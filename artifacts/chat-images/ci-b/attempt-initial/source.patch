+}
+.image-frames.image-count-1 {
+  grid-template-columns: minmax(0, 1fr);
+  max-width: 440px;
+}
+.image-frames.image-count-3 {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+.image-frame-shell {
+  position: relative;
+  min-width: 0;
+}
+.image-frame {
+  aspect-ratio: 1;
+  position: relative;
