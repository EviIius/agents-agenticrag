"] {\n    animation: full-screen-out 240ms var(--ease-in) both;\n  }\n}\n\n/* Conversation motion: presentation flags are cleared after each entrance. */\n@keyframes row-in {\n  from {\n    opacity: 0;\n    transform: translateY(var(--shift-md));\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\narticle[data-fresh=\"true\"] {\n  animation: row-in var(--dur-med) var(--ease-out) both;\n}\n@keyframes app-in {\n  from {\n    opacity: 0;\n    transform: translateY(var(--shift-sm));\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n.app-shell[data-app-entry=\"true\"] > .app-main,\n.app-shell[data-app-entry=\"true\"] > .sidebar-desktop {\n  animation: app-in var(--dur-med) var(--ease-out) both;\n}\n@keyframes waiting-wave {\n  0%,\n  80%,\n  100% {\n    opacity: 0.3;\n  }\n  40% {\n    opacity: 1;\n  }\n}\n[data-slot=\"waiting-dots\"] > [aria-hidden] {\n  animation: waiting-wave 1.2s var(--ease) infinite;\n}\n[data-slot=\"waiting-dots\"] > [aria-hidden]:nth-of-type(2) {\n  animation-delay: 160ms;\n}\n[data-slot=\"waiting-dots\"] > [aria-hidden]:nth-of-type(3) {\n  animation-delay: 320ms;\n}\n@keyframes caret-blink {\n  50% {\n    opacity: 0;\n  }\n}\n[data-streaming=\"true\"]\n  .prose-answer\n  > :last-child:not([data-sd-caret-hidden])::after {\n  color: var(--text-3);\n  animation: caret-blink 1s steps(1) infinite;\n}\n@keyframes collapse-in {\n  from {\n    height: 0;\n  }\n  to {\n    height: var(--radix-collapsible-content-height);\n  }\n}\n@keyframes collapse-out {\n  from {\n    height: var(--radix-collapsible-content-height);\n  }\n  to {\n    height: 0;\n  }\n}\n[data-slot=\"collapsible-content\"] {\n  overflow: hidden;\n}\n[data-slot=\"collapsible-content\"][data-state=\"open\"] {\n  animation: collapse-in var(--dur-med) var(--ease-out);\n}\n[data-slot=\"collapsible-content\"][data-state=\"closed\"] {\n  animation: collapse-out var(--dur-fast) var(--ease-in);\n}\n[data-slot=\"collapsible-trigger\"] > svg:last-child {\n  transition: transform var(--dur-fast) var(--ease);\n}\n[data-slot=\"collapsible-trigger\"][data-state=\"open\"] > svg:last-child {\n  transform: rotate(180deg);\n}\n/* A low contrast veil moves across a live label; foreground text stays readable. */\n@keyframes activity-shimmer {\n  from {\n    transform: translateX(-100%);\n  }\n  to {\n    transform: translateX(100%);\n  }\n}\n[data-slot=\"activity-label\"][data-live=\"true\"] {\n  position: relative;\n  overflow: hidden;\n}\n[data-slot=\"activity-label\"][data-live=\"true\"]::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    90deg,\n    transparent,\n    var(--surface-2),\n    transparent\n  );\n  opacity: 0.2;\n  animation: activity-shimmer 1.6s linear infinite;\n}\n[data-slot=\"search-step\"][data-live=\"true\"] {\n  animation: workbench-reveal var(--dur-fast) var(--ease-out);\n}\n@keyframes small-pop {\n  from {\n    opacity: 0;\n    transform: scale(0.8);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n[data-slot=\"activity-favicon\"],\n[data-slot=\"copy-check\"],\n[data-slot=\"send-icon\"] {\n  display: inline-flex;\n  animation: small-pop var(--dur-fast) var(--ease-pop);\n}\n[data-slot=\"activity-favicon\"][data-stagger=\"1\"] {\n  animation-delay: 40ms;\n}\n[data-slot=\"activity-favicon\"][data-stagger=\"2\"] {\n  animation-delay: 80ms;\n}\n[data-slot=\"activity-favicon\"][data-stagger=\"3\"] {\n  animation-delay: 120ms;\n}\n[data-code-copied=\"true\"] [data-streamdown=\"code-block-copy-button\"] svg {\n  animation: small-pop var(--dur-fast) var(--ease-pop);\n}\n[data-slot=\"scroll-bottom\"] {\n  transition:\n    opacity var(--dur-fast) var(--ease),\n    transform var(--dur-fast) var(--ease);\n}\n[data-slot=\"scroll-bottom\"][data-state=\"hidden\"] {\n  opacity: 0;\n  transform: translateY(var(--shift-md));\n}\n[data-slot=\"scroll-bottom\"][data-state=\"visible\"] {\n  opacity: 1;\n  transform: translateY(0);\n}\n[data-slot=\"composer\"] {\n  t