-answer td {\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--line);\n  text-align: left;\n}\n.prose-answer blockquote {\n  border-left: 2px solid var(--line-strong);\n  color: var(--text-2);\n  padding-left: 1em;\n}\n.prose-answer a {\n  color: var(--brand);\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n.prose-answer [data-streamdown=\"table-wrapper\"] {\n  overflow-x: auto;\n  max-width: 100%;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-md);\n}\n.prose-answer > :first-child {\n  margin-top: 0;\n}\n\n/* Streamdown's floating controls must remain clickable through their wrapper. */\n.prose-answer [data-streamdown=\"code-block-actions\"] {\n  pointer-events: auto;\n}\n\n/* Streamdown owns parsing; its data attributes own the single code/table surface. */\n.prose-answer [data-streamdown=\"code-block\"] {\n  border: 0;\n  border-radius: var(--radius-md);\n  overflow: hidden;\n  padding: 0;\n}\n.prose-answer [data-streamdown=\"code-block-header\"] {\n  background: var(--surface-2);\n  border: 0;\n  padding: 8px 14px;\n  font-family: var(--font-ui);\n  font-size: 12px;\n}\n.prose-answer [data-streamdown=\"code-block-body\"] {\n  border: 0;\n  border-radius: 0;\n  background: var(--code-bg);\n}\n.prose-answer [data-streamdown=\"code-block\"] pre {\n  border: 0;\n  border-radius: 0;\n  background: var(--code-bg);\n  margin: 0;\n  padding: 14px;\n}\n.prose-answer [data-streamdown=\"code-block\"] code,\n.prose-answer [data-streamdown=\"code-block\"] code span {\n  background: transparent !important;\n}\n.prose-answer [data-streamdown=\"code-block-actions\"] {\n  position: static;\n  background: transparent;\n}\n.prose-answer [data-streamdown=\"table\"] {\n  border: 0;\n  border-radius: 0;\n}\n.prose-answer [data-streamdown=\"table-wrapper\"] {\n  position: relative;\n  overflow: hidden;\n}\n.prose-answer [data-streamdown=\"table-wrapper\"] > div:has(> table) {\n  overflow-x: auto;\n  border: 0;\n  border-radius: 0;\n}\n.prose-