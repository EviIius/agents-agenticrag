r-content\"],\n  [data-slot=\"dropdown-menu-content\"],\n  [data-slot=\"dropdown-menu-sub-content\"],\n  [data-slot=\"select-content\"]\n)[data-state=\"open\"] {\n  animation: floating-in var(--dur-med) var(--ease-out) both;\n}\n:is(\n  [data-slot=\"popover-content\"],\n  [data-slot=\"dropdown-menu-content\"],\n  [data-slot=\"dropdown-menu-sub-content\"],\n  [data-slot=\"select-content\"]\n)[data-state=\"closed\"] {\n  animation: floating-out var(--dur-fast) var(--ease-in) both;\n}\n@keyframes tooltip-in {\n  from {\n    opacity: 0;\n    transform: translate(calc(var(--motion-x) / 2), calc(var(--motion-y) / 2));\n  }\n  to {\n    opacity: 1;\n    transform: translate(0, 0);\n  }\n}\n@keyframes opacity-out {\n  from {\n    opacity: 1;\n  }\n  to {\n    opacity: 0;\n  }\n}\n@keyframes opacity-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n[data-slot=\"tooltip-content\"][data-state]:not([data-state=\"closed\"]) {\n  animation: tooltip-in var(--dur-fast) var(--ease-out) both;\n}\n[data-slot=\"tooltip-content\"][data-state=\"closed\"] {\n  animation: opacity-out var(--dur-instant) var(--ease-in) both;\n}\n:is(\n  [data-slot=\"dialog-overlay\"],\n  [data-slot=\"alert-dialog-overlay\"],\n  [data-slot=\"sheet-overlay\"]\n)[data-state=\"open\"] {\n  animation: opacity-in var(--dur-med) var(--ease-out) both;\n}\n:is(\n  [data-slot=\"dialog-overlay\"],\n  [data-slot=\"alert-dialog-overlay\"],\n  [data-slot=\"sheet-overlay\"]\n)[data-state=\"closed\"] {\n  animation: opacity-out var(--dur-fast) var(--ease-in) both;\n}\n@keyframes dialog-in {\n  from {\n    opacity: 0;\n    transform: translateY(var(--shift-md)) scale(0.98);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n@keyframes dialog-out {\n  from {\n    opacity: 1;\n    transform: scale(1);\n  }\n  to {\n    opacity: 0;\n    transform: scale(0.98);\n  }\n}\n:is(\n  [data-slot=\"dialog-content\"],\n  [data-slot=\"alert-dialog-content\"]\n)[data-state=\"open\"] {\n  animation: dialog-in var(--dur-med) var(--ease-out) both;\n}\n:is(\n  [data-slot=\"dialog-content\"],\n  [data-slot=\"alert-dialog-content\"]\n)[data-state=\"closed\"] {\n  animation: dialog-out var(--dur-fast) var(--ease-in) both;\n}\n[data-slot=\"sheet-content\"] {\n  --motion-x: 100%;\n  --motion-y: 0px;\n}\n[data-slot=\"sheet-content\"][data-side=\"left\"] {\n  --motion-x: -100%;\n}\n[data-slot=\"sheet-content\"][data-side=\"top\"] {\n  --motion-x: 0px;\n  --motion-y: -100%;\n}\n[data-slot=\"sheet-content\"][data-side=\"bottom\"] {\n  --motion-x: 0px;\n  --motion-y: 100%;\n}\n@keyframes sheet-in {\n  from {\n    transform: translate(var(--motion-x), var(--motion-y));\n  }\n  to {\n    transform: translate(0, 0);\n  }\n}\n@keyframes sheet-out {\n  from {\n    transform: translate(0, 0);\n  }\n  to {\n    transform: translate(var(--motion-x), var(--motion-y));\n  }\n}\n[data-slot=\"sheet-content\"][data-state=\"open\"] {\n  animation: sheet-in var(--dur-slow) var(--ease-sheet) both;\n}\n[data-slot=\"sheet-content\"][data-state=\"closed\"] {\n  animation: sheet-out 240ms var(--ease-in) both;\n}\nhtml [data-slot=\"drawer-content\"][data-vaul-drawer][data-state],\nhtml [data-slot=\"drawer-overlay\"][data-vaul-overlay][data-state] {\n  animation-duration: var(--dur-slow);\n  animation-timing-function: var(--ease-sheet);\n  transition-duration: var(--dur-slow);\n  transition-timing-function: var(--ease-sheet);\n}\n@keyframes full-screen-in {\n  from {\n    opacity: 0;\n    transform: translateY(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes full-screen-out {\n  from {\n    opacity: 1;\n    transform: translateY(0);\n  }\n  to {\n    opacity: 0;\n    transform: translateY(16px);\n  }\n}\n@media (max-width: 639px) {\n  [data-slot=\"dialog-content\"].settings-dialog[data-state=\"open\"] {\n    animation: full-screen-in var(--dur-slow) var(--ease-sheet) both;\n  }\n  [data-slot=\"dialog-content\"].settings-dialog[data-state=\"closed\"] {\n    animation: full-screen-out 240ms var(--ease-in) both;\n  }\n}\n\n/* Conversation motion: presentation flags are cleared after each entrance. */\n@keyframes row-in {\n  from {\n    opacity: 0;\n    transform: translateY(var(--shift-md));\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\narticle[data-fresh=\"true\"] {\n  animation: row-in var(--dur-med) var(--ease-out) both;\n}\n@keyframes app-in {\n  from {\n    opacity: 0;\n    transform: translateY(var(--shift-sm));\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n.app-shell[data-app-entry=\"true\"] > .app-main,\n.app-shell[data-app-entry=\"true\"] > .sidebar-desktop {\n  animation: app-in var(--dur-med) var(--ease-out) both;\n}\n@keyframes waiting-wave {\n  0%,\n  80%,\n  100% {\n    opacity: 0.3;\n  }\n  40% {\n    opacity: 1;\n  }\n}\n[data-slot=\"waiting-dots\"] > [aria-hidden] {\n  animation: waiting-wave 1.2s var(--ease) infinite;\n}\n[data-slot=\"waiting-dots\"] > [aria-hidden]:nth-of-type(2) {\n  animation-delay: 160ms;\n}\n[data-slot=\"waiting-dots\"] > [aria-hidden]:nth-of-type(3) {\n  animation-delay: 320ms;\n}\n@keyframes caret-blink {\n  50% {\n    opacity: 0;\n  }\n}\n[data-streaming=\"true\"]\n  .prose-answer\n  > :last-child:not([data-sd-caret-hidden])::after {\n  color: var(--text-3);\n  animation: caret-blink 1s steps(1) infinite;\n}\n@keyframes collapse-in {\n  from {\n    height: 0;\n  }\n  to {\n    height: var(--radix-collapsible-content-height);\n  }\n}\n@keyframes collapse-out {\n  from {\n    height: var(--radix-collapsible-content-height);\n  }\n  to {\n    height: 0;\n  }\n}\n[data-slot=\"collapsible-content\"] {\n  overflow: hidden;\n}\n[data-slot=\"collapsible-content\"][data-state=\"open\"] {\n  animation: collapse-in var(--dur-med) var(--ease-out);\n}\n[data-slot=\"collapsible-content\"][data-state=\"closed\"] {\n  animation: collapse-out var(--dur-fast) var(--ease-in);\n}\n[data-slot=\"collapsible-trigger\"] > svg:last-child {\n  transition: transform var(--dur-fast) var(--ease);\n}\n[data-slot=\"collapsible-trigger\"][data-state=\"open\"] > svg:last-child {\n  transform: rotate(180deg);\n}\n/* A low contrast veil moves across a live label; foreground text stays readable. */\n@keyframes activity-shimmer {\n  from {\n    transform: translateX(-100%);\n  }\n  to {\n    transform: translateX(100%);\n  }\n}\n[data-slot=\"activity-label\"][data-live=\"true\"] {\n  position: relative;\n  overflow: hidden;\n}\n[data-slot=\"activity-label\"][data-live=\"true\"]::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    90deg,\n    transparent,\n    var(--surface-2),\n    transparent\n  );\n  opacity: 0.2;\n  animation: activity-shimmer 1.6s linear infinite;\n}\n[data-slot=\"search-step\"][data-live=\"true\"] {\n  animation: workbench-reveal var(--dur-fast) var(--ease-out);\n}\n@keyframes small-pop {\n  from {\n    opacity: 0;\n    transform: scale(0.8);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n[data-slot=\"activity-favicon\"],\n[data-slot=\"copy-check\"],\n[data-slot=\"send-icon\"] {\n  display: inline-flex;\n  animation: small-pop var(--dur-fast) var(--ease-pop);\n}\n[data-slot=\"activity-favicon\"][data-stagger=\"1\"] {\n  animation-delay: 40ms;\n}\n[data-slot=\"activity-favicon\"][data-stagger=\"2\"] {\n  animation-delay: 80ms;\n}\n[data-slot=\"activity-favicon\"][data-stagger=\"3\"] {\n  animation-delay: 120ms;\n}\n[data-code-copied=\"true\"] [data-streamdown=\"code-block-copy-button\"] svg {\n  animation: small-pop var(--dur-fast) var(--ease-pop);\n}\n[data-slot=\"scroll-bottom\"] {\n  transition:\n    opacity var(--dur-fast) var(--ease),\n    transform var(--dur-fast) var(--ease);\n}\n[data-slot=\"scroll-bottom\"][data-state=\"hidden\"] {\n  opacity: 0;\n  transform: translateY(var(--shift-md));\n}\n[data-slot=\"scroll-bottom\"][data-state=\"visible\"] {\n  opacity: 1;\n  transform: translateY(0);\n}\n[data-slot=\"composer\"] {\n  transition:\n    border-color var(--dur-fast) var(--ease),\n    box-shadow var(--dur-fast) var(--ease);\n}\n@keyframes chip-in {\n  from {\n    opacity: 0;\n    transform: scale(0.96);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n.composer [data-slot=\"attachment-chip\"],\n.composer [data-slot=\"audio-chip\"] {\n  animation: chip-in var(--dur-med) var(--ease-out);\n}\n[data-slot=\"upload-progress\"] {\n  height: 2px;\n  background: var(--surface-3);\n  overflow: hidden;\n}\n[data-slot=\"upload-progress\"] > span {\n  display: block;\n  height: 100%;\n  background: var(--brand);\n  transition: width var(--dur-fast) linear;\n}\n[data-slot=\"context-ring\"] {\n  transition: stroke-dasharray var(--dur-med) var(--ease);\n}\n[data-slot=\"history-row\"] {\n  transition: background-color var(--dur-fast) var(--ease);\n}\n@keyframes selected-bar {\n  from {\n    transform: scaleY(0);\n  }\n  to {\n    transform: scaleY(1);\n  }\n}\n[data-slot=\"history-row\"][data-current=\"true\"]::before {\n  content: \"\";\n  position: absolute;\n  width: 2px;\n  top: 0;\n  bottom: 0;\n  left: -2px;\n  background: var(--brand);\n  animation: selected-bar var(--dur-med) var(--ease-out);\n}\n[data-slot=\"run-dot\"] {\n  animation: breathe 1.2s var(--ease) infinite;\n}\n[data-slot=\"chat-title\"][data-fresh=\"true\"] {\n  animation: opacity-in var(--dur-med) var(--ease-out);\n}\n@keyframes loaded-pulse {\n  0%,\n  100% {\n    transform: scale(1);\n  }\n  50% {\n    transform: scale(1.35);\n  }\n}\n[data-slot=\"model-status\"][data-loaded-fresh=\"true\"] {\n  display: inline-block;\n  animation: loaded-pulse var(--dur-med) var(--ease);\n}\n/* Width snaps: the 300-message candidate exceeded 18 ms in WebKit. */\n.sidebar-desktop[data-collapsed=\"false\"] header > span {\n  animation: opacity-in var(--dur-fast) var(--ease-out);\n}\n::view-transition-old(root) {\n  animation: opacity-out var(--dur-med) var(--ease-in) both;\n}\n::view-transition-new(root) {\n  animation: opacity-in var(--dur-med) var(--ease-out) both;\n}\n[data-slot=\"side-panel\"] {\n  animation: side-panel-in var(--dur-med) var(--ease-out);\n}\n@keyframes side-panel-in {\n  from {\n    opacity: 0;\n    transform: translateX(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n.topbar {\n  transition: border-color var(--dur-fast) var(--ease);\n}\n.topbar[data-scrolled=\"true\"] {\n  border-bottom-color: var(--line);\n}\n/* Both triggers cover the root, pseudo-elements, vendor motion and future text fades. */\n[data-slot=\"message-actions\"],\n[data-slot=\"message-stats\"],\n[data-slot=\"model-action\"] {\n  transition: opacity var(--dur-fast) var(--ease);\n}\n[data-slot=\"context-menu-content\"][data-state=\"open\"] {\n  animation: opacity-in var(--dur-fast) var(--ease-out) both;\n}\n/* Workflow Studio editing; run loops remain the next checkpoint. */\n.wf-drag-ghost[data-reduced=\"false\"] .wf-block {\n  transform: scale(1.02);\n}\n@keyframes wf-enter {\n  from {\n    opacity: 0;\n    transform: translateY(4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes wf-panel-enter {\n  from {\n    opacity: 0;\n    transform: translateX(16px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n.wf-canvas[data-entrance=\"true\"] .react-flow__node-block > div {\n  animation: wf-enter var(--dur-med) var(--ease-out) both;\n}\n.wf-canvas[data-entrance=\"true\"] .react-flow__node-block > div {\n  animation-delay: calc(var(--wf-index) * 24ms);\n}\n.wf-right {\n  animation: wf-panel-enter var(--dur-med) var(--ease-sheet) both;\n}\n.wf-canvas[data-arranging=\"true\"] .react-flow__node {\n  transition: transform var(--dur-slow) var(--ease-sheet);\n}\n.wf-block,\n.wf-definition-card {\n  transition:\n    transform var(--dur-fast) var(--ease),\n    opacity var(--dur-fast) var(--ease);\n}\n.wf-definition-card:hover {\n  transform: translateY(-1px);\n  border-color: var(--line-strong);\n  box-shadow: var(--shadow-md);\n}\n.wf-edge-tools {\n  transition: opacity var(--dur-fast) var(--ease);\n}\n.wf-port.react-flow__handle {\n  transition: transform var(--dur-instant) var(--ease);\n}\n.wf-port.react-flow__handle:hover {\n  transform: translate(-50%, -50%) scale(1.4);\n}\n\n/* Workflow Studio WS-D activity indicators, driven by server states. */\n@keyframes wf-sweep {\n  to {\n    transform: rotate(1turn);\n  }\n}\n@keyframes wf-flow {\n  to {\n    stroke-dashoffset: -12;\n  }\n}\n@keyframes wf-badge {\n  from {\n    transform: scale(0.6);\n    opacity: 0;\n  }\n  to {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n.wf-block[data-run=\"running\"]::before {\n  animation: wf-sweep 1.6s linear infinite;\n}\n.wf-block[data-run=\"paused\"]::after {\n  animation: breathe 1.5s var(--ease) infinite;\n}\n.wf-edge-path[data-run=\"active\"] {\n  animation: wf-flow 800ms linear infinite;\n}\n.wf-run-badge[data-state=\"complete\"] {\n  animation: wf-badge 200ms var(--ease-pop) both;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n    scroll-behavior: auto !important;\n  }\n  [data-slot=\"button\"]:active:not(:disabled) {\n    transform: none;\n  }\n  ::view-transition-group(*),\n  ::view-transition-old(*),\n  ::view-transition-new(*) {\n    animation: none !important;\n  }\n  [data-sd-animate],\n  [data-sd-animate-marker]::marker {\n    animation: none !important;\n  }\n}\n[data-reduce-motion=\"always\"],\n[data-reduce-motion=\"always\"] *,\n[data-reduce-motion=\"always\"]::before,\n[data-reduce-motion=\"always\"]::after,\n[data-reduce-motion=\"always\"] *::before,\n[data-reduce-motion=\"always\"] *::after {\n  animation: none !important;\n  transition: none !important;\n  scroll-behavior: auto !important;\n}\n[data-reduce-motion=\"always\"] [data-slot=\"button\"]:active:not(:disabled) {\n  transform: none;\n}\n[data-reduce-motion=\"always\"]::view-transition-group(*),\n[data-reduce-motion=\"always\"]::view-transition-old(*),\n[data-reduce-motion=\"always\"]::view-transition-new(*) {\n  animation: none !important;\n}\n[data-reduce-motion=\"always\"] [data-sd-animate],\n[data-reduce-motion=\"always\"] [data-sd-animate-marker]::marker {\n  animation: none !important;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wf-edge-path[data-run=\"active\"] {\n    stroke-dasharray: none;\n  }\n}\n[data-reduce-motion=\"always\"] .wf-edge-path[data-run=\"active\"] {\n  stroke-dasharray: none;\n}\n"],["STYLE",{},".prose-answer {\n  font-family: var(--font-reading);\n  font-size: 17px;\n  line-height: 28px;\n  max-width: 68ch;\n  overflow-wrap: anywhere;\n}\n[data-answer-font=\"sans\"] .prose-answer {\n  font-family: var(--font-ui);\n}\n[data-text-size=\"S\"] .prose-answer {\n  font-size: 16px;\n  line-height: 26px;\n}\n[data-text-size=\"L\"] .prose-answer {\n  font-size: 19px;\n  line-height: 31px;\n}\n.prose-answer p {\n  margin: 0.8em 0;\n}\n.prose-answer h1,\n.prose-answer h2,\n.prose-answer h3 {\n  font-family: inherit;\n  font-weight: 600;\n  margin: 1.4em 0 0.5em;\n}\n.prose-answer h1 {\n  font-size: 24px;\n  line-height: 32px;\n}\n.prose-answer h2 {\n  font-size: 20px;\n  line-height: 28px;\n}\n.prose-answer h3 {\n  font-size: 17px;\n  line-height: 26px;\n}\n.prose-answer ul,\n.prose-answer ol {\n  padding-left: 1.4em;\n  margin: 0.8em 0;\n}\n.prose-answer li {\n  margin: 0.35em 0;\n}\n.prose-answer code {\n  font-family: var(--font-code);\n  background: var(--code-bg);\n  border-radius: 4px;\n  padding: 0.1em 0.35em;\n  font-size: 0.9em;\n}\n.prose-answer pre code {\n  padding: 0;\n  background: none;\n  font-size: 13.5px;\n  line-height: 21px;\n}\n.prose-answer pre,\n.prose-answer [data-streamdown=\"code-block\"] {\n  max-width: 100%;\n  font-family: var(--font-code);\n  font-size: 13.5px;\n  background: var(--code-bg);\n}\n.prose-answer table {\n  font-family: var(--font-ui);\n  font-size: 14px;\n  line-height: 20px;\n  min-width: 100%;\n}\n.prose-answer