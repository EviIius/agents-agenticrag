#!/usr/bin/env python3
"""Synthetic recording engine: no real audio, external runtime or network."""
import json
import os
import signal
import sys
import time
from pathlib import Path

if sys.argv[1:]==['doctor', '--json']:
    print(json.dumps({'ok': True, 'version': 'fake-0.1.0',
        'checks': [{'name': 'Fake engine', 'ok': True, 'detail': 'Synthetic test engine', 'blocking': True}],
        'paths': {'glossary': os.environ.get('FAKE_TRANSCRIBE_GLOSSARY', '/tmp/fake-glossary.txt')},
        'audio_extensions': ['.wav', '.mp3', '.m4a', '.flac', '.aiff', '.webm']}))
    sys.exit(0)
audio = Path(sys.argv[2])
out = Path(sys.argv[sys.argv.index('--out-dir')+1])
with audio.open('rb') as handle:
    directive = handle.readline(1024).decode(errors='replace').strip()
signal.signal(signal.SIGTERM, lambda *_: sys.exit(130))
if directive.startswith('#fake:slow '):
    time.sleep(float(directive.split()[-1]))
if directive.startswith('#fake:fail '):
    print('Transcription failed: '+directive[len('#fake:fail '):], file=sys.stderr)
    sys.exit(1)
text = 'Fake transcript. This recording is not real. We discussed the next release. Follow up on Friday.'
raw = text
corrections=[]
warnings=[]
if directive.startswith('#fake:words '):
    text = ' '.join(['Fake']*int(directive.split()[-1]))
if directive=='#fake:glossary':
    raw='Fake recording. Gismo is a synthetic test term.'
    text=raw.replace('Gismo','GSMOS')
    corrections=[{'found': 'Gismo', 'replaced_with': 'GSMOS', 'count': 1}]
if directive=='#fake:silence':
    text=raw=''
    warnings=['No speech was detected in this recording.']
segments=[{'start': i*25, 'end': (i+1)*25, 'text': part, 'raw_text': part,
           'speaker': 'Speaker %d' % (i%2+1) if directive=='#fake:speakers' else None}
          for i,part in enumerate([text[:len(text)//3],text[len(text)//3:len(text)*2//3],text[len(text)*2//3:]])] if text else []
out.mkdir(parents=True,exist_ok=True)
result={'text': text,'raw_text': raw if not directive.startswith('#fake:words') else text,'segments': segments,
        'source': {'duration_seconds':75},'engine': {'model':'fake-whisper','prompt': ''},
        'processing': {'elapsed_seconds':1,'speed_x_realtime':75},'warnings': warnings,
        'glossary_corrections':corrections,'channel_mode':'split' if '--channels' in sys.argv else 'mix'}
(out/(audio.stem+'.json')).write_text(json.dumps(result))
