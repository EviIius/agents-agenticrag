div&gt;&lt;/div&gt;\n            \n            &lt;script&gt;\n              document.getElementById(&#39;ad&#39;).setAttribute(&#39;data-script-start&#39;, window.CBCDACXRenderStartTime);\n              if (document &amp;&amp; document.fonts) {\n                try {\n                  document.fonts.ready.then(function () {\n                    document.getElementById(&#39;ad&#39;).setAttribute(&#39;data-font-loaded-time&#39;, performance.now());\n                  });\n                } catch (e) {\n                }\n              }\n            &lt;/script&gt;\n            &lt;div style=\&quot;display: none;\&quot; data-size-str=\&quot;970x250\&quot;&gt;&lt;/div&gt;\n            \n\n            \n            &lt;script src=\&quot;https://m.media-amazon.com/images/I/41VLrYTq8iL.js\&quot;&gt;&lt;/script&gt;\n            &lt;script src=\&quot;https://m.media-amazon.com/images/I/71JJ6+7j3GL.js\&quot;&gt;&lt;/script&gt;\n            &lt;script charset=\&quot;UTF-8\&quot; src=\&quot;https://m.media-amazon.com/images/I/B1U9QqKpQGL.js\&quot;&gt;&lt;/script&gt;\n            &lt;script&gt;\n              window.CBCDACXBundleLoadedTime = performance.now();\n              document.getElementById(&#39;ad&#39;).setAttribute(&#39;data-bundle-loaded-time&#39;, window.CBCDACXBundleLoadedTime);\n\n              ReactDOM.hydrate(AdaptiveRenderer.default({\&quot;creativeInformation\&quot;:{\&quot;variation\&quot;:\&quot;shop-now\&quot;,\&quot;customImages\&quot;:{\&quot;square\&quot;:null,\&quot;tall\&quot;:null,\&quot;wide\&quot;:null},\&quot;isPreview\&quot;:false,\&quot;priceInformation\&quot;:{\&quot;price\&quot;:23.74,\&quot;fullPrice\&quot;:24.99,\&quot;pricePerUnit\&quot;:\&quot;\&quot;,\&quot;currencyCode\&quot;:\&quot;USD\&quot;},\&quot;isPrimeEligible\&quot;:true,\&quot;productDescription\&quot;:\&quot;KOCHCHEMIE Green Star Universal Cleaner, 33.8 Fl Oz, 1-Pack\&quot;,\&quot;ratings\&quot;:{\&quot;stars\&quot;:4.8,\&quot;amount\&quot;:448},\&quot;climatePledgeFriendlyBadge\&quot;:{\&quot;attributeCount\&quot;:0,\&quot;certCount\&quot;:0},\&quot;dealBadge\&quot;:{},\&quot;promotion\&quot;:{\&quot;type\&quot;:\&quot;Percent off\&quot;,\&quot;value\&quot;:5,\&quot;class\&quot;:\&quot;sns\&quot;,\&quot;dataAceiId\&quot;:\&quot;sns-disc\&quot;},\&quot;aapiBrandName\&quot;:\&quot;KOCHCHEMIE\&quot;,\&quot;ctaText\&quot;:\&quot;shop-now\&quot;,\&quot;productGroupType\&quot;:\&quot;gl_automotive\&quot;,\&quot;resolvedAceiData\&quot;:{\&quot;renderFeatureFlags\&quot;:{},\&quot;renderLogData\&quot;:{\&quot;eligibleSCE\&quot;:[\&quot;sns-disc\&quot;],\&quot;metrics\&quot;:[]},\&quot;aceiExperimentsToRecord\&quot;:{}},\&quot;asin\&quot;:\&quot;B0DHBC6BY2\&quot;,\&quot;productQnADetails\&quot;:{\&quot;productQnA\&quot;:[{\&quot;question\&quot;:\&quot;Does it protect sensitive metal surfaces?\&quot;,\&quot;answer\&quot;:\&quot;Special corrosion inhibitors are built into the formula to ensure a high level of material compatibility for sensitive components, including anodised aluminium. The cleaner is also NTA, phosphate, and solvent-free, which further supports its gentler profile on delicate surfaces. For sensitive surfaces, dilution ratios as high as 1:120 are recommended to reduce intensity while maintaining cleaning performance.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;How does it break down grease and oil?\&quot;,\&quot;answer\&quot;:\&quot;Green Star&#39;s highly concentrated alkaline formula gives it an enormous dirt and oil absorption capacity, which is the core mechanism behind its degreasing performance. The alkaline chemistry works to lift and release grease and oil from surfaces, making it effective across workshop floors, engines, and vehicle interiors. Special corrosion inhibitors are included to protect sensitive components like anodised aluminium during the cleaning process.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;How far can one liter be diluted?\&quot;,\&quot;answer\&quot;:\&quot;One liter can be diluted up to 1:120 for workshop and industrial flooring or delicate surfaces, meaning a single liter can yield up to 120 liters of cleaning solution. For external vehicle and engine cleaning, the recommended ratio is 1:5 to 1:30, while interior vehicle and textile cleaning calls for 1:10 to 1:20. The concentrate can be used in spray bottles, foam cannons, or buckets depending on the task.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;How does the dilution ratio work?\&quot;,\&quot;answer\&quot;:\&quot;The dilution ratio varies by task: exterior vehicle and engine cleaning calls for 1:5 to 1:30, interior vehicle and textile cleaning uses 1:10 to 1:20, and workshop or industrial flooring can go as light as 1:40 to 1:120. The higher the second number, the more water is added — so 1:120 is the most diluted and is suited for delicate or sensitive surfaces. For maximum use concentration, the product can be applied as strong as 1:3, with an application time of no more than 5 minutes at that strength. This flexibility makes it usable in spray bottles, foam cannons, and buckets depending on the job.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;How well does it cut engine grease?\&quot;,\&quot;answer\&quot;:\&quot;Green Star&#39;s enormous dirt and oil absorption capacity makes it well-suited for engine cleaning, with a recommended dilution ratio of 1:5 to 1:30 depending on the level of grime. The alkaline formula is phosphate- and solvent-free, and special corrosion inhibitors protect sensitive components like anodised aluminium during the cleaning process. The recommended method is surface-covering application, a short dwell time, then rinsing off with a pressure washer — with a maximum application time of 5 minutes per VDA Class A guidelines.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;Can it clean cars, engines, and floors too?\&quot;,\&quot;answer\&quot;:\&quot;Green Star is formulated for exactly those three applications — and more. For external vehicle and engine cleaning, dilute between 1:5 and 1:30, apply to the surface, let it work briefly, then rinse with a pressure washer. For workshop and industrial flooring, it can be diluted as far as 1:40 to 1:120. Special corrosion inhibitors also make it safe for sensitive components like anodised aluminium.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;},{\&quot;question\&quot;:\&quot;Is it certified safe for car surfaces?\&quot;,\&quot;answer\&quot;:\&quot;Green Star conforms to VDA Class A, an automotive industry standard that sets limits on application time (max 5 minutes) and use concentration (max 1:3) for use on cars, camping vehicles, and commercial vehicles. Special corrosion inhibitors are built into the formula to protect sensitive components like anodised aluminium. It is also phosphate- and solvent-free, which contributes to its material compatibility across a wide range of surfaces.\&quot;,\&quot;type\&quot;:\&quot;sponsored\&quot;}]},\&quot;productTitleType\&quot;:\&quot;DEFAULT\&quot;,\&quot;type\&quot;:\&quot;DISPLAY\&quot;,\&quot;productImg\&quot;:{\&quot;url\&quot;:\&quot;https://m.media-amazon.com/images/I/51VAwHTwEtL.jpg\&quot;,\&quot;altText\&quot;:\&quot;\&quot;,\&quot;colorTreatment\&quot;:\&quot;default\&quot;},\&quot;videos\&quot;:[],\&quot;components\&quot;:[\&quot;Image\&quot;,\&quot;BuyBox\&quot;],\&quot;border\&quot;:true,\&quot;storeContextName\&quot;:\&quot;Cleaners\&quot;,\&quot;clickThroughInfo\&quot;:{\&quot;impressionUrls\&quot;:[],\&quot;isOffsite\&quot;:false,\&quot;adLink\&quot;:\&quot;https://www.amazon.com/dp/B0DHBC6BY2?aref=4eOdWs6XgT&amp;aaxitk=66c266cab76f0181c388097a9824c5af&amp;language=en_US&amp;pd_rd_plhdr=t&amp;ref=dacx_dp_580439783594147786_587629816078198072\&quot;,\&quot;reviewLink\&quot;:\&quot;https://www.amazon.com/product-reviews/B0DHBC6BY2?aref=4eOdWs6XgT&amp;aaxitk=6