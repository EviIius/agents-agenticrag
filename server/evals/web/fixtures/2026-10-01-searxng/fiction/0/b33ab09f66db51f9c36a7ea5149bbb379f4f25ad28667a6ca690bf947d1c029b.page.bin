	<script>
(function () {
  function setMediaSessionFromAudio(audio) {
    if (!('mediaSession' in navigator) || typeof MediaMetadata === 'undefined') return;

    var title  = audio.dataset.title  || document.title || '';
    var artist = audio.dataset.artist || '';
    var album  = audio.dataset.album  || '';
    var art    = audio.dataset.art    || '';

    if (!art) return;

    // Guess mime type from extension (png/jpg/jpeg); defaults to jpeg
    var type = 'image/jpeg';
    if (art.toLowerCase().endsWith('.png')) type = 'image/png';
    if (art.toLowerCase().endsWith('.jpg') || art.toLowerCase().endsWith('.jpeg')) type = 'image/jpeg';

    navigator.mediaSession.metadata = new MediaMetadata({
      title: title,
      artist: artist,
      album: album,
      artwork: [
        { src: art, sizes: '512x512', type: type },
        { src: art, sizes: '1024x1024', type: type }
      ]
    });
  }

  document.addEventListener('play', function (e) {
    if (e.target && e.target.tagName === 'AUDIO') setMediaSessionFromAudio(e.target);
  }, true);
})();
</script>

