-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}@font-face{font-family:'Public Sans';font-weight:700;font-display:swap;src:url(https://fonts.gstatic.com/s/publicsans/v21/ijwRs572Xtc6ZYQws9YVwnNJfJ7Cww.woff2) format('woff2');unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;}@font-face{font-family:'Public Sans';font-weight:700;font-display:swap;src:url(https://fonts.gstatic.com/s/publicsans/v21/ijwRs572Xtc6ZYQws9YVwnNIfJ7Cww.woff2) format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;}@font-face{font-family:'Public Sans';font-weight:700;font-display:swap;src:url(https://fonts.gstatic.com/s/publicsans/v21/ijwRs572Xtc6ZYQws9YVwnNGfJ4.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}</style><link rel="preload" fetchpriority="high" href="https://mashieldhouse.com/wp-content/uploads/themify-concate/2066885461/themify-1348118716.css" as="style"><link fetchpriority="high" id="themify_concate-css" rel="stylesheet" href="https://mashieldhouse.com/wp-content/uploads/themify-concate/2066885461/themify-1348118716.css"><link rel="preconnect" href="https://www.google-analytics.com"><style id="wp-custom-css">
/* ============================================
   PMPro MEMBER GATE — Styling
   ============================================ */

/* Centre the gate content */
.pmpro_content_message {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
    padding: 2.5rem;
}

/* Heading — EB Garamond, H2 bold */
.pmpro_content_message h2,
.pmpro_content_message h3 {
    font-family: 'EB Garamond', serif;
    font-weight: 700;
    color: #333333;
    text-align: center;
}

/* Body text — Lora */
.pmpro_content_message p,
.pmpro_content_message a {
    font-family: 'Lora', serif;
    color: #333333;
    text-align: center;
}

/* Already a member link — accent colour */
.pmpro_content_message a {
    color: #a12a49;
}

/* Gate button */
.pmpro_content_message .pmpro_btn,
.pmpro_content_message input[type="submit"],
.pmpro_content_message a.button {
    font-family: 'EB Garamond', serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: #a12a49;
    color: #ffffff;
    border: none;
    padding: 0.75rem 2rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
    display: inline-block;
    text-decoration: none;
}

.pmpro_content_message .pmpro_btn:hover,
.pmpro_content_message input[type="submit"]:hover,
.pmpro_content_message a.button:hover {
    background-color: rgba(161, 42, 73, 0.5);
    color: #ffffff;
}
.pmpro_content_message {
    background-color: rgba(255, 255, 255, 0.85);
    padding: 2.5rem;
    border-radius: 4px;
	 margin-bottom: 3rem;
}

/* ============================================
   PMPro ACCOUNT REST PASSWORD + LOGIN PAGE — Styling
   ============================================ */

/* PMPro login page - styled to match gate */
.pmpro_login .pmpro_card_content,
.pmpro_lost_password_wrap .pmpro_card_content {
    background-color: rgba(255, 255, 255, 0.85);
    padding: 2.5rem;
    border-radius: 4px;
    margin: 0 auto 3rem auto;
    max-width: 600px;
    text-align: center;
}

.pmpro_login .pmpro_card_content p,
.pmpro_lost_password_wrap .pmpro_card_content p {
    font-family: 'Lora', serif;
    color: #333333;
    text-align: center;
}

.pmpro_login .pmpro_card_content label,
.pmpro_lost_password_wrap .pmpro_card_content label {
    font-family: 'Lora', serif;
    color: #333333;
}

.pmpro_login .pmpro_card_content input[type="text"],
.pmpro_login .pmpro_card_content input[type="password"],
.pmpro_lost_password_wrap .pmpro_card_content input[type="text"] {
    font-family: 'Lora', serif;
    text-align: left;
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    display: block;
}

/* Button - centred, matching gate style */
.pmpro_login .pmpro_card_actions,
.pmpro_lost_password_wrap .pmpro_card_actions {
    background-color: transparent;
    border: none;
    text-align: center;
    padding: 0 2.5rem 2.5rem 2.5rem;
    max-width: 600px;
    margin: 0 auto;
}

.pmpro_login .pmpro_card_actions input[type="submit"],
.pmpro_lost_password_wrap .pmpro_card_actions input[type="submit"] {
    font-family: 'EB Garamond', serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: #a12a49;
    color: #ffffff;
    border: none;
    padding: 0.75rem 2rem;
    cursor: pointer;
    transition: background-color 0.2s ease;
    display: inline-block;
}

.pmpro_login .pmpro_card_actions input[type="submit"]:hover,
.pmpro_lost_password_wrap .pmpro_card_actions input[type="submit"]:hover {
    background-color: rgba(161, 42, 73, 0.5);
    color: #ffffff;
}
.pmpro_form_submit {
    text-align: center !important;
    display: flex !important;
    justify-content: center !important;
}

input.pmpro_btn.pmpro_btn-submit {
    font-family: 'EB Garamond', serif !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    background-color: #a12a49 !important;
    color: #ffffff !important;
    border: none !important;
    padding: 0.75rem 2rem !important;
    display: inline-block !important;
}

input.pmpro_btn.pmpro_btn-submit:hover {
    background-color: rgba(161, 42, 73, 0.5) !important;
}
/* Login form - centre and constrain */
#loginform {
    max-width: 400px !important;
    margin: 0 auto !important;
    text-align: center !important;
}

#loginform .login-submit {
    display: flex !important;
    justify-content: center !important;
}

#loginform .login-submit input[type="submit"] {
    font-family: 'EB Garamond', serif !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    background-color: #a12a49 !important;
    color: #ffffff !important;
    border: none !important;
    padding: 0.75rem 2rem !important;
    width: auto !important;
    display: inline-block !important;
    cursor: pointer !important;
    transition: background-color 0.2s ease !important;
}

#loginform .login-submit input[type="submit"]:hover {
    background-color: rgba(161, 42, 73, 0.5) !important;
}
/* PMPro login and reset password page backgrounds */
body.pmpro-account,
body.pmpro-login,
body.pmpro-lostpassword {
    background-image: url('https://mashieldhouse.com/wp-content/uploads/2024/05/Glitter-4.png');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
}
</style>
