          var s = document.getElementById('sr-slidein');
          if (s && !s.contains(f)) { s.classList.remove('sr-slidein-show'); }
        }
        btn.disabled = false;
      }).catch(function () {
        msg.textContent = 'Something went wrong — try again.';
        msg.style.color = '#DC2626';
        btn.disabled = false;
      });
    });
  });
});
