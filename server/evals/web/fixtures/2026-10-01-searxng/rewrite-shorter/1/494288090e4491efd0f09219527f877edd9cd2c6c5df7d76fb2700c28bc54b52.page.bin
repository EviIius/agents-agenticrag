        })
      }).then(function (r) { return r.json(); }).then(function (d) {
        msg.textContent = d.message || d.error || 'Something went wrong — try again.';
        msg.style.color = d.ok ? '#059669' : '#DC2626';
        if (d.ok) {
          f.email.value = '';
