<script>
(function () {
  var node = document.getElementById('sr-gab');
  if (!node) return;
  var alt;
  try { alt = JSON.parse(node.textContent); } catch (e) { return; }
  if (!alt || !alt.slug || !alt.from) return;
  var KEY = 'sr_guide_ab', arm = null;
  try { arm = localStorage.getItem(KEY); } catch (e) {}
  if (arm !== 'a' && arm !== 'b') {
    arm = Math.random() < 0.5 ? 'b' : 'a';
    try { localStorage.setItem(KEY, arm); } catch (e) {}
  }
  if (arm !== 'b') return;
  var from = '@' + alt.from, to = '@' + alt.slug;
  function retag(el, name) {
    var v = el.getAttribute(name);
    if (v && v.slice(-from.length) === from) {
      el.setAttribute(name, v.slice(0, -from.length) + to);
    }
  }
  var tagged = document.querySelectorAll('[data-cta-variant],[data-source]');
  for (var i = 0; i < tagged.length; i++) {
    retag(tagged[i], 'data-cta-variant');
    retag(tagged[i], 'data-source');
  }
  var links = document.querySelectorAll('a[href]');
  for (var j = 0; j < links.length; j++) {
    var href = links[j].getAttribute('href');
    if (href && href.slice(-('/get/' + alt.from).length) === '/get/' + alt.from) {
      links[j].setAttribute('href', href.slice(0, -alt.from.length) + alt.slug);
    }
  }
  function copy(sel, text) {
    var els = document.querySelectorAll(sel);
    for (var k = 0; k < els.length; k++) els[k].textContent = text;
  }
  copy('[data-gm-head]', alt.head);
  copy('[data-gm-sub]', alt.sub);
  copy('[data-gm-subshort]', alt.sub_short);
  var labelled = document.querySelectorAll('#sr-gslidein[aria-label]');
  for (var m = 0; m < labelled.length; m++) labelled[m].setAttribute('aria-label', alt.head);
})();
</script>

