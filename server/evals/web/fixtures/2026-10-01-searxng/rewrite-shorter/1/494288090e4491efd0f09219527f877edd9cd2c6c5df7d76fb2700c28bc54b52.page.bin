    addEventListener("scroll", function () {
      lastEvt = Date.now();
      if (lastEvt - lastSc < 300 || sc.length >= 480) return;
      lastSc = lastEvt;
      sc.push([Math.round((lastEvt - t0) / 100), pct()]);
      dirty = true;
    }, { passive: true });

    ["pointermove", "keydown", "touchstart", "click"].forEach(function (e) {
      addEventListener(e, function () { lastEvt = Date.now(); }, { passive: true });
    });

    addEventListener("pointerover", function (e) {
      var k = label(e.target);
      if (k === hovKey) return;
      if (hovKey) hov[hovKey] = (hov[hovKey] || 0) + (Date.now() - hovT0);
      hovKey = k; hovT0 = Date.now();
      if (k) { mark(k); dirty = true; }
    }, { passive: true });

    addEventListener("pointerdown", function (e) {
      var k = label(e.target);
      if (k) { tap[k] = (tap[k] || 0) + 1; mark(k); dirty = true; }
    }, { passive: true });

    setInterval(function () {
      var state = document.hidden ? "h" : ((Date.now() - lastEvt) < 5000 ? "a" : "i");
      var last = led[led.length - 1];
      if (last && last[0] === state) { last[1]++; } else if (led.length < 400) { led.push([state, 1]); }
      dirty = true;
    }, 1000);

    var sends = 0;
    var send = function (force) {
      if (!dirty || (!force && sends >= 40)) return;
      dirty = false; sends++;
      if (hovKey) { hov[hovKey] = (hov[hovKey] || 0) + (Date.now() - hovT0); hovT0 = Date.now(); }
      var body = { k: "tr", p: location.pathname,
                   tr: { sc: sc.length > 240 ? sc.filter(function (_, i) { return i % 2 === 0; }) : sc,
                         led: led, hov: hov, tap: tap, fq: fq } };
      var b = new Blob([JSON.stringify(body)], { type: "application/json" });
      if (!(navigator.sendBeacon && navigator.sendBeacon(PX, b))) {
        fetch(PX, { method: "POST", body: b, keepalive: true }).catch(function () {});
      }
    };
    setInterval(function () { send(false); }, 30000);
    var finalSend = function () { if (!sentFinal) { dirty = true; send(true); } };
    addEventListener("pagehide", function () { finalSend(); sentFinal = true; });
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) finalSend();
    });
  } catch (e) {}
})();
</script>
  <style>
    /* Sticky header: in-page anchor targets must land BELOW it, not under it. 6rem clears
       the tallest (wrapped, two-row mobile) header; on desktop it just adds breathing room. */
    html { scroll-padding-top: 6rem; }
    /* The nav product CTA — a filled pill so the offer reads as a button, not another link.
       Carries the nav's mono/uppercase/tracking so it stays OF the header, just weighted.
       var(--post-accent) matches the card buttons' per-post accent, same fallback. */
    .nav-cta { background: var(--post-accent, #3B82F6); color: #fff; font-weight: 700;
      padding: .45rem .9rem; border-radius: 9999px; white-space: nowrap;
      transition: filter .12s; }
    .nav-cta:hover { filter: brightness(1.12); color: #fff; }
    /* Header split (owner call, 2026-07-29): mobile = brand + offer + burger, desktop = the
       full text nav with the pill pinned at the end. Native <details> burger; the opened
       menu is IN FLOW, so it expands the sticky header downward rather than overlaying. */
    .nav-burger > summary { display: inline-flex; align-items: center; cursor: pointer;
      list-style: none; padding: .3rem; }
    .nav-burger > summary::-webkit-details-marker { display: none; }
    .nav-burger > summary::marker { content: ""; }
    @media (min-width: 768px) {
      .nav-burger { display: none; }
      .site-nav { order: 2; }
      .nav-cta { order: 3; }
    }
    @media (max-width: 767.98px) {
      .site-nav { display: none; width: 100%; flex-direction: column;
        align-items: flex-start; gap: .9rem; padding: .6rem 0 .3rem; }
      .nav-burger[open] ~ .site-nav { display: flex; }
      .nav-cta { padding: .4rem .75rem; }
      .site-brand { letter-spacing: .08em; }
      /* the switcher's inline-start divider is a row artifact; drop it in the column menu */
      .lang-switch { border-inline-start: none; padding-inline-start: 0; margin-inline-start: 0; }
    }
    .blog-code-wrap { position: relative; }
    .blog-code-wrap .code-copy {
      position: absolute; top: 8px; right: 8px; z-index: 2;
      font: 600 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.04em; text-transform: uppercase;
      color: #cbd5e1; background: rgba(15,23,42,0.65); border: 1px solid rgba(148,163,184,0.35);
      border-radius: 6px; padding: 5px 9px; cursor: pointer; opacity: 0; transition: opacity .12s, color .12s, border-color .12s;
    }
    .blog-code-wrap:hover .code-copy, .blog-code-wrap .code-copy:focus-visible { opacity: 1; }
    .blog-code-wrap .code-copy:hover { color: #fff; border-color: rgba(148,163,184,0.7); }
    .blog-code-wrap .code-copy.copied { color: #34d399; border-color: rgba(52,211,153,0.6); opacity: 1; }
    /* The clipboard API can refuse (focus, permission, insecure context). Say so rather
       than leave a button that reads as broken. */
    .blog-code-wrap .code-copy.copy-failed { color: #fca5a5; border-color: rgba(252,165,165,0.6); opacity: 1; }
    @media (hover: none) { .blog-code-wrap .code-copy { opacity: 1; } }
    /* RTL page (dir="rtl" on <html>): shell text flows RTL, but code, chart/tool widgets
       and quoted terminal output are LTR artifacts and must stay LTR — a reader runs the
       exact same commands. Physical-direction utilities that encode "end of line" flip. */
    [dir="rtl"] .blog-code-wrap, [dir="rtl"] pre,
    [dir="rtl"] .sr-mount, [dir="rtl"] .tool-mount { direction: ltr; text-align: left; }
    [dir="rtl"] .text-right { text-align: left; }
    [dir="rtl"] .ml-auto { margin-left: 0; margin-right: auto; }
    /* Language switcher (native <details> disclosure) — structure only; logical properties so
       it mirrors under dir="rtl" with no ar-specific rule. */
    .lang-switch{position:relative;text-transform:none;letter-spacing:normal;
      padding-inline-start:.75rem;margin-inline-start:.25rem;border-inline-start:1px solid var(--line,#E7E5E4)}
    .lang-switch>summary{display:inline-flex;align-items:center;gap:.4rem;cursor:pointer;list-style:none}
    .lang-switch>summary::-webkit-details-marker{display:none}
    .lang-switch>summary::marker{content:""}
    .lang-switch>summary:focus-visible{outline:2px solid currentColor;outline-offset:3px}
    .lang-switch .lang-globe{inline-size:1em;block-size:1em;flex:none;opacity:.85}
    .lang-switch>summary:hover .lang-globe{opacity:1}
    .lang-switch .lang-caret{font-size:.8em;line-height:1;transition:transform .12s ease}
    .lang-switch[open] .lang-caret{transform:rotate(180deg)}
    .lang-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    /* Show the WHOLE list at a glance. Past ~12 languages a single column overflows the
       viewport, so lay the options out in a multi-column grid — 3 columns on desktop, 2 then 1
       as the screen narrows. Pure CSS on the native <details>, no capped scroll box that hides
       options. `auto` columns size to the widest endonym so nothing clips; the 1-column phone
       fallback keeps a max-height safety for an unusually short window. */
    .lang-menu{position:absolute;top:calc(100% + .5rem);inset-inline-end:0;z-index:50;
      display:grid;grid-template-columns:repeat(3,auto);gap:0 .15rem;max-width:calc(100vw - 1.5rem);
      margin:0;padding:.25rem;list-style:none;border-radius:8px;box-shadow:0 8px 28px rgba(15,23,42,.16)}
    @media (max-width:640px){.lang-menu{grid-template-columns:repeat(2,auto)}}
    @media (max-width:400px){.lang-menu{grid-template-columns:1fr;max-height:calc(100dvh - 5rem);overflow-y:auto}}
    .lang-menu li{margin:0}
    .lang-menu .lang-opt{display:flex;align-items:center;gap:.5rem;padding:.4rem .6rem;
      border-radius:6px;text-align:start;white-space:nowrap;text-decoration:none}
    .lang-menu .lang-mark{inline-size:1em;flex:none;text-align:center}
    /* The Tailwind build only emitted .bg-surface/70 (the header uses it); plain .bg-surface,
       added later on the switcher dropdown and the language banner, was never compiled — so the
       dropdown rendered with NO background and the page showed through. Define it here so the
       fix does not depend on a CSS rebuild. */
    .bg-surface{background-color:var(--color-surface, #fff)}
  </style>
  
  <script>
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.code-copy');
      if (!btn) return;
      var code = btn.parentElement.querySelector('code');
      if (!code) return;
      var text = code.textContent;
      if (btn.getAttribute('data-label') === null) btn.setAttribute('data-label', btn.textContent);
      var flash = function (label, cls) {
        btn.textContent = label;
        btn.classList.add(cls);
        setTimeout(function () {
          btn.textContent = btn.getAttribute('data-label');
          btn.classList.remove(cls);
        }, 1600);
      };
      var done = function () { flash(btn.getAttribute('data-copied') || 'Copied!', 'copied'); };
      var failed = function () { flash(btn.getAttribute('data-failed') || 'Press Ctrl+C', 'copy-failed'); };
      var legacy = function () {
        var ta = document.createElement('textarea');
        ta.value = text; ta.readOnly = true;
        ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select(); ta.setSelectionRange(0, text.length);
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
        document.body.removeChild(ta);
        (ok ? done : failed)();
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(legacy);
      } else {
        legacy();
      }
    });
  </script>
  <script>
    (function () {
      var PATH = "/learn";
      
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-setlang]');
        if (!a) return;
        document.cookie = 'lang=' + encodeURIComponent(a.getAttribute('data-setlang'))
          + '; path=' + PATH + '; max-age=31536000; samesite=lax';
      });
      var langSwitches = document.querySelectorAll('details.lang-switch');
      Array.prototype.forEach.call(langSwitches, function (d) {
        var s = d.querySelector('summary'); if (!s) return;
        var sync = function () { s.setAttribute('aria-expanded', d.open ? 'true' : 'false'); };
        sync(); d.addEventListener('toggle', sync);
      });
      var closeLangOutside = function (e) {
        Array.prototype.forEach.call(langSwitches, function (d) {
          if (d.open && !d.contains(e.target)) d.open = false;
        });
      };
      document.addEventListener('pointerdown', closeLangOutside);
      document.addEventListener('focusin', closeLangOutside);
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        Array.prototype.forEach.call(langSwitches, function (d) {
          if (d.open) { d.open = false; var s = d.querySelector('summary'); if (s) s.focus(); }
        });
      });
      var el = document.getElementById('lang-banner'), data = document.getElementById('lang-banner-data');
      if (!el || !data) return;
      var map; try { map = JSON.parse(data.textContent || '{}'); } catch (e) { return; }
      var normLang = function (tag) {
        tag = (tag || '').toLowerCase();
        var primary = tag.split('-')[0];
        if (primary === 'zh') { if (/hant|tw|hk|mo/.test(tag)) return ''; return 'zh-hans'; }
        return primary;
      };
      var pref = document.cookie.split('; ').reduce(function (acc, c) {
        var i = c.indexOf('='); return c.slice(0, i) === 'lang' ? decodeURIComponent(c.slice(i + 1)) : acc;
      }, '');
      var chosen = '';
      if (pref) {
        if (map[pref]) chosen = pref;
      } else {
        var navs = (navigator.languages && navigator.languages.length)
          ? navigator.languages : [navigator.language || ''];
        for (var i = 0; i < navs.length && !chosen; i++) {
          var code = normLang(navs[i]);
          if (code && map[code]) chosen = code;
        }
      }
      if (!chosen) return;
      pref = chosen;
      var key = 'lb_x_' + pref;
      try { if (sessionStorage.getItem(key) === '1') return; } catch (e) {}
      var link = document.getElementById('lang-banner-link');
      link.textContent = map[pref].text; link.href = map[pref].url;
      el.hidden = false;
      var x = document.getElementById('lang-banner-x');
      if (x) x.addEventListener('click', function () {
        el.hidden = true; try { sessionStorage.setItem(key, '1'); } catch (e) {}
      });
    })();
  </script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"d2d602f2775c49029b2d89214051525d","spa":2}' crossorigin="anonymous"></script>
