  <main class="max-w-5xl mx-auto px-6 py-12">
    
<article class="post-article layout-default mx-auto max-w-[680px]" style="--post-accent: #06B6D4">
  
<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-4 font-mono text-[11px] text-muted">
