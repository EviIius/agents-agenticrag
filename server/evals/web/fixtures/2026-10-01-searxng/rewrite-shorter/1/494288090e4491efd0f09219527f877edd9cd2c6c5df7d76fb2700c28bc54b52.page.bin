<script>
(function () {
  var el = document.getElementById('sr-gslidein');
  if (!el) return;
  var KEY = 'sr_gslidein_dismissed', shown = false;
  try {
    if (localStorage.getItem('sr_subscribed')) return;
    var until = +localStorage.getItem(KEY) || 0;
    if (Date.now() < until) return;
  } catch (e) {}
  function maybeShow() {
    if (shown) return;
    var doc = document.documentElement;
    var depth = (window.scrollY + window.innerHeight) / doc.scrollHeight;
    if (depth < 0.10) return;
    shown = true;
    el.hidden = false;
    requestAnimationFrame(function () { el.classList.add('sr-show'); });
    window.removeEventListener('scroll', maybeShow);
  }
  function dismiss() {
    el.classList.remove('sr-show');
    setTimeout(function () { el.hidden = true; }, 350);
    try { localStorage.setItem(KEY, String(Date.now() + 7 * 86400e3)); } catch (e) {}
  }
  window.addEventListener('scroll', maybeShow, { passive: true });
  document.getElementById('sr-gslidein-close').addEventListener('click', dismiss);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && el.classList.contains('sr-show')) dismiss();
  });
})();
</script>



