rContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CCkQ0f0TGAAiEwjBm_a275mXAxWPlMsBHQoDPck=","visibility":{"types":"12"}}}}}},{"videoDescriptionHeaderRenderer":{"channel":{"simpleText":"Tailscale"},"views":{"simpleText":"72,912 views"},"publishDate":{"simpleText":"Oct 28, 2025"},"factoid":[{"factoidRenderer":{"value":{"simpleText":"2.5K"},"label":{"simpleText":"Likes"},"accessibilityText":"2.5 thousand likes","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgttRUxBZzUwbGpTQSDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"72K"},"label":{"simpleText":"Views"},"accessibilityText":"72,912 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Oct 28"},"label":{"simpleText":"2025"},"accessibilityText":"Oct 28, 2025","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","position":"FACTOID_POSITION_LAST"}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBUQ040EGAciEwjBm_a275mXAxWPlMsBHQoDPcnKAQTx560x","commandMetadata":{"webCommandMetadata":{"url":"/@Tailscale","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCcdv38QxPjSMqbt5ffLhJLA","canonicalBaseUrl":"/@Tailscale"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/K3B5Hdi7j4zy2y53nlQCQb9J0qHNuSXhD2hWysrwaiDvv19tPr5RY04QuQfFOvb9rDq9cugGjZU=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Tailscale Services is a new beta feature that makes it easy to publish, load balance, and scale internal applications across your Tailnet. In this video, Alex walks through how to set up and use Tailscale Services to securely expose apps, manage TLS, and automatically route traffic to the best available instance. Whether you’re hosting apps at home or across cloud regions, Tailscale handles it all seamlessly.\n\nThis launch is part of the Tailscale Fall Update series, featuring new releases, live events, and deep dives every day this week. Watch the full demo to see how Tailscale Services works in practice, and join the community on Discord to share your feedback and use cases. Subscribe for more updates throughout the week.\n\nLinks: \n\nhttps://tailscale.com/blog/services-beta\nhttps://tailscale.com/blog/fall-updat...\n\nChapters:\n\n00:00 - Start\n01:41 - What is Tailscale Services?\n06:25 - Setting up a Tailscale Service from scratch\n13:25 - Outro","commandRuns":[{"startIndex":743,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwjBm_a275mXAxWPlMsBHQoDPclIoJqW6bmQsKGYAcoBBPHnrTE=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRXhFV21laTJNUmdtR0dYdktEOFA1T3xBTl9pYzRlZzNoeDg1NFY0cGFZdGdGVzJiVTNPNkhKRHhJTlZFV2M5eXJyclNRenZGUEZkWG52SWZzUjY1NUZnUlBBdzRtVWFtVWZWcW45STI2ZEs2dk5Cek4xazNaV1RiRWpr\u0026q=https%3A%2F%2Ftailscale.com%2Fblog%2Fservices-beta\u0026v=mELAg50ljSA","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRXhFV21laTJNUmdtR0dYdktEOFA1T3xBTl9pYzRlZzNoeDg1NFY0cGFZdGdGVzJiVTNPNkhKRHhJTlZFV2M5eXJyclNRenZGUEZkWG52SWZzUjY1NUZnUlBBdzRtVWFtVWZWcW45STI2ZEs2dk5Cek4xazNaV1RiRWpr\u0026q=https%3A%2F%2Ftailscale.com%2Fblog%2Fservices-beta\u0026v=mELAg50ljSA","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":784,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwjBm_a275mXAxWPlMsBHQoDPclIoJqW6bmQsKGYAcoBBPHnrTE=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QU