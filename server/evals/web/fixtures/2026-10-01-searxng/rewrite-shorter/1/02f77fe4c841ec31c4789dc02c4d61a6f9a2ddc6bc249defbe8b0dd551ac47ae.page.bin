    var cls = document.getElementById("tiSearchClose");
    var timer = null;

    function openS() { if(!overlay) return; overlay.style.display="flex"; setTimeout(function(){ overlay.classList.add("ti-search-overlay--open"); inp.focus(); },10); }
    function closeS() { if(!overlay) return; overlay.classList.remove("ti-search-overlay--open"); setTimeout(function(){ overlay.style.display="none"; res.innerHTML=""; inp.value=""; },300); }

    if(tog) tog.addEventListener("click", openS);
    if(cls) cls.addEventListener("click", closeS);
    if(overlay) overlay.addEventListener("click", function(e){ if(e.target===overlay) closeS(); });
    document.addEventListener("keydown", function(e){ if(e.key==="Escape") closeS(); if((e.key==="k"||e.key==="K")&&(e.metaKey||e.ctrlKey)){ e.preventDefault(); openS(); }});

    if(inp) inp.addEventListener("input", function(){
        clearTimeout(timer);
        var v = this.value.trim();
        if(v.length<2){ res.innerHTML=""; return; }
        timer = setTimeout(function(){
            var x = new XMLHttpRequest();
            x.open("GET","https://tech-insider.org/ca/wp-admin/admin-ajax.php?action=ti_live_search&q="+encodeURIComponent(v));
            x.onload = function(){
                if(x.status!==200) return;
                var d = JSON.parse(x.responseText);
                if(!d.length){ res.innerHTML='<div class="ti-search-noresult">No results found</div>'; return; }
                var h = "";
                d.forEach(function(r){
                    h += '<a href="'+r.url+'" class="ti-search-result">';
                    if(r.thumb) h += '<img src="'+r.thumb+'" class="ti-search-result__thumb" alt="" />';
                    h += '<div class="ti-search-result__text"><div class="ti-search-result__title">'+r.title+'</div>';
                    h += '<div class="ti-search-result__meta">'+(r.cat?'<span class="ti-search-result__cat">'+r.cat+'</span>':'')+'<span>'+r.date+'</span></div></div></a>';
                });
                res.innerHTML = h;
            };
            x.send();
        }, 300);
    });
});
</script>

<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"a1b3ace0a90547449495db299e857266","r":1,"spa":2}' crossorigin="anonymous"></script>
</body>
</html>
