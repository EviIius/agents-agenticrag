        el.style.transform = "translateY(20px)";
        el.style.transition = "opacity 0.6s ease, transform 0.6s ease";
        observer.observe(el);
    });

    var s = document.createElement("style");
    s.textContent = ".ti-visible{opacity:1!important;transform:translateY(0)!important;}";
    document.head.appendChild(s);

    document.querySelectorAll(".ti-section__accent").forEach(function(el) {
        el.style.animation = "glowPulse 3s ease infinite";
    });

    var hero = document.querySelector(".ti-hero__main");
    if (hero) {
        var sc = document.createElement("div");
        sc.style.cssText = "position:absolute;inset:0;pointer-events:none;z-index:4;background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,0.03) 2px,rgba(0,0,0,0.03) 4px);";
