hildren\",\"segmentPath\":[\"children\",\"docs\",\"children\"],\"error\":\"$11\",\"errorStyles\":[],\"errorScripts\":[],\"template\":[\"$\",\"$La\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$L12\",\"notFoundStyles\":[]}]]}]}]]\n"])</script><script>self.__next_f.push([1,"7:[[\"$\",\"div\",null,{\"className\":\"col-span-10 mb-8 md:col-span-7 xl:col-span-6\",\"children\":[[\"$\",\"section\",null,{\"className\":\"flex flex-col gap-6 pb-8 md:gap-8 md:pb-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"order-first md:order-2\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Docs\\\",\\\"item\\\":\\\"/docs\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Features\\\",\\\"item\\\":\\\"/docs/features\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Tailscale Serve\\\",\\\"item\\\":\\\"/docs/features/tailscale-serve\\\"}]}\"}}],[\"$\",\"$L13\",null,{\"children\":[\"$\",\"nav\",null,{\"aria-label\":\"breadcrumb\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex min-w-0 flex-wrap items-center gap-2 text-sm font-medium\",\"children\":[[\"$\",\"li\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"$L14\",null,{\"href\":\"/docs\",\"className\":\"transition-color cursor-pointer text-gray-600 hover:text-gray-800\",\"children\":\"Docs\"}],[\"$\",\"span\",null,{\"role\":\"presentation\",\"aria-hidden\":\"true\",\"className\":\"text-gray-500\",\"children\":\"›\"}]]}],[\"$\",\"li\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"$L14\",null,{\"href\":\"/docs/features\",\"className\":\"transition-color cursor-pointer text-gray-600 hover:text-gray-800\",\"children\":\"Features\"}],[\"$\",\"span\",null,{\"role\":\"presentation\",\"aria-hidden\":\"true\",\"className\":\"text-gray-500\",\"children\":\"›\"}]]}],[\"$\",\"li\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"role\":\"link\",\"aria-disabled\":\"true\",\"aria-current\":\"page\",\"className\":\"text-gray-800\",\"children\":\"Tailscale Serve\"}],false]}]]}]}]}]]}],[\"$\",\"$L15\",null,{\"fallback\":[\"$\",\"span\",null,{}],\"children\":[\"$\",\"div\",null,{\"className\":\"relative order-2 flex md:order-first md:max-w-lg\",\"children\":[\"$\",\"$L16\",null,{\"initialQuery\":\"$undefined\"}]}]}]]}],[\"$\",\"article\",null,{\"id\":\"main-content\",\"className\":\"prism markdown-content js-docHighlight order-3\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-4xl font-medium tracking-tight\",\"children\":\"Tailscale Serve\"}],[\"$\",\"$L17\",null,{\"formattedDate\":\"Jan 20, 2026\",\"lastValidated\":\"2026-01-20\",\"docPath\":\"features/tailscale-serve\"}],[\"$\",\"$L15\",null,{\"fallback\":[\"$\",\"$L11\",null,{}],\"children\":[\"$\",\"div\",null,{\"className\":\"ts-prose\",\"children\":[[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],[\"$\",\"p\",null,{\"children\":[\"The CLI commands for both \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/tailscale-cli/funnel\",\"children\":\"Tailscale Funnel\"}],\" and \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/tailscale-cli/serve\",\"children\":\"Tailscale Serve\"}],\" have changed in the 1.52 version of the Tailscale client. If you've used Funnel or Serve in previous versions, we recommend reviewing the CLI documentation.\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Tailscale Serve lets you route traffic from other devices on your Tailscale network (known as a tailnet) to a local service running on your device. You can think of this as sharing the service, such as a website, with the rest of your tailnet. This page provides information about how Serve works and how to get started with it in your tailnet. For more specific use cases, refer to \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/examples/serve\",\"children\":\"Tailscale Serve examples\"}],\".\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-[#86efac] bg-[#f0fdf4] pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-[#15803d]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"}],[\"$\",\"polyline\",null,{\"points\":\"22 4 12 14.01 9 11.01\"}]]}]}],[\"$\",\"p\",null,{\"children\":[\"If you'd like to share local services publicly over the internet, use \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/tailscale-funnel\",\"children\":\"Tailscale Funnel\"}],\" instead.\"]}]]}],\"\\n\",[[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],\"The following related video provides additional context and examples.\"]}],[\"$\",\"figure\",null,{\"children\":[\"$\",\"iframe\",null,{\"src\":\"https://www.youtube.com/embed/MpxmfpCl20c?rel=0\",\"title\":\"Serve and Funnel | Tailscale Explained\",\"allow\":\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\",\"allowFullScreen\":true}]}]],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"get-started-with-serve\",\"children\":\"Get started with Serve\",\"level\":2}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-orange-300 bg-orange-50 pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-orange-700\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"9\",\"x2\":\"12\",\"y2\":\"13\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"17\",\"x2\":\"12.01\",\"y2\":\"17\"}]]}]}],[[\"$\",\"p\",null,{\"children\":\"Tailscale Serve requires you to enable HTTPS certificates in your tailnet.\"}],[\"$\",\"p\",null,{\"children\":[\"Additionally, keep in mind that \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/access-control\",\"children\":\"access control rules\"}],\" apply to Serve just like any other service. If you have access control rules that restrict access to certain devices or users, those rules will also apply to the services you're sharing with Serve.\"]}]]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"If you don't have HTTPS enabled in your tailnet, the Tailscale CLI command \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/tailscale-cli\",\"children\":[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}]}],\" provides an interactive web UI that prompts you to allow Tailscale to enable HTTPS on your behalf.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"The \",[\"$\",\"code\",null,{\"children\":\"serve\"}],\" command prompts you as needed and sends you to a web consent page to enable any unmet requirements.\"]}],\"\\n\",[\"$\",\"figure\",null,{\"className\":\"bordered\",\"children\":[null,[\"$\",\"$L19\",null,{\"src\":{\"src\":\"/_next/static/media/enable-serve.835c9b8e.png\",\"height\":1659,\"width\":1325,\"blurDataURL\":\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAYAAAAICAMAAADtGH4KAAAAD1BMVEX+/v/w8fL4+fns7O3D0e0snGHbAAAACXBIWXMAABYlAAAWJQFJUiTwAAAAJklEQVR4nDWKQQoAAAiD3Nb/3xwLOokiYBuwBKBHG0pK5TRnnh4LBQsANJAcU6AAAAAASUVORK5CYII=\",\"blurWidth\":6,\"blurHeight\":8},\"alt\":\"The 'Start using serve' web consent page\",\"width\":\"350\",\"height\":\"$undefined\"}],null]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Tailscale Funnel\"}],\" is enabled by default. If you don't plan to use \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/tailscale-funnel\",\"children\":\"Tailscale Funnel\"}],\" on the device, you can turn it off.\"]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"run-tailscale-serve\",\"children\":\"Run Tailscale Serve\",\"level\":2}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"If you run the \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/tailscale-cli\",\"children\":[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}]}],\" command and your tailnet isn't properly configured to use Tailscale Serve, it presents a login server URL that you can follow to enable the feature.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Tailscale Serve lets you serve local directories, files, plain text, or local ports with other devices in your tailnet. For example, you can proxy requests to a web server running at \",[\"$\",\"code\",null,{\"children\":\"http://127.0.0.1:3000\"}],\" using the following command:\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L1a\",null,{\"text\":\"tailscale serve 3000\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve \",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token number\",\"children\":[\"3000\"]}],\"\\n\"]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Run \",[\"$\",\"code\",null,{\"children\":\"tailscale serve --help\"}],\" for more examples.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The CLI opens a foreground session that displays the status of what it's serving and the URL you can use to access your server:\"}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L1a\",null,{\"text\":\"tailscale serve 3000\\nAvailable within your tailnet:\\nhttps://amelie-workstation.pango-lin.ts.net\\n\\n|-- / proxy http://127.0.0.1:3000\\n\\nPress Ctrl+C to exit.\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve \",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token number\",\"children\":[\"3000\"]}],\"\\nAvailable within your tailnet:\\nhttps://amelie-workstation.pango-lin.ts.net\\n\\n\",[\"$\",\"span\",\"fract-0-3\",{\"className\":\"token operator\",\"children\":[\"|\"]}],\"-- / proxy http://127.0.0.1:3000\\n\\nPress Ctrl+C to exit.\\n\"]}]}]]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"identity-headers\",\"children\":\"Identity headers\",\"level\":2}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],[\"$\",\"p\",null,{\"children\":\"Serve traffic includes identity headers when serving traffic from your tailnet using Tailscale Serve. Funnel traffic, which is publicly available, does not include identity headers.\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"When you use Serve to proxy traffic to a local service running on your device, it adds a few \",[\"$\",\"$L14\",null,{\"href\":\"/docs/concepts/tailscale-identity\",\"children\":\"Tailscale identity\"}],\" headers to the request sent to your backend. The destination server can use these headers to identify the Tailscale user associated with the request. If Serve finds the following headers on an incoming request, it will remove them for security reasons, to avoid header spoofing.\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"Tailscale-User-Login\"}],\": Filled with the requester's login name (for example, \",[\"$\",\"code\",null,{\"children\":\"alice@example.com\"}],\").\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"Tailscale-User-Name\"}],\": Filled with the requester's display name (for example, \",[\"$\",\"code\",null,{\"children\":\"Alice Architect\"}],\").\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"code\",null,{\"children\":\"Tailscale-User-Profile-Pic\"}],\": Filled with the requester's profile picture URL, if their identity provider provides one (for example, \",[\"$\",\"code\",null,{\"children\":\"https://example.com/photo.jpg\"}],\").\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"If the values contain non-ASCII values, Tailscale might use \",[\"$\",\"a\",null,{\"href\":\"https://www.rfc-editor.org/rfc/rfc2047.html\",\"children\":\"RFC2047\"}],\" \\\"Q\\\" encoding (for example, \",[\"$\",\"code\",null,{\"children\":\"=?utf-8?q?Ferris_B=C3=BCller?=\"}],\").\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],[\"$\",\"p\",null,{\"children\":[\"These identity headers are not populated for traffic originating from \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/tags\",\"children\":\"tagged devices\"}],\".\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"You can use the identity headers with a custom backend or third-party services that offer authentication proxy authentication, such as \",[\"$\",\"a\",null,{\"href\":\"https://grafana.com/docs/grafana/latest/setup-grafana/configure-security/configure-authentication/auth-proxy/#configure-auth-proxy-authentication\",\"children\":\"Grafana\"}],\".\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Although identity headers are only populated for tailnet traffic, this includes traffic from external users who have accepted a share of your device. For example, if you share a device with a friend and have it configured with a Serve proxy, Tailscale populates the identity headers when your friend visits the Serve URL.\"}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-[#86efac] bg-[#f0fdf4] pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-[#15803d]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"}],[\"$\",\"polyline\",null,{\"points\":\"22 4 12 14.01 9 11.01\"}]]}]}],[\"$\",\"p\",null,{\"children\":\"When you use the identity headers to authenticate to a backend service, it's best practice to only have the service listen on localhost. Otherwise, any user that can call your service directly (rather than with the Serve URL) could trivially provide their own values for these HTTP headers. By listening only on localhost, this limits tampering to only other services running on the Serve device, and not anyone on your LAN or tailnet.\"}]]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"app-capabilities-header\",\"children\":\"App capabilities header\",\"level\":2}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],[[\"$\",\"p\",null,{\"children\":\"Serve traffic can be configured to forward a header with selected app capabilities of the connected user or tagged device. Similar to identity headers, this isn't available for Funnel traffic, which is publicly available.\"}],[\"$\",\"p\",null,{\"children\":\"This feature is available in Tailscale v1.92 or later.\"}]]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"When you use Serve to proxy traffic to a local service running on your device, you can use the \",[\"$\",\"code\",null,{\"children\":\"--accept-app-caps\"}],\" command line flag to specify which \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/access-control/grants/grants-app-capabilities\",\"children\":\"app capabilities\"}],\" of a user or tagged node Serve should forward.\\nIf a user or tagged node that makes a request has been granted any of the app capabilities specified, Serve will convert them into serialised JSON and forward them in a header called \",[\"$\",\"code\",null,{\"children\":\"Tailscale-App-Capabilities\"}],\".\\nFor an example of what this can look like, refer to the \",[\"$\",\"a\",null,{\"href\":\"/docs/reference/examples/serve#forward-app-capabilities-to-a-local-service\",\"children\":\"Tailscale Serve examples\"}],\".\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Tailscale uses \",[\"$\",\"a\",null,{\"href\":\"https://www.rfc-editor.org/rfc/rfc2047.html\",\"children\":\"RFC2047\"}],\" \\\"Q\\\" encoding for values that contain non-ASCII characters (for example, \",[\"$\",\"code\",null,{\"children\":\"=?utf-8?q?{\\\"example.com/cap/monitoring\\\":[{\\\"role\\\":\\\"=F0=9F=90=BF=EF=B8=8F\\\"}]}?=\"}],\").\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"If Serve finds the \",[\"$\",\"code\",null,{\"children\":\"Tailscale-App-Capabilities\"}],\" header on an incoming request, Serve will remove it for security reasons, just like any Tailscale identity headers, to avoid header spoofing.\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-[#86efac] bg-[#f0fdf4] pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-[#15803d]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"}],[\"$\",\"polyline\",null,{\"points\":\"22 4 12 14.01 9 11.01\"}]]}]}],[\"$\",\"p\",null,{\"children\":\"When you use the capability headers to authorize users or tagged nodes at a backend service, it's best practice to only have the service listen on localhost. Otherwise, any user that can call your service directly (rather than with the Serve URL) could trivially provide their own values for these HTTP headers. By listening only on localhost, this limits tampering to only other services running on the Serve machine, and not anyone on your LAN or tailnet.\"}]]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"resources\",\"children\":\"Resources\",\"level\":2}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Explore the collection of \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/examples/serve\",\"children\":\"Serve use case examples\"}],\" for inspiration and ideas.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"/docs/reference/tailscale-cli/serve#use-the-proxy-protocol\",\"children\":\"Use the PROXY protocol\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"/docs/reference/tailscale-cli/serve#use-a-tcp-forwarder\",\"children\":\"Use the TCP forwarder\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"/docs/reference/tailscale-cli/serve#reset-tailscale-serve\",\"children\":\"Reset the Serve configuration\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"a\",null,{\"href\":\"/docs/reference/tailscale-cli/serve#disable-tailscale-serve\",\"children\":\"Disable Serve\"}],\".\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"limitations\",\"children\":\"Limitations\",\"level\":2}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"DNS names are restricted to your tailnet's domain name (\",[\"$\",\"code\",null,{\"children\":\"device-name.tailnet-name.ts.net\"}],\").\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Because of macOS app sandbox limitations, serving files and directories is limited to the \",[\"$\",\"$L14\",null,{\"href\":\"/docs/concepts/macos-variants\",\"children\":\"open source variant of the Tailscale client for macOS\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"The same port number cannot be used for Serve (available only within the tailnet) and Funnel (available within the tailnet and to the public) at the same time.\",\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"If the most recent command to configure the port was \",[\"$\",\"code\",null,{\"children\":\"serve\"}],\", then the port will be completely private.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"If the most recent command to configure the port was \",[\"$\",\"code\",null,{\"children\":\"funnel\"}],\", then the port will be completely public.\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"troubleshooting\",\"children\":\"Troubleshooting\",\"level\":2}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Tailscale Serve requires that you \",[\"$\",\"$L14\",null,{\"href\":\"/docs/how-to/set-up-https-certificates\",\"children\":\"enable HTTPS\"}],\" in your tailnet to automatically provision TLS certificates for your unique \",[\"$\",\"$L14\",null,{\"href\":\"/docs/concepts/tailnet-name\",\"children\":\"tailnet DNS name\"}],\". If you use the interactive CLI flow as described in the \",[\"$\",\"a\",null,{\"href\":\"#get-started-with-serve\",\"children\":\"Get started with Serve\"}],\" section, Tailscale automatically enables HTTPS if it is not already enabled.\"]}]]}]}]]}]]}],[\"$\",\"aside\",null,{\"className\":\"js-docHighlight col-span-10 h-full pb-8 md:col-span-8 md:col-start-4 xl:col-span-2 xl:col-start-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"sticky top-36 flex flex-col gap-8\",\"children\":[[\"$\",\"$L1b\",null,{\"data\":[{\"id\":\"get-started-with-serve\",\"text\":\"Get started with Serve\",\"level\":2},{\"id\":\"run-tailscale-serve\",\"text\":\"Run Tailscale Serve\",\"level\":2},{\"id\":\"identity-headers\",\"text\":\"Identity headers\",\"level\":2},{\"id\":\"app-capabilities-header\",\"text\":\"App capabilities header\",\"level\":2},{\"id\":\"resources\",\"text\":\"Resources\",\"level\":2},{\"id\":\"limitations\",\"text\":\"Limitations\",\"level\":2},{\"id\":\"troubleshooting\",\"text\":\"Troubleshooting\",\"level\":2}]}],null,[\"$\",\"div\",null,{\"className\":\"sticky top-brand-12\",\"children\":[\"$\",\"$L1c\",null,{}]}]]}]}]]\n"])</script><script>self.__next_f.push([1,"d:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"name\":\"theme-color\",\"content\":\"#fff\"}],[\"$\",\"meta\",\"2\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"3\",{\"children\":\"Tailscale Serve · Tailscale Docs\"}],[\"$\",\"meta\",\"4\",{\"name\":\"description\",\"content\":\"Explore the Tailscale Serve service.\"}],[\"$\",\"meta\",\"5\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"link\",\"6\",{\"rel\":\"canonical\",\"href\":\"https://tailscale.com/docs/features/tailscale-serve\"}],[\"$\",\"link\",\"7\",{\"rel\":\"alternate\",\"type\":\"text/markdown\",\"href\":\"https://tailscale.com/docs/features/tailscale-serve.md\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:title\",\"content\":\"Tailscale Serve · Tailscale Docs\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:description\",\"content\":\"Explore the Tailscale Serve service.\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:url\",\"content\":\"https://tailscale.com/features/tailscale-serve\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:site_name\",\"content\":\"Tailscale\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image\",\"content\":\"https://tailscale.com/files/images/