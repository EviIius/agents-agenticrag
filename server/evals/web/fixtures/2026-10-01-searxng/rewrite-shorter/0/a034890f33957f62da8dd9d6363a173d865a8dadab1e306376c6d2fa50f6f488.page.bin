    <script id="nnl-js">
(function () {
  var KEY_SUB = 'nhimg_nl_subscribed', KEY_DIS = 'nhimg_nl_dismissed';
  var DELAY = 30000, DAYS = 14, RETRY = 10000, MAX_RETRY = 6;
  var WRAPS = '.nnl-form, .nhimg-newsletter-inline, .journal-subscribe-block';
  var ASSESS = "https:\/\/nhimg.org\/nhi-ai-maturity-assessment\/?utm_source=nhimg&utm_medium=NewsletterSignup";
  var COURSE = "https:\/\/nhimg.org\/nhi-training?utm_source=nhimg&utm_medium=NewsletterSignup";
  function get(k) { try { return window.localStorage.getItem(k); } catch (e) { return null; } }
  function set(k, v) { try { window.localStorage.setItem(k, v); } catch (e) {} }

  // Find a discount code in the form's reply message (format not fixed):
  // "code: ABC123", "code is ABC123", or a stand-alone CAPS+digits token.
  function findCode(msg) {
    var m = msg.match(/code(?:\s+is)?\s*[:\-–]?\s*["“']?([A-Za-z0-9][A-Za-z0-9_-]{3,29})/i);
    if (m && (/\d/.test(m[1]) || m[1] === m[1].toUpperCase())) { return m[1]; }
    m = msg.match(/\b(?=[A-Z0-9_-]*\d)(?=[A-Z0-9_-]*[A-Z])[A-Z0-9][A-Z0-9_-]{4,29}\b/);
    return m ? m[0] : '';
  }

  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) { e.className = cls; } if (text) { e.textContent = text; } return e; }

  function showSuccess(wrap, unit, msg) {
    var old = wrap.querySelector('.nnl-ok'); if (old) { old.remove(); }
    var box = el('div', 'nnl-ok'); box.setAttribute('role', 'status');
    box.appendChild(el('strong', 'nnl-ok-t', 'You’re subscribed — thank you!'));
    if (msg) { box.appendChild(el('p', 'nnl-ok-m', msg)); }
    var row = el('div', 'nnl-ok-row'), code = findCode(msg || '');
    if (code) {
      var c = el('code', '', code), b = el('button', '', 'Copy code'); b.type = 'button';
      b.addEventListener('click', function () {
        var done = function () { b.textContent = 'Copied ✓'; };
        if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(code).then(done, function () { selectText(c); }); }
        else { selectText(c); }
      });
      row.appendChild(c); row.appendChild(b);
    }
    var a = el('a', '', 'Go to the course →'); a.href = COURSE; row.appendChild(a);
    box.appendChild(row);
    var nx = el('p', 'nnl-ok-next', 'Next: how mature is your NHI & AI agent governance? ');
    var na = el('a', '', 'Take the free 5-minute assessment →'); na.href = ASSESS; nx.appendChild(na); box.appendChild(nx);
    unit.style.display = 'none';
    unit.parentNode.insertBefore(box, unit.nextSibling);
  }
  function selectText(node) { try { var r = document.createRange(); r.selectNodeContents(node); var s = window.getSelection(); s.removeAllRanges(); s.addRange(r); } catch (e) {} }

  // Every newsletter form on the page (CF7 fires wpcf7mailsent on the .wpcf7 unit).
  document.addEventListener('wpcf7mailsent', function (e) {
    var unit = e.target && e.target.closest ? e.target.closest('.wpcf7') : null;
    var wrap = unit ? unit.closest(WRAPS) : null;
    if (!wrap) { return; }
    set(KEY_SUB, '1');
    var msg = (e.detail && e.detail.apiResponse && typeof e.detail.apiResponse.message === 'string') ? e.detail.apiResponse.message : '';
    showSuccess(wrap, unit, msg);
  });

  // ── Pop-up ──
  var pop = document.getElementById('nnl-pop');
  if (!pop) { return; }
  var box = pop.querySelector('.nnl-pop-box'), lastFocus = null, tries = 0;
  var mq = window.matchMedia('(max-width: 700px)');

  function recentlyDismissed() { var d = parseInt(get(KEY_DIS) || '0', 10); return d > 0 && (Date.now() - d) < DAYS * 864e5; }
  function otherFormOnScreen() {
    var list = document.querySelectorAll(WRAPS);
    for (var i = 0; i < list.length; i++) {
      if (pop.contains(list[i])) { continue; }
      var r = list[i].getBoundingClientRect();
      if (r.width && r.bottom > 0 && r.top < window.innerHeight) { return true; }
    }
    return false;
  }
  function open() {
    lastFocus = document.activeElement;
    pop.hidden = false;
    var modal = !mq.matches;
    box.setAttribute('aria-modal', modal ? 'true' : 'false');
    if (modal) { document.documentElement.style.overflow = 'hidden'; box.focus(); }
    requestAnimationFrame(function () { pop.classList.add('on'); });
    document.addEventListener('keydown', onKey);
  }
  function close() {
    pop.classList.remove('on'); pop.hidden = true;
    document.documentElement.style.overflow = '';
    document.removeEventListener('keydown', onKey);
    if (!get(KEY_SUB)) { set(KEY_DIS, String(Date.now())); }
    if (lastFocus && lastFocus.focus && !mq.matches) { lastFocus.focus(); }
  }
  function onKey(e) {
    if (e.key === 'Escape') { close(); return; }
    if (e.key === 'Tab' && !mq.matches) {   // keep focus inside the box while it is modal
      var f = box.querySelectorAll('a[href],button:not([disabled]),input:not([type="hidden"]):not([disabled])');
      f = Array.prototype.filter.call(f, function (n) { return n.offsetParent !== null; });
      if (!f.length) { return; }
      var first = f[0], last = f[f.length - 1];
      if (e.shiftKey && (document.activeElement === first || document.activeElement === box)) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  }
  pop.addEventListener('click', function (e) { if (e.target.closest('[data-nnl-close]')) { close(); } });
  function tryOpen() {
    if (get(KEY_SUB) || recentlyDismissed()) { return; }
    if (otherFormOnScreen()) { if (tries++ < MAX_RETRY) { setTimeout(tryOpen, RETRY); } return; }
    open();
  }
  if (!get(KEY_SUB) && !recentlyDismissed()) { setTimeout(tryOpen, DELAY); }
  window.nhimgNewsletterPopup = { open: open, close: close };   // for testing on staging
})();
</script>
<style id="nft-css">
.nft{background:#060613;color:rgba(255,255,255,.75);border-top:1px solid rgba(34,197,94,.25);margin:0;padding:56px 16px 0;font-size:15px;line-height:1.55;text-align:left}
.nft *{box-sizing:border-box}
.nft-wrap{max-width:1200px;margin:0 auto}
.nft-grid{display:grid;grid-template-columns:minmax(0,1.5fr) repeat(3,minmax(0,1fr));gap:40px}
.nft-logo img{display:block;height:52px;width:auto;max-width:100%}
.nft-desc{margin:16px 0 6px!important;color:rgba(255,255,255,.85)!important;font-size:15px!important}
.nft-trust{margin:0 0 18px!important;color:#22C55E!important;font-size:14px!important;font-weight:600}
.nft-social{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 20px!important;padding:0!important;list-style:none!important}
.nft-social li{margin:0!important;padding:0!important;list-style:none!important}
.nft-social a{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:8px;border:1px solid rgba(255,255,255,.16);color:#fff!important;font-size:17px;text-decoration:none!important}
.nft-social a:hover{border-color:#22C55E;color:#4ADE80!important}
.nft-ctas{display:flex;flex-wrap:wrap;gap:10px}
.nft-btn{display:inline-flex;align-items:center;min-height:42px;padding:0 18px;border-radius:6px;font-weight:700;font-size:14px;text-decoration:none!important}
.nft-btn.p{background:#22C55E;color:#060613!important}
.nft-btn.p:hover{background:#4ADE80}
.nft-btn.o{border:1px solid rgba(255,255,255,.3);color:#fff!important}
.nft-btn.o:hover{border-color:#22C55E}
.nft-col{display:block!important;box-shadow:none!important;border:0!important;background:none!important}
.nft-col h2{margin:0 0 14px!important;padding:0!important;font-size:13px!important;font-weight:700!important;letter-spacing:.12em;text-transform:uppercase;color:#fff!important;line-height:1.3!important;border:0!important;background:none!important}
.nft-col ul{margin:0!important;padding:0!important;list-style:none!important}
.nft-col li{margin:0!important;padding:0!important;list-style:none!important}
.nft-col a{display:inline-block;padding:5px 0;color:rgba(255,255,255,.75)!important;text-decoration:none!important;font-size:15px}
.nft-col a:hover,.nft-col a.nft-on{color:#4ADE80!important}
.nft-bottom{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 24px;margin-top:44px;padding:18px 0 22px;border-top:1px solid rgba(255,255,255,.08);font-size:13px;color:rgba(255,255,255,.6)}
.nft-bottom p{margin:0!important;color:inherit!important;font-size:13px!important}
.nft-legal{display:flex;flex-wrap:wrap;gap:6px 20px;margin:0!important;padding:0!important;list-style:none!important}
.nft-legal li{margin:0!important;padding:0!important;list-style:none!important}
.nft-legal a{color:rgba(255,255,255,.6)!important;text-decoration:none!important}
.nft-legal a:hover,.nft-legal a.nft-on{color:#4ADE80!important}
@media (max-width:1000px){.nft-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.nft-brand{grid-column:1/-1}}
@media (max-width:640px){.nft{padding-top:40px}.nft-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 20px}.nft-bottom{flex-direction:column}}
</style>
