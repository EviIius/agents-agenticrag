<!-- REMOVED 2026-09-18: Ivory Search modal removed entirely.
     Shortcode [ivory-search id="742"] was executing SQL_CALC_FOUND_ROWS
     WP_Query with LEFT JOIN wp_term_relationships on every page load
     (modal rendered server-side on every request) and on every AJAX
     keystroke (live search). With 2,400+ posts in wp_posts this was
     causing full table scans site-wide. Each page load was firing
     this query regardless of whether the user opened the search modal.
     The modal HTML and shortcode are preserved here for reference.
<div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="searchModalLabel">Search</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form data-min-no-for-search=1 data-result-box-max-height=400 data-form-id=742 class="is-search-form is-form-style is-form-style-3 is-form-id-742 is-ajax-search" action="https://nhimg.org/" method="get" role="search" ><label for="is-search-input-742"><span class="is-screen-reader-text">Search for:</span><input  type="search" id="is-search-input-742" name="s" value="" class="is-search-input" placeholder="Search for anything..." autocomplete=off /><span class="is-loader-image" style="display: none;background-image:url(https://nhimg.org/wp-content/plugins/add-search-to-menu/public/images/spinner.gif);" ></span></label><button type="submit" class="is-search-submit"><span class="is-screen-reader-text">Search Button</span><span class="is-search-icon"><svg focusable="false" aria-label="Search" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24px"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"></path></svg></span></button><input type="hidden" name="id" value="742" /></form>            </div>
        </div>
    </div>
</div>
-->
<style>
*, *::before, *::after { box-sizing: border-box; }
:root {
  --navy:   #0F2547;
  --blue:   #1A3A6B;
  --accent: #5B8DD9;
  --text:   #1C2333;
  --muted:  #5A6275;
  --border: #D4DCE8;
  --bg:     #F8FAFC;
  --white:  #FFFFFF;
}
.glos-single-header { background: #000000; padding: 48px 24px 40px; position: relative; overflow: hidden; }
.glos-single-header::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(135deg, transparent, transparent 40px, rgba(91,141,217,0.05) 40px, rgba(91,141,217,0.05) 41px);
  pointer-events: none;
}
.glos-header-inner { max-width: 1200px; margin: 0 auto; }
.glos-single-breadcrumb {
  font-family: 'Courier New', monospace; font-size: 11px;
  color: #7A9BC4; letter-spacing: 0.06em; margin-bottom: 20px;
}
.glos-single-breadcrumb a { color: #7A9BC4; text-decoration: none; }
.glos-single-breadcrumb a:hover { color: var(--accent); }
.glos-single-breadcrumb span { margin: 0 6px; }
.glos-single-domain-badge {
  display: inline-block; font-family: 'Courier New', monospace; font-size: 10px;
  letter-spacing: 0.12em; text-transform: uppercase; padding: 3px 10px; border-radius: 2px;
  background: rgba(91,141,217,0.15); color: var(--accent); border: 1px solid rgba(91,141,217,0.4);
  margin-bottom: 16px;
}
.glos-single-header h1 { font-size: clamp(24px,4vw,40px); font-weight: normal; color: #fff; line-height: 1.2; margin: 0; }
/* Two-column wrapper */
.glos-page-body { max-width: 1200px; margin: 0 auto; padding: 48px 24px 80px; }
.glos-single-wrapper { display: flex; gap: 48px; align-items: flex-start; }
/* Sidebar */
.glos-single-aside { flex: 0 0 220px; min-width: 0; position: sticky; top: 90px; }
.glos-aside-heading {
  font-family: 'Courier New', monospace; font-size: 11px; font-weight: normal;
  text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted);
  margin: 0 0 12px; padding-bottom: 8px; border-bottom: 2px solid var(--accent);
}
.glos-aside-list { list-style: none; margin: 0; padding: 0; }
.glos-aside-list li { border-bottom: 1px solid var(--border); }
.glos-aside-list a {
  display: block; padding: 9px 0; font-size: 13px; line-height: 1.45;
  color: var(--text); text-decoration: none; transition: color 0.15s;
}
.glos-aside-list a:hover { color: var(--accent); }
.glos-aside-domain-link {
  display: inline-block; margin-top: 14px;
  font-family: 'Courier New', monospace; font-size: 11px;
  color: var(--accent); text-decoration: none;
}
.glos-aside-domain-link:hover { text-decoration: underline; }
/* Main content */
.glos-single-content { flex: 1; min-width: 0; }
.glos-back-link {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: 'Courier New', monospace; font-size: 12px; color: var(--muted);
  text-decoration: none; margin-bottom: 28px; transition: color 0.15s;
}
.glos-back-link:hover { color: var(--accent); }
.glos-single-meta {
  font-family: 'Courier New', monospace; font-size: 11px; color: var(--muted);
  margin-bottom: 28px; display: flex; gap: 20px; flex-wrap: wrap;
}
.glos-primary-definition {
  font-size: 17px; color: var(--text); line-height: 1.8; font-weight: 500;
  padding: 24px 28px; background: var(--white);
  border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 4px;
  margin-bottom: 32px;
}
.glos-primary-definition p { margin-bottom: 0; }
.glos-definition-body { font-size: 16px; color: var(--text); line-height: 1.8; margin-bottom: 40px; overflow-wrap: break-word; word-break: break-word; }
.glos-definition-body p { margin-bottom: 14px; }
.glos-definition-body h2 { font-size: 19px; color: var(--navy); margin: 28px 0 12px; font-weight: 700; }
.glos-definition-body ul { list-style: disc; padding-left: 24px; margin-bottom: 14px; }
.glos-definition-body ol { list-style: decimal; padding-left: 24px; margin-bottom: 14px; }
.glos-definition-body li { margin-bottom: 6px; line-height: 1.65; }
.glos-definition-body strong { color: var(--navy); }
.glos-definition-body a { color: var(--accent); text-decoration: underline; }
.glos-definition-body a:hover { opacity: 0.8; }
/* Standards & Framework Alignment — rendered into post_content by registry.py */
.glos-definition-body .nhimg-framework-section { margin: 40px 0; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; }
.glos-definition-body .nhimg-framework-section h2 { font-size: 19px; color: var(--navy); margin: 0 0 10px; font-weight: 700; }
.glos-definition-body .nhimg-framework-purpose { font-size: 14px; color: var(--muted); margin-bottom: 8px; }
.glos-definition-body .nhimg-framework-bridge { font-size: 15px; color: var(--text); line-height: 1.65; margin-bottom: 16px; }
/* Table: proportional columns — Framework 20% | Control/Reference 35% | Relevance 45% */
.glos-definition-body .nhimg-framework-table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 13px; margin-bottom: 14px; }
.glos-definition-body .nhimg-framework-table th { background: var(--navy); color: #fff; padding: 8px 12px; font-family: 'Courier New', monospace; font-size: 11px; text-align: left; font-weight: normal; }
.glos-definition-body .nhimg-framework-table th:nth-child(1) { width: 20%; }
.glos-definition-body .nhimg-framework-table th:nth-child(2) { width: 35%; }
.glos-definition-body .nhimg-framework-table th:nth-child(3) { width: 45%; }
.glos-definition-body .nhimg-framework-table td { padding: 8px 12px; vertical-align: top; word-wrap: break-word; overflow-wrap: break-word; }
.glos-definition-body .nhimg-framework-recommendation-row td { padding: 2px 12px 10px; font-size: 13px; color: var(--text-muted, #666); line-height: 1.55; border-bottom: 1px solid var(--border); }
.glos-definition-body .nhimg-framework-table td .nhimg-framework-code { white-space: normal; word-break: break-word; display: inline; }
.glos-definition-body .nhimg-framework-code { font-family: 'Courier New', monospace; font-size: 11px; background: rgba(91,141,217,0.12); color: var(--accent); border: 1px solid rgba(91,141,217,0.3); padding: 2px 6px; border-radius: 2px; white-space: nowrap; }
.glos-definition-body .nhimg-framework-translation { font-size: 14px; color: var(--text); line-height: 1.65; border-left: 3px solid var(--accent); padding-left: 12px; margin-top: 10px; }
.glos-definition-body .nhimg-framework-summary { font-size: 12px; color: var(--muted); line-height: 1.5; display: block; margin-top: 3px; }
/* v4.2: Threat + PG sections — no container styling, matches other H2 sections */
/* DEPRECATED v4.x — nhimg-threat-section / nhimg-pg-section CSS retained for
   existing published pages generated under v4.x prompts. These classes are no
   longer emitted by v5.0 generations (TN/PG are now plain H2 sections).
   Do not remove until all v4.x pages have been regenerated. */
.glos-definition-body .nhimg-threat-section { margin: 32px 0; }
.glos-definition-body .nhimg-threat-section h2 { font-size: 19px; color: var(--navy); margin: 0 0 14px; font-weight: 700; }
.glos-definition-body .nhimg-threat-summary { font-size: 16px; color: var(--text); line-height: 1.8; margin-bottom: 16px; }
.glos-definition-body .nhimg-threat-mechanism { font-size: 16px; color: var(--text); line-height: 1.8; margin-bottom: 16px; }
.glos-definition-body .nhimg-threat-impact { font-size: 16px; color: var(--text); line-height: 1.8; margin-bottom: 16px; }
.glos-definition-body .nhimg-pg-section { margin: 32px 0; }
.glos-definition-body .nhimg-pg-section h2 { font-size: 19px; color: var(--navy); margin: 0 0 14px; font-weight: 700; }
.glos-definition-body .nhimg-pg-perspective { font-size: 16px; color: var(--text); line-height: 1.8; font-style: italic; margin-bottom: 16px; }
.glos-definition-body .nhimg-pg-actions { list-style: none; padding-left: 0; margin: 0; }
.glos-definition-body .nhimg-pg-actions li { font-size: 16px; color: var(--text); line-height: 1.8; padding: 8px 0 8px 20px; border-bottom: 1px solid var(--border); position: relative; }
.glos-definition-body .nhimg-pg-actions li::before { content: '→'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
.glos-definition-body .nhimg-pg-actions li:last-child { border-bottom: none; }
/* v5.0: Risk and Threat Considerations / Practitioner Guidance — plain H2 sections.
   H2 styled by existing .glos-definition-body h2 rule. No special TN treatment.
   PG paragraphs use standard body styling — angle labels use <strong> for structure. */
.glos-definition-body #practitioner-guidance ul { list-style: none; padding-left: 0; margin: 0; }
.glos-definition-body #practitioner-guidance ul li { padding: 8px 0 8px 20px; border-bottom: 1px solid var(--border); position: relative; }
