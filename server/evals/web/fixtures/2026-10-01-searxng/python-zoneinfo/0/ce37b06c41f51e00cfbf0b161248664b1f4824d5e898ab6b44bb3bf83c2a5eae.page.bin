    jQuery(this).removeClass('minvalInvalid');
    if( l < minLengths[id] ){
      jQuery(this).removeClass('mktoValid').addClass('minvalInvalid');
      jQuery(this).after("<div class='mktoError'>"+l+"/"+minLengths[id]+" of minimum</div>");
      return false;
