<script>/*SPJS*/
(function(){
 function boot(){
  var scope=document.querySelector('.att-single .wp-block-post-content')||document.querySelector('.att-single');
  if(!scope) return;
  var vid=scope.querySelector('.wp-block-embed, .att-video');
  if(!vid || vid.dataset.attv) return;
  vid.dataset.attv='1';
  var ph=document.createElement('div'); ph.className='att-vid-ph'; ph.style.display='none';
  vid.parentNode.insertBefore(ph, vid);
  var dismissed=false, floating=false;
  var close=document.createElement('button');
  close.className='att-vid-close'; close.type='button'; close.setAttribute('aria-label','Close video'); close.innerHTML='&times;';
  close.style.cssText='position:absolute;top:-11px;right:-11px;width:27px;height:27px;border-radius:50%;border:2px solid #fff;background:#1a1a18;color:#fff;font:600 15px/23px Inter,sans-serif;cursor:pointer;z-index:6;display:none;padding:0;box-shadow:0 2px 8px rgba(0,0,0,.3)';
  close.addEventListener("click", function(){ dismissed=true; unfloat(); });
  vid.appendChild(close);
  function doFloat(){ if(floating) return; floating=true; ph.style.height=vid.offsetHeight+"px"; ph.style.display="block"; vid.classList.add("att-vid-floating"); close.style.display="block"; }
  function unfloat(){ if(!floating) return; floating=false; vid.classList.remove("att-vid-floating"); ph.style.display="none"; close.style.display="none"; }
  function onScroll(){ if(window.scrollY < 140) dismissed=false; if(dismissed){ unfloat(); return; } var ref=floating?ph:vid; var r=ref.getBoundingClientRect(); if(r.bottom < r.height*0.5){ doFloat(); } else { unfloat(); } }
  window.addEventListener("scroll", onScroll, {passive:true});
  window.addEventListener("resize", onScroll);
  onScroll();
 }
 if(document.readyState!=='loading') boot(); else document.addEventListener('DOMContentLoaded', boot);
})();
</script>

