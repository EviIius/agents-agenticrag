yan-to-vivid-green-cyan) !important;}.has-luminous-vivid-amber-to-luminous-vivid-orange-gradient-background{background: var(--wp--preset--gradient--luminous-vivid-amber-to-luminous-vivid-orange) !important;}.has-luminous-vivid-orange-to-vivid-red-gradient-background{background: var(--wp--preset--gradient--luminous-vivid-orange-to-vivid-red) !important;}.has-very-light-gray-to-cyan-bluish-gray-gradient-background{background: var(--wp--preset--gradient--very-light-gray-to-cyan-bluish-gray) !important;}.has-cool-to-warm-spectrum-gradient-background{background: var(--wp--preset--gradient--cool-to-warm-spectrum) !important;}.has-blush-light-purple-gradient-background{background: var(--wp--preset--gradient--blush-light-purple) !important;}.has-blush-bordeaux-gradient-background{background: var(--wp--preset--gradient--blush-bordeaux) !important;}.has-luminous-dusk-gradient-background{background: var(--wp--preset--gradient--luminous-dusk) !important;}.has-pale-ocean-gradient-background{background: var(--wp--preset--gradient--pale-ocean) !important;}.has-electric-grass-gradient-background{background: var(--wp--preset--gradient--electric-grass) !important;}.has-midnight-gradient-background{background: var(--wp--preset--gradient--midnight) !important;}.has-small-font-size{font-size: var(--wp--preset--font-size--small) !important;}.has-medium-font-size{font-size: var(--wp--preset--font-size--medium) !important;}.has-large-font-size{font-size: var(--wp--preset--font-size--large) !important;}.has-x-large-font-size{font-size: var(--wp--preset--font-size--x-large) !important;}.has-xx-large-font-size{font-size: var(--wp--preset--font-size--xx-large) !important;}.has-manrope-font-family{font-family: var(--wp--preset--font-family--manrope) !important;}.has-fira-code-font-family{font-family: var(--wp--preset--font-family--fira-code) !important;}.has-fraunces-font-family{font-family: var(--wp--preset--font-family--fraunces) !important;}.has-inter-font-family{font-family: var(--wp--preset--font-family--inter) !important;}.has-light-text-shadow{text-shadow: var(--wp--preset--text-shadow--light) !important;}.has-strong-text-shadow{text-shadow: var(--wp--preset--text-shadow--strong) !important;}.footer-search .wp-block-search__input {
  background: rgba(255,255,255,0.06) !important;
  color: #fff !important;
  border-color: #3d3c37 !important;
  border-radius: 0 !important;
}
.footer-search .wp-block-search__button {
  background: #e8a23d !important;
  color: #1a1a18 !important;
  border: none !important;
  border-radius: 0 !important;
}
.footer-search .wp-block-search__inside-wrapper {
  background: rgba(255,255,255,0.06) !important;
  border-color: #3d3c37 !important;
}
.footer-cols > * {
  flex: 1 1 0 !important;
  min-width: 0;
}
@media (min-width: 782px) {
  .sidebar-sticky {
    position: sticky;
    top: 100px;          /* clears your sticky header — adjust to taste */
    align-self: flex-start;
  }
}

/* ATT mobile start */
html,body{ overflow-x:hidden; max-width:100%; }
/* Hero uses 100vw breakout + nested has-global-padding zeroing — restore gutters at ALL widths (esp. iPad) */
.force-full-width{
  padding-left: max(32px, var(--wp--style--root--padding-left, clamp(30px, 5vw, 50px))) !important;
  padding-right: max(32px, var(--wp--style--root--padding-right, clamp(30px, 5vw, 50px))) !important;
  box-sizing: border-box !important;
}
@media (max-width: 1024px){
  /* Soften 100vw scrollbar overflow on tablets */
  .force-full-width{
    max-width: 100% !important;
    width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
}
@media (max-width: 781px){
  .force-full-width .is-layout-flex.is-nowrap{ flex-wrap:wrap !important; }
  .force-full-width .is-layout-flex.is-nowrap > *{ flex-basis:100% !important; max-width:100% !important; }
  header.wp-block-template-part .wp-block-social-links{ display:none !important; }
  header.wp-block-template-part .wp-block-navigation{ margin-left:auto; }
}
/* ATT mobile end */

/* ATT toc start */
.att-toc{ border-top:1.5px solid #1a1a18; border-bottom:1.5px solid #1a1a18; padding:20px 0 22px; margin:10px 0 34px; font-family:Inter,-apple-system,sans-serif; }
.att-toc-head{ font-family:Fraunces,Georgia,serif; font-style:italic; font-weight:500; font-size:1.25rem; color:#1a1a18; margin:0 0 14px; }
.att-toc ul, .att-toc ol{ list-style:none; margin:0; padding:0; columns:2; column-gap:46px; }
.att-toc li{ break-inside:avoid; margin:0; border-bottom:1px solid #e4e1d7; }
.att-toc ul li::before, .att-toc ol li::before{ content:none !important; }
.att-toc li p{ margin:0; padding:6px 2px; }
.att-toc a{ color:#2f3e7c; text-decoration:none; font-size:.93rem; line-height:1.4; }
.att-toc a:hover{ text-decoration:underline; }
@media(max-width:781px){ .att-toc ul, .att-toc ol{ columns:1; } }
/* ATT toc end */

/* ATT reviews start */
.rv-eyebrow{ text-transform:uppercase; letter-spacing:.1em; font-size:12px; font-weight:700; color:#a9741f; margin:0 0 10px !important; }
.rv-h1{ font-family:Fraunces,Georgia,serif; font-weight:600; font-size:2.9rem; letter-spacing:-.02em; margin:0 0 12px !important; }
.rv-intro{ color:#3d3c37; font-size:1.02rem; max-width:560px; margin:0 0 34px !important; }
.rv-layout{ gap:52px !important; }
.att-reviews .wp-block-post-template{ list-style:none; margin:0; padding:0; }
.att-reviews li.wp-block-post{ display:grid; grid-template-columns:230px minmax(0,1fr); column-gap:26px; align-items:start; padding:26px 0; margin:0; border-bottom:1px solid #d9d6cb; }
.att-reviews li.wp-block-post:first-child{ padding-top:0; }
.rv-thumb{ margin:0 !important; }
.rv-thumb img{ width:100%; aspect-ratio:16/9; object-fit:cover; border:1px solid #d9d6cb; display:block; border-radius:2px; }
.rv-cat a,.rv-cat{ color:#2f3e7c !important; text-transform:uppercase; letter-spacing:.08em; font-size:11.5px; font-weight:600; text-decoration:none; }
.rv-cat{ margin:0 0 6px !important; }
.rv-title{ margin:0 0 8px !important; }
.rv-title a{ font-family:Fraunces,Georgia,serif !important; font-weight:600; font-size:1.3rem; line-height:1.28; color:#1a1a18; text-decoration:none; }
.rv-title a:hover{ color:#2f3e7c; }
.rv-excerpt{ color:#767468 !important; font-size:.88rem !important; line-height:1.55; margin:0 0 10px !important; }
.rv-date{ color:#767468 !important; font-size:11.5px !important; text-transform:uppercase; letter-spacing:.05em; margin:0 !important; }
.rv-side-h{ font-family:Fraunces,Georgia,serif !important; font-size:1rem !important; font-weight:600; margin:0 0 14px !important; padding-bottom:10px; border-bottom:1px solid #1a1a18; }
.rv-side-deals{ border:1px solid #1a1a18; padding:22px; margin-top:32px; }
.rv-side-deals p{ color:#767468; font-size:.82rem; margin:0 0 14px; }
.rv-side-deals .wp-block-button__link{ width:100%; text-align:center; background:#1a1a18; color:#f3f2ed; border-radius:0; font-size:.85rem; }
.att-reviews .wp-block-query-pagination{ margin-top:30px; }
@media(max-width:781px){ .att-reviews li.wp-block-post{ grid-template-columns:1fr; row-gap:14px; } .rv-h1{ font-size:2.1rem; } }
/* ATT reviews end */

/* ATT single start */
.att-single{ padding-top:34px; padding-bottom:20px; }
.att-single .sp-crumb{ font-size:11px !important; text-transform:uppercase; letter-spacing:.09em; color:#767468; margin:0 0 20px !important; gap:8px !important; align-items:baseline; }
.att-single .sp-crumb p{ margin:0; font-size:11px; }
.att-single .sp-crumb a{ color:#767468; text-decoration:none; }
.att-single .sp-crumb .wp-block-post-terms a{ color:#2f3e7c; }
.att-single .sp-layout{ gap:54px !important; }
.att-single .sp-title{ font-family:Fraunces,Georgia,serif !important; font-weight:600; font-size:2.6rem; line-height:1.09; letter-spacing:-.015em; margin:0 0 14px !important; }
.att-single .sp-byline{ color:#767468; font-size:.85rem; margin:0 0 26px !important; gap:12px !important; align-items:center; }
.att-single .sp-byline .wp-block-post-author-name, .att-single .sp-byline .wp-block-post-date{ color:#767468; font-size:.85rem; }
.att-single .sp-byline .wp-block-post-date a{ color:#767468; text-decoration:none; }
.att-single .sp-hero{ margin:0 0 26px !important; }
.att-single .sp-hero img{ width:100%; aspect-ratio:16/9; object-fit:cover; border:1px solid #d9d6cb; border-radius:3px; }
.att-single .sp-meta{ margin-top:38px; padding-top:22px; border-top:1px solid #d9d6cb; }
.att-single .sp-metalabel{ font-size:11px !important; text-transform:uppercase; letter-spacing:.08em; color:#767468; margin:0 0 10px !important; }
.att-single .sp-chips{ margin:0 0 16px !important; display:flex; flex-wrap:wrap; gap:8px; }
.att-single .sp-chips a{ font-size:12px; border:1px solid #d9d6cb; padding:5px 12px; border-radius:20px; color:#3d3c37; text-decoration:none; }
.att-single .sp-chips a:hover{ border-color:#1a1a18; }
.att-single .sp-chips-cat a{ background:#1a1a18; color:#f3f2ed; border-color:#1a1a18; }
.att-single .sp-side-h{ font-family:Fraunces,Georgia,serif !important; font-size:1rem !important; font-weight:600; margin:0 0 14px !important; padding-bottom:9px; border-bottom:1px solid #1a1a18; }
.att-single .sp-deals{ border:1px solid #1a1a18; padding:22px; margin-bottom:30px; }
.att-single .sp-deals h4{ font-family:Fraunces,Georgia,serif !important; font-size:1rem !important; font-weight:600; margin:0 0 6px !important; }
.att-single .sp-deals p{ color:#767468; font-size:.82rem; margin:0 0 14px; }
.att-single .sp-deals .wp-block-button__link{ width:100%; text-align:center; background:#1a1a18; color:#f3f2ed; border-radius:0; font-size:.85rem; }
.att-single .sp-side .wp-block-tag-cloud a{ font-size:12px !important; color:#2f3e7c; }
.att-single .sp-more{ margin-top:48px; padding-top:24px; border-top:2px solid #1a1a18; }
.att-single .sp-more-h{ font-family:Fraunces,Georgia,serif !important; font-size:1.4rem !important; font-weight:600; margin:0 0 20px !important; }
.att-single .sp-more .wp-block-post-template{ display:grid !important; grid-template-columns:repeat(3,1fr); gap:26px; }
.att-single .sp-more li.wp-block-post{ margin:0; }
.att-single .sp-more .wp-block-post-featured-image img{ aspect-ratio:16/9; object-fit:cover; border:1px solid #d9d6cb; margin-bottom:10px; }
.att-single .sp-more .wp-block-post-title{ font-family:Fraunces,Georgia,serif !important; font-size:1rem !important; line-height:1.3; margin:4px 0 0 !important; }
.att-single .sp-more .wp-block-post-title a{ color:#1a1a18; text-decoration:none; }
.att-single .sp-more-cat a, .att-single .sp-more-cat{ color:#2f3e7c !important; text-transform:uppercase; letter-spacing:.07em; font-size:10.5px; font-weight:600; text-decoration:none; }
@media(max-width:781px){ .att-single .sp-layout{ gap:34px !important; } .att-single .sp-title{ font-size:2rem; } .att-single .sp-more .wp-block-post-template{ grid-template-columns:1fr; } }
/* ATT single end */



/* ATT rvside start */
.att-reviews-side .wp-block-tag-cloud, .sp-side .wp-block-tag-cloud{ display:flex; flex-wrap:wrap; gap:8px; margin-top:4px; }
.att-reviews-side .wp-block-tag-cloud a, .sp-side .wp-block-tag-cloud a{ font-size:12px !important; border:1px solid #d9d6cb; padding:5px 11px; border-radius:20px; color:#3d3c37 !important; text-decoration:none; line-height:1.3; }
.att-reviews-side .wp-block-tag-cloud a:hover, .sp-side .wp-block-tag-cloud a:hover{ border-color:#1a1a18; color:#1a1a18 !important; }
.rv-search{ margin-bottom:30px; }
.rv-search .wp-block-search__label{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
.rv-search .wp-block-search__inside-wrapper{ border:1px solid #1a1a18; }
.rv-search input.wp-block-search__input{ border:none !important; border-radius:0 !important; padding:10px 12px; font-size:.86rem; background:#fff; }
.rv-search button.wp-block-search__button{ background:#1a1a18; color:#f3f2ed; border:none; border-radius:0; margin:0; padding:0 16px; font-size:.8rem; }
.rv-search button.wp-block-search__button:hover{ background:#2f3e7c; }
/* ATT rvside end */

/* ATT tagfilter start */
.att-reviews-side .wp-block-tag-cloud a{ cursor:pointer; }
.att-reviews-side .wp-block-tag-cloud a.rv-tag-active{ background:#2f3e7c; color:#fff !important; border-color:#2f3e7c; }
.rv-filter-note{ font-size:.8rem; color:#767468; margin:0 0 16px; }
.rv-filter-note b{ color:#1a1a18; }
.rv-filter-clear{ display:inline-block; margin-left:12px; padding:3px 12px; border:1px solid #2f3e7c; border-radius:20px; color:#2f3e7c; cursor:pointer; text-decoration:none; font-size:.78rem; font-weight:600; }
/* ATT tagfilter end */

/* ATT video start */
.att-vid-ph{ height:0; }
@keyframes attVidIn{ from{ transform:translateY(18px) scale(.93); opacity:0; } to{ transform:translateY(0) scale(1); opacity:1; } }
.att-vid-floating{ position:fixed !important; bottom:22px; right:22px; width:min(420px,44vw); z-index:99990; margin:0 !important; box-shadow:0 16px 46px rgba(26,26,24,.42); border-radius:8px; overflow:hidden; background:#000; animation:attVidIn .32s cubic-bezier(.2,.75,.3,1); will-change:transform,opacity; }
.att-vid-floating iframe,.att-vid-floating .wp-block-embed__wrapper{ width:100% !important; }
.att-vid-floating iframe{ aspect-ratio:16/9; height:auto !important; display:block; }
.att-vid-close{ position:absolute; top:6px; right:6px; z-index:3; background:rgba(0,0,0,.72); color:#fff; border:none; width:28px; height:28px; border-radius:50%; cursor:pointer; font-size:17px; line-height:1; display:none; align-items:center; justify-content:center; transition:background .15s; }
.att-vid-close:hover{ background:#2f3e7c; }
.att-vid-floating .att-vid-close{ display:flex; }
@media(prefers-reduced-motion:reduce){ .att-vid-floating{ animation:none; } }
@media(max-width:781px){ .att-vid-floating{ width:56vw; bottom:12px; right:12px; } }
/*ATTVIDMQ*/@media(min-width:1024px){ .att-vid-floating{ width:440px !important; } }
/* ATT video end */

/* ATT disc start */
.att-single .sqsrte-small,.att-single p.sqsrte-small{ font-size:.76rem !important; line-height:1.55 !important; color:#8a887f !important; font-style:italic; margin:0 auto 4px !important; }
.att-single .sqsrte-small a{ color:#767468; }
/* ATT disc end */

/* ATT sidebar start */
.side-h{ font-family:Fraunces,Georgia,serif !important; font-size:.82rem !important; font-weight:600; text-transform:uppercase; letter-spacing:.06em; margin:0 0 14px !important; padding-bottom:9px; border-bottom:1px solid #1a1a18; color:#1a1a18; }
.side-block{ margin-bottom:34px; }
.side-tags .wp-block-tag-cloud{ display:flex; flex-wrap:wrap; gap:8px; }
.side-tags .wp-block-tag-cloud a{ font-size:12px !important; border:1px solid #d9d6cb; padding:5px 11px; border-radius:20px; color:#3d3c37 !important; text-decoration:none; line-height:1.3; cursor:pointer; }
.side-tags .wp-block-tag-cloud a:hover{ border-color:#1a1a18; color:#1a1a18 !important; }
.side-deals{ background:#fbfaf6; border:1px solid #d9d6cb; padding:22px; border-radius:6px; }
.side-deals h4{ font-family:Fraunces,Georgia,serif !important; font-size:1.02rem !important; font-weight:600; margin:0 0 6px !important; color:#1a1a18; border:0; padding:0; }
.side-deals p{ color:#767468; font-size:.82rem; margin:0 0 14px; }
.side-form input{ width:100%; padding:10px 12px; border:1px solid #d9d6cb; background:#fff; font-size:.85rem; margin-bottom:8px; box-sizing:border-box; border-radius:3px; }
.side-form button{ width:100%; padding:11px; border:none; background:#2f3e7c; color:#fff; font-weight:600; font-size:.85rem; cursor:pointer; border-radius:3px; }
.side-form button:hover{ background:#26326a; }
.att-vid-wrap{ margin:10px 0; }
/* ATT spside start */
.att-single .sp-side{ position:sticky; top:88px; align-self:flex-start; }
.att-single .sp-side .sp-toc{ position:static; top:auto; }
@media(max-width:1024px){ .att-single .sp-side{ position:static; align-self:auto; } }
/* ATT spside end */
/* ATT sidebar end */
.att-video{ margin:12px 0; position:relative; aspect-ratio:16/9; overflow:hidden; }

/* ATT hp start */
.hp-deal-form{ display:flex; flex-wrap:wrap; gap:10px; width:100%; max-width:520px; margin:0 auto; box-sizing:border-box; }
.hp-deal-form input[type=email]{ flex:1 1 220px; min-width:0; padding:14px 16px; border:1px solid #d9d6cb; border-radius:8px; font-size:1rem; box-sizing:border-box; background:#fff; color:#1a1a18; }
.hp-deal-form button{ flex:0 0 auto; padding:14px 26px; border:none; border-radius:8px; background:#e8a23d; color:#1a1a18; font-weight:700; font-size:1rem; cursor:pointer; }
.hp-deal-form button:hover{ background:#f0b358; }
@media(max-width:600px){ .hp-deal-form button{ flex:1 1 100%; } }
.hp-deal-h{ font-family:Fraunces,Georgia,serif !important; font-size:1.7rem !important; font-weight:600; margin:0 0 8px !important; }
.hp-deal-sub{ color:#767468 !important; margin:0 0 22px !important; }
.hp-tags{ text-align:center; padding:6px 20px 4px; margin:46px auto 48px; max-width:920px; }
.hp-tags-label{ text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:700; color:#a9741f; margin:0 0 18px !important; }
.hp-topics{ display:flex; flex-wrap:wrap; gap:12px 14px; justify-content:center; max-width:640px; margin:0 auto; }
.hp-topics a{ font-size:.8rem; border:1px solid #d9d6cb; padding:8px 18px; border-radius:24px; color:#3d3c37; text-decoration:none; transition:all .15s; }
.hp-topics a:hover{ border-color:#2f3e7c; color:#2f3e7c; }
@media(max-width:781px){ .hp-gear .wp-block-column{ text-align:center; padding-left:20px !important; padding-right:20px !important; border:0 !important; } }
/* ATT hp end */

/* ATT rvmobile start */
@media(max-width:781px){
  .rv-layout{ flex-wrap:wrap; }
  .att-reviews-side{ order:-1 !important; flex-basis:100% !important; width:100% !important; display:flex; flex-direction:column; margin-bottom:10px; }
  .att-reviews-side .rv-search{ order:1; margin-bottom:18px; }
  .att-reviews-side .side-tags{ order:2; margin-bottom:6px; }
  .att-reviews-side .side-deals{ display:none !important; }
  .rv-layout > .wp-block-column:not(.att-reviews-side){ order:2; flex-basis:100% !important; width:100% !important; }
}
/* ATT rvmobile end */

/* ATT focus start */
.hp-deal-form input:focus, .side-form input:focus, .attn-form input:focus, .rv-deal-form input:focus, .wp-block-search__input:focus{ outline:2px solid #2f3e7c !important; outline-offset:1px; }
.hp-deal-form button:focus-visible, .side-form button:focus-visible, .attn-form button:focus-visible{ outline:2px solid #2f3e7c !important; outline-offset:2px; }
.hp-deal-form input:-webkit-autofill, .side-form input:-webkit-autofill, .attn-form input:-webkit-autofill{ box-shadow:0 0 0 100px #fff inset !important; -webkit-text-fill-color:#1a1a18 !important; }
/* ATT focus end */

/* ATT recform start */
.att-recform{ padding-top:36px; padding-bottom:64px; }
.rf-eyebrow{ text-transform:uppercase; letter-spacing:.14em; font-size:.72rem; font-weight:700; color:#a9741f; margin:0 0 10px !important; }
.rf-h1{ font-family:Fraunces,Georgia,serif !important; font-weight:600; font-size:2.6rem; letter-spacing:-.02em; margin:0 0 12px !important; }
.rf-intro{ color:#767468; font-size:1.05rem; max-width:600px; margin:0 0 34px !important; }
.att-recform .wp-block-jetpack-contact-form{ display:flex; flex-direction:column; gap:22px; }
.att-recform .jetpack-field label, .att-recform .grunion-field-label, .att-recform legend{ font-weight:600 !important; font-size:.92rem !important; color:#1a1a18 !important; margin-bottom:6px; }
.att-recform input[type=text], .att-recform input[type=email], .att-recform input[type=url], .att-recform select, .att-recform textarea{ border:1px solid #d9d6cb !important; border-radius:8px !important; padding:12px 14px !important; font-size:1rem !important; background:#fff !important; color:#1a1a18 !important; box-shadow:none !important; }
.att-recform input:focus, .att-recform select:focus, .att-recform textarea:focus{ outline:2px solid #E8A23D !important; outline-offset:1px; border-color:#E8A23D !important; }
.att-recform .wp-block-button__link, .att-recform button[type=submit]{ background:#E8A23D !important; color:#1a1a18 !important; border:none !important; border-radius:8px !important; font-weight:700 !important; padding:14px 30px !important; font-size:1rem !important; cursor:pointer; }
.att-recform .wp-block-button__link:hover, .att-recform button[type=submit]:hover{ background:#d8912b !important; }
/* ATT recform end */
/* ATT more start */
.sp-more-ex{ color:#767468 !important; font-size:.84rem !important; line-height:1.5; margin:6px 0 0 !important; }
.sp-more-allbtn{ margin-top:34px; }
.sp-more-allbtn .wp-block-button__link{ background:#E8A23D !important; color:#1a1a18 !important; border:none; border-radius:8px; font-weight:700; padding:13px 30px; }
.sp-more-allbtn .wp-block-button__link:hover{ background:#d8912b !important; }
/* ATT more end */
/* ATT rfcols start */
.rf-cols{ gap:50px !important; }
.rf-imgcol{ position:sticky; top:96px; }
.rf-img img{ width:100%; border-radius:10px; display:block; }
@media(max-width:781px){ .rf-imgcol{ position:static; margin-bottom:8px; } .rf-cols{ gap:24px !important; } }
/* ATT rfcols end */
/* ATT ssdcta start */
.ssd-cta{ display:flex; flex-wrap:wrap; background:#1a1a18; border-radius:12px; overflow:hidden; margin:8px 0; box-shadow:0 20px 60px rgba(26,24,21,.18); }
.ssd-img{ flex:1 1 300px; min-width:280px; }
.ssd-img img{ width:100%; height:100%; object-fit:cover; display:block; }
.ssd-body{ flex:1 1 320px; min-width:280px; padding:40px; display:flex; flex-direction:column; justify-content:center; }
.ssd-h{ color:#E8A23D; font-family:Fraunces,Georgia,serif; font-size:1.6rem; font-weight:600; margin:0 0 8px; }
.ssd-sub{ color:rgba(255,255,255,.72); font-size:.95rem; margin:0 0 24px; line-height:1.6; }
.ssd-form input{ width:100%; padding:13px 16px; border-radius:8px; border:1px solid rgba(255,255,255,.15); font-size:1rem; background:rgba(255,255,255,.08); color:#fff; outline:none; box-sizing:border-box; margin-bottom:10px; }
.ssd-form input::placeholder{ color:rgba(255,255,255,.5); }
.ssd-form input:focus{ border-color:#E8A23D; }
.ssd-form button{ width:100%; background:#E8A23D; color:#1a1a18; border:none; border-radius:8px; padding:14px 16px; font-size:1rem; font-weight:700; cursor:pointer; margin-bottom:10px; }
.ssd-form button:hover{ background:#d8912b; }
.ssd-fine{ color:rgba(255,255,255,.4); font-size:.75rem; margin:0; }
.att-results iframe{ width:100%; border:none; border-radius:10px; }
@media(max-width:781px){ .ssd-body{ padding:28px; } }
/* ATT ssdcta end */

/* ATT gold start */
.wp-block-button__link:not(.is-style-outline){ background-color:#E8A23D !important; color:#1a1a18 !important; border-radius:8px; }
.wp-block-button__link:not(.is-style-outline):hover{ background-color:#d8912b !important; }
.side-form button, .rv-deal-form button, .attn-form button, .sp-deal-form button, .hp-deal-form button{ background:#E8A23D !important; color:#1a1a18 !important; }
.side-form button:hover, .rv-deal-form button:hover, .attn-form button:hover, .sp-deal-form button:hover, .hp-deal-form button:hover{ background:#d8912b !important; }
/* ATT gold end */

/* ATT hdrbtn start */
/* Header Contact/Subscribe buttons removed — brands form lives in the footer. */
/* ATT hdrbtn end */

/* ATT hdr2 start */
@media(min-width:782px){
  header .wp-block-navigation-item.has-child > .wp-block-navigation__submenu-container{ transition:opacity .12s ease; }
  header .wp-block-navigation-item.has-child:hover > .wp-block-navigation__submenu-container, header .wp-block-navigation-item.has-child:focus-within > .wp-block-navigation__submenu-container{ visibility:visible !important; opacity:1 !important; }
  header .wp-block-navigation-item.has-child{ padding-bottom:6px; }
  header .wp-block-navigation__submenu-container{ margin-top:2px !important; }
}
/* ATT hdr2 end */
/* ATT foot start */
footer .wp-block-social-links{ gap:14px !important; }
footer .wp-block-social-link{ width:30px !important; height:30px !important; }
footer .wp-block-social-links svg{ width:30px !important; height:30px !important; }
footer .wp-block-social-link{ transition:transform .12s ease,opacity .12s ease; }
footer .wp-block-social-link:hover{ transform:translateY(-2px); opacity:.85; }
/* ATT foot end */
/* ATT sptoc start */
.sp-toc{ display:none; }
.sp-toc-inner{ border-top:1.5px solid #1a1a18; padding-top:14px; margin-bottom:30px; }
.sp-toc-head{ font-family:Fraunces,Georgia,serif; font-style:italic; font-size:15px; color:#1a1a18; margin:0 0 10px; }
.sp-toc ul{ list-style:none; margin:0; padding:0; }
.sp-toc li{ margin:0; }
.sp-toc a{ display:block; text-decoration:none; color:#767468; font-size:13px; line-height:1.35; padding:5px 0 5px 12px; border-left:2px solid #e4e1d7; transition:color .12s ease,border-color .12s ease; }
.sp-toc a:hover{ color:#1a1a18; }
.sp-toc a.is-active{ color:#1a1a18; border-left-color:#2F3E7C; font-weight:600; }
@media(min-width:1025px){
  .att-single .att-toc{ display:none; }
  .sp-toc{ display:block; position:sticky; top:88px; }
}

@media(min-width:1025px){
  .att-single .sp-side > *:not(.sp-toc){ display:block; }
  .sp-toc{ margin-top:8px; }
  .sp-toc-inner{ background:#F3F2ED; padding-bottom:14px; }
}
/* ATT sptoc end */
/* ATT sticky-fix start */
html, body{ overflow-x:clip !important; }
/* ATT sticky-fix end */
/* ATT dropdown start */
/* Desktop flyout only — these card styles break the mobile overlay menu */
@media (min-width: 782px){
  header .wp-block-navigation__submenu-container{
    background:#FBFAF6 !important;
    border:1px solid #e4e1d7 !important;
    border-radius:12px !important;
    box-shadow:0 14px 34px -10px rgba(26,24,21,.32), 0 3px 8px rgba(26,24,21,.10) !important;
    padding:7px !important;
    min-width:230px !important;
    margin-top:12px !important;
    left:-8px !important;
    transition:opacity .15s ease;
  }
  header .wp-block-navigation__submenu-container::before{
    content:""; position:absolute; top:-14px; left:0; right:0; height:16px; display:block;
  }
  header .wp-block-navigation__submenu-container .wp-block-navigation-item{ margin:0 !important; }
  header .wp-block-navigation__submenu-container .wp-block-navigation-item__content{
    display:block; border-radius:8px; padding:9px 13px !important;
    color:#1a1a18 !important; font-weight:500 !important; font-size:14px !important;
    letter-spacing:0 !important; text-transform:none !important;
    transition:background .13s ease, color .13s ease, padding-left .13s ease;
  }
  header .wp-block-navigation__submenu-container .wp-block-navigation-item__content:hover{
    background:#F1ECDF !important; color:#12100C !important; padding-left:16px !important;
  }
  header .wp-block-navigation .has-child:hover > .wp-block-navigation__submenu-container,
  header .wp-block-navigation .has-child:focus-within > .wp-block-navigation__submenu-container{
    visibility:visible !important; opacity:1 !important;
  }
  header .wp-block-navigation__container > .wp-block-navigation-item.has-child{ padding-bottom:0 !important; padding-top:0 !important; }
  header .wp-block-navigation__container > .wp-block-navigation-item{ align-items:center !important; }
}

/* Mobile header + overlay */
@media (max-width: 781px){
  /* Single-row bar: logo + hamburger only */
  header.wp-block-template-part > .wp-block-group{
    padding-top:0.85rem !important;
    padding-bottom:0.85rem !important;
    padding-left:1.15rem !important;
    padding-right:1.15rem !important;
    min-height:0 !important;
    align-items:center !important;
  }
  header.wp-block-template-part .wp-block-site-title,
  header.wp-block-template-part .wp-block-site-title a{
    white-space:nowrap !important;
    font-size:1.05rem !important;
    line-height:1.2 !important;
    max-width:none !important;
  }
  header.wp-block-template-part .wp-block-navigation{ margin-left:auto !important; }

  /* Overlay sheet */
  header .wp-block-navigation__responsive-container.is-menu-open{
    background:#FBFAF6 !important;
    color:#1a1a18 !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation-item__content,
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation-item,
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-close{
    color:#1a1a18 !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-close svg{
    fill:#1a1a18 !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-content{
    padding-top:3rem !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__container{
    gap:0 !important;
    width:100% !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__container > .wp-block-navigation-item > .wp-block-navigation-item__content{
    font-size:1.2rem !important;
    font-weight:600 !important;
    padding:0.85rem 0 !important;
    border-bottom:1px solid #e4e1d7 !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__submenu-container{
    background:transparent !important;
    border:none !important;
    border-radius:0 !important;
    box-shadow:none !important;
    min-width:0 !important;
    margin:0 !important;
    left:auto !important;
    padding:0.15rem 0 0.55rem 1rem !important;
    position:static !important;
    width:auto !important;
    opacity:1 !important;
    visibility:visible !important;
    gap:0 !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__submenu-container::before{ display:none !important; content:none !important; }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__submenu-container .wp-block-navigation-item__content{
    color:#3d3c37 !important;
    padding:0.55rem 0 !important;
    border-radius:0 !important;
    border-bottom:none !important;
    font-size:1rem !important;
    font-weight:500 !important;
  }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__submenu-container .wp-block-navigation-item__content:hover{
    background:transparent !important;
    color:#1a1a18 !important;
    padding-left:0 !important;
  }
}

/* ATT dropdown end */

/* ATT dropdown end */
/* ATT rvsticky start */
@media(min-width:1025px){
  .att-reviews-side{ position:sticky; top:88px; align-self:flex-start; }
}
/* ATT rvsticky end */
/* ATT ssdph start */
.ssd-cta input[type="text"], .ssd-cta input[type="email"]{ color:#1a1a18 !important; }
.ssd-cta input::placeholder, .ssd-form input::placeholder{ color:rgba(26,26,24,0.45) !important; opacity:1 !important; }
/* ATT ssdph end */
/* ATT ctcard start */
.ct-page{ padding-top:48px; }
.ct-card{
  background:#fff !important;
  border:1px solid #e4e1d7 !important;
  border-radius:16px;
  overflow:hidden;
  gap:0 !important;
  align-items:stretch !important;
  margin-top:0;
  box-shadow:0 18px 40px -28px rgba(26,24,21,.35);
}
.ct-card .ct-img{
  padding:28px 22px !important;
  background:#fff;
  display:flex !important;
  align-items:flex-start !important;
}
.ct-card .ct-img figure{ margin:0; width:100%; height:auto; }
.ct-card .ct-img img{
  width:100%;
  height:auto !important;
  aspect-ratio:1/1;
  min-height:0 !important;
  object-fit:cover;
  object-position:center top;
  display:block;
  border-radius:12px;
}
.ct-card .ct-body{ padding:34px 36px 40px !important; }
.ct-card .ct-title{
  font-family:Fraunces,Georgia,serif !important;
  font-weight:600 !important;
  font-size:2rem !important;
  letter-spacing:-.02em;
  color:#1a1a18 !important;
  margin:0 0 8px !important;
  text-align:left !important;
}
.ct-card .ct-intro{
  color:#5c5a52 !important;
  font-size:1.02rem !important;
  line-height:1.55;
  margin:0 0 22px !important;
  max-width:none !important;
  text-align:left !important;
}
.ct-card .grunion-field-label, .ct-card label, .ct-card .wp-block-jetpack-label{ color:#1a1a18 !important; font-weight:600 !important; font-size:13px !important; }
.ct-card .grunion-field-label span, .ct-card label span{ color:#767468 !important; font-weight:400 !important; }
.ct-card input[type="text"], .ct-card input[type="email"], .ct-card textarea{
  background:#FBFAF6 !important;
  color:#1a1a18 !important;
  border:1px solid #d9d6cb !important;
  border-radius:8px !important;
}
.ct-card input:focus, .ct-card textarea:focus{ outline:2px solid #E8A23D !important; outline-offset:1px; border-color:#E8A23D !important; }
.ct-card input::placeholder, .ct-card textarea::placeholder{ color:rgba(26,26,24,0.42) !important; opacity:1 !important; }
.ct-card .wp-block-button__link, .ct-card button[type="submit"]{ background:#E8A23D !important; color:#1a1815 !important; border:none !important; border-radius:8px !important; font-weight:600 !important; }
.ct-alt{ color:#5c5a52; font-size:1.02rem; }
.ct-note{ color:#767468; font-size:0.82rem; line-height:1.45; margin:12px 0 0 !important; }
@media(max-width:781px){
  .ct-card{ flex-direction:column; align-items:stretch !important; }
  .ct-card .ct-img{ padding:18px 18px 0 !important; }
  .ct-card .ct-img img{ aspect-ratio:1/1; }
  .ct-card .ct-body{ padding:24px 22px 28px !important; }
  .ct-card .ct-title{ font-size:1.7rem !important; }
}
/* ATT ctcard end */
/* ATT gearpg start */
.gear-page{ margin-top:64px; margin-bottom:110px; }
.gear-page .rf-intro{ max-width:660px; margin-left:auto; margin-right:auto; }
.gear-page .gear-jump{
  display:flex; flex-wrap:wrap; justify-content:center; align-items:center;
  gap:8px; margin-top:18px; padding:0 8px;
  font-family:Inter,-apple-system,sans-serif;
  font-size:12.5px; font-weight:600; letter-spacing:.04em; text-transform:uppercase;
}
.gear-page .gear-jump a{
  color:#1a1a18; text-decoration:none;
  border:1px solid #d9d6cb; background:#FBFAF6;
  padding:7px 14px; border-radius:999px; line-height:1.2;
  transition:border-color .14s ease, background .14s ease, color .14s ease;
}
.gear-page .gear-jump a:hover,
.gear-page .gear-jump a:focus-visible{
  border-color:#1a1a18; background:#1a1a18; color:#f3f2ed; outline:none;
}
.gear-page .gear-jump span{ display:none; }
.gear-alias-anchor{ position:relative; top:-90px; height:0; width:0; overflow:hidden; pointer-events:none; }
.gear-sec{ margin-top:64px; scroll-margin-top:90px; }
.gear-sec-eyebrow{ font-size:11.5px; text-transform:uppercase; letter-spacing:.14em; font-weight:700; color:#A9741F; margin:0 0 6px; }
.gear-sec-h{ font-family:Fraunces,Georgia,serif; font-weight:600; font-size:29px; margin:0 0 6px; color:#1a1a18; }
.gear-sec-sub{ color:#57544b; font-size:15px; margin:0 0 26px; }
.prod-grid{
  display:flex !important;
  flex-wrap:wrap;
  justify-content:center;
  align-items:flex-start;
  gap:22px;
}
.prod-grid > .prod-card,
.prod-grid > .wp-block-group.prod-card{
  flex:0 1 calc((100% - 66px) / 4);
  width:100%;
  max-width:320px;
  box-sizing:border-box;
  margin-top:0 !important;
  margin-bottom:0 !important;
}
.prod-card{ background:#FBFAF6; border:1px solid #e4e1d7; border-radius:14px; overflow:hidden; padding:0 !important; display:flex !important; flex-direction:column !important; height:auto; transition:transform .14s ease, box-shadow .14s ease; }
.prod-card:hover{ transform:translateY(-3px); box-shadow:0 18px 38px -22px rgba(26,24,21,.4); }
.prod-card > .prod-img,
.prod-card > figure.prod-img{
  margin:0 !important;
  width:100%;
  aspect-ratio:4 / 3;
  background:#eceae3;
  flex:0 0 auto;
}
.prod-card > .prod-img img,
.prod-card > figure.prod-img img{
  width:100% !important;
  height:100% !important;
  aspect-ratio:auto !important;
  object-fit:cover !important;
  object-position:center;
  display:block;
}
.prod-card:not(:has(> .prod-img)):not(:has(> figure.prod-img))::before{
  content:"";
  display:block;
  width:100%;
  aspect-ratio:4 / 3;
  background:#eceae3;
  flex:0 0 auto;
}
.prod-card .prod-name{ font-family:Fraunces,Georgia,serif; font-weight:600; font-size:18px; line-height:1.2; margin:16px 18px 0; color:#1a1a18; }
.prod-card .prod-blurb{ color:#6a675d; font-size:13.5px; line-height:1.5; margin:8px 18px 14px; flex:0 1 auto; }
/* Stack buy + review buttons full-width throughout */
.prod-card .wp-block-buttons{
  margin:0 18px 10px !important;
  display:flex !important;
  flex-direction:column !important;
  flex-wrap:nowrap !important;
  align-items:stretch !important;
  gap:8px !important;
  width:auto !important;
}
.prod-card .wp-block-buttons .wp-block-button,
.prod-card .wp-block-buttons .prod-btn,
.prod-card .wp-block-buttons .prod-review{
  margin:0 !important;
  flex:0 0 auto !important;
  width:100% !important;
  max-width:100% !important;
}
.prod-card .wp-block-button .wp-block-button__link{
  display:flex !important;
  align-items:center !important;
  justify-content:center !important;
  width:100% !important;
  box-sizing:border-box !important;
  border-radius:8px !important;
  text-align:center !important;
  line-height:1.2 !important;
}
.prod-card .prod-btn .wp-block-button__link{
  background:#E8A23D !important;
  color:#1a1815 !important;
  font-weight:600 !important;
  font-size:13.5px !important;
  padding:11px 16px !important;
  min-height:44px !important;
  border:none !important;
}
.prod-card .prod-review .wp-block-button__link{
  background:transparent !important;
  color:#1a1815 !important;
  border:1.5px solid #1a1815 !important;
  font-weight:600 !important;
  font-size:13.5px !important;
  padding:11px 16px !important;
  min-height:44px !important;
}
.prod-card .prod-review .wp-block-button__link:hover,
.prod-card .prod-review .wp-block-button__link:focus-visible{
  background:#1a1815 !important;
  color:#f3f2ed !important;
  outline:none !important;
}
.prod-retailers{ text-align:center; font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:#a49a86; margin:4px 18px 16px !important; }
.gear-sec-more{ margin-top:22px; font-size:13.5px; }
.gear-sec-more a{ color:#2F3E7C; text-decoration:none; font-weight:600; }
.gear-sec-more a:hover{ text-decoration:underline; }
@media(max-width:1100px){ .prod-grid > .prod-card, .prod-grid > .wp-block-group.prod-card{ flex-basis:calc((100% - 44px) / 3); max-width:340px; } }
@media(max-width:820px){ .prod-grid > .prod-card, .prod-grid > .wp-block-group.prod-card{ flex-basis:calc((100% - 22px) / 2); max-width:420px; } }
@media(max-width:560px){
  .prod-grid > .prod-card, .prod-grid > .wp-block-group.prod-card{ flex:1 1 100%; max-width:420px; }
  .gear-page .gear-jump{ gap:8px; padding:0 4px; }
  .gear-page .gear-jump a{ padding:7px 12px; font-size:11.5px; }
}

.prod-card .prod-img a{ display:block; line-height:0; }
.prod-card .prod-img a:hover img{ opacity:.92; transition:opacity .15s ease; }

.gear-hub-page .gear-hub-label{
  font-family:Fraunces,Georgia,serif; font-weight:600; font-size:22px;
  color:#1a1a18; margin:48px 0 18px; letter-spacing:-.01em;
}
.gear-hub-page .gear-dest-grid{
  display:flex !important; flex-wrap:wrap; gap:22px; justify-content:center; align-items:stretch;
}
.gear-hub-page .gear-dest{
  flex:1 1 calc(50% - 11px); max-width:520px; min-width:280px;
  background:#FBFAF6; border:1px solid #e4e1d7; border-radius:14px; overflow:hidden;
  display:flex !important; flex-direction:column !important; padding:0 !important;
  transition:transform .14s ease, box-shadow .14s ease;
}
.gear-hub-page .gear-dest:hover{ transform:translateY(-3px); box-shadow:0 18px 38px -22px rgba(26,24,21,.4); }
.gear-hub-page .gear-dest-img{ margin:0 !important; aspect-ratio:16/10; background:#eceae3; }
.gear-hub-page .gear-dest-img a{ display:block; line-height:0; height:100%; }
.gear-hub-page .gear-dest-img img{ width:100% !important; height:100% !important; object-fit:cover !important; display:block; }
.gear-hub-page .gear-dest-body{ padding:18px 20px 22px; display:flex; flex-direction:column; gap:6px; flex:1; }
.gear-hub-page .gear-dest-eyebrow{ font-size:11.5px; text-transform:uppercase; letter-spacing:.14em; font-weight:700; color:#A9741F; margin:0; }
.gear-hub-page .gear-dest-h{ font-family:Fraunces,Georgia,serif; font-weight:600; font-size:24px; margin:0; line-height:1.2; }
.gear-hub-page .gear-dest-h a{ color:#1a1a18; text-decoration:none; }
.gear-hub-page .gear-dest-h a:hover{ text-decoration:underline; text-underline-offset:3px; }
.gear-hub-page .gear-dest-blurb{ color:#57544b; font-size:15px; margin:0; line-height:1.45; flex:1; }
.gear-hub-page .gear-dest-cta{ margin:10px 0 0; }
.gear-hub-page .gear-dest-cta a{
  display:inline-block; font-family:Inter,-apple-system,sans-serif; font-size:13px; font-weight:600;
  letter-spacing:.02em; color:#1a1a18; text-decoration:none;
  border-bottom:1px solid #1a1a18; padding-bottom:1px;
}
.gear-hub-page .gear-dest-grid--guides .gear-dest{ flex:1 1 calc(50% - 11px); max-width:520px; }
@media (max-width:720px){
  .gear-hub-page .gear-dest{ flex-basis:100%; max-width:100%; }
}

/* ATT gearpg end */

/* ATT desk page writeup start */
.desk-setup-page .rf-h1{ margin-bottom:22px !important; }
.desk-setup-page .desk-tour-video{
  margin:0 auto 28px !important;
  max-width:960px;
}
.desk-setup-page .desk-tour-video.wp-block-embed,
.desk-setup-page figure.desk-tour-video{
  max-width:960px !important;
  width:100% !important;
}
.desk-setup-page .desk-tour-video .wp-block-embed__wrapper{
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 24px 50px -28px rgba(26,24,21,.45);
}
.desk-setup-page .desk-intro.rf-intro,
.desk-setup-page p.desk-intro{
  max-width:640px !important;
  margin-left:auto !important;
  margin-right:auto !important;
  margin-bottom:12px !important;
  font-family:Inter,-apple-system,sans-serif !important;
  font-size:1.05rem !important;
  line-height:1.65 !important;
  font-weight:400 !important;
  color:#57544b !important;
  text-align:center !important;
  letter-spacing:normal !important;
}
.desk-setup-page .desk-note{
  max-width:560px !important;
  margin:0 auto 4px !important;
  font-family:Inter,-apple-system,sans-serif !important;
  font-size:0.88rem !important;
  line-height:1.55 !important;
  font-weight:400 !important;
  color:#8a8578 !important;
  text-align:center !important;
}
.desk-setup-page .gear-jump{ margin-top:26px !important; margin-bottom:8px !important; }
@media (max-width:781px){
  .desk-setup-page .desk-tour-video{ margin-bottom:22px !important; }
  .desk-setup-page .desk-intro.rf-intro,
  .desk-setup-page p.desk-intro{ font-size:1rem !important; padding:0 8px; }
  .desk-setup-page .desk-note{ padding:0 12px; }
}
/* ATT desk page writeup end */



/* ATT guidespg start */
.guides-page{ margin-top:64px; margin-bottom:110px; }
.guides-page .rf-intro{ max-width:640px; margin-left:auto; margin-right:auto; }
.guides-grid{ display:grid !important; grid-template-columns:repeat(3,1fr); gap:34px 28px; margin-top:46px; list-style:none; padding:0; }
.guides-grid li.wp-block-post{ margin:0; display:flex; flex-direction:column; }
.guides-grid .guide-thumb{ margin:0 0 14px; }
.guides-grid .guide-thumb img{ width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:10px; display:block; }
.guides-grid .guide-cat{ font-size:11px; text-transform:uppercase; letter-spacing:.1em; font-weight:700; color:#2F3E7C; margin:0 0 6px; }
.guides-grid .guide-cat a{ color:#2F3E7C; text-decoration:none; }
.guides-grid .guide-title{ font-family:Fraunces,Georgia,serif; font-weight:600; font-size:20px; line-height:1.22; margin:0 0 8px; }
.guides-grid .guide-title a{ color:#1a1a18; text-decoration:none; }
.guides-grid .guide-title a:hover{ color:#2F3E7C; }
.guides-grid .guide-ex{ color:#6a675d; font-size:14px; line-height:1.5; margin:0; }
@media(max-width:900px){ .guides-grid{ grid-template-columns:repeat(2,1fr); } }
@media(max-width:560px){ .guides-grid{ grid-template-columns:1fr; } }
/* ATT guidespg end */
/* ATT widthfix start */
.gear-page, .guides-page{ --wp--style--global--content-size:1320px; max-width:1320px; }
.gear-page.is-layout-constrained > *, .guides-page.is-layout-constrained > *{ max-width:1320px; }
.gear-page .rf-intro, .guides-page .rf-intro{ max-width:640px !important; }
/* ATT widthfix end */
/* ATT gdsearch start */
.guides-search{ margin:34px auto 0; }
.guides-search .wp-block-search__inside-wrapper{ border:1px solid #d9d6cb; border-radius:999px; overflow:hidden; background:#fff; padding:3px 3px 3px 6px; }
.guides-search input.wp-block-search__input{ border:none !important; background:transparent !important; padding:10px 14px !important; font-size:15px; }
.guides-search .wp-block-search__button{ background:#1a1a18 !important; color:#fff !important; border:none !important; border-radius:999px !important; padding:9px 20px !important; font-weight:600; margin:0 !important; }
/* ATT gdsearch end */
/* ATT table start */
.wp-block-table{ overflow-x:auto; }
.wp-block-table table{ border-collapse:collapse; width:100%; font-size:14.5px; background:#fff; border:1px solid #e4e1d7; border-radius:12px; overflow:hidden; }
.wp-block-table thead th, .wp-block-table th{ background:#1A1815; color:#F3F2ED; font-family:Inter,sans-serif; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.04em; text-align:left; padding:13px 16px; border:none; }
.wp-block-table td{ padding:12px 16px; border:none; border-bottom:1px solid #ece8dd; color:#2b2a25; }
.wp-block-table tbody tr:nth-child(even){ background:#FBFAF6; }
.wp-block-table tbody tr:last-child td{ border-bottom:none; }
.wp-block-table tbody tr:hover{ background:#f4efe3; }
.wp-block-table td strong, .wp-block-table td b{ color:#1a1a18; }
.wp-block-table.is-style-stripes tbody tr:nth-child(odd){ background:#FBFAF6; }
.att-results-table caption, .wp-block-table figcaption{ color:#767468; font-size:13px; margin-top:10px; }
@media(max-width:600px){ .wp-block-table table{ font-size:13px; } .wp-block-table th, .wp-block-table td{ padding:10px 12px; } }
/* ATT table end */
/* ATT v2b start */
.att-disclaimer{font-size:.85rem;color:#6b6860;background:#efece3;border-left:3px solid #E8A23D;padding:.6em 1em;border-radius:0 4px 4px 0;margin:0 0 1.4rem}
.att-summary{border:1px solid #D9D6CB;border-top:4px solid #2F3E7C;border-radius:8px;padding:1.3rem 1.5rem;margin:1.6rem 0;background:#fbfaf6}
.att-summary-top{display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap}
.att-summary-title{font-family:'Fraunces',Georgia,serif;font-weight:600;font-size:1.3rem}
.att-summary-stars{color:#E8A23D;letter-spacing:2px}
.att-summary-num{color:#6b6860;font-size:.9rem;font-weight:600}
.att-summary-verdict{font-size:1.05rem;margin:.6rem 0 1rem}
.att-summary-cols{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;margin-bottom:1.1rem}
@media(max-width:560px){.att-summary-cols{grid-template-columns:1fr}}
.att-pc-head{font-weight:600;font-size:.78rem;letter-spacing:.05em;text-transform:uppercase;margin-bottom:.4rem}
.att-pros .att-pc-head{color:#2e7d46}.att-cons .att-pc-head{color:#b1442e}
.att-summary-cols ul{list-style:none;padding:0;margin:0}
.att-summary-cols li{position:relative;padding-left:1.4em;margin:.35em 0}
.att-pros li::before{content:"\2713";position:absolute;left:0;color:#2e7d46;font-weight:700}
.att-cons li::before{content:"\2715";position:absolute;left:0;color:#b1442e;font-weight:700}
.att-summary-buy a,.att-buy .wp-block-button__link{display:inline-block;background:#E8A23D;color:#1A1A18;font-weight:600;text-decoration:none;border-radius:4px;padding:.65rem 1.3rem}
.att-summary-buy a:hover,.att-buy .wp-block-button__link:hover{background:#A9741F;color:#F3F2ED}
.att-buy-wrap{margin:1.2rem 0}
.att-buybox{border:1px solid #D9D6CB;border-top:3px solid #2F3E7C;border-radius:6px;padding:1.2rem 1.4rem;margin:2rem 0}
.att-buybox-head{font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:1.2rem;margin-bottom:.8rem}
.att-buybox-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.6rem 0;border-top:1px solid #EFEDE6}
.att-buybox-row:first-of-type{border-top:0}
.att-buybox-name{font-weight:500}
.att-buybox-link{color:#2F3E7C;font-weight:600;white-space:nowrap;text-decoration:none}
.att-shot{margin:1.6rem 0}
.att-shot img{width:100%;height:auto;border:1px solid #D9D6CB;border-radius:6px}
.att-shot figcaption{font-family:'Fraunces',Georgia,serif;font-style:italic;font-size:.9rem;color:#5a574e;margin-top:.5rem}
.wp-block-table table{border-collapse:collapse;width:100%;margin:1.4rem 0;font-size:.95rem}
.wp-block-table td,.wp-block-table th{border:1px solid #D9D6CB;padding:.55rem .7rem;text-align:left}
.wp-block-table thead th{background:#efece3;font-family:'Fraunces',Georgia,serif;font-weight:600}
.wp-block-table tbody tr:nth-child(even){background:#faf9f4}
/* ATT v2b end */

/* ATT v2c start */
.wp-block-table{overflow-x:auto;-webkit-overflow-scrolling:touch}
.wp-block-table table{font-family:'Inter',system-ui,-apple-system,sans-serif;font-size:1rem;line-height:1.45;color:#1A1A18;width:100%;table-layout:auto}
.wp-block-table th,.wp-block-table td{padding:.65rem .9rem;color:#1A1A18;vertical-align:top;word-break:normal;overflow-wrap:break-word;hyphens:none}
.wp-block-table thead th{font-family:'Inter',system-ui,-apple-system,sans-serif;font-weight:700;background:#efece3;color:#1A1A18}
.wp-block-table td:first-child,.wp-block-table th:first-child{font-weight:600}
@media(max-width:600px){.wp-block-table table{font-size:.94rem}.wp-block-table th,.wp-block-table td{padding:.55rem .75rem}}
/* ATT v2c end */

/* ATT search start */
.att-search{ padding-bottom:70px; }
.att-search-title{ text-align:center; }
.att-search .att-search-form{ max-width:660px; margin:6px auto 44px !important; }
.att-search-list{ margin-top:0; }
.att-search-list li.wp-block-post > .rv-main:first-child{ grid-column:1 / -1; }
.att-search-list .wp-block-query-no-results{ color:#767468; font-size:1rem; padding:26px 0; }
.att-search-list .wp-block-query-no-results a{ color:#2f3e7c; }
/* ATT search end */

/* ATT table-read start */
.wp-block-table.att-upgrade-table{overflow:visible}
.wp-block-table.att-upgrade-table table{width:100%;table-layout:fixed;min-width:0}
.wp-block-table.att-upgrade-table th,
.wp-block-table.att-upgrade-table td{white-space:normal !important;min-width:0 !important;overflow-wrap:break-word;padding:.55rem .6rem}
.wp-block-table.att-upgrade-table th:nth-child(1),.wp-block-table.att-upgrade-table td:nth-child(1){width:22%}
.wp-block-table.att-upgrade-table th:nth-child(2),.wp-block-table.att-upgrade-table td:nth-child(2){width:28%}
.wp-block-table.att-upgrade-table th:nth-child(3),.wp-block-table.att-upgrade-table td:nth-child(3){width:16%}
.wp-block-table.att-upgrade-table th:nth-child(4),.wp-block-table.att-upgrade-table td:nth-child(4){width:34%}
@media(max-width:640px){
  .wp-block-table.att-upgrade-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .wp-block-table.att-upgrade-table table,
  .wp-block-table.att-upgrade-table tbody,
  .wp-block-table.att-upgrade-table tr,
  .wp-block-table.att-upgrade-table td{display:block;width:100%;min-width:0;white-space:normal !important}
  .wp-block-table.att-upgrade-table table{border:none;background:transparent}
  .wp-block-table.att-upgrade-table tr{border:1px solid #e4e1d7;border-radius:12px;background:#fff;margin:0 0 10px;padding:12px 14px}
  .wp-block-table.att-upgrade-table td{border:none;padding:2px 0}
  .wp-block-table.att-upgrade-table td:first-child{font-size:1.05rem;padding-bottom:4px}
  .wp-block-table.att-upgrade-table td:nth-child(2){color:#5a574e}
  .wp-block-table.att-upgrade-table td:nth-child(3){font-weight:700;padding:4px 0}
  .wp-block-table.att-upgrade-table td:last-child{color:#5a574e;font-size:.95rem}
}
/* ATT table-read end */

/* ATT brandform start */
.att-footer-rule{ border:none !important; height:1px !important; opacity:.9; }
.att-brandform .wp-block-jetpack-contact-form,
.att-brandform .jetpack-contact-form,
.att-brandform form.contact-form{
  display:flex;
  flex-direction:column;
  gap:14px;
  max-width:100%;
}
.att-brandform .grunion-field-wrap,
.att-brandform .jetpack-field,
.att-brandform .wp-block-jetpack-input-wrap{ margin:0 !important; }
.att-brandform .grunion-field-label,
.att-brandform .wp-block-jetpack-label,
.att-brandform legend{
  display:block;
  font-size:12px !important;
  font-weight:600 !important;
  letter-spacing:.02em;
  color:#f8f7f5 !important;
  margin:0 0 6px !important;
}
.att-brandform .grunion-label-required{ color:#9a978c !important; font-weight:500 !important; }
.att-brandform .grunion-field,
.att-brandform .wp-block-jetpack-input,
.att-brandform input[type="text"],
.att-brandform input[type="email"],
.att-brandform textarea{
  width:100% !important;
  max-width:100% !important;
  box-sizing:border-box;
  font-size:14px !important;
  line-height:1.4 !important;
  color:#fff !important;
  background:rgba(255,255,255,0.06) !important;
  border:1px solid #3d3c37 !important;
  border-radius:2px !important;
  padding:11px 14px !important;
  box-shadow:none !important;
}
.att-brandform textarea{ min-height:110px; resize:vertical; }
.att-brandform input::placeholder,
.att-brandform textarea::placeholder{ color:rgba(255,255,255,.45); }
.att-brandform input:focus,
.att-brandform textarea:focus{
  outline:2px solid #e8a23d !important;
  outline-offset:1px;
  border-color:#e8a23d !important;
}
.att-brandform .wp-block-jetpack-button,
.att-brandform .jetpack-submit-button{ margin-top:2px; width:100% !important; }
.att-brandform .wp-block-jetpack-button button,
.att-brandform .wp-block-jetpack-button .wp-block-button__link,
.att-brandform input[type="submit"],
.att-brandform button[type="submit"]{
  width:100% !important;
  background:#e8a23d !important;
  color:#1a1a18 !important;
  border:none !important;
  border-radius:2px !important;
  padding:11px !important;
  font-size:13px !important;
  font-weight:700 !important;
  cursor:pointer;
}
.att-brandform .wp-block-jetpack-button button:hover,
.att-brandform button[type="submit"]:hover{ background:#d8912b !important; }
.att-brandform .contact-form-submission{ color:#f8f7f5 !important; }
@media(max-width:781px){
  .att-brandform{ flex-direction:column !important; }
}
/* ATT brandform end */

/* ATT sitewidth start */
body{--att-site:clamp(1200px,76vw,1480px);--att-gutter:var(--wp--style--root--padding-left,clamp(30px,5vw,50px))}
body .wp-site-blocks{--wp--style--global--wide-size:var(--att-site)}
header.wp-block-group.alignfull{padding-left:max(var(--att-gutter),calc((100% - var(--att-site))/2)) !important;padding-right:max(var(--att-gutter),calc((100% - var(--att-site))/2)) !important}
main.att-single > *:not(.alignfull){max-width:var(--att-site) !important}
main.att-single > .sp-crumb{margin-left:auto !important;margin-right:auto !important}
.att-single .sp-layout > .wp-block-column:first-child .wp-block-post-content > *:not(.alignfull):not(.att-vid-floating){max-width:100% !important;margin-left:0 !important;margin-right:0 !important}
/* Homepage sections follow the site width (were capped at 1200) */
.home .wp-block-post-content > .alignwide.is-layout-constrained > *:not(.alignfull),
.home .force-full-width > .alignwide{max-width:var(--att-site) !important}
@media (max-width:900px){
 .wp-block-columns:has(> .att-reviews-side),.wp-block-columns:has(> .sp-side){flex-wrap:wrap !important}
 .wp-block-columns:has(> .att-reviews-side) > .wp-block-column,.wp-block-columns:has(> .sp-side) > .wp-block-column{flex-basis:100% !important;width:100% !important}
 .home .wp-block-post-template.columns-4{grid-template-columns:repeat(2,minmax(0,1fr)) !important}
}
@media (max-width:600px){ .home .wp-block-post-template.columns-4{grid-template-columns:1fr !important} }
/* Last dropdown (Gear) opens right-aligned so it never runs off-screen */
@media (min-width:782px){
 header .wp-block-navigation__container > .wp-block-navigation-item.has-child:last-child > .wp-block-navigation__submenu-container{left:auto !important;right:-8px !important}
 header .wp-block-navigation-submenu__toggle:focus:not(:focus-visible){outline:none !important}
}
/* ATT sitewidth end */

/* ATT navcta start */
header.wp-block-group.alignfull{padding-right:calc(max(var(--att-gutter),calc((100% - var(--att-site))/2)) + 14px) !important}
@media (min-width:782px){
 header .wp-block-navigation__container > .wp-block-navigation-item.att-nav-cta{background:#E8A23D;border-radius:8px;padding:7px 10px 7px 14px !important;margin-left:.35rem;transition:background .13s ease}
 header .wp-block-navigation__container > .wp-block-navigation-item.att-nav-cta:hover,
 header .wp-block-navigation__container > .wp-block-navigation-item.att-nav-cta:focus-within{background:#d8912b}
 header .wp-block-navigation__container > .att-nav-cta > .wp-block-navigation-item__content{color:#1a1a18 !important;font-weight:600 !important}
 header .wp-block-navigation__container > .att-nav-cta > .wp-block-navigation__submenu-icon,
 header .wp-block-navigation__container > .att-nav-cta > .wp-block-navigation-submenu__toggle{color:#1a1a18 !important}
 header .att-nav-cta > .wp-block-navigation__submenu-icon svg,
 header .att-nav-cta > .wp-block-navigation-submenu__toggle svg{stroke:#1a1a18 !important}
 header .wp-block-navigation__container > .att-nav-cta > .wp-block-navigation__submenu-container{margin-top:7px !important}
}
@media (max-width:781px){
 header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__container > .att-nav-cta > .wp-block-navigation-item__content{display:block;background:#E8A23D !important;color:#1a1a18 !important;border-radius:8px;border-bottom:none !important;padding:.8rem 1rem !important;margin-top:1.1rem}
 header .wp-block-navigation__responsive-container.is-menu-open .att-nav-cta{width:100%}
}
.gear-hub-page .gear-dest-grid--three .gear-dest{flex:1 1 calc(33.333% - 15px);max-width:none}
@media (max-width:900px){.gear-hub-page .gear-dest-grid--three .gear-dest{flex-basis:100%;max-width:100%}}
.gear-hub-page .gear-hub-more{margin:46px 0 0 !important;color:#57544b;font-size:15px}
.gear-hub-page .gear-hub-more a{color:#1a1a18;font-weight:600;text-decoration:none;border-bottom:1px solid #1a1a18}
/* ATT navcta end */

/* ATT ctbrand start */
.ct-card .ct-route{ color:#5c5a52 !important; font-size:.92rem !important; margin:-10px 0 22px !important; text-align:left !important; }
.ct-card .ct-route a{ color:#2F3E7C; font-weight:600; }
.ct-brand{ margin-top:40px !important; padding:30px 28px 34px !important; border:2px solid #1a1a18; border-radius:16px; background:#F3F2ED; }
.ct-brand .ct-brand-h{ font-family:Fraunces,Georgia,serif !important; font-weight:600 !important; font-size:1.6rem !important; letter-spacing:-.01em; margin:0 0 6px !important; color:#1a1a18 !important; }
.ct-brand .ct-brand-p{ color:#5c5a52; font-size:1.02rem; margin:0 auto 18px !important; max-width:520px; }
.ct-brand .wp-block-button__link{ background:#1a1a18 !important; color:#F3F2ED !important; border-radius:8px !important; font-weight:600 !important; padding:12px 22px !important; }
.ct-brand .wp-block-button__link:hover{ background:#000 !important; }
/* ATT ctbrand end */

/* ATT ctwide start */
@media (min-width:782px){
  .entry-content > .ct-page, .wp-block-post-content > .ct-page{ max-width:1040px !important; width:100%; margin-left:auto !important; margin-right:auto !important; }
  .ct-page .ct-card > .ct-img{ flex-basis:36% !important; }
  .ct-page .ct-card > .ct-body{ flex-basis:64% !important; }
}
/* ATT ctwide end */

/* ATT formsmobile start */
@media (max-width:781px){
  .ct-page{ padding-top:4px !important; }
  .ct-card .ct-img{ height:auto !important; min-height:0 !important; padding:22px 20px 0 !important; }
  .ct-card .ct-img figure{ width:84px !important; height:84px !important; margin:0 !important; }
  .ct-card .ct-img img{ width:84px !important; height:84px !important; aspect-ratio:1/1 !important; border-radius:50% !important; object-position:center 20% !important; }
  .ct-card .ct-body{ padding:12px 20px 24px !important; }
  .ct-card .ct-title{ font-size:1.75rem !important; }
  .ct-brand{ padding:24px 18px 26px !important; margin-top:28px !important; }
  .att-recform{ padding-top:12px !important; }
  .wp-block-jetpack-contact-form .wp-block-jetpack-button{ width:100% !important; align-self:stretch !important; }
  .wp-block-jetpack-contact-form .wp-block-jetpack-button .wp-block-button__link{ width:100% !important; min-height:50px; }
  .wp-block-jetpack-contact-form input[type=radio], .wp-block-jetpack-contact-form input[type=checkbox]{ width:20px !important; height:20px !important; flex:none; }
}
/* ATT formsmobile end */

/* ATT my-desk 16:9 frames */
.desk-setup-page .prod-card > .prod-img,
.desk-setup-page .prod-card > figure.prod-img{ aspect-ratio:16 / 9; position:relative; overflow:hidden; height:auto; min-height:0; }
.desk-setup-page .prod-card > .prod-img img,
.desk-setup-page .prod-card > figure.prod-img img{ position:absolute; inset:0; }
.desk-setup-page .prod-card:not(:has(> .prod-img)):not(:has(> figure.prod-img))::before{ aspect-ratio:16 / 9; }

/* ATT my-desk card grid + video */
.desk-setup-page .desk-tour-video,
.desk-setup-page .desk-tour-video.wp-block-embed,
.desk-setup-page figure.desk-tour-video{ max-width:720px !important; }
.desk-setup-page .prod-grid{
  display:grid !important;
  grid-template-columns:repeat(4, minmax(0, 1fr));
  align-items:stretch;
  justify-content:start;
  gap:22px;
}
.desk-setup-page .prod-grid > .prod-card,
.desk-setup-page .prod-grid > .wp-block-group.prod-card{ max-width:none; width:auto; height:100%; }
.desk-setup-page .prod-card .prod-blurb{ flex:1 1 auto; }
.desk-setup-page .prod-card .wp-block-buttons{ margin-top:auto !important; }
.desk-setup-page .prod-card > .prod-blurb:last-child{ margin-bottom:18px; }
@media (max-width:1100px){ .desk-setup-page .prod-grid{ grid-template-columns:repeat(3, minmax(0, 1fr)); } }
@media (max-width:820px){ .desk-setup-page .prod-grid{ grid-template-columns:repeat(2, minmax(0, 1fr)); } }
@media (max-width:560px){ .desk-setup-page .prod-grid{ grid-template-columns:minmax(0, 1fr); } }

/* ATT my-desk subgrid rows: image / name / blurb / buttons / retailers line up across each row */
@supports (grid-template-rows: subgrid){
  .desk-setup-page .prod-grid > .prod-card,
  .desk-setup-page .prod-grid > .wp-block-group.prod-card{
    display:grid !important;
    grid-row:span 4;
    grid-template-rows:subgrid;
    row-gap:0;
    height:auto;
  }
  .desk-setup-page .prod-card > figure.prod-img,
  .desk-setup-page .prod-card > .prod-img{ grid-row:1; }
  .desk-setup-page .prod-card > .prod-name{ grid-row:2; }
  .desk-setup-page .prod-card > .prod-blurb{ grid-row:3; align-self:start; }
  .desk-setup-page .prod-card > .wp-block-buttons{ grid-row:4; align-self:start; margin-top:0 !important; }
  .desk-setup-page .prod-card > .prod-retailers{ display:none; }
}

/* ATT my-desk no retailer line: bottom padding under buttons */
.desk-setup-page .prod-card .wp-block-buttons{ margin-bottom:18px !important; }

/* ATT nav-tablet-hamburger start */
/* Core WP only switches to the hamburger below 600px, but the header CSS is built for desktop >=782 / overlay <=781.
   Between 600 and 781px that left an unstyled inline menu (white-on-white dropdowns). Force the hamburger there. */
@media (min-width:600px) and (max-width:781px){
  header .wp-block-navigation__responsive-container-open:not(.always-shown){ display:flex !important; }
  header .wp-block-navigation__responsive-container:not(.hidden-by-default):not(.is-menu-open){ display:none !important; }
  header .wp-block-navigation__responsive-container.is-menu-open{ position:fixed !important; inset:0 !important; z-index:100000 !important; padding:clamp(1rem,4vw,2rem) !important; overflow:auto !important; }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-close{ display:flex !important; }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__container,
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__responsive-container-content{ flex-direction:column !important; align-items:flex-start !important; }
  header .wp-block-navigation__responsive-container.is-menu-open .wp-block-navigation__submenu-container{ position:static !important; opacity:1 !important; visibility:visible !important; width:auto !important; height:auto !important; }
}
/* ATT nav-tablet-hamburger end */

/* ATT my-desk editorial start */
.desk-setup-page .rf-h1{ margin-bottom:6px !important; }
.desk-setup-page .desk-updated{ font-family:Inter,-apple-system,sans-serif; font-size:.85rem; color:#8a8578; margin:0 0 30px !important; }
.desk-setup-page .desk-tour-video .wp-block-embed__wrapper{ border-radius:6px; box-shadow:none; }

/* jump links: plain text row between hairlines, not pills */
.desk-setup-page .gear-jump{
  text-transform:none !important; letter-spacing:0 !important; font-size:.92rem !important; font-weight:500 !important;
  gap:6px 22px !important; justify-content:center; max-width:1120px; margin:34px auto 0 !important;
  padding:14px 8px !important; border-top:1px solid #D9D6CB; border-bottom:1px solid #D9D6CB;
}
.desk-setup-page .gear-jump a{
  background:none !important; border:0 !important; border-radius:0 !important; padding:0 !important;
  color:#3d3c37 !important; text-decoration:none !important; font-weight:500 !important; letter-spacing:0 !important;
}
.desk-setup-page .gear-jump a:hover{ color:#1a1a18 !important; text-decoration:underline !important; text-underline-offset:4px; }

/* sections: rule-bound, left aligned */
.desk-setup-page .gear-sec{ margin-top:56px !important; padding-top:34px; border-top:1px solid #D9D6CB; scroll-margin-top:90px; }
.desk-setup-page .gear-sec-h{ font-size:1.75rem !important; margin-bottom:4px !important; }
.desk-setup-page .gear-sec-sub{ font-size:.95rem !important; margin-bottom:24px !important; }

/* cards: flat */
.desk-setup-page .prod-card{ border-radius:6px !important; border-color:#e4e1d7 !important; box-shadow:none !important; transition:none !important; }
.desk-setup-page .prod-card:hover{ transform:none !important; box-shadow:none !important; border-color:#cfcbbf !important; }
.desk-setup-page .prod-card .prod-name{ font-size:17px !important; }

/* one primary button + text links */
.desk-setup-page .prod-card .wp-block-buttons{ flex-direction:row !important; flex-wrap:wrap !important; align-items:center !important; gap:10px 18px !important; }
.desk-setup-page .prod-card .wp-block-buttons .prod-btn{ flex:1 1 100% !important; }
.desk-setup-page .prod-card .prod-btn .wp-block-button__link{ min-height:40px !important; padding:9px 14px !important; border-radius:6px !important; font-size:13.5px !important; }
.desk-setup-page .prod-card .wp-block-buttons .prod-review{ flex:0 0 auto !important; width:auto !important; }
.desk-setup-page .prod-card .prod-review .wp-block-button__link{
  background:none !important; border:0 !important; padding:0 !important; min-height:0 !important; width:auto !important;
  color:#1a1a18 !important; font-weight:500 !important; font-size:13.5px !important;
  text-decoration:underline !important; text-decoration-color:#bdb8aa !important; text-underline-offset:4px; border-radius:0 !important;
}
.desk-setup-page .prod-card .prod-review .wp-block-button__link:hover,
.desk-setup-page .prod-card .prod-review .wp-block-button__link:focus-visible{ background:none !important; color:#2F3E7C !important; text-decoration-color:#2F3E7C !important; }
/* ATT my-desk editorial end */

/* ATT camera-gear editorial start */
.camera-gear-page .rf-h1{ margin-bottom:6px !important; }
.camera-gear-page .desk-updated{ font-family:Inter,-apple-system,sans-serif; font-size:.85rem; color:#8a8578; margin:0 0 18px !important; }
.camera-gear-page .rf-intro{ margin-bottom:0 !important; }
.camera-gear-page .gear-jump{
  text-transform:none !important; letter-spacing:0 !important; font-size:.92rem !important; font-weight:500 !important;
  gap:6px 22px !important; justify-content:center; max-width:1120px; margin:30px auto 0 !important;
  padding:14px 8px !important; border-top:1px solid #D9D6CB; border-bottom:1px solid #D9D6CB;
}
.camera-gear-page .gear-jump a{ background:none !important; border:0 !important; border-radius:0 !important; padding:0 !important; color:#3d3c37 !important; text-decoration:none !important; font-weight:500 !important; letter-spacing:0 !important; }
.camera-gear-page .gear-jump a:hover{ color:#1a1a18 !important; text-decoration:underline !important; text-underline-offset:4px; }
.camera-gear-page .gear-sec{ margin-top:56px !important; padding-top:34px; border-top:1px solid #D9D6CB; scroll-margin-top:90px; }
.camera-gear-page .gear-sec-h{ font-size:1.75rem !important; margin-bottom:4px !important; }
.camera-gear-page .gear-sec-sub{ font-size:.95rem !important; margin-bottom:24px !important; }
.camera-gear-page .prod-card{ border-radius:6px !important; border-color:#e4e1d7 !important; box-shadow:none !important; transition:none !important; }
.camera-gear-page .prod-card:hover{ transform:none !important; box-shadow:none !important; border-color:#cfcbbf !important; }
.camera-gear-page .prod-card .prod-name{ font-size:17px !important; }
.camera-gear-page .prod-card .wp-block-buttons{ margin-top:auto !important; margin-bottom:18px !important; }
.camera-gear-page .prod-card .prod-btn .wp-block-button__link{ min-height:40px !important; padding:9px 14px !important; border-radius:6px !important; font-size:13.5px !important; }
/* equal-height cards in a row */
.camera-gear-page .prod-grid{ display:grid !important; grid-template-columns:repeat(4, minmax(0, 1fr)); align-items:stretch; justify-content:start; gap:22px; }
.camera-gear-page .prod-grid > .prod-card,
.camera-gear-page .prod-grid > .wp-block-group.prod-card{ max-width:none; width:auto; height:100%; }
.camera-gear-page .prod-card .prod-blurb{ flex:1 1 auto; }
@supports (grid-template-rows: subgrid){
  .camera-gear-page .prod-grid > .prod-card,
  .camera-gear-page .prod-grid > .wp-block-group.prod-card{ display:grid !important; grid-row:span 4; grid-template-rows:subgrid; row-gap:0; height:auto; }
  .camera-gear-page .prod-card > figure.prod-img,
  .camera-gear-page .prod-card > .prod-img{ grid-row:1; }
  .camera-gear-page .prod-card > .prod-name{ grid-row:2; }
  .camera-gear-page .prod-card > .prod-blurb{ grid-row:3; align-self:start; }
  .camera-gear-page .prod-card > .wp-block-buttons{ grid-row:4; align-self:start; margin-top:0 !important; }
}
@media (max-width:1100px){ .camera-gear-page .prod-grid{ grid-template-columns:repeat(3, minmax(0, 1fr)); } }
@media (max-width:820px){ .camera-gear-page .prod-grid{ grid-template-columns:repeat(2, minmax(0, 1fr)); } }
@media (max-width:560px){ .camera-gear-page .prod-grid{ grid-template-columns:minmax(0, 1fr); } }
/* ATT camera-gear editorial end */

/* ATT headings start */
.single-post .wp-block-post-content h2.wp-block-heading{font-size:clamp(1.75rem,1.2rem + 1.4vw,2.15rem);line-height:1.15;letter-spacing:-0.015em;margin-top:2.6em;margin-bottom:0.45em;padding-top:0.9em;border-top:1px solid #dcd8cf}
.single-post .wp-block-post-content h3.wp-block-heading{font-size:1.45rem;line-height:1.25;letter-spacing:-0.01em;margin-top:1.9em;margin-bottom:0.35em}
.single-post .wp-block-post-content h2.wp-block-heading+p,.single-post .wp-block-post-content h3.wp-block-heading+p{margin-top:0}
.sp-toc li.sub{padding-left:0}.sp-toc li.sub a{font-size:12px;padding:4px 0 4px 24px}.att-toc ul ul{margin:.2em 0 .35em 1.1em;padding:0}.att-toc ul ul li{font-size:.94em}
/* ATT headings end */

