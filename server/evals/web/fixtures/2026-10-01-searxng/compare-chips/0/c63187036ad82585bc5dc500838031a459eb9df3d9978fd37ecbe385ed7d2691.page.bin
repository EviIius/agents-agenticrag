<script>(function(){
var wrap=document.querySelector(".sp-more");if(!wrap)return;
var list=wrap.querySelector(".wp-block-post-template");if(!list)return;
var btn=document.querySelector(".sp-more-loadmore");if(!btn)return;
var cur=(document.body.className.match(/postid-(\d+)/)||[])[1]||0;
var STEP=6,offset=0,busy=false,ended=false;
function card(p){var img="";try{img=p._embedded["wp:featuredmedia"][0].source_url;}catch(e){}
var li=document.createElement("li");li.className="wp-block-post";
li.innerHTML=(img?'<figure class="wp-block-post-featured-image"><a href="'+p.link+'"><img src="'+img+'" alt="" style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block"></a></figure>':'')+'<h3 class="wp-block-post-title"><a href="'+p.link+'">'+p.title.rendered+'</a></h3>'+'<div class="sp-more-ex">'+(p.excerpt?p.excerpt.rendered:'')+'</div>';return li;}
function load(replace){if(busy||ended)return;busy=true;btn.textContent="Loading…";
var url="/wp-json/wp/v2/posts?categories=2050&per_page="+STEP+"&orderby=date&_embed=1&exclude="+cur+"&offset="+offset;
fetch(url).then(function(r){return r.json();}).then(function(posts){busy=false;btn.textContent="Load more reviews";
if(!posts||!posts.length){ended=true;if(replace)wrap.style.display="none";else btn.style.display="none";return;}
if(replace)list.innerHTML="";posts.forEach(function(p){list.appendChild(card(p));});offset+=posts.length;
if(posts.length<STEP){ended=true;btn.style.display="none";}
}).catch(function(){busy=false;btn.textContent="Load more reviews";});}
load(true);
btn.addEventListener("click",function(){load(false);});
})();</script>


