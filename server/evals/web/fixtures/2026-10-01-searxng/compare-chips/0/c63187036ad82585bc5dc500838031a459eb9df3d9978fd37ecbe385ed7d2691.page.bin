links.forEach(function(a){ h+='<li'+(a.closest('li li')?' class="sub"':'')+'><a href="'+a.getAttribute('href')+'">'+a.textContent.trim()+'</a></li>'; });
h+='</ul></div>'; panel.innerHTML=h; side.insertBefore(panel,side.firstChild);
var items=[].slice.call(panel.querySelectorAll('a'));
var targets=items.map(function(a){ try{return document.querySelector(a.getAttribute('href'));}catch(e){return null;} });
items.forEach(function(a,i){ a.addEventListener('click',function(e){ var t=targets[i]; if(t){ e.preventDefault(); window.scrollTo({top:t.getBoundingClientRect().top+window.pageYOffset-84, behavior:'smooth'}); } }); });
function spy(){ var idx=-1; for(var i=0;i<targets.length;i++){ var t=targets[i]; if(t){ if(t.getBoundingClientRect().top<=150){ idx=i; } } } items.forEach(function(a,i){ a.classList.toggle('is-active', i===idx); }); }
window.addEventListener('scroll', spy, {passive:true}); window.addEventListener('resize', spy); spy();
}
