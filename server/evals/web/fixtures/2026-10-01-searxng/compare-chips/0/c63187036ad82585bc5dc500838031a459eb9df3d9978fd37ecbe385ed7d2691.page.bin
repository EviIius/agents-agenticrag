<!DOCTYPE html>
<html lang="en-US">
<head>
	<meta charset="UTF-8" />
	<script id="att-kit-gate">
(function(){
  function ok(v){ return !!(v && v !== '0' && v !== 'undefined' && v !== 'null'); }
  function cookie(n){
    try{
      var m = document.cookie.match(new RegExp('(?:^|; )' + n.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '=([^;]*)'));
      return m ? decodeURIComponent(m[1]) : '';
    }catch(e){ return ''; }
  }
  function get(store, key){ try{ return store.getItem(key); }catch(e){ return null; } }
  function set(store, key, val){ try{ store.setItem(key, val); }catch(e){} }
  function known(){
    try{ if (window.convertkit && ok(String(convertkit.subscriber_id || ''))) return true; }catch(e){}
    if (ok(cookie('ck_subscriber_id')) || ok(cookie('wordpress_ck_subscriber_id'))) return true;
    try{
      var q = location.search.match(/[?&]ck_subscriber_id=([^&]+)/);
      if (q && ok(decodeURIComponent(q[1].replace(/\+/g,' ')))) return true;
    }catch(e){}
    if (get(localStorage,'attKitUnlocked') === '1') return true;
    if (get(localStorage,'attSsdUnlocked')) return true;
    if (get(localStorage,'attMacUnlocked')) return true;
    if (get(sessionStorage,'attMacQuizGate') === '1') return true;
    if (get(sessionStorage,'attSsdQuizGate') === '1') return true;
    if (get(sessionStorage,'attIpadQuizGate') === '1') return true;
    return false;
  }
  function unlockAll(){
    set(localStorage,'attKitUnlocked','1');
    set(localStorage,'attSsdUnlocked','1');
    set(localStorage,'attMacUnlocked','1');
    set(sessionStorage,'attMacQuizGate','1');
    set(sessionStorage,'attSsdQuizGate','1');
    set(sessionStorage,'attIpadQuizGate','1');
  }
  if (known()) unlockAll();
  document.addEventListener('kit_subscriber_id_removed_from_url', function(){ unlockAll(); });
})();
</script><meta name="viewport" content="width=device-width, initial-scale=1" />
