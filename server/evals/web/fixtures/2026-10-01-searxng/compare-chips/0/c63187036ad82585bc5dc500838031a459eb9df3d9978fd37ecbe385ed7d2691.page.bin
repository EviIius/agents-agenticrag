.att-vs{--vs-ink:#1a1a18;--vs-ink2:#6b6a64;--vs-line:#dcd8cf;--vs-s1:#4a4943;--vs-s2:#E8A23D;--vs-s3:#9b978c;margin:1.75rem 0 2rem;font-family:inherit;color:var(--vs-ink);font-size:15px;line-height:1.45}
.att-vs *{box-sizing:border-box}
.att-vs .vs-skel{height:140px;background:#efece6;border-radius:2px;opacity:.6}
.att-vs .vs-fig{margin:0}
.att-vs .vs-hd{border-top:2px solid var(--vs-ink);padding-top:10px;margin-bottom:14px}
.att-vs .vs-h{font-family:Fraunces,Georgia,serif;font-size:1.3rem;font-weight:600;line-height:1.2;margin:0 0 4px}
.att-vs .vs-sub{font-size:13.5px;color:var(--vs-ink2);margin:0}
.att-vs .vs-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px 32px}
.att-vs .vs-c{border-top:1px solid var(--vs-ink);padding-top:8px}
.att-vs .vs-ct{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0 0 8px}
.att-vs .vs-ct b{font-size:14.5px;font-weight:600}
.att-vs .vs-ct span{font-size:12px;color:var(--vs-ink2);white-space:nowrap}
.att-vs .vs-ct{margin-bottom:2px}.att-vs .vs-cd{font-size:12.5px;color:var(--vs-ink2);margin:0 0 8px;line-height:1.35}
.att-vs .vs-cp .vs-grid{grid-template-columns:1fr;gap:18px}
.att-vs .vs-row{display:grid;grid-template-columns:var(--vs-lw,84px) 1fr;gap:10px;align-items:center;margin:5px 0}
.att-vs .vs-rl{font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.att-vs .vs-track{display:flex;align-items:center;min-height:20px}
.att-vs .vs-bar{height:12px;min-width:2px}
.att-vs .vs-val{font-size:13px;margin-left:8px;white-space:nowrap;font-variant-numeric:tabular-nums}
.att-vs .vs-val.best{font-weight:700}
.att-vs .vs-val i{font-style:normal;font-weight:400;color:var(--vs-ink2);margin-left:6px}
.att-vs .vs-na{font-size:13px;color:var(--vs-ink2)}
.att-vs .vs-src{font-size:12px;color:var(--vs-ink2);margin:12px 0 0}
.att-vs .vs-src a{color:inherit;text-decoration:underline;text-underline-offset:2px}
.att-vs details.vs-all{margin-top:22px;border-top:1px solid var(--vs-line);border-bottom:1px solid var(--vs-line)}
.att-vs details.vs-all summary{cursor:pointer;list-style:none;padding:12px 0;font-weight:600;font-size:14.5px}
.att-vs details.vs-all summary::-webkit-details-marker{display:none}
.att-vs details.vs-all summary:after{content:"Show";float:right;font-weight:400;font-size:13px;color:var(--vs-ink2);text-decoration:underline;text-underline-offset:2px}
.att-vs details.vs-all[open] summary:after{content:"Hide"}
.att-vs .vs-tw{overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px}
.att-vs table.vs-t{width:100%;border-collapse:collapse;font-size:14px;margin:0;border:0;background:none}
.att-vs .vs-t th,.att-vs .vs-t td{padding:7px 10px;border:0;border-bottom:1px solid var(--vs-line);text-align:right;font-variant-numeric:tabular-nums;background:none}
.att-vs .vs-t th:first-child,.att-vs .vs-t td:first-child{text-align:left;padding-left:0}
.att-vs .vs-t thead th{font-weight:600;font-size:13px;border-bottom:2px solid var(--vs-ink);white-space:nowrap}
.att-vs .vs-t tr.vs-g td{padding-top:16px;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--vs-ink2);border-bottom:1px solid var(--vs-ink)}
.att-vs .vs-t td.best{font-weight:700}
.att-vs .vs-t td.na{color:var(--vs-ink2);font-size:13px}
.att-vs .vs-t td.dif{color:var(--vs-ink2);font-size:13px;white-space:nowrap}
.att-vs .vs-t .vs-u{font-size:12px;color:var(--vs-ink2)}
.att-vs .vs-tip{position:fixed;z-index:9999;pointer-events:none;background:var(--vs-ink);color:#fff;font-size:12.5px;padding:5px 8px;display:none;max-width:260px}
.wp-block-table.att-spec{margin:1.5rem 0 2rem;overflow-x:auto}.wp-block-table.att-spec table{border-collapse:collapse;width:100%;font-size:15px;border:0;background:none!important;border-radius:0!important;box-shadow:none!important;overflow:visible}.wp-block-table.att-spec tr,.wp-block-table.att-spec thead{background:none!important}.wp-block-table.att-spec th{text-transform:none!important;letter-spacing:0!important;color:#1a1a18}.wp-block-table.att-spec th,.wp-block-table.att-spec td{border:0;border-bottom:1px solid #dcd8cf;padding:9px 10px;text-align:left;background:none}.wp-block-table.att-spec thead th{border-bottom:2px solid #1a1a18;font-weight:600;font-size:14px}.wp-block-table.att-spec td:first-child{color:#6b6a64;padding-left:0}.wp-block-table.att-spec thead th:first-child{padding-left:0}
@media (max-width:600px){.att-vs .vs-t td:first-child{min-width:140px}.att-vs .vs-t td.dif{white-space:normal;min-width:110px}.att-vs .vs-t{font-size:13px}.att-vs .vs-t th,.att-vs .vs-t td{padding:7px 6px}}
</style>
