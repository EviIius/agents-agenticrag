	<style id="att-ytf-css">
.att-ytf{position:absolute;inset:0;width:100%;height:100%;background:#000}
.att-ytf-btn{-webkit-appearance:none;appearance:none;border:0;margin:0;padding:0;cursor:pointer;display:block;width:100%;height:100%;position:absolute;inset:0;background:#000;z-index:1}
.att-ytf-thumb{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
.att-ytf-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:68px;height:48px;background:rgba(20,20,18,.78);border-radius:14px;transition:background .15s ease;pointer-events:none}
.att-ytf-play::before{content:"";position:absolute;top:50%;left:53%;transform:translate(-50%,-50%);border-style:solid;border-width:12px 0 12px 20px;border-color:transparent transparent transparent #fff}
.att-ytf-btn:hover .att-ytf-play,.att-ytf-btn:focus-visible .att-ytf-play{background:#f00}
.att-ytf-loading{cursor:progress}
.att-ytf-loading .att-ytf-play{display:none}
.att-ytf-loading::after{content:"";position:absolute;top:50%;left:50%;width:46px;height:46px;margin:-23px 0 0 -23px;border:4px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:att-ytf-spin .8s linear infinite;z-index:3;pointer-events:none}
@keyframes att-ytf-spin{to{transform:rotate(360deg)}}
.att-ytf iframe,.att-ytf .att-ytf-mount{position:absolute;inset:0;width:100%;height:100%;border:0;z-index:2}
.att-ytf.is-playing .att-ytf-btn{display:none!important}
</style>
<script id="att-ytf-js">
(function(){
  // maxresdefault doesn't exist for every video; YouTube then serves a 120x90 placeholder. Fall back to hqdefault.
  function fallBack(img){
    if(img.dataset.fellBack) return;
    img.dataset.fellBack='1'; img.removeAttribute('srcset'); img.src=img.dataset.fallback;
  }
  function checkSize(img){
    var w=img.naturalWidth;
    if(w){ if(w <= 120) fallBack(img); }
  }
  document.querySelectorAll('img.att-ytf-thumb').forEach(function(img){
    checkSize(img);
    img.addEventListener('load', function(){ checkSize(img); });
    img.addEventListener('error', function(){ fallBack(img); });
  });
})();
(function(){
  var warmed=false, apiPromise=null;
  // Safari (incl. desktop) + mobile lose the click gesture across iframe creation.
  var needsApi = (navigator.vendor&&navigator.vendor.indexOf('Apple')!==-1) || /Mobi|Android/i.test(navigator.userAgent);

  function addPreconnect(h){
    var l=document.createElement('link'); l.rel='preconnect'; l.href=h; l.crossOrigin=''; document.head.appendChild(l);
  }
  function warm(){
    if(warmed) return; warmed=true;
    addPreconnect('https://www.youtube-nocookie.com');
    addPreconnect('https://www.youtube.com');
    addPreconnect('https://i.ytimg.com');
    addPreconnect('https://www.google.com');
    if(needsApi) fetchApi();
  }

  function fetchApi(){
    if(apiPromise) return apiPromise;
    if(window.YT && window.YT.Player){ apiPromise=Promise.resolve(); return apiPromise; }
    apiPromise=new Promise(function(res,rej){
      var done=false;
      function finish(){ if(done) return; done=true; res(); }
      var prev=window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady=function(){ if(prev) try{prev()}catch(e){}; finish(); };
      if(!document.getElementById('att-yt-api')){
        var s=document.createElement('script');
        s.id='att-yt-api'; s.src='https://www.youtube.com/iframe_api'; s.async=true;
        s.onerror=function(){ rej(new Error('yt api')); };
        document.head.appendChild(s);
      }
      if(window.YT && typeof window.YT.ready==='function'){ window.YT.ready(finish); }
    });
    return apiPromise;
  }

  function basicIframe(id){
    var f=document.createElement('iframe');
    f.src='https://www.youtube-nocookie.com/embed/'+encodeURIComponent(id)+'?autoplay=1&rel=0&playsinline=1';
    f.title='YouTube video player';
    f.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    f.setAttribute('allowfullscreen','');
    f.referrerPolicy='strict-origin-when-cross-origin';
    return f;
  }

  function activate(w,b){
    if(!w||w.dataset.loading) return;
    var id=w.getAttribute('data-ytid'); if(!id) return;
    warm();
    w.dataset.loading='1';
    w.classList.add('att-ytf-loading','is-playing');
    if(b){ b.style.display='none'; b.setAttribute('tabindex','-1'); b.setAttribute('aria-hidden','true'); }

    // Fast path: drop iframe in during the same user gesture (Chrome/Firefox/Edge).
    if(!needsApi){
      var f=basicIframe(id);
      f.addEventListener('load',function(){ w.classList.remove('att-ytf-loading'); });
      w.appendChild(f);
      return;
    }

    // Safari/mobile: YT.Player so play sticks to the gesture.
    // If API already warm (hover), this is nearly as fast as the iframe path.
    // If not, still insert a basic iframe immediately so the user sees progress,
    // then upgrade via API when ready isn't worth it — just use API or fallback.
    var apiReady = !!(window.YT && window.YT.Player);
    if(apiReady){
      mountPlayer(w,id);
      return;
    }
    // API still loading — insert basic iframe NOW so start isn't blocked on JS.
    var f=basicIframe(id);
    f.addEventListener('load',function(){ w.classList.remove('att-ytf-loading'); });
    w.appendChild(f);
    // Also finish warming API for next video on the page.
    fetchApi().catch(function(){});
  }

  function mountPlayer(w,id){
    var mount=document.createElement('div');
    mount.className='att-ytf-mount';
    w.appendChild(mount);
    new YT.Player(mount,{
      width:'100%',
      height:'100%',
      videoId:id,
      playerVars:{autoplay:1,rel:0,playsinline:1,modestbranding:1,origin:window.location.origin},
      host:'https://www.youtube-nocookie.com',
      events:{
        onReady:function(ev){
          w.classList.remove('att-ytf-loading');
          try{ ev.target.playVideo(); }catch(e){}
        }
      }
    });
  }

  function fromEvent(e){
    var b=e.target.closest&&e.target.closest('.att-ytf-btn'); if(!b) return;
    e.preventDefault();
    activate(b.closest('.att-ytf'), b);
  }

  document.addEventListener('pointerover',function(e){ if(e.target.closest&&e.target.closest('.att-ytf')) warm(); },{passive:true});
  document.addEventListener('touchstart',function(e){ if(e.target.closest&&e.target.closest('.att-ytf')) warm(); },{passive:true});
  document.addEventListener('pointerup',function(e){
    if(e.pointerType==='mouse' && e.button!==0) return;
    fromEvent(e);
  },false);
  document.addEventListener('keydown',function(e){
    if(e.key!=='Enter'&&e.key!==' ') return;
    fromEvent(e);
  },false);
})();
</script>
