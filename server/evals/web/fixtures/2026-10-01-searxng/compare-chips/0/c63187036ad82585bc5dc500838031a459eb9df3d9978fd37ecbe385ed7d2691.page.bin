      if (!btn) return;
      if (btn.getAttribute('aria-expanded') !== 'true') { e.preventDefault(); btn.click(); }
    });
  });
})();
</script>



<script>
(function(){
  /*ATTEXTLINKS*/
  if (window.__attExtLinks) return; window.__attExtLinks = true;
  var here = location.hostname.replace(/^www\./,'');
  function ext(a){
    var href = a.getAttribute('href') || '';
    if (!/^(https?:)?\/\//i.test(href)) return false;
    var host = (a.hostname || '').replace(/^www\./,'');
    if (!host) return false;
    if (host === here) return false;
    return !/(^|\.)adamtalks\.tech$/.test(host);
  }
  function mark(a){
    if (!ext(a) || a.hasAttribute('data-att-samewin')) return;
    a.setAttribute('target','_blank');
    var rel = (a.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
    if (rel.indexOf('noopener') < 0) rel.push('noopener');
    a.setAttribute('rel', rel.join(' '));
  }
  function run(){ document.querySelectorAll('a[href]').forEach(mark); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
  document.addEventListener('click', function(e){
    var t = e.target;
    if (!t || !t.closest) return;
    var a = t.closest('a[href]');
    if (a) mark(a);
  }, true);
})();
</script>

</header>


