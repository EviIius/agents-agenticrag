                    <span class="cpu-rating-subtitle">14C / 14T · 1.26 - 4.51 GHz</span>
            
                    <div class="cpu-rating-stars">
                        <div class="stars" data-cpu-id="3493"><span class="" onclick="cpu_rating(this,5);">&#9733;</span><span class="" onclick="cpu_rating(this,4);">&#9733;</span><span class="" onclick="cpu_rating(this,3);">&#9733;</span><span class="" onclick="cpu_rating(this,2);">&#9733;</span><span class="" onclick="cpu_rating(this,1);">&#9733;</span></div>
