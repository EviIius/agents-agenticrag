cpu_20_gpu","image":"https://www.cpu-monkey.com/images/cpu/apple_m_series_2.jpg","brand":{"@type":"Brand","name":"Apple"},"model":"M4 Pro (14-CPU 20-GPU)","category":"Processor","aggregateRating":{"@type":"AggregateRating","ratingValue":4.8,"reviewCount":472,"bestRating":5,"worstRating":1},"additionalProperty":[{"@type":"PropertyValue","name":"MonkeyBench 2026.3 Single-Core","value":"966"},{"@type":"PropertyValue","name":"MonkeyBench 2026.3 Multi-Core","value":"10357"},{"@type":"PropertyValue","name":"Cinebench 2026 Single-Thread","value":"661"},{"@type":"PropertyValue","name":"Cinebench 2026 Multi-Core","value":"6602"},{"@type":"PropertyValue","name":"Cinebench 2024 Single-Core","value":"176"},{"@type":"PropertyValue","name":"Cinebench 2024 Multi-Core","value":"1742"},{"@type":"PropertyValue","name":"Geekbench 7 Single-Core","value":"3470"},{"@type":"PropertyValue","name":"Geekbench 7 Multi-Core","value":"25369"},{"@type":"PropertyValue","name":"Cinebench R23 Single-Core","value":"2165"},{"@type":"PropertyValue","name":"Cinebench R23 Multi-Core","value":"23436"},{"@type":"PropertyValue","name":"Geekbench 6 Single-Core","value":"3940"},{"@type":"PropertyValue","name":"Geekbench 6 Multi-Core","value":"22700"},{"@type":"PropertyValue","name":"Cores","value":"14"},{"@type":"PropertyValue","name":"Threads","value":"14"},{"@type":"PropertyValue","name":"Frequency","value":"1.26 GHz"},{"@type":"PropertyValue","name":"Turbo Frequency","value":"4.51 GHz"},{"@type":"PropertyValue","name":"TDP","value":"50 W"},{"@type":"PropertyValue","name":"Technology","value":"3 nm"}]}},{"@type":"ListItem","position":2,"item":{"@type":"Product","@id":"https://www.cpu-monkey.com/en/cpu-apple_m5#product","name":"Apple M5","url":"https://www.cpu-monkey.com/en/cpu-apple_m5","image":"https://www.cpu-monkey.com/images/cpu/apple_m_series_2.jpg","brand":{"@type":"Brand","name":"Apple"},"model":"M5","category":"Processor","aggregateRating":{"@type":"AggregateRating","ratingValue":4.6,"reviewCount":445,"bestRating":5,"worstRating":1},"additionalProperty":[{"@type":"PropertyValue","name":"MonkeyBench 2026.3 Single-Core","value":"1029"},{"@type":"PropertyValue","name":"MonkeyBench 2026.3 Multi-Core","value":"4429"},{"@type":"PropertyValue","name":"Cinebench 2024 Single-Core","value":"198"},{"@type":"PropertyValue","name":"Geekbench 7 Single-Core","value":"3581"},{"@type":"PropertyValue","name":"Geekbench 7 Multi-Core","value":"15118"},{"@type":"PropertyValue","name":"Geekbench 6 Single-Core","value":"4133"},{"@type":"PropertyValue","name":"Geekbench 6 Multi-Core","value":"16472"},{"@type":"PropertyValue","name":"Cores","value":"9"},{"@type":"PropertyValue","name":"Threads","value":"9"},{"@type":"PropertyValue","name":"Frequency","value":"0.91 GHz"},{"@type":"PropertyValue","name":"Turbo Frequency","value":"4.61 GHz"},{"@type":"PropertyValue","name":"TDP","value":"17 W"},{"@type":"PropertyValue","name":"Technology","value":"3 nm"}]}}]},{"@type":"FAQPage","@id":"https://www.cpu-monkey.com/en/compare_cpu-apple_m4_pro_14_cpu_20_gpu-vs-apple_m5#faq","mainEntity":[{"@type":"Question","name":"Which processor is faster, Apple M4 Pro (14-CPU 20-GPU) or Apple M5?","acceptedAnswer":{"@type":"Answer","text":"It depends on the workload: in single-core performance the Apple M5 leads by 7%, in multi-core workloads the Apple M4 Pro (14-CPU 20-GPU) leads by 51%."}},{"@type":"Question","name":"What are the technical differences between Apple M4 Pro (14-CPU 20-GPU) and Apple M5?","acceptedAnswer":{"@type":"Answer","text":"The most important differences at a glance: Cores / Threads: Apple M4 Pro (14-CPU 20-GPU) 14 / 14, Apple M5 9 / 9; Turbo Frequency: Apple M4 Pro (14-CPU 20-GPU) 4.51 GHz, Apple M5 4.61 GHz; TDP: Apple M4 Pro (14-CPU 20-GPU) 50 W, Apple M5 17 W; Integrated graphics (iGPU): Apple M4 Pro (14-CPU 20-GPU) Apple M4 Pro (20 Core), Apple M5 Apple M5 (10 Core); Release date: Apple M4 Pro (14-CPU 20-GPU) Q4/2024, Apple M5 Q4/2025"}},{"@type":"Question","name":"Which processor is more efficient, Apple M4 Pro (14-CPU 20-GPU) or Apple M5?","acceptedAnswer":{"@type":"Answer","text":"The Apple M5 is rated at 17 W TDP, the Apple M4 Pro (14-CPU 20-GPU) at 50 W. TDP is the thermal budget for cooling, not actual power use. In a notebook, battery life also depends heavily on the display and workload."}},{"@type":"Question","name":"Which processor is better for gaming?","acceptedAnswer":{"@type":"Answer","text":"Games rely mainly on single-core performance, and there the Apple M5 is 7% ahead of the Apple M4 Pro (14-CPU 20-GPU). Actual frame rates also depend on the GPU in the laptop – the iGPU or a dedicated graphics chip."}},{"@type":"Question","name":"Is it worth upgrading from the Apple M4 Pro (14-CPU 20-GPU) to the Apple M5?","acceptedAnswer":{"@type":"Answer","text":"Purely for performance the upgrade is hardly worth it: the Apple M5 is only marginally ahead of the Apple M4 Pro (14-CPU 20-GPU). Because the CPU is usually soldered, a new laptop would be needed anyway; display, battery and ports then often matter more."}}]}]}</script>

