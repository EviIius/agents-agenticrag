<script>
  document.addEventListener("DOMContentLoaded", function () {
    const stickyHeaderDesktop = document.getElementById("sticky-header");
    const stickyHeaderMobile = document.getElementById("sticky-header-mobile");
    const triggers = [
      document.getElementById("benchmarks"),
      document.getElementById("technical-data")
    ];
    const sectionLabels = document.querySelectorAll(".section-label h2");

    if ((!stickyHeaderDesktop && !stickyHeaderMobile) || triggers.some(t => !t)) return;

    let visibleTriggers = new Set();
    let isTimerDone = false;

    function isMobileView() {
      return window.innerWidth <= 1070;
    }

    function setSectionLabelTop(px) {
      if (stickyHeaderDesktop && !isMobileView()) {
        sectionLabels.forEach(el => el.style.top = px + "px");
      }
    }

    function toggleHeaderVisibility(visible) {
      const mobile = isMobileView();

      if (stickyHeaderDesktop) {
        stickyHeaderDesktop.classList.toggle('visible', !mobile && visible);
        if (!mobile) {
          setSectionLabelTop(visible ? 160 : 50);
        }
      }

      if (stickyHeaderMobile) {
        stickyHeaderMobile.classList.toggle('visible', mobile && visible);
      }
    }

    const observer = new IntersectionObserver((entries) => {
      if (!isTimerDone) return;

      entries.forEach(entry => {
        const el = entry.target;
        if (entry.isIntersecting) {
          visibleTriggers.add(el);
        } else {
          visibleTriggers.delete(el);
        }
      });

      toggleHeaderVisibility(visibleTriggers.size > 0);
    }, {
      root: null,
      threshold: 0
    });

    function handleResizeSwitch() {
      const mobile = isMobileView();

      if (mobile && stickyHeaderDesktop) {
        stickyHeaderDesktop.classList.remove("visible");
      }
      if (!mobile && stickyHeaderMobile) {
        stickyHeaderMobile.classList.remove("visible");
      }

      setSectionLabelTop(mobile ? 50 : 160);
    }

    window.addEventListener("resize", handleResizeSwitch);

    setTimeout(() => {
      isTimerDone = true;
      triggers.forEach(trigger => observer.observe(trigger));
      handleResizeSwitch();
    }, 12000);
  });
</script>






