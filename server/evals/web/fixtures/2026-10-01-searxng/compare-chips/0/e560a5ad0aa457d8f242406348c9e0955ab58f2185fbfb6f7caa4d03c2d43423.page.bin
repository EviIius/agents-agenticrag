<link rel="icon" href="https://applemagazine.com/wp-content/uploads/2024/07/cropped-ColorBlur-AM-RoundedIcon-2024-1-32x32.png" sizes="32x32" />
<link rel="icon" href="https://applemagazine.com/wp-content/uploads/2024/07/cropped-ColorBlur-AM-RoundedIcon-2024-1-192x192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="https://applemagazine.com/wp-content/uploads/2024/07/cropped-ColorBlur-AM-RoundedIcon-2024-1-180x180.png" />
<meta name="msapplication-TileImage" content="https://applemagazine.com/wp-content/uploads/2024/07/cropped-ColorBlur-AM-RoundedIcon-2024-1-270x270.png" />
		<style type="text/css" id="wp-custom-css">
			/* SOCIAL ICONS */
#footer_social_icons img,
#sidebar_social_icons img {
    width: 24px;
    height: auto;
    margin: 0;
    padding: 0;
}
#footer_social_icons a.facebook img {
    margin-left: -8px;
    margin-top: -1px !important;
}
#footer_social_icons a.x-icon img,
#footer_social_icons a.instagram-icon img {
    width: 20px;
}

/* SOCIAL ICONS: Facebook Menu Item */
.menu-item-facebook a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 56px;
    background: url('https://applemagazine.com/wp-content/uploads/2025/01/social-icon-2025-Facebook.png') no-repeat center center;
    background-size: contain;
}
.menu-item-facebook a svg {
    display: none;
}

/* MENU & NAVIGATION */
ul.menu.whmpress {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px; /* tight and clean spacing */
  list-style: none;
  padding: 0;
  margin: 0;
}

ul.menu.whmpress li {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
}

/* Normalize icons (SVG, IMG, ICON FONT) */
ul.menu.whmpress li svg,
ul.menu.whmpress li img,
ul.menu.whmpress li i {
  width: 20px;
  height: 20px;
  display: block;
  object-fit: contain;
  background: none !important;
  fill: currentColor;
}

/* ⬆ Boost Apple News icon (image-based) slightly */
ul.menu.whmpress li img[src*="AppleNewsstand"] {
  width: 22px;
  height: 22px;
}

/* Search icon fix */
ul.menu.whmpress li.menu-item-search.by-click i {
  font-size: 20px;
  line-height: 1;
  display: block;
}

/* Hide search label */
ul.menu.whmpress li.menu-item-search.by-click span.label-text {
  display: none !important;
}
ul.menu.whmpress li.menu-item-facebook svg path {
  display: none !important;
}



/* COOKIE BAR (Mobile + Desktop) */
#moove_gdpr_cookie_info_bar.moove-gdpr-dark-scheme {
    position: fixed;
    bottom: 50px;
    left: 50%;
    width: 55%;
    transform: translateX(-50%);
    padding: 10px;
    border-radius: 5px;
    background-color: rgba(77, 77, 77, 0.9);
    z-index: 1000;
}
@media (max-width: 768px) {
    #moove_gdpr_cookie_info_bar.moove-gdpr-dark-scheme {
        width: 100%;
        left: 0;
        transform: none;
        border-radius: 0;
        bottom: 0;
    }
}
#moove_gdpr_cookie_info_bar .moove-gdpr-info-bar-container {
    width: 105%;
}
#moove_gdpr_cookie_info_bar .moove-gdpr-info-bar-content button.mgbutton {
    background-color: #000;
    padding: 15px 40px;
}

/* HOMEPAGE: Remove link underlines */
body.home a {
    text-decoration: none !important;
}
body.home a:hover,
body.home a:focus {
    text-decoration: none !important;
}

/* POSTS: Improve link visibility and UX */
#custom-single-post-div article .entry-content a {
    color: #0073aa;
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
    padding: 4px 2px;
    transition: all 0.2s ease-in-out;
}
#custom-single-post-div article .entry-content a:hover,
#custom-single-post-div article .entry-content a:focus {
    color: #005177;
    background-color: #eef6fb;
    border-radius: 3px;
}
#custom-single-post-div article .entry-content a:visited {
    color: #5a5a99;
}

/* FALLBACK: General link style for body content */
.entry-content a {
    color: #0073aa;
    text-decoration: underline;
}
.entry-content a:hover {
    color: #005177;
    text-decoration: underline;
}

/* BUTTON STYLES (VC default styles) */
a.vc_general.vc_btn3 {
    font-size: 14px;
    border-radius: 13px;
    padding: 8px 30px;
    display: inline-block;
    text-align: center;
    transition: all 0.3s ease;
    text-decoration: none;
}
a.vc_btn3-style-modern.vc_btn3-color-grey {
    color: #3f3f3f;
    border: 2px solid #3f3f3f;
    background-color: transparent;
}
a.vc_btn3-style-classic.vc_btn3-color-default,
a.vc_btn3-style-classic.vc_btn3-color-grey {
    color: #fff;
    border: 2px solid #fff;
    background-color: transparent;
}
/* APPLE-STYLE BUTTONS: View All */

/* Shared Base Style */
a.white-border-btn,
a.dark-bg-btn {
    background-color: #ffffff !important;
    color: #1d1d1f !important;
    border: 1px solid #1d1d1f !important;
    border-radius: 50px !important; /* Fully rounded pill shape */
    font-size: 16px !important;
    font-weight: 500 !important;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
    padding: 12px 26px !important;
    text-align: center !important;
    text-decoration: none !important;
    display: inline-block !important;
    transition: all 0.3s ease-in-out !important;
    line-height: 1.4 !important;
}
/* Hover & Focus Effect */
a.white-border-btn:hover,
a.white-border-btn:focus,
a.dark-bg-btn:hover,
a.dark-bg-btn:focus {
    background-color: #f5f5f7 !important;
    color: #1d1d1f !important;
    text-decoration: none !important;
    transform: translateY(-1px);
}

/* Optional: On dark backgrounds, keep border white */
a.dark-bg-btn {
    border-color: #ffffff !important;
}
a.dark-bg-btn:hover,
a.dark-bg-btn:focus {
    background-color: #e5e5e7 !important;
}
/* SHARE ICONS (Jetpack) */
.sd-content ul {
    list-style: none;
    padding: 0;
    margin: 0;
}
.sd-content ul li {
    margin: 5px;
}
.sd-content ul li a.share-icon {
    background-color: transparent !important;
    border: 1px solid #333 !important;
    border-radius: 14px !important;
    padding: 6px 16px !important;
    display: inline-flex;
    align-items: center;
    text-decoration: none !important;
    color: #000 !important;
}
.sd-content ul li a.share-icon:hover {
    background-color: #f0f0f0 !important;
}
.sd-content ul li a.share-icon span,
.sd-content ul li a.share-icon svg {
    color: #000 !important;
    fill: #000 !important;
}

/* REMOVE UNUSED/BROKEN SELECTORS */
div#below_article_add {
    display: none;
}
img.wp-image-91542 {
    display: none;
}



.vc_btn3.vc_btn3-color-grey.vc_btn3-style-modern {
    color: #404040;
    border-color: #7F7F7F !important;
    background-color: #ff000000 !important;

}
.vc_btn3.vc_btn3-color-grey.vc_btn3-style-modern:hover {
    color: #404040;
    border-color: #404040;
    background-color: #ff000000;
border-width: 2px
}

