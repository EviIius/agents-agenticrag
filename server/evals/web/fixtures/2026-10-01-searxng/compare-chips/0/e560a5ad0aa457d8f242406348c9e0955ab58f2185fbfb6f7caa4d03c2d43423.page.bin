/* Hide both logos by default */
.site-branding.image-logo .desktop-logo,
.site-branding.image-logo .mobile-logo {
    display: none;
}

/* Show desktop logo ONLY on laptops and desktops (1024px and up) */
@media screen and (min-width: 1024px) {
    .site-branding.image-logo .desktop-logo {
        display: block !important;
    }

    .site-branding.image-logo .mobile-logo {
        display: none !important;
        background-image: none !important;
    }
}

/* Show mobile logo from 0px up to 1023px (mobile + tablet) */
@media screen and (max-width: 1023px) {
    .site-branding.image-logo .mobile-logo {
        display: block !important;
        background-image: url('https://applemagazine.com/wp-content/uploads/2024/12/logo-whit.png.webp') !important;
        background-repeat: no-repeat;
        background-size: contain;
        background-position: center;
        width: 160px;   /* Customize size */
        height: 50px;   /* Customize size */
    }

    .site-branding.image-logo .desktop-logo {
        display: none !important;
    }
}


