<link rel="https://api.w.org/" href="https://applemagazine.com/wp-json/" /><link rel="alternate" title="JSON" type="application/json" href="https://applemagazine.com/wp-json/wp/v2/posts/124711" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://applemagazine.com/xmlrpc.php?rsd" />
