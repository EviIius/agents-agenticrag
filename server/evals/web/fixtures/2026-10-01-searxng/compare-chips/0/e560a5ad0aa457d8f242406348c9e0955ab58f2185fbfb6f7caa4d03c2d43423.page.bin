/* Restore image captions in Newsbeat Child theme */
.wp-caption .wp-caption-text,
.wp-caption-text,
figure.wp-caption figcaption {
    display: block !important;
    font-size: 0.85em;
    color: #666;
    text-align: center;
    margin-top: 4px;
    line-height: 1.4;
}
/* Desktop only */
@media (min-width: 1024px) {

    /* Make the primary menu span full width inside the nav */
    #site-primary-nav-menu {
        width: 100%;
    }

    /* Ensure the UL behaves as a full-width row */
    #site-primary-nav-menu #primary-menu {
        width: 100%;
        display: block;
        clear: both;
    }

    /* Default: all menu items float left */
    #site-primary-nav-menu #primary-menu > li {
        float: left !important;
    }

    /* Special case: Business Partnership Program item floats right */
    #site-primary-nav-menu #primary-menu > #menu-item-111885 {
        float: right !important;
        margin-left: 40px; /* adjust spacing from the left group */
    }
}
/* ===============================
   TAG PAGE LCP PERFORMANCE FIX
   Date: 2026-03-27
   Purpose:
   - Reduce LCP render delay on /tag/ pages
   - Remove animations/transforms delaying paint
   - Stabilize thumbnail layout for faster rendering
   Scope:
   - Applies ONLY to tag archive pages
   =============================== */

/* Remove all visual effects that delay paint */
body.archive.tag .thumb-w,
body.archive.tag .thumb-w a,
body.archive.tag .thumb-w img {
    animation: none !important;
    transition: none !important;
    transform: none !important;
    filter: none !important;
    opacity: 1 !important;
}

/* Ensure stable container sizing (prevents late layout shifts) */
body.archive.tag .thumb-w {
    display: block !important;
    width: 100% !important;
    min-height: 220px !important; /* adjust if needed */
    overflow: hidden !important;
}

/* Ensure image renders immediately and cleanly */
body.archive.tag .thumb-w img {
    display: block !important;
    width: 100% !important;
    height: auto !important;
    object-fit: cover !important;
}

/* Disable hover/zoom effects (common in Newsbeat themes) */
body.archive.tag .thumb-w:hover img,
body.archive.tag .has-hover .thumb-w img {
    transform: none !important;
}		</style>
