    .page-id-103647 .container {
        max-width: 1230px;
        width: 100%;
        margin: 0 auto;
    }
}

/* ✅ Make .m-sb full width in app layout on medium+ screens */
@media only screen and (min-width: 992px) {
    .page-id-103647 .m-sb {
        width: 100% !important;
        flex: 0 0 100%;
        max-width: 100%;
    }

    /* ✅ Custom widget area width (adjust as needed) */
