@type":"Question","name":"When was Burj Khalifa completed?","acceptedAnswer":{"@type":"Answer","text":"It was completed in 2010."}},{"@type":"Question","name":"Where is Burj Khalifa?","acceptedAnswer":{"@type":"Answer","text":"Burj Khalifa stands in Dubai, United Arab Emirates."}},{"@type":"Question","name":"How many floors does Burj Khalifa have?","acceptedAnswer":{"@type":"Answer","text":"It has 163 above-ground floors and 1 below ground."}}]}]</script><script async src="https://www.googletagmanager.com/gtag/js?id=G-YR3TCTC0S1"></script><script>(function(){const ga = "G-YR3TCTC0S1";
