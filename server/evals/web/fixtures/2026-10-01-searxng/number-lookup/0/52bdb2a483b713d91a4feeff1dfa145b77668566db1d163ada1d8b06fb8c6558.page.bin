)+`</mark>`+u(i.slice(a+o.length)):r.textContent=i,t.appendChild(r),t.appendChild(document.createTextNode(` ↗`)),n.appendChild(t)})}i=0,d()}function u(e){return e.replace(/[&<>"]/g,e=>({"&":`&amp;`,"<":`&lt;`,">":`&gt;`,'"':`&quot;`})[e])}function d(){let e=Array.from(n.querySelectorAll(`.search-row`));e.forEach((e,t)=>e.classList.toggle(`active`,t===i)),e[i]&&e[i].scrollIntoView({block:`nearest`})}document.addEventListener(`keydown`,t=>{if((t.metaKey||t.ctrlKey)&&t.key.toLowerCase()===`k`&&(t.preventDefault(),e.hidden?o():s()),!e.hidden&&t.key===`Escape`&&(t.preventDefault(),s()),!e.hidden&&(t.key===`ArrowDown`||t.key===`ArrowUp`)){t.preventDefault();let e=Array.from(n.querySelectorAll(`.search-row`));if(!e.length)return;i=(i+(t.key===`ArrowDown`?1:-1)+e.length)%e.length,d()}if(!e.hidden&&t.key===`Enter`){let e=n.querySelector(`.search-row.active`);e&&(t.preventDefault(),e.click())}}),document.querySelectorAll(`[data-close-search]`).forEach(e=>e.addEventListener(`click`,s)),t.addEventListener(`input`,c),t.addEventListener(`keydown`,e=>{e.stopPropagation()});</script><button type="button" class="theme-toggle" aria-label="Dark mode" aria-pressed="false" hidden><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 15.5A8 8 0 0 1 8.5 4 8 8 0 1 0 20 15.5Z" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg><span>Dark mode</span></button><script>
(()=>{
 const root=document.documentElement,button=document.querySelector('.theme-toggle'),system=matchMedia('(prefers-color-scheme: dark)');
 let preference;try{preference=localStorage.getItem('building-theme');}catch{}
 function apply(theme){root.dataset.theme=theme;button.setAttribute('aria-pressed',String(theme==='dark'));document.querySelector('meta[name="theme-color"]').setAttribute('content',theme==='dark'?'#101c19':'#f8f9f6');}
 apply(root.dataset.theme||'light');button.hidden=false;
 button.addEventListener('click',()=>{preference=root.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('building-theme',preference);}catch{}apply(preference);});
 system.addEventListener('change',()=>{if(preference!=='light'&&preference!=='dark')apply(system.matches?'dark':'light');});
 window.addEventListener('storage',event=>{if(event.key==='building-theme'||event.key===null){preference=event.newValue;apply(preference==='light'||preference==='dark'?preference:system.matches?'dark':'light');}});
})();
</script><span class="edition"><i></i> 2026 EDITION</span></div></header><main id="main"><div class="shell breadcrumb"><a href="/">Home</a><span>/</span><a href="/#rankings">The top 100</a><span>/</span>Burj Khalifa</div><section class="shell profile-hero"><div><div class="eyebrow"><span class="status-dot"></span> WORLD RANK 01  <a class="cite" href="https://en.wikipedia.org/wiki/List_of_tallest_buildings">[1]</a></div><h1>Burj Khalifa</h1><div class="profile-location">Dubai · United Arab Emirates · Completed 2010</div><p class="profile-answer">828 metres tall, Burj Khalifa is a mixed-use skyscraper in Dubai, United Arab Emirates. It ranks first among the world&#39;s tallest completed buildings by architectural height. <a class="cite" href="https://www.skyscrapercenter.com/building/burj-khalifa/3"> [2]</a></p><div class="profile-number"><span class data-metres="828"><span class="metric-value">828</span><span class="imperial-value">2,717</span><small class="metric-value"> m</small><small class="imperial-value"> ft</small></span></div><div class="profile-height-label">ARCHITECTURAL HEIGHT <span> / 2,717 FEET</span> <a class="cite" href="https://www.wikidata.org/wiki/Q12495">[2]</a></div><div class="hero-actions"><a class="button" href="/compare/?a=burj-khalifa&amp;b=merdeka-118">Compare this building <span>↗</span></a><a class="text-link" href="#facts">Explore the facts ↓</a></div></div><figure><img class="profile-photo" src="/img/buildings/burj-khalifa.webp" alt="Burj Khalifa in Dubai" width="1800" height="1200" fetchpriority="high"><figcaption class="image-credit">Photo: Laika ac · <a href="https://commons.wikimedia.org/wiki/File:Burj_Khalifa_(16260269606).jpg">Wikimedia Commons</a> · <a href="https://creativecommons.org/licenses/by-sa/2.0">CC BY-SA 2.0</a>. Resized; display crop may vary.</figcaption></figure></section><nav class="shell section-tabs" aria-label="On this page"><a href="#facts">Key facts</a><a href="#engineering">How it was built</a><a href="#scale">Height comparison</a><a href="#sources">Sources</a><a href="#faq">Questions</a></nav><div class="shell profile-content"><section id="facts"><div class="eyebrow">THE BUILDING, IN NUMBERS</div><h2 style="margin-top:12px">Key facts</h2><table class="facts-table"><caption class="sr-only">Measurements and dates for Burj Khalifa</caption><tbody><tr><td>Architectural height</td><td><a href="https://www.wikidata.org/wiki/Q12495">828 m<span class="secondary">2,717 ft</span></a></td></tr><tr><td>Height to tip</td><td><a href="https://www.wikidata.org/wiki/Q12495">829.8 m<span class="secondary">2,722 ft</span></a></td></tr><tr><td>Highest occupied floor</td><td><span class="secondary">Not confirmed</span></td></tr><tr><td>Observation deck</td><td><span class="secondary">Not confirmed</span></td></tr><tr><td>Floors above ground</td><td><a href="https://www.wikidata.org/wiki/Q12495">163</a></td></tr><tr><td>Floors below ground</td><td><a href="https://www.wikidata.org/wiki/Q12495">1</a></td></tr><tr><td>Completed</td><td><a href="https://www.skyscrapercenter.com/building/burj-khalifa/3">2010</a></td></tr></tbody></table><dl class="profile-meta"><dt>Developer</dt><dd>Not confirmed</dd><dt>Builders</dt><dd>Not confirmed</dd><dt>Main structural material</dt><dd>Not confirmed</dd><dt>Elevators</dt><dd>Not confirmed</dd></dl><details class="note-box"><summary><strong style="display:inline">A note on these measurements</strong></summary><p>The current Skyscraper Center lists the highest occupied floor at 585.4 metres, while the retrieved Wikidata statement lists 584.5 metres and the supplied prompt uses 585 metres. This field remains unpublished pending reconciliation. Observation decks and The Lounge are different visitor experiences and need separate dated measurements. <a href="https://www.skyscrapercenter.com/building/burj-khalifa/3">See source ↗</a></p></details></section><aside class="profile-aside"><div class="eyebrow">BEHIND THE HEIGHT</div><dl><dt>Design & construction</dt><dd><a class="aside-team" href="/firms/skidmore-owings-merrill/">Skidmore, Owings &amp; Merrill<small>Architecture and structural design</small></a><a class="aside-team" href="/firms/samsung-c-t/">Samsung C&amp;T<small>Main contractor, joint venture</small></a><a class="aside-team" href="/firms/besix-six-construct/">BESIX / Six Construct<small>Main contractor, joint venture</small></a><a class="aside-team" href="/firms/arabtec/">Arabtec<small>Main contractor, joint venture</small></a></dd><dt>Primary use</dt><dd>Mixed use</dd><dt>Location</dt><dd><a class="firm-inline" href="/cities/dubai/">Dubai</a>, <a class="firm-inline" href="/countries/united-arab-emirates/">United Arab Emirates</a> <a class="text-link" style="display:block;width:fit-content;margin-top:6px" href="https://www.openstreetmap.org/?mlat=25.197222222222223&amp;mlon=55.274166666666666#map=16/25.197222222222223/55.274166666666666" target="_blank" rel="noopener noreferrer">View on map ↗</a></dd><dt>Closest in height</dt><dd><a style="display:block;margin-block:7px" href="/buildings/merdeka-118/">Merdeka 118 <span style="color:var(--muted)">↗</span></a><a style="display:block;margin-block:7px" href="/buildings/shanghai-tower/">Shanghai Tower <span style="color:var(--muted)">↗</span></a></dd></dl><a class="button" href="/#rankings">Back to the ranking <span>↗</span></a></aside></div><section id="engineering" class="shell engineering-section"><div class="section-heading"><div><div class="eyebrow">INSIDE THE ENGINEERING</div><h2>How Burj Khalifa was built.</h2></div><p>Design, structure and construction.<br>Technical sources reviewed 9 September 2026.</p></div><a class="text-link" href="/inside/?building=Q12495">Explore the annotated tower anatomy ↗</a><p class="engineering-headline">Three wings that buttress one another.</p><div class="engineering-metrics"><a href="https://www.burjkhalifa.ae/the-tower/structures/"><span>Foundation mat</span><strong>3.7 m thick</strong><small>Technical source ↗</small></a><a href="https://www.burjkhalifa.ae/the-tower/structures/"><span>Bored piles</span><strong>1.5 m × 43 m</strong><small>Technical source ↗</small></a><a href="https://www.besix.com/en/projects/burj-khalifa"><span>Concrete pumping</span><strong>585 m</strong><small>Technical source ↗</small></a></div><div class="engineering-grid"><article><span class="eyebrow">01 / TECHNICAL NOTES</span><h3>Structural system &amp; load path</h3><p>SOM arranged three concrete wings around a six-sided core. Each wing braces the other two, while the central cell supplies torsional stiffness. The setback geometry aligns columns above with walls below, avoiding disruptive transfers as the floor plate reduces. Gravity and lateral resistance follow the same disciplined geometry.</p><a class="text-link" href="https://www.som.com/projects/burj-khalifa/">Read the technical source ↗</a></article><article><span class="eyebrow">02 / TECHNICAL NOTES</span><h3>Foundations &amp; durability</h3><p>A reinforced-concrete mat, 3.7 metres thick, distributes the tower load to bored piles 1.5 metres in diameter and 43 metres long. The mat was cast in four pours totalling 12,500 cubic metres. Low-permeability concrete forms part of the foundation durability strategy.</p><a class="text-link" href="https://www.burjkhalifa.ae/the-tower/structures/">Read the technical source ↗</a></article><article><span class="eyebrow">03 / TECHNICAL NOTES</span><h3>How it was built</h3><p>The Samsung C&amp;T, Six Construct and Arabtec joint venture had to coordinate cranes, labour and material supply vertically. BESIX reports concrete pumping to 585 metres and cycles reaching two floors per week. Special mixes and predominantly night-time pours addressed temperatures exceeding 45°C.</p><a class="text-link" href="https://www.besix.com/en/projects/burj-khalifa">Read the technical source ↗</a></article><article><span class="eyebrow">04 / TECHNICAL NOTES</span><h3>Wind, facade &amp; services</h3><p>Successive setbacks change the shape the wind encounters, reducing coherent vortex formation. The envelope uses silver-coated glazing to limit solar gain. Mechanical equipment is distributed through double-height service floors; the design also collects air-conditioning condensate for reuse. The steel spire was assembled inside the building and hydraulically raised into position.</p><a class="text-link" href="https://www.burjkhalifa.ae/the-tower/structures/">Read the technical source ↗</a></article></div><div id="project-team" class="team-section"><div><div class="eyebrow">THE PEOPLE BEHIND THE STRUCTURE</div><h2>The project team.</h2><p>Design architects, engineers and construction firms have different responsibilities. Credits identify the published role on this project.</p><a class="text-link" href="/firms/">Explore architects & builders ↗</a></div><dl class="team-list"><div><dt><a href="/firms/#skidmore-owings-merrill">Skidmore, Owings &amp; Merrill ↗</a></dt><dd>Architecture and structural design <a class="credit-source" href="https://www.som.com/projects/burj-khalifa/" aria-label="Source for Skidmore, Owings &amp; Merrill's role">Source ↗</a></dd></div><div><dt><a href="/firms/#skidmore-owings-merrill">Skidmore, Owings &amp; Merrill ↗</a></dt><dd>Structural engineering, led by William F. Baker <a class="credit-source" href="https://www.som.com/news/meet-the-man-behind-burj-khalifa/" aria-label="Source for Skidmore, Owings &amp; Merrill's role">Source ↗</a></dd></div><div><dt><a href="/firms/#samsung-c-t">Samsung C&amp;T ↗</a></dt><dd>Main contractor, joint venture <a class="credit-source" href="https://www.besix.com/en/projects/burj-khalifa" aria-label="Source for Samsung C&amp;T's role">Source ↗</a></dd></div><div><dt><a href="/firms/#besix-six-construct">BESIX / Six Construct ↗</a></dt><dd>Main contractor, joint venture <a class="credit-source" href="https://www.besix.com/en/projects/burj-khalifa" aria-label="Source for BESIX / Six Construct's role">Source ↗</a></dd></div><div><dt><a href="/firms/#arabtec">Arabtec ↗</a></dt><dd>Main contractor, joint venture <a class="credit-source" href="https://www.besix.com/en/projects/burj-khalifa" aria-label="Source for Arabtec's role">Source ↗</a></dd></div></dl></div></section><section class="shell scale-section" id="scale"><div class="eyebrow">SIDE BY SIDE</div><h2 class="content-title" style="margin-top:12px">A sense of scale.</h2><div class="scale-chart" aria-label="Architectural heights drawn to a common scale"><div class="scale-grid" aria-hidden="true"><span>Architectural height</span><span>828 m</span></div><div class="scale-columns"><a class="scale-column" href="/buildings/burj-khalifa/"><span class="scale-number">828 <small>m</small></span><span class="scale-bar" style="height:280px;--bar-color:var(--accent)"><span></span></span><span class="scale-label">Burj Khalifa</span></a><a class="scale-column" href="/buildings/merdeka-118/"><span class="scale-number">678.9 <small>m</small></span><span class="scale-bar" style="height:229.57971014492753px;--bar-color:#839c94"><span></span></span><span class="scale-label">Merdeka 118</span></a><a class="scale-column" href="/buildings/shanghai-tower/"><span class="scale-number">632 <small>m</small></span><span class="scale-bar" style="height:213.71980676328502px;--bar-color:#839c94"><span></span></span><span class="scale-label">Shanghai Tower</span></a></div><p class="chart-note">Height bars use the same scale. They do not represent building shape. <a href="https://www.skyscrapercenter.com/building/burj-khalifa/3">Measurement source ↗</a></p></div></section><section class="shell sources-section" id="sources"><div class="eyebrow">CHECK THE DETAILS</div><h2 style="margin-top:12px">Sources & references</h2><div class="sources-list"><a href="https://www.wikidata.org/wiki/Q12495" target="_blank" rel="noopener noreferrer">Wikidata ↗<span>www.wikidata.org</span></a><a href="https://en.wikipedia.org/wiki/Burj_Khalifa" target="_blank" rel="noopener noreferrer">Wikipedia ↗<span>en.wikipedia.org</span></a><a href="https://www.skyscrapercenter.com/building/burj-khalifa/3" target="_blank" rel="noopener noreferrer">CTBUH / Skyscraper Center ↗<span>www.skyscrapercenter.com</span></a></div><p class="chart-note">Record updated 2026-09-24. Sources can differ on height categories, floor counts and completion milestones. <a href="/methodology/">Read our methodology.</a></p></section><section class="shell faq-section" id="faq"><div class="section-heading"><div><div class="eyebrow">QUICK ANSWERS</div><h2>Common questions</h2></div><a class="text-link" href="/glossary/">Structural terms, defined ↗</a></div><div class="faq-list"><details class="faq-item"><summary>How tall is Burj Khalifa?</summary><p>Burj Khalifa reaches 828 metres (2,717 feet) by architectural height, with a tip height of 829.8 metres.</p></details><details class="faq-item"><summary>When was Burj Khalifa completed?</summary><p>It was completed in 2010.</p></details><details class="faq-item"><summary>Where is Burj Khalifa?</summary><p>Burj Khalifa stands in Dubai, United Arab Emirates.</p></details><details class="faq-item"><summary>How many floors does Burj Khalifa have?</summary><p>It has 163 above-ground floors and 1 below ground.</p></details></div></section></main><footer class="footer"><div class="shell footer-top"><a class="brand" href="/">TALLEST BUILDING<span class="brand-sub">IN THE WORLD</span></a><p>A closer look at the buildings<br>that take us higher.</p><div><a href="/methodology/">Methodology & sources</a><a href="/data/">Download the data</a><a href="/map/">World map</a><a href="/inside/">Inside a tower</a><a href="/timeline/">Height timeline</a><a href="/construction/">Construction tracker</a><a href="/cities/">By city</a><a href="/countries/">By country</a><a href="/years/">By completion year</a><a href="/decades/">By era (decade by decade)</a><a href="/types/">By building type</a><a href="/firms/">Architects & builders</a><a href="/future/">Under construction & concepts</a><a href="/news/">News</a><a href="/blog/">Engineering blog</a><a href="/glossary/">Glossary</a><a href="/#rankings">Explore the top 100 ↗</a></div></div><div class="shell footer-bottom"><span>© 2026 tallestbuildingintheworld.com</span><span>Top 100 + engineering + future projects · September 2026</span></div></footer><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"a127f9cc644a4b478b3e858fe7ad1e82","r":1,"spa":2}' crossorigin="anonymous"></script>
