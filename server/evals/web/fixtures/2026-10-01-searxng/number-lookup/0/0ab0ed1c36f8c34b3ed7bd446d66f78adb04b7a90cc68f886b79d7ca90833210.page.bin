<div class="fl-col-group fl-node-5f52b0a9cbba0" data-node="5f52b0a9cbba0">
			<div class="fl-col fl-node-5f52b0a9cbcd1 fl-col-bg-color" data-node="5f52b0a9cbcd1">
	<div class="fl-col-content fl-node-content"><div class="fl-module fl-module-photo fl-node-5f52b0afe540b fl-animation fl-fade-in" data-node="5f52b0afe540b" data-animation-delay="0" data-animation-duration="1" aria-label="Photo">
	<div class="fl-module-content fl-node-content">
		<div role="figure" class="fl-photo fl-photo-align-center" itemscope itemtype="https://schema.org/ImageObject">
	<div class="fl-photo-content fl-photo-img-jpg">
					<img data-attachment-id="6465" data-permalink="https://www.skyscraper.org/exhibitions/worlds-tallest-building-burj-dubai/attachment/worlds-tallet-building-burj-dubai-2/" data-orig-file="https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1.jpg" data-orig-size="1200,400" data-comments-opened="0" data-image-meta="{&quot;aperture&quot;:&quot;0&quot;,&quot;credit&quot;:&quot;&quot;,&quot;camera&quot;:&quot;&quot;,&quot;caption&quot;:&quot;&quot;,&quot;created_timestamp&quot;:&quot;0&quot;,&quot;copyright&quot;:&quot;&quot;,&quot;focal_length&quot;:&quot;0&quot;,&quot;iso&quot;:&quot;0&quot;,&quot;shutter_speed&quot;:&quot;0&quot;,&quot;title&quot;:&quot;&quot;,&quot;orientation&quot;:&quot;1&quot;}" data-image-title="Worlds-Tallet-Building-Burj-Dubai" data-image-description="" data-image-caption="" data-large-file="https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1-800x267.jpg" fetchpriority="high" decoding="async" width="1200" height="400" class="fl-photo-img wp-image-6465" src="https://skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1.jpg" alt="Worlds-Tallet-Building-Burj-Dubai" title="Worlds-Tallet-Building-Burj-Dubai"  itemprop="image" srcset="https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1.jpg 1200w, https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1-600x200.jpg 600w, https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1-800x267.jpg 800w, https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1-345x115.jpg 345w, https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1-768x256.jpg 768w, https://www.skyscraper.org/wordpress/wp-content/uploads/2019/07/Worlds-Tallet-Building-Burj-Dubai-1-960x320.jpg 960w,