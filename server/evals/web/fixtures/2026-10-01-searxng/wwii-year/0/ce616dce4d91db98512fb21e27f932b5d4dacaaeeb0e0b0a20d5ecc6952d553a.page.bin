<li about="#cite_note-FOOTNOTEZiemke1969130-24" id="cite_note-FOOTNOTEZiemke1969130-24" data-mw-footnote-number="24"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwA38"><a href="#cite_ref-FOOTNOTEZiemke1969130_24-0" id="mwA4A"><span class="mw-linkback-text" id="mwA4E">1</span></a> <a href="#cite_ref-FOOTNOTEZiemke1969130_24-1" id="mwA4I"><span class="mw-linkback-text" id="mwA4M">2</span></a> <a href="#cite_ref-FOOTNOTEZiemke1969130_24-2" id="mwA4Q"><span class="mw-linkback-text" id="mwA4U">3</span></a></span> <span id="mw-reference-text-cite_note-FOOTNOTEZiemke1969130-24" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFZiemke1969" class="mw-selflink-fragment" id="mwA4Y">Ziemke 1969</a>, p.<span typeof="mw:Entity" id="mwA4c"> </span>130.</span></li>
<li about="#cite_note-25" id="cite_note-25" data-mw-footnote-number="25"><span class="mw-cite-backlink" id="mwA4g"><a href="#cite_ref-25" rel="mw:referencedBy" id="mwA4k"><span class="mw-linkback-text" id="mwA4o">↑</span></a></span> <span id="mw-reference-text-cite_note-25" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt84" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwA4s" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.winstonchurchill.org/i4a/pages/index.cfm?pageid=426"},"url-status":{"wt":"dead"},"title":{"wt":"The Churchill Centre: The End of the War in Europe"},"archivedate":{"wt":"19 June 2006"},"archiveurl":{"wt":"https://web.archive.org/web/20060619052022/http://www.winstonchurchill.org/i4a/pages/index.cfm?pageid=426"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt84" id="mwA4w"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20060619052022/http://www.winstonchurchill.org/i4a/pages/index.cfm?pageid=426" class="external text" id="mwA40">"The Churchill Centre: The End of the War in Europe"</a>. Archived from <a rel="mw:ExtLink nofollow" href="http://www.winstonchurchill.org/i4a/pages/index.cfm?pageid=426" class="external text" id="mwA44">the original</a> on 19 June 2006.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=The+Churchill+Centre%3A+The+End+of+the+War+in+Europe&amp;rft_id=http%3A%2F%2Fwww.winstonchurchill.org%2Fi4a%2Fpages%2Findex.cfm%3Fpageid%3D426&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AEnd+of+World+War+II+in+Europe" class="Z3988" about="#mwt84" id="mwA48"></span></span></li>
<li about="#cite_note-BDST-26" id="cite_note-BDST-26" data-mw-footnote-number="26"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwA5A"><a href="#cite_ref-BDST_26-0" id="mwA5E"><span class="mw-linkback-text" id="mwA5I">1</span></a> <a href="#cite_ref-BDST_26-1" id="mwA5M"><span class="mw-linkback-text" id="mwA5Q">2</span></a></span> <span id="mw-reference-text-cite_note-BDST-26" class="mw-reference-text reference-text">During the summers of World War II, Britain was on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/British_Double_Summer_Time" title="British Double Summer Time" class="mw-redirect" id="mwA5U">British Double Summer Time</a> which meant that the country was ahead of CET time by one hour. This means that the surrender time in the UK was "effective from 0001 hours on May 9".<a rel="mw:ExtLink nofollow" href="http://www.raf.mod.uk/bombercommand/apr45.html" class="external text" id="mwA5Y">RAF Site Diary 7/8 May</a> <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20120118042101/http://www.raf.mod.uk/bombercommand/apr45.html" about="#mwt87" typeof="mw:Transclusion" class="external text" id="mwA5c" data-mw='{"parts":[{"template":{"target":{"wt":"webarchive ","href":"./Template:Webarchive"},"params":{"date":{"wt":"18 January 2012"},"url":{"wt":"https://web.archive.org/web/20120118042101/http://www.raf.mod.uk/bombercommand/apr45.html"}},"i":0}}]}'>Archived</a><span about="#mwt87" id="mwA5g"> 18 January 2012 at the </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wayback_Machine" title="Wayback Machine" about="#mwt87" id="mwA5k">Wayback Machine</a><link rel="mw:PageProp/Category" href="./Category:Webarchive_template_wayback_links" about="#mwt87" id="mwA5o"/></span></li>
<li about="#cite_note-FOOTNOTEZiemke1990258_last_paragraph-27" id="cite_note-FOOTNOTEZiemke1990258_last_paragraph-27" data-mw-footnote-number="27"><span class="mw-cite-backlink" id="mwA5s"><a href="#cite_ref-FOOTNOTEZiemke1990258_last_paragraph_27-0" rel="mw:referencedBy" id="mwA5w"><span class="mw-linkback-text" id="mwA50">↑</span></a></span> <span id="mw-reference-text-cite_note-FOOTNOTEZiemke1990258_last_paragraph-27" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFZiemke1990" class="mw-selflink-fragment" id="mwA54">Ziemke 1990</a>, p.<span typeof="mw:Entity" id="mwA58"> </span>258 last paragraph.</span></li>
