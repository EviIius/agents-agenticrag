String\":\"c_crop,h_1081,w_1920,x_0,y_0/g_auto:aoi_768_433_384_216\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_1081,w_1920,x_0,y_0/g_auto:aoi_768_433_384_216/sanity-new/16x9_1_izrtk3\",\"width\":1920},\"folder\":\"sanity-new\",\"height\":1080,\"public_id\":\"sanity-new/16x9_1_izrtk3\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1780429442/sanity-new/16x9_1_izrtk3.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1780429442/sanity-new/16x9_1_izrtk3.jpg\",\"width\":1920}},\"type\":\"list\"},{\"alias\":\"the-20-most-controversial-championships-in-sports-history-ranked\",\"authors\":[{\"alias\":\"jerrylbarrow\",\"bio\":null,\"createdAt\":\"2021-05-06T00:55:30Z\",\"email\":\"jerrylbarrow@gmail.com\",\"facebookLink\":null,\"id\":\"author-11393352\",\"image\":\"https://images.complex.com/complex/image/upload/v1714568427/sanity/user_large.jpg\",\"instagramLink\":null,\"joinDate\":\"2021-05-06T00:55:30.000Z\",\"link\":null,\"metaDescription\":null,\"name\":\"Jerry L. Barrow\",\"tiktokLink\":null,\"title\":null,\"type\":\"author\",\"xLink\":null},{\"alias\":\"jake-kring-schreifels\",\"bio\":null,\"createdAt\":\"2020-01-30T01:31:56Z\",\"email\":\"jakekringschreifels@gmail.com\",\"facebookLink\":null,\"id\":\"author-11393188\",\"image\":\"https://images.complex.com/complex/image/upload/v1714568427/sanity/user_large.jpg\",\"instagramLink\":null,\"joinDate\":\"2020-01-30T01:31:56.000Z\",\"link\":null,\"metaDescription\":null,\"name\":\"Jake Kring-Schreifels\",\"tiktokLink\":null,\"title\":null,\"type\":\"author\",\"xLink\":null},{\"alias\":\"ian-stonebrook\",\"bio\":null,\"createdAt\":\"2020-04-15T19:50:55Z\",\"email\":\"ian.stonebrook@gmail.com\",\"facebookLink\":null,\"id\":\"author-11393212\",\"image\":\"https://images.complex.com/complex/image/upload/v1714573535/sanity/JSRWd3BDw_large.jpg\",\"instagramLink\":null,\"joinDate\":\"2020-04-15T19:50:55.000Z\",\"link\":null,\"metaDescription\":null,\"name\":\"Ian Stonebrook\",\"tiktokLink\":null,\"title\":null,\"type\":\"author\",\"xLink\":null}],\"channel\":\"sports\",\"complexosMetadata\":null,\"complexos_generated\":false,\"contentCategory\":[\"lists\"],\"contentSubCategory\":null,\"description\":\"From outright cheats like the 2017 Houston Astros to lucky squads like the 2001 New England Patriots, not all champions are equal. \",\"edition\":{\"id\":\"5a9a730c-f0e2-46c1-aff7-93342e373ca9\",\"language\":\"en\",\"name\":\"United States\",\"shortName\":\"US\"},\"headline\":\"Cheaters, Luck, and Scandals: The 20 Most Controversial Champs in Sports History, Ranked\",\"id\":\"05df1154-ba6b-4c9d-8e17-516d176b6fae\",\"name\":null,\"publishedAt\":\"2025-11-04T18:13:43.402Z\",\"tags\":[{\"displayName\":\"Los Angeles Lakers\",\"id\":\"tag-los_angeles_lakers\",\"name\":\"los-angeles-lakers\",\"updatedAt\":\"2026-06-08T14:22:44Z\"},{\"displayName\":\"Los Angeles Dodgers\",\"id\":\"tag-los_angeles_dodgers\",\"name\":\"los-angeles-dodgers\",\"updatedAt\":\"2026-07-09T09:15:54Z\"},{\"displayName\":\"New York Yankees\",\"id\":\"tag-new_york_yankees\",\"name\":\"new-york-yankees\",\"updatedAt\":\"2026-07-09T11:57:08Z\"},{\"displayName\":\"Michigan Wolverines\",\"id\":\"tag-michigan_wolverines\",\"name\":\"michigan-wolverines\",\"updatedAt\":\"2026-07-09T10:27:03Z\"},{\"displayName\":\"New England Patriots\",\"id\":\"tag-new_england_patriots\",\"name\":\"new-england-patriots\",\"updatedAt\":\"2026-06-08T14:22:47Z\"},{\"displayName\":\"Tom Brady\",\"id\":\"tag-tom_brady\",\"name\":\"tom-brady\",\"updatedAt\":\"2026-07-09T20:42:37Z\"},{\"displayName\":\"Shaquille O'Neal\",\"id\":\"tag-shaquille_oneal\",\"name\":\"shaquille-oneal\",\"updatedAt\":\"2026-07-09T17:20:16Z\"},{\"displayName\":\"Kobe Bryant\",\"id\":\"tag-kobe_bryant\",\"name\":\"kobe-bryant\",\"updatedAt\":\"2026-07-09T08:08:57Z\"},{\"displayName\":\"LeBron James\",\"id\":\"tag-lebron_james\",\"name\":\"lebron-james\",\"updatedAt\":\"2026-07-09T08:39:02Z\"},{\"displayName\":\"Diego Maradona\",\"id\":\"tag-diego_maradona\",\"name\":\"diego-maradona\",\"updatedAt\":\"2026-07-09T01:33:34Z\"},{\"displayName\":\"Summer Olympics\",\"id\":\"tag-summer_olympics\",\"name\":\"summer-olympics\",\"updatedAt\":\"2026-07-09T19:04:02Z\"},{\"displayName\":\"Ice Hockey\",\"id\":\"tag-ice_hockey\",\"name\":\"ice-hockey\",\"updatedAt\":\"2026-07-09T05:16:49Z\"},{\"displayName\":\"UEFA Champions League\",\"id\":\"tag-uefa_champions_league\",\"name\":\"uefa-champions-league\",\"updatedAt\":\"2026-07-09T21:23:55Z\"},{\"displayName\":\"Michael Jordan\",\"id\":\"tag-michael_jordan\",\"name\":\"michael-jordan\",\"updatedAt\":\"2026-07-09T10:23:45Z\"},{\"displayName\":\"Dwyane Wade\",\"id\":\"tag-dwyane_wade\",\"name\":\"dwyane-wade\",\"updatedAt\":\"2026-07-09T02:17:50Z\"},{\"displayName\":\"Miami Heat\",\"id\":\"tag-miami_heat\",\"name\":\"miami-heat\",\"updatedAt\":\"2024-11-26T17:32:37Z\"}],\"thumbnail\":{\"_type\":\"landscapeThumbnail\",\"altText\":\"Kobe Bryant, Rick Fox, Lindsey Hunter, and Shaquille O'Neal celebrate the Lakers third consecutive championship in June 2002. \",\"credit\":\"Photo by Sporting News via Getty Images via Getty Images\",\"image\":{\"_type\":\"cloudinaryImageV2\",\"access_mode\":\"public\",\"asset_id\":\"a38a986f3d7dc9bdf2d674346fd02ea3\",\"bytes\":7769678,\"created_at\":\"2025-11-04T16:38:37Z\",\"derived\":{\"crop\":{\"height\":4012,\"width\":6048,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":3024,\"y\":2006},\"height\":4012,\"transformationString\":\"c_crop,h_4012,w_6048,x_0,y_0/g_xy_center,x_3024,y_2006\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_4012,w_6048,x_0,y_0/g_xy_center,x_3024,y_2006/sanity-new/GettyImages-469161589_z1qjja\",\"width\":6048},\"etag\":\"5f02601132278264736919ecae98900e\",\"existing\":false,\"folder\":\"sanity-new\",\"format\":\"jpg\",\"height\":4008,\"original_filename\":\"GettyImages-469161589\",\"placeholder\":false,\"public_id\":\"sanity-new/GettyImages-469161589_z1qjja\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1762274317/sanity-new/GettyImages-469161589_z1qjja.jpg\",\"signature\":\"1d9e37e8680295474051f2d62db6625a13b51928\",\"tags\":[],\"type\":\"upload\",\"url\":\"http://images.complex.com/complex/image/upload/v1762274317/sanity-new/GettyImages-469161589_z1qjja.jpg\",\"version\":1762274317,\"version_id\":\"d0ca56862d35b7858857ee78a7eb2f57\",\"width\":6048}},\"type\":\"list\"},{\"alias\":\"nba-most-hated-villains-all-time\",\"authors\":[{\"alias\":\"rashad-grove\",\"bio\":null,\"createdAt\":\"2026-01-06T21:29:53Z\",\"email\":null,\"facebookLink\":null,\"id\":\"276bfbc1-98c5-48cd-9bf0-9a645668c6de\",\"image\":null,\"instagramLink\":null,\"joinDate\":null,\"link\":null,\"metaDescription\":null,\"name\":\"Rashad Grove\",\"tiktokLink\":null,\"title\":null,\"type\":\"author\",\"xLink\":null}],\"channel\":\"bets\",\"complexosMetadata\":null,\"complexos_generated\":false,\"contentCategory\":[\"lists\"],\"contentSubCategory\":null,\"description\":\"SGA and the Thunder, the 90s Knicks, and LeBron’s Heatles lead a list of the NBA’s Big Bads. Where does Victor Wembanyama land? \",\"edition\":{\"id\":\"5a9a730c-f0e2-46c1-aff7-93342e373ca9\",\"language\":\"en\",\"name\":\"United States\",\"shortName\":\"US\"},\"headline\":\"The NBA's 10 Most Hated Villains of All Time (Updated) \",\"id\":\"e3ea0cbe-facc-438e-9a8f-2a30eab5e273\",\"name\":null,\"publishedAt\":\"2026-06-15T14:09:44.670Z\",\"tags\":[{\"displayName\":\"Dennis Rodman\",\"id\":\"tag-dennis_rodman\",\"name\":\"dennis-rodman\",\"updatedAt\":\"2026-07-09T01:21:11Z\"},{\"displayName\":\"Kobe Bryant\",\"id\":\"tag-kobe_bryant\",\"name\":\"kobe-bryant\",\"updatedAt\":\"2026-07-09T08:08:57Z\"},{\"displayName\":\"Dillon Brooks\",\"id\":\"tag-dillon_brooks\",\"name\":\"dillon-brooks\",\"updatedAt\":\"2026-07-09T01:35:30Z\"},{\"displayName\":\"Kevin Durant\",\"id\":\"tag-kevin_durant\",\"name\":\"kevin-durant\",\"updatedAt\":\"2026-07-09T07:47:41Z\"},{\"displayName\":\"Shai Gilgeous-Alexander\",\"id\":\"tag-shai_gilgeous_alexander\",\"name\":\"shai-gilgeous-alexander\",\"updatedAt\":\"2026-07-09T17:17:13Z\"},{\"displayName\":\"New York Knicks\",\"id\":\"tag-new_york_knicks\",\"name\":\"new-york-knicks\",\"updatedAt\":\"2026-07-09T11:56:08Z\"},{\"displayName\":\"Detroit Pistons\",\"id\":\"tag-detroit_pistons\",\"name\":\"detroit-pistons\",\"updatedAt\":\"2026-07-09T01:27:13Z\"},{\"displayName\":\"Ron Artest\",\"id\":\"tag-ron_artest\",\"name\":\"ron-artest\",\"updatedAt\":\"2026-07-09T16:23:40Z\"},{\"displayName\":\"LeBron James\",\"id\":\"tag-lebron_james\",\"name\":\"lebron-james\",\"updatedAt\":\"2026-07-09T08:39:02Z\"},{\"displayName\":\"Miami Heat\",\"id\":\"tag-miami_heat\",\"name\":\"miami-heat\",\"updatedAt\":\"2024-11-26T17:32:37Z\"},{\"displayName\":\"Draymond Green\",\"id\":\"tag-draymond_green\",\"name\":\"draymond-green\",\"updatedAt\":\"2026-07-09T02:05:09Z\"}],\"thumbnail\":{\"_type\":\"cloudinaryImage\",\"altText\":\"Victor Wembanyama reacts to a call during Game 1 of the 2026 NBA Finals. \",\"caption\":\"\",\"credit\":\"Photo by Gregory Shamus/Getty Images\",\"image\":{\"_key\":\"y16ri5hZq0sTqOl1Dpe66\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2002,\"width\":3000,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":1500,\"y\":1001},\"height\":2002,\"transformationString\":\"c_crop,h_2002,w_3000,x_0,y_0/g_auto:aoi_1200_801_600_400\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2002,w_3000,x_0,y_0/g_auto:aoi_1200_801_600_400/sanity-new/GettyImages-2279697977_pdbgq1\",\"width\":3000},\"folder\":\"sanity-new\",\"height\":2000,\"public_id\":\"sanity-new/GettyImages-2279697977_pdbgq1\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781496920/sanity-new/GettyImages-2279697977_pdbgq1.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781496920/sanity-new/GettyImages-2279697977_pdbgq1.jpg\",\"width\":