j\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":3564,\"width\":5312,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":2656,\"y\":1782},\"height\":3564,\"transformationString\":\"c_crop,h_3564,w_5312,x_0,y_0/g_auto:aoi_2125_1426_1062_713\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_3564,w_5312,x_0,y_0/g_auto:aoi_2125_1426_1062_713/sanity-new/GettyImages-535940392_nefv31\",\"width\":5312},\"folder\":\"sanity-new\",\"height\":3565,\"public_id\":\"sanity-new/GettyImages-535940392_nefv31\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781491341/sanity-new/GettyImages-535940392_nefv31.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781491341/sanity-new/GettyImages-535940392_nefv31.jpg\",\"width\":5312}},\"tags\":[{\"displayName\":\"Stephen Curry\",\"id\":\"tag-stephen_curry\",\"name\":\"stephen-curry\",\"updatedAt\":\"2026-07-09T18:47:45Z\"},{\"displayName\":\"Golden State Warriors\",\"id\":\"tag-golden_state_warriors\",\"name\":\"golden-state-warriors\",\"updatedAt\":\"2026-06-08T14:22:34Z\"},{\"displayName\":\"Draymond Green\",\"id\":\"tag-draymond_green\",\"name\":\"draymond-green\",\"updatedAt\":\"2026-07-09T02:05:09Z\"},{\"displayName\":\"LeBron James\",\"id\":\"tag-lebron_james\",\"name\":\"lebron-james\",\"updatedAt\":\"2026-07-09T08:39:02Z\"},{\"displayName\":\"Cleveland Cavaliers\",\"id\":\"tag-cleveland_cavaliers\",\"name\":\"cleveland-cavaliers\",\"updatedAt\":\"2024-11-26T17:30:24Z\"},{\"displayName\":\"Steve Nash\",\"id\":\"tag-steve_nash\",\"name\":\"steve-nash\",\"updatedAt\":\"2026-07-09T18:49:45Z\"},{\"displayName\":\"Phoenix Suns\",\"id\":\"tag-phoenix_suns\",\"name\":\"phoenix-suns\",\"updatedAt\":\"2026-07-09T14:43:24Z\"},{\"displayName\":\"Chris Paul\",\"id\":\"tag-chris_paul\",\"name\":\"chris-paul\",\"updatedAt\":\"2026-06-08T14:22:28Z\"},{\"displayName\":\"Houston Rockets\",\"id\":\"tag-houston_rockets\",\"name\":\"houston-rockets\",\"updatedAt\":\"2024-11-26T17:31:38Z\"},{\"displayName\":\"James Harden\",\"id\":\"tag-james_harden\",\"name\":\"james-harden\",\"updatedAt\":\"2026-07-09T05:54:46Z\"},{\"displayName\":\"Rasheed Wallace\",\"id\":\"tag-rasheed_wallace\",\"name\":\"rasheed-wallace\",\"updatedAt\":\"2026-07-09T15:34:44Z\"},{\"displayName\":\"Chris Webber\",\"id\":\"tag-chris_webber\",\"name\":\"chris-webber\",\"updatedAt\":\"2024-11-26T17:30:26Z\"},{\"displayName\":\"Kevin Durant\",\"id\":\"tag-kevin_durant\",\"name\":\"kevin-durant\",\"updatedAt\":\"2026-07-09T07:47:41Z\"},{\"displayName\":\"Dirk Nowitzki\",\"id\":\"tag-dirk_nowitzki\",\"name\":\"dirk-nowitzki\",\"updatedAt\":\"2026-07-09T01:37:14Z\"}],\"shopLinkMatches\":[],\"shopMatchDisplayAs\":null,\"relatedProducts\":[],\"channel\":{\"alias\":{\"_type\":\"slug\",\"current\":\"bets\"},\"disableRelatedProducts\":true,\"name\":\"Bets\"},\"secondaryChannels\":[\"sports\"],\"sponsored_type\":\"not_sponsored\",\"disable_also_watch_player\":false,\"disable_comments\":false,\"disable_products\":false,\"disable_vertical_product_module\":false,\"hide_related_stories\":null,\"hide_related_products\":null,\"productRecsContextualWeight\":null,\"disable_ads\":false,\"branded_keywords\":null,\"impression_tracker_url\":null,\"disable_floating_player\":false,\"brand_safe\":null,\"body\":[{\"_key\":\"184152db5186\",\"_type\":\"block\",\"children\":[{\"_key\":\"fa4d254b47a9\",\"_type\":\"span\",\"marks\":[],\"text\":\"The past 30 years have been the best three-decade stretch in \"},{\"_key\":\"800ceddc7d59\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781491579057-wtzq5v5\"],\"text\":\"NBA\"},{\"_key\":\"564a6b537edd\",\"_type\":\"span\",\"marks\":[],\"text\":\" history, and, naturally, not \"},{\"_key\":\"e7e6aeea73b6\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781491579057-zhegfeb\"],\"text\":\"every great team won the NBA championship\"},{\"_key\":\"d3176c67eb4a\",\"_type\":\"span\",\"marks\":[],\"text\":\". There’s plenty of reasons for this. Sometimes it’s an opponent and a generational talent on an epic winning streak (see: ‘15-’16 Warriors). Sometimes it’s drawing a matchup with a team that knows your personnel too well (see: ‘06-’07 Mavs). And sometimes, maybe, \"},{\"_key\":\"00730bd5e548\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781491579057-2c5a1rl\"],\"text\":\"allegedly, the fix is in (see: ‘01-’02 Kings)\"},{\"_key\":\"c43749b1dfbb\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781491579057-wtzq5v5\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"http://nba/\"}},{\"_key\":\"adaptiveLink-1781491579057-zhegfeb\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://www.complex.com/bets/a/jack-erwin/nba-champions-last-30-years-ranked\"}},{\"_key\":\"adaptiveLink-1781491579057-2c5a1rl\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"internal\",\"reference\":{\"alias\":{\"_type\":\"slug\",\"current\":\"the-20-most-controversial-championships-in-sports-history-ranked\"},\"canonicalUrl\":\"/sports/a/jerrylbarrow/the-20-most-controversial-championships-in-sports-history-ranked\",\"docType\":\"list\",\"store\":null,\"title\":null},\"url\":null}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"13c41c778e17\",\"_type\":\"block\",\"children\":[{\"_key\":\"577073da6054\",\"_type\":\"span\",\"marks\":[],\"text\":\"Whatever the reason, there have been some truly great teams in the past 30 years that didn’t win a chip. Let’s give them their flowers. Here are \"},{\"_key\":\"ef697948b889\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"The 10 Best Teams of the Past 30 Years That Didn’t Win an NBA Championship.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"slides\":[{\"alias\":null,\"content\":[{\"_key\":\"77434986a366\",\"_type\":\"block\",\"children\":[{\"_key\":\"879574a3f897\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"36e3b286b8b1\",\"_type\":\"span\",\"marks\":[],\"text\":\"62-20\\n\"},{\"_key\":\"e15e783cef81\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"8b5caaa3261b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Western Conference Finals (San Antonio, 4-1)\\n\"},{\"_key\":\"0530abbf177f\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"86ac167c0429\",\"_type\":\"span\",\"marks\":[],\"text\":\"Steve Nash, Amar’e Stoudemire, Shawn Marion\\n\"},{\"_key\":\"06d3b6928ee1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"2967460797de\",\"_type\":\"span\",\"marks\":[],\"text\":\" MVP (Steve Nash) Assists Leader (Steve Nash), All-NBA First Team (Steve Nash) All-NBA Second Team (Amar’e Stoudemire), All-NBA Third Team (Shawn Marion), Coach of the Year (Mike D’Antoni)\\nBasketball was invented in 1891. For much of the first 115 years of its existence the conventional wisdom was that smart offensive strategy dictated a patient approach to getting the best shot. Typically this meant the shortest possible shot, despite the fact that the three-point shot, introduced in the NBA in the 1979-80 season, was worth a full 50% more than a two-point shot. In the mid-2000s Mike D’Antoni turned all of that on its head, and the NBA has never been the same and better for it ever since.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"358838429c71\",\"_type\":\"block\",\"children\":[{\"_key\":\"2d65cb2fd18d\",\"_type\":\"span\",\"marks\":[],\"text\":\"D’Antoni was a journeyman NBA/ABA player in the ‘70s who then spent more than a decade playing in Italy where he retired as the Italian LBA’s all-time leading scorer. He spent most of the ‘90s coaching in the Italian League and coached the Nuggets in the 1999 lockout year to a 14-36 record before getting fired.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"b21651d39cf4\",\"_type\":\"block\",\"children\":[{\"_key\":\"8f36e2f06d25\",\"_type\":\"span\",\"marks\":[],\"text\":\"D’Antoni was an assistant coach on a promising Suns team featuring Stephon Marbury, Shawn Marion, and Amar’e Stoudemire that went 44-38 in 2002-03. Twenty-one games into the ‘03-’04 season D’Antoni was named head coach after the team got off to an 8-13 start. They did even worse with him at the helm, finishing 29-53. Then the Suns signed Steve Nash and started a basketball revolution.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"f96e02d082a3\",\"_type\":\"block\",\"children\":[{\"_key\":\"ae35968b8575\",\"_type\":\"span\",\"marks\":[],\"text\":\"The combination of Nash, Marion, and Stoudemire was perfect for D’Antoni’s fast motion, high shot volume offense. Dubbed the “Seven Seconds or Less” offense for their approach to shot clock management, the Suns averaged 110.4 points per game, nearly seven points more than the second place Kings, and more than five points more than the previous season’s best offense, the similarly Nash-led Mavs.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"14c14b8352bc\",\"_type\":\"block\",\"children\":[{\"_key\":\"93227e3c8c0f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Nash won the first of his two consecutive MVPs in 2005, Marion and Stoudemire joined him on All NBA teams, and D’Antoni won Coach of the Year. The Suns finished 62-20 and likely would’ve racked up even more Ws if not for a six-game losing streak in January when Nash was out with an injury.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"c823ae6f009e\",\"_type\":\"block\",\"children\":[{\"_key\":\"1a98c6815990\",\"_type\":\"span\",\"marks\":[],\"text\":\"The only problem with the “Seven Seconds or Less” offense was that it gave opponents plenty of possessions as well, and Phoenix ran into a savvy San Antonio team in the second round of the playoffs. The Spurs rode hot-shooting fourth quarters to steal Games 1 and 2 in Phoenix and eventually put the Suns away in five, also taking the last game of the series on the road. San Antonio would go on to win the Finals that year.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"c5ecce4062d7\",\"_type\":\"block\",\"children\":[{\"_key\":\"7dcf0f42aef6\",\"_type\":\"span\",\"marks\":[],\"text\":\"The “Seven Seconds or Less” era would last three more seasons in Phoenix, including a trip to the WCF in ‘06 and another 60-plus win season ended by San Antonio in the playoffs in ‘07. That iteration of the Suns never reached an NBA Finals, but its influence is everywhere in the NBA today,\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"2906b15683b6\",\"_type\":\"block\",\"children\":[{\"_key\":\"854fecded847\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"cec1d487bc7f\",\"_type\":\"block\",\"children\":[{\"_key\":\"1507771663c6\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2004-2005 Phoenix Suns\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"15150f3c61c9\",\"leadMedia\":{\"_key\":\"8c5bdf645da3\",\"_type\":\"cloudinaryImage\",\"altText\":\"Steve Nash and Mike D'Antoni strategize during a Phoenix Suns game in the 2005 NBA Playoffs. \",\"credit\":\"Photo by Barry Gossage/NBAE via Getty Images\",\"image\":{\"_key\":\"DTUt7i6PLjIOZLt8lNb6M\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2023,\"width\":3108,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":1554,\"y\":1012},\"height\":2023,\"transformationString\":\"c_crop,h_2023,w_3108,x_0,y_0/g_auto:aoi_1243_810_622_405\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2023,w_3108,x_0,y_0/g_auto:aoi_1243_810_622_405/sanity-new/GettyImages-52815664_rttqt1\",\"width\":3108},\"folder\":\"sanity-new\",\"height\":2025,\"public_id\":\"sanity-new/GettyImages-52815664_rttqt1\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781496420/sanity-new/GettyImages-52815664_rttqt1.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781496420/sanity-new/GettyImages-52815664_rttqt1.jpg\",\"width\":3108},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"c4d9244a9513\",\"_type\":\"block\",\"children\":[{\"_key\":\"7ac97e147be7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"bfe7957b4efa\",\"_type\":\"span\",\"marks\":[],\"text\":\"57-25\\n\"},{\"_key\":\"7714ef4f1e0b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"3f459c6d09e8\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost NBA Finals (Toronto, 4-2)\\n\"},{\"_key\":\"10d233ab9bad\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"d09b80a08155\",\"_type\":\"span\",\"marks\":[],\"text\":\"Stephen Curry, Kevin Durant, Klay Thompson\\n\"},{\"_key\":\"80fb8fb0744d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"f42b855c56b0\",\"_type\":\"span\",\"marks\":[],\"text\":\" All-NBA First Team (Stephen Curry), All-NBA Second Team (Kevin Durant)\\nEntering the 2018-19 season, it seemed entirely possible that \"},{\"_key\":\"2e916acd4f27\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781496051865-pn4ud6i\"],\"text\":\"the Hamptons Five Warriors\"},{\"_key\":\"d827eaa3bfb5\",\"_type\":\"span\",\"marks\":[],\"text\":\" could join the ‘60s Celtics and ‘90s Bulls as the greatest NBA dynasties of all time. They’d won three of the previous four Finals and had just swept the Cavs the previous June. Kevin Durant and Steph Curry were 30; Draymond Green, Klay Thompson, and Demarcus Cousins were 28. Sure, they’d been pushed to seven games in the ‘18 WCF by James Harden, Chris Paul and the Rockets, but no one was buying Houston futures over Golden State. But a year later KD was in Brooklyn, Klay was beginning a full-season rehab, and, a heartwarming coda championship in ‘22 notwithstanding, the Dubs dynasty was over.\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781496051865-pn4ud6i\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://en.wikipedia.org/wiki/Death_Lineup\"}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"ee5c61a50087\",\"_type\":\"block\",\"children\":[{\"_key\":\"e964ef3aad08\",\"_type\":\"span\",\"marks\":[],\"text\":\"Golden State jumped out to a 10-1 start to the 2018-19 season, but a calf injury to Curry precipitated a 5-8 stretch, including a very uncharacteristic four-game losing streak. Sadly, it would be a sign of things to come.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"198282b648c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"e999292cce24\",\"_type\":\"span\",\"marks\":[],\"text\":\"Despite Curry’s injury, the Warriors won the Pacific Division and No. 1 seed in the West, finishing three games up on the Nuggets and four on the Rockets and Trail Blazers. The offense was still elite, first in the league with KD, Steph, and Klay all averaging 20-plus, but the defense slipped to 13th best in the league.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"7cd8a5882258\",\"_type\":\"block\",\"children\":[{\"_key\":\"993cf6753d38\",\"_type\":\"span\",\"marks\":[],\"text\":\"In the playoffs Golden State cruised through the Western Conference bracket 12-4, but injuries plagued them throughout, with Cousins, Curry, Durant, Igoudala, Thompson, and Kevin Looney all missing time. Infamously, KD ruptured his Achilles while playing through a calf strain, and Thompson tore his ACL while playing through a hamstring strain. It was a Herculean effort for a team of Warriors, but not enough to beat the Kawhi Leonard-led Raptors in the Finals.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"1a25957895e2\",\"_type\":\"block\",\"children\":[{\"_key\":\"b39de99c1b75\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"db3d70b46770\",\"_type\":\"block\",\"children\":[{\"_key\":\"2b26bea37acf\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2018-2019 Golden State Warriors\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"e607ea0a7b18\",\"leadMedia\":{\"_key\":\"864ece12e533\",\"_type\":\"cloudinaryImage\",\"altText\":\"Kevin Durant walks off the court (alongside Draymond Green) after tearing his Achilles during Game 5 of the 2019 NBA Finals. \",\"credit\":\"Photo by Claus Andersen/Getty Images\",\"image\":{\"_key\":\"ecWsEN2OTJaHTD1jmRV40\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2431,\"width\":3600,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":1800,\"y\":1216},\"height\":2431,\"transformationString\":\"c_crop,h_2431,w_3600,x_0,y_0/g_auto:aoi_1440_973_720_486\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2431,w_3600,x_0,y_0/g_auto:aoi_1440_973_720_486/sanity-new/GettyImages-1155275418_nkcz78\",\"width\":3600},\"folder\":\"sanity-new\",\"height\":2430,\"public_id\":\"sanity-new/GettyImages-1155275418_nkcz78\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781496194/sanity-new/GettyImages-1155275418_nkcz78.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781496194/sanity-new/GettyImages-1155275418_nkcz78.jpg\",\"width\":3600},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"02b0d84f797a\",\"_type\":\"block\",\"children\":[{\"_key\":\"f2e81aca8bde\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"df41cf2f0ccd\",\"_type\":\"span\",\"marks\":[],\"text\":\"64-18\\n\"},{\"_key\":\"9c4a17a243e3\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"730e10e7388f\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Western Conference Semifinals (Dallas, 4-3)\\n\"},{\"_key\":\"106a4141ff9c\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"66f8863813a5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Chris Paul, Devin Booker\\n\"},{\"_key\":\"a5e8b3b36dd5\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"38eed10086ad\",\"_type\":\"span\",\"marks\":[],\"text\":\" All-NBA First Team (Devin Booker), All-NBA Third Team (Chris Paul), Assists Leader (Chris Paul), Coach of the Year (Monty Williams) \\nHere’s how one half—one quarter even—can derail a promising franchise.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"4cd3587e53dc\",\"_type\":\"block\",\"children\":[{\"_key\":\"6a4d80c03416\",\"_type\":\"span\",\"marks\":[],\"text\":\"In 2021 the Suns took the Bucks to six games in the NBA Finals. That year they finished with a very respectable 51 wins but had a young core and a wily vet with a little still left in the tank that promised even more.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"4661c5e4af73\",\"_type\":\"block\",\"children\":[{\"_key\":\"c8cc895aa42e\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Suns won 64 games in 2021-22, and the young core established itself even more. In their age 25 seasons, Devin Booker and Mikal Bridges finished in the top 5 of the MVP and DPOY voting, Chris Paul was a top 10 MVP finisher and led the league in assists, Deandre Ayton averaged a triple double for the fourth consecutive year as a 23-year-old, and Cam Johnson finished top 3 in the 6th Man of the Year voting at age 25.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"67952cda6d6d\",\"_type\":\"block\",\"children\":[{\"_key\":\"f2f962a5fa27\",\"_type\":\"span\",\"marks\":[],\"text\":\"Finishing eight games better than anyone in the league, the Suns were the heavy favorites to win the title, but reasons for worry emerged in the first round during a harder than expected six game series with the Pelicans. The Suns traded home wins with the Luka Doncic-led Mavs in the semis, setting up a Game 7 in Phoenix.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"4c5f8712e0c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"05b701120d78\",\"_type\":\"span\",\"marks\":[],\"text\":\"And then the young Suns seemed to wilt under the pressure of a G7. Down 10 at the end of the first quarter, the Suns imploded in the second, shooting 4-18 and 0-6 from three and scoring just 10 points in the quarter to go down 57-27 at the half. The Suns trailed by as many as 46 points and were down 92-50 after three quarters in one of the all-time worst face plants in NBA playoffs history.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"d9b6d64b2e10\",\"_type\":\"block\",\"children\":[{\"_key\":\"ffa271ca91f5\",\"_type\":\"span\",\"marks\":[],\"text\":\"The next year the Suns would trade Bridges, Johnson, and others to the Nets for Kevin Durant; two days after another blowout playoff loss at home, coach Monty Williams would be fired. The team has cycled through two more coaches since, and only Booker remains from the once promising 2022 core.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"0b1a448257ed\",\"_type\":\"block\",\"children\":[{\"_key\":\"815c4f0aaa28\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"36b92cf6d87a\",\"_type\":\"block\",\"children\":[{\"_key\":\"732c6b249127\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2021-2022 Phoenix Suns\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"fdcdccc15a72\",\"leadMedia\":{\"_key\":\"349533b52fef\",\"_type\":\"cloudinaryImage\",\"altText\":\"Mikal Bridges, Devin Booker, and Chris Paul look on during Game 7 of the 2022 Western Conference Semifinals. \",\"credit\":\"Photo by Christian Petersen/Getty Images\",\"image\":{\"_key\":\"29oGV4TfhqZMpC1OLDXGl\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2683,\"width\":3885,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":1943,\"y\":1342},\"height\":2683,\"transformationString\":\"c_crop,h_2683,w_3885,x_0,y_0/g_auto:aoi_1555_1074_777_537\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2683,w_3885,x_0,y_0/g_auto:aoi_1555_1074_777_537/sanity-new/GettyImages-1397468129_ou8ajc\",\"width\":3885},\"folder\":\"sanity-new\",\"height\":2686,\"public_id\":\"sanity-new/GettyImages-1397468129_ou8ajc\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781495980/sanity-new/GettyImages-1397468129_ou8ajc.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781495980/sanity-new/GettyImages-1397468129_ou8ajc.jpg\",\"width\":3885},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"082e5d78e460\",\"_type\":\"block\",\"children\":[{\"_key\":\"86ec239fae11\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"88e250cee161\",\"_type\":\"span\",\"marks\":[],\"text\":\"59-23\\n\"},{\"_key\":\"38718eca9e03\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"2a4b5c96494e\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Western Conference Finals (Los Angeles Lakers, 4-2)\\n\"},{\"_key\":\"7b251510b843\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"0e85bd1e1c9c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Rasheed Wallace\\n\"},{\"_key\":\"7da11ac105e7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"c483ccb0dab4\",\"_type\":\"span\",\"marks\":[],\"text\":\" N/A\\nIn hindsight, the Lakers’ threepeat at the top of the 21st Century seems effortless and almost preordained. Led by two icons of the game, LA’s record in the ‘00, ‘01, and ‘02 Finals was a combined 12-3. But the Shaq-Kobe mini dynasty was nearly finished before it could even start.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"f17e0a509cb2\",\"_type\":\"block\",\"children\":[{\"_key\":\"88a290c0733a\",\"_type\":\"span\",\"marks\":[],\"text\":\"With 10 minutes to go in the fourth quarter of Game 7 of the 2000 Western Conference Finals, the Portland Trail Blazers led the Lakers by 15 points. It was also a veteran Portland squad that should’ve known how to hold a lead.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"1d4c2381f378\",\"_type\":\"block\",\"children\":[{\"_key\":\"4c983524da2c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Led by Scottie Pippen, the Trail Blazers had youth with Rasheed Wallace and Damon Stoudamire entering their primes alongside an emerging Bonzi Wells, and veteran, albeit hobbled leadership from vets like Arvydas Sabonis, Steve Smith, Detlef Schrempf, Brian Grant, and Greg Anthony. They won 59 games in the regular season, second in both the Pacific and the league overall to the Lakers’ 67.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"9f14fe5cc3f8\",\"_type\":\"block\",\"children\":[{\"_key\":\"52a81ffb3d65\",\"_type\":\"span\",\"marks\":[],\"text\":\"Portland dropped just two games in the first two rounds of the ‘00 playoffs, beating the Timberwolves in four and the Jazz in five. They then fell behind 1-3 to the Lakers before winning Game 5 on the road and Game 6 at home. Entering the fourth quarter of Game 7, they looked poised to pull off an all-time great comeback and upset.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"9e4ef3ecf760\",\"_type\":\"block\",\"children\":[{\"_key\":\"705406d1d9f8\",\"_type\":\"span\",\"marks\":[],\"text\":\"And then came some dreadful shooting from the Blazers (5-23 overall, with Wallace going 3-9 and Smith 1-5), some perhaps questionable calls (Sabonis fouled out and the Lakers shot 18 free throws in the quarter to the Blazers four), and arguably \"},{\"_key\":\"25155279d98a\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781495668286-5ihc7ms\"],\"text\":\"the high-water mark\"},{\"_key\":\"01e0f47ffefc\",\"_type\":\"span\",\"marks\":[],\"text\":\" of the Shaq-Kobe era.\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781495668286-5ihc7ms\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://www.youtube.com/watch?v=sKhIDYJdsQY\"}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"9b209106925a\",\"_type\":\"block\",\"children\":[{\"_key\":\"007e98c24d74\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"39f6f73161f0\",\"_type\":\"block\",\"children\":[{\"_key\":\"2c014c3cae96\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"1999-2000 Portland Trail Blazers\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"f3936c68e335\",\"leadMedia\":{\"_key\":\"7829a1f60af9\",\"_type\":\"cloudinaryImage\",\"altText\":\"Arvydas Sabonis looks on as Rasheed Wallace screams at a referee during a Portland Trail Blazers-Utah Jazz NBA playoff game. \",\"credit\":\"BRETT CRANDALL/AFP via Getty Images\",\"image\":{\"_key\":\"wEugfnBjNk8wYXJzaPytO\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":1291,\"width\":1954,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":977,\"y\":646},\"height\":1291,\"transformationString\":\"c_crop,h_1291,w_1954,x_0,y_0/g_auto:aoi_782_517_391_258\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_1291,w_1954,x_0,y_0/g_auto:aoi_782_517_391_258/sanity-new/GettyImages-51965486_c1slwu\",\"width\":1954},\"folder\":\"sanity-new\",\"height\":1291,\"public_id\":\"sanity-new/GettyImages-51965486_c1slwu\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781495771/sanity-new/GettyImages-51965486_c1slwu.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781495771/sanity-new/GettyImages-51965486_c1slwu.jpg\",\"width\":1954},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"368953b962cb\",\"_type\":\"block\",\"children\":[{\"_key\":\"4f3ae45259dd\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"faab42f80266\",\"_type\":\"span\",\"marks\":[],\"text\":\"67-15\\n\"},{\"_key\":\"c4eb67bc35ba\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"718446d52821\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Western Conference First Round (Golden State, 4-2)\\n\"},{\"_key\":\"eaa12e0ec712\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"b050a9892144\",\"_type\":\"span\",\"marks\":[],\"text\":\"Dirk Nowitzki, Josh Howard\\n\"},{\"_key\":\"b83e6fa45839\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"ffb8fc8c21a8\",\"_type\":\"span\",\"marks\":[],\"text\":\" MVP (Dirk Nowitzki), All-NBA First Team (Dirk Nowitzki)\\nHow do you respond to blowing a 2-0 lead in the Finals? How about setting a franchise record for wins in the following regular season, with your young star winning MVP? That works. Just don’t follow that by losing in the first round of the playoffs.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"009c03efae71\",\"_type\":\"block\",\"children\":[{\"_key\":\"3239ee5ef29e\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Mavs of the ‘00s were excellent, playing in a conference that included other heavyweights like the Shaq-Kobe Lakers, the Duncan-Parker-Ginobili Spurs, and the Seven Seconds or Less Suns. In 2000-’01, with a lineup led by Nash, Dirk Nowitzki, and Michael Finley, Dallas began a run of 11 straight 50-plus win seasons, including three with 60-plus. It was a core conceived and coached by Don Nelson and built around a flowing offense predicated on Nash’s playmaking and Nowitzki and Finley’s scoring. Nash left for Phoenix after the ‘03-’04 season and Don Nelson resigned late in the ‘04-’05 campaign; the team responded by upping its win total by six games, and reached the Finals in ‘06 with Avery Johnson at the helm.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"1692e0d54ae8\",\"_type\":\"block\",\"children\":[{\"_key\":\"791591f4afd8\",\"_type\":\"span\",\"marks\":[],\"text\":\"After that Finals loss, the Mavs entered the ‘06-’07 with a young, talented, and very deep roster, with a rotation that saw 11 regulars average more than 10 minutes a game. Dirk won MVP averaging 24.6/8.9/3.4, Josh Howard made the only All-Star game of his career, and Dallas got key contributions from vets like Jason Terry, Jerry Stackhouse, and Erick Dampier, and youngsters like Devin Harris.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"29abb011a609\",\"_type\":\"block\",\"children\":[{\"_key\":\"f4d943658458\",\"_type\":\"span\",\"marks\":[],\"text\":\"And then the Mavs met the Warriors in the first round of the playoffs, coached by a familiar face: Don Nelson. The architect of the Mavs’ core had returned to coaching for a second stint with the Warriors before the ‘06-’07 season. Golden State needed a 16-5 close to the regular season just to make the playoffs, and then pulled off one of the greatest upsets in NBA playoff history, winning the first game in Dallas and holding serve at home to bounce the Mavs in six. Dallas would lose in the first round three of the next four years, before upsetting the Heat in 2011.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"3878b845fcac\",\"_type\":\"block\",\"children\":[{\"_key\":\"68bfed9c9b77\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2006-2007 Dallas Mavericks\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"c45b1e04193b\",\"leadMedia\":{\"_key\":\"34c752b81435\",\"_type\":\"cloudinaryImage\",\"altText\":\"Josh Howard and Dirk Nowitzki walk onto the court during Game 4 of the Western Conference First Round Series. \",\"credit\":\"Photo by Jed Jacobsohn/Getty Images\",\"image\":{\"_key\":\"bAxFATtv39iqvNZrdM8Cq\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2344,\"width\":3000,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":1500,\"y\":1172},\"height\":2344,\"transformationString\":\"c_crop,h_2344,w_3000,x_0,y_0/g_auto:aoi_1200_938_600_469\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2344,w_3000,x_0,y_0/g_auto:aoi_1200_938_600_469/sanity-new/GettyImages-74025662_fmjolh\",\"width\":3000},\"folder\":\"sanity-new\",\"height\":2346,\"public_id\":\"sanity-new/GettyImages-74025662_fmjolh\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781495608/sanity-new/GettyImages-74025662_fmjolh.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781495608/sanity-new/GettyImages-74025662_fmjolh.jpg\",\"width\":3000},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"09b1069e4258\",\"_type\":\"block\",\"children\":[{\"_key\":\"c247d1581b88\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"2c1ea5621280\",\"_type\":\"span\",\"marks\":[],\"text\":\"61-21\\n\"},{\"_key\":\"cfd4b8992cc6\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"e079e45b1f8b\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Western Conference Finals (Los Angeles Lakers, 4-3)\\n\"},{\"_key\":\"9d362da830de\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"ce50745ad0f3\",\"_type\":\"span\",\"marks\":[],\"text\":\"Chris Webber, Peja Stojakovic\\n\"},{\"_key\":\"0bd98b87db40\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"ae050100e7fd\",\"_type\":\"span\",\"marks\":[],\"text\":\" All-NBA Second Team (Chris Webber)\\nWhat’s the only NBA team to be the \"},{\"_key\":\"98035f644c6e\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781495330194-3jtjb72\"],\"text\":\"subject of a letter from iconic consumer rights advocate Ralph Nader\"},{\"_key\":\"097f94655ded\",\"_type\":\"span\",\"marks\":[],\"text\":\" to NBA commissioner David Stern? The 2002 Sacramento Kings. (Well, the Kings and the 2002 Lakers. We’ll explain.)\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781495330194-3jtjb72\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://www.espn.com/espn/page2/story?page=neumann/080611\"}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"12111b26fec9\",\"_type\":\"block\",\"children\":[{\"_key\":\"35696ad410b9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Beginning in the lockout-shortened 1999 season, the Kings—traditionally a perennial laughingstock—suddenly became one of the most entertaining, and eventually best, teams in the league. That year they hired coach Rick Adelman (who’d taken the Trail Blazers to two Finals in the early ‘90s), traded for Chris Webber, signed free agents Vlade Divac and Scot Pollard, and saw the debut of 1996 draft pick Peja Stojakovic, the quartet that would form the core of the most successful run in franchise history.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"fe3c674158ea\",\"_type\":\"block\",\"children\":[{\"_key\":\"1e248f3573fb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Entering the 2001-02 season the Kings had seen steady improvement, albeit without much playoff success. The previous offseason they’d traded point guard Jason “White Chocolate” Williams to the Grizzlies for Mike Bibby. Despite Webber missing the first 20 games of the season, Sacramento finished 61-21, good for first in the NBA, three games ahead of the Spurs and the two-time defending champ Lakers. The Kings ran a balanced attack that saw seven regulars average 10+ points per game; they also featured stout defense led by second team all-defense selection Doug Christie.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"82f33ccb2a41\",\"_type\":\"block\",\"children\":[{\"_key\":\"6c57d08da2d9\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sacramento dropped just two games in the first two rounds of the playoffs, setting up a conference finals clash with the Lakers. Up 3-2 and looking to close out in LA, the Kings trailed by one with 12 seconds left when Bibby was taken out by a Kobe Bryant elbow to the face that was, amazingly, ca lled a foul on Bibby. (\"},{\"_key\":\"e5856f7377d0\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781495330194-hkycuv3\"],\"text\":\"Check the video\"},{\"_key\":\"072d2f20dad6\",\"_type\":\"span\",\"marks\":[],\"text\":\" for a play that’s a few things at once: 1. An example of “playoff basketball” in the ‘90s/early ‘00s; 2. Probably a Flagrant 2 in 2026; 3. Most definitely not a foul on Bibby.)\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781495330194-hkycuv3\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://www.youtube.com/watch?v=mbWgWZjo1nI\"}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"547d1c3e440e\",\"_type\":\"block\",\"children\":[{\"_key\":\"8e0d24b32f41\",\"_type\":\"span\",\"marks\":[],\"text\":\"That foul alone, while arguably game- and series-changing, isn’t the reason Ralph Nader was writing letters to David Stern and every NBA fan who didn’t bleed purple and gold was shouting conspiracy. The Kings were whistled for 31 fouls in the game (to the Lakers’ 24), which is not remarkable in itself, but \"},{\"_key\":\"e296f7050737\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"16 of those were called in the fourth quarter\"},{\"_key\":\"12436864d660\",\"_type\":\"span\",\"marks\":[],\"text\":\" (compared to eight for the LA). The Lakers attempted 27 free throws in the 4th and made 21; they attempted 13 field goals and made five.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"0b179e7373b7\",\"_type\":\"block\",\"children\":[{\"_key\":\"98a3c5e5bb86\",\"_type\":\"span\",\"marks\":[],\"text\":\"Sticking to the script, the Lakers proceeded to win Game 7 on the road in OT, with Webber, Bibby, and especially Christie having poor shooting nights. And the free throws were distributed more equally, with LA taking 33 for the game (and hitting 27) and Sacramento shooting 30 (and making just 16—hit just one of those and this team might be on the other list). The Kings had a couple more very good seasons, including another Pacific Division title over the Lakers the following year, but couldn’t advance past the second round of the playoffs.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"a129ce6c1860\",\"_type\":\"block\",\"children\":[{\"_key\":\"4484a7e66cfc\",\"_type\":\"span\",\"marks\":[],\"text\":\"And then the footnote. In 2008, disgraced NBA referee Tim Donaghy, convicted of fixing games he officiated, \"},{\"_key\":\"60be091e0239\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781495330194-ec08u34\"],\"text\":\"alleged that two of the refs in Game 6 of the 2002 WCF\"},{\"_key\":\"77f769df8d7c\",\"_type\":\"span\",\"marks\":[],\"text\":\" fixed that game because they were “company men” who conspired to favor the Lakers because “it was in the NBA’s interest to add another game to the series.”\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781495330194-ec08u34\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://www.espn.com/nba/news/story?id=3436401\"}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"e03612ef4e9c\",\"_type\":\"block\",\"children\":[{\"_key\":\"28815481fd2d\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"1811ef039bbd\",\"_type\":\"block\",\"children\":[{\"_key\":\"eeea0063bf78\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2001-2002 Sacramento Kings\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"9b7787fc7c8a\",\"leadMedia\":{\"_key\":\"dcc282986ce6\",\"_type\":\"cloudinaryImage\",\"altText\":\"Kings Chris Webber watches his team hopes against the Lakers in Game 7 of the Western Conference Finals at the Arco Arena Sunday June 2, 2002. \",\"credit\":\"Photo by Wally Skalij/Los Angeles Times via Getty Images\",\"image\":{\"_key\":\"mp6iY7X7RFGn51nRVqD5X\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":1075,\"width\":1700,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":850,\"y\":538},\"height\":1075,\"transformationString\":\"c_crop,h_1075,w_1700,x_0,y_0/g_auto:aoi_680_431_340_215\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_1075,w_1700,x_0,y_0/g_auto:aoi_680_431_340_215/sanity-new/GettyImages-563609265_ivamjo\",\"width\":1700},\"folder\":\"sanity-new\",\"height\":1074,\"public_id\":\"sanity-new/GettyImages-563609265_ivamjo\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781495435/sanity-new/GettyImages-563609265_ivamjo.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781495435/sanity-new/GettyImages-563609265_ivamjo.jpg\",\"width\":1700},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"a3000577c5f0\",\"_type\":\"block\",\"children\":[{\"_key\":\"8520816f3af0\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"79a9ef9a2431\",\"_type\":\"span\",\"marks\":[],\"text\":\"65-17\\n\"},{\"_key\":\"d9fa99a4338d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"923f84557fc1\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Western Conference Finals (Golden State, 4-3)\\n\"},{\"_key\":\"e95785f17f12\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"617d7a57369a\",\"_type\":\"span\",\"marks\":[],\"text\":\"James Harden\\n\"},{\"_key\":\"78396861a8a5\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"1eb80c109514\",\"_type\":\"span\",\"marks\":[],\"text\":\" MVP (James Harden), All-NBA First Team (James Harden), Scoring Champ (James Harden)\\nYou miss 100% of the shots you don’t take. But if you’ve already missed 20 in a row, maybe try a shorter shot for a little while.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"37703c83f10e\",\"_type\":\"block\",\"children\":[{\"_key\":\"4dc3d2822901\",\"_type\":\"span\",\"marks\":[],\"text\":\"Prior to the ‘17-’18 season the Rockets had an emerging core led by James Harden and role players like Eric Gordon, Trevor Ariza, and Clint Capela. With head coach Mike D’Antoni they were spectacular on offense (their offensive rating was second in the league) and far from it on defense (18th).\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"6a0fd9733278\",\"_type\":\"block\",\"children\":[{\"_key\":\"34a6e513012d\",\"_type\":\"span\",\"marks\":[],\"text\":\"In June 2017 Houston GM Daryl Morey traded seven players and a first round pick to the Clippers for Chris Paul, and despite worries that CP3 talents would overlap too much with Harden’s, the addition was genius. With Paul running the show and new addition PJ Tucker shoring up the defense, the Rockets were first in offensive rating, and a much improved sixth in defensive rating, good for a league-best +8.7 net rating. Harden won MVP, six regulars averaged 10-plus points a game, the team set the all-time record for threes in a season, and Houston finished with a franchise-record 65 wins, seven more than the defending champ Warriors.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"841847c7a216\",\"_type\":\"block\",\"children\":[{\"_key\":\"dac977ad587a\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Rockets cruised through the first two rounds of the playoffs before injury and an epically bad shooting streak struck. With the series tied at two games a piece, Houston went up 3-2 thanks to seven fourth quarter points from Paul at home in Game 5. But Paul also injured his hamstring late in the game and wouldn’t play for the remainder of the series.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"16359d5503d4\",\"_type\":\"block\",\"children\":[{\"_key\":\"d6c25066a992\",\"_type\":\"span\",\"marks\":[],\"text\":\"Still, the Rockets led by 11 at halftime of Game 7 at home before going completely cold from deep, at one point missing 27 consecutive threes (Harden was 2-13 on threes for the game; Gordon 2-12). In the final two games of the series Houston was outscored 122-63 in the second half. Paul would finally get to the Finals in ‘21 with the Suns but became the first player to play on four teams who blew 2-0 series leads after Milwaukee topped Phoenix in 6.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"36ad9ae15cf4\",\"_type\":\"block\",\"children\":[{\"_key\":\"7d592ce984c7\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"7f179215a9cf\",\"_type\":\"block\",\"children\":[{\"_key\":\"43859f5ee262\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2017-2018 Houston Rockets\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"e1a5069cc5e0\",\"leadMedia\":{\"_key\":\"36fddfd13e28\",\"_type\":\"cloudinaryImage\",\"altText\":\"Chris Paul and James Harden step onto the court during Game 4 of the 2018 Western Conference Semifinals. \",\"credit\":\"Photo by Noah Graham/NBAE via Getty Images\",\"image\":{\"_key\":\"OayCtSnbjg6PNvO-w7H4A\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2946,\"width\":4414,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":2207,\"y\":1473},\"height\":2946,\"transformationString\":\"c_crop,h_2946,w_4414,x_0,y_0/g_auto:aoi_1766_1179_883_589\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2946,w_4414,x_0,y_0/g_auto:aoi_1766_1179_883_589/sanity-new/GettyImages-961547260_wtpw17\",\"width\":4414},\"folder\":\"sanity-new\",\"height\":2943,\"public_id\":\"sanity-new/GettyImages-961547260_wtpw17\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781493254/sanity-new/GettyImages-961547260_wtpw17.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781493254/sanity-new/GettyImages-961547260_wtpw17.jpg\",\"width\":4414},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"8c1f9d4e7eea\",\"_type\":\"block\",\"children\":[{\"_key\":\"442d6f3f1b94\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"fca7b839041a\",\"_type\":\"span\",\"marks\":[],\"text\":\"67-15\\n\"},{\"_key\":\"e73fa30a6663\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"5155888b3afb\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Western Conference Semifianls (Oklahoma City, 4-2)\\n\"},{\"_key\":\"f4f28d1934a2\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"4c6515de2640\",\"_type\":\"span\",\"marks\":[],\"text\":\"Kawhi Leonard, LaMarcus Aldridge\\n\"},{\"_key\":\"ccfafdf4c614\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"dae2075b024a\",\"_type\":\"span\",\"marks\":[],\"text\":\" Defensive Players of the Year (Kawhi Leonard), All-NBA First Team (Kawhi Leonard), All-NBA Third Team (LaMarcus Aldridge)\\nHere’s a list of teams from the last 30 years with 65+ wins and a plus-10 net rating: ‘95-’96 Bulls (champs), ‘96-’97 Bulls (champs), ‘07-’08 Celtics (champs), ‘14-’15 Warriors (champs), ‘16-’17 Warriors (champs), ‘24-’25 Thunder (champs), ‘08-’09 Cavs (lost Eastern Conference Finals), ‘15-’16 Warriors (lost Finals); ‘15-’16 Spurs (lost West semis).\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"5409f3dbb8bb\",\"_type\":\"block\",\"children\":[{\"_key\":\"d5024f2fadca\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Warriors epic 2015-16 regular season and just as epic 2016 Finals loss obscures the fact that, judging by a key metric of team performance, the 2015-16 Spurs could be called a better team. Of course wins and losses are the key metric of team performance, and San Antonio had six fewer of the former (which is why Golden State appears later on this list). But the ‘15-’16 Spurs were great nonetheless.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"8449b6eb5785\",\"_type\":\"block\",\"children\":[{\"_key\":\"a866a1fcc1f5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Take the net rating alluded to above: Led by Kawhi Leonard, LaMarcus Aldridge, and Tony Parker, the Spurs were fourth in offensive rating at 110.3 and first in defensive rating at 99.0, good for plus 11.3 (the Warriors were 114.5 and 103.8, good for a plus 10.7). And the Spurs weren’t playing in a league with a dozen tanking teams, either. In addition to the Warriors, the West featured a 55-win Thunder team led by Kevin Durant and Russell Westbrook, and a 53-win Clippers team led by Chris Paul, Deandre Jordan, and an injured Blake Griffin.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"0890e5b2bf18\",\"_type\":\"block\",\"children\":[{\"_key\":\"c8003d3a0b4e\",\"_type\":\"span\",\"marks\":[],\"text\":\"The 2015-16 season was the year Kawhi Leonard became a superstar. He was the Defensive Player of the Year the previous season; in ‘15-’16 he defended that title and finished second to Steph Curry in the MVP race. Aldridge had a typically excellent season, Tim Duncan showed flashes of past brilliance in his last year, and franchise stalwarts like Parker, Manu Ginobili, Boris Diaw, and Danny Green continued to be one of the best collections of role players in league history.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"a33de0ff5ec2\",\"_type\":\"block\",\"children\":[{\"_key\":\"342f39adf4af\",\"_type\":\"span\",\"marks\":[],\"text\":\"After sweeping the Grizzlies in the first round and taking a 2-1 lead on the Thunder in the conference semis, the Spurs dropped three straight to OKC, with Leonard having bad shooting performances in Games 4 and 6, and KD and Russ doing peak KD and Russ things for the Thunder. Duncan unexpectedly retired the following summer, and the Spurs had one more 60+-win season before a slow fade until the Wembanyama era.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"ef962c8245b8\",\"_type\":\"block\",\"children\":[{\"_key\":\"fd82d176aa7c\",\"_type\":\"span\",\"marks\":[],\"text\":\"\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"56208521d31c\",\"_type\":\"block\",\"children\":[{\"_key\":\"6205988e567c\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2015-2016 San Antonio Spurs\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"30d661b85438\",\"leadMedia\":{\"_key\":\"6552628d9c49\",\"_type\":\"cloudinaryImage\",\"altText\":\"Tim Duncan, Kawhi Leonard, and LaMarcus Aldridge and the 2016 San Antonio Spurs argue with the referee. \",\"credit\":\"Photo by Wesley Hitt/Getty Images\",\"image\":{\"_key\":\"G73S_c-7W-sXR1gm0aAOz\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2774,\"width\":4158,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":2079,\"y\":1387},\"height\":2774,\"transformationString\":\"c_crop,h_2774,w_4158,x_0,y_0/g_auto:aoi_1663_1110_832_555\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2774,w_4158,x_0,y_0/g_auto:aoi_1663_1110_832_555/sanity-new/GettyImages-505348082_yttfyj\",\"width\":4158},\"folder\":\"sanity-new\",\"height\":2772,\"public_id\":\"sanity-new/GettyImages-505348082_yttfyj\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781493063/sanity-new/GettyImages-505348082_yttfyj.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781493063/sanity-new/GettyImages-505348082_yttfyj.jpg\",\"width\":4158},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"0cccef24d5b9\",\"_type\":\"block\",\"children\":[{\"_key\":\"9a6632f5d030\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"4fe7c5b818df\",\"_type\":\"span\",\"marks\":[],\"text\":\"66-16\\n\"},{\"_key\":\"a9962f542024\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"42abe23f1076\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost Eastern Conference Finals (Orlando, 4-2)\\n\"},{\"_key\":\"073ee078ae6b\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"2dba07bb9252\",\"_type\":\"span\",\"marks\":[],\"text\":\"LeBron James, Mo Williams\\n\"},{\"_key\":\"e479c244b5c4\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"285731bd5626\",\"_type\":\"span\",\"marks\":[],\"text\":\" All-NBA First Team (LeBron James), Coach of the Year (Mike Brown) \\nOn May 20, 2009 LeBron James was 24 and the toast of the NBA. He’d led the Cavs to the Finals two years earlier; in a few weeks he’d win his first MVP and finish second in the Defensive Player of the Year voting. And in 10 days, his tenure in Cleveland and his honeymoon era seemed irredeemably soured, setting in motion a series of events that would change the NBA for the next decade.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"60aa3d988e21\",\"_type\":\"block\",\"children\":[{\"_key\":\"e3d3507edda6\",\"_type\":\"span\",\"marks\":[],\"text\":\"LeBron’s ‘08-’09 season was one of the greats of all time. He played 81 games (that won’t happen again), averaging 28.4/7.6/7.2 and played suffocating defense (1.7 steals and 1.1 blocks per game) for a team that went 66-16 and finished with a plus-10 net rating.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"14ccc0057f4a\",\"_type\":\"block\",\"children\":[{\"_key\":\"e26368dec62b\",\"_type\":\"span\",\"marks\":[],\"text\":\"The supporting cast was, well, capable (if you can’t say something nice…). Mo Williams averaged 17+ points a game and made the All-Star team; Zydrunas Ilgauskas, Delonte West, and Anderson Varejao rounded out the regular starting lineup, and Ben Wallace, Wally Szczerbiak, and Joe Smith offered a veteran presence. But that’s not exactly a rotation of up-and-comers, and it showed in the playoffs.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"d6c989c7706d\",\"_type\":\"block\",\"children\":[{\"_key\":\"4ee97444bcfd\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Cavs swept the Pistons and Hawks in the first two rounds of the East bracket, but ran into immediate trouble in the ECF against the Magic. In a 107-106 Game 1 loss at home, LeBron dropped 49 on 20-30 shooting; the rest of the team scored 57 on 23-58. The bench in particular contributed nothing, and Orlando got a balanced attack led by Dwight Howard’s 30/13.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"3f49788750fd\",\"_type\":\"block\",\"children\":[{\"_key\":\"a7f9b95aa089\",\"_type\":\"span\",\"marks\":[],\"text\":\"While Cleveland took Games 2 and 5, with LeBron going for 37/14/12 in G5 to stave off elimination, there simply wasn’t enough help for James in a Game 6 loss. LeBron famously left the court without the customary series-capping handshake, and a new narrative was born: LeBron, sore loser in the clutch. He’d win another MVP the following year, but lose in the conference semis and take his talents to South Beach that summer, suddenly \"},{\"_key\":\"f19a9058a89e\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781492043547-h1e7irr\"],\"text\":\"one of the most derided players in the league.\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781492043547-h1e7irr\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://www.complex.com/bets/a/rashad-grove/nba-most-hated-villains-all-time\"}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"ec93bf2c171b\",\"_type\":\"block\",\"children\":[{\"_key\":\"0388ab8607a8\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"caa116e4ae86\",\"_type\":\"block\",\"children\":[{\"_key\":\"a1f291f4d1b7\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2008-2009 Cleveland Cavaliers\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"31543f8ab3fe\",\"leadMedia\":{\"_key\":\"d4cf588d092d\",\"_type\":\"cloudinaryImage\",\"altText\":\"Delonte West, LeBron James, and Mo Williams prepare to check into Game 3 of the 2009 Eastern Conference Semifinals. \",\"credit\":\"Photo by Doug Benc/Getty Images\",\"image\":{\"_key\":\"yY4rJZMkfEMIYGZuaCs8y\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":2095,\"width\":3000,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":1500,\"y\":1048},\"height\":2095,\"transformationString\":\"c_crop,h_2095,w_3000,x_0,y_0/g_auto:aoi_1200_839_600_419\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_2095,w_3000,x_0,y_0/g_auto:aoi_1200_839_600_419/sanity-new/GettyImages-88077979_y8yweh\",\"width\":3000},\"folder\":\"sanity-new\",\"height\":2096,\"public_id\":\"sanity-new/GettyImages-88077979_y8yweh\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781492223/sanity-new/GettyImages-88077979_y8yweh.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781492223/sanity-new/GettyImages-88077979_y8yweh.jpg\",\"width\":3000},\"parallax\":false},\"type\":\"slide\"},{\"alias\":null,\"content\":[{\"_key\":\"a44fe752ccef\",\"_type\":\"block\",\"children\":[{\"_key\":\"b2bc31bbbe57\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Regular Season Record: \"},{\"_key\":\"772eddc7d71c\",\"_type\":\"span\",\"marks\":[],\"text\":\"73-9\\n\"},{\"_key\":\"20ea4942cd11\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Playoff Result: \"},{\"_key\":\"85559682b2e5\",\"_type\":\"span\",\"marks\":[],\"text\":\"Lost in NBA Finals (Cleveland, 4-3)\\n\"},{\"_key\":\"317e0ea7e579\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"All-Stars: \"},{\"_key\":\"b4564ff9f022\",\"_type\":\"span\",\"marks\":[],\"text\":\"Stephen Curry, Klay Thompson, Draymond Green\\n\"},{\"_key\":\"aded68ea176f\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Accolades:\"},{\"_key\":\"d04d24dd56ee\",\"_type\":\"span\",\"marks\":[],\"text\":\" MVP (Stephen Curry), All-NBA First Team (Stephen Curry), All-NBA Second Team (Draymond Green), All-NBA Third Team (Klay Thompson), Scoring Champ (Stephen Curry), Coach of the Year (Steve Kerr) \\nThe best team that didn’t win their sport’s championship…ever? The 2007 New England Patriots would like to join the chat for this ignominious title as well, but just like the ‘07 Pats, the ‘15-’16 Warriors were historically great—until the last 2% of their season.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"33d7dac55e1d\",\"_type\":\"block\",\"children\":[{\"_key\":\"fae1d180baa6\",\"_type\":\"span\",\"marks\":[],\"text\":\"How good were the Warriors in the ‘15-’16 regular season? They started 24-0, had a 19-1 stretch in March, and set the single-season wins record with 73. Steph Curry won the MVP, and the team started three Hall of Famers (Curry, Draymond Green, and Klay Thompson) and had a fourth likely HOFer coming off the bench (Andre Igoudala). Harrison Barnes, Shaun Livingston, Leandro Barbosa, and Festus Ezell rounded out the regular rotation that saw 11 players average more than 10 minutes a game in the regular season.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"1a2bb0dd293d\",\"_type\":\"block\",\"children\":[{\"_key\":\"0dc61a5b136e\",\"_type\":\"span\",\"marks\":[],\"text\":\"The Western Conference was tough that year, too: the Spurs won 67 (fun fact: the Spurs actually had a higher net rating than the Dubs that season) and the Kevin Durant-Russell Westbrook Thunder won 55 and stretched the Warriors to seven games in the Western Conference Finals.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"b6d4e51d852a\",\"_type\":\"block\",\"children\":[{\"_key\":\"2e59561b108d\",\"_type\":\"span\",\"marks\":[],\"text\":\"And then? Then the team that would’ve been either No. 1 or 2 on the Greatest NBA Champs of the Past 30 Years list blew a 3-1 lead in the Finals. The series went left for the Warriors at the end of Game 4 when Green took a swing at LeBron James in the closing minutes. After the contest Green was assessed a flagrant foul, his fourth of the postseason, which resulted in his suspension for Game 5.\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"},{\"_key\":\"29fc0bdbc54c\",\"_type\":\"block\",\"children\":[{\"_key\":\"96362249d936\",\"_type\":\"span\",\"marks\":[],\"text\":\"Without Draymond, Golden State dropped Game 5 at home; with Draymond back they lost Game 6 in Cleveland when LeBron authored one of the greatest Finals performances of all-time and Steph was ejected for throwing his mouthpiece into the stands after fouling out. And then a classic Game 7: 20 lead changes, 11 ties, LeBron’s block,\"},{\"_key\":\"e832b5beefa5\",\"_type\":\"span\",\"marks\":[\"adaptiveLink-1781491635272-l4zoz0j\"],\"text\":\" Kyrie’s three,\"},{\"_key\":\"c8f0c1d0df3c\",\"_type\":\"span\",\"marks\":[],\"text\":\" and a historic Cavs victory despite a near triple-double from Green.\"}],\"links\":null,\"markDefs\":[{\"_key\":\"adaptiveLink-1781491635272-l4zoz0j\",\"_type\":\"adaptiveLink\",\"linkValue\":{\"linkType\":\"external\",\"reference\":null,\"url\":\"https://www.complex.com/bets/a/matt-burke/nba-playoff-clutch-shots\"}}],\"products\":null,\"style\":\"normal\"},{\"_key\":\"d03692cfb910\",\"_type\":\"block\",\"children\":[{\"_key\":\"98c5088077de\",\"_type\":\"span\",\"marks\":[],\"text\":\"\\n\"}],\"links\":null,\"markDefs\":[],\"products\":null,\"style\":\"normal\"}],\"header\":[{\"_key\":\"872ed91835c2\",\"_type\":\"block\",\"children\":[{\"_key\":\"df2ebc2c13ef\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"2015-2016 Golden State Warriors\"}],\"markDefs\":[],\"style\":\"normal\"}],\"id\":\"8de67ee2e83d\",\"leadMedia\":{\"_key\":\"dba8613492f6\",\"_type\":\"cloudinaryImage\",\"altText\":\"Stephen Curry looks on as LeBron James shoots a free throw during Game 7 of the 2016 NBA Finals between the Golden State Warriors and Cleveland Cavaliers. \",\"credit\":\"Nhat V. Meyer/Bay Area News Group) (Photo by MediaNews Group/Bay Area News via Getty Images)\",\"image\":{\"_key\":\"5ZLFDNzaWQOqgKIjpiiD1\",\"_type\":\"cloudinaryImageV2\",\"derived\":{\"crop\":{\"height\":3238,\"width\":4620,\"x\":0,\"y\":0},\"focalPoint\":{\"x\":2310,\"y\":1619},\"height\":3238,\"transformationString\":\"c_crop,h_3238,w_4620,x_0,y_0/g_auto:aoi_1848_1295_924_648\",\"url\":\"https://images.complex.com/complex/image/upload/c_crop,h_3238,w_4620,x_0,y_0/g_auto:aoi_1848_1295_924_648/sanity-new/GettyImages-1172425311_zrp8kn\",\"width\":4620},\"folder\":\"sanity-new\",\"height\":3238,\"public_id\":\"sanity-new/GettyImages-1172425311_zrp8kn\",\"resource_type\":\"image\",\"secure_url\":\"https://images.complex.com/complex/image/upload/v1781491950/sanity-new/GettyImages-1172425311_zrp8kn.jpg\",\"url\":\"http://images.complex.com/complex/image/upload/v1781491950/sanity-new/GettyImages-1172425311_zrp8kn.jpg\",\"width\":4620},\"parallax\":false},\"type\":\"slide\"}],\"slideType\":\"countdown\",\"page_width\":\"standard\",\"redirect_url\":null,\"canonicalUrl\":\"https://www.complex.com/bets/a/jack-erwin/best-nba-teams-no-championship\",\"contentCategory\":[\"lists\"],\"contentSubCategory\":null,\"related_posts\":{\"links\":[{\"alias\":\"nba-champions-last-30-years-ranked\",\"authors\":[{\"alias\":\"jack-erwin\",\"bio\":null,\"createdAt\":\"2014-07-19T05:04:10Z\",\"email\":\"jacke@complex.com\",\"facebookLink\":null,\"id\":\"author-11387740\",\"image\":\"https://images.complex.com/complex/image/upload/v1714574588/sanity/ugVqr88l1_large.jpg\",\"instagramLink\":null,\"joinDate\":\"2014-07-19T05:04:10.000Z\",\"link\":null,\"metaDescription\":null,\"name\":\"Jack Erwin\",\"tiktokLink\":null,\"title\":null,\"type\":\"author\",\"xLink\":null}],\"channel\":\"bets\",\"complexosMetadata\":null,\"complexos_generated\":false,\"contentCategory\":[\"lists\"],\"contentSubCategory\":null,\"description\":\"Where do Jalen Brunson's New York Knicks rank amongst the NBA's best championship teams since 1996. \",\"edition\":{\"id\":\"5a9a730c-f0e2-46c1-aff7-93342e373ca9\",\"language\":\"en\",\"name\":\"United States\",\"shortName\":\"US\"},\"headline\":\"The 31 Best NBA Champs of the Last 31 Years, Ranked (Updated) \",\"id\":\"6bca4ff5-d469-40d0-bcd9-be31854a77ab\",\"name\":null,\"publishedAt\":\"2026-06-15T16:58:44.838Z\",\"tags\":[{\"displayName\":\"Los Angeles Lakers\",\"id\":\"tag-los_angeles_lakers\",\"name\":\"los-angeles-lakers\",\"updatedAt\":\"2026-06-08T14:22:44Z\"},{\"displayName\":\"Golden State Warriors\",\"id\":\"tag-golden_state_warriors\",\"name\":\"golden-state-warriors\",\"updatedAt\":\"2026-06-08T14:22:3