            <th>Minimum Qty</th>
            <th>Discount</th>
        </tr>
        </thead>
        <tbody>
        {{#vol_rows}}
        <tr>
            <td>{{{quantity}}} +</td>
            <td>{{{price.title}}}</td>
        </tr>
        {{/vol_rows}}
        </tbody>
    </table>
</div>

</script>
