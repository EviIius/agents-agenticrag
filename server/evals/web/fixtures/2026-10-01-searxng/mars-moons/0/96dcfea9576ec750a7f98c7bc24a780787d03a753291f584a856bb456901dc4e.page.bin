<td id="mwAW4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Deimos_(moon)" title="Deimos (moon)" id="mwAW8">Deimos</a></td>
<td id="mwAXA"><span class="rt-commentedText nowrap" about="#mwt122" typeof="mw:Transclusion" id="mwAXE" data-mw='{"parts":[{"template":{"target":{"wt":"IPAc-en","href":"./Template:IPAc-en"},"params":{"1":{"wt":"ˈ"},"2":{"wt":"d"},"3":{"wt":"aɪ"},"4":{"wt":"m"},"5":{"wt":"ə"},"6":{"wt":"s"}},"i":0}}]}'><span class="IPA nopopups noexcerpt" lang="en-fonipa"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Help:IPA/English" title="Help:IPA/English">/<span style="border-bottom:1px dotted"><span title="/ˈ/: primary stress follows">ˈ</span><span title="'d' in 'dye'">d</span><span title="/aɪ/: 'i' in 'tide'">aɪ</span><span title="'m' in 'my'">m</span><span title="/ə/: 'a' in 'about'">ə</span><span title="'s' in 'sigh'">s</span></span>/</a></span></span><br id="mwAXI"/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Help:Pronunciation_respelling_key" title="Help:Pronunciation respelling key" about="#mwt123" typeof="mw:Transclusion" id="mwAXM" data-mw='{"parts":[{"template":{"target":{"wt":"respell","href":"./Template:Respell"},"params":{"1":{"wt":"DY"},"2":{"wt":"məss"}},"i":0}}]}'><i title="English pronunciation respelling"><span style="font-size:90%">DY</span>-məss</i></a></td>
<td bgcolor="black" id="mwAXQ"><figure class="mw-halign-center" typeof="mw:File" id="mwAXU"><a href="https://en.wikipedia.org/wiki/File:Deimos-viking1.jpg" class="mw-file-description" id="mwAXY"><img resource="https://en.wikipedia.org/wiki/File:Deimos-viking1.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Deimos-viking1.jpg/60px-Deimos-viking1.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Deimos-viking1.jpg/120px-Deimos-viking1.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1015" data-file-height="1033" data-file-type="bitmap" height="51" width="50" class="mw-file-element" id="mwAXc"/></a><figcaption id="mwAXg"></figcaption></figure></td>
<td id="mwAXk"><span about="#mwt124" typeof="mw:Transclusion" id="mwAXo" data-mw='{"parts":[{"template":{"target":{"wt":"convert","href":"./Template:Convert"},"params":{"1":{"wt":"12.6"},"2":{"wt":"km"},"3":{"wt":"mi"},"abbr":{"wt":"on"}},"i":0}}]}'>12.6</span><span typeof="mw:Entity" about="#mwt124"> </span><span about="#mwt124">km (7.8</span><span typeof="mw:Entity" about="#mwt124"> </span><span about="#mwt124">mi)</span><br id="mwAXs"/>(10 × 12 × 16<span typeof="mw:Entity" id="mwAXw"> </span>km)</td>
<td id="mwAX0">483<span typeof="mw:Entity" id="mwAX4"> </span>km<sup id="mwAX8">2</sup></td>
<td id="mwAYA">1.5<span style="margin:0 .15em 0 .25em" about="#mwt125" typeof="mw:Transclusion" id="mwAYE" data-mw='{"parts":[{"template":{"target":{"wt":"e","href":"./Template:E"},"params":{"1":{"wt":"15"}},"i":0}}]}'>×</span><span about="#mwt125">10</span><sup about="#mwt125" id="mwAYI"><span class="nowrap"><span data-sort-value="7001150000000000000♠"></span>15</span></sup></td>
<td id="mwAYM"><span about="#mwt126" typeof="mw:Transclusion" id="mwAYQ" data-mw='{"parts":[{"template":{"target":{"wt":"convert","href":"./Template:Convert"},"params":{"1":{"wt":"23,460"},"2":{"wt":"km"},"3":{"wt":"mi"},"abbr":{"wt":"on"}},"i":0}}]}'>23,460</span><span typeof="mw:Entity" about="#mwt126"> </span><span about="#mwt126">km (14,580</span><span typeof="mw:Entity" about="#mwt126"> </span><span about="#mwt126">mi)</span></td>
<td id="mwAYU">30.31</td>
<td id="mwAYY">131 h (5.44 d)</td>
<td id="mwAYc">0.00033</td>
