<li class="gallerybox" style="width: 155px;" id="mwAnU"><div class="thumb" style="width: 150px; height: 150px;" id="mwAnY"><span typeof="mw:File" id="mwAnc"><a href="https://en.wikipedia.org/wiki/File:Phobosmgs.gif" class="mw-file-description" title="Phobos (1998)" id="mwAng"><img resource="https://en.wikipedia.org/wiki/File:Phobosmgs.gif" src="//thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Phobosmgs.gif/120px-Phobosmgs.gif?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/2/23/Phobosmgs.gif/250px-Phobosmgs.gif?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Phobos (1998)" data-file-width="683" data-file-height="1000" data-file-type="bitmap" height="120" width="82" class="mw-file-element" id="mwAnk"/></a></span></div><div class="gallerytext" id="mwAno">Phobos (1998)<sup about="#mwt227" class="mw-ref reference" id="cite_ref-65" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-65"}}'><a href="#cite_note-65" id="mwAns"><span class="mw-reflink-text" id="mwAnw"><span class="cite-bracket" id="mwAn0">[</span>63<span class="cite-bracket" id="mwAn4">]</span></span></a></sup></div></li>
<li class="gallerybox" style="width: 155px;" id="mwAn8"><div class="thumb" style="width: 150px; height: 150px;" id="mwAoA"><span typeof="mw:File" id="mwAoE"><a href="https://en.wikipedia.org/wiki/File:Phobos_deimos_diff.jpg" class="mw-file-description" title="Comparison between Phobos (top) and Deimos (bottom) (2005)" id="mwAoI"><img resource="https://en.wikipedia.org/wiki/File:Phobos_deimos_diff.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e8/Phobos_deimos_diff.jpg/120px-Phobos_deimos_diff.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/e/e8/Phobos_deimos_diff.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" alt="Comparison between Phobos (top) and Deimos (bottom) (2005)" data-file-width="250" data-file-height="398" data-file-type="bitmap" height="120" width="75" class="mw-file-element" id="mwAoM"/></a></span></div><div class="gallerytext" id="mwAoQ">Comparison between <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Phobos_(moon)" title="Phobos (moon)" id="mwAoU">Phobos</a> (top) and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Deimos_(moon)" title="Deimos (moon)" id="mwAoY">Deimos</a> (bottom) (2005)</div></li>
</ul>
<figure class="mw-halign-center" typeof="mw:File/Thumb" id="mwAoc"><a href="https://en.wikipedia.org/wiki/File:PIA19396-PlanetMars-OrbitsOfMoonsAndOrbiters-20150504.jpg" class="mw-file-description" id="mwAog"><img resource="https://en.wikipedia.org/wiki/File:PIA19396-PlanetMars-OrbitsOfMoonsAndOrbiters-20150504.jpg" src="//upload.wikimedia.org/wikipedia/commons/c/c0/PIA19396-PlanetMars-OrbitsOfMoonsAndOrbiters-20150504.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled" decoding="async" loading="lazy" data-file-width="720" data-file-height="412" data-file-type="bitmap" height="343" width="600" class="mw-file-element" id="mwAok"/></a><figcaption id="mwAoo"><div class="center" about="#mwt229" typeof="mw:Transclusion" id="mwAos" data-mw='{"parts":[{"template":{"target":{"wt":"center","href":"./Template:Center"},"params":{"1":{"wt":"The orbits of moons and spacecraft orbiting Mars.&lt;ref name=\"NASA-20150504-GW\">{{cite web |last=Webster |first=Guy |title=Traffic Around Mars Gets Busy |url=http://www.jpl.nasa.gov/news/news.php?feature=4572 |date=4 May 2015 |work=[[NASA]] |access-date=5 May 2015 |archive-date=6 May 2015 |archive-url=https://web.archive.org/web/20150506163802/http://www.jpl.nasa.gov/news/news.php?feature=4572 |url-status=live }}&lt;/ref>"}},"i":0}}]}'>The orbits of moons and spacecraft orbiting Mars.<sup about="#mwt232" class="mw-ref reference" id="cite_ref-NASA-20150504-GW_66-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"NASA-20150504-GW"},"body":{"id":"mw-reference-text-cite_note-NASA-20150504-GW-66"}}'><a href="#cite_note-NASA-20150504-GW-66" id="mwAow"><span class="mw-reflink-text" id="mwAo0"><span class="cite-bracket" id="mwAo4">[</span>64<span class="cite-bracket" id="mwAo8">]</span></span></a></sup></div></figcaption></figure>

</section><section data-mw-section-id="13" id="mwApA" aria-labelledby="See_also"><div class="mw-heading mw-heading2"><h2 id="See_also">See also</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Moons_of_Mars&amp;action=edit&amp;section=13" title="Edit section: See also"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<ul id="mwApE"><li id="mwApI"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_missions_to_Mars#Missions_to_the_moons_of_Mars" title="List of missions to Mars" about="#mwt235" typeof="mw:Transclusion" id="mwApM" data-mw='{"parts":[{"template":{"target":{"wt":"annotated link","href":"./Template:Annotated_link"},"params":{"1":{"wt":"List of missions to Mars#Missions to the moons of Mars"},"2":{"wt":"List of missions to the moons of Mars"}},"i":0}}]}'>List of missions to the moons of Mars</a></li>
<li id="mwApQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mars_trojan" title="Mars trojan" about="#mwt236" typeof="mw:Transclusion" id="mwApU" data-mw='{"parts":[{"template":{"target":{"wt":"annotated link","href":"./Template:Annotated_link"},"params":{"1":{"wt":"Mars trojan"}},"i":0}}]}'>Mars trojan</a><span typeof="mw:Entity" about="#mwt236"> </span><span about="#mwt236">– Celestial bodies that share the orbit of Mars</span></li>
