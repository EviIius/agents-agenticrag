<li about="#cite_note-PSS-20181116-36" id="cite_note-PSS-20181116-36" data-mw-footnote-number="36"><span class="mw-cite-backlink" id="mwBhk"><a href="#cite_ref-PSS-20181116_36-0" rel="mw:referencedBy" id="mwBho"><span class="mw-linkback-text" id="mwBhs">↑</span></a></span> <span id="mw-reference-text-cite_note-PSS-20181116-36" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt165" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBhw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal ","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Ramsley"},"first1":{"wt":"Kenneth R."},"last2":{"wt":"Head"},"first2":{"wt":"James W."},"title":{"wt":"Origin of Phobos grooves: Testing the Stickney Crater ejecta model"},"journal":{"wt":"[[Planetary and Space Science]]"},"volume":{"wt":"165"},"pages":{"wt":"137–147"},"doi":{"wt":"10.1016/j.pss.2018.11.004"},"bibcode":{"wt":"2019P&amp;SS..165..137R"},"year":{"wt":"2019"},"s2cid":{"wt":"86859432"}},"i":0}}]}'/><cite id="CITEREFRamsleyHead2019" class="citation journal cs1" about="#mwt165">Ramsley, Kenneth R.; Head, James W. (2019). "Origin of Phobos grooves: Testing the Stickney Crater ejecta model". <i id="mwBh0"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Planetary_and_Space_Science" title="Planetary and Space Science" id="mwBh4">Planetary and Space Science</a></i>. <b id="mwBh8">165</b>: <span class="nowrap" id="mwBiA">137–</span>147. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bibcode_(identifier)" title="Bibcode (identifier)" class="mw-redirect" id="mwBiE">Bibcode</a>:<a rel="mw:ExtLink nofollow" href="https://ui.adsabs.harvard.edu/abs/2019P&amp;SS..165..137R" class="external text" id="mwBiI">2019P<span typeof="mw:Entity" id="mwBiM">&amp;</span>SS..165..137R</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwBiQ">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1016%2Fj.pss.2018.11.004" class="external text" id="mwBiU">10.1016/j.pss.2018.11.004</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwBiY">S2CID</a><span typeof="mw:Entity" id="mwBic"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:86859432" class="external text" id="mwBig">86859432</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Planetary+and+Space+Science&amp;rft.atitle=Origin+of+Phobos+grooves%3A+Testing+the+Stickney+Crater+ejecta+model&amp;rft.volume=165&amp;rft.pages=137-147&amp;rft.date=2019&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A86859432%23id-name%3DS2CID&amp;rft_id=info%3Adoi%2F10.1016%2Fj.pss.2018.11.004&amp;rft_id=info%3Abibcode%2F2019P%26SS..165..137R&amp;rft.aulast=Ramsley&amp;rft.aufirst=Kenneth+R.&amp;rft.au=Head%2C+James+W.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt165" id="mwBik"></span></span></li>
<li about="#cite_note-37" id="cite_note-37" data-mw-footnote-number="37"><span class="mw-cite-backlink" id="mwBio"><a href="#cite_ref-37" rel="mw:referencedBy" id="mwBis"><span class="mw-linkback-text" id="mwBiw">↑</span></a></span> <span id="mw-reference-text-cite_note-37" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt168" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBi0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"doi":{"wt":"10.1016/j.pss.2006.05.009"},"last1":{"wt":"Showalter"},"first1":{"wt":"Mark R."},"last2":{"wt":"Hamilton"},"first2":{"wt":"Douglas P."},"last3":{"wt":"Nicholson"},"first3":{"wt":"Philip D."},"title":{"wt":"A Deep Search for Martian Dust Rings and Inner Moons Using the Hubble Space Telescope"},"journal":{"wt":"Planetary and Space Science"},"volume":{"wt":"54"},"date":{"wt":"2006"},"issue":{"wt":"9–10"},"pages":{"wt":"844–854"},"url":{"wt":"http://www.astro.umd.edu/~hamilton/research/reprints/ShoHamNic06.pdf"},"bibcode":{"wt":"2006P&amp;SS...54..844S"}},"i":0}}]}'/><cite id="CITEREFShowalterHamiltonNicholson2006" class="citation journal cs1" about="#mwt168">Showalter, Mark R.; Hamilton, Douglas P.; Nicholson, Philip D. (2006). <a rel="mw:ExtLink nofollow" href="http://www.astro.umd.edu/~hamilton/research/reprints/ShoHamNic06.pdf" class="external text" id="mwBi4">"A Deep Search for Martian Dust Rings and Inner Moons Using the Hubble Space Telescope"</a> <span class="cs1-format" id="mwBi8">(PDF)</span>. <i id="mwBjA">Planetary and Space Science</i>. <b id="mwBjE">54</b> (<span class="nowrap" id="mwBjI">9–</span>10): <span class="nowrap" id="mwBjM">844–</span>854. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bibcode_(identifier)" title="Bibcode (identifier)" class="mw-redirect" id="mwBjQ">Bibcode</a>:<a rel="mw:ExtLink nofollow" href="https://ui.adsabs.harvard.edu/abs/2006P&amp;SS...54..844S" class="external text" id="mwBjU">2006P<span typeof="mw:Entity" id="mwBjY">&amp;</span>SS...54..844S</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwBjc">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1016%2Fj.pss.2006.05.009" class="external text" id="mwBjg">10.1016/j.pss.2006.05.009</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Planetary+and+Space+Science&amp;rft.atitle=A+Deep+Search+for+Martian+Dust+Rings+and+Inner+Moons+Using+the+Hubble+Space+Telescope&amp;rft.volume=54&amp;rft.issue=%3Cspan+class%3D%22nowrap%22%3E9%E2%80%93%3C%2Fspan%3E10&amp;rft.pages=844-854&amp;rft.date=2006&amp;rft_id=info%3Adoi%2F10.1016%2Fj.pss.2006.05.009&amp;rft_id=info%3Abibcode%2F2006P%26SS...54..844S&amp;rft.aulast=Showalter&amp;rft.aufirst=Mark+R.&amp;rft.au=Hamilton%2C+Douglas+P.&amp;rft.au=Nicholson%2C+Philip+D.&amp;rft_id=http%3A%2F%2Fwww.astro.umd.edu%2F~hamilton%2Fresearch%2Freprints%2FShoHamNic06.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt168" id="mwBjk"></span></span></li>
<li about="#cite_note-38" id="cite_note-38" data-mw-footnote-number="38"><span class="mw-cite-backlink" id="mwBjo"><a href="#cite_ref-38" rel="mw:referencedBy" id="mwBjs"><span class="mw-linkback-text" id="mwBjw">↑</span></a></span> <span id="mw-reference-text-cite_note-38" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt171" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBj0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"last":{"wt":"Britt"},"first":{"wt":"Robert Roy"},"title":{"wt":"Forgotten Moons: Phobos and Deimos Eat Mars&apos; Dust"},"url":{"wt":"http://www.space.com/scienceastronomy/forgotten_moons_010313-3.html"},"publisher":{"wt":"space.com"},"date":{"wt":"13 March 2001"},"access-date":{"wt":"12 May 2010"}},"i":0}}]}'/><cite id="CITEREFBritt2001" class="citation web cs1" about="#mwt171">Britt, Robert Roy (13 March 2001). <a rel="mw:ExtLink nofollow" href="http://www.space.com/scienceastronomy/forgotten_moons_010313-3.html" class="external text" id="mwBj4">"Forgotten Moons: Phobos and Deimos Eat Mars' Dust"</a>. space.com<span class="reference-accessdate" id="mwBj8">. Retrieved <span class="nowrap" id="mwBkA">12 May</span> 2010</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Forgotten+Moons%3A+Phobos+and+Deimos+Eat+Mars%27+Dust&amp;rft.pub=space.com&amp;rft.date=2001-03-13&amp;rft.aulast=Britt&amp;rft.aufirst=Robert+Roy&amp;rft_id=http%3A%2F%2Fwww.space.com%2Fscienceastronomy%2Fforgotten_moons_010313-3.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt171" id="mwBkE"></span></span></li>
<li about="#cite_note-39" id="cite_note-39" data-mw-footnote-number="39"><span class="mw-cite-backlink" id="mwBkI"><a href="#cite_ref-39" rel="mw:referencedBy" id="mwBkM"><span class="mw-linkback-text" id="mwBkQ">↑</span></a></span> <span id="mw-reference-text-cite_note-39" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt174" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBkU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"last":{"wt":"Ivanov"},"first":{"wt":"Andrei V."},"bibcode":{"wt":"2004SoSyR..38...97I"},"title":{"wt":"Is the Kaidun Meteorite a Sample from Phobos?"},"date":{"wt":"March 2004"},"journal":{"wt":"Solar System Research"},"volume":{"wt":"38"},"issue":{"wt":"2"},"pages":{"wt":"97–107"},"doi":{"wt":"10.1023/B:SOLS.0000022821.22821.84"},"s2cid":{"wt":"123669722"}},"i":0}}]}'/><cite id="CITEREFIvanov2004" class="citation journal cs1" about="#mwt174">Ivanov, Andrei V. (March 2004). "Is the Kaidun Meteorite a Sample from Phobos?". <i id="mwBkY">Solar System Research</i>. <b id="mwBkc">38</b> (2): <span class="nowrap" id="mwBkg">97–</span>107. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bibcode_(identifier)" title="Bibcode (identifier)" class="mw-redirect" id="mwBkk">Bibcode</a>:<a rel="mw:ExtLink nofollow" href="https://ui.adsabs.harvard.edu/abs/2004SoSyR..38...97I" class="external text" id="mwBko">2004SoSyR..38...97I</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwBks">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1023%2FB%3ASOLS.0000022821.22821.84" class="external text" id="mwBkw">10.1023/B:SOLS.0000022821.22821.84</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwBk0">S2CID</a><span typeof="mw:Entity" id="mwBk4"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:123669722" class="external text" id="mwBk8">123669722</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Solar+System+Research&amp;rft.atitle=Is+the+Kaidun+Meteorite+a+Sample+from+Phobos%3F&amp;rft.volume=38&amp;rft.issue=2&amp;rft.pages=97-107&amp;rft.date=2004-03&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A123669722%23id-name%3DS2CID&amp;rft_id=info%3Adoi%2F10.1023%2FB%3ASOLS.0000022821.22821.84&amp;rft_id=info%3Abibcode%2F2004SoSyR..38...97I&amp;rft.aulast=Ivanov&amp;rft.aufirst=Andrei+V.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt174" id="mwBlA"></span></span></li>
<li about="#cite_note-40" id="cite_note-40" data-mw-footnote-number="40"><span class="mw-cite-backlink" id="mwBlE"><a href="#cite_ref-40" rel="mw:referencedBy" id="mwBlI"><span class="mw-linkback-text" id="mwBlM">↑</span></a></span> <span id="mw-reference-text-cite_note-40" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt177" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBlQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Ivanov"},"first1":{"wt":"Andrei"},"first2":{"wt":"Michael"},"last2":{"wt":"Zolensky"},"title":{"wt":"The Kaidun Meteorite: Where Did It Come From?"},"url":{"wt":"http://www.lpi.usra.edu/meetings/lpsc2003/pdf/1236.pdf"},"journal":{"wt":"Lunar and Planetary Science"},"date":{"wt":"2003"},"volume":{"wt":"34"},"quote":{"wt":"The currently available data on the lithologic composition of the Kaidun meteorite– primarily the composition of the main portion of the meteorite, corresponding to CR2 carbonaceous chondrites and the presence of clasts of deeply differentiated rock&amp;nbsp;– provide weighty support for considering the meteorite&apos;s parent body to be a carbonaceous chondrite satellite of a large differentiated planet. The only possible candidates in the modern Solar System are Phobos and Deimos, the moons of Mars."}},"i":0}}]}'/><cite id="CITEREFIvanovZolensky2003" class="citation journal cs1" about="#mwt177">Ivanov, Andrei; Zolensky, Michael (2003). <a rel="mw:ExtLink nofollow" href="http://www.lpi.usra.edu/meetings/lpsc2003/pdf/1236.pdf" class="external text" id="mwBlU">"The Kaidun Meteorite: Where Did It Come From?"</a> <span class="cs1-format" id="mwBlY">(PDF)</span>. <i id="mwBlc">Lunar and Planetary Science</i>. <b id="mwBlg">34</b>. <q id="mwBlk">The currently available data on the lithologic composition of the Kaidun meteorite– primarily the composition of the main portion of the meteorite, corresponding to CR2 carbonaceous chondrites and the presence of clasts of deeply differentiated rock<span typeof="mw:Entity" id="mwBlo"> </span>– provide weighty support for considering the meteorite's parent body to be a carbonaceous chondrite satellite of a large differentiated planet. The only possible candidates in the modern Solar System are Phobos and Deimos, the moons of Mars.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Lunar+and+Planetary+Science&amp;rft.atitle=The+Kaidun+Meteorite%3A+Where+Did+It+Come+From%3F&amp;rft.volume=34&amp;rft.date=2003&amp;rft.aulast=Ivanov&amp;rft.aufirst=Andrei&amp;rft.au=Zolensky%2C+Michael&amp;rft_id=http%3A%2F%2Fwww.lpi.usra.edu%2Fmeetings%2Flpsc2003%2Fpdf%2F1236.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt177" id="mwBls"></span></span></li>
<li about="#cite_note-41" id="cite_note-41" data-mw-footnote-number="41"><span class="mw-cite-backlink" id="mwBlw"><a href="#cite_ref-41" rel="mw:referencedBy" id="mwBl0"><span class="mw-linkback-text" id="mwBl4">↑</span></a></span> <span id="mw-reference-text-cite_note-41" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt182" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBl8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"date":{"wt":"12 July 2017"},"title":{"wt":"A Convenient Truth - One Universe at a Time"},"url":{"wt":"https://archive.briankoberlein.com/2017/07/12/a-convenient-truth/index.html"},"access-date":{"wt":"14 July 2020"},"website":{"wt":"archive.briankoberlein.com"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt182" id="mwBmA"><a rel="mw:ExtLink nofollow" href="https://archive.briankoberlein.com/2017/07/12/a-convenient-truth/index.html" class="external text" id="mwBmE">"A Convenient Truth - One Universe at a Time"</a>. <i id="mwBmI">archive.briankoberlein.com</i>. 12 July 2017<span class="reference-accessdate" id="mwBmM">. Retrieved <span class="nowrap" id="mwBmQ">14 July</span> 2020</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=archive.briankoberlein.com&amp;rft.atitle=A+Convenient+Truth+-+One+Universe+at+a+Time&amp;rft.date=2017-07-12&amp;rft_id=https%3A%2F%2Farchive.briankoberlein.com%2F2017%2F07%2F12%2Fa-convenient-truth%2Findex.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt182" id="mwBmU"></span></span></li>
<li about="#cite_note-Shklovsky-42" id="cite_note-Shklovsky-42" data-mw-footnote-number="42"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwBmY"><a href="#cite_ref-Shklovsky_42-0" id="mwBmc"><span class="mw-linkback-text" id="mwBmg">1</span></a> <a href="#cite_ref-Shklovsky_42-1" id="mwBmk"><span class="mw-linkback-text" id="mwBmo">2</span></a></span> <span id="mw-reference-text-cite_note-Shklovsky-42" class="mw-reference-text reference-text">Shklovsky, Iosif Samuilovich; <i id="mwBms">The Universe, Life, and Mind</i>, Academy of Sciences USSR, Moscow, 1962</span></li>
