e=Phobos&amp;rft.date=2004-01-12&amp;rft_id=http%3A%2F%2Fwww.bbc.co.uk%2Fscience%2Fspace%2Fsolarsystem%2Fmars%2Fphobos.shtml&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt144" id="mwBeg"></span></span></li>
<li about="#cite_note-32" id="cite_note-32" data-mw-footnote-number="32"><span class="mw-cite-backlink" id="mwBek"><a href="#cite_ref-32" rel="mw:referencedBy" id="mwBeo"><span class="mw-linkback-text" id="mwBes">↑</span></a></span> <span id="mw-reference-text-cite_note-32" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt147" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBew" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite magazine ","href":"./Template:Cite_magazine"},"params":{"url":{"wt":"https://books.google.com/books?id=Q6tkzO06q4oC&amp;pg=PA158"},"title":{"wt":"Viking looks at Phobos in detail"},"magazine":{"wt":"[[New Scientist]]"},"volume":{"wt":"72"},"issue":{"wt":"1023"},"page":{"wt":"158"},"publisher":{"wt":"[[Reed Business Information]]"},"date":{"wt":"21 October 1976"},"access-date":{"wt":"19 July 2021"},"id":{"wt":"{{ISSN|0262-4079}}"},"via":{"wt":"[[Google Books]]"}},"i":0}}]}'/><cite class="citation magazine cs1" about="#mwt147" id="mwBe0"><a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=Q6tkzO06q4oC&amp;pg=PA158" class="external text" id="mwBe4">"Viking looks at Phobos in detail"</a>. <i id="mwBe8"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/New_Scientist" title="New Scientist" id="mwBfA">New Scientist</a></i>. Vol.<span typeof="mw:Entity" id="mwBfE"> </span>72, no.<span typeof="mw:Entity" id="mwBfI"> </span>1023. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Reed_Business_Information" title="Reed Business Information" class="mw-redirect" id="mwBfM">Reed Business Information</a>. 21 October 1976. p.<span typeof="mw:Entity" id="mwBfQ"> </span>158. <link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt149" typeof="mw:Extension/templatestyles" id="mwBfU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwBfY">ISSN</a><span typeof="mw:Entity" id="mwBfc"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/0262-4079" class="external text" id="mwBfg">0262-4079</a><span class="reference-accessdate" id="mwBfk">. Retrieved <span class="nowrap" id="mwBfo">19 July</span> 2021</span> <span typeof="mw:Entity" id="mwBfs">–</span> via <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Google_Books" title="Google Books" id="mwBfw">Google Books</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=New+Scientist&amp;rft.atitle=Viking+looks+at+Phobos+in+detail&amp;rft.volume=72&amp;rft.issue=1023&amp;rft.pages=158&amp;rft.date=1976-10-21&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3DQ6tkzO06q4oC%26pg%3DPA158&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt147" id="mwBf0"></span></span></li>
<li about="#cite_note-33" id="cite_note-33" data-mw-footnote-number="33"><span class="mw-cite-backlink" id="mwBf4"><a href="#cite_ref-33" rel="mw:referencedBy" id="mwBf8"><span class="mw-linkback-text" id="mwBgA">↑</span></a></span> <span id="mw-reference-text-cite_note-33" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt151" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBgE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"Stickney Crater-Phobos"},"url":{"wt":"http://www.solarviews.com/cap/mars/phobos2.htm"},"quote":{"wt":"One of the most striking features of Phobos, aside from its irregular shape, is its giant crater Stickney. Because Phobos is only {{Convert|28|by|20|km|}}, it must have been nearly shattered from the force of the impact that caused the giant crater. Grooves that extend across the surface from Stickney appear to be surface fractures caused by the impact."}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt151" id="mwBgI"><a rel="mw:ExtLink nofollow" href="http://www.solarviews.com/cap/mars/phobos2.htm" class="external text" id="mwBgM">"Stickney Crater-Phobos"</a>. <q id="mwBgQ">One of the most striking features of Phobos, aside from its irregular shape, is its giant crater Stickney. Because Phobos is only 28 by 20 kilometres (17 by 12<span typeof="mw:Entity" id="mwBgU"> </span>mi), it must have been nearly shattered from the force of the impact that caused the giant crater. Grooves that extend across the surface from Stickney appear to be surface fractures caused by the impact.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Stickney+Crater-Phobos&amp;rft_id=http%3A%2F%2Fwww.solarviews.com%2Fcap%2Fmars%2Fphobos2.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt151" id="mwBgY"></span></span></li>
<li about="#cite_note-grooves_origin-34" id="cite_note-grooves_origin-34" data-mw-footnote-number="34"><span class="mw-cite-backlink" id="mwBgc"><a href="#cite_ref-grooves_origin_34-0" rel="mw:referencedBy" id="mwBgg"><span class="mw-linkback-text" id="mwBgk">↑</span></a></span> <span id="mw-reference-text-cite_note-grooves_origin-34" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt159" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBgo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"New Evidence on the Origin of Phobos&apos; Parallel Grooves from HRSC Mars Express"},"last1":{"wt":"Murray"},"first1":{"wt":"John B."},"display-authors":{"wt":"4"},"first2":{"wt":"John B."},"last2":{"wt":"Murray"},"first3":{"wt":"Jonathan C."},"last3":{"wt":"Iliffe"},"first4":{"wt":"Jan-Peter A. L."},"last4":{"wt":"Muller"},"first5":{"wt":"Gerhard"},"last5":{"wt":"Neukum"},"first6":{"wt":"Stephanie"},"last6":{"wt":"Werner"},"first7":{"wt":"Matt"},"last7":{"wt":"Balme"},"last8":{"wt":"HRSC Co-Investigator Team"},"publisher":{"wt":"37th Annual Lunar and Planetary Science Conference, March 2006"},"url":{"wt":"http://www.lpi.usra.edu/meetings/lpsc2006/pdf/2195.pdf"}},"i":0}}]}'/><cite id="CITEREFMurrayMurrayIliffeMuller" class="citation web cs1" about="#mwt159">Murray, John B.; Murray, John B.; Iliffe, Jonathan C.; Muller, Jan-Peter A. L.; et<span typeof="mw:Entity" id="mwBgs"> </span>al. <a rel="mw:ExtLink nofollow" href="http://www.lpi.usra.edu/meetings/lpsc2006/pdf/2195.pdf" class="external text" id="mwBgw">"New Evidence on the Origin of Phobos' Parallel Grooves from HRSC Mars Express"</a> <span class="cs1-format" id="mwBg0">(PDF)</span>. 37th Annual Lunar and Planetary Science Conference, March 2006.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=New+Evidence+on+the+Origin+of+Phobos%27+Parallel+Grooves+from+HRSC+Mars+Express&amp;rft.pub=37th+Annual+Lunar+and+Planetary+Science+Conference%2C+March+2006&amp;rft.aulast=Murray&amp;rft.aufirst=John+B.&amp;rft.au=Murray%2C+John+B.&amp;rft.au=Iliffe%2C+Jonathan+C.&amp;rft.au=Muller%2C+Jan-Peter+A.+L.&amp;rft.au=Neukum%2C+Gerhard&amp;rft.au=Werner%2C+Stephanie&amp;rft.au=Balme%2C+Matt&amp;rft.au=HRSC+Co-Investigator+Team&amp;rft_id=http%3A%2F%2Fwww.lpi.usra.edu%2Fmeetings%2Flpsc2006%2Fpdf%2F2195.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APhobos+%28moon%29" class="Z3988" about="#mwt159" id="mwBg4"></span></span></li>
<li about="#cite_note-UT-20181120-35" id="cite_note-UT-20181120-35" data-mw-footnote-number="35"><span class="mw-cite-backlink" id="mwBg8"><a href="#cite_ref-UT-20181120_35-0" rel="mw:referencedBy" id="mwBhA"><span class="mw-linkback-text" id="mwBhE">↑</span></a></span> <span id="mw-reference-text-cite_note-UT-20181120-35" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt162" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBhI" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"last":{"wt":"Gough"},"first":{"wt":"Evan"},"title":{"wt":"Strange Grooves on Phobos Were Caused by Boulders Rolling Around on its Surface"},"url":{"wt":"https://www.universetoday.com/140593/strange-grooves-on-phobos-were-caused-by-boulders-rolling-around-on-its-surface/"},"date":{"wt":"20 November 2018"},"work":{"wt":"[[Universe Today]]"},"access-date":{"wt":"21 November 2018"}},"i":0}}]}'/><cite id="CITEREFGough2018" class="citation web cs1" about="#mwt162">Gough, Evan (20 November 2018). <a rel="mw:ExtLink nofollow" href="https://www.universetoday.com/140593/strange-grooves-on-phobos-were-caused-by-boulders-rolling-around-on-its-surface/" class="external text" id="mwBhM">"Strange Grooves on Phobos Were Caused by Boulders Rolling Around on its Surface"</a>. <i id="mwBhQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Universe_Today" title="Universe Today" id="mwBhU">Universe Today</a></i><span class="reference-accessdate" id="mwBhY">. Retrieved <span class="nowrap" id="mwBhc">21 November</span> 2018</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Universe+Today&amp;rft.atitle=Strange+Grooves+on+Phobos+Were+Caused+by+Boulders+Rolling+Around+on+its+Surface&am