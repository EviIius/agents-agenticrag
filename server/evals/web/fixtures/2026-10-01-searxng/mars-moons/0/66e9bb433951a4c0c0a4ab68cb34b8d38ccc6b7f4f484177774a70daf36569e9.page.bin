					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.24.0.0-alpha24" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Larger of the two moons of Mars"}},"i":0}}]}'>Larger of the two moons of Mars</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"redirect","href":"./Template:Redirect"},"params":{"1":{"wt":"Mars I"},"2":{"wt":"the Soviet Mars probe"},"3":{"wt":"Mars 1"},"4":{"wt":"other uses"},"5":{"wt":"Mars 1 (disambiguation)"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">"Mars I" redirects here. For the Soviet Mars probe, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mars_1" title="Mars 1">Mars 1</a>. For other uses, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mars_1_(disambiguation)" title="Mars 1 (disambiguation)" class="mw-disambig">Mars 1 (disambiguation)</a>.</div>
