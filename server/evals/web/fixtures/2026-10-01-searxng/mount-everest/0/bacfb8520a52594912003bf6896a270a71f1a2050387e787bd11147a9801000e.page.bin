"trip.image_url" alt="" class="object-cover w-16 h-16 rounded-lg"> <div class="grow"> <div class="text-lg" x-text="trip.name"></div> <div class="flex justify-between gap-2"> <span class="text-sm text-gray-600" x-text="`${trip.duration} days`"></span> <span class="text-sm text-gray-600" x-show="trip.offer_price" x-text="`US $ ${trip.offer_price}`"></span> </div> </div> </div> </a> </li> </template> </ul> </div> </div> </div> </div> </div> </div> </div> </div> </header> <div class="relative bg-white border-b border-gray-500/20 top-0 z-100 sticky"> <div class="container flex justify-end lg:justify-between"> <nav :class="{ show: mobilenavOpen }"> <ul id="main-nav" class="absolute left-0 right-0 sm sm-simple lg:static top-[calc(100%+1px)]"> <li> <a href="https://www.majestictrailsnepal.com/destinations/nepal" class="text-sm font-semibold text-gray-800 uppercase">Nepal</a> <ul> <li> <a href="https://www.majestictrailsnepal.com/activities/classic-treks">Classic Treks</a> </li> <li> <a href="https://www.majestictrailsnepal.com/activities/cultural-tours">Cultural Tours</a> </li> <li> <a href="https://www.majestictrailsnepal.com/activities/family-friendly-treks">Family-Friendly Treks</a> </li> <li> <a href="https://www.majestictrailsnepal.com/activities/trekking-in-nepal">Trekking in Nepal</a> </li> <li> <a href="https://www.majestictrailsnepal.com/activities/beginners-trek-in-nepal">Beginners Trek in Nepal</a> </li> <li> <a href="https://www.majestictrailsnepal.com/activities/helicopter-tours-in-nepal">Helicopter Tours in Nepal</a> </li> <li> <a href="https://www.majestictrailsnepal.com/activities/adventure-in-nepal">Adventure In Nepal</a> </li> </ul> </li> <li> <a href="https://www.majestictrailsnepal.com/activities/trekking-in-nepal" class="text-sm font-semibold text-gray-800 uppercase">Trekking in Nepal</a> <ul class="mega-menu"> <div class="left-0 right-0 bg-white rounded-lg shadow-xs lg:absolute lg:py-10 z-100" id="mega1"> <div class="container gap-4 lg:grid lg:grid-col