ual.\",\"severity\":\"warning\",\"affected_tour_slugs\":[\"langtang-valley-trek-7-days\",\"langtang-gosaikunda-trek-13-days\",\"gosaikunda-lake-trek-9-days\",\"tamang-heritage-trek-7-days\"],\"affected_regions\":[\"Langtang\",\"Rasuwa\"],\"bookings_paused\":true,\"notice_title\":\"We are not taking bookings for this trek right now\",\"notice_body\":\"This route starts at Syabrubesi or Dhunche, reached by the Rasuwa road that was destroyed on 26 August. Until access is restored we will not sell a trek we cannot promise to run. Tell us your dates and we will hold them, or suggest an Annapurna or Everest route for the same window — both are unaffected.\",\"cta_label\":\"See what is open right now\",\"cta_url\":\"/nepal-trekking-conditions-now\",\"starts_at\":\"2026-08-28T00:47:23.925491+00:00\"}";var s=i&&JSON.parse(i);if(s&&s.slug&&localStorage.getItem('thn_incident_dismissed:'+s.slug)==='1'){document.documentElement.setAttribute('data-incident-dismissed','')}}catch(e){}</script><script src="/_next/static/chunks/03~yq9q893hmn.js" noModule=""></script></head><body class="min-h-dvh flex flex-col" style="background:var(--bg-page);color:var(--text-primary);font-family:var(--font-sans)"><div hidden=""><!--$--><!--/$--></div><a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:rounded" style="background:var(--cta);color:var(--text-on-cta)">Skip to main content</a><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-3Q2ZS1HESE');</script><div id="thn-incident" role="status" aria-live="polite" style="position:fixed;top:0;left:0;right:0;z-index:var(--z-float);background:var(--surface-dark-deep);border-bottom:1px solid var(--cta-tint-30);padding-top:env(safe-area-inset-top, 0px);opacity:1;transform:none"><div class="mx-auto flex items-center gap-2.5 sm:gap-3" style="max-width:80rem;padding:0.