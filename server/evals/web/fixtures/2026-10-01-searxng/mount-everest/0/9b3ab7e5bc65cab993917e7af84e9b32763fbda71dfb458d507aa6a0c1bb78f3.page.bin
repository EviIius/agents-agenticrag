l\":true,\"sizes\":\"230px\",\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/jpeg;base64,\",\"style\":{\"objectFit\":\"cover\"}}]}],[\"$\",\"div\",null,{\"className\":\"pad\",\"children\":[[\"$\",\"b\",null,{\"children\":\"Ghorepani Poon Hill Trek — 2 Days\"}],[\"$\",\"span\",null,{\"children\":[\"$$\",265,\" pp\"]}]]}]]}]\n79:[\"$\",\"aside\",\"m3\",{\"className\":\"nv-incta\",\"children\":[\"$\",\"$L12\",null,{\"href\":\"https://travelhimalayanepal.com/tours/everest-base-camp-helicopter-tour\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ic-img\",\"style\":{\"position\":\"relative\",\"display\":\"block\"},\"children\":[\"$\",\"$L27\",null,{\"src\":\"https://pub-2153aa6d32ca4a5da7850eaa8e290576.r2.dev/tours/everest-base-camp-helicopter-tour/featured.webp\",\"alt\":\"\",\"width\":66,\"height\":66,\"placeholder\":\"blur\",\"blurDataURL\":\"data:image/jpeg;base64,\",\"style\":{\"objectFit\":\"cover\"}}]}],[\"$\",\"span\",null,{\"className\":\"ic-txt\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ic-lbl\",\"children\":\"Unaffected — running normally\"}],[\"$\",\"b\",null,{\"children\":\"Everest Base Camp Helicopter Tour — 1 Day\"}],[\"$\",\"span\",null,{\"className\":\"ic-price\",\"children\":[\"$$\",1680,\" pp · guided departures\"]}]]}],[\"$\",\"span\",null,{\"className\":\"ic-go\",\"children\":\"Plan this trek →\"}]]}]}]\n7b:T1365,\n\u003cfigure class=\"nv-figure\"\u003e\u003cimg src=\"https://travelhimalayanepal.com/cdn-cgi/image/width=1080,quality=68,format=auto,onerror=redirect/https://media.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s2.webp\" srcset=\"https://travelhimalayanepal.com/cdn-cgi/image/width=640,quality=74,format=auto,onerror=redirect/https://m"])</script><script>self.__next_f.push([1,"edia.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s2.webp 640w, https://travelhimalayanepal.com/cdn-cgi/image/width=1080,quality=68,format=auto,onerror=redirect/https://media.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s2.webp 1080w, https://travelhimalayanepal.com/cdn-cgi/image/width=1600,quality=68,format=auto,onerror=redirect/https://media.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s2.webp 1600w\" sizes=\"(max-width: 780px) 100vw, 760px\" data-full=\"https://pub-2153aa6d32ca4a5da7850eaa8e290576.r2.dev/news/everest-official-height-1955-to-2020-2026-s2.webp\" alt=\"A satellite positioning device in the snow\" loading=\"lazy\"\u003e\u003cfigcaption\u003eThe 2020 number came off the summit itself.\u003c/figcaption\u003e\u003c/figure\u003e\n\u003cdiv class='nv-tablewrap'\u003e\u003ctable class='nv-table'\u003e\u003ccaption\u003eThree official heights for the same summit\u003c/caption\u003e\u003cthead\u003e\u003ctr\u003e\u003cth\u003eSurvey\u003c/th\u003e\u003cth class='num'\u003eHeight\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003eSurvey of India, 1955 (global standard for 65 years)\u003c/td\u003e\u003ctd class='num'\u003e8,848m\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eChina, 2005 (rock height, ice cap excluded)\u003c/td\u003e\u003ctd class='num'\u003e8,844.43m\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003eNepal \u0026amp; China joint survey, announced 8 Dec 2020\u003c/td\u003e\u003ctd class='num'\u003e8,848.86m\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\u003ch2\u003eIs Everest still growing?\u003c/h2\u003e\n\u003cp\u003eThe 2019\u0026ndash;2020 expedition data was also used to settle a separate worry. After the 2015 Gorkha earthquake, some geologists suspected Everest might have lost height as the crust shifted. The new survey found no evidence of that \u0026mdash; if anything, the mountain has kept rising. Geologists put the long-term growth rate at roughly 4 millimetres a year, driven by the Indian tectonic plate, which continues pushing north into the Eurasian plate at about 5 centimetres annually, the same force that built the entire Himalayan range over the last 50 million years.\u003c/p\u003e\n\u003cfigure class=\"nv-figure\"\u003e\u003cimg src=\"https://travelhimalayanepal.com/cdn-cgi/image/width=1080,quality=68,format=auto,onerror=redirect/https://media.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s3.webp\" srcset=\"https://travelhimalayanepal.com/cdn-cgi/image/width=640,quality=74,format=auto,onerror=redirect/https://media.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s3.webp 640w, https://travelhimalayanepal.com/cdn-cgi/image/width=1080,quality=68,format=auto,onerror=redirect/https://media.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s3.webp 1080w, https://travelhimalayanepal.com/cdn-cgi/image/width=1600,quality=68,format=auto,onerror=redirect/https://media.travelhimalayanepal.com/news/everest-official-height-1955-to-2020-2026-s3.webp 1600w\" sizes=\"(max-width: 780px) 100vw, 760px\" data-full=\"https://pub-2153aa6d32ca4a5da7850eaa8e290576.r2.dev/news/everest-official-height-1955-to-2020-2026-s3.webp\" alt=\"The summit pyramid of a Himalayan peak\" loading=\"lazy\"\u003e\u003cfigcaption\u003eRising, and worn down, at the same time.\u003c/figcaption\u003e\u003c/figure\u003e\n\u003ch2\u003eWhat this means for trekkers\u003c/h2\u003e\u003cdiv class='nv-callout'\u003e\u003cp class='clab'\u003eWhat this means for you\u003c/p\u003e\u003cp\u003eNothing about the trek itself changes \u0026mdash; permits, routes and difficulty ratings are exactly as they were before 2020. What the joint survey actually confirms is that the mountain you're looking at from the trail is still growing, millimetre by millimetre, on the same tectonic engine that first pushed it above the Tethys seabed. It also means the 8,848m figure printed in older guidebooks and textbooks is simply out of date.\u003c/p\u003e\u003c/div\u003e\u003cp\u003eYou don't need to summit to see why the number matters. Most trekkers get their first real look at Everest from \u003ca href=\"/gokyo-ri-vs-kala-patthar-everest-viewpoint-2026\"\u003eKala Patthar\u003c/a\u003e or along the \u003ca href='/tours/everest-base-camp-trek-15-days'\u003eEverest Base Camp trek\u003c/a\u003e itself, and for travellers short on time or altitude tolerance, an \u003ca href='/tours/everest-base-camp-helicopter-tour'\u003eEverest Base Camp helicopter tour\u003c/a\u003e covers the same view in a single day. Either way, the mountain in front of you is 86 centimetres taller than"])</script><script>self.__next_f.push([1," the 8,848 m printed on most maps before December 2020.\u003c/p\u003e\u003cp\u003e\u003cem\u003eSources: The Kathmandu Post, \u0026ldquo;It\u0026rsquo;s official: Mt Everest is 8,848.86 metres tall,\u0026rdquo; 8 December 2020; CNN, \u0026ldquo;Mount Everest: China and Nepal agree on height after years of dispute.\u0026rdquo;\u003c/em\u003e\u003c/p\u003e\n\u003cp class=\"img-credit\"\u003e\u003cem\u003eCover photo: Megaurab09 via Wikimedia Commons (CC BY-SA 4.0). Section photos: Mukhtar Shuaib Mukhtar via Pexels (Pexels licence); Kyle Loftus via Pexels (Pexels licence); Tobi \u0026Chris via Pexels (Pexels licence).\u003c/em\u003e\u003c/p\u003e7a:[\"$\",\"div\",\"h4\",{\"className\":\"rich-part\",\"dangerouslySetInnerHTML\":{\"__html\":\"$7b\"}}]\n"])</script><script>(function(){function c(){var b=a.contentDocument||(a.contentWindow&&a.contentWindow.document);if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'a43eebefd8bf2080',t:'MTc5MDg5MzkyOA=='};var a=document.createElement('script');a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"91d5adb7d14b4f2592acd4b08a1f5611","r":1,"spa":2}' crossorigin="anonymous"></script>
</body></html>