e.\n\nThis video features LeBron James' best highlights from the 2020 NBA Playoffs and Finals, including his biggest dunks, clutch shots, incredible assists, and the plays that earned him his fourth NBA Championship and fourth NBA Finals MVP award.\n\n🔥 Relive one of the greatest playoff runs in NBA history.\n\n👉 Like the video, comment your favorite LeBron moment, and subscribe to NBArtv for more NBA highlights.","styleRuns":[{"startIndex":0,"length":731,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":731,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964208,"raisedBackground":4294964208,"additiveBackground":566845765,"textPrimary":4281733897,"textSecondary":4285743926,"invertedBackground":4287640345,"overlayBackground":3426095881},"darkThemeColorPalette":{"baseBackground":4280027138,"raisedBackground":4281733897,"additiveBackground":734617925,"textPrimary":4294698720,"textSecondary":4292851113,"invertedBackground":4293104253,"overlayBackground":3426095881},"colorSampledDescriptionBodyText":{"content":"LeBron James led the Los Angeles Lakers to the 2020 NBA Championship with one of the most dominant playoff runs of his legendary career. Throughout the 2020 NBA Playoffs and Finals, LeBron showcased elite scoring, playmaking, leadership, and basketball IQ while leading the Lakers to their first championship in a decade.\n\nThis video features LeBron James' best highlights from the 2020 NBA Playoffs and Finals, including his biggest dunks, clutch shots, incredible assists, and the plays that earned him his fourth NBA Championship and fourth NBA Finals MVP award.\n\n🔥 Relive one of the greatest playoff runs in NBA history.\n\n👉 Like the video, comment your favorite LeBron moment, and subscribe to NBArtv for more NBA highlights.","styleRuns":[{"startIndex":0,"length":731,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294698720},{"key":"USER_INTERFACE_THEME_LIGHT","value":4281733897}]}},"fontFamilyName":"Roboto"}]},"enableColorSampledDescriptionBodyText":true}},{"expandableMetadataRenderer":{"header":{"collapsedTitle":{"simpleText":"NBArtv showcases the versatility of LeBron James throughout the 2020 postseason run. Experience elite playmaking, transition scoring, and defensive intensity as the star navigates high-stakes matchups against the Trail Blazers, Rockets, Nuggets, and Heat."},"collapsedLabel":{"simpleText":"Summary"},"expandedTitle":{"simpleText":"AI-generated video summary"},"expandedSubtitle":{"simpleText":"AI can make mistakes, so double-check it."},"collapsedLabelIcon":{"iconType":"SPARK"},"expandedTitleIcon":{"iconType":"SPARK"},"expandedSubtitleTapCommand":{"clickTrackingParams":"CCEQgcsLGAMiEwitzMap75mXAxXPCdsBHadbEMfKAQTKoDST","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/youtube/answer/14089423","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/youtube/answer/14089423","target":"TARGET_NEW_WINDOW"}},"expandedSubtitleTrailingIcon":{"iconType":"INFO"}},"expandedContent":{"videoSummaryContentViewModel":{"paragraphs":[{"videoSummaryParagraphViewModel":{"text":{"content":"NBArtv showcases the versatility of LeBron James throughout the 2020 postseason run. Experience elite playmaking, transition scoring, and defensive intensity as the star navigates high-stakes matchups against the Trail Blazers, Rockets, Nuggets, and Heat."}}}]}},"expandButton":{"buttonRenderer":{"style":"STYLE_DEFAULT","size":"SIZE_DEFAULT","isDisabled":false,"icon":{"iconType":"EXPAND_MORE"},"trackingParams":"CCQQ8FsiEwitzMap75mXAxXPCdsBHadbEMc=","accessibilityData":{"accessibilityData":{"la