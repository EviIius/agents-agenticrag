",\"pct\":\"story\",\"videoPosition\":\"\",\"spaceId\":\"\"},\"contentVideoInfo\":{\"hasYahooVideo\":false},\"seoMeta\":{\"canonicalUrl\":\"https://clutchpoints.com/nba/los-angeles-lakers/lakers-news-lebron-james-2020-championship-parade\",\"clickThroughUrl\":\"https://sports.yahoo.com/articles/lakers-news-lebron-james-still-171344815.html\",\"title\":\"Lakers news: LeBron James still wishes LA had 2020 championship parade\",\"seamlessUrl\":\"https://sports.yahoo.com/articles/lakers-news-lebron-james-still-171344815.html\"},\"contentIdentifiers\":{\"headerSectionName\":\"nba\",\"isOriginalContent\":false,\"readMoreList\":\"\",\"isNetworkSportsContent\":false,\"hostedType\":\"hosted\",\"presentation\":\"\"},\"contentType\":\"story\",\"categoryLabel\":\"Sports\",\"contentSummaries\":{\"summary\":\"In the 23 NBA seasons that he has played so far, LeBron James has won four championships. While he is now with the Philadelphia 76ers after signing a two-year, $8 million contract , there is one part of his 2020 title run with the Los Angeles Lakers that he still wishes he could have experienced. The Lakers never got to celebrate their championship […] The post Lakers news: LeBron James still wishes LA had 2020 championship parade appeared first on ClutchPoints.\"},\"adMeta\":{\"hashtag\":\"nba;basketball;sports;opinion_and_editorial;historical_moments;culture;milestones;transaction;team_profiles;player_profiles\",\"rs\":\"lmsid:a0Va6000001mTITEA2;revsp:clutchpoints_articles_939;lpstaid:53772c9b-9c8d-3421-85d9-0ed81fc3f597;pct:story\",\"site_attribute\":\"\"},\"contentTags\":{\"normalizedTags\":\"$88:props:children:0:props:children:props:initialArticle:data:contentMeta:contentTags:normalizedTags\"},\"attribution\":{\"authors\":\"$88:props:children:0:props:children:props:initialArticle:data:contentMeta:attribution:authors\",\"provider\":{\"name\":\"ClutchPoints\"}},\"commentsAllowed\":true}}}}]\n8d:[[\"$\",\"$L40\",null,{\"moduleIds\":[\"app/article/[...slug]/page.tsx -\u003e