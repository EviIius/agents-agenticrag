<tbody><tr><td style="border-style:none"><div style="text-align:center">September 30<br/><small> 9:00<span typeof="mw:Entity"> </span>pm</small></div></td></tr>
</tbody></table>
<table style="background-color:#eee; color:#202122; float:left; width:7%; table-layout:fixed">
<tbody><tr><td style="border-style:none"><div style="font-size:85%"><a rel="mw:ExtLink nofollow" href="https://www.nba.com/game/mia-vs-lal-0041900401" class="external text">Recap</a></div></td></tr>
