<tr id="mwAQ4">
<td align="right" id="mwAQ8">
<table class="wikitable" style="width:400px;font-size:95%;text-align:center" about="#mwt93" typeof="mw:Transclusion" id="mwARA" data-mw='{"parts":[{"template":{"target":{"wt":"2019–20 NBA East standings","href":"./Template:2019–20_NBA_East_standings"},"params":{"team":{"wt":"MIA"}},"i":0}}]}'><tbody><tr><th colspan="7"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eastern_Conference_(NBA)" title="Eastern Conference (NBA)">Eastern Conference</a></th></tr><tr><th style="width:5%">#</th><th>Team</th><th style="width:5%"><abbr title="Games won">W</abbr></th><th style="width:5%"><abbr title="Games lost">L</abbr></th><th style="width:5%"><abbr title="Winning percentage">PCT</abbr></th><th style="width:7.5%"><abbr title="Games behind">GB</abbr></th><th style="width:7.5%"><abbr title="Games played">GP</abbr></th></tr><tr><th>1</th><td style="text-align:left"><b>z</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Milwaukee_Bucks_season" title="2019–20 Milwaukee Bucks season">Milwaukee Bucks</a><span typeof="mw:Entity"> </span><span typeof="mw:Entity">*</span></td><td>56</td><td>17</td><td>.767</td><td>–</td><td>73</td></tr><tr><th>2</th><td style="text-align:left"><b>y</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Toronto_Raptors_season" title="2019–20 Toronto Raptors season">Toronto Raptors</a><span typeof="mw:Entity"> </span><span typeof="mw:Entity">*</span></td><td>53</td><td>19</td><td>.736</td><td>2.5</td><td>72</td></tr><tr><th>3</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Boston_Celtics_season" title="2019–20 Boston Celtics season">Boston Celtics</a></td><td>48</td><td>24</td><td>.667</td><td>7.5</td><td>72</td></tr><tr><th>4</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Indiana_Pacers_season" title="2019–20 Indiana Pacers season">Indiana Pacers</a></td><td>45</td><td>28</td><td>.616</td><td>11.0</td><td>73</td></tr><tr style="background-color:#CCFFCC"><th>5</th><td style="text-align:left"><b>y</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Miami_Heat_season" title="2019–20 Miami Heat season">Miami Heat</a><span typeof="mw:Entity"> </span><span typeof="mw:Entity">*</span></td><td>44</td><td>29</td><td>.603</td><td>12.0</td><td>73</td></tr><tr><th>6</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Philadelphia_76ers_season" title="2019–20 Philadelphia 76ers season">Philadelphia 76ers</a></td><td>43</td><td>30</td><td>.589</td><td>13.0</td><td>73</td></tr><tr><th>7</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Brooklyn_Nets_season" title="2019–20 Brooklyn Nets season">Brooklyn Nets</a></td><td>35</td><td>37</td><td>.486</td><td>20.5</td><td>72</td></tr><tr><th>8</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Orlando_Magic_season" title="2019–20 Orlando Magic season">Orlando Magic</a></td><td>33</td><td>40</td><td>.452</td><td>23.0</td><td>73</td></tr><tr style="background-color:#CCCCCC"><td colspan="7"></td></tr><tr><th>9</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Washington_Wizards_season" title="2019–20 Washington Wizards season">Washington Wizards</a></td><td>25</td><td>47</td><td>.347</td><td>30.5</td><td>72</td></tr><tr><th>10</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Charlotte_Hornets_season" title="2019–20 Charlotte Hornets season">Charlotte Hornets</a></td><td>23</td><td>42</td><td>.354</td><td>29.0</td><td>65</td></tr><tr><th>11</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Chicago_Bulls_season" title="2019–20 Chicago Bulls season">Chicago Bulls</a></td><td>22</td><td>43</td><td>.338</td><td>30.0</td><td>65</td></tr><tr><th>12</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_New_York_Knicks_season" title="2019–20 New York Knicks season">New York Knicks</a></td><td>21</td><td>45</td><td>.318</td><td>31.5</td><td>66</td></tr><tr><th>13</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Detroit_Pistons_season" title="2019–20 Detroit Pistons season">Detroit Pistons</a></td><td>20</td><td>46</td><td>.303</td><td>32.5</td><td>66</td></tr><tr><th>14</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Atlanta_Hawks_season" title="2019–20 Atlanta Hawks season">Atlanta Hawks</a></td><td>20</td><td>47</td><td>.299</td><td>33.0</td><td>67</td></tr><tr><th>15</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_Cleveland_Cavaliers_season" title="2019–20 Cleveland Cavaliers season">Cleveland Cavaliers</a></td><td>19</td><td>46</td><td>.292</td><td>33.0</td><td>65</td></tr></tbody></table></td>
<th colspan="2" id="mwARE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2019–20_NBA_season" title="2019–20 NBA season" id="mwARI">Regular season</a></th>
