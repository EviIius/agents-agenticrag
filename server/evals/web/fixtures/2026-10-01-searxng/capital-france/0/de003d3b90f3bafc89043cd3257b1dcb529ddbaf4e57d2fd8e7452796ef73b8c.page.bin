<script src="/assets/js/app.js?id=b300b865650f6980a6aef206147b4673"></script>
<div id="chatbot-label" aria-hidden="true">
    <img src="https://www.cia-france.com/images/logo/logo-centre-international-antibes-pictogramme-white.svg" alt="" class="chatbot-label__logo" loading="lazy"/>
    <span class="chatbot-label__text">Chat with us</span>
    <button type="button" class="chatbot-label__close" aria-label="Close">&times;</button>
</div>

<style>
    #chatbot-label {
        position: fixed;
        right: 20px;
        bottom: 95px;
        max-width: 260px;
        padding: 10px 14px;
        background: #b1163d;
        color: #FFF;
        font-size: 18px;
        font-weight: bold;
        line-height: 1.3;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        opacity: 0;
        transform: translateY(8px);
        transition: opacity .25s ease, transform .25s ease;
        pointer-events: none;
        z-index: 2147483646;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    #chatbot-label .chatbot-label__logo {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        object-fit: contain;
    }
    #chatbot-label .chatbot-label__text {
        display: inline-block;
    }
    #chatbot-label .chatbot-label__close {
        margin-left: 4px;
        padding: 2px 6px;
        background: transparent;
        border: 0;
        color: #fff;
        font-size: 20px;
        line-height: 1;
        cursor: pointer;
        opacity: .8;
    }
    #chatbot-label .chatbot-label__close:hover {
        opacity: 1;
    }
    @media (max-width: 767.98px) {
        #chatbot-label {
            bottom: 145px;
        }
    }
    #chatbot-label.is-visible {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }
    #chatbot-label::after {
        content: "";
        position: absolute;
        right: 22px;
        bottom: -6px;
        width: 12px;
        height: 12px;
        background: #b1163d;
        transform: rotate(45deg);
        box-shadow: 3px 3px 6px rgba(0, 0, 0, 0.06);
    }
</style>

<script>
    (function () {
        var label = document.getElementById('chatbot-label');
        if (!label) return;

        var DISMISS_KEY = 'chatbotLabelDismissed';
        try {
            if (sessionStorage.getItem(DISMISS_KEY)) return;
        } catch (e) {}

        var BUBBLE_SELECTOR = '#yourgpt-chatbot, iframe[src*="yourgpt"], iframe[id*="yourgpt"], div[id*="yourgpt"]';
        var AUTO_DISMISS_MS = 6000;

        function bubbleExists() {
            return !!document.querySelector(BUBBLE_SELECTOR);
        }

        var dismissed = false;
        var autoDismissTimer = null;
        var observer = null;

        function show() {
            if (dismissed) return;
            label.classList.add('is-visible');
            if (autoDismissTimer) clearTimeout(autoDismissTimer);
            autoDismissTimer = setTimeout(dismiss, AUTO_DISMISS_MS);
        }

        function dismiss() {
            if (dismissed) return;
            dismissed = true;
            label.classList.remove('is-visible');
            if (autoDismissTimer) { clearTimeout(autoDismissTimer); autoDismissTimer = null; }
            if (observer) { observer.disconnect(); observer = null; }
            try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch (e) {}
        }

        var revealed = false;
        function tryReveal() {
            if (revealed || dismissed) return;
            if (bubbleExists()) {
                revealed = true;
                show();
            }
        }

        tryReveal();
        observer = new MutationObserver(tryReveal);
        observer.observe(document.body, { childList: true, subtree: true });
        setTimeout(tryReveal, 1500);
        setTimeout(function () { if (!revealed && !dismissed) { revealed = true; show(); } }, 4000);

        var closeBtn = label.querySelector('.chatbot-label__close');
        if (closeBtn) closeBtn.addEventListener('click', dismiss);

        document.addEventListener('click', function (e) {
            if (e.target.closest(BUBBLE_SELECTOR)) dismiss();
        }, true);
    })();
</script>
<script>
    window.dataLayer = window.dataLayer || [];

    document.addEventListener('click', function (e) {
        const link = e.target.closest('a[href^="tel:"], a[href*="api.whatsapp.com/send"], a[href*="wa.me/"]');

        if (!link) {
            return;
        }

        let eventName = '';

        if (link.href.startsWith('tel:')) {
            eventName = 'phone_click';
        } else if (link.href.includes('whatsapp')) {
            eventName = 'whatsapp_click';
        }

        window.dataLayer.push({
            event: eventName,
            button_text: link.textContent.trim(),
            button_url: link.href,
            button_id: link.id || '',
            page_path: window.location.pathname
        });
    });
</script>
<script src="https://player.vimeo.com/api/player.js"></script>
<script>
    document.querySelectorAll('.banner-video iframe').forEach(function (f) {
        var player = new Vimeo.Player(f);
        player.setVolume(0);
    });
</script>

