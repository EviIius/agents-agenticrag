<div class="w-full p-4 bg-white border border-gray-200 rounded-lg shadow sm:p-8 dark:bg-gray-800 dark:border-gray-700 mt-5 mb-5">
    <h5 class="mb-2 text-center text-3xl font-bold text-gray-900 dark:text-white">About Tokyo</h5>
    <div id="infoboxContainer"></div>

    <script>
    $(document).ready(function() {
        var title = "Tokyo"; // Replace this with the title you want to fetch

        $.ajax({
            dataType: 'jsonp',
            url: 'https://en.wikipedia.org/w/api.php',
            data: {
                action: 'parse',
                prop: 'text',
                page: title,
                format: 'json',
            },
            success: function(data) {
                var content = data.parse.text['*'];
                var $infobox = $(content).find('.infobox').eq(0);

                // Remove parts of the infobox
                $infobox.find('.noresize').remove();
                $infobox.find('a').contents().unwrap(); // Remove links
                $infobox.find('sup').remove(); // Remove references
                
 $infobox.find('th.infobox-label').filter(function() {
    return $(this).text().trim() === 'Capital';
}).each(function() {
    $(this).next('td.infobox-data').remove(); // Remove the following td.infobox-data
}).remove(); // Remove the th.infobox-label

$infobox.find('th.infobox-label').filter(function() {
    // Replace the non-breaking space with a regular space and then trim the text
    return $(this).text().replace(/\u00A0/g, ' ').trim() === 'Official languages';
}).each(function() {
    $(this).next('td.infobox-data').remove(); // Remove the following td.infobox-data
}).remove(); // Remove the th.infobox-label

$infobox.find('th.infobox-label').filter(function() {
    // Replace the non-breaking space with a regular space and then trim the text
    return $(this).text().replace(/\u00A0/g, ' ').trim() === 'Calling code';
}).each(function() {
    $(this).next('td.infobox-data').remove(); // Remove the following td.infobox-data
}).remove(); // Remove the th.infobox-label

$infobox.find('th.infobox-label').filter(function() {
    // Replace the non-breaking space with a regular space and then trim the text
    return $(this).text().replace(/\u00A0/g, ' ').trim() === 'ISO 3166 code';
}).each(function() {
    $(this).next('td.infobox-data').remove(); // Remove the following td.infobox-data
}).remove(); // Remove the th.infobox-label
$infobox.find('th.infobox-label').filter(function() {
    // Replace the non-breaking space with a regular space and then trim the text
    return $(this).text().replace(/\u00A0/g, ' ').trim() === 'Driving side';
}).each(function() {
    $(this).next('td.infobox-data').remove(); // Remove the following td.infobox-data
}).remove(); // Remove the th.infobox-label


 $infobox.find('th.infobox-label').filter(function() {
    return $(this).text().trim() === 'Demonym(s)';
}).each(function() {
    $(this).next('td.infobox-data').remove(); // Remove the following td.infobox-data
}).remove(); // Remove the th.infobox-label

   $('#infoboxContainer').html($infobox); // Append modified infobox content to container
            },
            error: function(xhr, status, error) {
                console.error('Error fetching data:', error);
            }
        });
    });
    </script>
