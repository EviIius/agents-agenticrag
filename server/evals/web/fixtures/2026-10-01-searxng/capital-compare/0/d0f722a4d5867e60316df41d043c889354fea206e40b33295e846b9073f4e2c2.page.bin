        </svg>
        <input type="text" id="searchInput" class="pl-10 w-full py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500" placeholder="Search..." onkeyup="liveSearch(this.value)">
    </div>
    <ul id="searchResults" class="absolute w-full border border-gray-300 rounded-lg shadow-lg mt-0 bg-white"></ul>
</div>



<script>
    // Function to perform live search
    function liveSearch(query) {
        // Check if query length is at least three characters
        if (query.length >= 3) {
            fetch('https://theworldcountries.com/geo/api/countries.json')
                .then(response => response.json())
                .then(data => {
                    // Filter countries based on the query
                    const results = data.filter(country =>
                        country.toLowerCase().includes(query.toLowerCase())
                    );
                    // Call function to display search results
                    displaySearchResults(results);
                })
                .catch(error => {
                    console.error('Error fetching data:', error);
                });
        } else {
            // If query length is less than three characters, clear search results
            clearSearchResults();
        }
    }

function displaySearchResults(results) {
    const resultList = document.getElementById('searchResults');
    resultList.innerHTML = ''; // Clear previous results

    results.forEach(country => {
        const listItem = document.createElement('li');
        const link = document.createElement('a');
        link.textContent = country;
        let countrySlug = country.replace(/\s+/g, '-');
        link.href = `https://theworldcountries.com/geo/country/${countrySlug}`;
        listItem.appendChild(link);
        resultList.appendChild(listItem);
    });
}



    // Function to clear search results
    function clearSearchResults() {
        const resultList = document.getElementById('searchResults');
        resultList.innerHTML = ''; // Clear previous results
    }
</script>
<!-- END SEARCH -->

