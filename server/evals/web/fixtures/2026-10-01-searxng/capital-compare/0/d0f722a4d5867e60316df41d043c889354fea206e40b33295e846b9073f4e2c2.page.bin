<script>
document.addEventListener('DOMContentLoaded', function () {
    const apiKey = 'YBOzvOMIevwajaj4RhR+Sw==Qq2EhKwHHn8yrmdR';
    
    // Get longitude and latitude from PHP variable
    const latitude = '35.6895';
    const longitude = '139.6917';

    const apiUrl = `https://api.api-ninjas.com/v1/worldtime?lat=${latitude}&lon=${longitude}`;
    const userLocationApiUrl = 'https://ipapi.co/json/';

    // Function to update the time and date
    function updateTime(currentTime, timeElementId, dateElementId) {
        currentTime.setSeconds(currentTime.getSeconds() + 1);
        document.getElementById(timeElementId).textContent = currentTime.toLocaleTimeString();
        document.getElementById(dateElementId).textContent = currentTime.toLocaleDateString(undefined, {
            weekday: 'long',
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
    }

    // Fetch time and timezone from an API
    function fetchTime(url, timeElementId, timezoneElementId, dateElementId) {
        fetch(url, {
            headers: {
                'X-Api-Key': apiKey
            }
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Error fetching data.');
            }
            return response.json();
        })
        .then(data => {
            const currentTime = new Date(data.datetime);
            document.getElementById(timezoneElementId).textContent = data.timezone;
            setInterval(() => updateTime(currentTime, timeElementId, dateElementId), 1000);
        })
        .catch(error => {
            console.error('API response error:', error);
        });
    }

    // Fetch and display time for country
    fetchTime(apiUrl, 'time-country', 'timezone-country', 'date-country');

    // Fetch and display user's location and time
    fetch(userLocationApiUrl)
        .then(response => {
            if (!response.ok) {
                throw new Error('Error fetching user data.');
            }
            return response.json();
        })
        .then(data => {
            const countryCode = data.country_code.toLowerCase();
            const flagUrl = `https://flagcdn.com/w320/${countryCode}.png`;
            document.getElementById('user-flag').src = flagUrl;

            const timezone = data.timezone;
            const userTimeApiUrl = `https://api.api-ninjas.com/v1/worldtime?timezone=${timezone}`;
            
            fetch(userTimeApiUrl, {
                headers: {
                    'X-Api-Key': apiKey
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Error fetching user time data.');
                }
                return response.json();
            })
            .then(userData => {
                const currentTime = new Date(userData.datetime);
                document.getElementById('timezone-user').textContent = userData.timezone;
                setInterval(() => updateTime(currentTime, 'time-user', 'date-user'), 1000);
            })
            .catch(error => {
                console.error('User time API response error:', error);
            });
        })
        .catch(error => {
            console.error('User location API response error:', error);
        });
});
</script></head>
