<figure class="wp-block-kadence-image kb-image41601_176776-d9 size-full kb-image-is-ratio-size"><div class="kb-is-ratio-image kb-image-ratio-land41"><img fetchpriority="high" decoding="async" src="https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra.png" alt="" width="1920" height="1080" class="kb-img wp-image-39578" srcset="https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra.png 1920w, https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra-300x169.png 300w, https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra-1024x576.png 1024w, https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra-150x84.png 150w, https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra-768x432.png 768w, https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra-1536x864.png 1536w, https://www.airniugini.com.pg/wp-content/uploads/2024/11/Canberra-18x10.png 18w" sizes="(max-width: 1920px) 100vw, 1920px" /></div></figure>
