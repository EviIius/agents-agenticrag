<li about="#cite_note-169" id="cite_note-169" data-mw-footnote-number="168"><span class="mw-cite-backlink" id="mwFS4"><a href="#cite_ref-169" rel="mw:referencedBy" id="mwFS8"><span class="mw-linkback-text" id="mwFTA">↑</span></a></span> <span id="mw-reference-text-cite_note-169" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt601" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwFTE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal ","href":"./Template:Cite_journal"},"params":{"title":{"wt":"Babylonian Planetary Omens. Part One. Enuma Anu Enlil, Tablet 63: The Venus Tablet of Ammisaduqa."},"first1":{"wt":"W. G."},"last1":{"wt":"Lambert"},"date":{"wt":"1987"},"journal":{"wt":"Journal of the American Oriental Society"},"doi":{"wt":"10.2307/602955"},"volume":{"wt":"107"},"issue":{"wt":"1"},"last2":{"wt":"Reiner"},"first2":{"wt":"Erica"},"jstor":{"wt":"602955"},"pages":{"wt":"93–96"}},"i":0}}]}'/><cite id="CITEREFLambertReiner1987" class="citation journal cs1" about="#mwt601">Lambert, W. G.; Reiner, Erica (1987). "Babylonian Planetary Omens. Part One. Enuma Anu Enlil, Tablet 63: The Venus Tablet of Ammisaduqa". <i id="mwFTI">Journal of the American Oriental Society</i>. <b id="mwFTM">107</b> (1): <span class="nowrap" id="mwFTQ">93–</span>96. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwFTU">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.2307%2F602955" class="external text" id="mwFTY">10.2307/602955</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/JSTOR_(identifier)" title="JSTOR (identifier)" class="mw-redirect" id="mwFTc">JSTOR</a><span typeof="mw:Entity" id="mwFTg"> </span><a rel="mw:ExtLink nofollow" href="https://www.jstor.org/stable/602955" class="external te