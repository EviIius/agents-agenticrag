<li about="#cite_note-168" id="cite_note-168" data-mw-footnote-number="167"><span class="mw-cite-backlink" id="mwFSM"><a href="#cite_ref-168" rel="mw:referencedBy" id="mwFSQ"><span class="mw-linkback-text" id="mwFSU">↑</span></a></span> <span id="mw-reference-text-cite_note-168" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt598" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwFSY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book ","href":"./Template:Cite_book"},"params":{"volume":{"wt":"8"},"series":{"wt":"State Archives of Assyria"},"title":{"wt":"Astrological reports to Assyrian kings"},"editor":{"wt":"Hermann Hunger"},"date":{"wt":"1992"},"publisher":{"wt":"Helsinki University Press"},"isbn":{"wt":"978-951-570-130-5"}},"i":0}}]}'/><cite id="CITEREFHermann_Hunger1992" class="citation book cs1" about="#mwt598">Hermann Hunger, ed. (1992). <i id="mwFSc">Astrological reports to Assyrian kings</i>. State Archives of Assyria. Vol.<span typeof="mw:Entity" id="mwFSg"> </span>8. Helsinki University Press. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwFSk">ISBN</a><span typeof="mw:Entity" id="mwFSo"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-951-570-130-5" title="Special:BookSources/978-951-570-130-5" id="mwFSs"><bdi id="mwFSw">978-951-570-130-5</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Astrological+reports+to+Assyrian+kings&amp;rft.series=State+Archives+of+Assyria&amp;rft.pub=Helsinki+University+Press&amp;rft.date=1992&amp;rft.isbn=978-951-570-130-5&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3APlanet" class="Z3988" about="#mwt598" id="mwFS0"></span></span></