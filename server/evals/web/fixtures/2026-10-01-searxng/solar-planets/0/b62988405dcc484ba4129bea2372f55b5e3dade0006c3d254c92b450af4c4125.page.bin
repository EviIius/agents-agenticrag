<li about="#cite_note-ancientmes-170" id="cite_note-ancientmes-170" data-mw-footnote-number="169"><span class="mw-cite-backlink" id="mwFTs"><a href="#cite_ref-ancientmes_170-0" rel="mw:referencedBy" id="mwFTw"><span class="mw-linkback-text" id="mwFT0">↑</span></a></span> <span id="mw-reference-text-cite_note-ancientmes-170" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt604" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwFT4" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite journal ","href":"./Template:Cite_journal"},"params":{"url":{"wt":"http://www.folklore.ee/Folklore/vol16/planets.pdf"},"last1":{"wt":"Kasak"},"first1":{"wt":"Enn"},"last2":{"wt":"Veede"},"first2":{"wt":"Raul"},"title":{"wt":"Understanding Planets in Ancient Mesopotamia"},"journal":{"wt":"Electronic Journal of Folklore"},"access-date":{"wt":"6 February 2008"},"volume":{"wt":"16"},"date":{"wt":"2001"},"pages":{"wt":"7–35"},"editor":{"wt":"Mare Kõiva"},"editor2":{"wt":"Andres Kuperjanov"},"doi":{"wt":"10.7592/fejf2001.16.planets"},"citeseerx":{"wt":"10.1.1.570.6778"},"archive-date":{"wt":"4 February 2019"},"archive-url":{"wt":"https://web.archive.org/web/20190204141254/http://www.folklore.ee/folklore/vol16/planets.pdf"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFKasakVeede2001" class="citation journal cs1" about="#mwt604">Kasak, Enn; Veede, Raul (2001). Mare Kõiva; Andres Kuperjanov (eds.). <a rel="mw:ExtLink nofollow" href="http://www.folklore.ee/Folklore/vol16/planets.pdf" class="external text" id="mwFT8">"Understanding Planets in Ancient Mesopotamia"</a> <span class="cs1-format" id="mwFUA">(PDF)</span>. <i id="mwFUE">Electronic Journal of Folklore</i>. <b id="mwFUI">16</b>: <span class="nowrap" id="mwFUM">7–</span>35. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/CiteSeerX_(ide