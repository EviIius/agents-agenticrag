<td rowspan="4" align="center" valign="middle" style="border-bottom:solid thin" colspan="1">88<br>100% Female</td>
<td rowspan="4" align="center" valign="middle" style="border-bottom:solid thin" colspan="1">35–70</td>
<td rowspan="4" align="center" valign="middle" style="border-bottom:solid thin" colspan="1">25–42</td>
<td rowspan="4" align="center" valign="middle" style="border-bottom:solid thin" colspan="1">10 weeks</td>
