l],&quot;course_id&quot;:[0,7],&quot;answer&quot;:[0,&quot;&quot;],&quot;answer_alt&quot;:[0,null],&quot;duration&quot;:[0,972],&quot;show_notations&quot;:[0,0],&quot;exclude_tests&quot;:[0,0],&quot;exclude_module_tests&quot;:[0,0],&quot;disable_voice_recognition&quot;:[0,0],&quot;is_favorite&quot;:[0,null],&quot;writeit_enabled&quot;:[0,0],&quot;writeit_hint&quot;:[0,&quot;&quot;],&quot;use_remote_speech_recognition&quot;:[0,0],&quot;strings&quot;:[1,[[0,{&quot;id&quot;:[0,260684],&quot;text&quot;:[0,&quot;une bise&quot;],&quot;writing_system_id&quot;:[0,10],&quot;notations&quot;:[1,[]]}],[0,{&quot;id&quot;:[0,260685],&quot;text&quot;:[0,&quot;a kiss (on the cheek)&quot;],&quot;writing_system_id&quot;:[0,1],&quot;notations&quot;:[1,[]]}]]]}],&quot;108577&quot;:[0,{&quot;id&quot;:[0,108577],&quot;audio_url&quot;:[0,&quot;https://d2jkfj9lazd7el.cloudfront.net/audio/phrase/french/108577-faire-la-bise-normalized.mp3&quot;],&quot;literal_string&quot;:[0,null],&quot;course_id&quot;:[0,7],&quot;answer&quot;:[0,&quot;&quot;],&quot;answer_alt&quot;:[0,null],&quot;duration&quot;:[0,1389],&quot;show_notations&quot;:[0,0],&quot;exclude_tests&quot;:[0,0],&quot;exclude_module_tests&quot;:[0,0],&quot;disable_voice_recognition&quot;:[0,0],&quot;is_favorite&quot;:[0,null],&quot;writeit_enabled&quot;:[0,0],&quot;writeit_hint&quot;:[0,&quot;&quot;],&quot;use_remote_speech_recognition&quot;:[0,0],&quot;strings&quot;:[1,[[0,{&quot;id&quot;:[0,260686],&quot;text&quot;:[0,&quot;faire la bise&quot;],&quot;writing_system_id&quot;:[0,10],&quot;notations&quot;:[1,[]]}],[0,{&quot;id&quot;:[0,260687],&quot;text&quot;:[0,&quot;to kiss (on the cheek)&quot;],&quot;writing_system_id&quot;:[0,1],&quot;notations&quot;:[1,[]]}]]]}]}],&quot;lesson_quiz&quot;:[0,{&quot;3694&quot;:[0,null]}],&quot;lesson_components&quot;:[0,{&quot;3694&quot;:[1,[[0,{&quot;id&quot;:[0,137739],&quot;type&quot;:[0,&quot;markdown&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,null],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,24512],&quot;content&quot;:[0,&quot;## Saying \&quot;Good Morning\&quot; in French\n\nThe word for the \&quot;Good Morning\&quot; in French** is **Bonjour**, or sometimes **Bonne matinée\\*\\*. Find out words for the different ways to say Good Morning in French with this free lesson.\n\nSaying Good morning to French people (particularly when entering shops) can make a huge difference to how you are perceived. French people love it when you speak French and are polite as well!\n\nYou can test your pronunciation with our free voice recognition software! Just listen to the audio and follow the pronunciation of the good morning expressions in French.\n\n## How to say Good morning in French\n\nThe French word that is used to say \&quot;Hello,\&quot; **Bonjour**, is also used to say \&quot;Good morning,\&quot; and does not include a reference to **matin** \&quot;morning\&quot; in French.\n\nFriends use **Salut** a lot, the equivalent of \&quot;Hi.\&quot;\n\nWhen French people actually say **Bonne matinée**, literally \&quot;Good morning,\&quot; it is when leaving to wish a good morning, and **never to greet people.**&quot;],&quot;type&quot;:[0,&quot;default&quot;]}]}],[0,{&quot;id&quot;:[0,152677],&quot;type&quot;:[0,&quot;markdown&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,null],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,33096],&quot;content&quot;:[0,&quot;### Important! Perfect Your Pronunciation With Rocket Record\n\nOur voice recognition tool, Rocket Record, is used extensively throughout Rocket French to get you speaking the right way. Listen to the tutor audio then record yourself saying the phrase. Use a headset mic in a quiet environment for best results. [Problems? Click here!](https://www.rocketlanguages.com/help#225)&quot;],&quot;type&quot;:[0,&quot;tip&quot;]}]}],[0,{&quot;id&quot;:[0,67795],&quot;type&quot;:[0,&quot;phrasebox&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,null],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,13060],&quot;lines&quot;:[1,[[0,{&quot;id&quot;:[0,94261],&quot;phrase_id&quot;:[0,108533],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94262],&quot;phrase_id&quot;:[0,108534],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94263],&quot;phrase_id&quot;:[0,108535],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94264],&quot;phrase_id&quot;:[0,108536],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94265],&quot;phrase_id&quot;:[0,108537],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94266],&quot;phrase_id&quot;:[0,108538],&quot;status&quot;:[0,1]}]]]}]}],[0,{&quot;id&quot;:[0,197777],&quot;type&quot;:[0,&quot;markdown&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,15],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,58456],&quot;content&quot;:[0,&quot;### Important! Remember What You Learn\n\nYou&#39;ll put a lot of time into learning French, so we make sure you can remember it all by including fun and engaging **activities at the bottom of every lesson.**&quot;],&quot;type&quot;:[0,&quot;tip&quot;]}]}],[0,{&quot;id&quot;:[0,137740],&quot;type&quot;:[0,&quot;markdown&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,null],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,24513],&quot;content&quot;:[0,&quot;French people are famous for kissing each other in the morning, which can be surprising to some foreigners! It is true that friends will often kiss each other, **faire la bise**, even men. It is less common to kiss colleagues, and men will often just shake hands, **serrer la main**.\n\n**La bise** follows a very strict code! In most French regions it&#39;s two kisses, one on each cheek, but in some parts of France it&#39;s only one (in Britanny for example), three (in the south) or even four (in Normandy)!&quot;],&quot;type&quot;:[0,&quot;default&quot;]}]}],[0,{&quot;id&quot;:[0,67797],&quot;type&quot;:[0,&quot;phrasebox&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,null],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,13061],&quot;lines&quot;:[1,[[0,{&quot;id&quot;:[0,94267],&quot;phrase_id&quot;:[0,108539],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94301],&quot;phrase_id&quot;:[0,108575],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94302],&quot;phrase_id&quot;:[0,108576],&quot;status&quot;:[0,1]}],[0,{&quot;id&quot;:[0,94303],&quot;phrase_id&quot;:[0,108577],&quot;status&quot;:[0,1]}]]]}]}],[0,{&quot;id&quot;:[0,197778],&quot;type&quot;:[0,&quot;markdown&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,15],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,58457],&quot;content&quot;:[0,&quot;### Ready to Start Learning French?\n\nSee how Rocket French helps you learn French online, from pronunciation practice to learning on the go. Watch the official Rocket French Course Tour below!&quot;],&quot;type&quot;:[0,&quot;tip&quot;]}]}],[0,{&quot;id&quot;:[0,197779],&quot;type&quot;:[0,&quot;embed&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,15],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,204],&quot;content&quot;:[0,&quot;&lt;iframe width=\&quot;560\&quot; height=\&quot;315\&quot; src=\&quot;https://www.youtube.com/embed/xfKlpAMrbWA?si=DqnCBwx2DMSb-P2D\&quot; title=\&quot;YouTube video player\&quot; frameborder=\&quot;0\&quot; allow=\&quot;accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\&quot; referrerpolicy=\&quot;strict-origin-when-cross-origin\&quot; allowfullscreen&gt;&lt;/iframe&gt;&quot;]}]}],[0,{&quot;id&quot;:[0,137741],&quot;type&quot;:[0,&quot;markdown&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,null],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,24514],&quot;content&quot;:[0,&quot;That’s it for today’s lesson. I hope you enjoyed it, that you learned new expressions, bettered your pronunciation, and that you&#39;re now ready to greet French speakers in the morning!\n\nIf you want to learn how to say [Goodbye in French](https://www.rocketlanguages.com/french/salutations/goodbye-in-french) or other [French salutations](https://www.rocketlanguages.com/french/salutations/) then check these lessons out!\n\nÀ bientôt !\n\nMarie-Claire Rivière and the Rocket French Team&quot;],&quot;type&quot;:[0,&quot;default&quot;]}]}],[0,{&quot;id&quot;:[0,152678],&quot;type&quot;:[0,&quot;markdown&quot;],&quot;title_show&quot;:[0,0],&quot;title_text&quot;:[0,null],&quot;language_id&quot;:[0,null],&quot;status&quot;:[0,&quot;live&quot;],&quot;component&quot;:[0,{&quot;id&quot;:[0,33097],&quot;content&quot;:[0,&quot;### Make Your French Stick With The Rocket Activities\n\nReinforce your French learning with activities that test your recall, listening and speaking skills!&quot;],&quot;type&quot;:[0,&quot;tip&quot;]}]}]]]}]}]}],&quot;lessonId&quot;:[0,3694],&quot;activeCourse&quot;:[0,{&quot;id&quot;:[0,7],&quot;name&quot;:[0,&quot;French&quot;],&quot;locale&quot;:[0,&quot;fr-FR&quot;],&quot;slug&quot;:[0,&quot;french&quot;],&quot;writing_system_ids&quot;:[1,[[0,10],[0,1]]],&quot;products&quot;:[1,[[0,{&quot;id&quot;:[0,3],&quot;name&quot;:[0,&quot;Rocket French Level 1&quot;],&quot;type_id&quot;:[0,1],&quot;level_id&quot;:[0,1],&quot;course_id&quot;:[0,7]}],[0,{&quot;id&quot;:[0,4],&quot;name&quot;:[0,&quot;Rocket French Level 2&quot;],&quot;type_id&quot;:[0,1],&quot;level_id&quot;:[0,2],&quot;course_id&quot;:[