    <script>
    (function () {
        // storefront hosts only: aws.amazon.com / docs.aws.amazon.com are docs, not money
        var MERCHANTS = [
            [/^(www\.|smile\.)?amazon\.[a-z]{2,3}(\.[a-z]{2})?$/, 'amazon'],
            [/^amzn\.to$/, 'amazon'],
            [/(^|\.)click\.linksynergy\.com$/, 'rakuten'],
            [/(^|\.)bit\.ly$/, 'shortlink']
        ];
        var recent = Object.create(null);

        function trim(s, n) {
            s = (s || '').replace(/\s+/g, ' ').trim();
            return s.length > n ? s.slice(0, n) : s;
        }

        function merchantOf(a) {
            var host = (a.hostname || '').toLowerCase();
            if (host === location.hostname) {
                return a.pathname.indexOf('/go/') === 0 ? 'go_redirect' : null;
            }
            for (var i = 0; i < MERCHANTS.length; i++) {
                if (MERCHANTS[i][0].test(host)) return MERCHANTS[i][1];
            }
            return null;
        }

        function asinOf(href) {
            var m = href.match(/\/(?:dp|gp\/product|gp\/aw\/d)\/([A-Z0-9]{10})(?:[\/?#]|$)/);
            return m ? m[1] : '';
        }

        function sectionOf(a) {
            var hs = document.querySelectorAll('.entry-content h2, .entry-content h3'), last = '';
            for (var i = 0; i < hs.length; i++) {
                if (!(hs[i].compareDocumentPosition(a) & Node.DOCUMENT_POSITION_FOLLOWING)) break;
                last = hs[i].textContent;
            }
            return trim(last, 100);
        }

        function placementOf(a) {
            if (a.closest('table')) return 'table';
            if (a.closest('.wp-block-button, .wp-block-buttons')) return 'button';
            if (a.querySelector('img')) return 'image';
            if (a.closest('li')) return 'list';
            return 'inline';
        }

        function labelOf(a) {
            var img = a.querySelector('img');
            return trim(a.textContent || a.getAttribute('aria-label') || (img && img.alt) || '', 100);
        }

        function send(a, how) {
            var merchant = merchantOf(a);
            if (!merchant) return;
            var href = a.href || '', now = new Date().getTime();
            if (recent[href] && now - recent[href] < 1500) return;
            recent[href] = now;

            var params = {
                merchant: merchant,
                asin: asinOf(href),
                link_domain: trim(a.hostname, 100),
                link_path: trim(a.pathname, 100),
                link_text: labelOf(a),
                link_section: sectionOf(a),
                placement: placementOf(a),
                click_type: how
            };
            if (typeof window.gtag === 'function') {
                window.gtag('event', 'affiliate_click', params);
            } else {
                params.event = 'affiliate_click';
                (window.dataLayer = window.dataLayer || []).push(params);
            }
        }

        function anchor(e) {
            return e.target && e.target.closest ? e.target.closest('a[href]') : null;
        }

        document.addEventListener('click', function (e) {
            var a = anchor(e);
            if (a) send(a, (e.metaKey || e.ctrlKey) ? 'new_tab' : 'click');
        }, true);

        document.addEventListener('auxclick', function (e) {
            if (e.button !== 1) return;
            var a = anchor(e);
            if (a) send(a, 'middle');
        }, true);
    })();
    </script>
        <script>
    (function() {
        var overlay = document.getElementById('cfg-search-overlay');
        if (!overlay) return;
        var input = overlay.querySelector('.cfg-search-overlay__input');
        var toggles = document.querySelectorAll('.cfg-search-toggle');
        var closeBtn = overlay.querySelector('.cfg-search-overlay__close');

        function openSearch(e) {
            if (e) e.preventDefault();
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
            setTimeout(function() { input.focus(); }, 100);
        }

        function closeSearch() {
            overlay.classList.remove('active');
            document.body.style.overflow = '';
            input.value = '';
        }

        toggles.forEach(function(t) { t.addEventListener('click', openSearch); });
        closeBtn.addEventListener('click', closeSearch);
        overlay.addEventListener('click', function(e) {
            if (e.target === overlay) closeSearch();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && overlay.classList.contains('active')) closeSearch();
            if (e.key === '/' && !overlay.classList.contains('active') && !['INPUT','TEXTAREA','SELECT'].includes(document.activeElement.tagName)) {
                e.preventDefault();
                openSearch();
            }
        });
    })();
    </script>
        <script>
    (function() {
        /* Copy-to-clipboard */
        document.querySelectorAll('.wp-block-code, .wp-block-preformatted').forEach(function(block) {
            var wrap = document.createElement('div');
            wrap.className = 'cfg-code-wrap';
            block.parentNode.insertBefore(wrap, block);
            wrap.appendChild(block);

            var btn = document.createElement('button');
            btn.className = 'code-copy-btn';
            btn.textContent = 'Copy';
            btn.setAttribute('aria-label', 'Copy code to clipboard');
            btn.addEventListener('click', function() {
                var code = block.querySelector('code') || block;
                navigator.clipboard.writeText(code.innerText).then(function() {
                    btn.textContent = 'Copied!';
                    btn.classList.add('copied');
                    setTimeout(function() {
                        btn.textContent = 'Copy';
                        btn.classList.remove('copied');
                    }, 2000);
                });
            });
            wrap.appendChild(btn);
        });

        /* Smooth scroll for anchor links only (not back-to-top) */
        document.querySelectorAll('a[href^="#"]').forEach(function(a) {
            a.addEventListener('click', function(e) {
                var target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        /* Float ToC: hide when past article body */
        var toc = document.getElementById('cfg-float-toc');
        if (toc) {
            var body = document.querySelector('.cfg-article__body');
            if (body) {
                var tocTicking = false;
                window.addEventListener('scroll', function() {
                    if (!tocTicking) {
                        requestAnimationFrame(function() {
                            var bodyBottom = body.getBoundingClientRect().bottom;
                            if (bodyBottom < 100) {
                                toc.classList.add('toc-hidden');
                            } else {
                                toc.classList.remove('toc-hidden');
                            }
                            tocTicking = false;
                        });
                        tocTicking = true;
                    }
                });
            }
        }

        /* Reading progress bar */
        var bar = document.getElementById('cfg-progress');
        if (bar) {
            var article = document.querySelector('.entry-content') || document.querySelector('article');
            if (article) {
                var ticking = false;
                window.addEventListener('scroll', function() {
                    if (!ticking) {
                        requestAnimationFrame(function() {
                            var rect = article.getBoundingClientRect();
                            var total = article.offsetHeight - window.innerHeight;
                            var progress = Math.min(Math.max(-rect.top / total * 100, 0), 100);
                            bar.style.width = progress + '%';
                            ticking = false;
                        });
                        ticking = true;
                    }
                });
            }
        }
    })();
    </script>
        <script>
    (function() {
        var imgs = document.querySelectorAll('.entry-content .wp-block-image img');
        if (!imgs.length) return;

        function openLightbox(src) {
            var overlay = document.createElement('div');
            overlay.className = 'cfg-lightbox';
            overlay.innerHTML = '<button class="cfg-lightbox__close" aria-label="Close">&times;</button><img src="' + src + '" alt="">';

            document.body.appendChild(overlay);
            document.body.style.overflow = 'hidden';
            requestAnimationFrame(function() { overlay.classList.add('cfg-lightbox--visible'); });

            function close() {
                overlay.classList.remove('cfg-lightbox--visible');
                setTimeout(function() {
                    overlay.remove();
                    document.body.style.overflow = '';
                }, 200);
            }

            overlay.addEventListener('click', function(e) {
                if (e.target === overlay || e.target.classList.contains('cfg-lightbox__close')) close();
            });
            document.addEventListener('keydown', function handler(e) {
                if (e.key === 'Escape') { close(); document.removeEventListener('keydown', handler); }
            });
        }

        imgs.forEach(function(img) {
            var link = img.closest('a');
            // If the image links to a real page (e.g. an affiliate product link),
            // leave the click alone so the link opens normally. Only lightbox images
            // that are unlinked or that point to an actual image file.
            if (link && link.href && !/\.(jpe?g|png|gif|webp|avif|svg)(\?.*)?$/i.test(link.href)) {
                return;
            }
            img.addEventListener('click', function(e) {
                e.preventDefault();
                var src = (link && link.href) ? link.href : img.src;
                openLightbox(src);
            });
        });
    })();
    </script>
