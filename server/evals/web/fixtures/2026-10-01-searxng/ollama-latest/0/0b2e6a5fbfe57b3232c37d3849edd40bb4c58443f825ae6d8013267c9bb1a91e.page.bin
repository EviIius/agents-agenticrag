function safeCampaignValue(value) {
  if (typeof value !== 'string') return null;
  var normalized = value.trim().toLowerCase();
  return /^[a-z0-9][a-z0-9._-]{0,99}$/.test(normalized) ? normalized : null;
}
function safeUrl(value, originOnly) {
  if (typeof value !== 'string' || !value) return null;
  try {
    var parsed = new URL(value, window.location.origin);
    return originOnly ? parsed.origin : parsed.origin + parsed.pathname;
  } catch (error) {
    return null;
  }
}
function safeReferrer(value) {
  if (value === '$direct') return value;
  return safeUrl(value, true);
}
function safeReferringDomain(value) {
  if (typeof value !== 'string' || !value) return null;
  try {
    return new URL(value, window.location.origin).hostname.toLowerCase();
  } catch (error) {
    return null;
  }
}
function replaceOrRemove(properties, name, value) {
  if (!(name in properties)) return;
  if (value) properties[name] = value;
  else delete properties[name];
}
function sanitizeAnalyticsProperties(properties) {
  if (!properties || typeof properties !== 'object') return;
  var urlProperties = ['$current_url', '$initial_current_url', '$session_entry_url'];
  var referrerProperties = ['$referrer', '$initial_referrer'];
  var campaignProperties = [
    '$utm_source', '$utm_medium', '$utm_campaign',
    '$initial_utm_source', '$initial_utm_medium', '$initial_utm_campaign',
    'utm_source', 'utm_medium', 'utm_campaign'
  ];

  urlProperties.forEach(function(name) {
    replaceOrRemove(properties, name, safeUrl(properties[name], false));
  });
  referrerProperties.forEach(function(name) {
    replaceOrRemove(properties, name, safeReferrer(properties[name]));
  });
  campaignProperties.forEach(function(name) {
    replaceOrRemove(properties, name, safeCampaignValue(properties[name]));
  });
}
function sanitizeAnalyticsEvent(event) {
  if (!event || !event.properties) return event;

  sanitizeAnalyticsProperties(event.properties);
  sanitizeAnalyticsProperties(event.properties.$set);
  sanitizeAnalyticsProperties(event.properties.$set_once);

  return event;
}
