JK\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://discord.com/invite/nwuETS9jJK\",\"className\":\"Footer-module__OJmioW__social\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"aria-label\":\"Thunder Compute on Discord\",\"children\":[\"$\",\"svg\",null,{\"viewBox\":\"0 0 24 24\",\"fill\":\"currentColor\",\"focusable\":\"false\",\"className\":\"Footer-module__OJmioW__socialIcon\",\"aria-hidden\":\"true\",\"children\":[\"$\",\"path\",null,{\"transform\":\"translate(2 1.6) scale(0.8333)\",\"d\":\"$32\"}]}]}]}]\n33:T187d,"])</script><script>self.__next_f.push([1,"                                                                                                                                                                *******  **********                       \n                                                                                                                                                               *******  *********.\n                                                                                                                                                              *******  *********\n                                                                                                                                                             ******* **********\n                                                                                                                                                             ******* *********\n                                                                                                                                                            ****************`\n                                                                                                                                                           ****************\n                                                                                                                                                          ****************\n                                                                                                                                                         `***************\n                                                                                                                                                         ***************\n                                                                                                                                                        ***************\n                                                                                                                                                       **************\n                                                                                                                                                      **************\n                                                                                                                                                      ************\n                                                                                                                                                     *************\n                                                                                                                                                    *************\n                                                                                                                                                   ************`\n                                                                                                                                                   ***********\n                                                                                                                                                  ***********\n                                                                                                                                                 ;**********\n                                                                                                                                                **********;\n                                                                                                                                                *********\n                                                                                                                                               *********\n                                                                                                                                              *********\n                                                                                                                                             *********\n                                                                                                                                            ;*******\n                                                                                                                                            *******\n                                                                                                                                           *******\n                                                                                                                                          ******\n                                                                                                                                         *******\n                                                                                                                                         ******\n                                                                                                                                        *****\n                                                                                                                                       *****\n                                                                                                                                      *****\n                                                                                                                                      ****\n                                                                                                                                     ***.\n                                                                                                                                    ***\n                                                                                                                                   ***\n                                                                                                                                  ***\n                                                                                                                                  *\n"])</script><script>self.__next_f.push([1,"31:[\"$\",\"div\",null,{\"className\":\"Footer-module__OJmioW__tail\",\"children\":[\"$\",\"$L2f\",null,{\"frame\":\"$33\",\"className\":\"Footer-module__OJmioW__ascii\",\"style\":{\"color\":\"transparent\",\"opacity\":0.8,\"textShadow\":\"0 42lh 0 #35353d\",\"overflow\":\"visible\",\"background\":\"none\"}}]}]\n"])</script><script>self.__next_f.push([1,"34:T13ae,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://www.thundercompute.com/#organization\",\"name\":\"Thunder Compute\",\"url\":\"https://www.thundercompute.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.thundercompute.com/icon.svg\"},\"description\":\"Thunder Compute builds virtualization software that turns underutilized GPUs into additional capacity.\",\"sameAs\":[\"https://x.com/ThunderCompute\",\"https://www.linkedin.com/company/102863366\",\"https://www.crunchbase.com/organization/thunder-9b4c\",\"https://www.producthunt.com/products/thunder-compute\",\"https://www.ycombinator.com/companies/thunder-compute\",\"https://marketplace.visualstudio.com/items?itemName=ThunderCompute.thunder-compute\"]},{\"@type\":\"WebSite\",\"@id\":\"https://www.thundercompute.com/#website\",\"url\":\"https://www.thundercompute.com\",\"name\":\"Thunder Compute\",\"publisher\":{\"@id\":\"https://www.thundercompute.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://www.thundercompute.com/search?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}},{\"@type\":\"BlogPosting\",\"@id\":\"https://www.thundercompute.com/blog/what-is-ollama-run-ai-models-locally#article\",\"headline\":\"What is Ollama? Complete Guide to Local AI Models (October 2026)\",\"description\":\"Ollama is a free, open-source (MIT) tool for running LLMs like Llama, Qwen and DeepSeek locally. See what's free, Ollama Cloud pricing and hardware needs.\",\"url\":\"https://www.thundercompute.com/blog/what-is-ollama-run-ai-models-locally\",\"mainEntityOfPage\":\"https://www.thundercompute.com/blog/what-is-ollama-run-ai-models-locally\",\"datePublished\":\"2025-10-17T00:00:00.000Z\",\"dateModified\":\"2026-10-01T00:00:00.000Z\",\"image\":\"https://www.thundercompute.com/og/blog-v1.png\",\"author\":{\"@id\":\"https://www.thundercompute.com/#carl-peterson\"},\"publisher\":{\"@id\":\"https://www.thundercompute.com/#organization\"},\"isPartOf\":{\"@id\":\"https://www.thundercompute.com/blog#blog\"},\"articleSection\":\"AI Workflows\",\"keywords\":\"ollama, local-llm, open-source-ai, ai-inference, gpu-cloud, llm, vram, ollama-models, ollama-cloud, ollama-pricing\"},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.thundercompute.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Writing\",\"item\":\"https://www.thundercompute.com/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"What is Ollama? Complete Guide to Local AI Models (October 2026)\",\"item\":\"https://www.thundercompute.com/blog/what-is-ollama-run-ai-models-locally\"}]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is Ollama free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Ollama is free, open source and unlimited on your own hardware. Ollama Cloud has a free tier, then Pro ($20/mo), Max ($100/mo) and Team ($500/mo) plans with monthly usage credits. Thunder Compute rents a 48GB RTX A6000 for $0.35/hr.\"}},{\"@type\":\"Question\",\"name\":\"What is Ollama Cloud?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ollama Cloud runs models on Ollama's servers instead of your GPU, through the same CLI and API as local Ollama. Cloud models use a :cloud tag suffix, such as kimi-k2.6:cloud. Run ollama signin once; every request needs an internet connection.\"}},{\"@type\":\"Question\",\"name\":\"Is Ollama safe to use?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, when installed from ollama.com or the official GitHub releases. Its API listens only on localhost by default and has no built-in authentication. Never expose port 11434 to the internet without a reverse proxy, VPN or SSH tunnel.\"}},{\"@type\":\"Question\",\"name\":\"What hardware do I need to run Ollama?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You need a GPU with enough VRAM for your model's precision: about 2GB per 1B parameters at FP16 and 1GB at Q8, plus context. An 8B model at Q8 fits a 12GB GPU. A 32B model at Q8 needs 30-38GB, usually a 48GB cloud GPU.\"}},{\"@type\":\"Question\",\"name\":\"Can I use Ollama without a GPU?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Ollama supports CPU-only execution, but generation is much slower than on a GPU, especially for models above 7B. Use a dedicated GPU for anything beyond light testing.\"}},{\"@type\":\"Question\",\"name\":\"When should I move from local Ollama to cloud infrastructure?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Move to the cloud when local hardware can't fit the model or precision you need. Cloud GPUs also suit consistent production performance and shared team access to GPU resources.\"}}]},{\"@type\":\"Blog\",\"@id\":\"https://www.thundercompute.com/blog#blog\",\"name\":\"Thunder Compute Writing\",\"url\":\"https://www.thundercompute.com/blog\",\"inLanguage\":\"en\",\"publisher\":{\"@id\":\"https://www.thundercompute.com/#organization\"}},{\"@type\":\"Person\",\"@id\":\"https://www.thundercompute.com/#carl-peterson\",\"name\":\"Carl Peterson\",\"jobTitle\":\"Co-Founder and CEO\",\"worksFor\":{\"@id\":\"https://www.thundercompute.com/#organization\"},\"sameAs\":[\"https://www.linkedin.com/in/cpeterson42\",\"https://github.com/cpeterson42\",\"https://x.com/carlpeterson\"]}]}"])</script><script>self.__next_f.push([1,"23:[\"$\",\"div\",null,{\"className\":\"page-wrapper cloud-page\",\"children\":[\"$\",\"main\",null,{\"className\":\"main-wrapper\",\"children\":[[\"$\",\"$L1a\",null,{\"currentPath\":\"/blog\"}],[\"$\",\"div\",null,{\"className\":\"railed-top\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$34\"}}],\"$L35\"]}],\"$L36\"]}]}]\n"])</script><script>self.__next_f.push([1,"37:T6b79,"])</script><script>self.__next_f.push([1,"\u003cp\u003e\u003ca href=\"https://ollama.com/\" target=\"_blank\" rel=\"noopener\"\u003eOllama\u003c/a\u003e is a free, open-source (MIT-licensed) tool for running large language models (LLMs) like Llama, DeepSeek, Qwen and Gemma on your own computer. Local use is free and unlimited. Ollama Cloud adds a free tier that includes a small amount of monthly usage for a set of starter models, plus paid plans from $20/month.\u003c/p\u003e\n\u003cp\u003eOllama works through a command-line tool, a desktop app or an OpenAI-compatible API. When a model outgrows your machine, you can run Ollama on a dedicated \u003ca href=\"https://www.thundercompute.com/pricing\" target=\"_blank\"\u003ecloud GPU from $0.35/hr\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTakeaways\u003c/strong\u003e\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eFree for local use:\u003c/strong\u003e Ollama runs open models on your own hardware at no cost and with no usage limits.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eOllama Cloud is optional:\u003c/strong\u003e it offers a free tier with starter credits, then paid plans from $20/month.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ePrecision drives memory:\u003c/strong\u003e \u003ca href=\"https://medium.com/@laurentkubaski/ollama-model-names-explained-a39460e0fab5\" target=\"_blank\" rel=\"noopener\"\u003eMost default Ollama tags\u003c/a\u003e are 4-bit; Q8 and FP16 need 1.7-3.3x more memory.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eCloud GPUs fill the gap:\u003c/strong\u003e Thunder Compute runs Ollama on a 48GB RTX A6000 for $0.35/hr.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eWhat Is Ollama?\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"/blog/images/69362a66cc1ed4f4a831b9bf_6903a779a61f2561fa15b9b5_qmz7KN1nk5GAVM2btyHVkjckOM.png\" alt=\"Ollama running a local language model from the command line.\"\u003e\u003c/p\u003e\n\u003cp\u003eOllama is an \u003ca href=\"https://github.com/ollama/ollama\" target=\"_blank\" rel=\"noopener\"\u003eopen-source platform\u003c/a\u003e for running and managing LLMs locally or through hosted cloud models. It packages model weights, configuration and a prompt template into a single Modelfile. Pulling and running a model takes one command.\u003c/p\u003e\n\u003cp\u003eOllama gives you full control over your models and data, unlike proprietary cloud AI services. The same CLI and API work for local models and for models routed through Ollama\u0026#39;s cloud.\u003c/p\u003e\n\u003ch3\u003eWho Makes Ollama?\u003c/h3\u003e\n\u003cp\u003eOllama Inc. is an independent, \u003ca href=\"https://www.ycombinator.com/companies/ollama\" target=\"_blank\" rel=\"noopener\"\u003eventure-backed startup based in Palo Alto, California\u003c/a\u003e. Jeffrey Morgan (CEO) and Michael Chiang co-founded the company. The pair \u003ca href=\"https://betakit.com/kitematic-founders-nab-65-million-usd-to-help-devs-run-ai-models-locally-with-ollama/\" target=\"_blank\" rel=\"noopener\"\u003epreviously built Kitematic, an early graphical interface for Docker\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://pkg.go.dev/github.com/jmorganca/ollama@v0.1.14\" target=\"_blank\" rel=\"noopener\"\u003eOllama first launched around Meta\u0026#39;s Llama models\u003c/a\u003e, and the name appears to nod to them. Today it runs models from Google, Microsoft, Mistral, DeepSeek, Alibaba (Qwen), Moonshot AI (Kimi) and other labs.\u003c/p\u003e\n\u003cp\u003eOllama\u0026#39;s design reflects the founders\u0026#39; Docker background: you pull and run models much like container images.\u003c/p\u003e\n\u003ch2\u003eIs Ollama Free? Ollama Pricing Explained\u003c/h2\u003e\n\u003cp\u003eYes, Ollama is free to download and use. Running models on your own hardware is unlimited and needs no account. The software is \u003ca href=\"https://pkg.go.dev/github.com/ollama/ollama@v0.8.0-rc0\" target=\"_blank\" rel=\"noopener\"\u003ereleased under the MIT license\u003c/a\u003e, so commercial use is also free. You pay only for Ollama Cloud, which runs models on Ollama\u0026#39;s servers instead of your GPU.\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://ollama.com/blog/transparent-pricing\" target=\"_blank\" rel=\"noopener\"\u003eOllama Cloud moved to credit-based pricing on August 31, 2026\u003c/a\u003e. Each paid plan includes a monthly pool of usage credits, spent at per-token rates that vary by model. Usage continues at the same rates after the included credits run out. The old 5-hour session and weekly limits no longer apply, although existing subscribers can keep their legacy plans.\u003c/p\u003e\n\u003cp\u003eOllama Cloud plans as of October 2026:\u003c/p\u003e\n\u003cdiv class=\"Post-module__zd2qRG__tableScroll\"\u003e\u003ctable\u003e\n  \u003cthead\u003e\n    \u003ctr\u003e\n      \u003cth\u003ePlan\u003c/th\u003e\n      \u003cth\u003ePrice\u003c/th\u003e\n      \u003cth\u003eIncluded Usage\u003c/th\u003e\n      \u003cth style=\"text-align:center;\"\u003eConcurrent Requests\u003c/th\u003e\n      \u003cth\u003eBest For\u003c/th\u003e\n    \u003c/tr\u003e\n  \u003c/thead\u003e\n  \u003ctbody\u003e\n    \u003ctr\u003e\n      \u003ctd\u003eFree\u003c/td\u003e\n      \u003ctd\u003e$0\u003c/td\u003e\n      \u003ctd\u003eStarter credits for a set of starter models; unlimited local use\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e1\u003c/td\u003e\n      \u003ctd\u003eTrying cloud models\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003ePro\u003c/td\u003e\n      \u003ctd\u003e$20/mo or $200/yr\u003c/td\u003e\n      \u003ctd\u003e$60 of credits per month\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e3\u003c/td\u003e\n      \u003ctd\u003eDaily individual use\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003eMax\u003c/td\u003e\n      \u003ctd\u003e$100/mo\u003c/td\u003e\n      \u003ctd\u003e$300 of credits per month\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e10\u003c/td\u003e\n      \u003ctd\u003eRunning several agents at once\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003eTeam\u003c/td\u003e\n      \u003ctd\u003e$500/mo\u003c/td\u003e\n      \u003ctd\u003e$1K of credits per month, shared across unlimited users\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e10\u003c/td\u003e\n      \u003ctd\u003eTeams with centralized billing\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003eEnterprise\u003c/td\u003e\n      \u003ctd\u003eCustom\u003c/td\u003e\n      \u003ctd\u003eCustom\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003eCustom\u003c/td\u003e\n      \u003ctd\u003eLarge organizations\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003cp\u003eUnused Ollama Cloud credits do not roll over. Any plan, including Free, can buy extra credits to unlock all models on a pay-as-you-go basis. \u003ca href=\"https://ollama.com/pricing\" target=\"_blank\" rel=\"noopener\"\u003eOllama\u0026#39;s pricing page\u003c/a\u003e lists per-model token rates.\u003c/p\u003e\n\u003ch3\u003eOllama Cloud or a Dedicated GPU: Which Costs Less?\u003c/h3\u003e\n\u003cp\u003eOllama Cloud is usually cheaper for occasional use, since you pay per token and manage no hardware. A dedicated GPU can be cheaper for long sessions, batch jobs and custom models. The $20 Ollama Pro subscription equals about 57 hours on a Thunder Compute RTX A6000 (48GB VRAM) at $0.35/hr. It also equals about 18 hours on an NVIDIA A100 80GB at $1.09/hr, with no per-token metering.\u003c/p\u003e\n\u003cp\u003eA dedicated GPU runs any model and precision that fits in VRAM, including fine-tuned GGUF files (llama.cpp\u0026#39;s model format) and full-precision FP16 tags. The trade-off is setup: you size, start and stop a GPU instance, while Ollama Cloud needs only a sign-in.\u003c/p\u003e\n\u003ch2\u003eOllama vs Cloud AI: How Do They Compare?\u003c/h2\u003e\n\u003cp\u003eOllama wins on privacy, cost control and offline use. Cloud AI services like ChatGPT and Claude win on setup speed and simplicity.\u003c/p\u003e\n\u003cdiv class=\"Post-module__zd2qRG__tableScroll\"\u003e\u003ctable\u003e\n  \u003cthead\u003e\n    \u003ctr\u003e\n      \u003cth\u003e\u003c/th\u003e\n      \u003cth\u003eOllama (Local)\u003c/th\u003e\n      \u003cth\u003eCloud AI (ChatGPT / Claude)\u003c/th\u003e\n    \u003c/tr\u003e\n  \u003c/thead\u003e\n  \u003ctbody\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eData Privacy\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eComplete: data never leaves your machine\u003c/td\u003e\n      \u003ctd\u003eData processed on vendor servers\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eCost\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eFree to run; pay only for hardware or GPU time\u003c/td\u003e\n      \u003ctd\u003ePer-token API fees or $20+/month subscriptions\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eInternet Required\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eLocal models: no. Cloud models: yes.\u003c/td\u003e\n      \u003ctd\u003eYes, always requires a connection\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eModel Choice\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003e\u003ca href=\"https://ollama.com/library\" target=\"_blank\" rel=\"noopener\"\u003e4,500+ open-weight models\u003c/a\u003e (Llama 4, DeepSeek R1, Kimi K2, Mistral and more)\u003c/td\u003e\n      \u003ctd\u003eLimited to the provider's own models\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eSetup Time\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eAbout 5 minutes\u003c/td\u003e\n      \u003ctd\u003eInstant (browser-based)\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eBest For\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003ePrivacy-sensitive work, cost control, offline use, regulated industries\u003c/td\u003e\n      \u003ctd\u003eGeneral use, multimodal tasks, no technical setup\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003cp\u003eChoose Ollama when your data can\u0026#39;t leave your infrastructure, API bills are climbing or you need to work offline. Choose cloud AI when you need frontier reasoning or built-in multimodal features without setup.\u003c/p\u003e\n\u003ch2\u003eHow Ollama Works\u003c/h2\u003e\n\u003cp\u003eOllama runs as a background service that downloads models, loads them into GPU or system memory and serves them through a local API. It handles model weights, configuration and runtime libraries for you.\u003c/p\u003e\n\u003ch3\u003eSetting Up Ollama\u003c/h3\u003e\n\u003cp\u003eOllama installs and runs a first model in three steps:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e\u003ca href=\"https://ollama.com/download\" rel=\"noopener\" target=\"_blank\"\u003eDownload the installer\u003c/a\u003e from the official Ollama website.\u003c/li\u003e\n\u003cli\u003eRun the installer and open your terminal.\u003c/li\u003e\n\u003cli\u003eRun a model: \u003ccode\u003eollama run llama3.2\u003c/code\u003e\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eAfter setup, type a prompt and the model responds, much like ChatGPT or Claude.\u003c/p\u003e\n\u003cp\u003e\u003cimg src=\"/blog/images/69362a66cc1ed4f4a831b9cc_6903a779a61f2561fa15b9ac_QTU9J2eMxjhiN9IW2ptGhhF3fzE.png\" alt=\"Terminal chat with an Ollama model running locally.\"\u003e\u003c/p\u003e\n\u003ch3\u003eCLI, API and Desktop App\u003c/h3\u003e\n\u003cp\u003eOllama offers three interfaces to the same local engine and model library: a CLI, a REST API and a desktop app.\u003c/p\u003e\n\u003cp\u003eThe CLI lets you prompt models directly and manage them:\u003c/p\u003e\n\u003cpre\u003e\u003ccode class=\"language-bash\"\u003eollama run llama3.1:8b                              # start an interactive chat\nollama run llama3.1:8b \u0026quot;Explain KV cache briefly\u0026quot;   # send a single prompt and exit\nollama pull llama3.1:8b                             # download a model\nollama list                                         # show installed models\nollama ps                                           # show loaded models and the GPU/CPU split\nollama rm llama3.1:8b                               # delete a model\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003e\u003cstrong\u003eThe REST API serves models to other applications\u003c/strong\u003e at \u003ccode\u003ehttp://localhost:11434\u003c/code\u003e. Scripts, IDE coding assistants and chat interfaces all talk to Ollama through the REST API, which also accepts OpenAI-style requests.\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://ollama.com/blog/new-app\" target=\"_blank\" rel=\"noopener\"\u003e\u003cstrong\u003eThe Ollama desktop app adds a chat window\u003c/strong\u003e\u003c/a\u003e with file and image drag-and-drop for . \u003ca href=\"https://www.databasemart.com/blog/intro-to-ollama-app-v0100\" target=\"_blank\" rel=\"noopener\"\u003eOn Linux, Ollama is command-line only\u003c/a\u003e.\u003c/p\u003e\n\u003ch3\u003eOllama\u0026#39;s REST API and OpenAI Compatibility\u003c/h3\u003e\n\u003cp\u003eOllama exposes a local REST API at \u003ccode\u003ehttp://localhost:11434\u003c/code\u003e that \u003ca href=\"https://docs.ollama.com/api/openai\" target=\"_blank\" rel=\"noopener\"\u003emirrors the OpenAI Chat Completions API\u003c/a\u003e. Tools built for OpenAI (LangChain, LlamaIndex, CrewAI, Continue) usually work with Ollama by changing only the base URL. \u003ca href=\"https://docs.ollama.com/integrations/claude-code\" target=\"_blank\" rel=\"noopener\"\u003eClaude Code and other Anthropic-compatible tools\u003c/a\u003e connect via \u003ccode\u003eANTHROPIC_BASE_URL=http://localhost:11434\u003c/code\u003e.\u003c/p\u003e\n\u003cp\u003eThis API compatibility is one of the main reasons developers adopt Ollama over running llama.cpp directly. The same endpoint serves local and cloud-tagged models.\u003c/p\u003e\n\u003ch2\u003eOllama Cloud vs Local Models\u003c/h2\u003e\n\u003cp\u003eOllama Cloud models run on Ollama\u0026#39;s servers instead of your GPU, through the same CLI and API as local models. Cloud models carry a \u003ccode\u003e:cloud\u003c/code\u003e suffix (such as \u003ccode\u003ekimi-k2.6:cloud\u003c/code\u003e or \u003ccode\u003edeepseek-v4-pro:cloud\u003c/code\u003e). Run \u003ccode\u003eollama signin\u003c/code\u003e once, then call them like any local model. Every cloud request needs an internet connection.\u003c/p\u003e\n\u003cp\u003eOllama Cloud suits models too large for your hardware and fast inference without GPU management. Local models never send data off your machine. Ollama Cloud requests go to Ollama\u0026#39;s servers, which run primarily in the US and Europe, plus Singapore for a limited set of Qwen models. Ollama says it retains no data and does not log or train on prompts.\u003c/p\u003e\n\u003cdiv class=\"Post-module__zd2qRG__tableScroll\"\u003e\u003ctable\u003e\n  \u003cthead\u003e\n    \u003ctr\u003e\n      \u003cth style=\"text-align:left;\"\u003e\u003c/th\u003e\n      \u003cth style=\"text-align:left;\"\u003eOllama Local\u003c/th\u003e\n      \u003cth style=\"text-align:left;\"\u003eOllama Cloud\u003c/th\u003e\n      \u003cth style=\"text-align:left;\"\u003eThunder Compute\u003c/th\u003e\n    \u003c/tr\u003e\n  \u003c/thead\u003e\n  \u003ctbody\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eWhere It Runs\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eYour machine\u003c/td\u003e\n      \u003ctd\u003eOllama's servers\u003c/td\u003e\n      \u003ctd\u003eA GPU instance you control\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eCost\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eFree\u003c/td\u003e\n      \u003ctd\u003eFree tier, then $20-$500/mo plus per-token overage\u003c/td\u003e\n      \u003ctd\u003eStarting at $0.35/hr and billed per-minute\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eModel Size Limit\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eYour VRAM and RAM\u003c/td\u003e\n      \u003ctd\u003eOllama's cloud catalog\u003c/td\u003e\n      \u003ctd\u003eUp to 640GB of VRAM on 8x GPU instances\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eData\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eNever leaves your machine\u003c/td\u003e\n      \u003ctd\u003eSent to Ollama, not retained\u003c/td\u003e\n      \u003ctd\u003eStays on your instance\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eInternet\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eOnly to download models\u003c/td\u003e\n      \u003ctd\u003eRequired for every request\u003c/td\u003e\n      \u003ctd\u003eRequired to connect\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003cstrong\u003eSetup\u003c/strong\u003e\u003c/td\u003e\n      \u003ctd\u003eInstall Ollama and models\u003c/td\u003e\n      \u003ctd\u003eSign in\u003c/td\u003e\n      \u003ctd\u003eLaunch the Ollama template, download models to the instance\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003ch3\u003eThe \u003ccode\u003eollama launch\u003c/code\u003e Command\u003c/h3\u003e\n\u003cp\u003e\u003ccode\u003eollama launch\u003c/code\u003e starts a coding agent in one command, with Ollama as the model backend:\u003c/p\u003e\n\u003cpre\u003e\u003ccode class=\"language-bash\"\u003eollama launch claude\nollama launch codex-app\nollama launch opencode\nollama launch openclaw\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003e\u003ccode\u003eollama launch\u003c/code\u003e differs from \u003ccode\u003eollama run\u003c/code\u003e in scope. \u003ccode\u003eollama run\u003c/code\u003e opens a chat with a single model. \u003ccode\u003eollama launch\u003c/code\u003e starts an agent such as Claude Code, Codex, OpenCode (an open-source coding agent) or OpenClaw (an open-source personal AI assistant) on top of the model. Both commands work with local and cloud models.\u003c/p\u003e\n\u003ch2\u003eOllama System Requirements\u003c/h2\u003e\n\u003cp\u003eOllama\u0026#39;s hardware requirements vary significantly based on the model you run and its precision.\u003c/p\u003e\n\u003ch3\u003eModel Parameters\u003c/h3\u003e\n\u003cblockquote\u003e\n\u003cp\u003e\u003cstrong\u003eParameters\u003c/strong\u003e: numerical values a model learns during training.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003cp\u003eA model\u0026#39;s name states its parameter count (7B, 13B, 70B). More parameters usually mean more capable responses and higher memory requirements. All parameters must load into VRAM or system RAM when a model runs.\u003c/p\u003e\n\u003ch3\u003eChoosing a Precision: FP16, Q8 or Q4\u003c/h3\u003e\n\u003cp\u003eMost default Ollama tags, like \u003ccode\u003ellama3.1:8b\u003c/code\u003e, are 4-bit (Q4_K_M) builds sized to fit laptops and 8GB GPUs. This 4-bit default favors convenience over quality.\u003c/p\u003e\n\u003cp\u003eQ8 is the best balance for most Ollama workloads. \u003ca href=\"https://arxiv.org/html/2411.02355v4\" target=\"_blank\" rel=\"noopener\"\u003e8-bit quantization\u003c/a\u003e halves memory use with minimal quality loss compared with full precision. FP16 delivers full quality and fits cases where outputs must match the original model, such as evaluation baselines or fine-tune comparisons.\u003c/p\u003e\n\u003cp\u003eQ4 cuts memory to roughly a third of FP16, but quality loss grows on \u003ca href=\"https://arxiv.org/html/2504.04823v1\" target=\"_blank\" rel=\"noopener\"\u003esmaller models, reasoning-heavy work\u003c/a\u003e, and \u003ca href=\"https://arxiv.org/html/2505.20276v3\" target=\"_blank\" rel=\"noopener\"\u003elong-context tasks\u003c/a\u003e. Studies show the largest quality drops in those cases. Use Q4 only when nothing else fits.\u003c/p\u003e\n\u003cp\u003eTo choose a precision, run a model\u0026#39;s full tag instead of the default. Each Ollama model page lists available builds in its Tags tab:\u003c/p\u003e\n\u003cpre\u003e\u003ccode class=\"language-bash\"\u003eollama run llama3.1:8b-instruct-q8_0    # 8-bit\nollama run llama3.1:8b-instruct-fp16    # full precision\n\u003c/code\u003e\u003c/pre\u003e\n\u003ch3\u003eVRAM Requirements by Model Size\u003c/h3\u003e\n\u003cp\u003eFP16 needs about 2GB of VRAM per 1B parameters, and Q8 needs about 1GB. Add 10-20% for the context window (KV cache). Q4 needs roughly half the Q8 figure.\u003c/p\u003e\n\u003cdiv class=\"Post-module__zd2qRG__tableScroll\"\u003e\u003ctable\u003e\n  \u003cthead\u003e\n    \u003ctr\u003e\n      \u003cth style=\"text-align:left;\"\u003eModel Size\u003c/th\u003e\n      \u003cth style=\"text-align:left;\"\u003eExample Tags\u003c/th\u003e\n      \u003cth style=\"text-align:center;\"\u003eFP16 VRAM\u003c/th\u003e\n      \u003cth style=\"text-align:center;\"\u003eQ8 VRAM\u003c/th\u003e\n    \u003c/tr\u003e\n  \u003c/thead\u003e\n  \u003ctbody\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e3B-4B\u003c/td\u003e\n      \u003ctd\u003ellama3.2:3b, qwen3:4b\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e7-10GB\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e4-6GB\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e7B-8B\u003c/td\u003e\n      \u003ctd\u003ellama3.1:8b, qwen3:8b\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e16-19GB\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e9-11GB\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e12B-14B\u003c/td\u003e\n      \u003ctd\u003egemma3:12b, qwen3:14b\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e27-33GB\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e14-18GB\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e27B-32B\u003c/td\u003e\n      \u003ctd\u003egemma3:27b, qwen3:32b\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e60-75GB\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e30-38GB\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e70B\u003c/td\u003e\n      \u003ctd\u003ellama3.3:70b\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e145-160GB\u003c/td\u003e\n      \u003ctd style=\"text-align:center;\"\u003e75-85GB\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003ch3\u003eWhy VRAM Is King for AI\u003c/h3\u003e\n\u003cp\u003e\u003ca href=\"https://intuitionlabs.ai/articles/hbm-vs-ddr-memory-comparison\" target=\"_blank\" rel=\"noopener\"\u003eSystem RAM transfers data at 20-70GB/s, whereas VRAM moves data at 350-4,800GB/s.\u003c/a\u003e That bandwidth gap makes GPU inference much faster than CPU inference.\u003c/p\u003e\n\u003cp\u003eWhen a model exceeds VRAM, Ollama offloads the remaining layers to system RAM. Offloading prevents a crash but sharply cuts tokens/second.\u003c/p\u003e\n\u003cp\u003eRun \u003ccode\u003eollama ps\u003c/code\u003e while a model is loaded to check its placement. A reading of 100% GPU means the whole model fits in VRAM.\u003c/p\u003e\n\u003cblockquote\u003e\n\u003cp\u003eCompare GPUs by workload and budget in the \u003ca href=\"/blog/best-gpu-for-llm\"\u003eThunder Compute guide to the best GPU for LLM work\u003c/a\u003e.\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003ch3\u003eHow Much Disk Space Does Ollama Need?\u003c/h3\u003e\n\u003cp\u003eThe Ollama installer is small: about 190 MB on macOS and 1.5GB on Windows. Models take far more space. An 8B model needs about 5GB at Q4, 8.5GB at Q8 and \u003ca href=\"https://ollama.com/library/llama3.1:8b-instruct-fp16\" target=\"_blank\" rel=\"noopener\"\u003e16GB at FP16\u003c/a\u003e. 70B models range from \u003ca href=\"https://computingforgeeks.com/ollama-models-cheat-sheet/\" target=\"_blank\" rel=\"noopener\"\u003eabout 43GB at Q4\u003c/a\u003e to over 140GB at FP16.\u003c/p\u003e\n\u003ch2\u003eAvailable Models on Ollama\u003c/h2\u003e\n\u003cp\u003e\u003cimg src=\"/blog/images/69362a66cc1ed4f4a831b9d3_6903a779a61f2561fa15b9af_7h2MgQYtBantu7ub5gLfF7OlkXQ.png\" alt=\"List of language models available through Ollama.\"\u003e\u003c/p\u003e\n\u003cp\u003eOllama\u0026#39;s model library spans lightweight assistants to frontier reasoning models.\u003c/p\u003e\n\u003cdiv class=\"Post-module__zd2qRG__tableScroll\"\u003e\u003ctable\u003e\n\u003cthead\u003e\n\u003ctr\u003e\n\u003cth\u003eModel Family\u003c/th\u003e\n\u003cth\u003eBest For\u003c/th\u003e\n\u003cth\u003eParameter Sizes\u003c/th\u003e\n\u003cth\u003eKey Features\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody\u003e\u003ctr\u003e\n\u003ctd\u003eDeepSeek R1\u003c/td\u003e\n\u003ctd\u003eComplex reasoning, math\u003c/td\u003e\n\u003ctd\u003e1.5B-671B\u003c/td\u003e\n\u003ctd\u003eChain-of-thought reasoning\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eLlama 4\u003c/td\u003e\n\u003ctd\u003eGeneral conversation, multimodal\u003c/td\u003e\n\u003ctd\u003eScout 109B, Maverick 400B\u003c/td\u003e\n\u003ctd\u003eMeta\u0026#39;s latest open-weight MoE models\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eMistral\u003c/td\u003e\n\u003ctd\u003eFast performance, balanced tasks\u003c/td\u003e\n\u003ctd\u003e7B-22B\u003c/td\u003e\n\u003ctd\u003eOptimized for speed and accuracy\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eGemma 3\u003c/td\u003e\n\u003ctd\u003eLightweight applications\u003c/td\u003e\n\u003ctd\u003e1B-27B\u003c/td\u003e\n\u003ctd\u003eGoogle\u0026#39;s efficient models (Gemma 4 also available)\u003c/td\u003e\n\u003c/tr\u003e\n\u003ctr\u003e\n\u003ctd\u003eKimi K2\u003c/td\u003e\n\u003ctd\u003eCoding, agentic tasks\u003c/td\u003e\n\u003ctd\u003e1T (32B active)\u003c/td\u003e\n\u003ctd\u003eOpen-weight coding and agent model\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\u003c/table\u003e\u003c/div\u003e\n\u003cp\u003eThunder Compute has step-by-step guides for running large open models with Ollama:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ca href=\"/blog/deepseek-r1-ollama\"\u003eHow to run DeepSeek R1 with Ollama\u003c/a\u003e: the full 671B reasoning model on cloud GPUs\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/blog/kimi-k2-ollama\"\u003eHow to run Kimi K2 with Ollama\u003c/a\u003e: Moonshot AI\u0026#39;s 1T-parameter open-weight coding model\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/blog/llama-4-ai-model-ollama\"\u003eHow to run Llama 4 with Ollama\u003c/a\u003e: Scout and Maverick, Meta\u0026#39;s multimodal MoE family\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2\u003eOllama vs LM Studio vs llama.cpp vs vLLM\u003c/h2\u003e\n\u003cp\u003eOllama, LM Studio, llama.cpp and vLLM all run open models, and each fits a different job.\u003c/p\u003e\n\u003cdiv class=\"Post-module__zd2qRG__tableScroll\"\u003e\u003ctable\u003e\n  \u003cthead\u003e\n    \u003ctr\u003e\n      \u003cth\u003eTool\u003c/th\u003e\n      \u003cth\u003eInterface\u003c/th\u003e\n      \u003cth\u003eLicense\u003c/th\u003e\n      \u003cth\u003eModel Formats\u003c/th\u003e\n      \u003cth\u003eBest For\u003c/th\u003e\n    \u003c/tr\u003e\n  \u003c/thead\u003e\n  \u003ctbody\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003ca href=\"https://docs.ollama.com\" target=\"_blank\" rel=\"noopener\"\u003eOllama\u003c/a\u003e\u003c/td\u003e\n      \u003ctd\u003eCLI, API, desktop app\u003c/td\u003e\n      \u003ctd\u003eMIT\u003c/td\u003e\n      \u003ctd\u003eGGUF, plus Safetensors import\u003c/td\u003e\n      \u003ctd\u003eLocal development and simple self-hosting\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003ca href=\"https://lmstudio.ai/\" target=\"_blank\" rel=\"noopener\"\u003eLM Studio\u003c/a\u003e\u003c/td\u003e\n      \u003ctd\u003eDesktop GUI, local API server\u003c/td\u003e\n      \u003ctd\u003eProprietary (free)\u003c/td\u003e\n      \u003ctd\u003eGGUF, MLX on Apple Silicon\u003c/td\u003e\n      \u003ctd\u003eBrowsing and testing models in a visual interface\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003ca href=\"https://github.com/ggml-org/llama.cpp\" target=\"_blank\" rel=\"noopener\"\u003ellama.cpp\u003c/a\u003e\u003c/td\u003e\n      \u003ctd\u003eCLI, C/C++ library, llama-server\u003c/td\u003e\n      \u003ctd\u003eMIT\u003c/td\u003e\n      \u003ctd\u003eGGUF\u003c/td\u003e\n      \u003ctd\u003eMaximum control over inference settings\u003c/td\u003e\n    \u003c/tr\u003e\n    \u003ctr\u003e\n      \u003ctd\u003e\u003ca href=\"https://docs.vllm.ai/\" target=\"_blank\" rel=\"noopener\"\u003evLLM\u003c/a\u003e\u003c/td\u003e\n      \u003ctd\u003ePython library, OpenAI-compatible server\u003c/td\u003e\n      \u003ctd\u003eApache 2.0\u003c/td\u003e\n      \u003ctd\u003eHugging Face safetensors, GPTQ, AWQ\u003c/td\u003e\n      \u003ctd\u003eHigh-throughput production serving on GPUs\u003c/td\u003e\n    \u003c/tr\u003e\n  \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003ch2\u003eUse Cases and Applications\u003c/h2\u003e\n\u003cp\u003eOllama supports development, business and education use cases.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eDevelopment:\u003c/strong\u003e Developers use Ollama for code completion, programming assistance, document analysis and research on proprietary datasets. Local models carry no API costs or rate limits.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eBusiness Applications:\u003c/strong\u003e Regulated industries benefit most from local deployment, because Ollama keeps inference on infrastructure they control. Customer service chatbots, internal knowledge-base search, content generation and legal document analysis all run without exposing data to third-party servers.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eEducation:\u003c/strong\u003e Schools and universities can use Ollama to avoid ongoing cloud costs for teaching AI concepts, student projects and academic research.\u003c/p\u003e\n\u003ch2\u003eWhy Run Ollama in the Cloud?\u003c/h2\u003e\n\u003cp\u003eCloud GPUs remove the trade-off between model size and quality that local hardware forces. An 8GB GPU runs an 8B model at Q4, but not a 32B model at Q8 or an 8B model at FP16. Closing that gap with owned hardware is expensive: \u003ca href=\"https://www.thundercompute.com/blog/nvidia-h100-pricing\" target=\"_blank\"\u003ean NVIDIA H100 runs from around $25K\u003c/a\u003e and \u003ca href=\"https://www.thundercompute.com/blog/nvidia-rtx-pro-6000-pricing\" target=\"_blank\"\u003ea dedicated RTX PRO 6000 around $13.25K\u003c/a\u003e as of June 2026.\u003c/p\u003e\n\u003cp\u003eThunder Compute offers a pre-configured Ollama template on the RTX A6000, NVIDIA A100 and NVIDIA H100, billed per minute with no upfront cost. A 48GB RTX A6000 runs a 32B model at Q8 or a 14B model at FP16. Prompts stay on an instance you control instead of going to a third-party API.\u003c/p\u003e\n\u003ch2\u003eStep-by-Step: Running Ollama on Thunder Compute\u003c/h2\u003e\n\u003cp\u003eThunder Compute\u0026#39;s one-click Ollama template installs NVIDIA drivers and CUDA automatically, with nothing to configure.\u003c/p\u003e\n\u003ch3\u003eStep 1: Create a GPU Instance\u003c/h3\u003e\n\u003cp\u003eCreate a Thunder Compute instance with this configuration:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eGPU:\u003c/strong\u003e NVIDIA RTX A6000*\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSize:\u003c/strong\u003e 6 vCPUs (48GB RAM)*\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eTemplate:\u003c/strong\u003e Ollama\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eDisk:\u003c/strong\u003e 100GB\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003cem\u003e*Adjust GPU and disk based on the model and precision you plan to run.\u003c/em\u003e\u003c/p\u003e\n\u003cp\u003eThe Ollama template ships with Ubuntu 22.04, NVIDIA drivers and the Ollama binary.\u003c/p\u003e\n\u003ch3\u003eStep 2: Connect\u003c/h3\u003e\n\u003cp\u003eConnect to the live instance with the \u003ca href=\"https://www.thundercompute.com/docs/vscode/quickstart\" target=\"_blank\"\u003eThunder Compute extension for VS Code or Cursor\u003c/a\u003e, or with your OS\u0026#39;s CLI.\u003c/p\u003e\n\u003ch3\u003eStep 3: Start Ollama\u003c/h3\u003e\n\u003cp\u003eRun \u003ccode\u003estart-ollama\u003c/code\u003e to launch Open WebUI. The command returns a link to the Open WebUI interface.\u003c/p\u003e\n\u003ch3\u003eStep 4: Add a Model\u003c/h3\u003e\n\u003cp\u003eThe Ollama template ships with no models pre-installed.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eHead over to the \u003ca href=\"https://ollama.com/search\" rel=\"noopener\" target=\"_blank\"\u003eOllama Models\u003c/a\u003e page.\u003c/li\u003e\n\u003cli\u003eSelect a model.\u003c/li\u003e\n\u003cli\u003eGo back to Open WebUI.\u003c/li\u003e\n\u003cli\u003eClick \u003cstrong\u003eSelect a model\u003c/strong\u003e.\u003c/li\u003e\n\u003cli\u003eType the model name to begin the download.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eDownload time depends on model size.\u003c/p\u003e\n\u003ch3\u003eStep 5: Start Chatting\u003c/h3\u003e\n\u003cp\u003eThe model is now live. Send it a complex prompt, ask it to write a Python script or use it to analyze a dataset.\u003c/p\u003e\n\u003ch2\u003eLast Thoughts on Ollama\u003c/h2\u003e\n\u003cp\u003eOllama runs capable open models on your own machine for free, with an optional cloud tier for larger models. Start locally for full control over your data and models. When your hardware runs out, \u003ca href=\"https://www.thundercompute.com/products/instances\"\u003elaunch the Ollama template on Thunder Compute\u003c/a\u003e. A 48GB RTX A6000 costs $0.35/hr, billed by the minute.\u003c/p\u003e\n\u003ch2\u003eFAQ\u003c/h2\u003e\n\u003cdetails style=\"margin-bottom: 20px;\"\u003e\n\u003csummary style=\"display: list-item; cursor: pointer;\"\u003e\u003ch3 style=\"display: inline;\"\u003eIs Ollama free?\u003c/h3\u003e\u003c/summary\u003e\n\n\u003cp\u003eYes. Ollama is free, open source and unlimited on your own hardware. Ollama Cloud has a free tier, then Pro ($20/mo), Max ($100/mo) and Team ($500/mo) plans with monthly usage credits. Thunder Compute rents a 48GB RTX A6000 for $0.35/hr.\u003c/p\u003e\n\u003c/details\u003e\n\n\u003cdetails style=\"margin-bottom: 20px;\"\u003e\n\u003csummary style=\"display: list-item; cursor: pointer;\"\u003e\u003ch3 style=\"display: inline;\"\u003eWhat is Ollama Cloud?\u003c/h3\u003e\u003c/summary\u003e\n\n\u003cp\u003eOllama Cloud runs models on Ollama\u0026#39;s servers instead of your GPU, through the same CLI and API as local Ollama. Cloud models use a :cloud tag suffix, such as kimi-k2.6:cloud. Run ollama signin once; every request needs an internet connection.\u003c/p\u003e\n\u003c/details\u003e\n\n\u003cdetails style=\"margin-bottom: 20px;\"\u003e\n\u003csummary style=\"display: list-item; cursor: pointer;\"\u003e\u003ch3 style=\"display: inline;\"\u003eIs Ollama safe to use?\u003c/h3\u003e\u003c/summary\u003e\n\n\u003cp\u003eYes, when installed from ollama.com or the official GitHub releases. Its API listens only on localhost by default and has no built-in authentication. Never expose port 11434 to the internet without a reverse proxy, VPN or SSH tunnel.\u003c/p\u003e\n\u003c/details\u003e\n\n\u003cdetails style=\"margin-bottom: 20px;\"\u003e\n\u003csummary style=\"display: list-item; cursor: pointer;\"\u003e\u003ch3 style=\"display: inline;\"\u003eWhat hardware do I need to run Ollama?\u003c/h3\u003e\u003c/summary\u003e\n\n\u003cp\u003eYou need a GPU with enough VRAM for your model\u0026#39;s precision: about 2GB per 1B parameters at FP16 and 1GB at Q8, plus context. An 8B model at Q8 fits a 12GB GPU. A 32B model at Q8 needs 30-38GB, usually a 48GB cloud GPU.\u003c/p\u003e\n\u003c/details\u003e\n\n\u003cdetails style=\"margin-bottom: 20px;\"\u003e\n\u003csummary style=\"display: list-item; cursor: pointer;\"\u003e\u003ch3 style=\"display: inline;\"\u003eCan I use Ollama without a GPU?\u003c/h3\u003e\u003c/summary\u003e\n\n\u003cp\u003eYes. Ollama supports CPU-only execution, but generation is much slower than on a GPU, especially for models above 7B. Use a dedicated GPU for anything beyond light testing.\u003c/p\u003e\n\u003c/details\u003e\n\n\u003cdetails style=\"margin-bottom: 20px;\"\u003e\n\u003csummary style=\"display: list-item; cursor: pointer;\"\u003e\u003ch3 style=\"display: inline;\"\u003eWhen should I move from local Ollama to cloud infrastructure?\u003c/h3\u003e\u003c/summary\u003e\n\n\u003cp\u003eMove to the cloud when local hardware can\u0026#39;t fit the model or precision you need. Cloud GPUs also suit consistent production performance and shared team access to GPU resources.\u003c/p\u003e\n\u003c/details\u003e"])</script><script>self.__next_f.push([1,"35:[\"$\",\"section\",null,{\"className\":\"Doc-module__gMlsRq__section\",\"children\":[\"$\",\"div\",null,{\"className\":\"Doc-module__gMlsRq__column\",\"children\":[\"$\",\"article\",null,{\"itemScope\":true,\"itemType\":\"https://schema.org/BlogPosting\",\"children\":[[\"$\",\"header\",null,{\"className\":\"Doc-module__gMlsRq__header\",\"children\":[[\"$\",\"$L1b\",null,{\"href\":\"/blog\",\"className\":\"Doc-module__gMlsRq__back\",\"children\":[\"← \",\"All writing\"]}],[\"$\",\"h1\",null,{\"className\":\"Doc-module__gMlsRq__title Doc-module__gMlsRq__md\",\"children\":[\"$\",\"span\",null,{\"itemProp\":\"headline\",\"children\":\"What is Ollama? Complete Guide to Local AI Models (October 2026)\"}]}],[\"$\",\"p\",null,{\"className\":\"Doc-module__gMlsRq__meta\",\"children\":\"Carl Peterson  ·  October 17, 2025  ·  16 min read\"}],null,\"$undefined\"]}],[\"$\",\"p\",null,{\"hidden\":true,\"children\":\"Ollama is a free, open-source (MIT) tool for running LLMs like Llama, Qwen and DeepSeek locally. See what's free, Ollama Cloud pricing and hardware needs.\"}],[\"$\",\"div\",null,{\"className\":\"Doc-module__gMlsRq__body Doc-module__gMlsRq__prose\",\"children\":[\"$\",\"div\",null,{\"className\":\"Post-module__zd2qRG__content\",\"itemProp\":\"articleBody\",\"dangerouslySetInnerHTML\":{\"__html\":\"$37\"}}]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"36:[\"$\",\"footer\",null,