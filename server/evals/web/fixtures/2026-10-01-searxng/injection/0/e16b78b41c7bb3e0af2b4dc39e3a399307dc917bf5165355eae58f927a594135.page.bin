</section><section data-mw-section-id="26" id="mwBEA" aria-labelledby="(2)_Brooklyn_Nets_vs._(3)_Milwaukee_Bucks"><div class="mw-heading mw-heading4"><h4 id="(2)_Brooklyn_Nets_vs._(3)_Milwaukee_Bucks"><span id=".282.29_Brooklyn_Nets_vs._.283.29_Milwaukee_Bucks" typeof="mw:FallbackId"></span>(2) Brooklyn Nets vs. (3) Milwaukee Bucks</h4><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2021_NBA_playoffs&amp;action=edit&amp;section=26" title="Edit section: (2) Brooklyn Nets vs. (3) Milwaukee Bucks"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<div style="clear:both;" class="" about="#mwt260" typeof="mw:Transclusion" id="mwBEE" data-mw='{"parts":[{"template":{"target":{"wt":"Basketballbox","href":"./Template:Basketballbox"},"params":{"bg":{"wt":"#eee"},"date":{"wt":"June 5"},"time":{"wt":"7:30pm"},"place":{"wt":"[[Barclays Center]], [[Brooklyn|Brooklyn, New York City]]"},"TV":{"wt":"[[NBA on TNT|TNT]]"},"team1":{"wt":"[[Milwaukee Bucks]]"},"score1":{"wt":"107"},"team2":{"wt":"&apos;&apos;&apos;[[Brooklyn Nets]]&apos;&apos;&apos;"},"score2":{"wt":"&apos;&apos;&apos;115&apos;&apos;&apos;"},"report":{"wt":"[https://www.nba.com/game/mil-vs-bkn-0042000211 Recap]"},"Q1":{"wt":"&apos;&apos;&apos;32&apos;&apos;&apos;–30"},"Q2":{"wt":"29–&apos;&apos;&apos;33&apos;&apos;&apos;"},"Q3":{"wt":"23–&apos;&apos;&apos;35&apos;&apos;&apos;"},"Q4":{"wt":"&apos;&apos;&apos;23&apos;&apos;&apos;–17"},"points1":{"wt":"[[Giannis Antetokounmpo]] 34"},"points2":{"wt":"[[Kevin Durant]] 29"},"rebounds1":{"wt":"[[Khris Middleton]] 13"},"rebounds2":{"wt":"[[Blake Griffin]] 14"},"assist1":{"wt":"[[Jrue Holiday]] 6"},"assist2":{"wt":"[[Kyrie Irving]] 8"},"attendance":{"wt":"15,750"},"referee":{"wt":"David Guthrie, [[Bill Kennedy (referee)|Bill Kennedy]], Mark Lindsay"},"series":{"wt":"Brooklyn leads series, 1–0"}},"i":0}}]}'></div><div style="width: 100%; background-color:#eee; color:#202122;" about="#mwt260" id="mwBEI">
