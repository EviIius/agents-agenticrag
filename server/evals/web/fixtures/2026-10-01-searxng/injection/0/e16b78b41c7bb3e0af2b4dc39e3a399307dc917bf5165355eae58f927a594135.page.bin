<div style="clear:both;" class="" about="#mwt273" typeof="mw:Transclusion" id="mwBG8" data-mw='{"parts":[{"template":{"target":{"wt":"basketballbox\n","href":"./Template:Basketballbox"},"params":{"bg":{"wt":"#fff"},"1":{"wt":" \n"},"date":{"wt":"1984"},"team1":{"wt":"&apos;&apos;&apos;[[Milwaukee Bucks]]&apos;&apos;&apos;"},"score1":{"wt":"4"},"team2":{"wt":"[[Brooklyn Nets|New Jersey Nets]]"},"score2":{"wt":"2"},"place":{"wt":"[[1984 NBA playoffs|1984 Eastern Conference semifinals]]"}},"i":0}}]}'></div><div style="width: 100%; background-color:#fff; color:#202122;" about="#mwt273" id="mwBHA">

