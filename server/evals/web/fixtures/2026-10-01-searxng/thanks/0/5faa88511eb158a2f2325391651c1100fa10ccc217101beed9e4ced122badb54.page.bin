			</div>
		</div>

		<div id='highlights-carousel-app-2b26807a-a367-4732-b554-9d3a77a599d5' data-cq-model='{&#34;title&#34;:&#34;Top things to do in Canberra&#34;,&#34;componentUUID&#34;:&#34;2b26807a-a367-4732-b554-9d3a77a599d5&#34;,&#34;highlights&#34;:[{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1437560444/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1437560444/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Lake Burley Griffin, Australian Capital Territory © Tourism Australia&#34;,&#34;text&#34;:&#34;\u003cp\u003eTake a walk or cycle around the shore, drift along in a kayak, boat or stand-up paddleboard, or just enjoy the view from a lakeside café. There’s plenty to do here. Check out all the \u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/lake-burley-griffin.html\&#34; target\u003d\&#34;_self\&#34;\u003eactivities for exploring the lake\u003c/a\u003e, both on and off the water. \u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/lake-burley-griffin.html&#34;,&#34;title&#34;:&#34;Spend the day on Lake Burley Griffin &#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/assets/photograph/digital/1/6/v/z/w/2001020.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_389105358/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;50ff2d06-dbf3-463e-9e6b-ed822804c455&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_389105358/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Hike to Gibraltar Peak at Tidbinbilla Nature Reserve © Richard Poulton&#34;,&#34;text&#34;:&#34;\u003cp\u003eIn under an hour you can trade the city for the lush snow gum forests and sprawling valleys of \u003ca href\u003d\&#34;https://www.tidbinbilla.act.gov.au/home\&#34; target\u003d\&#34;_blank\&#34;\u003eTidbinbilla Nature Reserve\u003c/a\u003e. Home to a range of wildlife and adventure experiences, you may want to spend a few nights experiencing this natural haven.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://www.tidbinbilla.act.gov.au/home&#34;,&#34;title&#34;:&#34;Get back to nature at Tidbinbilla&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;#tidbinbilla-reserve&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/australian-capital-territory/australian-alps/tidbinbilla-nature-reserve/hike-gibraltar-peak-act.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1567278651/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;b5e9a182-607a-430c-9d2f-4c8d041295ec&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1567278651/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Woman enjoying the National Gallery of Australia in Canberra © Tourism Australia &#34;,&#34;text&#34;:&#34;\u003cp\u003eExplore\u0026nbsp;Aboriginal\u0026nbsp;artworks, see international exhibitions, stroll\u0026nbsp;through\u0026nbsp;a garden dotted with original sculptures and see\u0026nbsp;portraits of famous personalities. You won\u0027t regret an afternoon lost in\u0026nbsp;\u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/best-museums-art-galleries-and-theatres.html\&#34; target\u003d\&#34;_self\&#34;\u003eCanberra’s museums and galleries\u003c/a\u003e.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/best-museums-art-galleries-and-theatres.html&#34;,&#34;title&#34;:&#34;Explore galleries and museums &#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/assets/photograph/digital/1/c/0/p/0/2240388.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_490007723/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;78de50ae-edc5-46e9-911f-e5f3982f769f&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_490007723/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Family sledding at Corin Forest near Canberra © Damian Breach Photography&#34;,&#34;text&#34;:&#34;\u003cp\u003eCanberra is the ideal family destination. From kid-friendly ski slopes to a museum dedicated to dinosaurs, your little ones will never get bored on a trip to the national capital. Check out the \u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/with-kids.html\&#34; target\u003d\&#34;_self\&#34;\u003ebest activities for families\u003c/a\u003e near Canberra.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/with-kids.html&#34;,&#34;title&#34;:&#34;Keep the kids entertained&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/global/images/australian-capital-territory/australian-alps/Corin Forest.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;febcb21f-3dd0-40bb-a83f-6eb2a13741e0&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Friends at Brindabella Hills Winery in the Canberra District Wine Region © VisitCanberra&#34;,&#34;text&#34;:&#34;\u003cp\u003eThe Canberra Wine District is making an impact with its stellar cool-climate shiraz and riesling. Be sure to visit the stalwarts – but don\u0027t miss the up-and-comers. With more than 140 vineyards and \u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/best-wineries.html\&#34; target\u003d\&#34;_self\&#34;\u003e40 wineries\u003c/a\u003e in the region, here’s where to start.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/best-wineries.html&#34;,&#34;title&#34;:&#34;Taste Canberra’s top drops &#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/australian-capital-territory/canberra/brindabella-hills-winery-canberra-act.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_878233326/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;dfcadbe2-9cd5-4c9b-baba-74b94461393d&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_878233326/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Aboriginal Memorial, National Gallery of Australia, Canberra, ACT © Martin Ollman / Tourism Australia&#34;,&#34;text&#34;:&#34;\u003cp\u003eExplore about the customs and traditions of the Ngunawal people as you uncover historical artefacts and hidden rock art, learn about bush food and traditional stone tools, and hear the stories of the significant sites that you \u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/experience-aboriginal-culture.html\&#34; target\u003d\&#34;_self\&#34;\u003evisit\u003c/a\u003e.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/experience-aboriginal-culture.html&#34;,&#34;title&#34;:&#34;Experience Aboriginal Culture in Canberra&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/australian-capital-territory/canberra/culture-national-gallery-australia-act.JPG&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_123065760/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;fd3e32eb-8512-409b-8a06-acad62404d8b&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_123065760/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Family enjoying a GoBoat in Canberra © GoBoat&#34;,&#34;text&#34;:&#34;\u003cp\u003eRent an electric GoBoat for an afternoon on the calm waters of Lake Burley Griffin. With a built-in picnic table and benches, you\u0027re sure to have the best seat in the house when you \u003ca href\u003d\&#34;https://goboat.com.au/canberra/\&#34; target\u003d\&#34;_blank\&#34;\u003ebook a GoBoat\u003c/a\u003e experience.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://goboat.com.au/canberra/&#34;,&#34;title&#34;:&#34;Skipper a picnic boat&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/goboat-canberra-act.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1617287564/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1617287564/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Family at Parliament House in Canberra © Penny Bradfield&#34;,&#34;text&#34;:&#34;\u003cp\u003eDon’t miss the chance to \u003ca href\u003d\&#34;https://www.aph.gov.au/visit_parliament/tours\&#34; target\u003d\&#34;_blank\&#34;\u003eexplore Parliament House\u003c/a\u003e on a guided tour, admire its modern architecture,\u0026nbsp;wander through its exhibitions and galleries or take a sneak peek at Parliament in session to\u0026nbsp;see Australian democracy in action.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://www.aph.gov.au/visit_parliament/tours&#34;,&#34;title&#34;:&#34;Take a tour at Parliament House &#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/assets/photograph/digital/l/g/q/i/1001466.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_417464799/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;689921ca-c6fe-4ff9-90fb-a7d89bd9fd3f&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_417464799/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Naked Cubby Co, Majura, Australian Capital Territory © Naked Cubby Co/Shan Bawden&#34;,&#34;text&#34;:&#34;\u003cp\u003eNestled among the vines of Mount Majura Vineyard you\u0027ll find the \u003ca href\u003d\&#34;https://nakedcubbycollective.com/\&#34; target\u003d\&#34;_blank\&#34;\u003eNaked Cubby Collective\u003c/a\u003e.\u0026nbsp;Book one of their bell tents and enjoy a secluded nature escape where you can leave it all behind.\u0026nbsp;\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://nakedcubbycollective.com/&#34;,&#34;title&#34;:&#34;Stay in an outdoor hideaway&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/no-wifi-no-worries-majura-act.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_2407/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;f2b7fa28-a00c-46dc-a675-6995ba333a43&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_2407/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Armada Bar, Canberra, ACT © Armada Bar&#34;,&#34;text&#34;:&#34;\u003cp\u003eCanberra is a capital of culture, and these \u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/hidden-gems.html\&#34; target\u003d\&#34;_self\&#34;\u003ehidden gems\u003c/a\u003e prove it. Peruvian food trucks, Chinese-style gardens and wineries that push the boundaries are just the beginning. It’s time to update your bucket list with the city’s best-kept secrets.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/hidden-gems.html&#34;,&#34;title&#34;:&#34;Explore the city’s hidden gems&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/australian-capital-territory/canberra/amanda-bar-canberra-act-109749.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_240775183/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;6b6678e2-b1f5-4bd8-ada9-73170c5e01e2&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_240775183/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Horse riding with Burnelee Excursions in Canberra © VisitCanberra &#34;,&#34;text&#34;:&#34;\u003cp\u003eSurrounded by forests and mountains,\u0026nbsp;the Canberra region is an adventure playground. Mountain-bike\u0026nbsp;down\u0026nbsp;famous trails, hike mountains, raft rivers\u0026nbsp;and hit the snow.\u0026nbsp;Discover all the ways you can experience\u0026nbsp;\u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/canberras-adventurous-side.html\&#34; target\u003d\&#34;_self\&#34;\u003eCanberra’s adventurous side\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/canberras-adventurous-side.html&#34;,&#34;title&#34;:&#34;Get adventurous &#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/global/images/new-south-wales/country-nsw/murrumbateman/Burnelee Excursions on Horseback.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_474679904/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;4de5f371-acf9-456d-9dd0-19c124be8007&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_474679904/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;The Hive, Lonsdale Street, Braddon, ACT © VisitCanberra &#34;,&#34;text&#34;:&#34;\u003cp\u003eThe city’s shopping style is contemporary yet distinctive, taking its cue from the many art institutions and modern architecture and design. With creative boutiques, markets and local designs on offer, find your own sense of \u003ca href\u003d\&#34;/content/australia/en_us/places/canberra-and-surrounds/shopping-in-canberra.html\&#34; target\u003d\&#34;_self\&#34;\u003eCanberra style\u003c/a\u003e.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:false,&#34;itemLink&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/shopping-in-canberra.html&#34;,&#34;title&#34;:&#34;Shop like a local &#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/the-hive-lonsdale-street-braddon-act.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1231918033/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;b7b6bf27-c317-4bc7-affb-3c93f8d51b71&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1231918033/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Hiking in Namadgi National Park near Canberra © VisitCanberra \u0026 Matt Donovan&#34;,&#34;text&#34;:&#34;\u003cp\u003eAn hour\u0027s drive from Canberra will bring you to the remote wilderness of \u003ca href\u003d\&#34;https://www.parks.act.gov.au/find-a-park/namadgi-national-park\&#34; target\u003d\&#34;_blank\&#34;\u003eNamadgi National Park\u003c/a\u003e. Reconnect with the environment on hiking trails that explore forested woods, impressive rock formations and Aboriginal heritage sites.\u0026nbsp;\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://www.parks.act.gov.au/find-a-park/namadgi-national-park&#34;,&#34;title&#34;:&#34;Take a hike in Namadgi National Park&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/global/images/australian-capital-territory/australian-alps/namadgi-national-park/Namadgi National Park 3 credit VisitCanberra \u0026 Matt Donovan.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1974/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;903e46c5-f764-4d74-b6b3-b9d6272ebbc2&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1974/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Hot air balloons in Canberra © EventsACT &#34;,&#34;text&#34;:&#34;\u003cp\u003eCanberra is one of the only places in the world where you can board a \u003ca href\u003d\&#34;https://balloonaloftcanberra.com.au/\&#34; target\u003d\&#34;_blank\&#34;\u003ehot air balloon\u003c/a\u003e and float right over a capital city.\u0026nbsp;Be sure to look\u0026nbsp;out\u0026nbsp;to the\u0026nbsp;rolling mountains to sprawling\u0026nbsp;valleys as you see it all\u0026nbsp;from the bird’s eye point of view.\u0026nbsp;\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://balloonaloftcanberra.com.au/&#34;,&#34;title&#34;:&#34;Soar over the city in a hot air balloon &#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/assets/photograph/digital/1/c/1/c/f/2241231.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1974306151/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;796b7d24-f791-44af-bc37-0d55b4d33e96&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_1974306151/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Truffle hunt, The Truffle Farm, Canberra © Richard Poulton Photography&#34;,&#34;text&#34;:&#34;\u003cp\u003eIn winter, join the friendly truffle dogs for a walk through the oak forests of \u003ca href\u003d\&#34;https://www.thetrufflefarm.com.au/\&#34; target\u003d\&#34;_blank\&#34;\u003eThe Truffle Farm\u003c/a\u003e as they race among 3,000 trees to find the black gold. After, take your prize back to the cosy shed for a decadent degustation paired with local wines.  \u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://www.thetrufflefarm.com.au/&#34;,&#34;title&#34;:&#34;Hunt for black gold&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/assets/photograph/digital/1/c/1/j/l/2241489.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_452417713/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;9ba9d067-8fc0-4f77-9736-7f311f70a72d&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_452417713/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;Alpine River Adventures, Murrumbidgee River, Australian Capital Territory © Alpine River Adventures&#34;,&#34;text&#34;:&#34;\u003cp\u003eReady to escape to the wilderness? Join a Snowy River wilderness expedition to paddle your way through a multi-day kayak adventure. With river views by day and starry skies by night, \u003ca href\u003d\&#34;https://www.riverguide.com.au/\&#34; target\u003d\&#34;_blank\&#34;\u003ethis tour\u003c/a\u003e is made for nature lovers.\u0026nbsp;\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;https://www.riverguide.com.au/&#34;,&#34;title&#34;:&#34;Raft down an alpine river&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/alpine-river-adventures-act.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}},{&#34;imageRenditionPath&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_2053206631/ImageTile/imageHighlightsSrc.adapt.584.medium.jpg&#34;,&#34;imageUUID&#34;:&#34;2c7ad43a-4c8d-4c1d-a653-161b3970d642&#34;,&#34;src&#34;:&#34;/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/imagecontainer/imageContainerParsys/imagehighlights_2053206631/ImageTile/imageHighlightsSrc&#34;,&#34;imageAlt&#34;:&#34;National Botanic Gardens, Canberra, Australian Capital Territory © Tourism Australia&#34;,&#34;text&#34;:&#34;\u003cp\u003eSpend a relaxing day among fragrant native flowers and greenery at the \u003ca href\u003d\&#34;https://www.anbg.gov.au/gardens/\&#34; target\u003d\&#34;_blank\&#34;\u003eAustralian National Botanic Gardens\u003c/a\u003e. Spot adorable local wildlife as you roam at your own pace, or climb aboard the Flora Explorer bus to see the garden highlights.\u003c/p\u003e\r\n&#34;,&#34;externalLink&#34;:true,&#34;itemLink&#34;:&#34;&#34;,&#34;title&#34;:&#34;Wander native gardens&#34;,&#34;sectionAnchor&#34;:&#34;&#34;,&#34;anchorId&#34;:&#34;&#34;,&#34;imagePath&#34;:&#34;/content/dam/digital/australia-com/images/australian-capital-territory/canberra/accessible-lizard-canberra-act.jpg&#34;,&#34;partnerLeads&#34;:[],&#34;componentEventInfo&#34;:{&#34;componentId&#34;:&#34;highlightsCarousel&#34;,&#34;componentName&#34;:&#34;Highlights Carousel&#34;},&#34;attributesEventInfo&#34;:{}}]}'></div>
	



<script>
	var controlsLoad = function () {
		const thisCarousel = $('.imageContainer').find('.carousel');
		thisCarousel.each(function(i,elm) {
			const indicators = $(elm).find('.carousel-indicators');
			const leftArrow = $(elm).find('.carousel-control-prev');
			const rightArrow = $(elm).find('.carousel-control-next');
			const mainContainer = $(elm).find('.carousel-inner');
			const baseContainer = $(elm).find('.carousel-inner .carousel-item.active .ta-image');
			const containerHeight = baseContainer.height();
			const baseLeft = baseContainer.offset().left;
			const baseWidth = baseContainer.width();
			const mainWidth = mainContainer.width();
			if(containerHeight > 0) {
				leftArrow.show().css("top", (containerHeight - leftArrow.height()) / 2).css('left', ((mainWidth-baseWidth)/2)+20);
				rightArrow.show().css("top", (containerHeight - rightArrow.height()) / 2).css('right', ((mainWidth-baseWidth)/2)+20);
				indicators.css("top", (containerHeight - indicators.height() - 20)).css("display", "flex");
			}
		});
	};
	window.onload = controlsLoad;
	window.onresize = function(e) {
		controlsLoad();
	};
</script>
  
</div>
<div class="carousel section">
	<div id="carousel" data-props-path="/content/australia/en_us/places/canberra-and-surrounds/guide-to-canberra/jcr:content/mainParsys/carousel.wishlisting.json" data-showhide-carousel="default" data-wishlist-carousel="false" data-carousel-tabs="false" data-wcm-mode="DISABLED" data-ceddl-component-info='{ &quot;componentId&quot;: &quot;carousel&quot;, &quot;componentName&quot;: &quot;Carousel&quot; }' class="color-ta-original-white no-scroll-bar wishlist-carousel">
        
        <script id="tabsTemplate" type="text/x-handlebars-template"><div class="tabs section wishlist-tabs">
    <div class="cmp-tabs ta-inner-container" data-placeholder-text="false">
        <div class="cmp-tabs__scroll-container">
            <button aria-label="see previous items" class="cmp-tabs__scroll-button previous hide" style="display: none;"></button>
            <div class="cmp-tabs__item-container d-flex">
                <ol role="tablist" class="cmp-tabs__tablist d-flex no-scroll-bar" aria-multiselectable="false">
                    {{#each this}}
                    <li role="tab" class="cmp-tabs__tab" data-path="{{contentPath}}" data-content-fragment-path="{{contentFragment}}" data-content="{{content}}">
                        {{title}}
                    </li>
                    {{/each}}
                </ol>
            </div>
            <button aria-label="see next items" class="cmp-tabs__scroll-button next hide" style="display: none;"></button>
        </div>
    </div>
</div></script>
        <script id="itemsTemplate" type="text/x-handlebars-template">{{#each this}}
<div class="ta-carousel-item">
    {{#if destinationPathWishlistEnabled}}
        <div class="wishlist-icon" data-destination-content-fragment="{{destinationContentFragmentPath}}" data-path="{{link}}">&nbsp;</div>
    {{/if}}
    
     {{#if openInNewTab}}
       <a href="{{link}}" data-destination-fragment-path="{{destinationContentFragmentPath}}" target="_blank">
       {{else}}
        <a href="{{link}}" data-destination-fragment-path="{{destinationContentFragmentPath}}" target="_self">
      {{/if}}
          <img class="ta-image ta-image-small-portrait blur-up lazyload" src="{{imagePreviewPath}}" data-src="{{imagePath}}" alt="{{imageAltText}}" title="{{title}}"/>
        <div class='item-text-wrapper'>
            <h4 class="item-text">
                {{title}}
            </h4>
        </div>
    </a>
</div>
{{/each}}
<div class="ta-carousel-item stump"></div>
</script>
