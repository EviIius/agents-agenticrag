y:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Parliament_House,_Canberra" title="Parliament House, Canberra"><span title="New Parliament House" style="color:white;font-size:88%;font-weight:bold">4</span></a></div></div><div style="position:absolute;left:110px;top:260px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Gallery_of_Australia" title="National Gallery of Australia"><span title="National Gallery" style="color:white;font-size:88%;font-weight:bold">5</span></a></div></div><div style="position:absolute;left:230px;top:275px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/High_Court_of_Australia" title="High Court of Australia"><span title="High Court" style="color:white;font-size:88%;font-weight:bold">6</span></a></div></div><div style="position:absolute;left:540px;top:250px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Questacon" title="Questacon"><span title="Questacon" style="color:white;font-size:88%;font-weight:bold">7</span></a></div></div><div style="position:absolute;left:735px;top:248px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Library_of_Australi