<li about="#cite_note-Frei-16" id="cite_note-Frei-16" data-mw-footnote-number="16"><span class="mw-cite-backlink" id="mwDd4"><a href="#cite_ref-Frei_16-0" rel="mw:referencedBy" id="mwDd8"><span class="mw-linkback-text" id="mwDeA">↑</span></a></span> <span id="mw-reference-text-cite_note-Frei-16" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt94" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDeE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"last":{"wt":"Frei"},"first":{"wt":"Patricia"},"title":{"wt":"Discussion on the Meaning of &apos;Canberra&apos;"},"url":{"wt":"http://www.canberrahistoryweb.com/meaningofcanberra.htm"},"work":{"wt":"Canberra History Web"},"publisher":{"wt":"Patricia Frei"},"access-date":{"wt":"11 August 2013"},"url-status":{"wt":"usurped"},"archive-url":{"wt":"https://web.archive.org/web/20130927182307/http://www.canberrahistoryweb.com/meaningofcanberra.htm"},"archive-date":{"wt":"27 September 2013"}},"i":0}}]}'/><cite id="CITEREFFrei" class="citation web cs1 cs1-prop-unfit" about="#mwt94">Frei, Patricia. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20130927182307/http://www.canberrahistoryweb.com/meaningofcanberra.htm" class="external text" id="mwDeI">"Discussion on the Meaning of 'Canberra'<span class="cs1-kern-right" id="mwDeM"></span>"</a>. <i id="mwDeQ">Canberra History Web</i>. Patricia Frei. Archived from the original on 27 September 2013<span class="reference-accessdate" id="mwDeU">. Retrieved <span class="nowrap" id="mwDeY">11 August</span> 2013</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Canberra+History+Web&amp;rft.atitle=Discussion+on+the+Meaning+of+%27Canberra%27&amp;rft.aulast=Frei&amp;rft.aufirst=Patricia&amp;rft_id=http%3A%2F%2Fwww.canberrahistoryweb.com%2Fmeaningofcanberra.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACanberra" class="Z3988" about="#mwt94" id="mwDec"></span><link rel="mw:PageProp/Category" href="./Category:CS1:_unfit_URL" about="#mwt94" id="mwDeg"/></span></li>
<li about="#cite_note-17" id="cite_note-17" data-mw-footnote-number="17"><span class="mw-cite-backlink" id="mwDek"><a href="#cite_ref-17" rel="mw:referencedBy" id="mwDeo"><span class="mw-linkback-text" id="mwDes">↑</span></a></span> <span id="mw-reference-text-cite_note-17" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt97" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDew" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite book ","href":"./Template:Cite_book"},"params":{"url":{"wt":"http://www.crispinhull.com.au/book-on-canberra/chapter-2-european-settlement-and-the-naming-of-canberra"},"title":{"wt":"Canberra – Australia&apos;s National Capital"},"chapter":{"wt":"European settlement and the naming of Canberra"},"last":{"wt":"Hull"},"first":{"wt":"Crispin"},"date":{"wt":"6 February 2009"},"access-date":{"wt":"7 June 2010"},"publisher":{"wt":"Crispin Hull"},"archive-date":{"wt":"26 April 2010"},"archive-url":{"wt":"https://web.archive.org/web/20100426150348/http://www.crispinhull.com.au/book-on-canberra/chapter-2-european-settlement-and-the-naming-of-canberra/"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFHull2009" class="citation book cs1" about="#mwt97">Hull, Crispin (6 February 2009). "European settlement and the naming of Canberra". <a rel="mw:ExtLink nofollow" href="http://www.crispinhull.com.au/book-on-canberra/chapter-2-european-settlement-and-the-naming-of-canberra" class="external text" id="mwDe0"><i id="mwDe4">Canberra – Australia's National Capital</i></a>. Crispin Hull. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20100426150348/http://www.crispinhull.com.au/book-on-canberra/chapter-2-european-settlement-and-the-naming-of-canberra/" class="external text" id="mwDe8">Archived</a> from the original on 26 April 2010<span class="reference-accessdate" id="mwDfA">. Retrieved <span class="nowrap" id="mwDfE">7 June</span> 2010</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=European+settlement+and+the+naming+of+Canberra&amp;rft.btitle=Canberra+%E2%80%93+Australia%27s+National+Capital&amp;rft.pub=Crispin+Hull&amp;rft.date=2009-02-06&amp;rft.aulast=Hull&amp;rft.aufirst=Crispin&amp;rft_id=http%3A%2F%2Fwww.crispinhull.com.au%2Fbook-on-canberra%2Fchapter-2-european-settlement-and-the-naming-of-canberra&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACanberra" class="Z3988" about="#mwt97" id="mwDfI"></span></span></li>
<li about="#cite_note-18" id="cite_note-18" data-mw-footnote-number="18"><span class="mw-cite-backlink" id="mwDfM"><a href="#cite_ref-18" rel="mw:referencedBy" id="mwDfQ"><span class="mw-linkback-text" id="mwDfU">↑</span></a></span> <span id="mw-reference-text-cite_note-18" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt100" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDfY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://press-files.anu.edu.au/downloads/press/p17331/html/ch05.xhtml?referer=xxx&amp;page=13"},"title":{"wt":"The methodology of reconstructing Indigenous placenames: Australian Capital Territory and south-eastern New South Wales"},"first":{"wt":"Harold"},"last":{"wt":"Koch"},"date":{"wt":"2009"},"work":{"wt":"Aboriginal Placenames: Naming and Renaming the Australian Landscape"},"publisher":{"wt":"ANU E Press and Aboriginal History Incorporated"},"quote":{"wt":"The other widely known theory is that the name meant ‘breasts’. John Gale was told at Andrew Cunningham’s funeral at Lanyon in 1887 by Rev. Canon Champion of Bungendore that a very old swagman familiar with the area had heard from the blacks “that the English equivalent for Canberra was ‘a woman’s breasts’”; this was suggested by the two hills Mr Ainslie and Black Mountain... Gale’s reported meaning ‘breast’ may contain an oblique reference to a mythological story, since body parts do often figure in Aboriginal myth-based toponymy. Nevertheless the story, if there was one, remains irrecoverable."}},"i":0}}]}'/><cite id="mwDfc" class="citation web cs1" about="#mwt100" data-x-id="CITEREFKoch2009">Koch, Harold (2009). <a rel="mw:ExtLink nofollow" href="https://press-files.anu.edu.au/downloads/press/p17331/html/ch05.xhtml?referer=xxx&amp;page=13" class="external text" id="mwDfg">"The methodology of reconstructing Indigenous placenames: Australian Capital Territory and south-eastern New South Wales"</a>. <i id="mwDfk">Aboriginal Placenames: Naming and Renaming the Australian Landscape</i>. ANU E Press and Aboriginal History Incorporated. <q id="mwDfo">The other widely known theory is that the name meant 'breasts'. John Gale was told at Andrew Cunningham's funeral at Lanyon in 1887 by Rev. Canon Champion of Bungendore that a very old swagman familiar with the area had heard from the blacks "that the English equivalent for Canberra was 'a woman's breasts'"; this was suggested by the two hills Mr Ainslie and Black Mountain... Gale's reported meaning 'breast' may contain an oblique reference to a mythological story, since body parts do often figure in Aboriginal myth-based toponymy. Nevertheless the story, if there was one, remains irrecoverable.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Aboriginal+Placenames%3A+Naming+and+Renaming+the+Australian+Landscape&amp;rft.atitle=The+methodology+of+reconstructing+Indigenous+placenames%3A+Australian+Capital+Territory+and+south-eastern+New+South+Wales&amp;rft.date=2009&amp;rft.aulast=Koch&amp;rft.aufirst=Harold&amp;rft_id=https%3A%2F%2Fpress-files.anu.edu.au%2Fdownloads%2Fpress%2Fp17331%2Fhtml%2Fch05.xhtml%3Freferer%3Dxxx%26page%3D13&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACanberra" class="Z3988" about="#mwt100" id="mwDfs"></span></span></li>
<li about="#cite_note-19" id="cite_note-19" data-mw-footnote-number="19"><span class="mw-cite-backlink" id="mwDfw"><a href="#cite_ref-19" rel="mw:referencedBy" id="mwDf0"><span class="mw-linkback-text" id="mwDf4">↑</span></a></span> <span id="mw-reference-text-cite_note-19" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt103" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDf8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.smh.com.au/politics/federal/cleavage-gives-canberra-allure-20121116-29hgk.html"},"title":{"wt":"Cleavage gives Canberra allure"},"date":{"wt":"17 November 2012"},"first":{"wt":"Tony"},"last":{"wt":"Wright"},"work":{"wt":"The Sydney Morning Herald"},"quote":{"wt":"Canberra, Mortimer confirmed, was indeed the same word as Ngambri. \"So what does Ngambri actually mean?\" Daley asked. \"Cleavage,\" said the Ngambri elder. \"You sure?\" insisted Daley. \"No doubt whatsoever. Her womb is where Capital Hill is today.\""}},"i":0}}]}'/><cite id="CITEREFWright2012" class="citation web cs1" about="#mwt103">Wright, Tony (17 November 2012). <a rel="mw:ExtLink nofollow" href="https://www.smh.com.au/politics/federal/cleavage-gives-canberra-allure-20121116-29hgk.html" class="external text" id="mwDgA">"Cleavage gives Canberra allure"</a>. <i id="mwDgE">The Sydney Morning Herald</i>. <q id="mwDgI">Canberra, Mortimer confirmed, was indeed the same word as Ngambri. "So what does Ngambri actually mean?" Daley asked. "Cleavage," said the Ngambri elder. "You sure?" insisted Daley. "No doubt whatsoever. Her womb is where Capital Hill is today."<span class="cs1-kern-right" id="mwDgM"></span></q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=The+Sydney+Morning+Herald&amp;rft.atitle=Cleavage+gives+Canberra+allure&amp;rft.date=2012-11-17&amp;rft.aulast=Wright&amp;rft.aufirst=Tony&amp;rft_id=https%3A%2F%2Fwww.smh.com.au%2Fpolitics%2Ffederal%2Fcleavage-gives-canberra-allure-20121116-29hgk.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACanberra" class="Z3988" about="#mwt103" id="mwDgQ"></span></span></li>
<li about="#cite_note-20" id="cite_note-20" data-mw-footnote-number="20"><span class="mw-cite-backlink" id="mwDgU"><a href="#cite_ref-20" rel="mw:referencedBy" id="mwDgY"><span class="mw-linkback-text" id="mwDgc">↑</span></a></span> <span id="mw-reference-text-cite_note-20" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt106" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDgg" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.abc.net.au/news/specials/curious-canberra/2016-04-04/indigenous-sites-in-canberra/7281812"},"title":{"wt":"Thousands of Indigenous heritage sites scattered across Canberra"},"first":{"wt":"Jordan"},"last":{"wt":"Hayne"},"work":{"wt":"ABC News"},"date":{"wt":"4 April 2016"},"quote":{"wt":"Ngambri-Guumaal elder Shane Mortimer, who contests the Ngunnawal claim to Canberra, said Black Mountain, Mount Ainslie and the area between them were hugely significant to his people. \"Canberra is women&apos;s business, it is women&apos;s country,\" he said. \"[The word &apos;Canberra&apos;] means cleavage – the space between a woman&apos;s breasts, that&apos;s Black Mountain and Mount Ainslie, and a very very important area for our people, indeed a corroboree ground for our people, right where the National Museum of Australia is today.\""}},"i":0}}]}'/><cite id="CITEREFHayne2016" class="citation web cs1" about="#mwt106">Hayne, Jordan (4 April 2016). <a rel="mw:ExtLink nofollow" href="https://www.abc.net.au/news/specials/curious-canberra/2016-04-04/indigenous-sites-in-canberra/7281812" class="external text" id="mwDgk">"Thousands of Indigenous heritage sites scattered across Canberra"</a>. <i id="mwDgo">ABC News</i>. <q id="mwDgs">Ngambri-Guumaal elder Shane Mortimer, who contests the Ngunnawal claim to Canberra, said Black Mountain, Mount Ainslie and the area between them were hugely significant to his people. "Canberra is women's business, it is women's country," he said. "[The word 'Canberra'] means cleavage – the space between a woman's breasts, that's Black Mountain and Mount Ainslie, and a very very important area for our people, indeed a corroboree ground for our people, right where the National Museum of Australia is today."<span class="cs1-kern-right" id="mwDgw"></span></q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=ABC+News&amp;rft.atitle=Thousands+of+Indigenous+heritage+sites+scattered+across+Canberra&amp;rft.date=2016-04-04&amp;rft.aulast=Hayne&amp;rft.aufirst=Jordan&amp;rft_id=https%3A%2F%2Fwww.abc.net.au%2Fnews%2Fspecials%2Fcurious-canberra%2F2016-04-04%2Findigenous-sites-in-canberra%2F7281812&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACanberra" class="Z3988" about="#mwt106" id="mwDg0"></span></span></li>
<li about="#cite_note-21" id="cite_note-21" data-mw-footnote-number="21"><span class="mw-cite-backlink" id="mwDg4"><a href="#cite_ref-21" rel="mw:referencedBy" id="mwDg8"><span class="mw-linkback-text" id="mwDhA">↑</span></a></span> <span id="mw-reference-text-cite_note-21" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt109" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDhE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"Suggested names for Australia&apos;s new capital {{!}} naa.gov.au"},"url":{"wt":"https://www.naa.gov.au/learn/learning-resources/learning-resource-themes/government-and-democracy/federation/suggested-names-australias-new-capital"},"access-date":{"wt":"17 November 2021"},"website":{"wt":"www.naa.gov.au"},"archive-date":{"wt":"17 November 2021"},"archive-url":{"wt":"https://web.archive.org/web/20211117110616/https://www.naa.gov.au/learn/learning-resources/learning-resource-themes/government-and-democracy/federation/suggested-names-australias-new-capital"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt109" id="mwDhI"><a rel="mw:ExtLink nofollow" href="https://www.naa.gov.au/learn/learning-resources/learning-resource-themes/government-and-democracy/federation/suggested-names-australias-new-capital" class="external text" id="mwDhM">"Suggested names for Australia's new capital | naa.gov.au"</a>. <i id="mwDhQ">www.naa.gov.au</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20211117110616/https://www.naa.gov.au/learn/learning-resources/learning-resource-themes/government-and-democracy/federation/suggested-names-australias-new-capital" class="external text" id="mwDhU">Archived</a> from the original on 17 November 2021<span class="reference-accessdate" id="mwDhY">. Retrieved <span class="nowrap" id="mwDhc">17 November</span> 2021</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=www.naa.gov.au&amp;rft.atitle=Suggested+names+for+Australia%27s+new+capital+%7C+naa.gov.au&amp;rft_id=https%3A%2F%2Fwww.naa.gov.au%2Flearn%2Flearning-resources%2Flearning-resource-themes%2Fgovernment-and-democracy%2Ffederation%2Fsuggested-names-australias-new-capital&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACanberra" class="Z3988" about="#mwt109" id="mwDhg"></span></span></li>
<li about="#cite_note-22" id="cite_note-22" data-mw-footnote-number="22"><span class="mw-cite-backlink" id="mwDhk"><a href="#cite_ref-22" rel="mw:referencedBy" id="mwDho"><span class="mw-linkback-text" id="mwDhs">↑</span></a></span> <span id="mw-reference-text-cite_note-22" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt112" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDhw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"Australia For Everyone: Canberra - The Names of Canberra"},"url":{"wt":"https://www.australiaforeveryone.com.au/australia-for-everyone-canberra-11/"},"access-date":{"wt":"17 November 2021"},"website":{"wt":"Australia Guide"},"language":{"wt":"en"},"archive-date":{"wt":"17 November 2021"},"archive-url":{"wt":"https://web.archive.org/web/20211117110616/https://www.australiaforeveryone.com.au/australia-for-everyone-canberra-11/"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt112" id="mwDh0"><a rel="mw:ExtLink nofollow" href="https://www.australiaforeveryone.com.au/australia-for-everyone-canberra-11/" class="external text" id="mwDh4">"Australia For Everyone: Canberra - The Names of Canberra"</a>. <i id="mwDh8">Australia Guide</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20211117110616/https://www.australiaforeveryone.com.au/australia-for-everyone-canberra-11/" class="external text" id="mwDiA">Archived</a> from the original on 17 November 2021<span class="reference-accessdate" id="mwDiE">. Retrieved <span class="nowrap" id="mwDiI">17 November</span> 2021</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Australia+Guide&amp;rft.atitle=Australia+For+Everyone%3A+Canberra+-+The+Names+of+Canberra&amp;rft_id=https%3A%2F%2Fwww.australiaforeveryone.com.au%2Faustralia-for-everyone-canberra-11%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ACanberra" class="Z3988" about="#mwt112" id="mwDiM"></span></span></li>
<li about="#cite_note-23" id="cite_note-23" data-mw-footnote-number="23"><span class="mw-cite-backlink" id="mwDiQ"><a href="#cite_ref-23" rel="mw:referencedBy" id="mwDiU"><span class="mw-linkback-text" id="mwDiY">↑</span></a></span> <span id="mw-reference-text-cite_note-23" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt115" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDic" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"last":{"wt":"Salvage"},"first":{"wt":"Jess"},"date":{"wt":"25 August 2016"},"title":{"wt":"The Siting and Naming of Canberra"},"url":{"wt":"https://www.nca.gov.au/siting-and-naming-canberra"},"access-date":{"wt":"17 November 2021"},"website":{"wt":"www.nca.gov.au"},"language":{"wt":"en"},"archive-date":{"wt":"17 November 2021"},"archive-url":{"wt":"https://web.archive.org/web/20211117110625/https://www.nca.gov.au/siting-and-naming-canberra"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFSalvage2016" class="citation web cs1" about="#mwt115">Salvage, Jess (25 August 2016). <a rel="mw:ExtLink nofollow" href="https://www.nca.gov.au/siting-and-naming-canberra" class="external text" id="mwDig">"The Siting and Naming of Canberra"</a>. <i id="mwDik">www.nca.gov.au</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20211117110625/https://www.nca.gov.au/siting-and-naming-canberra" class="external text" id="mwDio">Archived</a> from the original on 17 November 2021<span class="reference-accessdate" id="mwDis">. Retrieved <span class="nowrap" id="mwDiw">17 November</span> 2021</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=www.nca.gov.au&amp;rft.atitle=The+Siting+and+Naming+of+Canberra&amp;rft.date=20