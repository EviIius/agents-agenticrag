810px;top:310px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:blue"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Lake_Burley_Griffin" title="Lake Burley Griffin"><span title="Lake Burley Griffin" style="color:white;font-size:88%;font-weight:bold">13</span></a></div></div><div style="position:absolute;left:650px;top:525px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Limestone_Avenue,_Canberra" title="Limestone Avenue, Canberra" class="mw-redirect"><span title="Limestone Avenue" style="color:white;font-size:88%;font-weight:bold">14</span></a></div></div><div style="position:absolute;left:205px;top:525px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Fairbairn_Avenue" title="Fairbairn Avenue"><span title="Fairbairn Avenue" style="color:white;font-size:88%;font-weight:bold">15</span></a></div></div><div style="position:absolute;left:420px;top:350px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Parkes_Way" title="Parkes Way"><span title="Parkes Way" style="color:white;font-size:88%;font-weight:bold">16</span></a></div></div><div style="position:absolute;left:125px;top:202px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Department_of_Foreign_Affairs_and_Trade_(Australia)" title="Department of Foreign Affairs and Trade (Australia)"><span title="R G Casey Building" style="color:white;font-size:88%;font-weight:bold">17</span></a></div></div><div style="position:absolute;left:220px;top:240px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/John_Gorton_Building" title="John Gorton Building"><span title="John Gorton Building" style="color:white;font-size:88%;font-weight:bold">18</span></a></div></div><div style="position:absolute;left:420px;top:275px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><span title="King Edward Terrace" style="color:white;font-size:88%;font-weight:bold">19</span></div></div><div style="position:absolute;left:175px;top:200px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><span title="Presbyterian Church of Saint Andrew" style="color:white;font-size:88%;font-weight:bold">20</span></div></div><div style="position:absolute;left:635px;top:375px;line-height:95%;z-index:1"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 2px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/St_John_the_Baptist_Church,_Reid" title="St John the Baptist Church, Reid"><span title="St John's Anglican Church" style="color:white;font-size:88%;font-weight:bold">21</span></a></div></div></div></td></tr><tr><td>Points of Interest Looking South from <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mount_Ainslie" title="Mount Ainslie">Mount Ainslie</a><table style="width:100%;border:1px #ccc solid"><tbody><tr><td style="width:0.2%;vertical-align:top"><table style="width:100%;font-size:85%;line-height:95%"><tbody><tr style="vertical-align:top"><td style="width:12px;text-align:right;padding-bottom:2px"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Australian_War_Memorial" title="Australian War Memorial"><span title="War Memorial" style="color:white;font-size:88%;font-weight:bold">1</span></a></div></td><td style="padding-bottom:2px"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Australian_War_Memorial" title="Australian War Memorial">War Memorial</a></td></tr><tr style="vertical-align:top"><td style="width:12px;text-align:right;padding-bottom:2px"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Anzac_Parade,_Canberra" title="Anzac Parade, Canberra"><span title="Anzac Parade" style="color:white;font-size:88%;font-weight:bold">2</span></a></div></td><td style="padding-bottom:2px"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Anzac_Parade,_Canberra" title="Anzac Parade, Canberra">Anzac Parade</a></td></tr><tr style="vertical-align:top"><td style="width:12px;text-align:right;padding-bottom:2px"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Old_Parliament_House,_Canberra" title="Old Parliament House, Canberra"><span title="Old Parliament House" style="color:white;font-size:88%;font-weight:bold">3</span></a></div></td><td style="padding-bottom:2px"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Old_Parliament_House,_Canberra" title="Old Parliament House, Canberra">Old Parliament House</a></td></tr><tr style="vertical-align:top"><td style="width:12px;text-align:right;padding-bottom:2px"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Parliament_House,_Canberra" title="Parliament House, Canberra"><span title="New Parliament House" style="color:white;font-size:88%;font-weight:bold">4</span></a></div></td><td style="padding-bottom:2px"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Parliament_House,_Canberra" title="Parliament House, Canberra">New Parliament House</a></td></tr><tr style="vertical-align:top"><td style="width:12px;text-align:right;padding-bottom:2px"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Gallery_of_Australia" title="National Gallery of Australia"><span title="National Gallery" style="color:white;font-size:88%;font-weight:bold">5</span></a></div></td><td style="padding-bottom:2px"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Gallery_of_Australia" title="National Gallery of Australia">National Gallery</a></td></tr><tr style="vertical-align:top"><td style="width:12px;text-align:right;padding-bottom:2px"><div style="display:inline-block;width:auto;height:auto;text-align:center;padding:0px 4px;vertical-align:middle;border-radius:3px;background-color:red"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/High_Court_of_Australia" title="High Court of Australia"><span title="High Court" style="color:white;font-size:88%;font-weight:bold">6</span></a></div></td><td style="padding-bottom:2px"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/High_Court_