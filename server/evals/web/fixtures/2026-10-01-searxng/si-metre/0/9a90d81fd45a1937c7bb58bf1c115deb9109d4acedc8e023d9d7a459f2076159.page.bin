<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt157" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwCN0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book\n ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Hsu"},"first":{"wt":"L."},"year":{"wt":"2006"},"chapter":{"wt":"Appendix A: Systems of units and the development of relativity theories"},"chapter-url":{"wt":"https://books.google.com/books?id=amLqckyrvUwC&amp;pg=PA428"},"title":{"wt":"A Broader View of Relativity: General Implications of Lorentz and Poincaré Invariance"},"pages":{"wt":"427–428"},"edition":{"wt":"2"},"publisher":{"wt":"[[World Scientific]]"},"isbn":{"wt":"978-981-256-651-5"}},"i":0}}]}'/><cite id="CITEREFHsu2006" class="citation book cs1" about="#mwt157">Hsu, L. (2006). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=amLqckyrvUwC&amp;pg=PA428" class="external text" id="mwCN4">"Appendix A: Systems of units and the development of relativity theories"</a>. <i id="mwCN8">A Broader View of Relativity: General Implications of Lorentz and Poincaré Invariance</i> (2<span typeof="mw:Entity" id="mwCOA"> </span>ed.). <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/World_Scientific" title="World Scientific" id="mwCOE">World Scientific</a>. pp.<span typeof="mw:Entity" id="mwCOI"> </span><span class="nowrap" id="mwCOM">427–</span>428. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwCOQ">ISBN</a><span typeof="mw:Entity" id="mwCOU"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-981-256-651-5" title="Special:BookSources/978-981-256-651-5" id="mwCOY"><bdi id="mwCOc">978-981-256-651-5</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=boo