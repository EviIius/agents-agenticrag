<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt601" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDr0" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book\n ","href":"./Template:Cite_book"},"params":{"editor1-last":{"wt":"Hutton"},"editor1-first":{"wt":"C."},"editor2-last":{"wt":"Shaw"},"editor2-first":{"wt":"G."},"editor3-last":{"wt":"Pearson"},"editor3-first":{"wt":"R."},"year":{"wt":"1809"},"title":{"wt":"The Philosophical Transactions of the Royal Society of London, from Their Commencement in 1665, in the Year 1800: Abridged"},"chapter":{"wt":"On the Motion of Light by M. Romer"},"chapter-url":{"wt":"https://archive.org/stream/philosophicaltra02royarich#page/397/mode/1up"},"location":{"wt":"London"},"publisher":{"wt":"C. &amp; R. Baldwin"},"volume":{"wt":"II. From 1673 to 1682"},"pages":{"wt":"397–398"}},"i":0}}]}'/><cite id="CITEREFHuttonShawPearson1809" class="citation book cs1 cs1-prop-long-vol" about="#mwt601">Hutton, C.; Shaw, G.; Pearson, R., eds. (1809). <a rel="mw:ExtLink nofollow" href="https://archive.org/stream/philosophicaltra02royarich#page/397/mode/1up" class="external text" id="mwDr4">"On the Motion of Light by M. Romer"</a>. <i id="mwDr8">The Philosophical Transactions of the Royal Society of London, from Their Commencement in 1665, in the Year 1800: Abridged</i>. Vol.<span typeof="mw:Entity" id="mwDsA"> </span>II. From 1673 to 1682. London: C. &amp; R. Baldwin. pp.<span typeof="mw:Entity" id="mwDsE"> </span><span class="nowrap" id="mwDsI">397–</span>398.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=On+the+Motion+of+Light+by+M.+Romer&amp;rft.btitle=The+Philosophical+Transactions+of+the+Royal+Society+of+London%2C+from+Their+Commencement+in+1665%2C+in+the+Year+1800%3A+Abridged&amp;rft.place=London&amp;rft.pag