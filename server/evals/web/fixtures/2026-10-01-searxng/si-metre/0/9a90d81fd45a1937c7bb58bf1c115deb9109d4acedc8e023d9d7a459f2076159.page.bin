<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt339" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwCsI" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal\n ","href":"./Template:Cite_journal"},"params":{"last1":{"wt":"Ellis"},"first1":{"wt":"G. F. R."},"last2":{"wt":"Uzan"},"first2":{"wt":"J.-P."},"year":{"wt":"2005"},"title":{"wt":"&apos;c&apos; is the speed of light, isn&apos;t it?"},"journal":{"wt":"[[American Journal of Physics]]"},"volume":{"wt":"73"},"issue":{"wt":"3"},"pages":{"wt":"240–227"},"doi":{"wt":"10.1119/1.1819929"},"arxiv":{"wt":"gr-qc/0305099"},"quote":{"wt":"The possibility that the fundamental constants may vary during the evolution of the universe offers an exceptional window onto higher dimensional theories and is probably linked with the nature of the dark energy that makes the universe accelerate today."},"bibcode":{"wt":"2005AmJPh..73..240E"},"s2cid":{"wt":"119530637"}},"i":0}}]}'/><cite id="CITEREFEllisUzan2005" class="citation journal cs1" about="#mwt339">Ellis, G. F. R.; Uzan, J.-P. (2005). "<span class="cs1-kern-left" id="mwCsM"></span>'c' is the speed of light, isn't it?". <i id="mwCsQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/American_Journal_of_Physics" title="American Journal of Physics" id="mwCsU">American Journal of Physics</a></i>. <b id="mwCsY">73</b> (3): <span class="nowrap" id="mwCsc">240–</span>227. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ArXiv_(identifier)" title="ArXiv (identifier)" class="mw-redirect" id="mwCsg">arXiv</a>:<span class="id-lock-free" title="Freely accessible" id="mwCsk"><a rel="mw:ExtLink nofollow" href="https://arxiv.org/abs/gr-qc/0305099" class="external text" id="mwCso">gr-qc/0305099</a></span>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Bibcode_(identifier)" title="Bibcode (identifier)" class="mw-redirect" id="mwCss">Bibcode</a>:<a rel="mw:ExtLink nofollow" href="https://ui.adsabs.harvard.edu/abs/2005AmJPh..73..240E" class="external text" id="mwCsw">2005AmJPh..73..240E</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwCs0">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1119%2F1.1819929" class="external text" id="mwCs4">10.1119/1.1819929</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/S2CID_(identifier)" title="S2CID (identifier)" class="mw-redirect" id="mwCs8">S2CID</a><span typeof="mw:Entity" id="mwCtA"> </span><a rel="mw:ExtLink nofollow" href="https://api.semanticscholar.org/CorpusID:119530637" class="external text" id="mwCtE">119530637</a>. <q id="mwCtI">The possibility that the fundamental constants may vary during the evolution of the universe offers an exceptional window onto higher dimensional theories and is probably linked with the nature of the dark energy that makes the universe accelerate today.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=American+Journal+of+Physics&amp;rft.atitle=%27c%27+is+the+speed+of+light%2C+isn%27t+it%3F&amp;rft.volume=73&amp;rft.issue=3&amp;rft.pages=240-227&amp;rft.date=2005&amp;rft_id=info%3Aarxiv%2Fgr-qc%2F0305099&amp;rft_id=https%3A%2F%2Fapi.semanticscholar.org%2FCorpusID%3A119530637%23id-name%3DS2CID&amp;rft_id=info%3Adoi%2F10.1119%2F1.1819929&amp;rft_id=info%3Abibcode%2F2005AmJPh..73..240E&amp;rft.aulast=Ellis&amp;rft.aufirst=G.+F.+R.&amp;rft.au=Uzan%2C+J.-P.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASpeed+of+light" class="Z3988" about="#mwt339" id="mwCtM"></span></span></li>
