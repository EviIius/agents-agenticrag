46C12 19.46 18.88 19.46 20.6 19C21.0708 18.8668 21.498 18.6118 21.8387 18.2606C22.1793 17.9094 22.4212 17.4746 22.54 17C22.8524 15.2676 23.0063 13.5103 23 11.75C23.0112 9.96295 22.8573 8.1787 22.54 6.42Z" stroke="rgba(255,255,255,0.75)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.75 15.02L15.5 11.75L9.75 8.48V15.02Z" stroke="rgba(255,255,255,0.75)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div></div></footer></div><style>
        .mobile-lead-bar {
          display: none;
        }
        @media (max-width: 1100px) {
          .mobile-lead-bar {
            display: flex;
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            z-index: 200;
            background: #0F1F3D;
            color: #fff;
            align-items: center;
            justify-content: space-between;
            padding: 10px 16px;
            /* iOS safe-area: push content above the home indicator on notched phones */
            padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
            gap: 10px;
            box-shadow: 0 -2px 12px rgba(0,0,0,0.25);
            box-sizing: border-box;
          }
        }
      </style><div class="mobile-lead-bar"><span style="font-size:13px;font-weight:600;flex:1;line-height:1.3">Book a FREE Demo Class</span><a href="https://bhanzu.com/embeddable-demo-form?utm_source=blog-mobile" style="background:#F15D22;color:#fff;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap;flex-shrink:0">Book Now →</a><button aria-label="Dismiss" style="background:transparent;border:none;color:rgba(255,255,255,0.6);font-size:18px;cursor:pointer;padding:0 4px;flex-shrink:0;line-height:1">×</button></div><style>
      /* Transition only on the way IN. On [data-reveal] generally, arming a
         block would animate it OUT over the same duration, and a fast
         scroller could catch it fading away before fading back. */
      .bhanzu-prose > [data-reveal="in"] {
        transition:
          opacity .6s cubic-bezier(.165,.84,.44,1),
          transform .6s cubic-bezier(.165,.84,.44,1),
          filter .6s cubic-bezier(.165,.84,.44,1);
      }
      .bhanzu-prose > [data-reveal="pending"] {
        opacity: 0;
        transform: translateY(14px);
      }
      /* Blur only on text: on a wide table or image it costs paint for no gain. */
      .bhanzu-prose > [data-reveal="pending"]:is(p, h2, h3, h4, ul, ol, blockquote) {
        filter: blur(3px);
      }
      @media print {
        .bhanzu-prose > [data-reveal] { opacity: 1 !important; transform: none !important; filter: none !important; }
      }
    </style><style>
        /* ── Page-level classes (overrideable by custom/template CSS) ── */
        /* overflow-x:clip clips without creating a block formatting context,
           so position:sticky still works on nav, TOC, and sidebar descendants.
           (overflow:hidden would break sticky — that was the previous bug.) */
        .page-root { background: #fff; color: #374151; overflow-x: clip; width: 100%; }
        .page-hero { background: #fff; }
        /* ── Featured image — LCP + CLS (Medium/Substack pattern) ───────────────
           Lives inside the article header column, below the meta bar.
           aspect-ratio:16/9 reserves exact space before bytes arrive → zero CLS.
           border-radius keeps it within the article column as a designed element,
           not a raw full-bleed banner. margin-top separates it from the meta bar.
           fetchPriority="high" on the <img> makes it the LCP candidate without
           the image having to dominate the entire above-the-fold viewport. */
        .page-hero-img-wrap {
          position: relative;
          width: 100%;
          aspect-ratio: 16 / 9;
          overflow: hidden;
          border-radius: 12px;
          background: #F3F4F6;
          margin-top: 20px;
        }
        .page-hero-img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }
        /* Grid container box-sizing so padding doesn't push it past viewport width */
        .page-grid { box-sizing: border-box; width: 100%; }
        .bhanzu-prose h1 { font-family: 'Quicksand','Quicksand Fallback',sans-serif; font-size: 28px; font-weight: 900; color: #0F1F3D; margin: 0 0 16px; line-height: 1.2; }
        .bhanzu-prose h2 { font-family: 'Quicksand','Quicksand Fallback',sans-serif; font-size: 20px; font-weight: 800; color: #0F1F3D; margin: 1.8em 0 0.35em; }
        .bhanzu-prose h2:first-child { margin-top: 0; }
        .bhanzu-prose h3 { font-size: 16px; font-weight: 700; color: #0F1F3D; margin: 1.4em 0 0.25em; }
        .bhanzu-prose h4 { font-size: 14px; font-weight: 700; color: #0F1F3D; margin: 18px 0 8px; }
        /* max-width prevents the prose container itself from overflowing */
        .bhanzu-prose { max-width: 100%; }
        /* word-break + overflow-wrap only on flowing text — NOT inherited by tables */
        .bhanzu-prose p, .bhanzu-prose li, .bhanzu-prose blockquote,
        .bhanzu-prose h1, .bhanzu-prose h2, .bhanzu-prose h3, .bhanzu-prose h4 { word-break: break-word; overflow-wrap: break-word; }
        /* Hard reset on every table descendant — TipTap wraps <td> content in <p>, so
           targeting td alone is not enough; the inner <p> match above would still win.
           !important ensures this beats any inherited or element-level override. */
        .bhanzu-prose table, .bhanzu-prose table * { word-break: normal !important; overflow-wrap: normal !important; }
        .bhanzu-prose p { font-size: 15px; color: #4B5563; margin-bottom: 14px; line-height: 1.85; }
        .bhanzu-prose strong { color: #0F1F3D; }
        .bhanzu-prose em { font-style: italic; }
        .bhanzu-prose a.md-link { color: #F15D22; font-weight: 600; border-bottom: 1px dotted rgba(255,107,43,.4); text-decoration: none; }
        .bhanzu-prose a.md-link:hover { border-bottom-style: solid; }
        /* ── Lists: fix bullet/number visibility ── */
        .bhanzu-prose ul { padding-left: 24px; margin-bottom: 16px; color: #4B5563; list-style-type: disc !important; }
        .bhanzu-prose ol { padding-left: 24px; margin-bottom: 16px; color: #4B5563; list-style-type: decimal !important; }
        .bhanzu-prose li { margin-bottom: 6px; font-size: 15px; display: list-item !important; }
        .bhanzu-prose li > p { margin: 0; display: inline; }
        .bhanzu-prose ul ul { list-style-type: circle !important; margin-top: 4px; }
        .bhanzu-prose ul ul ul { list-style-type: square !important; }
        /* ── Blockquote / HR / Image ── */
        .bhanzu-prose blockquote { border-left: 3px solid #F15D22; padding: 12px 16px; background: #FFF4EF; border-radius: 0 8px 8px 0; margin: 18px 0; color: #4B5563; font-style: italic; }
        .bhanzu-prose hr { height: 1px; background: #E9ECEF; border: none; margin: 32px 0; }
        /* All images capped at container width — prevents bare <img> from TipTap HTML overflowing */
        .bhanzu-prose img { max-width: 100%; height: auto; }
        .bhanzu-prose img.md-img { border-radius: 12px; width: 100%; height: auto; margin: 16px 0; }
        /* CLS: reserve 16:9 space for images without explicit width+height
           so the layout doesn't jump when they load. Only applies when both
           attributes are missing — images WITH dimensions get natural sizing. */
        /* Reserve 16:9 space for images without explicit dimensions to prevent CLS.
           object-fit:contain (not cover) preserves the full image without cropping —
           portrait or square images stay fully visible, just with transparent bars. */
        .bhanzu-prose img:not([width]):not([height]) { aspect-ratio: 16/9; width: 100%; object-fit: contain; }
        /* ── Tables: scroll-wrapper prevents overflow, cells stay readable ── */
        /* width:100% + display:block ensures wrapper never grows beyond its parent */
        .bhanzu-prose .table-scroll-wrapper { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 18px 0; border-radius: 12px; border: 1px solid #E9ECEF; width: 100%; display: block; box-sizing: border-box; }
        /* min-width:100% fills wrapper when content is narrow;                     */
        /* removing fixed width:100% lets wide tables exceed the wrapper → scroll   */
        /* ── Worksheet downloads ──────────────────────────────────────────
           One stylesheet for all four presets, so any download block on the
           site can be restyled here without touching a single article. */
        .wsdl { margin: 26px 0; }
        .wsdl a { text-decoration: none; }
        .wsdl__grp + .wsdl__grp { margin-top: 16px; }
        .wsdl__group { font-size: 12.5px; font-weight: 700; color: #6B7280; margin: 0 0 8px; letter-spacing: .02em; }
        .wsdl__btns { display: flex; flex-wrap: wrap; gap: 9px; }
        .wsdl__meta { font-size: 11px; color: #9CA3AF; font-weight: 600; }

        /* button-list */
        .wsdl--buttons .wsdl__link {
          display: inline-flex; align-items: center; gap: 8px;
          padding: 9px 16px; border-radius: 8px;
          border: 1.5px solid #F15D22; color: #F15D22;
          background: #fff; font-size: 13.5px; font-weight: 700;
          transition: background .15s, color .15s;
        }
        .wsdl--buttons .wsdl__link:hover { background: #F15D22; color: #fff; }
        .wsdl--buttons .wsdl__link:hover .wsdl__meta { color: rgba(255,255,255,.75); }
        .wsdl__ico { font-size: 12px; }

        /* thumbnail-grid */
        .wsdl--thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
        .wsdl--thumbs .wsdl__link {
          display: flex; flex-direction: column; gap: 2px;
          border: 1px solid #E9ECEF; border-radius: 10px; overflow: hidden;
          background: #fff; transition: border-color .15s, transform .15s;
        }
        .wsdl--thumbs .wsdl__link:hover { border-color: #F15D22; transform: translateY(-2px); }
        .wsdl__thumb {
          display: flex; align-items: center; justify-content: center;
          aspect-ratio: 3/4; background: #FDEEE8; overflow: hidden;
        }
        .wsdl__thumbimg { width: 100%; height: 100%; object-fit: cover; display: block; }
        .wsdl__thumbfallback { font-size: 13px; font-weight: 800; color: #F15D22; letter-spacing: .06em; }
        .wsdl__cap { font-size: 12.5px; font-weight: 700; color: #0F1F3D; padding: 9px 11px 0; }
        .wsdl--thumbs .wsdl__meta { padding: 0 11px 10px; }

        /* numbered-hub */
        .wsdl--hub { display: flex; flex-wrap: wrap; gap: 10px; }
        .wsdl__n {
          display: flex; align-items: center; justify-content: center;
          width: 46px; height: 46px; border-radius: 50%;
          border: 1.5px solid #F15D22; color: #F15D22;
          font-weight: 800; font-size: 15px; background: #fff;
          transition: background .15s, color .15s;
        }
        .wsdl--hub .wsdl__link:hover .wsdl__n { background: #F15D22; color: #fff; }

        /* inline-cta */
        .wsdl--cta .wsdl__link {
          display: flex; align-items: center; gap: 14px;
          border: 1px solid #E9ECEF; border-radius: 10px;
          padding: 13px 15px; background: #fff; margin-bottom: 10px;
          transition: border-color .15s;
        }
        .wsdl--cta .wsdl__link:hover { border-color: #F15D22; }
        .wsdl__ctaico {
          flex-shrink: 0; width: 38px; height: 46px; border-radius: 5px;
          border: 1px solid #F15D22; color: #F15D22;
          display: flex; align-items: center; justify-content: center;
          font-size: 10px; font-weight: 800; letter-spacing: .05em; background: #FDEEE8;
        }
        .wsdl__ctabody { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
        .wsdl__ctat { font-size: 14.5px; font-weight: 700; color: #0F1F3D; }
        .wsdl__ctabtn {
          flex-shrink: 0; padding: 8px 16px; border-radius: 7px;
          background: #F15D22; color: #fff; font-size: 13px; font-weight: 700;
        }
        .wsdl a:focus-visible { outline: 2px solid #F15D22; outline-offset: 2px; }
        @media (prefers-reduced-motion: reduce) {
          .wsdl--thumbs .wsdl__link:hover { transform: none; }
        }

        .bhanzu-prose table.md-table { display: table; min-width: 100%; border-collapse: collapse; font-size: 13px; margin: 0; border: none; border-radius: 0; }
        /* Dark header ONLY for proper <thead> rows — grid/puzzle tables that use   */
        /* <th> in <tbody> (e.g. magic squares) get neutral styling instead.        */
        .bhanzu-prose table.md-table thead { background: #0F1F3D; }
        .bhanzu-prose table.md-table thead th, .bhanzu-prose table thead th { padding: 11px 14px; text-align: left; color: #fff !important; font-weight: 700; font-size: 11px; letter-spacing: .04em; background: #0F1F3D !important; white-space: nowrap; }
        /* Cover all descendants so TipTap's inline-styled <span> elements don't bleed through */
        .bhanzu-prose table thead th *, .bhanzu-prose table thead th p { color: #fff !important; background: #0F1F3D !important; margin: 0; }
        /* th in tbody = row-header cell (e.g. first column label) — bold, no dark bg */
        .bhanzu-prose table tbody th { padding: 10px 14px; text-align: left; font-weight: 700; color: #0F1F3D !important; font-size: 13px; background: #fff !important; border-bottom: 1px solid #F3F4F6; }
        .bhanzu-prose table tbody th *, .bhanzu-prose table tbody th p { color: #0F1F3D !important; background: #fff !important; margin: 0; }
        .bhanzu-prose table.md-table tbody tr { border-bottom: 1px solid #F3F4F6; }
        .bhanzu-prose table.md-table tbody tr:last-child { border: none; }
        .bhanzu-prose table.md-table tbody tr:hover { background: #F9FAFB; }
        .bhanzu-prose table.md-table td { padding: 10px 14px; color: #4B5563; }
        .bhanzu-prose table.md-table td:first-child { font-weight: 700; color: #0F1F3D; }
        /* Fallback for any unclassed table */
        .bhanzu-prose table:not(.md-table) { display: table; min-width: 100%; border-collapse: collapse; font-size: 13px; margin: 18px 0; border: 1px solid #E9ECEF; }
        .bhanzu-prose table:not(.md-table) thead th { padding: 11px 14px; text-align: left; color: #fff !important; font-weight: 700; font-size: 11px; background: #0F1F3D !important; white-space: nowrap; }
        .bhanzu-prose table:not(.md-table) thead th * { color: #fff !important; background: #0F1F3D !important; }
        .bhanzu-prose table:not(.md-table) tbody th { padding: 10px 14px; font-weight: 700; color: #0F1F3D !important; background: #fff !important; }
        .bhanzu-prose table:not(.md-table) tbody th * { color: #0F1F3D !important; background: #fff !important; }
        .bhanzu-prose table:not(.md-table) td { padding: 10px 14px; color: #4B5563; border-bottom: 1px solid #F3F4F6; }
        /* ── Code ── */
        .bhanzu-prose pre.code-block { background: #1E293B; color: #E2E8F0; border-radius: 12px; padding: 16px 20px; overflow-x: auto; font-family: 'Courier New',monospace; font-size: 13px; margin: 18px 0; }
        .bhanzu-prose code.inline-code { background: #F3F4F6; color: #D9520E; padding: 2px 6px; border-radius: 4px; font-family: 'Courier New',monospace; font-size: 13px; font-weight: 700; }
        .bhanzu-prose .math-display { margin: 20px 0; text-align: center; overflow-x: auto; padding: 12px; background: #F9FAFB; border-radius: 8px; border: 1px solid #E9ECEF; }
        .bhanzu-prose .math-inline { font-family: 'Courier New', monospace; }
        .bhanzu-prose del { color: #9CA3AF; text-decoration: line-through; }
        /* ── Accordion / Collapsible FAQ ── */
        .bhanzu-prose details.md-accordion { border: 1px solid #E9ECEF; border-radius: 10px; margin: 10px 0; overflow: hidden; }
        .bhanzu-prose details.md-accordion summary.md-accordion-summary { padding: 14px 18px; font-weight: 700; font-size: 15px; color: #0F1F3D; cursor: pointer; background: #F9FAFB; list-style: none; display: flex; align-items: center; justify-content: space-between; }
        .bhanzu-prose details.md-accordion summary.md-accordion-summary::-webkit-details-marker { display: none; }
        .bhanzu-prose details.md-accordion summary.md-accordion-summary::after { content: '+'; font-size: 18px; color: #F15D22; transition: transform 0.2s; }
        .bhanzu-prose details.md-accordion[open] summary.md-accordion-summary::after { content: '−'; }
        .bhanzu-prose details.md-accordion .md-accordion-body { padding: 14px 18px; font-size: 15px; color: #4B5563; line-height: 1.75; border-top: 1px solid #E9ECEF; }
        /* ── Mobile layout ── */
        @media (max-width: 1100px) {
          /* Collapse 3-col grid to single-column flex stack */
          .page-grid {
            display: flex !important;
            flex-direction: column !important;
            padding: 16px 20px !important;
            gap: 0 !important;
          }
          /* Every direct flex child must fill the full width */
          .page-article-header,
          .page-article-body,
          .page-sidebar-aside {
            width: 100% !important;
            box-sizing: border-box !important;
            min-width: 0 !important;
          }
          /* Remove the cross-axis start alignment that shrinks sidebar on mobile */
          .page-sidebar-aside {
            position: static !important;
            align-self: stretch !important;
            top: auto !important;
          }
          /* Article body: let content overflow horizontally inside scroll wrappers
             instead of being hard-clipped by the parent */
          .page-article-body {
            overflow: visible !important;
            padding-top: 20px !important;
          }
          /* TOC hidden on tablet/mobile */
          .page-toc-aside { display: none !important; }
          /* Table scroll wrapper capped to viewport */
          .bhanzu-prose .table-scroll-wrapper { max-width: calc(100vw - 40px); }
        }
        @media (max-width: 640px) {
          .page-grid { padding: 12px 16px !important; }
          .bhanzu-prose .table-scroll-wrapper { max-width: calc(100vw - 32px); }
          /* Tighter prose font on small phones */
          .bhanzu-prose p, .bhanzu-prose li { font-size: 14px; }
          .bhanzu-prose h2 { font-size: 18px; }
          .bhanzu-prose h3 { font-size: 15px; }
        }
      </style><style>
          @media (max-width: 1100px) {
            .page-root { padding-bottom: var(--mobile-lead-bar-height, 64px); }
          }
        </style><style>/* ============================================================
   BLOG POST STYLES  —  edit any value and click Save
   Tip: colour = color, size in px, spacing in px
   ============================================================ */

/* ------ PAGE TITLE (the big H1 at the top) ------ */
.bhanzu-prose h1 { font-size: 28px; font-weight: 900; color: #0F1F3D; margin: 0 0 16px; line-height: 1.2; }

/* ------ SECTION HEADING (H2 — used for major sections) ------ */
.bhanzu-prose h2 { font-size: 20px; font-weight: 800; color: #0F1F3D; margin: 40px 0 12px; }

/* ------ SUB-HEADING (H3 — used inside sections) ------ */
.bhanzu-prose h3 { font-size: 16px; font-weight: 700; color: #0F1F3D; margin: 24px 0 10px; }

/* ------ SMALL HEADING (H4) ------ */
.bhanzu-prose h4 { font-size: 14px; font-weight: 700; color: #0F1F3D; margin: 18px 0 8px; }

/* ------ BODY TEXT (regular paragraphs) ------ */
.bhanzu-prose p { font-size: 15px; color: #4B5563; margin-bottom: 14px; line-height: 1.85; }

/* ------ BOLD TEXT ------ */
.bhanzu-prose strong { color: #0F1F3D; }

/* ------ ITALIC TEXT ------ */
.bhanzu-prose em { font-style: italic; }

/* ------ LINKS (clickable text) ------ */
.bhanzu-prose a { color: #F15D22; font-weight: 600; text-decoration: none; border-bottom: 1px dotted rgba(255,107,43,.4); }
.bhanzu-prose a:hover { border-bottom-style: solid; }

/* ------ BULLET LISTS and NUMBERED LISTS ------ */
.bhanzu-prose ul, .bhanzu-prose ol { padding-left: 24px; margin-bottom: 16px; color: #4B5563; }
.bhanzu-prose li { margin-bottom: 6px; font-size: 15px; }

/* ------ PULL QUOTE / BLOCKQUOTE (the indented callout box) ------ */
.bhanzu-prose blockquote { border-left: 3px solid #F15D22; padding: 12px 16px; background: #FFF4EF; border-radius: 0 8px 8px 0; margin: 18px 0; color: #4B5563; font-style: italic; }

/* ------ HORIZONTAL DIVIDER LINE (---) ------ */
.bhanzu-prose hr { height: 1px; background: #E9ECEF; border: none; margin: 32px 0; }

/* ------ IMAGES ------ */
.bhanzu-prose img { border-radius: 12px; width: 100%; height: auto; margin: 16px 0; }

/* ------ TABLES ------ */
.bhanzu-prose table { width: 100%; table-layout: fixed; border-collapse: collapse; margin: 18px 0; font-size: 13px; border-radius: 12px; overflow: hidden; border: 1px solid #E9ECEF; }
.bhanzu-prose thead { background: #0F1F3D; } /* table header row background */
.bhanzu-prose th { padding: 11px 14px; color: #fff !important; font-weight: 700; font-size: 11px; text-align: left; letter-spacing: .04em; background: #0F1F3D !important; }
.bhanzu-prose tbody tr { border-bottom: 1px solid #F3F4F6; }
.bhanzu-prose tbody tr:hover { background: #F9FAFB; } /* row highlight on hover */
.bhanzu-prose td { padding: 10px 14px; color: #4B5563; }

/* ------ CODE BLOCK (multi-line code snippet) ------ */
.bhanzu-prose pre { background: #1E293B; color: #E2E8F0; border-radius: 12px; padding: 16px 20px; overflow-x: auto; font-family: monospace; font-size: 13px; margin: 18px 0; }

/* ------ INLINE CODE (short code inside a sentence) ------ */
.bhanzu-prose code { background: #F3F4F6; color: #D9520E; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 13px; font-weight: 700; }</style><!--$--><!--/$--><div></div><script src="https://blog.bhanzu.com/_next/static/chunks/a4e3ec9da66678d0.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n3:I[39756,[\"https://blog.bhanzu.com/_next/static/chunks/ff1a16fafef87110.js\",\"https://blog.bhanzu.com/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n4:I[37457,[\"https://blog.bhanzu.com/_next/static/chunks/ff1a16fafef87110.js\",\"https://blog.bhanzu.com/_next/static/chunks/d2be314c3ece3fbe.js\"],\"default\"]\n6:I[97367,[\"https://blog.bhanzu.com/_next/static/chunks/ff1a16fafef87110.js\",\"https://blog.bhanzu.com/_next/static/chunks/d2be314c3ece3fbe.js\"],\"OutletBoundary\"]\n7:\"$Sreact.suspense\"\n9:I[97367,[\"https://blog.bhanzu.com/_next/static/chunks/ff1a16fafef87110.js\",\"https://blog.bhanzu.com/_next/static/chunks/d2be314c3ece3fbe.js\"],\"ViewportBoundary\"]\nb:I[97367,[\"https://blog.bhanzu.com/_next/static/chunks/ff1a16fafef87110.js\",\"https://blog.bhanzu.com/_next/static/chunks/d2be314c3ece3fbe.js\"],\"MetadataBoundary\"]\nd:I[53348,[\"https://blog.bhanzu.com/_next/static/chunks/0d6ee984d85f7267.js\"],\"default\"]\n:HL[\"https://blog.bhanzu.com/_next/static/chunks/778318d31bdf5a6d.css\",\"style\"]\n"])</script><script>self.__next_f.push([1,"0:{\"P\":null,\"b\":\"Hl423zgQjhR2Xp9pYEz95\",\"c\":[\"\",\"math\",\"terms\",\"meter\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[[\"section\",\"math\",\"d\"],{\"children\":[[\"slug\",\"terms/meter\",\"c\"],{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",true],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"https://blog.bhanzu.com/_next/static/chunks/778318d31bdf5a6d.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\