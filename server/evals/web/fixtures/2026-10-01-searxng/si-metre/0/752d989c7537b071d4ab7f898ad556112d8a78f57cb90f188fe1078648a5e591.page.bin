y Team Bhanzu focuses on delivering practical insights, concept-driven explanations, and trustworthy guidance-empowering learners to develop confidence, speed, and a lifelong love for mathematics.\"}],\"publisher\":{\"@type\":\"Organization\",\"@id\":\"https://bhanzu.com/#organization\",\"name\":\"Bhanzu\",\"url\":\"https://bhanzu.com\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://bhanzu.com/brand/bhanzu-logo-600x60.png\",\"width\":600,\"height\":60},\"sameAs\":[\"https://www.linkedin.com/company/bhanzu\",\"https://twitter.com/bhanzu_official\",\"https://www.instagram.com/bhanzu_/\",\"https://www.youtube.com/@bhanzu\"]}}"])</script><script>self.__next_f.push([1,"15:T5b0,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"@id\":\"https://bhanzu.com/math/terms/meter#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is a meter in math?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The SI base unit of length, equal to $100$ centimetres or about $3.28$ feet.\"}},{\"@type\":\"Question\",\"name\":\"How is the meter defined?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"As the length light travels in vacuum in $1/299{,}792{,}458$ of a second.\"}},{\"@type\":\"Question\",\"name\":\"How many centimetres are in $1$ meter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"$100$ centimetres.\"}},{\"@type\":\"Question\",\"name\":\"How many feet are in $1$ meter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Approximately $3.281$ feet, or exactly $\\\\dfrac{1}{0.3048}$ feet (since $1$ ft $= 0.3048$ m).\"}},{\"@type\":\"Question\",\"name\":\"How many meters are in $1$ kilometre?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"$1{,}000$ meters.\"}},{\"@type\":\"Question\",\"name\":\"What's the difference between \\\"meter\\\" and \\\"metre\\\"?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Spelling only. American English uses \\\"meter\\\"; British and most other English uses \\\"metre.\\\" They refer to the same unit.\"}},{\"@type\":\"Question\",\"name\":\"Who invented the meter?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The French Academy of Sciences proposed it in $1791$ as a unit \\\"for all people, for all time.\\\" It became the international standard with the Metric Convention of $1875$.\"}}]}"])</script><script>self.__next_f.push([1,"5:[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$14\"}}],null,[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$15\"}}],\"\",\"\",false,\"$L16\",false,\"$L17\",false,\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"\"]\n"])</script><script>self.__next_f.push([1,"1f:I[64389,[\"https://blog.bhanzu.com/_next/static/chunks/289c98a5c27dd4bb.js\",\"https://blog.bhanzu.com/_next/static/chunks/fa907f97ab85c687.js\",\"https://blog.bhanzu.com/_next/static/chunks/e0da408efd949077.js\"],\"default\"]\n20:I[22016,[\"https://blog.bhanzu.com/_next/static/chunks/289c98a5c27dd4bb.js\",\"https://blog.bhanzu.com/_next/static/chunks/fa907f97ab85c687.js\",\"https://blog.bhanzu.com/_next/static/chunks/e0da408efd949077.js\"],\"\"]\n21:I[9215,[\"https://blog.bhanzu.com/_next/static/chunks/289c98a5c27dd4bb.js\",\"https://blog.bhanzu.com/_next/static/chunks/fa907f97ab85c687.js\",\"https://blog.bhanzu.com/_next/static/chunks/e0da408efd949077.js\"],\"default\"]\n27:I[78523,[\"https://blog.bhanzu.com/_next/static/chunks/289c98a5c27dd4bb.js\",\"https://blog.bhanzu.com/_next/static/chunks/fa907f97ab85c687.js\",\"https://blog.bhanzu.com/_next/static/chunks/e0da408efd949077.js\"],\"default\"]\n28:I[41520,[\"https://blog.bhanzu.com/_next/static/chunks/289c98a5c27dd4bb.js\",\"https://blog.bhanzu.com/_next/static/chunks/fa907f97ab85c687.js\",\"https://blog.bhanzu.com/_next/static/chunks/e0da408efd949077.js\"],\"default\"]\n29:I[3634,[\"https://blog.bhanzu.com/_next/static/chunks/289c98a5c27dd4bb.js\"