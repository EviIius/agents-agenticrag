e":"StorylineArticle","title":"Brunson's Message to Critics","permalink":"https://www.nytimes.com/athletic/7373660/2026/06/18/jalen-brunson-critics-response-knicks-parade/","id":"7373660"},{"__typename":"StorylineArticle","title":"Celebrating The Win","permalink":"https://www.nytimes.com/athletic/7370356/2026/06/18/new-york-knicks-celebration-viral-moments-shows/","id":"7370356"}]}},"broadcast_network":"ESPN","broadcast_networks":["ESPN"],"clock":"00:00","period":4,"period_id":"full_time"},"isEmbed":false,"isInAppWebview":false,"isGooglebot":false,"liveBlogId":"8jKUFvbSM6rv","isPageAdsEnabled":true,"theme":"legacy","storylineId":"jz73uwUlwB0q","isTAApp":false,"viewportFitCover":false,"liveBlogTitle":"How the dominant Knicks swept past sorry Cavaliers to make the 2026 NBA Finals","initialLiveBlogData":{"__typename":"LiveBlog","ad_unit_path":"/29390238/nyt/theathletic/basketball/nba","ad_targeting_params":{"__typename":"AdParameters","auth":null,"byline":null,"coll":"nba","id":"8jKUFvbSM6rv","keywords":"EffNbicd5T2fzCW3","org":"knicks,cavaliers","tags":"live,nba","typ":"livebl"},"byline_linkable":{"__typename":"LinkableString","raw_string":"The Athletic NBA Team ","web_linked_string":"The Athletic NBA Team "},"byline_authors":[{"__typename":"Staff","avatar_uri":"https://static01.nyt.com/athletic/uploads/wp/2025/09/02075443/ATHLETIC-LIVE-TEAM.png","name":"The Athletic Live Team","description":"","twitter":null,"bluesky":null,"threads":null},{"__typename":"Staff","avatar_uri":"https://static01.nyt.com/athletic/uploads/wp/2024/10/18115425/Weese-Lukas-Headshot-101724-scaled-e1729266914606.jpg","name":"Lukas Weese","description":"Staff Writer, Live","twitter":"Weesesports","bluesky":null,"threads":null},{"__typename":"Staff","avatar_uri":"https://static01.nyt.com/athletic/uploads/wp/2024/06/17084923/Michael-Bailey.png","name":"Michael Bailey","description":"Senior Writer, Live","twitter":"michaeljbailey","bluesky":"michaeljbailey.bsky.social","threads":"mrmichaeljbailey"}],"createdAt":1779630062280,"description":"New York made history to clinch a first Eastern Conference championship since 1999. ","enable_discuss_tab":false,"game_id":"EffNbicd5T2fzCW3","is_unlocked":false,"free_apron_state":"expanded","id":"8jKUFvbSM6rv","images":[{"__typename":"Image","credits":"Getty Images","imageCdnUri":"https://cdn-media.theathletic.com/8jKUFvbSM6rv_0PViFUOkhYyZ_1440x960.jpg","imageHeight":960,"imageUri":"https://theathletic-media-production.s3-us-west-2.amazonaws.com/8jKUFvbSM6rv_0PViFUOkhYyZ_1440x960.jpg","imageWidth":1440,"caption":"The Knicks celebrate their Eastern Conference championship.","alt_text":"The Knicks celebrate their Eastern Conference championship."}],"lastActivityAt":1779787418349,"match_widgets":["lineup","game_details","related_content","related_matches","standings","match_stats"],"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","metadata":{"__typename":"LiveBlogMetadata","about":{"__typename":"LiveBlogMetadataAbout","endDate":1779789600000,"location":{"__typename":"LiveBlogMetadataAboutLocation","address":null,"name":"Cleveland, Ohio "},"name":"Knicks vs. Cavaliers live updates","sameAs":null,"startDate":1779732000000}},"posts":{"__typename":"LiveBlogPostsConnection","initialPostStatus":null,"items":[{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/A2kYctnHhgmP/","attachments":[{"__typename":"LiveBlogPostAttachment","html":null,"id":"7307873","image_uri":"https://static01.nyt.com/athletic/uploads/wp/2026/05/25214147/GettyImages-2277632786-1024x683.jpg","short_title":"New York Knicks punch ticket to NBA Finals for first time in 27 years","title":"New York Knicks punch ticket to NBA Finals for first time in 27 years","type":"article","url":"https://www.nytimes.com/athletic/7307873/2026/05/25/knicks-win-game-4-cavs-sweep-takeaways-nba-playoffs/","fan_zone_card":null,"comment":null,"game":null,"tournament":null,"match":null}],"body":"\u003cp\u003e\u003cstrong\u003eThe Knicks have reached the NBA Finals for the first time since 1999, as they demolished the Cavaliers with a Game 4 rout in Cleveland.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eNew York’s 130-93 win completed a historic sweep, with all four games won by double digits and Jalen Brunson awarded the series MVP.\u003c/p\u003e\u003cp\u003eBut Game 4 was particularly painful for Cleveland, who looked forlorn and defensively accommodating throughout. \u003c/p\u003e\u003cp\u003eThe Knicks now wait to see whether the Oklahoma City Thunder or San Antonio Spurs come out on top in a Western Conference finals series tied up 2-2.\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eShare your thoughts:\u003c/strong\u003e \u003ca href=\"mailto:live@theathletic.com\" target=_blank rel=\"nofollow noopener noreferrer\"\u003elive@theathletic.com\u003c/a\u003e\u003c/li\u003e\u003c/ul\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779632123777,"id":"A2kYctnHhgmP","images":[],"is_pinned":true,"publishedAt":1779732480000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"Knicks sweep Cavs with Game 4 dominance  ","tweets":[],"type":"liveBlogPost","updatedAt":1779768986729,"user":{"__typename":"Staff","id":"2372646","name":"Michael Bailey","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/06/17084923/Michael-Bailey.png","fullDescription":"Senior Writer, Live","description":"Senior Writer, Live","slug":"michael-bailey","twitter":"michaeljbailey","bluesky":"michaeljbailey.bsky.social","threads":"mrmichaeljbailey"},"video_block":null},{"__typename":"LiveBlogDropzone","dropzone_id":"0-1","id":"bb810c5d-26a1-4256-87da-79641bede902","type":"LiveBlogDropzone"},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/BHRlBNAu0Ilb/","attachments":[],"body":"\u003cp\u003eAnd now the Knicks rest and watch.\u003c/p\u003e\u003cp\u003eWe’ve tipped into Tuesday, May 26 on the east coast. The Thunder and Spurs play Game 5 in the Western Conference finals tonight, with Game 6 scheduled for Thursday and a potential Game 7 on Saturday.\u003c/p\u003e\u003cp\u003eGame 1 of the NBA Finals is a week today.\u003c/p\u003e\u003cp\u003eIt’s going to be a wild ride from here.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779768665764,"id":"BHRlBNAu0Ilb","images":[],"is_pinned":false,"publishedAt":1779770400000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"All eyes on the west","tweets":[],"type":"liveBlogPost","updatedAt":1779770400374,"user":{"__typename":"Staff","id":"2372646","name":"Michael Bailey","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/06/17084923/Michael-Bailey.png","fullDescription":"Senior Writer, Live","description":"Senior Writer, Live","slug":"michael-bailey","twitter":"michaeljbailey","bluesky":"michaeljbailey.bsky.social","threads":"mrmichaeljbailey"},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/AcwPxCcdvaRH/","attachments":[],"body":"\u003cp\u003eJason Jones gave \u003cstrong\u003eMike Brown\u003c/strong\u003e a wonderful and well-deserved shoutout earlier, and I think it’s also worth mentioning that not only has Brown responded to his exile from Sacramento becoming the coach who got the Knicks back to the NBA Finals — but his former starting point guard, \u003cstrong\u003eDe’Aaron Fox\u003c/strong\u003e, is two wins away from meeting him there. \u003c/p\u003e\u003cp\u003eLong live the 2023 Kings.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779769274004,"id":"AcwPxCcdvaRH","images":[{"__typename":"Image","alt_text":null,"credits":"Getty Images","imageCdnUri":"https://cdn-media.theathletic.com/AcwPxCcdvaRH_MRm0b7oc926K_1440x959.jpg","image_height":959,"image_width":1440,"caption":null}],"is_pinned":false,"publishedAt":1779770100000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=AcwPxCcdvaRH\u0026type=live_blog\u0026m=1779770114878","title":"Kings among men","tweets":[],"type":"liveBlogPost","updatedAt":1779770114878,"user":{"__typename":"Staff","id":"22834540","name":"Austin Green","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2025/05/30104154/Green-Austin-Headshot-060225.jpg","fullDescription":"Staff Writer, Live","description":"Staff Writer, Live","slug":"austin-green","twitter":"AustinGreen44","bluesky":null,"threads":"austmgreen"},"video_block":null},{"__typename":"LiveBlogPickem","id":"a2cf4b41-33f9-454b-9c86-d7caef26d10f","type":"LiveBlogPickem"},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/V3eSAZfkVRSm/","attachments":[{"__typename":"LiveBlogPostAttachment","html":"\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003e“Genuinely, I do feel like we are the better team,” - James Harden after the Cavs were swept by the Knicks 🫨🫨🫨 \u003ca href=\"https://t.co/JtDk8A7D2F\"\u003epic.twitter.com/JtDk8A7D2F\u003c/a\u003e\u003c/p\u003e\u0026mdash; ESPN Cleveland (@ESPNCleveland) \u003ca href=\"https://twitter.com/ESPNCleveland/status/2059116208331342062?ref_src=twsrc%5Etfw\"\u003eMay 26, 2026\u003c/a\u003e\u003c/blockquote\u003e\n\n","id":"2059116208331342062","image_uri":null,"short_title":null,"title":null,"type":"twitter","url":"https://x.com/ESPNCleveland/status/2059116208331342062","fan_zone_card":null,"comment":null,"game":null,"tournament":null,"match":null}],"body":"\u003cp\u003eAs one of the replies to this clip says, does this mean the Cleveland Cavaliers were also genuinely — as well as analytically — better than the Knicks?\u003c/p\u003e\u003cp\u003eProbably one for the 2026-27 NBA regular season now, James. \u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779769495587,"id":"V3eSAZfkVRSm","images":[],"is_pinned":false,"publishedAt":1779769800000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"","tweets":[],"type":"liveBlogPost","updatedAt":1779769814243,"user":{"__typename":"Staff","id":"2372646","name":"Michael Bailey","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/06/17084923/Michael-Bailey.png","fullDescription":"Senior Writer, Live","description":"Senior Writer, Live","slug":"michael-bailey","twitter":"michaeljbailey","bluesky":"michaeljbailey.bsky.social","threads":"mrmichaeljbailey"},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/mDxKZwasKLwo/","attachments":[],"body":"\u003cp\u003eI’m not running a caption competition tonight but if I was … this would be the image.\u003c/p\u003e\u003cp\u003eAd if you did fancy submitting a caption, the inbox is always open: \u003cstrong\u003e\u003ca href=\"mailto:live@theathletic.com\" target=_blank rel=\"nofollow noopener noreferrer\"\u003elive@theathletic.com\u003c/a\u003e\u003c/strong\u003e\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779768386602,"id":"mDxKZwasKLwo","images":[{"__typename":"Image","alt_text":null,"credits":"Getty Images","imageCdnUri":"https://cdn-media.theathletic.com/mDxKZwasKLwo_7jb0RFpDc5nS_1440x960.jpg","image_height":960,"image_width":1440,"caption":null}],"is_pinned":false,"publishedAt":1779769500000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=mDxKZwasKLwo\u0026type=live_blog\u0026m=1779769513810","title":"Add your captions!","tweets":[],"type":"liveBlogPost","updatedAt":1779769513810,"user":{"__typename":"Staff","id":"2372646","name":"Michael Bailey","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/06/17084923/Michael-Bailey.png","fullDescription":"Senior Writer, Live","description":"Senior Writer, Live","slug":"michael-bailey","twitter":"michaeljbailey","bluesky":"michaeljbailey.bsky.social","threads":"mrmichaeljbailey"},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/VXU6fNseAjul/","attachments":[{"__typename":"LiveBlogPostAttachment","html":"\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003ejob’s not done. \u003ca href=\"https://t.co/aAjZPB8Wed\"\u003epic.twitter.com/aAjZPB8Wed\u003c/a\u003e\u003c/p\u003e\u0026mdash; NEW YORK KNICKS (@nyknicks) \u003ca href=\"https://twitter.com/nyknicks/status/2059113556755308733?ref_src=twsrc%5Etfw\"\u003eMay 26, 2026\u003c/a\u003e\u003c/blockquote\u003e\n\n","id":"2059113556755308733","image_uri":null,"short_title":null,"title":null,"type":"twitter","url":"https://x.com/nyknicks/status/2059113556755308733","fan_zone_card":null,"comment":null,"game":null,"tournament":null,"match":null}],"body":"\u003cp\u003eHere’s some of the immediate reaction from those Eastern Conference champion Knicks.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779768237478,"id":"VXU6fNseAjul","images":[],"is_pinned":false,"publishedAt":1779769200000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"","tweets":[],"type":"liveBlogPost","updatedAt":1779769213326,"user":{"__typename":"Staff","id":"2372646","name":"Michael Bailey","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/06/17084923/Michael-Bailey.png","fullDescription":"Senior Writer, Live","description":"Senior Writer, Live","slug":"michael-bailey","twitter":"michaeljbailey","bluesky":"michaeljbailey.bsky.social","threads":"mrmichaeljbailey"},"video_block":null},{"__typename":"LiveBlogDropzone","dropzone_id":"0-2","id":"deb3b930-f35e-4e77-955b-94f4aad3ac98","type":"LiveBlogDropzone"},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/6dSEx7bO7H4Z/","attachments":[],"body":"\u003cp\u003eNew York’s dominant run has made the franchise feel invincible. The Knicks dropped the first two of three games to the Hawks in the first round and have been on as dominant a postseason run as there has been in NBA history. They go into the NBA Finals having won 11 straight playoff games.\u003c/p\u003e\u003cp\u003eAs far as confidence goes, New York has plenty of it going into the sport’s most prestigious stage. They’ll need all the confidence they can get. The Knicks can beat either Oklahoma City or San Antonio, but it won’t be as easy as their path in the Eastern Conference has made it seem.\u003c/p\u003e\u003cp\u003eNeither the Thunder nor the Spurs has anyone in their starting lineup that the Knicks can hunt defensively. The Hawks had\u003cstrong\u003e CJ McCollum\u003c/strong\u003e and \u003cstrong\u003eJalen Johnson\u003c/strong\u003e. The 76ers had \u003cstrong\u003eJoel Embiid\u003c/strong\u003e and \u003cstrong\u003eTyrese Maxey.\u003c/strong\u003e The Cleveland Cavaliers had \u003cstrong\u003eJames Harden\u003c/strong\u003e and \u003cstrong\u003eDonovan Mitchell\u003c/strong\u003e.\u003c/p\u003e\u003cp\u003eNew York’s potent offense is going to come back to a more realistic ground in the NBA Finals but it has the defense, just like whichever team it will face next, to make up for the inevitable drop off.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779764592148,"id":"6dSEx7bO7H4Z","images":[],"is_pinned":false,"publishedAt":1779768930000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"Takeaways: Can Knicks do this vs. Thunder or Spurs?","tweets":[],"type":"liveBlogPost","updatedAt":1779768942814,"user":{"__typename":"Staff","id":"43147","name":"James L. Edwards III","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2018/03/06200857/James-L.-Edwards-III.jpg","fullDescription":"Staff Writer, Knicks reporting from Rocket Arena","description":"Senior Writer","slug":"james-l-edwards-iii","twitter":"JLEdwardsIII","bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/Ij9PtNPHsu9v/","attachments":[],"body":"\u003cp\u003eThe final image of the 2025-26 \u003cstrong\u003eCleveland Cavaliers\u003c/strong\u003e will be the team giving up at the end of Game 3 and fans of the New York Knicks storming their arena for an embarrassing Game 4.\u003c/p\u003e\u003cp\u003eMaking the conference finals is a noteworthy accomplishment for a franchise that for years couldn’t make it out of the second round, but the Cavs’ performance in this series was disastrous. \u003c/p\u003e\u003cp\u003eCleveland ended its season by playing 14 games in 27 days and coach Kenny Atkinson spent most of this series talking about fatigue and how tired his players were. Certainly, it played a role in how lopsided this series was — but that can’t be the excuse.\u003c/p\u003e\u003cp\u003eSomething has to change. But what? \u003c/p\u003e\u003cp\u003eThe Cavs are boxed in by their payroll and previous roster decisions. Nevertheless, the unvarnished truth is the team with the league’s highest payroll quit on their own floor to end their season. \u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779764754670,"id":"Ij9PtNPHsu9v","images":[{"__typename":"Image","alt_text":null,"credits":"Imagn Images","imageCdnUri":"https://cdn-media.theathletic.com/Ij9PtNPHsu9v_WE8O6UlUgW9w_1440x959.jpg","image_height":959,"image_width":1440,"caption":null}],"is_pinned":false,"publishedAt":1779768618000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=Ij9PtNPHsu9v\u0026type=live_blog\u0026m=1779768627254","title":"Takeaways: The Cavs quit","tweets":[],"type":"liveBlogPost","updatedAt":1779768627254,"user":{"__typename":"Staff","id":"11359","name":"Jason Lloyd","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2020/04/14194557/HS_Square_0050_20200227Lloyd-Jason0364_bw.jpg","fullDescription":"Senior Columnist reporting from Rocket Arena","description":"Senior Columnist \u0026 EIC","slug":"jason-lloyd","twitter":"ByJasonLloyd","bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/xknIbjR5hz5U/","attachments":[],"body":"\u003cp\u003e\u003cstrong\u003eKarl-Anthony Towns\u003c/strong\u003e took 11 shots and yet, no one will sit here to complain about his lack of involvement. \u003c/p\u003e\u003cp\u003eThe Knicks wrecked the Cavaliers because of his — as he and Mike Brown have put it — “sacrifice.” Towns isn’t shooting as much. He continues to score efficiently. His passing is through the roof. And it’s transformed the Knicks offense in the process.\u003c/p\u003e\u003cp\u003eFor all the flak Towns gets about not being a malleable enough player, he continues to win. This is his third consecutive conference finals appearance, the first with the Minnesota Timberwolves and the last two with the Knicks. \u003c/p\u003e\u003cp\u003eNow, he’s on the way to the NBA Finals for the first time.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779764649413,"id":"xknIbjR5hz5U","images":[{"__typename":"Image","alt_text":null,"credits":"Imagn Images","imageCdnUri":"https://cdn-media.theathletic.com/xknIbjR5hz5U_esX55nKjLqv0_1440x960.jpg","image_height":960,"image_width":1440,"caption":null}],"is_pinned":false,"publishedAt":1779768300000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=xknIbjR5hz5U\u0026type=live_blog\u0026m=1779768311685","title":"Takeaways: Towns proves he’s a winner","tweets":[],"type":"liveBlogPost","updatedAt":1779768311685,"user":{"__typename":"Staff","id":"742841","name":"Fred Katz","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2018/09/21185530/Katz-Fred-Headshot-092018.jpg","fullDescription":"Staff Writer, Knicks reporting from Rocket Arena","description":"Senior Writer","slug":"fred-katz","twitter":"FredKatz","bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/gFP80iH9gDwh/","attachments":[],"body":"\u003cp\u003eSmall guards aren’t supposed to be able to win in the modern NBA.\u003c/p\u003e\u003cp\u003eBut \u003cstrong\u003eJalen Brunson \u003c/strong\u003ekeeps creating his own legacy. \u003c/p\u003e\u003cp\u003eWatch my video on the Knicks’ star. \u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779764120427,"id":"gFP80iH9gDwh","images":[],"is_pinned":false,"publishedAt":1779767940000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"","tweets":[],"type":"liveBlogPost","updatedAt":1779767951024,"user":{"__typename":"Staff","id":"26431119","name":"Esfandiar Baraheni","avatarUri":null,"fullDescription":"","description":"","slug":"esfandiar-baraheni","twitter":null,"bluesky":null,"threads":null},"video_block":{"__typename":"LiveBlogPostVideoBlock","ad_unit_path":"/29390238/nyt/theathletic/basketball/nba","video_stream":{"__typename":"VideoStream","id":"JkSqnuZ6hrMzKYk","author":"Esfandiar Baraheni","captions_available":false,"created_at":1779364679249,"description":"Esfandiar Baraheni breaks down Jalen Brunson's unprecedented playoff performances despite being an undersized guard.  ","duration_ms":252736,"ratio":{"__typename":"VideoStreamRatio","horizontal":16,"vertical":9},"live_stream_url_dash":null,"restricted_countries":["BI","BY","CD","CF","CU","IQ","IR","KP","LB","LY","ML","NI","RU","SD","SO","SS","SY","UA","VE","YE","ZW"],"restricted_countries_mode":"block","share_url":"https://www.nytimes.com/athletic/video/JkSqnuZ6hrMzKYk?source=athletic_user_shared_video","stream_url_dash":"https://video.nyt.com/athletic/streams/JkSqnuZ6hrMzKYk/4dEGuzIZdmAN/4dEGuzIZdmAN.mpd","stream_url_hls":"https://video.nyt.com/athletic/streams/JkSqnuZ6hrMzKYk/4dEGuzIZdmAN/4dEGuzIZdmAN.m3u8","thumbnail_url":"https://cdn-media.theathletic.com/video-stream/auto-thumbnail/JkSqnuZ6hrMzKYk/4dEGuzIZdmAN.0000000.jpg","title":"How Jalen Brunson is creating his own legacy","transcript_url":"https://video.nyt.com/athletic/streams/JkSqnuZ6hrMzKYk/4dEGuzIZdmAN/transcript.json","video_stream_mode":"VOD"}}},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/vKigkqlVOVs9/","attachments":[],"body":"\u003cp\u003eThis Knicks regime’s first front-office hire was a little-known salary cap aficionado in Cleveland, \u003cstrong\u003eBrock Aller\u003c/strong\u003e.\u003c/p\u003e\u003cp\u003eLeon Rose might be first in charge. William Wesley might be second. In 2020, Scott Perry was third; now, it’s Gersson Rosas. But Aller, an obsessor of the margins, someone who former Cavaliers lead executive David Griffin dubbed a “diabolical genius,” makes more trade calls than anyone else in the organization.\u003c/p\u003e\u003cp\u003eAnd Aller adores his precious draft picks. One time, shortly after he joined the Knicks, Aller left an empty pizza box in his office for a curiously long time. A joke emerged in the building: That box must be where he stored the Knicks’ valuable first-rounders.\u003c/p\u003e\u003cp\u003eThe Mavericks, even with the Knicks all-in on \u003cstrong\u003eJalen Brunson\u003c/strong\u003e, could not flip the lid of that pizza box.\u003c/p\u003e\u003cp\u003eFour months later, after Brunson helped the Mavs to the conference finals, after Tom Thibodeau had hired Rick Brunson, they were rewarded.\u003c/p\u003e\u003cp\u003eAller swindled deal after deal on 2022 draft night, garnering future draft picks and getting off enough salary to sign Brunson and more.\u003c/p\u003e\u003cp\u003eFour years later, Brunson is a three-time All-NBA member, the captain of a team that is just four victories short of inspiring New York City to combust.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779763705108,"id":"vKigkqlVOVs9","images":[{"__typename":"Image","alt_text":null,"credits":"Getty Images","imageCdnUri":"https://cdn-media.theathletic.com/vKigkqlVOVs9_ZLNxXrTf5dlU_1440x960.jpg","image_height":960,"image_width":1440,"caption":null}],"is_pinned":false,"publishedAt":1779767700000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=vKigkqlVOVs9\u0026type=live_blog\u0026m=1779767710626","title":"Who is Brock Aller? The Brunson dealmaker","tweets":[],"type":"liveBlogPost","updatedAt":1779767710626,"user":{"__typename":"Staff","id":"742841","name":"Fred Katz","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2018/09/21185530/Katz-Fred-Headshot-092018.jpg","fullDescription":"Staff Writer, Knicks reporting from Rocket Arena","description":"Senior Writer","slug":"fred-katz","twitter":"FredKatz","bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogDropzone","dropzone_id":"0-3","id":"dd06a311-d3ff-4655-93e1-c0d02c3c4e03","type":"LiveBlogDropzone"},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/SLAIO8fs8Zu2/","attachments":[{"__typename":"LiveBlogPostAttachment","html":null,"id":"7307698","image_uri":"https://static01.nyt.com/athletic/uploads/wp/2026/05/25221131/GettyImages-2270144782-scaled.jpg","short_title":"How the Knicks built an NBA Finals team: Patience, restraint and Jalen Brunson","title":"How the Knicks built an NBA Finals team: Patience, restraint and Jalen Brunson","type":"article","url":"https://www.nytimes.com/athletic/7307698/2026/05/25/knicks-nba-finals-jalen-brunson-james-dolan-leon-rose/","fan_zone_card":null,"comment":null,"game":null,"tournament":null,"match":null}],"body":"\u003cp\u003eFor years, people claimed the Knicks could never win as long as owner \u003cstrong\u003eJames Dolan\u003c/strong\u003e, who was more hands-on in his early stage of owning the franchise, was at the top. \u003c/p\u003e\u003cp\u003eThose allegations can no longer exist, though the irony is that it took Dolan looking elsewhere for the front office to operate more autonomously.\u003c/p\u003e\u003cp\u003eIn 2018, Dolan’s passion project began in Las Vegas, the construction of a high-tech, globe-like venue on the Strip that would change entertainment forever. The process of building his Sphere was bumpy. The venture climbed over budget, ending up with a $2.3-billion price tag, which diverted much of Dolan’s time to Vegas. Basketball dropped down the list of priorities.\u003c/p\u003e\u003cp\u003eThen the Sphere opened in 2023. He’s been around the team more since. Though his opinion was not the only factor in firing Tom Thibodeau just days after last year’s Eastern Conference finals, the deepest playoff run the Knicks had made in a quarter century, he spearheaded the coach’s ousting, \u003ca href=\"https://www.nytimes.com/athletic/7269240/2026/05/11/knicks-76ers-mike-brown-owner-james-dolan/\" target=_self\u003eas \u003cem\u003eThe Athletic’s\u003c/em\u003e Ian O’Connor detailed.\u003c/a\u003e\u003c/p\u003e\u003cp\u003eNow, after three clinical series and a constant stream of innovative, strategic adjustments from the new head coach, Mike Brown, the Knicks will play deeper into the spring than they have since Dolan’s first year at the helm.\u003c/p\u003e\u003cp\u003eThe wager paid off.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779763989244,"id":"SLAIO8fs8Zu2","images":[],"is_pinned":false,"publishedAt":1779767520000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"Dolan’s role in recent Knicks run","tweets":[],"type":"liveBlogPost","updatedAt":1779767570416,"user":{"__typename":"Staff","id":"742841","name":"Fred Katz","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2018/09/21185530/Katz-Fred-Headshot-092018.jpg","fullDescription":"Staff Writer, Knicks reporting from Rocket Arena","description":"Senior Writer","slug":"fred-katz","twitter":"FredKatz","bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/vX3fXNwNI9UK/","attachments":[],"body":"\u003cp\u003eOur Knicks writer \u003cem\u003eJames L. Edwards III \u003c/em\u003ecaptured the scene inside Rocket Arena in Cleveland after the New York Knicks advance to the NBA Finals.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779767228056,"id":"vX3fXNwNI9UK","images":[],"is_pinned":false,"publishedAt":1779767340000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"Scene inside Rocket Arena","tweets":[],"type":"liveBlogPost","updatedAt":1779767350090,"user":{"__typename":"Staff","id":"10161922","name":"Lukas Weese","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/10/18115425/Weese-Lukas-Headshot-101724-scaled-e1729266914606.jpg","fullDescription":"Staff Writer, Live","description":"Staff Writer, Live","slug":"lukas-weese","twitter":"Weesesports","bluesky":null,"threads":null},"video_block":{"__typename":"LiveBlogPostVideoBlock","ad_unit_path":"/29390238/nyt/theathletic/basketball/nba","video_stream":{"__typename":"VideoStream","id":"To3ZEX52QDV80xd","author":"James L. Edwards III","captions_available":false,"created_at":1779766958275,"description":"The scene inside Rocket Arena in Cleveland after the New York Knicks advance to the NBA Finals. ","duration_ms":10267,"ratio":{"__typename":"VideoStreamRatio","horizontal":16,"vertical":9},"live_stream_url_dash":null,"restricted_countries":["BI","BY","CD","CF","CU","IQ","IR","KP","LB","LY","ML","NI","RU","SD","SO","SS","SY","UA","VE","YE","ZW"],"restricted_countries_mode":"block","share_url":"https://www.nytimes.com/athletic/video/To3ZEX52QDV80xd?source=athletic_user_shared_video","stream_url_dash":"https://video.nyt.com/athletic/streams/To3ZEX52QDV80xd/PfnqhxXPJtVY/PfnqhxXPJtVY.mpd","stream_url_hls":"https://video.nyt.com/athletic/streams/To3ZEX52QDV80xd/PfnqhxXPJtVY/PfnqhxXPJtVY.m3u8","thumbnail_url":"https://cdn-media.theathletic.com/video-stream/auto-thumbnail/To3ZEX52QDV80xd/PfnqhxXPJtVY.0000000.jpg","title":"Scene at Rocket Arena after ECF","transcript_url":"https://video.nyt.com/athletic/streams/To3ZEX52QDV80xd/PfnqhxXPJtVY/transcript.json","video_stream_mode":"VOD"}}},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/9qBbmxxaKTvS/","attachments":[],"body":"\u003cp\u003e \u003c/p\u003e","breakout_article_id":"7308284","breakout_article":{"__typename":"Article","alt_text":"Fat Joe alleges the Cavaliers revoked his ticket to Game 4 of the East finals.","body":"\u003cp\u003eThe \u003ca href=\"https://www.nytimes.com/athletic/7308048/2026/05/26/kenny-atkinson-cavaliers-coach-status-2/\"\u003eCleveland Cavaliers\u003c/a\u003e weren’t going to allow New York’s celebrity row to commandeer their Rocket Arena courtside seats in Game 4 of the Eastern Conference finals.\u003c/p\u003e\n\u003cp\u003eNot Fat Joe, and not even Spike Lee.\u003c/p\u003e\n\u003cp\u003eThe rapper, whose real name is Joseph Cartagena, went on ESPN’s “NBA Today” in Cleveland before the game and said the organization revoked his ticket once it found out the purchaser was a known Knicks supporter.\u003c/p\u003e\n\u003cp\u003e“We had bought some courtside tickets to the game, and once they found out it was superfan Fat Joe, they were like, I can’t sit courtside. New York Knicks fans can’t sit courtside,” he said. “They took the tickets away courtside after we purchased it, so shame on you all.”\u003c/p\u003e\n\u003cp\u003eSpike Lee was also seen at the game in the second row, in what appeared to be a deliberate strategy from Cleveland to reserve the premier seats exclusively for Cavaliers fans. The organization did not immediately respond to an email request for comment from \u003cem\u003eThe Athletic. \u003c/em\u003e\u003c/p\u003e\n\u003cdiv data-ath-video-stream=\"nM68OwP81qX7tCE\"\u003e\u003c/div\u003e\n\u003cp\u003eOther Knicks fans on Twitter also lamented the Cavaliers’ efforts to limit the purchasing power of traveling Knicks fans. Jason Calacanis, a New York-based entrepreneur, posted on Twitter that Cleveland fans were forced to sign documentation stating they would not resell their courtside tickets to Knicks fans or face stern repercussions.\u003c/p\u003e\n\u003cp\u003e“(Cavaliers owner Dan Gilbert) has successfully blocked me from buying courtside seats,” Calacanis wrote. “Backstory: Dan forced fans to sign a DocuSign that they wouldn’t resell their courtside tickets, or they would face a lifetime ban from future Cavaliers games. I was told firsthand from ticket holders who wanted to sell them.”\u003c/p\u003e\n\u003cblockquote class=\"twitter-tweet\" data-width=\"550\" data-dnt=\"true\"\u003e\n\u003cp lang=\"en\" dir=\"ltr\"\u003eWell, I will be in the building for the 🧹 tonight… but \u003ca href=\"https://twitter.com/cavsdan?ref_src=twsrc%5Etfw\"\u003e@cavsdan\u003c/a\u003e has successfully blocked me from buying court side seats \u003c/p\u003e\n\u003cp\u003eBackstory: Dan forced fans to sign a Docusign that they wouldn’t resell their court side tickets or the would face a lifetime ban from \u003ca href=\"https://twitter.com/cavs?ref_src=twsrc%5Etfw\"\u003e@cavs\u003c/a\u003e games (I was…\u003c/p\u003e\n\u003cp\u003e\u0026mdash; @jason (@Jason) \u003ca href=\"https://twitter.com/Jason/status/2058947998051446808?ref_src=twsrc%5Etfw\"\u003eMay 25, 2026\u003c/a\u003e\u003c/p\u003e\u003c/blockquote\u003e\n\u003cp\u003e\u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e\u003c/p\u003e\n\u003cp\u003eEven still, the New York cheering contingent found its way to Rocket Arena in droves to watch the Knicks attempt to sweep the Cavaliers and make the franchise’s first NBA Finals appearance since 1999. Other celebrity Knicks superfans, Ben Stiller and Timothée Chalamet, were also on hand to watch New York take its shot at history.\u003c/p\u003e\n\u003cp\u003eThere were several viral videos circulating of former Knicks point guard Stephon Marbury hyping up a plane full of New York faithful headed to Cleveland.\u003c/p\u003e\n\u003cdiv data-ath-video-stream=\"8UfSNYYAZhsf7mx\"\u003e\u003c/div\u003e\n\u003cp\u003e“After the game,” Marbury said over the plane’s PA system, “After the game, not before the game, we go crazy!”\u003c/p\u003e\n\u003cp\u003eFans erupted in excitement as Marbury started a “Go New York Go!” chant on the plane.\u003c/p\u003e\n\u003cblockquote class=\"twitter-tweet\" data-width=\"550\" data-dnt=\"true\"\u003e\n\u003cp lang=\"en\" dir=\"ltr\"\u003eStephon Marbury fired up the Knicks fans on their flight to Cleveland 🔥 \u003ca href=\"https://t.co/tFVGHI8saF\"\u003epic.twitter.com/tFVGHI8saF\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u0026mdash; SNY Knicks (@sny_knicks) \u003ca href=\"https://twitter.com/sny_knicks/status/2059001702510907886?ref_src=twsrc%5Etfw\"\u003eMay 25, 2026\u003c/a\u003e\u003c/p\u003e\u003c/blockquote\u003e\n\u003cp\u003e\u003cscript async src=\"https://platform.twitter.com/widgets.js\" charset=\"utf-8\"\u003e\u003c/script\u003e\u003c/p\u003e\n\u003cp\u003eThe Knicks, who crushed Cleveland 130-93 in Game 4 to earn the sweep, have made an emphasis of closing out series in dominant fashion this playoff run. The Knicks averaged 138 points per game and a 39.3-point average margin of victory in their three series-clinching wins this postseason, including victories against the Atlanta Hawks and Philadelphia 76ers.\u003c/p\u003e\n\u003cp\u003eTheir celebrity row is eager for every chance to watch more history in person.\u003c/p\u003e\n\u003cp\u003eThey will have to wait until the series returns to New York to get back courtside, though.\u003c/p\u003e\n","id":"7308284","imageCdnUri":"https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg","permalink":"https://www.nytimes.com/athletic/7308284/2026/05/25/fat-joe-knicks-cavaliers-nba-playoffs-east-finals/","last_major_modification":1779766514000,"featured":false,"publishedAt":1779766514000,"title":"Fat Joe says Cavaliers revoked his ticket to Game 4 vs. Knicks: ‘Shame on you all’","byline_linkable":{"__typename":"LinkableString","raw_string":"Devon Henderson","app_linked_string":"\u003ca href=\"theathletic://author/29562990\"\u003eDevon Henderson\u003c/a\u003e","web_linked_string":"\u003ca href=\"https://www.nytimes.com/athletic/author/devon-henderson/\"\u003e\u003cu\u003eDevon Henderson\u003c/u\u003e\u003c/a\u003e"},"authors":[{"__typename":"ArticleAuthor","id":"29562990","author":{"__typename":"Staff","name":"Devon Henderson","slug":"devon-henderson","description":"Staff Writer","full_description":"Staff Writer","twitter":"HendersonDevon_","avatar_uri":"https://static01.nyt.com/athletic/uploads/wp/2025/09/24092939/BW-Devon-Henderson-Athletic-Photo-e1758720603116.jpg"}}],"user":{"__typename":"Staff","id":"29562990","name":"Devon Henderson","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2025/09/24092939/BW-Devon-Henderson-Athletic-Photo-e1758720603116.jpg","fullDescription":"Staff Writer","description":"Staff Writer","slug":"devon-henderson","twitter":"HendersonDevon_","bluesky":null,"threads":null},"post_type_id":"39","hero_video_stream":null},"createdAt":1779766795810,"id":"9qBbmxxaKTvS","images":[],"is_pinned":false,"publishedAt":1779767280000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"","tweets":[],"type":"liveBlogPost","updatedAt":1779767289936,"user":{"__typename":"Staff","id":"10630588","name":"Mike Prada","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2026/05/18112010/Prada-Mike-Headshot-051726.jpg","fullDescription":"Senior Editor, NBA","description":"Senior Editor","slug":"mike-prada","twitter":null,"bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/pb4ZVhBOG5O1/","attachments":[],"body":"\u003cp\u003eAn engaging interview from \u003cstrong\u003eKarl-Anthony Towns \u003c/strong\u003ejust now on ESPN Sportscenter.\u003c/p\u003e\u003cp\u003eHe admits the sweep and rest means there is a rust risk come Game 1 of the NBA Finals, whoever they’re playing. It’s something they have got to “figure out”.\u003c/p\u003e\u003cp\u003eBut the most compelling bits was his initial reaction to getting the Knicks to the NBA Finals:\u003c/p\u003e\u003cp\u003e💬 \u003cstrong\u003e\u003cem\u003e“I mean, it’s an honour to even be in this position … with the team I grew up cheering for, my favourite team, and be in this position wearing this jersey, and to see the word hope be brought back to the city because of us.\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003e“I can’t lie, it’s something that\u0026#x27;s emotional and it’s something I’ve always dreamed of, and you never know if it’s gonna come true. \u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\u003cem\u003e“You always think you got to play 2K to reach these heights, but I’m super happy we have this opportunity to be back somewhere where the Knicks deserve to be.”\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779767118835,"id":"pb4ZVhBOG5O1","images":[{"__typename":"Image","alt_text":"KAT emotional at Knicks achievement","credits":"Getty Images","imageCdnUri":"https://cdn-media.theathletic.com/pb4ZVhBOG5O1_TjpuJ4idHQpF_1440x960.jpg","image_height":960,"image_width":1440,"caption":""}],"is_pinned":false,"publishedAt":1779767118810,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=pb4ZVhBOG5O1\u0026type=live_blog\u0026m=1779767208906","title":"KAT emotional at Knicks achievement","tweets":[],"type":"liveBlogPost","updatedAt":1779767208906,"user":{"__typename":"Staff","id":"2372646","name":"Michael Bailey","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/06/17084923/Michael-Bailey.png","fullDescription":"Senior Writer, Live","description":"Senior Writer, Live","slug":"michael-bailey","twitter":"michaeljbailey","bluesky":"michaeljbailey.bsky.social","threads":"mrmichaeljbailey"},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/yrPe2bN15zGT/","attachments":[],"body":"\u003cp\u003eOne of the coolest scenes of the evening is watching those in the buses, cars — and yes, even NYFD trucks — driving down 7th Avenue, taking out their phones and recording the historic night as they pass by.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779766782128,"id":"yrPe2bN15zGT","images":[],"is_pinned":false,"publishedAt":1779766800000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"","tweets":[],"type":"liveBlogPost","updatedAt":1779766808869,"user":{"__typename":"Staff","id":"3694172","name":"Charlotte Carroll","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2019/12/04134340/Carroll-Charlotte-Headshot-112519.jpg","fullDescription":"Staff Writer, reporting from Midtown Manhattan","description":"Staff Writer","slug":"charlotte-carroll","twitter":"charlottecrrll","bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogDropzone","dropzone_id":"0-4","id":"952ede24-d784-4d60-a7dd-57c220105f14","type":"LiveBlogDropzone"},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/qr1QUbPztuON/","attachments":[],"body":"\u003cp\u003eNew York fell in love with the 1970-73 Knicks because of their likability … in how they played and how they carried themselves. \u003c/p\u003e\u003cp\u003eBrunson, KAT, Hart, Bridges, OG, Mike Brown, Shamet etc — they have that quality. \u003c/p\u003e\u003cp\u003eImportant part of this historic return to the NBA Finals.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779765433549,"id":"qr1QUbPztuON","images":[{"__typename":"Image","alt_text":null,"credits":"Getty Images","imageCdnUri":"https://cdn-media.theathletic.com/qr1QUbPztuON_qGXsg84OpZgQ_1440x960.jpg","image_height":960,"image_width":1440,"caption":null}],"is_pinned":false,"publishedAt":1779766680000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=qr1QUbPztuON\u0026type=live_blog\u0026m=1779766688574","title":"2026 Knicks similar to 1970s","tweets":[],"type":"liveBlogPost","updatedAt":1779766688574,"user":{"__typename":"Staff","id":"27708081","name":"Ian O'Connor","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2025/07/14155848/OConnor-Ian-Headshot-071425-e1752523153678.jpg","fullDescription":"Senior Writer","description":"Senior Writer","slug":"ian-oconnor","twitter":"Ian_OConnor","bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/cH8qsAYdroCO/","attachments":[],"body":"\u003cp\u003eThe Knicks have not beaten the Thunder since Nov. 21, 2022. The Thunder’s starters in that game: Shai Gilgeous-Alexander, Lu Dort, Josh Giddey, Kenrich Williams and Jeremiah Robinson-Earl. That’s historically been a rough matchup for New York.\u003c/p\u003e\u003cp\u003eThey did, however, play the Spurs well this season, beating them in the NBA Cup final and smashing them at Madison Square Garden on March 1 by 25 points. That was one of four regular-season losses the Spurs had after Feb. 1; two of the other three were nailbiters to Denver, while the third was in the season finale when the Spurs rested their key players.\u003c/p\u003e\u003cp\u003eThe Spurs beat the Knicks in late December, but only by two points and only because Julian Champagnie hit 11 3s.\u003c/p\u003e\u003cp\u003eSo if you’re a Knicks fan hoping for a title, I’d recommend rooting for the Spurs in the West finals.\u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779762386802,"id":"cH8qsAYdroCO","images":[],"is_pinned":false,"publishedAt":1779766500000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"Looking ahead to the Finals","tweets":[],"type":"liveBlogPost","updatedAt":1779766508255,"user":{"__typename":"Staff","id":"10630588","name":"Mike Prada","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2026/05/18112010/Prada-Mike-Headshot-051726.jpg","fullDescription":"Senior Editor, NBA","description":"Senior Editor","slug":"mike-prada","twitter":null,"bluesky":null,"threads":null},"video_block":null},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/75BtxtkUifO5/","attachments":[],"body":"\u003cp\u003eThere’s a huge police presence too, doing its best to keep Knicks fans off 7th Avenue. \u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779766365673,"id":"75BtxtkUifO5","images":[],"is_pinned":false,"publishedAt":1779766365637,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"","tweets":[],"type":"liveBlogPost","updatedAt":1779766390921,"user":{"__typename":"Staff","id":"3694172","name":"Charlotte Carroll","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2019/12/04134340/Carroll-Charlotte-Headshot-112519.jpg","fullDescription":"Staff Writer, reporting from Midtown Manhattan","description":"Staff Writer","slug":"charlotte-carroll","twitter":"charlottecrrll","bluesky":null,"threads":null},"video_block":{"__typename":"LiveBlogPostVideoBlock","ad_unit_path":"/29390238/nyt/theathletic/basketball/nba","video_stream":{"__typename":"VideoStream","id":"tEu9HVVJ8U7I8Ve","author":"Charlotte Carroll","captions_available":false,"created_at":1779766302598,"description":null,"duration_ms":4708,"ratio":{"__typename":"VideoStreamRatio","horizontal":9,"vertical":16},"live_stream_url_dash":null,"restricted_countries":["BI","BY","CD","CF","CU","IQ","IR","KP","LB","LY","ML","NI","RU","SD","SO","SS","SY","UA","VE","YE","ZW"],"restricted_countries_mode":"block","share_url":"https://www.nytimes.com/athletic/video/tEu9HVVJ8U7I8Ve?source=athletic_user_shared_video","stream_url_dash":"https://video.nyt.com/athletic/streams/tEu9HVVJ8U7I8Ve/C3WuV6nzEEoM/C3WuV6nzEEoM.mpd","stream_url_hls":"https://video.nyt.com/athletic/streams/tEu9HVVJ8U7I8Ve/C3WuV6nzEEoM/C3WuV6nzEEoM.m3u8","thumbnail_url":"https://cdn-media.theathletic.com/video-stream/auto-thumbnail/tEu9HVVJ8U7I8Ve/C3WuV6nzEEoM.0000000.jpg","title":"\"Knicks in 4\" chants as police keep fans off 7th Avenue","transcript_url":"https://video.nyt.com/athletic/streams/tEu9HVVJ8U7I8Ve/C3WuV6nzEEoM/transcript.json","video_stream_mode":"VOD"}}},{"__typename":"LiveBlogPost","permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/0tel0vAp9kfg/","attachments":[{"__typename":"LiveBlogPostAttachment","html":"\u003cblockquote class=\"twitter-tweet\"\u003e\u003cp lang=\"en\" dir=\"ltr\"\u003e.\u003ca href=\"https://twitter.com/NYCSanitation?ref_src=twsrc%5Etfw\"\u003e@NYCSanitation\u003c/a\u003e I\u0026#39;d like to report a sweep\u003c/p\u003e\u0026mdash; Mayor Zohran Kwame Mamdani (@NYCMayor) \u003ca href=\"https://twitter.com/NYCMayor/status/2059104003393200333?ref_src=twsrc%5Etfw\"\u003eMay 26, 2026\u003c/a\u003e\u003c/blockquote\u003e\n\n","id":"2059104003393200333?s=20","image_uri":null,"short_title":null,"title":null,"type":"twitter","url":"https://x.com/NYCMayor/status/2059104003393200333?s=20","fan_zone_card":null,"comment":null,"game":null,"tournament":null,"match":null}],"body":"\u003cp\u003eZohran Mamdani, New York City’s mayor, makes a funny comment on X about the Knicks sweep, tagging NYC Sanitation. \u003c/p\u003e","breakout_article_id":null,"breakout_article":null,"createdAt":1779765152410,"id":"0tel0vAp9kfg","images":[],"is_pinned":false,"publishedAt":1779766260000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=8jKUFvbSM6rv\u0026type=live_blog\u0026m=1779787418875","title":"NYC mayor weighs in","tweets":[],"type":"liveBlogPost","updatedAt":1779766267849,"user":{"__typename":"Staff","id":"10161922","name":"Lukas Weese","avatarUri":"https://static01.nyt.com/athletic/uploads/wp/2024/10/18115425/Weese-Lukas-Headshot-101724-scaled-e1729266914606.jpg","fullDescription":"Staff Writer, Live","description":"Staff Writer, Live","slug":"lukas-weese","twitter":"Weesesports","bluesky":null,"threads":null},"video_block":null}],"pageInfo":{"__typename":"PageInfo","currentPage":0,"hasNextPage":true,"hasPreviousPage":false},"total":203,"numNewPosts":0},"permalink":"https://www.nytimes.com/athletic/live-blogs/knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result/8jKUFvbSM6rv/","primaryLeague":{"__typename":"League","shortname":"NBA"},"publishedAt":1779732025381,"short_title":"Knicks vs. Cavaliers live reaction","slug":"knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result","sponsored_dropzone":null,"status":"live","storyline":{"__typename":"Storyline","id":"jz73uwUlwB0q","title":"Knicks Parade","items":[{"__typename":"StorylineArticle","title":"Recap","permalink":"https://www.nytimes.com/athletic/7373867/2026/06/18/knicks-parade-nba-championship-recap/","id":"7373867"},{"__typename":"StorylineArticle","title":"Brunson's Message to Critics","permalink":"https://www.nytimes.com/athletic/7373660/2026/06/18/jalen-brunson-critics-response-knicks-parade/","id":"7373660"},{"__typename":"StorylineArticle","title":"Celebrating The Win","permalink":"https://www.nytimes.com/athletic/7370356/2026/06/18/new-york-knicks-celebration-viral-moments-shows/","id":"7370356"}]},"tags":[{"__typename":"LeagueTag","id":"3","name":"National Basketball Association","shortname":"NBA","type":"league"},{"__typename":"TeamTag","id":"68","name":"Knicks","shortname":"NY","type":"team"},{"__typename":"TeamTag","id":"74","name":"Cavaliers","shortname":"CLE","type":"team"},{"__typename":"TopicTag","id":"20244","name":null,"shortname":"Live","type":"topic"},{"__typename":"TopicTag","id":"431","name":null,"shortname":"NBA","type":"topic"},{"__typename":"GameTag","id":"EffNbicd5T2fzCW3","name":null,"shortname":"Mon, 25 May - 8:00pm : New York Knicks @ Cleveland Cavaliers","type":"game"}],"title":"How the dominant Knicks swept past sorry Cavaliers to make the 2026 NBA Finals","tweets":[],"type":"liveBlog","updatedAt":1779787418875},"videoTranscripts":{"JkSqnuZ6hrMzKYk":"Did you notice that Jalen Brunson continues to beat the odds? It's not typical to see an undersized guard score as proficiently as he has and lead his team deep into the playoffs. But Brunson has done it again. Since signing with the Knicks, Brunson has averaged over 27 points in 4 straight playoff runs. And when you consider Captain Clutch is just 6'2 on a good day, that type of consistent offensive output in the postseason is just Not normal. There have been just 15 players in NBA history, 6'2 or shorter, to average 27 points or more in the playoffs in any given season. Only 7 of them did it more than once. And of those 7, only 5 of them did it for 10 games or longer. Of those 5, only Brunson and Steph Curry made it to at least the conference finals multiple times. Now, look, Steph obviously got over the hump, winning a championship in. Three of the 5 seasons he did that. And that's the next step both Brunson and the Knicks are attempting to take and trying to do that, all while changing their approach. Brunson has always been a prolific pick and roll and isolation scorer for the Knicks. Only Cade Cunningham and Tyrese Maxey have run more pick and rolls in the playoffs than Brunson, but he's been more efficient than both of them. He's in the top 10 in isolation possessions in the playoffs, but only SGA and Edwards have been more efficient. As a scorer in these actions. And while Brunson still runs a ton of pick and roll and isolations in these playoffs relative to the rest of the league, he's doing it less than ever before for the Knicks, all while working off of the ball more in spot-up situations. That's because the Knicks have found success putting the ball in Carl Anthony Towns' hands more often, asking him to be a playmaker in their flex actions and reducing Brunson's usage. Putting Brunson off the ball a little bit more. has helped him achieve the most efficient playoff run in his career. He's also taken the most catch and shoot 3s since he was a member of the Mavericks. That switch up is key to keeping an undersized guard at his best in the postseason. When you're already at a size disadvantage, you have to do things to keep teams guessing to stay ahead of the curve. Of course, the other very pressing thing to address when building around a small guard like Brunson is defense. The Knicks were 5. 0.3 points per 100 possessions, worse on defense when Brunson was on the floor. The second-worst mark on the team, ranking in the 14th percentile at his position during the regular season. It hasn't exactly been better in the playoffs. The Knicks are 9.2 points per 100 possessions, better on defense when Brunson is off of the floor. That said, to the Knicks' credit, they have tried to mask and hide Brunson on that end, empowering McHale Bridges. In particular, to guard on the perimeter and in space against good isolation scorers like Tyrese Maxey and CJ McCulley. They paired Brunson alongside Deuce McBride, a much more sturdy and stout point of attack defender, so that he could be provided more assistance on the perimeter. They've done enough to survive. And the key thing is that Brunson is doing more than enough offensively to the point where it's too hard to keep him off of the floor for any defensive limitations. Perhaps that's why Kats emerged. as a playmaker is so important because the Knicks can stagger their two offensive stars more often now, which leads to less time with those two guys getting targeted on defense at the same time. A few years ago, Hall of Famer Becky Hammond controversially told the world that she didn't believe Brunson could be the best player on the championship team because he was too small. And while he hasn't necessarily proven that particular statement wrong just yet, he is making it incredibly hard to ignore. Just how unstoppable he's been in the playoffs in his career, despite being undersized. Hammond's statement rings true in one way. It is incredibly rare to win a championship with the small guard as the guy in the modern NBA. It's basically just Curry who has done it this century. Brunson doing it would put him in rarefied air, not just in New York as a Knicks legend, but as a short king, even by NBA standards."},"serverNow":1790893893490,"socialVariant":null,"leagueRibbonSSRData":null},"statsigStore":{"edgeUser":{"country":"US","userAgent":"Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) Workbench/1.0","customIDs":{"ta_stable_id":"17908938931112552621","agent_id":"Kz-mgLxTGf4mCwKoIM0L1S"},"custom":{"surface":"ta-liveblog","deviceType":"desktop","browserName":"Safari","browserVersion":"","osName":"Mac","osVersion":"10.15.7","is_ta_app_webview":false},"statsigEnvironment":{"tier":"production"}},"experiments":{},"gates":{"adexp-taconnections-web-adslot-0826":false,"comments-sharing":false,"community-reactions-chat-enabled":false,"community-reactions-top-comment-enabled":false,"data-wrapper-in-articles-embeds-share":false,"hide-image-size":false,"mlb-season-replay":false,"open-comments-for-anonymous-users":true,"share-preview-image":false,"ta-web-one-tap-video-fullscreen":true,"web-can-regis-comment-react":true,"web-discuss-anon-open":true,"web-ssr-graphql-retry":true},"dynamicConfigs":{},"layers":{},"parameters":{}},"__N_SSP":true},"page":"/live-blogs/[...slug]","query":{"slug":["knicks-vs-cavaliers-live-updates-nba-playoffs-game-4-score-result","8jKUFvbSM6rv"]},"buildId":"PI2pPh_P7E--Sm3c256JN","assetPrefix":"/athletic","isFallback":false,"dynamicIds":[8159,57401,90892,39551,33507,28232,48797,90416,1421,86182],"gssp":true,"appGip":true,"scriptLoader":[]}</script></body></html>