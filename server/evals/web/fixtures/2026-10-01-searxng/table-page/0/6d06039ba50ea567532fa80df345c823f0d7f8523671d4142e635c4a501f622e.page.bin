-left-radius:0px;position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%;object-fit:cover" class="image-next-root" srcSet="https://static01.nyt.com/athletic/uploads/wp/2024/10/18115425/Weese-Lukas-Headshot-101724-scaled-e1729266914606.jpg?width=48&amp;quality=70&amp;auto=webp 1x, https://static01.nyt.com/athletic/uploads/wp/2024/10/18115425/Weese-Lukas-Headshot-101724-scaled-e1729266914606.jpg?width=96&amp;quality=70&amp;auto=webp 2x" src="https://static01.nyt.com/athletic/uploads/wp/2024/10/18115425/Weese-Lukas-Headshot-101724-scaled-e1729266914606.jpg?width=96&amp;quality=70&amp;auto=webp"/></noscript></span></div></div></div><div class="LiveBlogs_PostMeta__he7PA"><div class="LiveBlogs_LiveBlogNonRelativeTimestamp__K8_LD LiveBlogs_LiveBlogPostTimestamp__7iB7e"><time dateTime="2026-05-26T03:49:00.000Z">May 25, 2026<!-- --> at 11:49 PM<!-- --> EDT</time></div><div><div class="LiveBlogs_PostByline___riv_"><span class="nowrap">Lukas Weese</span><span>·</span><span><div class="LineClamp_LineClamp__OYTvW" style="-webkit-line-clamp:1">Staff Writer, Live</div></span></div></div></div></div></div><div class="LiveBlogs_PostActions__3TiJu"><div role="button" tabindex="0" style="cursor:pointer;display:inline-block" aria-label="Copy to Clipboard"><div class="LiveBlogs_PostLinkImage__9XocL post-link Image_Root--centered__66MeR"><span style="box-sizing:border-box;display:inline-block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative;max-width:100%"><span style="box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;max-width:100%"><img style="display:block;max-width:100%;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0" alt="" aria-hidden="true" src="data:image/svg+xml,%3csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20version=%271.1%27%20width=%2730%27%20height=%2730%27/%3e"/></span><img alt="" src="data:image/svg+xml;base64," decoding="async" data-nimg="intrinsic" class="image-next-root" style="border-top-left-radius:0px;border-top-right-radius:0px;border-bottom-right-radius:0px;border-bottom-left-radius:0px;position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%"/></span></div></div></div></div><h2 class="LiveBlogs_PostTitle__v911d">Scene inside Rocket Arena</h2><div class="LiveBlogs_LiveBlogVideoContainer___Hitd"><div class="AspectRatioBox_root__AKv5b" style="aspect-ratio:16 / 9;max-height:min(100%)"><div class="AspectRatioBox_inner__86C_2" style="aspect-ratio:16 / 9"><div class="VideoStreamPlayer_GridStack__2H0p2"></div></div></div></div><div id="liveblog-post-content" class="LiveBlogs_LiveBlogBody__9bgXM LiveBlogs_PostBody__HX1FM"><p>Our Knicks writer <em>James L. Edwards III </em>captured the scene inside Rocket Arena in Cleveland after the New York Knicks advance to the NBA Finals.</p></div></div></div></div></section><section class="LiveBlogs_LiveBlogContentSection__5VgoG"><div class="Fade_Base__oC3XN Fade_FadeIn__BlL3J" style="--fade-duration:1000ms"><div><div class="LiveBlogs_LiveBlogPostContainer__gp4u6 LiveBlogs_BottomBorder__SPKpV"><div class="Article_ArticleWrapper__U7T_4"><div class="Article_Wrapper__yUEgd article-container"><div id="article-container-grid" class="Article_ContainerGrid__fjaTe"><div class="LiveBlogs_PostHeader__HRJXp"><div class="LiveBlogs_PostBylineContainer__GCAVS"><a as="a" href="https://www.nytimes.com/athletic/author/devon-henderson/" class="LiveBlogs_PostHeader__HRJXp post-header-link"><div class="Grid_container__nUoFL Grid_alignItems-center__gLeMH Grid_justifyContent-flex-start__c8ll5 Grid_xsNumber12__7AIjd"><div class="Grid_item__tf6ss Grid_flexDirection-row__Wh_