next-root" srcSet="https://static01.nyt.com/athletic/uploads/wp/2025/09/24092939/BW-Devon-Henderson-Athletic-Photo-e1758720603116.jpg?width=48&amp;quality=70&amp;auto=webp 1x, https://static01.nyt.com/athletic/uploads/wp/2025/09/24092939/BW-Devon-Henderson-Athletic-Photo-e1758720603116.jpg?width=96&amp;quality=70&amp;auto=webp 2x" src="https://static01.nyt.com/athletic/uploads/wp/2025/09/24092939/BW-Devon-Henderson-Athletic-Photo-e1758720603116.jpg?width=96&amp;quality=70&amp;auto=webp"/></noscript></span></div></div></div></div><div><div class="LiveBlogs_LiveBlogNonRelativeTimestamp__K8_LD LiveBlogs_LiveBlogPostTimestamp__7iB7e"><time dateTime="2026-05-26T03:35:14.000Z">May 25, 2026<!-- --> at 11:35 PM<!-- --> EDT</time></div><div><div class="LiveBlogs_PostByline___riv_"><span id="articleByLineString"><a href="https://www.nytimes.com/athletic/author/devon-henderson/"><u>Devon Henderson</u></a></span><span>·</span><span><div class="LineClamp_LineClamp__OYTvW" style="-webkit-line-clamp:1">Staff Writer</div></span></div></div></div></div></a></div><div class="LiveBlogs_PostActions__3TiJu"><div role="button" tabindex="0" style="cursor:pointer;display:inline-block" aria-label="Copy to Clipboard"><div class="LiveBlogs_PostLinkImage__9XocL post-link Image_Root--centered__66MeR"><span style="box-sizing:border-box;display:inline-block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative;max-width:100%"><span style="box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;max-width:100%"><img style="display:block;max-width:100%;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0" alt="" aria-hidden="true" src="data:image/svg+xml,%3csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20version=%271.1%27%20width=%2730%27%20height=%2730%27/%3e"/></span><img alt="" src="data:image/svg+xml;base64," decoding="async" data-nimg="intrinsic" class="image-next-root" style="border-top-left-radius:0px;border-top-right-radius:0px;border-bottom-right-radius:0px;border-bottom-left-radius:0px;position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%"/></span></div></div></div></div><h2 class="LiveBlogs_PostTitle__v911d">Fat Joe says Cavaliers revoked his ticket to Game 4 vs. Knicks: ‘Shame on you all’</h2><div class="article-inline-image"><figure style="margin:0"><div class="LiveBlogs_LiveBlogImageContainer__nB2uM"><div class="LiveBlogs_LiveBlogImage__QNL1Y"><span style="box-sizing:border-box;display:block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative"><span style="box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;padding-top:63.57142857142857%"></span><img alt="Fat Joe alleges the Cavaliers revoked his ticket to Game 4 of the East finals." src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" decoding="async" data-nimg="responsive" class="image-next-root" style="border-top-left-radius:0px;border-top-right-radius:0px;border-bottom-right-radius:0px;border-bottom-left-radius:0px;position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%;object-fit:cover"/><noscript><img alt="Fat Joe alleges the Cavaliers revoked his ticket to Game 4 of the East finals." loading="lazy" decoding="async" data-nimg="responsive" style="border-top-left-radius:0px;border-top-right-radius:0px;border-bottom-right-radius:0px;border-bottom-left-radius:0px;position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%;object-fit:cover" class="image-next-root" sizes="
  (max-width: 600px) 90vw,
  (max-width: 700px) 100vw,
  700px
" srcSet="https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg?width=600&amp;quality=70&amp;auto=webp 600w, https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg?width=770&amp;quality=70&amp;auto=webp 770w, https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg?width=1000&amp;quality=70&amp;auto=webp 1000w, https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg?width=1248&amp;quality=70&amp;auto=webp 1248w, https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg?width=1440&amp;quality=70&amp;auto=webp 1440w, https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg?width=1920&amp;quality=70&amp;auto=webp 1920w" src="https://static01.nyt.com/athletic/uploads/wp/2026/05/25230309/GettyImages-2277577630.jpg?width=1920&amp;quality=70&amp;auto=webp"/></noscript></span></div></div><figcaption><span class="LiveBlogs_ImageCaption__WXzt7"> </span><span class="LiveBlogs_ImageCredit__DYVtG" style="padding-bottom:0"></span></figcaption></figure></div><div class="Article_ContentContainer__jBNW3 LiveBlogs_BreakoutArticleContentContainer__6DV_M article-content-container bodytext1"><p>The <a href="https://www.nytimes.com/athletic/7308048/2026/05/26/kenny-atkinson-cavaliers-coach-status-2/">Cleveland Cavaliers</a> weren’t going to allow New York’s celebrity row to commandeer their Rocket Arena courtside seats in Game 4 of the Eastern Conference finals.</p>
<p>Not Fat Joe, and not even Spike Lee.</p>
<p>The rapper, whose real name is Joseph Cartagena, went on ESPN’s “NBA Today” in Cleveland before the game and said the organization revoked his ticket once it found out the purchaser was a known Knicks supporter.</p></div></div></div><div class="Grid_item__tf6ss Grid_container__nUoFL Grid_alignItems-stretch__tvoyw Grid_justifyContent-center__QIP8k LiveBlogs_FullStoryContainer__4LPU7"><button style="min-width:76px" class="Button_Base__jCWBk Button_Bordered__WY465 Button_Fitted__KBZsa Button_LightPrimaryDefault__p1JSp LiveBlogs_FullStoryButton__0egbu" type="button">Full Story<span class="LiveBlogs_FullStoryIcon__ZoEWN"><svg style="font-size:20px;vertical-align:middle" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.79999 12.08L8.8711 8.00002L4.79999 3.92002L6.05332 2.66669L11.3867 8.00002L6.05332 13.3334L4.79999 12.08Z" fill="#121212"></path></svg></span></button></div></div></div></div></div></section><section class="LiveBlogs_LiveBlogContentSection__5VgoG"><div class="Fade_Base__oC3XN Fade_FadeIn__BlL3J" style="--fade-duration:1000ms"><div><div class="LiveBlogs_LiveBlogPostContainer__gp4u6 LiveBlogs_BottomBorder__SPKpV"><div class="LiveBlogs_PostHeader__HRJXp"><div class="LiveBlogs_PostBylineContainer__GCAVS"><div class="LiveBlogs_PostHeader__HRJXp post-header-link"><div class="Avatar_Base__PEyFI styled-image-with-fallback" style="display:flex;align-items:center;justify-content:center;position:relative;width:40px;height:40px"><div class="image" style="position:relative;width:40px;height:40px;visibility:hidden"><div class="Image_Root--centered__66MeR"><span style="box-sizing:border-box;display:inline-block;overflow:hidden;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;position:relative;max-width:100%"><span style="box-sizing:border-box;display:block;width:initial;height:initial;background:none;opacity:1;border:0;margin:0;padding:0;max-width:100%"><img style="display:block;max-