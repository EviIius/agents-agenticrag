ilia and Collectibles","url":"/sports-memorabilia-and-collectibles/","location":"primary","icon_path":"https://cdn-league-logos.theathletic.com/league-60-color@2x.png","is_tentpole":null,"subnav_items":[]},{"id":"hBPjeJnHcdYv","title":"Motorsports","url":"/motorsports/","location":"primary","icon_path":"https://cdn-league-logos.theathletic.com/league-28-color@2x.png","is_tentpole":null,"subnav_items":[{"id":"motorsports-home","title":"Home","url":"/motorsports/","icon_path":null,"location":"primary"},{"id":"sTlGbmkihUSU","title":"Podcasts","url":"/podcasts/motorsports/","icon_path":null,"location":"primary"}]},{"id":"fpwAvPBs9y77","title":"NASCAR","url":"/nascar/","location":"primary","icon_path":"https://cdn-league-logos.theathletic.com/league-58-color@2x.png","is_tentpole":null,"subnav_items":[]},{"id":"AjBHfdBj5ErF","title":"Women's Hockey","url":"/womens-hockey/","location":"primary","icon_path":"https://cdn-league-logos.theathletic.com/league-51-color@2x.png","is_tentpole":null,"subnav_items":[{"id":"womens-hockey-home","title":"Home","url":"/womens-hockey/","icon_path":null,"location":"primary"},{"id":"iW9n0YHf984E","title":"Scores \u0026 Schedule","url":"/womens-hockey/schedule/","icon_path":"https://cdn-media.theathletic.com/cropped-favicon-50x50.png","location":"primary"},{"id":"RxvI4S8BdUAv","title":"Standings","url":"/womens-hockey/standings/","icon_path":"https://cdn-media.theathletic.com/cropped-favicon-50x50.png","location":"primary"},{"id":"aaEO1DQEf81g","title":"Teams","url":"/womens-hockey/teams/","icon_path":"https://cdn-media.theathletic.com/cropped-favicon-50x50.png","location":"primary"}]},{"id":"JOxonSbCcYWH","title":"MMA","url":"/mma/","location":"primary","icon_path":"https://cdn-league-logos.theathletic.com/league-29-color@2x.png","is_tentpole":null,"subnav_items":[{"id":"mma-home","title":"Home","url":"/mma/","icon_path":null,"location":"primary"}]},{"id":"YdGMzhhYFcFb","title":"Boxing","url":"/boxing/","location":"primary","icon_path":"htt