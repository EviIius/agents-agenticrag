o-81-72x72.png","location":null},{"id":"team-90","title":"Clippers","url":"/nba/team/clippers/","icon_path":"team-logo-90-72x72.png","location":null},{"id":"team-92","title":"Kings","url":"/nba/team/sac-kings/","icon_path":"team-logo-92-72x72.png","location":null},{"id":"team-89","title":"Lakers","url":"/nba/team/lakers/","icon_path":"team-logo-89-72x72.png","location":null},{"id":"team-91","title":"Suns","url":"/nba/team/suns/","icon_path":"team-logo-91-72x72.png","location":null},{"id":"team-88","title":"Warriors","url":"/nba/team/warriors/","icon_path":"team-logo-88-72x72.png","location":null}]},{"id":"XlHuhfaeDgVX","title":"Scores \u0026 Schedule","url":"/nba/schedule/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"pza0wvNkMjXg","title":"Standings","url":"/nba/standings/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"0mVgGUMiL52Y","title":"The Bounce Newsletter","url":"/tag/the-bounce/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"8AyOGXPfBu0M","title":"NBA Draft","url":"/tag/nba-draft/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"QgP3NheOyzyI","title":"Podcasts","url":"/podcasts/nba/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"C3DNNhOGXrLX","title":"Fantasy","url":"/fantasy/basketball/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"GqcUNKswp9hs","title":"NBA Odds","url":"/nba/odds/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"vvLSLPFaWU3I","title":"NBA Picks","url":"/nba/picks/","location":"primary","icon_path":null,"is_tentpole":null,"subnav_items":[]},{"id":"nN1AmTLbJHUi","title":"Games To Circle On Your Calendar","url":"/7491910/2026/08/13/nba-best-games-knicks-spurs-thunder-cavalier-2026-27-season/","location":"secondary","icon_path":"https://cdn-media.theathletic.com/cropped-favicon-50x50.png","is_tentpole":false,"subnav_items":[]}]}},"statsigClientKey":"client-pCbgayUwsolDsLXA9dV4tQlvnXC94qXliEBNtbPfzn0","nytRoute":"ta-article","_sentryTraceData":"8ff8d8d3d3f742399a36137a8e336312-7edb7048e1192e1c-0","_sentryBaggage":"sentry-environment=production,sentry-release=theathletic-web,sentry-trace_id=8ff8d8d3d3f742399a36137a8e336312,sentry-sampled=false","article":{"__typename":"Article","ad_unit_path":"/29390238/nyt/theathletic/basketball/nba","ad_targeting_params":{"__typename":"AdParameters","auth":"lawmurray","byline":null,"coll":"nba","id":"7345644","keywords":null,"org":"knicks,spurs","tags":null,"typ":"art","prop":"athweb","plat":"","abs":"51008340,51006174,51009892,51009891,51004094,51002906,51009230,51007179,51009008,51000667,51004900,51008002,51007151,51007049,51000772,51005902,51003984,51007071,51001538,51009077,51001347,51002435,51009194,51000398,51000147,51006805,51004964,51004843,51000181,51004788,51004663,51001269,51005641,51006822,51005732,51005604,51006813,51006834,51007625,51007985,51000094,51009901,51008758,51008994,51008615,51005589,51003048,51008640,51004166,51009621","bsc":"84221001,74142228,87012038,74312458,74311451,74312507,84091001,76012002,74141221,76012001,74141219","gscat":"gs_t","als_test_clientside":"none_none_none_20260928144647","tt":null},"article_body":"\u003cp\u003eWith just over 30 seconds left in Game 3 of the 2026 NBA Finals, \u003ca href=\"https://www.nytimes.com/athletic/7349256/2026/06/10/knicks-spurs-nba-finals-game-4-score-results-takeaways/\"\u003eNew York Knicks\u003c/a\u003e guard Jalen Brunson grabbed a rebound and advanced into the frontcourt. The San Antonio Spurs led 111-105, so Brunson had to make something happen.\u003c/p\u003e\n\u003cp\u003eHe drove at San Antonio Spurs rookie Dylan Harper enough to send him inside the 3-point line, then stepped back and nailed a 3-pointer to cut New York\u0026#8217;s deficit in half. Those were \u003ca href=\"https://www.nytimes.com/athletic/7358507/2026/06/13/jalen-brunson-nba-mvp-knicks-championship/\"\u003eBrunson\u0026#8217;s\u003c/a\u003e final points and last shot attempt of Game 3.\u003c/p\u003e\n\u003cp\u003eBrunson finished with a team-high 32 points on 11-of-25 shooting from the field to go with five assists. But this time, unlike Games 1 and 2, the Knicks never completed the comeback. The Spurs scored on three of their final five possessions, holding onto their fourth-quarter lead and \u003ca href=\"https://www.nytimes.com/athletic/7343693/2026/06/08/knicks-spurs-nba-finals-game-3-score-results-takeaways/\"\u003eearning a 111-105 victory\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eAs the series shifts to Game 4 on Wednesday, New York has a glaring issue to resolve: How can they stop losing the Brunson minutes?\u003c/p\u003e\n\u003cp\u003eThrough three games of the NBA Finals, the Knicks are up 2-1 and outscoring the Spurs 321-314 overall. Yet, New York has been outscored by 13 points with Brunson on the floor, a notable stat given Brunson\u0026#8217;s role as the primary playmaker and shot creator while playing the most minutes among all Knicks (over 110, per NBA.com).\u003c/p\u003e\n\u003cdiv data-ath-video-stream=\"7J92WawN68xEJPJ\"\u003e\u003c/div\u003e\n\u003cp\u003eThat doesn\u0026#8217;t mean Brunson hasn\u0026#8217;t delivered in the series, though. In Game 1, he erased San Antonio\u0026#8217;s final lead with a second-chance 3-pointer with 1:50 remaining, then scored after a costly Victor Wembanyama turnover in the final minute. In Game 2, Brunson hit a game-tying basket with 39.3 seconds left before capitalizing on another Wembanyama miscue, drawing the foul that led to the go-ahead free throw and the game\u0026#8217;s final lead change.\u003c/p\u003e\n\u003cp\u003eBut the larger trend of the series is that New York has repeatedly fallen behind with Brunson directing the offense. The Spurs built first-quarter leads of 10, 10 and 12 points in Games 1 through 3, respectively. In Game 1, the Knicks were outscored by 10 points in Brunson\u0026#8217;s opening-quarter minutes. In Games 2 and 3, with Brunson playing all 12 minutes of the first quarter, New York was outscored 34-25 and 33-22. During those first quarters, Brunson has scored just 16 points in 35 minutes while missing 17-of-22 shots (22.7 percent) from the field with four assists and four turnovers.\u003c/p\u003e\n\u003cp\u003eThe Knicks, meanwhile, have managed only 88.0 points per 100 possessions in first quarters compared to 130.9 points per 100 possessions in 12 playoff games against the Eastern Conference. During the regular season, New York ranked fifth in first-quarter offensive efficiency (120.2 points per 100 possessions), its highest output in any period.\u003c/p\u003e\n\u003cp\u003eBrunson has also struggled to reach the rim when it\u0026#8217;s protected by Wembanyama, the Defensive Player of the Year. Brunson has instead settled for attempts inside the 3-point line against bigger defenders such as Stephon Castle, Julian Champagnie, Devin Vassell and Harper. Free throws aren\u0026#8217;t a given against a Spurs defense that allowed the NBA\u0026#8217;s lowest free-throw attempt rate.\u003c/p\u003e\n\u003cdiv data-ath-video-stream=\"NzrH7qrFgYVpSSl\"\u003e\u003c/div\u003e\n\u003cp\u003eAs consistently as the Knicks have struggled to begin games with Brunson pounding the rock, they have eaten up Spurs deficits just as consistently during Brunson\u0026#8217;s first trips to the bench. During Brunson\u0026#8217;s first rest in Game 1, the Knicks turned a 10-point deficit into a 3-point game. During his first rest in Game 2, the Knicks shaved a nine-point deficit to three. In Brunson\u0026#8217;s first rest in Game 3, the Knicks cut an 11-point deficit to four. Those three stretches account for just 15 minutes of basketball, but they are when the Knicks have gotten back into games. The Spurs made just 6 of 22 from the field during those collective spans.\u003c/p\u003e\n\u003cp\u003eKarl-Anthony Towns has been at the center of those turnarounds. In the 37:30 Towns has been off the floor in the series, New York has been outscored by 24 points.\u003c/p\u003e\n\u003cp\u003eNew York\u0026#8217;s best stretch with Brunson of the finals came after San Antonio took a 65-51 lead midway through the third quarter of Game 1. From that point on, Brunson scored 19 points on 7-of-13 shooting, and the Knicks outscored the Spurs by 24 points over the final 18.5 minutes of that game with Brunson on the floor. But even during that surge, Brunson wasn\u0026#8217;t carrying the entire offensive burden. Towns, Josh Hart and Miles McBride each bumped up their playmaking as New York generated offense from multiple sources.\u003c/p\u003e\n\u003cp\u003eThat balance has been harder to find since. In Game 2, the Knicks looked close to being on the other side of a blown lead, as San Antonio ripped a 21-5 fourth-quarter run featuring 207 seconds of scoreless basketball by the Knicks over six possessions. The last three of those possessions featured misses by Brunson, including back-to-back missed 3s. Even during New York\u0026#8217;s biggest positive stretch of the game, a 26-point swing that turned a 12-point deficit into a 14-point lead, the Knicks outscored the Spurs by 29 points with Towns on the floor.\u003c/p\u003e\n\n    \u003cdiv id=\"inline-graphic\"\u003e\n      \u003cignore\u003e\n        \u003cstyle\u003ea.showcase-link-container {\n  display: flex;\n  gap: 20px;\n  flex-direction: column;\n  align-items: center;\n  padding: 20px 0px;\n  border-top: 1px solid rgba(150, 150, 147, 0.4);\n  border-bottom: 1px solid rgba(150, 150, 147, 0.4);\n  text-decoration: none;\n  color: #121212;\n  cursor: pointer;\n\n  .showcase-link {\n    font-family: nyt-franklin;\n    font-size: 14px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 13.8px;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n  }\n\n  .showcase-link-image {\n    border-radius: 8px;\n    object-fit: cover;\n    width: 200px;\n    height: 150px;\n    margin: 0px;\n    @media (max-width: 600px) {\n      width: 120px;\n      height: 120px;\n    }\n  }\n\n  .showcase-link-inner-content {\n    display: flex;\n    flex-direction: row;\n    gap: 16px;\n    width: 100%;\n  }\n\n  .showcase-link-text-content {\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    justify-content: center;\n    @media (max-width: 600px) {\n      gap: 8px;\n    }\n  }\n\n  .showcase-link-title {\n    font-family: nyt-cheltenham;\n    font-size: 24px;\n    font-style: normal;\n    font-weight: 500;\n    line-height: 120%; /* 24px */\n    letter-spacing: 0.01px;\n    text-overflow: ellipsis;\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 3;\n    @media (max-width: 600px) {\n      font-size: 16px;\n    }\n  }\n\n  .showcase-link-excerpt {\n    font-family: nyt-imperial;\n    font-size: 16px;\n    font-style: normal;\n    font-weight: 400;\n    line-height: 139%; /* 19.46px */\n    color: #323232;\n    text-overflow: ellipsis;\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 4;\n    @media (max-width: 600px) {\n      font-size: 12px;\n      line-height: 121%;\n    }\n  }\n}\n\n.showcase-link-inputs {\n  .showcase-link-input {\n    width: 100%;\n    font-size: 1rem;\n    background-color: white;\n    margin-bottom: 12px;\n  }\n\n  .showcase-link-indent {\n    margin-left: 25px;\n  }\n\n  option {\n    width: 100%;\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .native-mobile a.showcase-link-container {\n    background-color: #121212;\n    color: #f0f0ee;\n    .showcase-link-excerpt {\n      color: #c4c4c0;\n    }\n  }\n}\n\u003c/style\u003e\n        \u003cscript\u003e\n            // Remove all onclicks on imgs for apps to prevent image zoom on click\n            document.querySelectorAll('.showcase-link-image').forEach((img) =\u003e img.removeAttribute('onclick'));\n        \u003c/script\u003e\n\n        \u003ca id=\"showcase-link-7343584\"\n          href=\"https://www.nytimes.com/athletic/7343584/2026/06/09/knicks-win-streak-resiliency-spurs-nba-finals/\"\n          class=\"showcase-link-container in-content-module-link testbed-shortcode\"\n          data-shortcode-id=\"101\"\n          data-shortcode-string=\"showcase-link\"\n          data-content-id=\"7343584\"\n          data-content-post-type=\"article\"\u003e\n\n          \u003cdiv class=\"showcase-link\"\u003eWhat You Should Read Next\u003c/div\u003e\n\n          \u003cdiv class=\"showcase-link-inner-content\"\u003e\n            \u003cimg src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/09023436/GettyImages-2280602909-scaled-e1780986939751-1024x683.jpg?width=400\u0026quality=70\" alt=\"The Knicks’ 13-game win streak is done. Now it’s time to show who they really are\" class=\"showcase-link-image\" width=\"200\" height=\"200\" loading=\"lazy\"\u003e\n            \u003cdiv class=\"showcase-link-text-content\"\u003e\n              \u003cdiv class=\"showcase-link-title\"\u003e\n                  The Knicks’ 13-game win streak is done. Now it’s time to show who they really are\n              \u003c/div\u003e\n              \u003cdiv class=\"showcase-link-excerpt\"\u003e\n                  The Knicks may have finally hit a speed bump in Game 3 against the Spurs, but their resiliency is what makes them most dangerous.\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/a\u003e\n      \u003c/ignore\u003e\n    \u003c/div\u003e\n  \n\u003cp class=\"isSelectedEnd\"\u003eThis is only relevant because the Knicks failed to erase a deficit in Game 3 the way they did in Games 1 and 2. Brunson wasn\u0026#8217;t the problem in the fourth quarter, though. New York\u0026#8217;s supporting cast was. Players not named Brunson or Anunoby missed 15 of their 16 shots in the final period, with the lone basket coming on a Mitchell Robinson putback of a Brunson miss.\u003c/p\u003e\n\u003cp class=\"isSelectedEnd\"\u003eThe bigger issue was Brunson\u0026#8217;s disastrous third quarter, which put the Knicks in a hole they couldn\u0026#8217;t escape. He missed 5-of-7 shots, including his final four attempts of the period, committed three turnovers while recording just a single basket and no assists, and picked up three fouls that all resulted in Spurs free throws. New York entered halftime with a seven-point lead but trailed by three when Brunson went to the bench with 4:29 remaining in the third because of foul trouble — a 10-point swing during his minutes. New York never led again.\u003c/p\u003e\n\u003cp class=\"isSelectedEnd\"\u003eThe good news for the Knicks is that they own a 2-1 series lead and have another home game ahead. The concern moving forward should be that New York has spent much of the finals trying to survive Brunson\u0026#8217;s minutes rather than winning them. That worked in Games 1 and 2. Not so much in Game 3.\u003c/p\u003e\n\u003cp\u003eIf New York wants a more comfortable path to a Game 4 victory, it will likely need a more efficient version of Brunson, one who can impact the game without dominating the ball against one of the NBA\u0026#8217;s toughest defenses.\u003c/p\u003e\n","article_body_desktop":"\u003cp\u003eWith just over 30 seconds left in Game 3 of the 2026 NBA Finals, \u003ca href=\"https://www.nytimes.com/athletic/7349256/2026/06/10/knicks-spurs-nba-finals-game-4-score-results-takeaways/\"\u003eNew York Knicks\u003c/a\u003e guard Jalen Brunson grabbed a rebound and advanced into the frontcourt. The San Antonio Spurs led 111-105, so Brunson had to make something happen.\u003c/p\u003e\u003cp\u003eHe drove at San Antonio Spurs rookie Dylan Harper enough to send him inside the 3-point line, then stepped back and nailed a 3-pointer to cut New York’s deficit in half. Those were \u003ca href=\"https://www.nytimes.com/athletic/7358507/2026/06/13/jalen-brunson-nba-mvp-knicks-championship/\"\u003eBrunson’s\u003c/a\u003e final points and last shot attempt of Game 3.\u003c/p\u003e\u003cdiv class=\"ad-container\"\u003e\u003cdiv class=\"ad-wrapper\"\u003e\u003cdiv class=ad-slug-container\u003e\u003cp class=\"ad-slug\"\u003eAdvertisement\u003c/p\u003e\u003c/div\u003e\u003cdiv id=\"mid1\" data-position=\"mid1\" class=\"ad place-ad\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cp\u003eBrunson finished with a team-high 32 points on 11-of-25 shooting from the field to go with five assists. But this time, unlike Games 1 and 2, the Knicks never completed the comeback. The Spurs scored on three of their final five possessions, holding onto their fourth-quarter lead and \u003ca href=\"https://www.nytimes.com/athletic/7343693/2026/06/08/knicks-spurs-nba-finals-game-3-score-results-takeaways/\"\u003eearning a 111-105 victory\u003c/a\u003e.\u003c/p\u003e\u003cp\u003eAs the series shifts to Game 4 on Wednesday, New York has a glaring issue to resolve: How can they stop losing the Brunson minutes?\u003c/p\u003e\u003cp\u003eThrough three games of the NBA Finals, the Knicks are up 2-1 and outscoring the Spurs 321-314 overall. Yet, New York has been outscored by 13 points with Brunson on the floor, a notable stat given Brunson’s role as the primary playmaker and shot creator while playing the most minutes among all Knicks (over 110, per NBA.com).\u003c/p\u003e\u003cdiv data-ath-video-stream=\"7J92WawN68xEJPJ\"\u003e\u003c/div\u003e\u003cp\u003eThat doesn’t mean Brunson hasn’t delivered in the series, though. In Game 1, he erased San Antonio’s final lead with a second-chance 3-pointer with 1:50 remaining, then scored after a costly Victor Wembanyama turnover in the final minute. In Game 2, Brunson hit a game-tying basket with 39.3 seconds left before capitalizing on another Wembanyama miscue, drawing the foul that led to the go-ahead free throw and the game’s final lead change.\u003c/p\u003e\u003cp\u003eBut the larger trend of the series is that New York has repeatedly fallen behind with Brunson directing the offense. The Spurs built first-quarter leads of 10, 10 and 12 points in Games 1 through 3, respectively. In Game 1, the Knicks were outscored by 10 points in Brunson’s opening-quarter minutes. In Games 2 and 3, with Brunson playing all 12 minutes of the first quarter, New York was outscored 34-25 and 33-22. During those first quarters, Brunson has scored just 16 points in 35 minutes while missing 17-of-22 shots (22.7 percent) from the field with four assists and four turnovers.\u003c/p\u003e\u003cdiv class=\"ad-container\"\u003e\u003cdiv class=\"ad-wrapper\"\u003e\u003cdiv class=ad-slug-container\u003e\u003cp class=\"ad-slug\"\u003eAdvertisement\u003c/p\u003e\u003c/div\u003e\u003cdiv id=\"mid2\" data-position=\"mid2\" class=\"ad place-ad\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cp\u003eThe Knicks, meanwhile, have managed only 88.0 points per 100 possessions in first quarters compared to 130.9 points per 100 possessions in 12 playoff games against the Eastern Conference. During the regular season, New York ranked fifth in first-quarter offensive efficiency (120.2 points per 100 possessions), its highest output in any period.\u003c/p\u003e\u003cp\u003eBrunson has also struggled to reach the rim when it’s protected by Wembanyama, the Defensive Player of the Year. Brunson has instead settled for attempts inside the 3-point line against bigger defenders such as Stephon Castle, Julian Champagnie, Devin Vassell and Harper. Free throws aren’t a given against a Spurs defense that allowed the NBA’s lowest free-throw attempt rate.\u003c/p\u003e\u003cdiv data-ath-video-stream=\"NzrH7qrFgYVpSSl\"\u003e\u003c/div\u003e\u003cp\u003eAs consistently as the Knicks have struggled to begin games with Brunson pounding the rock, they have eaten up Spurs deficits just as consistently during Brunson’s first trips to the bench. During Brunson’s first rest in Game 1, the Knicks turned a 10-point deficit into a 3-point game. During his first rest in Game 2, the Knicks shaved a nine-point deficit to three. In Brunson’s first rest in Game 3, the Knicks cut an 11-point deficit to four. Those three stretches account for just 15 minutes of basketball, but they are when the Knicks have gotten back into games. The Spurs made just 6 of 22 from the field during those collective spans.\u003c/p\u003e\u003cp\u003eKarl-Anthony Towns has been at the center of those turnarounds. In the 37:30 Towns has been off the floor in the series, New York has been outscored by 24 points.\u003c/p\u003e\u003cp\u003eNew York’s best stretch with Brunson of the finals came after San Antonio took a 65-51 lead midway through the third quarter of Game 1. From that point on, Brunson scored 19 points on 7-of-13 shooting, and the Knicks outscored the Spurs by 24 points over the final 18.5 minutes of that game with Brunson on the floor. But even during that surge, Brunson wasn’t carrying the entire offensive burden. Towns, Josh Hart\u0026nbsp;and Miles McBride each bumped up their playmaking as New York generated offense from multiple sources.\u003c/p\u003e\u003cdiv class=\"ad-container\"\u003e\u003cdiv class=\"ad-wrapper\"\u003e\u003cdiv class=ad-slug-container\u003e\u003cp class=\"ad-slug\"\u003eAdvertisement\u003c/p\u003e\u003c/div\u003e\u003cdiv id=\"mid3\" data-position=\"mid3\" class=\"ad place-ad\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cp\u003eThat balance has been harder to find since. In Game 2, the Knicks looked close to being on the other side of a blown lead, as San Antonio ripped a 21-5 fourth-quarter run featuring 207 seconds of scoreless basketball by the Knicks over six possessions. The last three of those possessions featured misses by Brunson, including back-to-back missed 3s. Even during New York’s biggest positive stretch of the game, a 26-point swing that turned a 12-point deficit into a 14-point lead, the Knicks outscored the Spurs by 29 points with Towns on the floor.\u003c/p\u003e\u003cdiv id=\"inline-graphic\"\u003e\n      \u003cignore\u003e\n        \u003cstyle\u003ea.showcase-link-container {\n  display: flex;\n  gap: 20px;\n  flex-direction: column;\n  align-items: center;\n  padding: 20px 0px;\n  border-top: 1px solid rgba(150, 150, 147, 0.4);\n  border-bottom: 1px solid rgba(150, 150, 147, 0.4);\n  text-decoration: none;\n  color: #121212;\n  cursor: pointer;\n\n  .showcase-link {\n    font-family: nyt-franklin;\n    font-size: 14px;\n    font-style: normal;\n    font-weight: 700;\n    line-height: 13.8px;\n    letter-spacing: 1.1px;\n    text-transform: uppercase;\n  }\n\n  .showcase-link-image {\n    border-radius: 8px;\n    object-fit: cover;\n    width: 200px;\n    height: 150px;\n    margin: 0px;\n    @media (max-width: 600px) {\n      width: 120px;\n      height: 120px;\n    }\n  }\n\n  .showcase-link-inner-content {\n    display: flex;\n    flex-direction: row;\n    gap: 16px;\n    width: 100%;\n  }\n\n  .showcase-link-text-content {\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    justify-content: center;\n    @media (max-width: 600px) {\n      gap: 8px;\n    }\n  }\n\n  .showcase-link-title {\n    font-family: nyt-cheltenham;\n    font-size: 24px;\n    font-style: normal;\n    font-weight: 500;\n    line-height: 120%; /* 24px */\n    letter-spacing: 0.01px;\n    text-overflow: ellipsis;\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 3;\n    @media (max-width: 600px) {\n      font-size: 16px;\n    }\n  }\n\n  .showcase-link-excerpt {\n    font-family: nyt-imperial;\n    font-size: 16px;\n    font-style: normal;\n    font-weight: 400;\n    line-height: 139%; /* 19.46px */\n    color: #323232;\n    text-overflow: ellipsis;\n    overflow: hidden;\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 4;\n    @media (max-width: 600px) {\n      font-size: 12px;\n      line-height: 121%;\n    }\n  }\n}\n\n.showcase-link-inputs {\n  .showcase-link-input {\n    width: 100%;\n    font-size: 1rem;\n    background-color: white;\n    margin-bottom: 12px;\n  }\n\n  .showcase-link-indent {\n    margin-left: 25px;\n  }\n\n  option {\n    width: 100%;\n  }\n}\n\n@media (prefers-color-scheme: dark) {\n  .native-mobile a.showcase-link-container {\n    background-color: #121212;\n    color: #f0f0ee;\n    .showcase-link-excerpt {\n      color: #c4c4c0;\n    }\n  }\n}\n\u003c/style\u003e\n        \u003cscript\u003e\n            // Remove all onclicks on imgs for apps to prevent image zoom on click\n            document.querySelectorAll('.showcase-link-image').forEach((img) =\u003e img.removeAttribute('onclick'));\n        \u003c/script\u003e\n\n        \u003ca id=\"showcase-link-7343584\" href=\"https://www.nytimes.com/athletic/7343584/2026/06/09/knicks-win-streak-resiliency-spurs-nba-finals/\" class=\"showcase-link-container in-content-module-link testbed-shortcode\" data-shortcode-id=\"101\" data-shortcode-string=\"showcase-link\" data-content-id=\"7343584\" data-content-post-type=\"article\"\u003e\n\n          \u003cdiv class=\"showcase-link\"\u003eWhat You Should Read Next\u003c/div\u003e\n\n          \u003cdiv class=\"showcase-link-inner-content\"\u003e\n            \u003cimg src=\"https://static01.nyt.com/athletic/uploads/wp/2026/06/09023436/GettyImages-2280602909-scaled-e1780986939751-1024x683.jpg?width=400\u0026amp;quality=70\" alt=\"The Knicks’ 13-game win streak is done. Now it’s time to show who they really are\" class=\"showcase-link-image\" width=\"200\" height=\"200\" loading=\"lazy\"\u003e\n            \u003cdiv class=\"showcase-link-text-content\"\u003e\n              \u003cdiv class=\"showcase-link-title\"\u003e\n                  The Knicks’ 13-game win streak is done. Now it’s time to show who they really are\n              \u003c/div\u003e\n              \u003cdiv class=\"showcase-link-excerpt\"\u003e\n                  The Knicks may have finally hit a speed bump in Game 3 against the Spurs, but their resiliency is what makes them most dangerous.\n              \u003c/div\u003e\n            \u003c/div\u003e\n          \u003c/div\u003e\n        \u003c/a\u003e\n      \u003c/ignore\u003e\n    \u003c/div\u003e\u003cp class=\"isSelectedEnd\"\u003eThis is only relevant because the Knicks failed to erase a deficit in Game 3 the way they did in Games 1 and 2. Brunson wasn’t the problem in the fourth quarter, though. New York’s supporting cast was. Players not named Brunson or Anunoby missed 15 of their 16 shots in the final period, with the lone basket coming on a Mitchell Robinson putback of a Brunson miss.\u003c/p\u003e\u003cp class=\"isSelectedEnd\"\u003eThe bigger issue was Brunson’s disastrous third quarter, which put the Knicks in a hole they couldn’t escape. He missed 5-of-7 shots, including his final four attempts of the period, committed three turnovers while recording just a single basket and no assists, and picked up three fouls that all resulted in Spurs free throws. New York entered halftime with a seven-point lead but trailed by three when Brunson went to the bench with 4:29 remaining in the third because of foul trouble — a 10-point swing during his minutes. New York never led again.\u003c/p\u003e\u003cp class=\"isSelectedEnd\"\u003eThe good news for the Knicks is that they own a 2-1 series lead and have another home game ahead. The concern moving forward should be that New York has spent much of the finals trying to survive Brunson’s minutes rather than winning them. That worked in Games 1 and 2. Not so much in Game 3.\u003c/p\u003e\u003cp\u003eIf New York wants a more comfortable path to a Game 4 victory, it will likely need a more efficient version of Brunson, one who can impact the game without dominating the ball against one of the NBA’s toughest defenses.\u003c/p\u003e\n","authors":[{"__typename":"ArticleAuthor","author":{"__typename":"Staff","first_name":"Law","name":"Law Murray","id":"6252267","avatar_uri":"https://static01.nyt.com/athletic/uploads/wp/2025/09/25123543/Murray-Law-Headshot-e1758818165187.jpg","bio":"Law Murray is a staff writer for The Athletic covering the NBA, based in Los Angeles. Law joined The Athletic in 2021 as a Clippers beat writer. Prior to joining The Athletic, he was an NBA editor at ESPN, a researcher at NFL Media and a contributor to DrewLeague.com and ClipperBlog. Law is from Philadelphia, Pa., and is a graduate of California University of Pennsylvania and the University of Southern California. When not playing basketball, Law is probably discussing the next Saturday Night Live episode.","role":"author","slug":"law-murray","twitter":"LawMurrayTheNU","bluesky":null,"threads":null,"fullDescription":"Staff Writer, Los Angeles"}}],"byline_linkable":{"__typename":"LinkableString","raw_string":"Law Murray","web_linked_string":"\u003ca href=\"https://www.nytimes.com/athletic/author/law-murray/\"\u003e\u003cu\u003eLaw Murray\u003c/u\u003e\u003c/a\u003e","app_linked_string":"\u003ca href=\"theathletic://author/6252267\"\u003eLaw Murray\u003c/a\u003e"},"city_ids":["4","32"],"chartbeat_authors":[{"__typename":"ArticleAuthor","author":{"__typename":"Staff","id":"6252267","name":"Law Murray","slug":"law-murray","twitter":"LawMurrayTheNU","bluesky":null,"threads":null,"bio":"Law Murray is a staff writer for The Athletic covering the NBA, based in Los Angeles. Law joined The Athletic in 2021 as a Clippers beat writer. Prior to joining The Athletic, he was an NBA editor at ESPN, a researcher at NFL Media and a contributor to DrewLeague.com and ClipperBlog. Law is from Philadelphia, Pa., and is a graduate of California University of Pennsylvania and the University of Southern California. When not playing basketball, Law is probably discussing the next Saturday Night Live episode.","description":"Staff Writer","knows_about":{"__typename":"AuthorKnowsAbout","teams":[{"__typename":"KnowsAboutItem","type":"team","name":"Los Angeles Clippers","url":"https://www.nytimes.com/athletic/nba/team/clippers/"}],"leagues":[{"__typename":"KnowsAboutItem","type":"league","name":"National Basketball Association","url":"https://www.nytimes.com/athletic/nba/"}],"cities":[{"__typename":"KnowsAboutItem","type":"city","name":"Los Angeles","url":"https://www.nytimes.com/athletic/location/losangeles/"}]}}}],"chartbeat_sections":"NBA,basketball","comment_count":35,"disable_comments":false,"entity_keywords":"New York Knicks, San Antonio Spurs, NBA","excerpt":"New York has spent much of the finals trying to survive Jalen Brunson's minutes rather than winning them.","featured":false,"game_id":null,"has_story_index":false,"hide_pickem":false,"hero_video_stream":null,"id":"7345644","image_uri":"https://static01.nyt.com/athletic/uploads/wp/2026/06/09210729/GettyImages-2280602691-1.jpg","image_uri_full":"https://static01.nyt.com/athletic/uploads/wp/2026/06/09210729/GettyImages-2280602691-1.jpg","image_caption":"Jalen Brunson has struggled in the opening frame of these NBA Finals, shooting only 22.7 percent in the first quarter.","image_credit":"Al Bello / Getty Images","image_alt_text":"Jalen Brunson attempts to dribble past Victor Wembanyama.","inferred_league_ids":["3"],"is_licensable":true,"is_teaser":false,"is_premier":false,"is_paid_post":false,"is_unpublished":null,"last_major_modification":1781101875000,"league_ids":["3"],"league_urls":"nba","lock_comments":false,"news_topics":"","permalink":"https://www.nytimes.com/athletic/7345644/2026/06/10/jalen-brunson-knicks-spurs-victor-wembanyama-first-quarter-nba-finals/","post_type_id":"1","primary_tag":"NBA","primary_league_details":{"__typename":"League","id":"3","shortname":"NBA","name":"National Basketball Association"},"published_at":1781089237000,"share_preview_url":"https://www.nytimes.com/shared/athletic/content-card.png?id=7345644\u0026type=article\u0026m=1781101875000","short_title":"The Knicks keep losing the Jalen Brunson minutes. Game 3 showed why that matters","storyline":{"__typename":"Storyline","id":"jz73uwUlwB0q","title":"Knicks Parade","items":[{"__typename":"StorylineArticle","title":"Recap","permalink":"https://www.nytimes.com/athletic/7373867/2026/06/18/knicks-parade-nba-championship-recap/","id":"7373867"},{"__typename":"StorylineArticle","title":"Brunson's Message to Critics","permalink":"https://www.nytimes.com/athletic/7373660/2026/06/18/jalen-brunson-critics-response-knicks-parade/","id":"7373660"},{"__typename":"StorylineArticle","title":"Celebrating The Win","permalink":"https://www.nytimes.com/athletic/7370356/2026/06/18/new-york-knicks-celebration-viral-moments-shows/","id":"7370356"}]},"story_type_tags":["Column","Reported Analysis"],"subscriber_score":null,"team_hex":"444444","team_ids":["68","86"],"team_urls":"knicks,spurs","display_tags":[{"__typename":"DisplayTags","name":"NBA","term_id":"3","term_type":"league_id","url":"/nba/"},{"__typename":"DisplayTags","name":"New York Knicks","term_id":"68","term_type":"team_id","url":"/nba/team/knicks/"},{"__typename":"DisplayTags","name":"San Antonio Spurs","term_id":"86","term_type":"team_id","url":"/nba/team/spurs/"}],"title":"The Knicks keep losing the Jalen Brunson minutes. How long can they survive it?"},"isPreview":false,"isPageAdsEnabled":true,"theme":"legacy","isInAppWebview":false,"isTeamChatEnabled":false,"isMobileAppUserAgent":false,"isTAApp":false,"taAppPlatform":null,"viewportFitCover":false,"geoipMap":"continent=NA,country=US,region=NC,gmt-offset=-400,latitude=35.060,longitude=-80.810,city=charlotte,postal-code=28277,area-code=704,metro=517,meridiem=PM","socialVariant":null,"experiments":{},"videoStreamProperties":[{"__typename":"VideoStream","id":"7J92WawN68xEJPJ","author":"Esfandiar Baraheni","captions_available":false,"created_at":1781034801541,"description":"Karl-Anthony Towns discusses his friendship with Jalen Brunson ahead of Game 4 of the NBA Finals.","duration_ms":57767,"live_stream_url_dash":null,"permalink":"https://www.nytimes.com/athletic/video/7J92WawN68xEJPJ/","ratio":{"__typename":"VideoStreamRatio","horizontal":9,"vertical":16},"restricted_countries":["BI","BY","CD","CF","CU","IQ","IR","KP","LB","LY","ML","NI","RU","SD","SO","SS","SY","UA","VE","YE","ZW"],"restricted_countries_mode":"block","stream_url_dash":"https://video.nyt.com/athletic/streams/7J92WawN68xEJPJ/X7QmSm9Dddpd/X7QmSm9Dddpd.mpd","stream_url_hls":"https://video.nyt.com/athletic/streams/7J92WawN68xEJPJ/X7QmSm9Dddpd/X7QmSm9Dddpd.m3u8","thumbnail_url":"https://cdn-media.theathletic.com/video-stream/auto-thumbnail/7J92WawN68xEJPJ/X7QmSm9Dddpd.0000000.jpg","title":"Karl-Anthony Towns discusses his friendship with Jalen Brunson","transcript_url":"https://video.nyt.com/athletic/streams/7J92WawN68xEJPJ/X7QmSm9Dddpd/transcript.json","video_stream_mode":"VOD"},{"__typename":"VideoStream","id":"NzrH7qrFgYVpSSl","author":"Dan Woike","captions_available":false,"created_at":1780985429685,"description":"Stephon Castle and Victor Wembanyama helped San Antonio avoid an 0-3 hole in the NBA Finals with a pair of clutch performances in a bounce back game. ","duration_ms":117248,"live_stream_url_dash":null,"permalink":"https://www.nytimes.com/athletic/video/NzrH7qrFgYVpSSl/","ratio":{"__typename":"VideoStreamRatio","horizontal":9,"vertical":16},"restricted_countries":["BI","BY","CD","CF","CU","IQ","IR","KP","LB","LY","ML","NI","RU","SD","SO","SS","SY","UA","VE","YE","ZW"],"restricted_countries_mode":"block","stream_url_dash":"https://video.nyt.com/athletic/streams/NzrH7qrFgYVpSSl/RvZ4q7rqxEuK/RvZ4q7rqxEuK.mpd","stream_url_hls":"https://video.nyt.com/athletic/streams/NzrH7qrFgYVpSSl/RvZ4q7rqxEuK/RvZ4q7rqxEuK.m3u8","thumbnail_url":"https://cdn-media.theathletic.com/video-stream/auto-thumbnail/NzrH7qrFgYVpSSl/RvZ4q7rqxEuK.0000000.jpg","title":"Takeaways: Spurs snap Knicks' 13-game playoff win streak, take Game 3 of NBA Finals","transcript_url":"https://video.nyt.com/athletic/streams/NzrH7qrFgYVpSSl/RvZ4q7rqxEuK/transcript.json","video_stream_mode":"VOD"}],"videoTranscripts":{"7J92WawN68xEJPJ":"Did he say that with Josh around or no? He did not. Josh was going to be jealous. And uh I think you know our friendship is built off respect you know we've had so much respect for each other um as opponents and now to be teammates, you know, spending, you know, true time with each other as teammates, you know, and uh I've always said, you know, we spend more time with each other than our families, our kids, so, um, to see who we truly are on a day to day basis and how we truly, you know. Treat people and the things that the media says, is it true? Is it not? and you're getting to see firsthand what the truth really is, um, you know, I, I'm glad I've been able to. Not only earned his respect even more as a basketball player but as a man and for him to uh appreciate the advice I give him in a daily, you know, in daily life and um things I see um. It means a lot.","NzrH7qrFgYVpSSl":"The playoffs offer unknowns. They rarely provide certainty, but game 3 was different since the Knicks made it here by winning the East. The first NBA Finals game in New York City since 1999 was always going to be an event. That was true before ticket prices skyrocketed. It was true before the Knicks took a 2-0 series lead in San Antonio, and it was true before the president decided to sit inside a suite and watch them play. All of that plus 13 wins in a row, and yeah, New York City was gonna show out. The moment, the scenes, the stakes, it was a given that Game 3 would provide. Some kind of defining moment for a legacy, and Monday, the Garden was the stage for Victor Wambayama and his Spurs, their team winning 115-111 for the first time in these NBA Finals. As the Knicks roared back again early from a double-digit deficit, it looked like Josh Hart would be that hero. The guy who is usually open for a reason, hit three after three to throw matches on a crowd ready to ignite. Jordan Clarkson, a non-factor in the first two games of these finals, sparked the Knicks in their 42 point second quarter. But one of the perks of youth is ignorance to mortality. Spurs were too young, too confident, and a little too nasty to let a blown lead on the road push them to the edge of elimination. Stefan Cassel finally got going at the basket, using his topline athleticism and strength at the rim. Dylan Harper kept on bullying, and most importantly, Victor Wamiyama finally got to dominating around the rim and above it before he hit some huge shots from deep. Cassel had 23 points, 3 coming on a clutch late game triple. De'Aaron Fox, who was quiet for most of the game, hit a huge mid-range jumper in the final minute, and Harper had 13 points and 88 rebound. Even with his jumper painfully broken. Wemiyama finished his first finals win with 32 points, 8 rebounds, 6 assists, and 3 blocks, making sure Nixon 4 would be no more. The future, like the playoffs, is full of unknowns. We don't know what will last, what moments will be the outline headers for our memories. But if Victor Wamanyama has the career everyone thinks he will, and wins the way we all expect, maybe this moment will stick. At the world's most famous arena, the 22-year-old showed that any event with him a part of it, well, it was guaranteed to be even bigger."},"multiRecircHtml":"\u003cdiv id=\"stacked-recommendations-root\"\u003e\u003c/div\u003e\n    \u003cscript id=\"stacked-recommendations-data\" type=\"application/json\"\u003e{\"endpoint\":\"https://api-prd-nyt.theathletic.com/graphql\",\"wpBaseUrl\":\"https://theathletic.com\",\"sessionVerificationEndpoint\":\"https://www.nytimes.com/athletic/session-verification/\"}\u003c/script\u003e\n    \u003cscript defer id=\"stacked-recommendations-script\" src=\"https://graphics-cdn.theathletic.com/dir/stacked-recommendations.js?ver=11\"\u003e\u003c/script\u003e","qandaData":null,"socialImageOverride":null,"socialUrlOverride":null,"socialTitleOverride":null},"statsigStore":{"edgeUser":{"country":"US","userAgent":"Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) Workbench/1.0","customIDs":{"ta_stable_id":"17908937894727721911","agent_id":"1kVu3HOaOYeti0EPztY9rU"},"custom":{"surface":"ta-article","deviceType":"desktop","browserName":"Safari","browserVersion":"","osName":"Mac","osVersion":"10.15.7","is_ta_app_webview":false},"statsigEnvironment":{"tier":"production"}},"experiments":{},"gates":{"adexp-taconnections-web-adslot-0826":false,"comments-sharing":false,"community-reactions-chat-enabled":false,"community-reactions-top-comment-enabled":false,"data-wrapper-in-articles-embeds-share":false,"hide-image-size":false,"mlb-season-replay":false,"open-comments-for-anonymous-users":true,"share-preview-image":false,"ta-web-one-tap-video-fullscreen":true,"web-can-regis-comment-react":true,"web-discuss-anon-open":true,"web-ssr-graphql-retry":true},"dynamicConfigs":{},"layers":{},"parameters":{}},"__N_SSP":true},"page":"/article/[...id]","query":{"id":["7345644","2026","06","10","jalen-brunson-knicks-spurs-victor-wembanyama-first-quarter-nba-finals"]},"buildId":"PI2pPh_P7E--Sm3c256JN","assetPrefix":"/athletic","isFallback":false,"dynamicIds":[8159,57401,90892,39551,40491,79800,11449,68025,1421,86182],"gssp":true,"appGip":true,"scriptLoader":[]}</script></body></html>