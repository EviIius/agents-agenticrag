","value":"xi"},{"type":"wb","value":"yi"},{"type":"wb","value":"yi"},{"type":"wb","value":"yi"},{"introTextColor":"117","introTextSizeInLargeScreen":"118","introTextSizeMediumScreen":"119","introTextSizeInSmallScreen":"11a"},{"type":"w2","value":"ws"},{"linkInTextColor":"11c"},{"type":"w2","value":"wu"},{"type":"w2","value":"ws"},{"tagActiveColor":"11e","tagHoverColor":"11f"},{"type":"w2","value":"wx"},{"type":"w2","value":"wu"},{"backgroundColor":"11h","titleColor":"11i"},{"articleDisclaimer":"wa","verticalCard":"wl","sectionHeader":"wr","button":"xh","footer":"xt","articleTitle":"y2","header":"zg","image":"zl","verticalShareMenu":"zn","articleContent":"zs","relatedPosts":"zx","articleBlock":"10h","relatedTopics":"10u","socialButtons":"10x","threeRowsHeader":"116","intro":"11b","authorBio":"11d","tag":"11g","sportradar":"11j"},1,{"divider":"11l","iframeEmbed":"11l","inline-text":"tz","mm-content-embed":"x9","table":"x9"},{"divider":"11l","iframeEmbed":"11l","inline-text":"tz","mm-content-embed":"x9","table":"x9"},"https://www.si.com/nba/finals/chris-mannix-knicks-keep-finding-way-championship-within-reach","https://www.si.com/nba/finals/knicks-spurs-nba-finals-game-1-live-updates-scores-stats-takeaways","https://www.si.com/nfl/inside-rams-browns-negotiation-myles-garrett-trade","https://www.si.com/nba/finals/did-spurs-exhaust-themselves-vs-thunder-wemby-thinks-so-nba-history-agrees","https://www.si.com/nba/finals/every-celebrity-spotted-game-2-spurs-vs-knicks","https://www.si.com/nba/finals/knicks-fans-dreams-title-within-reach-after-game-1-win-my-heart-would-stop","https://podcasts.apple.com/us/podcast/open-floor-sis-nba-show/id1050847009","https://open.spotify.com/show/0Bgxp9XcFMTysIDB5mC04P","https://www.youtube.com/playlist?list=PLRxhb-2QRi1DlpVi8D3zH7WzJgtZXo72g",["11o","11p","11q","11r","11s","11t","11u","11v","11w"],530,12,"inline-text",{"numberOfWords":"11z","type":"120"},68,{"numberOfWords":"122","type":"120"},24,{"numberOfWords":"124","type":"120"},{"numberOfWords":"tz","type":"120"},65,{"numberOfWords":"127","type":"120"},78,{"numberOfWords":"129","type":"120"},18,{"numberOfWords":"12b","type":"120"},{"numberOfWords":"11z","type":"120"},"table",{"numberOfWords":"7r","type":"12e"},62,{"numberOfWords":"12g","type":"120"},37,{"numberOfWords":"12i","type":"120"},38,{"numberOfWords":"12k","type":"120"},"mm-content-embed",{"numberOfWords":"7r","type":"12m"},{"numberOfWords":"11z","type":"120"},{"numberOfWords":"7r","type":"12e"},25,{"numberOfWords":"12q","type":"120"},35,{"numberOfWords":"12s","type":"120"},"divider",{"numberOfWords":"7r","type":"12u"},{"numberOfWords":"sz","type":"120"},23,{"numberOfWords":"12x","type":"120"},"iframeEmbed",{"numberOfWords":"7r","type":"12z"},{"numberOfWords":"7r","type":"12m"},["121","123","125","126","128","12a","12c","12d","12f","12h","12j","12l","12n","12o","12p","12r","12t","12v","12w","12y","130","131"],{"blockTypeToQuantity":"11m","contentTypesToQuantity":"11n","coverMediaType":"r6","listOfArticleLinks":"11x","numberOfWordsTyped":"11y","orderedBlocksWithWordCount":"132"},[],{"type":"9j","value":"r4"},{"x":"r7","y":"r8"},{"aspectRatio":"136","caption":"ra","credit":"ra","description":"ra","fileExtension":"rb","path":"rc","provider":"rd","url":"re"},{"type":"r6","value":"137"},{"type":"rh","value":"ri"},{"type":"9j","value":"ra"},{"alt":"rm","src":"rn","url":"ro"},["13b"],{"type":"rl","value":"13c"},{"bio":"135","image":"138","joinedDate":"139","name":"13a","socialLinks":"13d"},{"authorInfo":"13e","lastPublishedAt":"rt","link":"rv","name":"ra","pageID":"ru","pagePath":"rv","source":"rw","userName":"rx","username":"rx"},{"additional":"134","owner":"13f"},95,"NBA Finals",{"score":"13h","tag":"13i"},90,"San Antonio Spurs",{"score":"13k","tag":"13l"},85,"2–0 series deficit",{"score":"13n","tag":"13o"},80,"NBA history",{"score":"13q","tag":"13r"},75,"comeback in NBA Finals",{"score":"13t","tag":"13u"},70,"Victor Wembanyama",{"score":"13w","tag":"13x"},"Madison Square Garden",{"score":"127","tag":"13z"},60,"Knicks",{"score":"141","tag":"142"},55,"Giannis Antetokounmpo",{"score":"144","tag":"145"},50,"Milwaukee Bucks",{"score":"147","tag":"148"},45,"2021 NBA Finals",{"score":"14a","tag":"14b"},40,"2026 NBA Finals",{"score":"14d","tag":"14e"},"2021 Bucks",{"score":"12s","tag":"14g"},30,"2016 Cavaliers",{"score":"14i","tag":"14j"},"2006 Heat",{"score":"12q","tag":"14l"},20,"1977 Trail Blazers",{"score":"14n","tag":"14o"},15,"1969 Celtics",{"score":"14q","tag":"14r"},10,"2021 Suns",{"score":"14t","tag":"14u"},8,"NBA Championship",{"score":"14w","tag":"14x"},"NBA Comebacks",{"score":"sz","tag":"14z"},["13j","13m","13p","13s","13v","13y","140","143","146","149","14c","14f","14h","14k","14m","14p","14s","14v","14y","150"],"<p>The Spurs face <a href=\"https://www.si.com/nba/finals/chris-mannix-knicks-keep-finding-way-championship-within-reach\">an uphill battle in the 2026 NBA Finals</a>.</p>",{"html":"152"},{"type":"120","value":"153"},"<p>San Antonio has held double-digit leads in both games of the Finals against the Knicks—a 14-point lead in Game 1 and a 12-point lead in Game 2—but has no wins to show for it. New York closed out Game 1 with <a href=\"https://www.si.com/nba/finals/knicks-spurs-nba-finals-game-1-live-updates-scores-stats-takeaways\">an 11–0 run in the final two minutes</a>, and Victor Wembanyama <a href=\"https://www.si.com/nfl/inside-rams-browns-negotiation-myles-garrett-trade\">committed a costly turnover</a> with 11 seconds to play in the Spurs’ Game 2 loss. </p>",{"html":"155"},{"type":"120","value":"156"},"<p>Now, the Spurs find themselves where 37 other teams in NBA history have been before: facing a 2–0 series deficit in the NBA Finals. </p>",{"html":"158"},{"type":"120","value":"159"},"<h3>RELATED: <a href=\"https://www.si.com/nba/finals/did-spurs-exhaust-themselves-vs-thunder-wemby-thinks-so-nba-history-agrees\">Did the Spurs Exhaust Themselves vs. the Thunder? Wemby Thinks So, and NBA History Agrees</a></h3>",{"html":"15b"},{"type":"120","value":"15c"},"<p>Of those previous 37 teams, only five have come back to win the championship. Three others forced a Game 7 and lost. Since the first edition of the Finals in 1947, it’s been more common for teams facing a 2–0 Finals deficit to get swept (nine times) than to force a Game 7 and/or complete a comeback and hoist the Larry O’Brien Trophy (eight times).</p>",{"html":"15e"},{"type":"120","value":"15f"},"<p>The Spurs don’t have to look too far back in league annals to find an example of a team to overcome it, though. In 2021, Giannis Antetokounmpo and the Bucks trailed the Suns 2–0 after losing the first two games of the Finals by a total of 23 points. Just about every pundit proclaimed the series was over until Antetokounmpo turned things around in Game 3, and the Bucks went on to win the title in six games.</p>",{"html":"15h"},{"type":"120","value":"15i"},"<p>Here’s a look at every team to face a 2–0 deficit in the Finals and how it went:</p>",{"html":"15k"},{"type":"120","value":"15l"},"<h2>A full list of every team to trail 2–0 in NBA Finals</h2>",{"html":"15n"},{"type":"120","value":"15o"},"<p><strong>YEAR</strong></p>","<p><strong>TEAM DOWN 2–0</strong></p>","<p><strong>OPPONENT</strong></p>","<p><strong>FINALS RESULT</strong></p>",["15q","15r","15s","15t"],"<p>2026</p>","<p>Spurs</p>","<p>Knicks</p>","<p>TBD</p>",["15v","15w","15x","15y"],"<p>2024</p>","<p>Mavericks</p>","<p>Celtics</p>","<p>Celtics in 5</p>",["160","161","162","163"],"<p><strong>2021</strong></p>","<p><strong>Bucks</strong></p>","<p><strong>Suns</strong></p>","<p><strong>Bucks in 6</strong></p>",["165","166","167","168"],"<p>2020</p>","<p>Heat</p>","<p>Lakers</p>","<p>Lakers in 6</p>",["16a","16b","16c","16d"],"<p>2018</p>","<p>Cavaliers</p>","<p>Warriors</p>","<p>Warriors in 4</p>",["16f","16g","16h","16i"],"<p>2017</p>","<p>Warriors in 5</p>",["16k","16g","16h","16l"],"<p><strong>2016</strong></p>","<p><strong>Cavaliers</strong></p>","<p><strong>Warriors</strong></p>","<p><strong>Cavs in 7</strong></p>",["16n","16o","16p","16q"],"<p>2009</p>","<p>Magic</p>","<p>Lakers in 5</p>",["16s","16t","16c","16u"],"<p>2008</p>","<p>Celtics in 6</p>",["16w","16c","162","16x"],"<p>2007</p>","<p>Spurs in 4</p>",["16z","16g","15w","170"],"<p><strong>2006</strong></p>","<p><strong>Heat</strong></p>","<p><strong>Mavericks</strong></p>","<p><strong>Heat in 6</strong></p>",["172","173","174","175"],"<p>2005</p>","<p>Pistons</p>","<p>Spurs in 7</p>",["177","178","15w","179"],"<p>2002</p>","<p>Nets</p>","<p>Lakers in 4</p>",["17b","17c","16c","17d"],"<p>2000</p>","<p>Pacers</p>",["17f","17g","16c","16d"],"<p>1999</p>","<p>Spurs in 5</p>",["17i","15x","15w","17j"],"<p>1997</p>","<p>Jazz</p>","<p>Bulls</p>","<p>Bulls in 6</p>",["17l","17m","17n","17o"],"<p>1996</p>","<p>SuperSonics</p>",["17q","17r","17n","17o"],"<p>1995</p>","<p>Rockets</p>","<p>Rockets in 4</p>",["17t","16t","17u","17v"],"<p>1993</p>","<p>Suns</p>",["17x","17y","17n","17o"],"<p>1989</p>","<p>Pistons in 4</p>",["180","16c","178","181"],"<p>1987</p>",["183","162","16c","16d"],"<p>1986</p>",["185","17u","162","16x"],"<p>1983</p>","<p>76ers</p>","<p>76ers in 4</p>",["187","16c","188","189"],"<p><strong>1977</strong></p>","<p><strong>Trail Blazers</strong></p>","<p><strong>76ers</strong></p>","<p><strong>Trail Blazers in 6</strong></p>",["18b","18c","18d","18e"],"<p>1976</p>",["18g","17y","162","16x"],"<p>1975</p>","<p>Bullets</p>",["18i","18j","16h","16i"],"<p>1971</p>","<p>Bucks</p>","<p>Bucks in 4</p>",["18l","18j","18m","18n"],"<p><strong>1969</strong></p>","<p><strong>Celtics</strong></p>","<p><strong>Lakers</strong></p>","<p><strong>Celtics in 7</strong></p>",["18p","18q","18r","18s"],"<p>1967</p>","<p>76ers in 6</p>",["18u","16h","188","18v"],"<p>1965</p>",["18x","16c","162","163"],"<p>1964</p>",["18z","16h","162","163"],"<p>1963</p>",["191","16c","162","16x"],"<p>1961</p>","<p>Hawks</p>",["193","194","162","163"],"<p>1959</p>","<p>Celtics in 4</p>",["196","16c","162","197"],"<p>1955</p>","<p>Nationals</p>","<p>Nationals in 7</p>",["199","178","19a","19b"],"<p>1951</p>","<p>Royals</p>","<p>Royals in 7</p>",["19d","15x","19e","19f"],"<p>1949</p>","<p>Capitols</p>",["19h","19i","16c","16d"],"<p>1947</p>","<p>Stags</p>",["19k","19l","16h","16l"],["15u","15z","164","169","16e","16j","16m","16r","16v","16y","171","176","17a","17e","17h","17k","17p","17s","17w","17z","182","184","186","18a","18f","18h","18k","18o","18t","18w","18y","190","192","195","198","19c","19g","19j","19m"],{"data":"19n"},{"type":"12e","value":"19o"},"<p>However, the Spurs face a tougher task ahead than any of those five aforementioned championship-winning teams—the 2021 Bucks, 2016 Cavaliers, 2006 Heat, 1977 Trail Blazers and 1969 Celtics—did when they went down 2–0. All five of those teams lost the first two games of the Finals on the road, and returned to the friendly confines of their home arena for Game 3.</p>",{"html":"19q"},{"type":"120","value":"19r"},"<p>San Antonio, on the other hand, will hit the road and will play Game 3 <a href=\"https://www.si.com/nba/finals/every-celebrity-spotted-game-2-spurs-vs-knicks\">in front of a rowdy Madison Square Garden crowd</a> that <a href=\"https://www.si.com/nba/finals/knicks-fans-dreams-title-within-reach-after-game-1-win-my-heart-would-stop\">is starving to watch the Knicks win</a> their first title since 1973. </p>",{"html":"19t"},{"type":"120","value":"19u"},"<p>The Spurs are just the third team in history to start the NBA Finals by losing both games at home. The other two teams to do so—the 1995 Magic and 1993 Suns—lost in four and six games, respectively. </p>",{"html":"19w"},{"type":"120","value":"19x"},"StoryLink","100","<blockquote class=\"mm-content-embed\" data-type=\"StoryLink\" data-embed-name=\"SI NBA Newsletter\" data-call-to-action=\"SIGN UP NOW\" data-text=\"Get SI&#39;s FREE NBA Newsletter\" data-theme=\"dark\" data-url=\"https://www.si.com/newsletter-nba\"><p lang=\"en\" dir=\"ltr\">Get SI&#39;s FREE NBA Newsletter. dark. SIGN UP NOW. SI NBA Newsletter</p></blockquote>","01k60qygf4dwrqd","https://content-enrichment-service.mmsport.minutesvc.com/oembed?url=https://content-enrichment-service.mmsport.minutesvc.com/properties/si/embeds/01k60qygf4dwrqd","rich",{"embedType":"19z","height":"1a0","html":"1a1","mediaId":"1a2","originalEmbedUrl":"1a3","provider":"12m","type":"1a4","url":"1a3","width":"1a0"},{"type":"12m","value":"1a5"},"<h2>Teams to trail 2–0 in NBA Finals after hosting first two games</h2>",{"html":"1a7"},{"type":"120","value":"1a8"},["15q","15r","15s","15t"],["15v","15w","15x","15y"],["17t","16t","17u","17v"],["17x","17y","17n","17o"],["1aa","1ab","1ac","1ad"],{"data":"1ae"},{"type":"12e","value":"1af"},"<p>Game 3 is a must-win for San Antonio. No team in NBA history has ever won a series—no matter the round—when facing a 3–0 deficit. </p>",{"html":"1ah"},{"type":"120","value":"1ai"},"<p>The Spurs will have a chance to get their championship dreams back on track when they visit the Knicks at Madison Square Garden in Game 3 on Monday. Tipoff is scheduled for 8:30 p.m. ET.</p>",{"html":"1ak"},{"type":"120","value":"1al"},{},{"type":"12u","value":"1an"},"<h3>More NBA from <em>Sports Illustrated</em></h3>",{"html":"1ap"},{"type":"120","value":"1aq"},"<p>Listen to SI’s NBA podcast, <em>Open Floor</em>, below or on<a href=\"https://podcasts.apple.com/us/podcast/open-floor-sis-nba-show/id1050847009\"> Apple</a> and<a href=\"https://open.spotify.com/show/0Bgxp9XcFMTysIDB5mC04P\"> Spotify</a>. Watch the show on<a href=\"https://www.youtube.com/playlist?list=PLRxhb-2QRi1DlpVi8D3zH7WzJgtZXo72g\"> SI’s YouTube channel</a>.</p>",{"html":"1as"},{"type":"120","value":"1at"},"<iframe frameborder=\"0\" height=\"450\" style=\"width:100%;max-width:660px;overflow:hidden;border-radius:10px;\" src=\"https://embed.podcasts.apple.com/us/podcast/open-floor-sis-nba-show/id1050847009\"></iframe>","450","https://embed.podcasts.apple.com/us/podcast/open-floor-sis-nba-show/id1050847009",{"emb