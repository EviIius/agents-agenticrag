                        <script type="text/javascript" data-name="vguidScript">
    var __window_vguid = (function() {
        try {
            // Prefer crypto.randomUUID() if available (most secure)
            if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
                return crypto.randomUUID();
            }
            
            // Fallback to crypto.getRandomValues() (cryptographically secure)
            if (typeof crypto !== 'undefined' && typeof crypto.getRandomValues === 'function') {
                var randomBytes = new Uint8Array(16);
                crypto.getRandomValues(randomBytes);
                
                // Set version (4) and variant bits for UUID v4 compliance
                randomBytes[6] = (randomBytes[6] & 0x0f) | 0x40; // Version 4
                randomBytes[8] = (randomBytes[8] & 0x3f) | 0x80; // Variant 10
                
                var hex = Array.from(randomBytes, function(byte) {
                    return ('0' + byte.toString(16)).slice(-2);
                }).join('');
                
                return [
                    hex.slice(0, 8),
                    hex.slice(8, 12),
                    hex.slice(12, 16),
                    hex.slice(16, 20),
                    hex.slice(20, 32)
                ].join('-');
            }
        } catch (e) {
            // Continue to Math.random fallback on any crypto errors
        }
        
        // WARNING: Math.random() fallback - NOT cryptographically secure
        // Should only be used in development or when crypto is unavailable
        console.warn('VGUID: Using non-secure Math.random() fallback');
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            var r = Math.random() * 16 | 0;
            var v = c == 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    })();
</script>
                


