            <h1 class="Article-headline">
                                Winners and losers of NBA's regular-season finales: Bracket breaks nicely for Rockets and Cavaliers
            </h1>
        </div>

                                    <h2 class="Article-subline">The 2025-26 NBA regular season came to a close on Sunday</h2>
                    
        <div class="ArticleAuthorAndCounter">
                            

    
<div class="ArticleAuthor" section="author">
                                                            
                                                <div class="ArticleAuthor-headshot">
                                
                                                                                        

    
    
                    
        
            
    
    
                        <a href="/writers/brad-botkin/" rel="author">
                        <div class="HeadshotContainer ">
                    <div class="Headshot Headshot--medium">
                                                                                                                        
        
    <figure class="Headshot-image img"><img class="" alt="            Brad Botkin
    " src="https://sportshub.cbsistatic.com/i/r/2022/02/28/0d4aa17e-46c3-4268-b0f5-7460fe41c1ed/thumbnail/80x80/3ac826b9d379d2c56c2de608a2210855/botkin1-700.png" loading="lazy" height="40" width="40"></figure>
                                            </div>

                                    </div>
                    </a>
            
                    </div>
