:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/4a57535cb56cab629ef52a30abe1f2bae94a51f90caf2058a3728b7cd35d64f6/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fb67e5a2c17547a95a0a3d9841228c3dc"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo dunks the ball in the third quarter against Jimmy Butler of the Miami Heat during Game 2 of their Eastern Conference first-round playoff series between the Milwaukee Bucks and the Miami Heat at Fiserv Forum on May 24, 2021.<br><br>Antetokounmpo had a game-high 31 points on 12 of 23 shooting and 13 rebounds as the Bucks crushed the Heat, 132-98, to take a 2-0 lead in the series.</p></div><span class="caption-credit"> (Quinn Harris, Getty Images)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="34"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/c1027436fc290b3f9e00c28eac8d336ed7013e113a435853814a5d996b125696/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe9ddbedaadf6849b19600cc53b75b32d&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/c1027436fc290b3f9e00c28eac8d336ed7013e113a435853814a5d996b125696/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe9ddbedaadf6849b19600cc53b75b32d"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) lays the ball up while Phoenix Suns center Deandre Ayton (22) attempts to guard him during the first half of Game 6 of the NBA Finals Tuesday, July 20, 2021, at Fiserv Forum in Milwaukee. <br><br>Antetokounmpo was unstoppable in the title-clinching game, scoring nearly half of the Bucks points in the 105-98 win.</p></div><span class="caption-credit"> (Ebony Cox / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="35"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/3896f34b08653127df42c991f954c27a251e9bd65b76118548832c5272a578a9/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F219121b30e982facaa369afb2121e08f&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/3896f34b08653127df42c991f954c27a251e9bd65b76118548832c5272a578a9/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F219121b30e982facaa369afb2121e08f"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo (34) puts up a shot at the basket in the first quarter of their Eastern Conference semifinal playoff Game 4 at Fiserv Forum in Milwaukee on Sunday, June 13, 2021.</p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="36"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/44a434f1818c224464c2d5bd23e23fd2be69cea1a430e7e0532089c74fb8b4c6/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fc3a24ad48b028953aa2d8917af9adbdd&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/44a434f1818c224464c2d5bd23e23fd2be69cea1a430e7e0532089c74fb8b4c6/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fc3a24ad48b028953aa2d8917af9adbdd"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo (34) drives to the basket against Brooklyn Nets point guard Mike James (55) and point guard Kyrie Irving (11) during the second quarter of Game 1 in the Eastern Conference semifinals of the 2021 NBA Playoffs at Barclays Center on June 5.<br><br>Antetokounmpo scored 34 poitns but it wasn't enough as the Bucks fell 115-107 in the series opener.</p></div><span class="caption-credit"> (Brad Penner, USA TODAY Sports)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="37"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/75526c588235ad7261c8942190fd6906f3851fd11dd7a1ac2fc8b5d6b7903cef/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Ff0da4174cd54d28c6ec09b791efc0b73&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/75526c588235ad7261c8942190fd6906f3851fd11dd7a1ac2fc8b5d6b7903cef/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Ff0da4174cd54d28c6ec09b791efc0b73"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo (34) dunks during the fourth quarter of their Eastern Conference semifinal playoff game against the Brooklyn Nets at Fiserv Forum in Milwaukee on Sunday, June 13, 2021. <br><br>Antetokounmpo scored a game-high 34 points in the Bucks' 107-96 win in Game 4 to even the best-of-seven series at 2-2.</p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="38"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/535a9cb58453550f4137eb0f996571f0890562e157589497bb5f5d0d0abafb28/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F6c426cc5c440059dbc4af269809ee489&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/535a9cb58453550f4137eb0f996571f0890562e157589497bb5f5d0d0abafb28/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F6c426cc5c440059dbc4af269809ee489"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) celebrates in the closing moments as the Bucks won Game 6 of the NBA Finals to win the championship in front of their home fans at Fiserv Forum in Milwaukee on Tuesday, July 20, 2021.</p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="39"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/6285e73f506a9024721c8b8adbc8ad9326aa20730b842bc67bb0cf54053c3660/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F221e61ae17ea3ef2fdfd1efaf0021ff3&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/6285e73f506a9024721c8b8adbc8ad9326aa20730b842bc67bb0cf54053c3660/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F221e61ae17ea3ef2fdfd1efaf0021ff3"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo, right, watches the end of practice Tuesday, July 13, 2021 at Fiserv Forum in Milwaukee, a day before Game 4 of the series.<br><br>Antetokounmpo managed a left knee injury during the NBA Finals after suffering the injury in the Eastern Conference finals.</p></div><span class="caption-credit"> (Mark Hoffman, Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="40"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/5089894554315680b26994ada5dadc42130f5a0074ec4ac8d047a77ba260faea/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe5dd510d4d17341f4521ba57335e13f7&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/5089894554315680b26994ada5dadc42130f5a0074ec4ac8d047a77ba260faea/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe5dd510d4d17341f4521ba57335e13f7"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo (34) dunks the ball as Phoenix Suns forward Jae Crowder (99) looks on during the first half of Game 3 of the NBA Finals game 3 Sunday, July 11, 2021 at Fiserv Forum in Milwaukee. The Bucks won 120-100 to get on the board in the series, the first of four straight wins.<br><br>Antetokounmpo scored a game-high 41 points on 14 of 23 shooting, plus 13 of 17 from the free-throw line and 13 rebounds.</p></div><span class="caption-credit"> (Mark Hoffman, Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="41"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/c9684783d339d8e01bc14f4454cd9dd4dea06855c8e9a5a5e8fa7338670d217c/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fae3b279b387b9070b95aa79b0e7f6864&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/c9684783d339d8e01bc14f4454cd9dd4dea06855c8e9a5a5e8fa7338670d217c/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fae3b279b387b9070b95aa79b0e7f6864"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) celebrates after the Bucks won Game 6 of the NBA Finals at Fiserv Forum in Milwaukee on Tuesday, July 20, 2021. </p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="42"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/0989179e67be514cbeaf0f6c403e715eedce1c43d7c3da1b0afb6de69030d44b/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F7e83cb8025cd7ee48e073e7a7ad217ab&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/0989179e67be514cbeaf0f6c403e715eedce1c43d7c3da1b0afb6de69030d44b/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F7e83cb8025cd7ee48e073e7a7ad217ab"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) celebrates after the Bucks won Game 6 of the NBA Finals at Fiserv Forum in Milwaukee on Tuesday, July 20, 2021.<br><br>He scored 50 points on 16 of 25 shooting, as well as 17 of 19 on free throws, plus 14 rebounds and five blocks.</p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="43"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/0dcfa69f734c0c2170234d3df8186f315541d736498a7c67bc32f38b09afc599/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F2eb9923f5ae015bd9510e3ffd5a8de9e&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/0dcfa69f734c0c2170234d3df8186f315541d736498a7c67bc32f38b09afc599/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.c