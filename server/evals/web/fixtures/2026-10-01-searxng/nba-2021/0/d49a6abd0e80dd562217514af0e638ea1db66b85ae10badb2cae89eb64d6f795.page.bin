b914b33213c11e78c3f2c1c2/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F229e37829aad94e910c9c9034ec60225&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/0d2d7d2643ddf4ae007068d020b29a414dae49d1b914b33213c11e78c3f2c1c2/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F229e37829aad94e910c9c9034ec60225"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) holds his NBA Finals trophy after the 105-98 win over the Phoenix Suns in Game 6 of the NBA Finals Tuesday, July 20, 2021, at Fiserv Forum in Milwaukee.</p></div><span class="caption-credit"> (Ebony Cox / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="16"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/00706a36a14bcd927ec4b710aa150b167faf2d57f3286715ae3f793fb78e8599/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe03d5bacc2ff69d5bdd9a0c401594ce8&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/00706a36a14bcd927ec4b710aa150b167faf2d57f3286715ae3f793fb78e8599/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe03d5bacc2ff69d5bdd9a0c401594ce8"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) dunks during the second half of Game 6 of the NBA Finals Tuesday, July 20, 2021, at Fiserv Forum in Milwaukee. <br><br>Antetokounmpo scored 50 points as the Bucks defeated the Suns 105-98 to win the NBA championship.</p></div><span class="caption-credit"> (Ebony Cox / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="17"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/109c9b593743d9c0736593d79245b3bdde38b2406b1075039664ed6ce0d8cacb/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F4c917355a1a1e91ec32c9ebf68b044f8&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/109c9b593743d9c0736593d79245b3bdde38b2406b1075039664ed6ce0d8cacb/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F4c917355a1a1e91ec32c9ebf68b044f8"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo (34) dunks over Atlanta Hawks guard Lou Williams (6) during the first half during Game 3 of the Eastern Conference Finals for the 2021 