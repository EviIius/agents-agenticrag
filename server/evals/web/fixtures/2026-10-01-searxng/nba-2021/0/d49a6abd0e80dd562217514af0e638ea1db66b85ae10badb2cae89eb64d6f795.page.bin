Link\":null,\"data-autolinker-wiki-id\":null,\"dataYlk\":{\"slk\":\"Jrue Holiday steal in Game 5\",\"elm\":\"context_link\",\"itc\":\"0\",\"sec\":\"content-canvas\"},\"data-ylk\":\"{\\\"slk\\\":\\\"Jrue Holiday steal in Game 5\\\",\\\"elm\\\":\\\"context_link\\\",\\\"itc\\\":\\\"0\\\",\\\"sec\\\":\\\"content-canvas\\\"}\"}}]}},{\"nodeId\":\"14\",\"parentNodeId\":\"5\",\"text\":\", the \",\"type\":\"text\"},{\"nodeId\":\"15\",\"parentNodeId\":\"5\",\"text\":\"workout that helped Giannis\",\"type\":\"text\",\"attrs\":{\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://www.jsonline.com/story/sports/nba/bucks/2026/07/14/secret-workout-giannis-antetokounmpo-ready-game-1-nba-finals-knee-injury-bucks/90876892007/\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer nofollow\",\"class\":null,\"isValidAffiliate\":null,\"isDoNotAffiliateLink\":false,\"dataOriginalLink\":null,\"data-autolinker-wiki-id\":null,\"dataYlk\":{\"slk\":\"workout that helped Giannis\",\"elm\":\"context_link\",\"itc\":\"0\",\"sec\":\"content-canvas\"},\"data-ylk\":\"{\\\"slk\\\":\\\"workout that helped Giannis\\\",\\\"elm\\\":\\\"context_link\\\",\\\"itc\\\":\\\"0\\\",\\\"sec\\\":\\\"content-canvas\\\"}\"}}]}},{\"nodeId\":\"16\",\"parentNodeId\":\"5\",\"text\":\" get back to game play.\",\"type\":\"text\"}]},{\"__typename\":\"CBodyItem\",\"locationNumber\":1,\"subtype\":\"in-body\",\"type\":\"ad\"},{\"nodeId\":\"17\",\"parentNodeId\":null,\"type\":\"paragraph\",\"attrs\":{\"textAlign\":\"left\",\"characterCount\":184},\"content\":[{\"nodeId\":\"18_e0\",\"parentNodeId\":\"17\",\"text\":\"We asked readers what they remembered about July 20, 2021, the day Milwaukee hoisted the trophy thanks to a Game 6 win over the \",\"type\":\"text\"},{\"nodeId\":\"18_e1\",\"parentNodeId\":\"17\",\"text\":\"Phoenix Suns\",\"type\":\"text\",\"attrs\":{\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"https://sports.yahoo.com/nba/teams/phoenix/\",\"target\":\"_blank\",\"rel\":\"\",\"class\":\"link\",\"data-ylk\":\"{\\\"slk\\\":\\\"Phoenix Suns\\\",\\\"elm\\\":\\\"context_link\\\",\\\"itc\\\":\\\"0\\\",\\\"sec\\\":\\\"content-canvas\\\"}\"}}]}},{\"nodeId\":\"18_e2\",\"parentNodeId\":\"17\",\"text\":\" in the NBA Finals. Here's what you told us:\",\"type\":\"text\"}]},{\"nodeId\":\"19\",\"parentNodeId\":null,\"type\":\"slideshow\",\"uuid\":\"6221eb1f-aecc-332e-8656-a4b818104538\",\"attrs\":{\"contentItemId\":\"6221eb1f-aecc-332e-8656-a4b818104538\"},\"photos\":[{\"alt\":\"\",\"caption\":\"\u003cp style=\\\"margin: 0px;\\\"\u003eFive years ago, Giannis Antetokounmpo led the Milwaukee Bucks to their first NBA championship in 50 years after he scored 50 points in the clinching Game 6 over the Phoenix Suns. \u003cbr\u003e\u003cbr\u003eIt capped an incredible playoff run that also saw him return faster than anyone thought from a hyperextended left knee he suffered during the Eastern Conference finals. \u003cbr\u003e\u003cbr\u003eHe would deliver several masterpieces throughout the playoffs and iconic NBA Finals moments.\u003cbr\u003e\u003cbr\u003eScroll through this gallery for all of Giannis' highlights during the 2021 postseason.\u003c/p\u003e\",\"credit\":\"Mark J. Rebilas, USA TODAY Sports\",\"headline\":\"Giannis Antetokounmpo highlights during Bucks' 2021 championship run, NBA Finals\",\"id\":\"3f3bafee-3754-396c-ba08-577edc63801c\",\"size\":{\"original\":{\"url\":\"https://media.zenfs.com/en/milwaukee_journal_sentinel_national_slideshows_156/fbfb2b058ff6c7101db72e2246f290e1\",\"width\":2397,\"height\":3300},\"resized\":{\"url\":\"https://s.yimg.com/lo/mysterio/api/40f7e12f115997cc6d20cd933bf92a3c71f4e8e48c334448b8a28971608a0f7f/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Ffbfb2b058ff6c7101db72e2246f290e1\",\"width\":976,\"height\":1344},\"thumbnail\":{\"url\":\"https://s.yimg.com/lo/mysterio/api/1c54fc58b64452125e13767361d4bf0985a4cb4820c1e44808efeda97a8a9574/ligh