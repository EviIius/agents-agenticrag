_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F609d44c5a0582eb5c489cdf4452df5e8&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/c17f23c5cdfbb28cab1e1dae8c8f777bc35708bc49525043d8f5cd8f29c318dc/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F609d44c5a0582eb5c489cdf4452df5e8"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (right) congratulates forward Khris Middleton (22) after a basket during the third quarter against the Atlanta Hawks in Game 6 of the Eastern Conference Finals for the 2021 NBA playoffs on July 3, 2021, at State Farm Arena. <br><br>Antetokounmpo missed the last two games of the series after injuring his left knee in Game 4.</p></div><span class="caption-credit"> (Jason Getz, USA TODAY Sports)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="20"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/08ffc173c5f3908f726d1561747887632e3e6d9c888dae9ebec6983b185d40d1/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe97eb63ac6b07d6c016e0996f7c02575&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/08ffc173c5f3908f726d1561747887632e3e6d9c888dae9ebec6983b185d40d1/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fe97eb63ac6b07d6c016e0996f7c02575"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit">Milwaukee Bucks forward Giannis Antetokounmpo (34) drive to the basket past Brooklyn Nets guard Mike James (55) during the 3rd quarter of their eastern conference semifinal playoff game at Fiserv Forum in Milwaukee on Sunday, June 13, 2021. Photo by Mike De Sisti / Milwaukee Journal Sentinel via USA TODAY NETWORK ORG XMIT: DBY1</div><span class="caption-credit"> (Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="21"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/28c239e8e9bc872035d11e1f2b46b90b5d232ea149070f7f4bb8ef59b29affab/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F046e9ada69df2f428840edb771757d4a&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/28c239e8e9bc872035d11e1f2b46b90b5d232ea149070f7f4bb8ef59b29affab/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F046e9ada69df2f428840edb771757d4a"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Injured Milwaukee Bucks forward Giannis Antetokounmpo congratulates center Brook Lopez (11) during the second half of Game 5 of the Eastern Conference finals game Thursday, July 1, 2021 at Fiserv Forum. <br><br>The Milwaukee Bucks beat the Atlanta Hawks, 123-112, to take a 3-2 series lead. <br><br>Antetokounmpo missed the game with a left knee injury. <br><br>Lopez led the Bucks in scoring with 33 points. </p></div><span class="caption-credit"> (Mark Hoffman, Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="22"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/f406b5e0d3534928bef0ae4a578b9e544eac78f684716e63efb47f26f0faf1a6/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F726716e4133f90ad314a0906a1a7dcaa&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/f406b5e0d3534928bef0ae4a578b9e544eac78f684716e63efb47f26f0faf1a6/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F726716e4133f90ad314a0906a1a7dcaa"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo celebrates winning the Bill Russell NBA Finals MVP Award after defeating the Phoenix Suns in Game 6 to win the 2021 NBA Finals at Fiserv Forum on July 20, 2021 in Milwaukee, Wisconsin. </p></div><span class="caption-credit"> (Jonathan Daniel, Getty Images)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="23"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/007ddc688b15f8bc4f82dbdff7fcbee45fbdfde1cd84f5e255736ce9d8ee26e1/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Ff9ab2b90a3dd0d574813bc33354d7112&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/007ddc688b15f8bc4f82dbdff7fcbee45fbdfde1cd84f5e255736ce9d8ee26e1/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Ff9ab2b90a3dd0d574813bc33354d7112"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Giannis Antetokounmpo (34) scores two of his game-high 50 points as Phoenix Suns forward Frank Kaminsky (8) tries to block the shot during the fourth quarter of Game 6 of the NBA Finals at Fiserv Forum in Milwaukee on Tuesday, July 20, 2021. <br><br>The 50 points are tied for most in an NBA Finals clinching game in NBA history.</p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="24"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/bbb592d215f904ed29c9f02c51bd9b4d884728d9534342736fc66c284e4d6391/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fef6b5e1e2ea48adfeb590cd77fa80002&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/bbb592d215f904ed29c9f02c51bd9b4d884728d9534342736fc66c284e4d6391/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fef6b5e1e2ea48adfeb590cd77fa80002"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) blocks a shot on Phoenix Suns forward Mikal Bridges during the first quarter of Game 6 of the NBA Finals at Fiserv Forum in Milwaukee on Tuesday, July 20, 2021. <br><br>It was one of five blocks for Antetokounmpo in the title-clinching game.</p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="25"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/b4f7c2d126b2db984c9b21016cac706f20f5b113169371d857d470af5f54da94/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fa1cdb94014b21d2be7f80c2a904d5787&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/b4f7c2d126b2db984c9b21016cac706f20f5b113169371d857d470af5f54da94/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2Fa1cdb94014b21d2be7f80c2a904d5787"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks assistant coach Darvin Ham hugs Milwaukee Bucks forward Giannis Antetokounmpo as part of the celebration of the Milwaukee Bucks' NBA championship in the downtown Deer District near Fiserv Forum in Milwaukee on Thursday, July 22, 2021.</p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="26"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/8bc30c5ca57c1b1caa63eac3ca064ec14c4006c3ee4a9dcbb419c2d9b5f3f253/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F80df5f5433c44258bda9aacf6edd7d07&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/8bc30c5ca57c1b1caa63eac3ca064ec14c4006c3ee4a9dcbb419c2d9b5f3f253/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F80df5f5433c44258bda9aacf6edd7d07"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">Milwaukee Bucks forward Giannis Antetokounmpo (34) celebrates with Milwaukee Bucks forward P.J. Tucker (17) in the closing moments as the Bucks won Game 6 of the NBA Finals at Fiserv Forum in Milwaukee on Tuesday, July 20, 2021. </p></div><span class="caption-credit"> (Mike De Sisti / Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="27"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysterio/api/dfbe41e90157bb8278c56417e27be38fd223861087a2f5501551307cf84d0223/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F51499eb908d7c9da6517708919b8a529&quot;)"></div><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="letterboxed-img" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://s.yimg.com/lo/mysterio/api/dfbe41e90157bb8278c56417e27be38fd223861087a2f5501551307cf84d0223/lightyear_networkapi/resizefill_w976%3Bquality_80%3Bformat_webp/https%3A%2F%2Fmedia.zenfs.com%2Fen%2Fmilwaukee_journal_sentinel_national_slideshows_156%2F51499eb908d7c9da6517708919b8a529"/></div><figcaption class="caption-node"><div style="max-height:none;overflow:visible"><div class="fig-credit"><p style="margin: 0px;">With his knees wrapped with ice bags, Milwaukee Bucks forward Giannis Antetokounmpo watches the end of practice Tuesday, July 13, 2021 at Fiserv Forum in Milwaukee, Wis. <br><br>He managed a left knee injury throughout the NBA Finals but he didn't let it stop him as he averaged 35.2 points per game on 61.8% shooting. </p></div><span class="caption-credit"> (Mark Hoffman, Milwaukee Journal Sentinel)</span></div></figcaption></div></figure><figure class="slide-photo" data-inview="false"><div class="snap-start snap-always hidden" data-slide-index="28"><div class="letterboxed-img-wrapper" style="aspect-ratio:16 / 9"><div class="letterbox-bg" style="background-image:url(&quot;https://s.yimg.com/lo/mysteri