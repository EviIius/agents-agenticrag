<!doctype html><html><head>
	<meta charset="UTF-8">
	<!--
		DEV-1215 · CLS · reserve the page chrome's footprint before any JS runs.
		<wral-header> and <wral-alerts-bar> ship as empty custom-element tags that
		are upgraded by the deferred core module, so on a slow/cold load first
		paint lays them out at 0px and everything below jumps down ~131-195px once
		the library arrives. These min-heights are the pre-upgrade floor; the
		components set the --wral-*-height variables themselves once defined.
		Must stay the first tag in <head> (after charset) so it applies to the
		very first paint. No background rule, by team decision 2026-08-17.
	-->
	<style>
		wral-header {
			display: block;
			min-height: var(--wral-header-height, 44px);
		}
		wral-alerts-bar {
			display: block;
			min-height: var(--wral-alerts-bar-height, 87px);
		}
		@media (min-width: 1024px) {
			wral-header {
				min-height: var(--wral-header-height, 108px);
			}
		}
		/* DEV-893: hold the radar/conditions row at its upgraded height (600px radar on phones, 518px row on desktop) so nothing below moves */
		/* DEV-893: needed once ima3.js and wralvideo.js are gone (the template bundle then renders before the library); the desktop floor stays after upgrade, so keep 518px in step with the radar and conditions heights */
		@media (max-width: 1024px) {
			.weather-conditions-wrapper > my-interactive-radar:not(:defined) {
				display: block;
				min-height: 600px;
			}
		}
		@media (min-width: 1025px) {
			.weather-conditions-wrapper {
				min-height: 518px !important;
			}
		}
	</style>
	<!-- DEV-893: desktop CLS: the rail ad slots and the sub-nav current-link border keep their final size from first paint -->
	<style id="wx-desktop-cls">
		/* rail: keep empty rail ad slots in the flow at rail widths, so the ad stack's own 600px right-rail reservation (htlbid opscobid.css) holds from first paint and the Get the app link below never jumps when the slots fill */
		@media (min-width: 1024px){.layout-a__rail .layout-a__rail-slot:empty{display:block}}
		/* sub-nav: every link carries the current-page border's 3px (transparent) from first paint, so marking the current link later (index.mjs) does not grow the header */
		:where(wral-section-header > a[slot=nav]){border-bottom:3px solid transparent}
	</style>
	<!-- TEMP local test harness (gated by ?mockHurricane) — remove after verification -->
	<script>
	(function () {
		if (typeof location === 'undefined' || location.search.indexOf('mockHurricane') === -1) return;
		var canned = {"data":{"generated_at":"2026-06-17T19:15:21.570Z","basin":"atlantic","storms":[{"id":"AL-ARTHUR-2026","name":"Arthur","basin":"atlantic","classification":"tropical_storm","category":null,"position":{"lat":28.8,"lon":-95.5},"movement":{"direction":"NE","speed":9},"winds":{"sustained":46,"gusts":58},"pressure":999,"advisory":{"number":null,"issued_at":"2026-06-17T16:30:00.000Z"}}],"count":1,"season":{"year":2026,"named_storms":1,"hurricanes":0}}};
		var origFetch = window.fetch.bind(window);
		window.fetch = function (input, init) {
			var url = (typeof input === 'string') ? input : (input && input.url) || '';
			if (url.indexOf('/hurricanes/active') !== -1) {
				return Promise.resolve(new Response(JSON.stringify(canned), { status: 200, headers: { 'Content-Type': 'application/json' } }));
			}
			return origFetch(input, init);
		};
		console.log('[mockHurricane] fetch override active');
	})();
	</script>
