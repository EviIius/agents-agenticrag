	<!-- web-components-wral · core library -->
	<!--
		Prod resolves to the frozen minor "v0.15" (DEV-1215 — the CLS fix landed
		in v0.15.19); staging stays on "v0" (latest) so new core releases get
		canary coverage before prod is re-pinned. Re-pin prod by changing the
		fallback minor in the three expressions below. src/fixtures/fixture.json
		sets publication.site to "wral.com", so local dev renders the prod branch.
		The loader is `type="module" async` so the upgrade can run as soon as the
		module lands instead of waiting on the full parse — safe only because the
		reservation CSS at the top of <head> holds the chrome's space.
	-->
	<link rel="stylesheet" href="https://web-components.cdn.wral.com/core/v0.15/styles.css" media="all" onload="this.media=&#x27;all&#x27;">
  	<script type="module" src="https://web-components.cdn.wral.com/weather/icon/v0/component.es.js"></script>
	<script type="module" async src="https://web-components.cdn.wral.com/core/v0.15/components.es.js"></script>

