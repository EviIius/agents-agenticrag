		<!--
			Page-level layout: when a fixture declares `pageRail.slots[]`, wrap the section
			list in a CSS grid with a sticky right-rail aside. Without `pageRail` the
			layout class collapses to a passthrough so other fixtures render unchanged.
		-->
		<div class="weather-main__layout">
			<div class="weather-main__content">
		

			<!-- ===== layout-a section ===== -->
			
				<section id="weather-top" class="section-wrapper content-wrapper layout-a-section">
