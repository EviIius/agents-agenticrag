		window.opscobid = window.opscobid || {};
		opscobid.cmd = opscobid.cmd || [];
		opscobid.cmd.push(function () {
			const currentUrl = new URL(window.location.href);
			opscobid.setTargeting('is_testing', currentUrl.hostname === 'www.wral.com' ? 'no' : 'yes');
			opscobid.setTargeting('is_home', currentUrl.pathname === '/' || currentUrl.pathname.includes('/home') ? 'yes' : 'no');
