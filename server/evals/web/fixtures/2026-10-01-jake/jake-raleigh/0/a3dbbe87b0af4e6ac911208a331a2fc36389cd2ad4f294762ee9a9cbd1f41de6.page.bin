	<script>
		(() => {
			const define = (root) => {
				if (!root || typeof root.__WRAL_IS_SPONSORED === 'function') {
					return;
				}
				root.__WRAL_IS_SPONSORED = (entity) => {
					if (!entity || typeof entity !== 'object') {
						return false;
					}
					if (entity.sponsored === true || String(entity.sponsored || '').toLowerCase() === 'true') {
						return true;
					}
					const tags = Array.isArray(entity.tags) ? entity.tags : [];
					return tags.some((tag) => {
						const value = typeof tag === 'string'
							? tag
							: (tag?.name || tag?.displayName || tag?.label || '');
						return typeof value === 'string'
							&& value.trim().toLowerCase() === 'sponsored';
					});
				};
			};
			if (typeof window !== 'undefined') {
				define(window);
			}
		})();
	</script>

