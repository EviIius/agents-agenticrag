<!doctype html><html><head>
	<meta charset="UTF-8">
	<style>
		wral-header {
			display: block;
			min-height: var(--wral-header-height, 44px);
		}
		wral-alerts-bar {
			display: block;
			min-height: var(--wral-alerts-bar-height, 87px);
		}
		@media (min-width: 1024px) {
			wral-header {
				min-height: var(--wral-header-height, 108px);
			}
		}
	</style>
	<!-- DEV-888: lay out library tags before upgrade as after it (no CLS, no homepage thumbnail flash); keep in step with article-asset.mjs, wral-section-header.mjs, listen-watch.mjs -->
	<!-- DEV-888: measured desktop CLS on /sports/ and /news/ 0.26 to 0.005 and on the homepage 0.10 to 0.015 with the thumbnail flash gone (lab A/B, 2026-09-29); every rule is scoped to :not(:defined), so nothing changes once the library upgrades -->
	<!-- DEV-888: this also applies to the homepage on purpose: with the .a3 rules it removes the flash and lowers homepage LCP; if the library never loads, the .a3 thumbnails stay hidden (accepted trade) -->
	<style id="sf-pre-upgrade">
		/* wral-section-header: match the upgraded shadow layout (padding, 46px title, nav row) so the header keeps its height */
		wral-section-header:not(:defined){display:block;width:100%;box-sizing:border-box;background-color:var(--color-primary-dark);color:var(--color-white);padding:1.25rem max(20px,calc((100% - 1366px) / 2 + 20px)) 0;white-space:nowrap;overflow:hidden;font-size:0}
		:where(wral-section-header:not(:defined))>[slot=title]{margin:0;font-size:2.875rem;font-weight:500;font-family:var(--heading-font-family);text-transform:capitalize;line-height:2.875rem;letter-spacing:-.035em;white-space:normal}
		:where(wral-section-header:not(:defined))>[slot=description]{margin:1em 0 8px;white-space:normal;font-size:1.125rem}
		:where(wral-section-header:not(:defined))>[slot=nav]{display:inline-block;vertical-align:top;margin:calc(1.25rem + 1px) 1rem 0 0;padding:.5rem;font-size:.875rem;line-height:1.5rem;font-family:var(--heading-font-family);font-weight:500;text-transform:uppercase;text-decoration:none;color:var(--color-white)}
		/* article-asset: emulate the upgraded grid (thumbnail first, excerpt, tag and date lines) so each card keeps its height */
		article-asset:not(:defined){display:grid!important;grid-template-columns:minmax(0,1fr);align-content:start}
		:where(article-asset:not(:defined))>[slot=thumbnail]{order:-1;margin-bottom:var(--thumbnail-gap,1rem)}
		article-asset:not(:defined):not(:has(>[slot=thumbnail]))::before{content:"";display:block;height:var(--thumbnail-gap,1rem)}
		:where(article-asset:not(:defined))>[slot=excerpt]{margin-top:.625rem;font-size:15px;font-family:var(--body-font-family);color:var(--color-gray-8)}
		:where(article-asset:not(:defined))>[slot=tags]{display:none}
		article-asset:not(:defined)::after{content:"";display:block;grid-column:1;margin-top:.5125rem;font-size:.6875rem;font-family:sans-serif;letter-spacing:.05rem;text-transform:uppercase}
		article-asset:not(:defined):has(>[slot=tags])::after,article-asset:not(:defined)[date]:not([date=""])::after{height:1lh}
		article-asset:not(:defined):has(>[slot=tags])[date]:not([date=""])::after{height:2lh}
		/* align-thumbnail=right: the thumbnail sits in a 33% side column, as after upgrade */
		article-asset[align-thumbnail=right]:not(:defined){grid-template-columns:minmax(0,1fr) var(--thumbnail-size,33%);grid-template-rows:repeat(8,auto) 1fr;column-gap:var(--thumbnail-gap,1rem)}
		article-asset[align-thumbnail=right]:not(:defined)::before{display:none}
		:where(article-asset[align-thumbnail=right]:not(:defined))>*{grid-column:1}
		:where(article-asset[align-thumbnail=right]:not(:defined))>[slot=thumbnail]{grid-column:2;grid-row:1/-1;margin-bottom:0;align-self:start}
		/* thumbnail-stack: narrow cards put the thumbnail on top, as the component does */
		article-asset[thumbnail-stack]:not(:defined){container-type:inline-size}
		@container (max-width:768px){
		:where(article-asset[align-thumbnail=right]:not(:defined))>*{grid-column:1/-1}
		:where(article-asset[align-thumbnail=right]:not(:defined))>[slot=thumbnail]{grid-column:1/-1;grid-row:1;margin-bottom:var(--thumbnail-gap,1rem)}
		}
		/* phones: align-thumbnail-mobile=right uses the same side column */
		@media (max-width:600px){
		article-asset[align-thumbnail-mobile=right]:not(:defined){grid-template-columns:minmax(0,1fr) var(--thumbnail-size-mobile,var(--thumbnail-size,33%));grid-template-rows:repeat(8,auto) 1fr;column-gap:var(--thumbnail-gap,1rem)}
		article-asset[align-thumbnail-mobile=right]:not(:defined)::before{display:none}
		:where(article-asset[align-thumbnail-mobile=right]:not(:defined))>*{grid-column:1}
		:where(article-asset[align-thumbnail-mobile=right]:not(:defined))>[slot=thumbnail]{grid-column:2;grid-row:1/-1;margin-bottom:0;align-self:start}
		}
		/* wral-listen-watch: reserve its upgraded desktop height */
		@media (min-width:1024px){wral-listen-watch:not(:defined){display:block;min-height:271px}}
		/* homepage Top Stories 2-item collection (.a3, News+ and the forecast video): hide the thumbnail until upgrade and reserve its 16:9 side box, so it never flashes full width */
		.a3 article-asset:not(:defined)>[slot=thumbnail]{display:none}
		.a3 article-asset[align-thumbnail=right]:not(:defined):has(>[slot=thumbnail])::before{content:"";display:block;grid-column:2;grid-row:1/-1;align-self:start;aspect-ratio:16/9;height:auto}
	</style>
