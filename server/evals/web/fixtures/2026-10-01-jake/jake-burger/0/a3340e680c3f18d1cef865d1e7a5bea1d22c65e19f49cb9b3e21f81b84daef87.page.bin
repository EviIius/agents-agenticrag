<script>
(function() {
	var form = document.querySelector('.mdl_footer .newsletter-form');
	if (!form) return;

	form.addEventListener('submit', function(e) {
		e.preventDefault();

		var btn = form.querySelector('.newsletter-btn');
		var msg = form.querySelector('.form-message');
		var originalText = btn.textContent;

		btn.disabled = true;
		btn.textContent = 'Sending...';

		fetch(form.getAttribute('action'), {
			method: 'POST',
			credentials: 'same-origin',
			body: new FormData(form)
		})
		.then(function(r) { return r.json(); })
		.then(function(data) {
			if (data.success) {
				var input = form.querySelector('.newsletter-input');
				btn.remove();
				input.disabled = true;
				input.value = '';
				input.placeholder = (data.data && data.data.message) ? data.data.message : 'Thanks for signing up!';
			} else {
				btn.disabled = false;
				btn.textContent = originalText;
				if (msg) {
					msg.hidden = false;
					msg.textContent = (data.data && data.data.message) ? data.data.message : 'Something went wrong.';
					msg.style.color = '#ff4444';
				}
			}
		})
		.catch(function() {
			btn.disabled = false;
			btn.textContent = originalText;
			if (msg) {
				msg.hidden = false;
				msg.textContent = 'Something went wrong. Please try again.';
				msg.style.color = '#ff4444';
			}
		});
	});
})();
</script>

