<div class='recipe-ingredients'>
	<h3 class='ingredients-title'>Ingredients</h3>
	<ul class='ingredients-list'>
		<li class='ingredient-item '> 1/2 cup baking soda  </li><li class='ingredient-item '> 1 cup cold water plus more as needed  </li><li class='ingredient-item '> 1 teaspoon kosher salt  </li><li class='ingredient-item '> 4 cups all-purpose flour plus more for dusting noodles  </li>	</ul>
	<div class='text-ingredients-container'>
	<a href="sms:?&body=Homemade Ramen Noodles%20%0Ahttps://www.tasteofhome.com/recipes/homemade-ramen-noodles/%20%0A%20%0AINGREDIENTS%20%0A%20%0A1/2 cup baking soda%20%0A1 cup cold water plus more as needed%20%0A1 teaspoon kosher salt%20%0A4 cups all-purpose flour plus more for dusting noodles%20%0A" class="bumblebee-cta-button bumblebee-cta-tint-color bumblebee-cta-size--md bumblebee-cta-text-ingredients" role="button" aria-label="Text Ingredients"  target="blank" data-name="text ingredients" data-module="recipe card" data-position="" data-placement="recipe card"><span class="cta-icon icon-left" aria-hidden="true"><span class="bumblebee-icon bumblebee-icon-mobile-text bumblebee-icon--xs" name="icon-mobile-text"  title="Text Ingredients" role="img"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="20" viewBox="0 0 15 20" fill="none">
