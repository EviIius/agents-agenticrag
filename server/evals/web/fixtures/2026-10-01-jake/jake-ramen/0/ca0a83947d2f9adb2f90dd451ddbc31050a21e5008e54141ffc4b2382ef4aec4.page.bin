https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/01\/Easy-Chicken-Ramen-Featured.jpg","datePublished":"2019-01-09T03:04:21+00:00","dateModified":"2023-09-20T23:36:21+00:00","description":"Incredibly flavorful Easy Homemade Chicken Ramen with authentic flavors, with caramelized soy chicken and a ramen egg. Ready in 30 minutes!","breadcrumb":{"@id":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#primaryimage","url":"https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/01\/Easy-Chicken-Ramen-Featured.jpg","contentUrl":"https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/01\/Easy-Chicken-Ramen-Featured.jpg","width":725,"height":725,"caption":"Easy chicken ramen bowl with ramen eggs, soy marinated caramelized chicken, steamed greens and other toppings."},{"@type":"BreadcrumbList","@id":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"The Flavor Bender","item":"https:\/\/www.theflavorbender.com\/"},{"@type":"ListItem","position":2,"name":"Recipes","item":"https:\/\/www.theflavorbender.com\/category\/recipes\/"},{"@type":"ListItem","position":3,"name":"Recipes by Course","item":"https:\/\/www.theflavorbender.com\/category\/recipes\/courses\/"},{"@type":"ListItem","position":4,"name":"Main Dish Recipes","item":"https:\/\/www.theflavorbender.com\/category\/recipes\/courses\/main-meals\/"},{"@type":"ListItem","position":5,"name":"The Best Homemade Chicken Ramen (Easy Ramen Recipe)"}]},{"@type":"WebSite","@id":"https:\/\/www.theflavorbender.com\/#website","url":"https:\/\/www.theflavorbender.com\/","name":"The Flavor Bender","description":"Master the Science of Delicious","publisher":{"@id":"https:\/\/www.theflavorbender.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/www.theflavorbender.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/www.theflavorbender.com\/#organization","name":"The Flavor Bender","url":"https:\/\/www.theflavorbender.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.theflavorbender.com\/#\/schema\/logo\/image\/","url":"https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2023\/12\/The-Flavor-Bender-Logo-scaled.jpg","contentUrl":"https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2023\/12\/The-Flavor-Bender-Logo-scaled.jpg","width":1200,"height":1200,"caption":"The Flavor Bender"},"image":{"@id":"https:\/\/www.theflavorbender.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/theflavorbender","https:\/\/x.com\/FlavorBender","https:\/\/instagram.com\/theflavorbender\/","https:\/\/www.pinterest.com\/theflavorbender\/","https:\/\/www.youtube.com\/c\/theflavorbender"]},{"@type":"Person","@id":"https:\/\/www.theflavorbender.com\/#\/schema\/person\/ab6f60ebb738d3347a2b3dfb5ad2b43c","name":"Dini Kodippili","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/10\/headshot.jpg","url":"https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/10\/headshot.jpg","contentUrl":"https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/10\/headshot.jpg","caption":"Dini Kodippili"},"description":"Dini Kodippili is a professional food writer, recipe developer, food photographer, cookbook author, and baker. Dini has been featured on HuffPost, Cosmopolitan, Forbes, Delish, Food &amp; Wine and more. Learn More","sameAs":["https:\/\/www.theflavorbender.com","https:\/\/www.facebook.com\/theflavorbender","https:\/\/x.com\/flavorbender"],"url":"https:\/\/www.theflavorbender.com\/author\/dini\/"},{"@type":"Recipe","name":"Easy Homemade Chicken Ramen","author":{"@id":"https:\/\/www.theflavorbender.com\/#\/schema\/person\/ab6f60ebb738d3347a2b3dfb5ad2b43c"},"description":"An incredibly flavorful homemade chicken ramen with authentic flavors, but easy enough to make for dinner! Topped with caramelized soy chicken and a ramen egg. This classic shoyu chicken ramen can be made in about 45 minutes, and 30 minutes for the easier version.You also have the option of marinating the chicken and ramen eggs overnight to increase flavor. INTERMEDIATE - This is an overall easy recipe, but it does have several components. It&#039;s recommended to make each component separately the first time you make this, but afterwards, it&#039;ll be easier to multitask and make the components simultaneously. An easier version of the recipe is also included. Makes 4 servings of chicken ramen.US based cup, teaspoon, tablespoon measurements. Common Measurement Conversions. Weight measurements are recommended for accurate results.","datePublished":"2019-01-08T21:04:21+00:00","image":["https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/01\/Easy-Chicken-Ramen-Featured.jpg","https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/01\/Easy-Chicken-Ramen-Featured-500x500.jpg","https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/01\/Easy-Chicken-Ramen-Featured-500x375.jpg","https:\/\/www.theflavorbender.com\/wp-content\/uploads\/2019\/01\/Easy-Chicken-Ramen-Featured-480x270.jpg"],"recipeYield":["4","4 servings"],"prepTime":"PT5M","cookTime":"PT40M","totalTime":"PT45M","recipeIngredient":["30 mL mirin (2 tbsp)","15 mL dark soy sauce (or mushroom dark soy sauce)","15 mL light soy sauce (1 tbsp)","¼ tsp cayenne pepper","2 cloves garlic  (chopped finely)","4 pieces chicken thighs (boneless, skin off or on)","2 tsp brown sugar","30 mL dark soy sauce (or mushroom dark soy sauce)","4 - 5 cups good quality chicken stock (1000 - 1180 mL. No sodium or low sodium)","4  spring onions \/ scallions (trimmed and cut into 3 inch pieces, or just in half)","5 cloves garlic (whole cloves are fine)","2 inch piece of ginger (sliced)","4  fresh red chili","60 mL light soy sauce (¼ cup)","60 mL mirin (¼ cup)","8 ounces fresh shiitake mushrooms (stems trimmed and sliced, or cut in half)","6 pieces dried shiitake mushrooms (optional. See recipe notes below.)","4 portions dried ramen noodles","4  large eggs","1  large bunch of yu choy OR spinach (or any Asian greens)","Soy sauce (to taste)","Sesame oil (a drizzle)","2 - 3 cloves garlic (finely sliced, to taste)","4  spring onions \/ scallions (finely sliced)","Sliced radishes or bean sprouts","Ramen eggs (marinated or plain)","Chili garlic oil"],"recipeInstructions":[{"@type":"HowToSection","name":"Caramelized soy chicken","itemListElement":[{"@type":"HowToStep","text":"Place all the ingredients for the chicken marinade in a bowl. Mix well to coat the chicken. If time permits, allow the chicken to marinate for at least 1 hour.","name":"Place all the ingredients for the chicken marinade in a bowl. Mix well to coat the chicken. If time permits, allow the chicken to marinate for at least 1 hour.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-0-0"},{"@type":"HowToStep","text":"Preheat the oven to 425°F \/ 218°C, and place an oven rack in the top third of your oven. Line a baking sheet with parchment paper.","name":"Preheat the oven to 425°F \/ 218°C, and place an oven rack in the top third of your oven. Line a baking sheet with parchment paper.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-0-1"},{"@type":"HowToStep","text":"Place the chicken pieces on the baking sheet, skin side down (or smooth side down), evenly spaced apart. Then place the baking sheet in the preheated oven (upper third).","name":"Place the chicken pieces on the baking sheet, skin side down (or smooth side down), evenly spaced apart. Then place the baking sheet in the preheated oven (upper third).","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-0-2"},{"@type":"HowToStep","text":"Let the chicken roast for 15 minutes. While the chicken is cooking, mix the brown sugar and dark soy sauce for the glaze, and start making the ramen. (Please note that the cook time for the chicken will vary depending on the size and thickness of the chicken thigh pieces you are using. )","name":"Let the chicken roast for 15 minutes. While the chicken is cooking, mix the brown sugar and dark soy sauce for the glaze, and start making the ramen. (Please note that the cook time for the chicken will vary depending on the size and thickness of the chicken thigh pieces you are using. )","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-0-3"},{"@type":"HowToStep","text":"After 15 minutes, flip the chicken pieces over and spoon the glaze over them. Let the chicken cook for a further 10 - 15 minutes. Then remove from the oven and let them cool down.","name":"After 15 minutes, flip the chicken pieces over and spoon the glaze over them. Let the chicken cook for a further 10 - 15 minutes. Then remove from the oven and let them cool down.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-0-4"},{"@type":"HowToStep","text":"Slice the chicken and set aside.","name":"Slice the chicken and set aside.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-0-5"}]},{"@type":"HowToSection","name":"Ramen","itemListElement":[{"@type":"HowToStep","text":"While the caramelized soy chicken is cooking in the oven, make the ramen base.","name":"While the caramelized soy chicken is cooking in the oven, make the ramen base.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-0"},{"@type":"HowToStep","text":"Place two saucepans on the stove.&nbsp;","name":"Place two saucepans on the stove.&nbsp;","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-1"},{"@type":"HowToStep","text":"As an optional step, you can chop the garlic and ginger. Or you can add them whole or sliced, and strain the ramen stock to remove the large pieces of garlic and ginger later. ","name":"As an optional step, you can chop the garlic and ginger. Or you can add them whole or sliced, and strain the ramen stock to remove the large pieces of garlic and ginger later. ","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-2"},{"@type":"HowToStep","text":"In one saucepan (Pot 1), place the stock, ginger, garlic, spring onions, chili (if using), soy sauce, and mirin. Stir and cover the pot. Let it come to a boil at medium high - high heat. Then lower the heat to medium and let it simmer for 20 - 25 minutes. Taste the base and add more salt if needed. ","name":"In one saucepan (Pot 1), place the stock, ginger, garlic, spring onions, chili (if using), soy sauce, and mirin. Stir and cover the pot. Let it come to a boil at medium high - high heat. Then lower the heat to medium and let it simmer for 20 - 25 minutes. Taste the base and add more salt if needed. ","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-3"},{"@type":"HowToStep","text":"To add more flavor to the stock base, you can also add dried shiitake mushrooms to the broth. The dried mushroom will reconstitute as the stock heats up and add a lot of umami flavor to the broth.","name":"To add more flavor to the stock base, you can also add dried shiitake mushrooms to the broth. The dried mushroom will reconstitute as the stock heats up and add a lot of umami flavor to the broth.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-4"},{"@type":"HowToStep","text":"While Pot 1 is simmering, add water to the second pot (Pot 2), and bring it to a boil. Add the dried noodles to the boiling water and cook according to package directions. I prefer to cook the noodles for ONE MINUTE LESS than what&#39;s recommended on the package, since the noodles will continue to cook for a bit longer when served with hot broth. The straight ramen noodles I use here take 3  minutes to cook. Drain the noodles and divide into 4 bowls and set aside. ","name":"While Pot 1 is simmering, add water to the second pot (Pot 2), and bring it to a boil. Add the dried noodles to the boiling water and cook according to package directions. I prefer to cook the noodles for ONE MINUTE LESS than what&#39;s recommended on the package, since the noodles will continue to cook for a bit longer when served with hot broth. The straight ramen noodles I use here take 3  minutes to cook. Drain the noodles and divide into 4 bowls and set aside. ","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-5"},{"@type":"HowToStep","text":"When the ramen base in Pot 1 has cooked for about 20 - 25 minutes, strain to remove the garlic, ginger, chili, and spring onions (or only the spring onions and chili). If you added dried mushrooms, remove these. Slice these mushrooms and set aside.","name":"When the ramen base in Pot 1 has cooked for about 20 - 25 minutes, strain to remove the garlic, ginger, chili, and spring onions (or only the spring onions and chili). If you added dried mushrooms, remove these. Slice these mushrooms and set aside.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-6"},{"@type":"HowToStep","text":"Add the strained stock back into the pot and add the mushrooms (fresh and reconstituted dried mushrooms) , and let it cook for a further 5 minutes until the fresh mushrooms have softened. The ramen base is now ready. ","name":"Add the strained stock back into the pot and add the mushrooms (fresh and reconstituted dried mushrooms) , and let it cook for a further 5 minutes until the fresh mushrooms have softened. The ramen base is now ready. ","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-1-7"}]},{"@type":"HowToSection","name":"Ramen egg or unseasoned soft boiled egg","itemListElement":[{"@type":"HowToStep","text":"Make ramen eggs the day before, according to this recipe. OR make regular soft boiled eggs to top your ramen bowl. (Ramen eggs need at least 2 hours to marinate.)","name":"Make ramen eggs the day before, according to this recipe. OR make regular soft boiled eggs to top your ramen bowl. (Ramen eggs need at least 2 hours to marinate.)","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-2-0"},{"@type":"HowToStep","text":"To make regular soft boiled eggs - bring a pot of water to a boil. Lower 4 large eggs carefully into the water and cook the eggs for 6 - 6 ½ minutes.","name":"To make regular soft boiled eggs - bring a pot of water to a boil. Lower 4 large eggs carefully into the water and cook the eggs for 6 - 6 ½ minutes.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-2-1"},{"@type":"HowToStep","text":"Immediately place the eggs in cool running water or an ice bath for a few minutes. Peel and set aside until ready to serve. This can be done BEFORE you cook the ramen as well.","name":"Immediately place the eggs in cool running water or an ice bath for a few minutes. Peel and set aside until ready to serve. This can be done BEFORE you cook the ramen as well.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-2-2"}]},{"@type":"HowToSection","name":"Steamed greens","itemListElement":[{"@type":"HowToStep","text":"Wash the greens and cut them in half, or into sections if necessary, to separate thick stems from the leaves.","name":"Wash the greens and cut them in half, or into sections if necessary, to separate thick stems from the leaves.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-3-0"},{"@type":"HowToStep","text":"Place the greens in a bowl and drizzle a little soy sauce and sesame oil (and garlic) on top. Toss to combine.","name":"Place the greens in a bowl and drizzle a little soy sauce and sesame oil (and garlic) on top. Toss to combine.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-3-1"},{"@type":"HowToStep","text":"Cover and microwave in 1 minute increments until the greens have softened, but not too wilted.","name":"Cover and microwave in 1 minute increments until the greens have softened, but not too wilted.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-3-2"},{"@type":"HowToStep","text":"Alternatively, you can heat a non-stick pan with a little oil, and pan fry the greens with soy sauce and garlic for about 2 - 4 minutes. You can also blanche the greens in the ramen broth for about 1 minute. Remove the greens and then drizzle soy sauce, sesame oil, garlic, and toss to mix.","name":"Alternatively, you can heat a non-stick pan with a little oil, and pan fry the greens with soy sauce and garlic for about 2 - 4 minutes. You can also blanche the greens in the ramen broth for about 1 minute. Remove the greens and then drizzle soy sauce, sesame oil, garlic, and toss to mix.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-3-3"}]},{"@type":"HowToSection","name":"To serve","itemListElement":[{"@type":"HowToStep","text":"Evenly divide the hot stock between the four bowls with ramen noodles.","name":"Evenly divide the hot stock between the four bowls with ramen noodles.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-4-0"},{"@type":"HowToStep","text":"Top with the steamed greens, sliced soy chicken, ramen eggs, spring onions, radishes, and other toppings you like.","name":"Top with the steamed greens, sliced soy chicken, ramen eggs, spring onions, radishes, and other toppings you like.","url":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#wprm-recipe-25934-step-4-1"}]}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.95","ratingCount":"151","reviewCount":"13"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I wanted some ramen but didn't have all the ingredients, so I improvised and basically followed only the chicken part of the recipe, using the seasoning from the ramen noodle packets I had. The chicken on its own was delicious, so now I really want to try this with ALL the correct ingredients! \r\n\r\nI have some dashi powder that I'm kicking myself for not adding to the broth I had. Sounds like that might be a good addition for more flavor if needed. Thanks so much for sharing this!","author":{"@type":"Person","name":"Cheryl H."},"datePublished":"2026-08-14"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Loved this ramen. This was my first time making ramen and it came out great! I made the ramen eggs and just bought some noodles. Everything came together great. It was a hit in our house!","author":{"@type":"Person","name":"Sharon"},"datePublished":"2026-04-26"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Very glad I found this recipe! I finally decided to make a proper bowl of ramen. I was browsing recipes until I came across this one. Again, very glad I decided to go with this one. I will look into your other recipes as well.","author":{"@type":"Person","name":"C.G."},"datePublished":"2026-02-25"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Fabulous! I’ve made a lot of Ramen from scratch and always in the search of a ramen recipe that’s easy, delicious, and customizable. This one hits the mark. The broth with homemade chicken stock is outstanding, I don’t think slicing and returning the dried shiitake to the broth adds a lot because I also had fresh mushrooms. The soy glazed chicken is to die for, I’m saving extras for fried rice as suggested. Thank you!","author":{"@type":"Person","name":"KayDubb"},"datePublished":"2026-02-08"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"This is so delicious!  I had to sub for dark soy sauce but I found some to use next time.  This has a few steps but so so worth it and not difficult at all.  I am having just the broth leftover today and it is even better than last night.","author":{"@type":"Person","name":"Sally"},"datePublished":"2026-01-06"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Thank you for the recipe! I will definitely be making this again! I used beef stock because I didn‘t have chicken stock and I didn‘t have mirin, so I added sugar to rice vinegar and that worked great. I didn‘t add chili flakes because my son doesn‘t like spicy, but my husband and I added sriracha to our own and it was sooooo good! Thanks so much! Adding it to the dinner rotation for sure!","author":{"@type":"Person","name":"April"},"datePublished":"2025-12-28"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"this recipe is perfect! even my 7 year old brother who can be a little iffy with trying new things adores it! and it's the perfect meal to have when we want something filling but not too fatty","author":{"@type":"Person","name":"Mollie Mae"},"datePublished":"2025-09-13"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"This was incredible. We didn’t use fresh shitake mushrooms (only dried) but that was the only change we made. \r\nFelt very complicated but I’m sure the next time will take half the time. Either way 100% worth it 🤤","author":{"@type":"Person","name":"Hanna"},"datePublished":"2025-08-31"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"This was really good. Added enoki and oyster mushrooms to bowl and no chicken. Scaled down to half the recipe and used only one ramen pack and almost ran out of broth. Probably the mushrooms soaked it up. I would definitely make again. We love jammy eggs and really liked the marinated eggs.","author":{"@type":"Person","name":"Kris"},"datePublished":"2025-07-30"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Yum! Yummy!  I  used shaoxing wine instead of mirin...so good! Thank you!","author":{"@type":"Person","name":"Zoi"},"datePublished":"2025-06-12"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Amazing! We love this recipe. It does always take longer than I expect to develop the flavors I want and to cut\/prep everything. I allot more time than the recipe calls for, and it is still longer. However, my husband and I find this to be better than the nice ramen restaurants in our town. So, at the end of the day, it's worth it. It's my husband's new favorite thing I make! We're making it for Easter this year since we're taking it easy and it'll just be the two of us :)","author":{"@type":"Person","name":"Beth"},"datePublished":"2025-04-17"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Delicious!!! I will definitely make again. It was so flavorful.","author":{"@type":"Person","name":"ann"},"datePublished":"2025-03-11"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"This was great and so easy.  Thank you for the recipe.","author":{"@type":"Person","name":"Courtney Lai"},"datePublished":"2025-03-06"}],"recipeCategory":["Dinner","Lunch"],"recipeCuisine":["Asian","Japanese"],"keywords":"Asian recipes, Authentic ramen, Caramelized chicken, Chicken Recipes, Comfort food, East Asian recipes, Homemade ramen, Japanese ramen, Noodle soup, Noodles, Ramen, Ramen broth, Ramen eggs, Shoyu ramen","nutrition":{"@type":"NutritionInformation","calories":"658 kcal","carbohydrateContent":"88 g","proteinContent":"31 g","fatContent":"21 g","saturatedFatContent":"9 g","cholesterolContent":"172 mg","sodiumContent":"4123 mg","fiberContent":"4 g","sugarContent":"13 g","transFatContent":"0.02 g","unsaturatedFatContent":"12 g","servingSize":"1 serving"},"@id":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#recipe","isPartOf":{"@id":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/#article"},"mainEntityOfPage":"https:\/\/www.theflavorbender.com\/easy-homemade-chicken-ramen\/"}]}</script>
