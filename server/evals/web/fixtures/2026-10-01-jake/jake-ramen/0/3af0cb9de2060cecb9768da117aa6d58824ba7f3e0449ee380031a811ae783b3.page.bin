content="Easily make your own homemade ramen noodles from scratch with this simple, no-knead method that takes less than 60 minutes from start to finish." /><link rel="canonical" href="https://gingerandscotch.com/homemade-ramen-noodles-from-scratch/" /><meta name="author" content="Sandy" /><meta name="twitter:label1" content="Written by" /><meta name="twitter:data1" content="Sandy" /><meta name="twitter:label2" content="Est. reading time" /><meta name="twitter:data2" content="13 minutes" /> <script type="application/ld+json" class="yoast-schema-graph">{"@context":"https:\/\/schema.org","@graph":[{"@type":"Article","@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#article","isPartOf":{"@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/"},"author":{"name":"Sandy","@id":"https:\/\/gingerandscotch.com\/#\/schema\/person\/f458d85aef4384956385e8ec58f6c9eb"},"headline":"Ramen Noodles From Scratch (the No-Knead Easy Way)","datePublished":"2017-07-10T16:10:43+00:00","dateModified":"2021-06-11T06:46:05+00:00","wordCount":2785,"commentCount":119,"publisher":{"@id":"https:\/\/gingerandscotch.com\/#organization"},"image":{"@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#primaryimage"},"thumbnailUrl":"https:\/\/gingerandscotch.com\/wp_sd\/wp-content\/uploads\/2017\/06\/Alkaline_Noodles-1806.jpg","keywords":["TOS"],"articleSection":["Noodle Tutorials","Recipes"],"inLanguage":"en-US","potentialAction":[{"@type":"CommentAction","name":"Comment","target":["https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#respond"]}]},{"@type":"WebPage","@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/","name":"Ramen Noodles From Scratch (the No-Knead Easy Way) - Ginger and Scotch","isPartOf":{"@id":"https:\/\/gingerandscotch.com\/#website"},"primaryImageOfPage":{"@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#primaryimage"},"image":{"@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#primaryimage"},"thumbnailUrl":"https:\/\/gingerandscotch.com\/wp_sd\/wp-content\/uploads\/2017\/06\/Alkaline_Noodles-1806.jpg","datePublished":"2017-07-10T16:10:43+00:00","dateModified":"2021-06-11T06:46:05+00:00","description":"Easily make your own homemade ramen noodles from scratch with this simple, no-knead method that takes less than 60 minutes from start to finish.","breadcrumb":{"@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#breadcrumb"},"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#primaryimage","url":"https:\/\/gingerandscotch.com\/wp_sd\/wp-content\/uploads\/2017\/06\/Alkaline_Noodles-1806.jpg","contentUrl":"https:\/\/gingerandscotch.com\/wp_sd\/wp-content\/uploads\/2017\/06\/Alkaline_Noodles-1806.jpg","width":800,"height":953,"caption":"Kids Making Homemade Ramen Noodles From Scratch"},{"@type":"BreadcrumbList","@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https:\/\/gingerandscotch.com\/"},{"@type":"ListItem","position":2,"name":"Home Option 4","item":"https:\/\/gingerandscotch.com\/?page_id=80019"},{"@type":"ListItem","position":3,"name":"Ramen Noodles From Scratch (the No-Knead Easy Way)"}]},{"@type":"WebSite","@id":"https:\/\/gingerandscotch.com\/#website","url":"https:\/\/gingerandscotch.com\/","name":"Ginger and Scotch","description":"Noodle Recipes and Expat Stories from the Sandpit","publisher":{"@id":"https:\/\/gingerandscotch.com\/#organization"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/gingerandscotch.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":"Organization","@id":"https:\/\/gingerandscotch.com\/#organization","name":"Ginger and Scotch","url":"https:\/\/gingerandscotch.com\/","logo":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/gingerandscotch.com\/#\/schema\/logo\/image\/","url":"https:\/\/i0.wp.com\/gingerandscotch.com\/wp_sd\/wp-content\/uploads\/2008\/03\/Noodle-Logo-500px-x-500px-jpg.jpg?fit=500%2C500&ssl=1","contentUrl":"https:\/\/i0.wp.com\/gingerandscotch.com\/wp_sd\/wp-content\/uploads\/2008\/03\/Noodle-Logo-500px-x-500px-jpg.jpg?fit=500%2C500&ssl=1","width":500,"height":500,"caption":"Ginger and Scotch"},"image":{"@id":"https:\/\/gingerandscotch.com\/#\/schema\/logo\/image\/"},"sameAs":["https:\/\/www.facebook.com\/GingerAndScotch\/","https:\/\/www.instagram.com\/gingerandscotch\/"]},{"@type":"Person","@id":"https:\/\/gingerandscotch.com\/#\/schema\/person\/f458d85aef4384956385e8ec58f6c9eb","name":"Sandy","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/secure.gravatar.com\/avatar\/078e5933f3279ba7f14221fc7d5f4be6f73227d8ba9535cf164c051c8ff1930d?s=96&d=identicon&r=g","url":"https:\/\/secure.gravatar.com\/avatar\/078e5933f3279ba7f14221fc7d5f4be6f73227d8ba9535cf164c051c8ff1930d?s=96&d=identicon&r=g","contentUrl":"https:\/\/secure.gravatar.com\/avatar\/078e5933f3279ba7f14221fc7d5f4be6f73227d8ba9535cf164c051c8ff1930d?s=96&d=identicon&r=g","caption":"Sandy"},"description":"I’m Sandy (aka “Ginger”), married to “Scotch”. I write about my noodle obsession, expat life in Dubai, our travels, and the challenges of raising third-culture kids. I believe in slowing down, relishing time spent with our children and loved ones, and living our best life now. Read more...","sameAs":["https:\/\/gingerandscotch.com","https:\/\/www.facebook.com\/GingerAndScotch\/","https:\/\/www.instagram.com\/gingerandscotch\/","https:\/\/www.pinterest.com\/gingerandscotch\/","https:\/\/x.com\/https:\/\/twitter.com\/gingerandscotch"],"url":"https:\/\/gingerandscotch.com\/author\/sd-b\/"},{"@type":"Recipe","name":"Homemade Ramen Noodles From Scratch","author":{"@id":"https:\/\/gingerandscotch.com\/#\/schema\/person\/f458d85aef4384956385e8ec58f6c9eb"},"description":"Ramen is a type of Japanese noodle made from wheat flour. In Japan, it is eaten freshly made, not like the inexpensive packets of instant noodles which are deep-fried and full of MSG. Ramen originated from China – the term “ramen” means “boiled noodles” and is the Japanese kanji pronunciation of the Chinese characters for “lo mein”.To make fresh ramen at home, all you need is all-purpose flour, water and either lye water (purchased from an Asian grocery store) or substitute with&nbsp;baking soda. And a pasta machine helps!","datePublished":"2017-07-10T12:10:43+00:00","image":["https:\/\/gingerandscotch.com\/wp_sd\/wp-content\/uploads\/2017\/06\/Alkaline_Noodles-1865.jpg"],"recipeYield":["4","4 people"],"prepTime":"PT35M","cookTime":"PT10M","totalTime":"PT45M","recipeIngredient":["240 grams All-purpose flour ((or 8 oz, about 2 cups))","2 teaspoons baked baking soda ((or 1 teaspoon lye water aka \"kansui\"))","1\/2 cup + 1 teaspoon warm water"],"recipeInstructions":[{"@type":"HowToStep","text":"Make Your alkaline water solution.Add baked baking soda (or use &quot;kansui&quot; if you have that) to the warm water and mix well to make an alkaline solution.","name":"Make Your alkaline water solution.Add baked baking soda (or use &quot;kansui&quot; if you have that) to the warm water and mix well to make an alkaline solution.","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-0"},{"@type":"HowToStep","text":"Mix flour and alkaline solution in a large mixing bowl.  Place flour in a large bowl and pour in the alkaline solution. The flour will immediately turn a yellowish. Use a spoon, spatula or chopsticks to mix in the water until it is all incorporated into the flour. Then use your hands to squeeze the flour &quot;crumbs&quot; together into a ball. If the flour doesn’t completely form a ball after a bit of squeezing, then add more water, but only a tablespoon at a time, until you get one cohesive ball.","name":"Mix flour and alkaline solution in a large mixing bowl.  Place flour in a large bowl and pour in the alkaline solution. The flour will immediately turn a yellowish. Use a spoon, spatula or chopsticks to mix in the water until it is all incorporated into the flour. Then use your hands to squeeze the flour &quot;crumbs&quot; together into a ball. If the flour doesn’t completely form a ball after a bit of squeezing, then add more water, but only a tablespoon at a time, until you get one cohesive ball.","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-1"},{"@type":"HowToStep","text":"Rest dough for 30 minutes at room temperature. &nbsp;Wrap the dough in plastic wrap or place it in a bowl covered with a damp towel so the dough does not dry out.","name":"Rest dough for 30 minutes at room temperature. &nbsp;Wrap the dough in plastic wrap or place it in a bowl covered with a damp towel so the dough does not dry out.","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-2"},{"@type":"HowToStep","text":"\"Knead\" the dough for 2-3 minutes. &nbsp;Knead by hand or \"knead\" with a large-diameter rolling pin.&nbsp;To “knead” with a rolling pin, give the dough a couple of whacks, pat into a ball, whack it again and repeat.","name":"\"Knead\" the dough for 2-3 minutes. &nbsp;Knead by hand or \"knead\" with a large-diameter rolling pin.&nbsp;To “knead” with a rolling pin, give the dough a couple of whacks, pat into a ball, whack it again and repeat.","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-3"},{"@type":"HowToStep","text":"Roll dough flat with the pasta machine at the widest setting. &nbsp;Set your pasta machine to the widest setting (level 0 for Marcato brand and Level 6 for Imperia brand).&nbsp;Divide your dough in half and return the unused portion to it's plastic wrap or towel covered bowl. Flatten the other half of your dough as much as possible by hand (or whack with the rolling pin again) and start feeding it through the pasta machine.It will look raggedy and rough. Fold the raggedy dough into thirds and pass it through the machine again. Repeat 5 or 6 more times.&nbsp;Once the dough is flattened to a nice looking (not holey or broken into bits) rectangular shape, pass the dough through the machine two more times but in one piece without folding it into thirds.","name":"Roll dough flat with the pasta machine at the widest setting. &nbsp;Set your pasta machine to the widest setting (level 0 for Marcato brand and Level 6 for Imperia brand).&nbsp;Divide your dough in half and return the unused portion to it's plastic wrap or towel covered bowl. Flatten the other half of your dough as much as possible by hand (or whack with the rolling pin again) and start feeding it through the pasta machine.It will look raggedy and rough. Fold the raggedy dough into thirds and pass it through the machine again. Repeat 5 or 6 more times.&nbsp;Once the dough is flattened to a nice looking (not holey or broken into bits) rectangular shape, pass the dough through the machine two more times but in one piece without folding it into thirds.","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-4"},{"@type":"HowToStep","text":"Continue rolling the dough through the pasta machine until desired thickness.Adjust the pasta machine to the next smaller size setting and pass the dough through the rollers 2 more times but remember DO NOT FOLD in thirds anymore. Pass it through as a single sheet.Dust dough with a little tapioca starch or corn starch to prevent any possible stick-age.With our Marcato pasta machine, we started with the widest setting of 0, then went to level 1, then level 2 and stopped at level 4 which according ot the user manual is 1.9mm (1\/16 inch) thickness. We did try level 5 but the noodles came out too thin for our liking.At this point, the dough may not be completely smooth like our homemade udon dough but once it passes through the cutters, it will still become beautiful noodles!","name":"Continue rolling the dough through the pasta machine until desired thickness.Adjust the pasta machine to the next smaller size setting and pass the dough through the rollers 2 more times but remember DO NOT FOLD in thirds anymore. Pass it through as a single sheet.Dust dough with a little tapioca starch or corn starch to prevent any possible stick-age.With our Marcato pasta machine, we started with the widest setting of 0, then went to level 1, then level 2 and stopped at level 4 which according ot the user manual is 1.9mm (1\/16 inch) thickness. We did try level 5 but the noodles came out too thin for our liking.At this point, the dough may not be completely smooth like our homemade udon dough but once it passes through the cutters, it will still become beautiful noodles!","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-5"},{"@type":"HowToStep","text":"Cut dough into long strips of noodles with the pasta machine.Our Marcato pasta machine came with only two size options - a thick fettucine size or a thin spaghettini size. We used the spaghettini cutter to make these ramen noodles.If your flattened dough is too long, cut it in half. Lightly dust the dough with tapioca or corn starch and then pass it through the cutters.","name":"Cut dough into long strips of noodles with the pasta machine.Our Marcato pasta machine came with only two size options - a thick fettucine size or a thin spaghettini size. We used the spaghettini cutter to make these ramen noodles.If your flattened dough is too long, cut it in half. Lightly dust the dough with tapioca or corn starch and then pass it through the cutters.","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-6"},{"@type":"HowToStep","text":"Simmer noodles in boiling water.&nbsp;To cook these noodles, bring a large pot of water to boil. Then add the noodles and cook for 1 minute. These noodles are thin so don't need much time to cook at all or they'll become very gummy\/sticky.&nbsp;ou want to undercook them slightly as they'll also soften up slightly in your soup broth. Drain and rinse under cold water.","name":"Simmer noodles in boiling water.&nbsp;To cook these noodles, bring a large pot of water to boil. Then add the noodles and cook for 1 minute. These noodles are thin so don't need much time to cook at all or they'll become very gummy\/sticky.&nbsp;ou want to undercook them slightly as they'll also soften up slightly in your soup broth. Drain and rinse under cold water.","url":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#wprm-recipe-15078-step-0-7"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":"4.81","ratingCount":"42","reviewCount":"3"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Hi\r\nIs there a way to make instant ramen using homemade ramen noodles?","author":{"@type":"Person","name":"Chanel Pugh"},"datePublished":"2022-04-28"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"I have been craving ramen from my home town, it didn’t matter what brand of noodles I tried none of them were good enough. Finally I tried this recipe, and these are the best damn ramen noodles I have ever had ! Chewy and tasty, perfect consistency! I can’t believe how easy they were ! Thank you so much ! I can now have ramen whenever I want !","author":{"@type":"Person","name":"Imogen"},"datePublished":"2021-06-02"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"reviewBody":"Hello! This is a great recipe - thanks so much! \r\nI've got a question:\r\nHow can the ramen be preserved without freezing? Does drying work? I'd like to make some form of instant ramen although from what I've heard the actual version is difficult and involves frying the noodles first.\r\n\r\nThanks,\r\nMark","author":{"@type":"Person","name":"Mark"},"datePublished":"2021-05-22"}],"recipeCategory":["Noodles"],"recipeCuisine":["Chinese","Japanese"],"keywords":"alkaline noodles, Chinese noodles, homemade noodles, japanese noodles, lye noodles, noodles from scratch, ramen noodles, wheat noodles","nutrition":{"@type":"NutritionInformation","calories":"218 kcal","carbohydrateContent":"45 g","proteinContent":"6 g","sodiumContent":"276 mg","fiberContent":"1 g","servingSize":"1 serving"},"@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#recipe","isPartOf":{"@id":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/#article"},"mainEntityOfPage":"https:\/\/gingerandscotch.com\/homemade-ramen-noodles-from-scratch\/"}]}</script> <link rel='dns-prefetch' href='//www.googletagmanager.com' /><link rel='dns-prefetch' href='//stats.wp.com' /><link rel='dns-prefetch' href='//maps.googleapis.com' /><link rel='dns-prefetch' href='//maps.gstatic.com' /><link rel='dns-prefetch' href='//fonts.googleapis.com' /><link rel='dns-prefetch' href='//fonts.gstatic.com' /><link rel='dns-prefetch' href='//ajax.googleapis.com' /><link rel='dns-prefetch' href='//apis.google.com' /><link rel='dns-prefetch' href='//google-analytics.com' /><link rel='dns-prefetch' href='//www.google-analytics.com' /><link rel='dns-prefetch' href='//ssl.google-analytics.com' /><link rel='dns-prefetch' href='//youtube.com' /><link rel='dns-prefetch' href='//api.pinterest.com' /><link rel='dns-prefetch' href='//cdnjs.cloudflare.com' /><link rel='dns-prefetch' href='//connect.facebook.net' /><l