300" src="https://gingerandscotch.com/wp_sd/wp-content/uploads/2017/06/Alkaline_Noodles-1865.jpg" class="attachment-999999x300 size-999999x300" alt="Homemade fresh ramen noodles from scratch (Alkaline Noodles)" srcset="https://gingerandscotch.com/wp_sd/wp-content/uploads/2017/06/Alkaline_Noodles-1865.jpg 800w, https://gingerandscotch.com/wp_sd/wp-content/uploads/2017/06/Alkaline_Noodles-1865-125x83.jpg 125w, https://gingerandscotch.com/wp_sd/wp-content/uploads/2017/06/Alkaline_Noodles-1865-370x247.jpg 370w, https://gingerandscotch.com/wp_sd/wp-content/uploads/2017/06/Alkaline_Noodles-1865-640x426.jpg 640w, https://gingerandscotch.com/wp_sd/wp-content/uploads/2017/06/Alkaline_Noodles-1865-560x373.jpg 560w" sizes="(max-width: 450px) 100vw, 450px" /></noscript></div></div><div class="wprm-layout-column wprm-column-width-75 wprm-align-rows-center"><div class="wprm-layout-container meadow-header-accent" style="--wprm-layout-container-text-color: var(--meadow-accent-color);"> <span class="wprm-recipe-details wprm-recipe-author wprm-block-text-semi-bold">Ginger and Scotch</span></div><h2 class="wprm-recipe-name wprm-block-text-bold">Homemade Ramen Noodles From Scratch</h2><div class="wprm-spacer" style="height: 15px;"></div><style>#wprm-recipe-rating-0 .wprm-rating-star.wprm-rating-star-full svg *{fill:var(--meadow-accent-color)}#wprm-recipe-rating-0 .wprm-rating-star.wprm-rating-star-33 svg *{fill:url(#wprm-recipe-rating-0-33)}#wprm-recipe-rating-0 .wprm-rating-star.wprm-rating-star-50 svg *{fill:url(#wprm-recipe-rating-0-50)}#wprm-recipe-rating-0 .wprm-rating-star.wprm-rating-star-66 svg *{fill:url(#wprm-recipe-rating-0-66)}linearGradient#wprm-recipe-rating-0-33 stop{stop-color:var(--meadow-accent-color)}linearGradient#wprm-recipe-rating-0-50 stop{stop-color:var(--meadow-accent-color)}linearGradient#wprm-recipe-rating-0-66 stop{stop-color:var(--meadow-accent-color)}</style><svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="display:block;width:0px;height: