y and corrosion resistance Precision forged from a single piece of steel Ergonomic handle in three-rivet design Dishwasher safe, hand wash recommended Made in Germany *ZWILLING LIFETIME WARRANTYThis product is warranted against defects in material and workmanship.","thumbnail":{"thumbnails":[{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcRq-nWSXMtGCmH2ZVs-V1E4GOdfetWi1xDoNn-a1nDB0sPXXtOu4zDipadzCSo","width":128,"height":128},{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcTBurgAKaiHvn6FDBQIRzvStAcB_93Oxs0PU2jb3KOH_jaFk_hY3H9Sk84gbB8","width":256,"height":256},{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcSK5K6v5bXHtRy0tMz9cQqMjuJqUzj8huxj_7AgmnrKk6MXN5cgw23_j28uYiA","width":512,"height":512}],"placeholderColor":4294967295},"price":"$149.99","vendorName":"Osmo Kitchen","trackingParams":"CI4CEJP0ARgIIhMI3Py1ufCZlwMVjpnLAR11OzZb","buttonText":"Shop","buttonCommand":{"clickTrackingParams":"CI4CEJP0ARgIIhMI3Py1ufCZlwMVjpnLAR11OzZbygEEfYoqKQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CI4CEJP0ARgIIhMI3Py1ufCZlwMVjpnLAR11OzZbygEEfYoqKQ==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpKiIU-QdVde8rzTjsPHrqqnqTf6uk5PE-o5njnjRxl3DHGt7sd3U4LHNaX9EXR0s_-ta--5LzAVpKqXY1nsdZVoZUg_-aKpBThiHPW7SAagHbj8cUrm39CEe78jRej8o3sxoaNN4drvabG2ky_c_P-587rx81FGwi2TV7Ghqaaw0f_a7VADOniK7mEV6aiKcjaJE7VgRWQGSPvN8fqnCe6FrVtJn4A3XcRZbvi5xkta4EoHUQ1lCKWdpNameOMV45PSKJj591_iBLlAnObO57y5FMIK6FRz-AwP_Uvo2Nj5UUPnwpoNl0XXYaCDemchN82ERrpdgLj5crRq8QQqu9s7tPj1xDHu5wwECiRZYYaXUIJWfEY3RyJPt63-fZv7-niibrkGQYJ0XhJBtj-4EzazycnHel09QxGgtXLoEmW1x5ksG0UCym2TQPI_jSUilKUxlaaV1hDHIRm4rzWYbCUNbj8pkrEkW24hciaUa-5h8WyHDR34VTJgAtfF0a4UEUg7MZkeiONnxEPKJqnOtbnrwYYTLpdALc4xZ3Qyu-chVw93gKPYC1no7b1mI9n7Z2LB_upls-2-L8lbQEFjcnMVppjKK-slCSo__yDC2Rw0VzhOt8TOzBa8inI_8l5Bh5Nh-6urGfNxiBEfXU2kxuYMAmN4JPFjDVLPQhp5te6F3W8bii-btq8NAXIZtAPvXoEi6tgF0GPcQj61SmtMC8ZxKRKp56ZoC2LjTHXHsBS