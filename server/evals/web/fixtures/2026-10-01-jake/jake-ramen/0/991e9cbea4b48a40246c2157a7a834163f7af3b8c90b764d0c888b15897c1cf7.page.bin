<script>
(function() {
	var	baseUrl = "https:\/\/pinchofyum.com\/quick-homemade-ramen?poy-next-comments=%%next%%",
		currentPage = 1,
		totalPages = 9;
	document.querySelector('.poy-load-more-comments').addEventListener('click', function( event ) {
		event.preventDefault();
		var button = event.currentTarget;
		if (button.disabled) {
			return;
		}
		button.disabled = true;
		var errorMessage = document.querySelector('.poy-load-more-comments-error');
		errorMessage.hidden = true;
		var nextPage = currentPage + 1;

		var scrollPos = window.scrollY;
		var oReq = new XMLHttpRequest();
		function failed() {
			button.disabled = false;
			errorMessage.hidden = false;
		}
		oReq.addEventListener('load', function() {
			if (this.status < 200 || this.status >= 300) {
				failed();
				return;
			}
			document.querySelector('.comment-list').insertAdjacentHTML('beforeend', this.responseText);
			currentPage = nextPage;
			button.disabled = false;
			window.scrollTo( 0, scrollPos );
			if (currentPage >= totalPages) {
				button.remove();
			}
		});
		oReq.addEventListener('error', failed);
		oReq.addEventListener('abort', failed);
		oReq.addEventListener('timeout', failed);
		oReq.open('GET', baseUrl.replace('%%next%%', nextPage));
		oReq.timeout = 15000;
		oReq.send();
	});
}())
</script>
