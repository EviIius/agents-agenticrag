omemade-ramen#breadcrumb"},"mainEntity":[{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754134147"},{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754200270"},{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754290293"},{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658335039392"},{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658335673822"},{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658336554603"},{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1726851653977"},{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1726851729735"}],"inLanguage":"en-US","potentialAction":[{"@type":"ReadAction","target":["https:\/\/pinchofyum.com\/quick-homemade-ramen"]}]},{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#primaryimage","url":"https:\/\/pinchofyum.com\/tachyon\/Homemade-Ramen-4-3.jpg","contentUrl":"https:\/\/pinchofyum.com\/tachyon\/Homemade-Ramen-4-3.jpg","width":1200,"height":1800},{"@type":"BreadcrumbList","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Recipes","item":"https:\/\/pinchofyum.com\/recipes"},{"@type":"ListItem","position":2,"name":"Vegetarian"}]},{"@type":"WebSite","@id":"https:\/\/pinchofyum.com\/#website","url":"https:\/\/pinchofyum.com\/","name":"Pinch of Yum","description":"A food blog with simple and tasty recipes.","publisher":{"@id":"https:\/\/pinchofyum.com\/#\/schema\/person\/8d4b17c71f73debc14204a0352749dca"},"potentialAction":[{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https:\/\/pinchofyum.com\/?s={search_term_string}"},"query-input":{"@type":"PropertyValueSpecification","valueRequired":true,"valueName":"search_term_string"}}],"inLanguage":"en-US"},{"@type":["Person","Organization"],"@id":"https:\/\/pinchofyum.com\/#\/schema\/person\/8d4b17c71f73debc14204a0352749dca","name":"Lindsay Ostrom","image":{"@type":"ImageObject","inLanguage":"en-US","@id":"https:\/\/pinchofyum.com\/tachyon\/Headshot-Main-Bio-Circle.jpg","url":"https:\/\/pinchofyum.com\/tachyon\/Headshot-Main-Bio-Circle.jpg","contentUrl":"https:\/\/pinchofyum.com\/tachyon\/Headshot-Main-Bio-Circle.jpg","width":1638,"height":1638,"caption":"Lindsay"},"logo":{"@id":"https:\/\/pinchofyum.com\/tachyon\/Headshot-Main-Bio-Circle.jpg"},"description":"A little thing about me: I ♡ FOOD. I used to be a teacher, and now making food and writing about it online is my full-time job. I love talking with people about food, and I'm so glad you're here. Did you make a recipe? Tag @pinchofyum on Instagram so we can find you!","sameAs":["https:\/\/pinchofyum.com","https:\/\/www.facebook.com\/pinchofyum","https:\/\/instagram.com\/pinchofyum","https:\/\/pinterest.com\/pinchofyum","https:\/\/x.com\/pinchofyum"],"url":"https:\/\/pinchofyum.com\/author\/lindsay"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754134147","position":1,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754134147","name":"How do I make the crunchy panko topping?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"To make crunchy golden panko crumbs, heat a few tablespoons of oil in a large skillet over medium heat. Add the panko, stir for one minute or less, or until golden brown. Remove and place on paper towels to drain. You can also toss the panko with a little oil and toast them in the oven to get them golden and crispy.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754200270","position":2,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754200270","name":"I don't like mushrooms. Can I leave them out?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Sure! You can swap just about any veggie in its place or leave them out entirely. We'd recommend still cooking with the mushrooms though to give the broth a nice umami flavor and then just remove the mushrooms before serving. ","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754290293","position":3,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1615754290293","name":"How do I make the soft-boiled egg to go on top?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Good news - this is super easy! Boil water on the stove in a pot. Add your egg straight from the fridge and put the lid on the pot. Boil the egg for 6 minutes. Remove the egg and plunge it into an ice water bath. Peel the shell off, cut the egg in half, and place your beautiful jammy egg on top of your ramen.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658335039392","position":4,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658335039392","name":"All I have is powdered broth. Can I use it?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Sure! Liquid broth levels up this recipe but you can skip the ramen seasoning packet and swap just about any powdered broth in its place. We like <a href=\"https:\/\/amzn.to\/3PlvG0chttps:\/\/amzn.to\/3PlvG0c\" target=\"_blank\" rel=\"noreferrer noopener sponsored nofollow\">this<\/a> powdered soup base. <em>(Affiliate link)<\/em>","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658335673822","position":5,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658335673822","name":"My local grocery store didn't have dried shitake mushrooms. Where can I find them?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Good news - you can order them online <a href=\"https:\/\/amzn.to\/3yTjbSv\" target=\"_blank\" rel=\"noreferrer noopener nofollow\">here<\/a>. <em>(affiliate link)<\/em>","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658336554603","position":6,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1658336554603","name":"Have you used toasted sesame oil in this recipe?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"Yes, we’ve used both <a href=\"https:\/\/amzn.to\/3vrHZQR\">toasted sesame oil<\/a> and <a href=\"https:\/\/amzn.to\/3PG0NDE\" target=\"_blank\" rel=\"noreferrer noopener nofollow\">regular<\/a>. <em>(affiliate links)<\/em>","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1726851653977","position":7,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1726851653977","name":"What other vegetables are good in ramen?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"The kale and carrots are great here for texture and color, but I also love to use spinach, bok choy, and fresh mushrooms as well.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@type":"Question","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1726851729735","position":8,"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#faq-question-1726851729735","name":"Could I add meat to this ramen recipe?","answerCount":1,"acceptedAnswer":{"@type":"Answer","text":"You could add some pre-cooked and shredded chicken (rotisserie chicken works great here!), or throw in some shrimp near the end and let it cook in the broth.","inLanguage":"en-US"},"inLanguage":"en-US"},{"@context":"https:\/\/schema.org\/","@type":"Recipe","name":"Quick Homemade Ramen","description":"Take the usual ramen up a notch with this quick homemade ramen. Fresh veggies and herbs make this extra delicious, healthy, and cozy!","author":{"@type":"Person","name":"Lindsay Ostrom","url":"https:\/\/pinchofyum.com\/author\/lindsay"},"keywords":"homemade ramen, easy homemade ramen, ramen noodles","image":["https:\/\/pinchofyum.com\/tachyon\/Quick-Homemade-Ramen-Square.png?fit=225%2C225","https:\/\/pinchofyum.com\/tachyon\/Quick-Homemade-Ramen-Square.png?fit=195%2C195","https:\/\/pinchofyum.com\/tachyon\/Quick-Homemade-Ramen-Square.png?fit=180%2C180","https:\/\/pinchofyum.com\/tachyon\/Quick-Homemade-Ramen-Square.png"],"url":"https:\/\/pinchofyum.com\/quick-homemade-ramen","recipeIngredient":["1 tablespoon sesame oil","3 teaspoons grated ginger","4 teaspoons grated garlic","4 cups broth (I used chicken, but vegetable would also work)","4 cups water","1 ounce dried shiitake mushrooms","2 packages instant ramen (noodles only!)","1\/2 cup chopped scallions or chives","2 cup chopped kale (or spinach)","1 cups shredded carrots (or another vegetable like bok choy)","Sriracha to taste","crunchy golden panko crumbs for topping (see notes below)"],"recipeInstructions":[{"@type":"HowToStep","text":"Heat the sesame oil in a large skillet over medium low heat. Add the garlic and ginger; stir fry for 2 minutes or until soft and fragrant.","url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#instruction-step-1","video":{"@context":"http:\/\/schema.org","@type":"VideoObject","name":"Quick Homemade Ramen Step 1","description":"Heat the sesame oil in a large skillet over medium low heat. Add the garlic and ginger; stir fry for 2 minutes or until soft and fragrant.","duration":"PT6S","embedUrl":"https:\/\/player.vimeo.com\/video\/522884678?dnt=1&amp;app_id=122963","contentUrl":"https:\/\/vimeo.com\/522884678","thumbnailUrl":["https:\/\/i.vimeocdn.com\/video\/1082994459-75a538e32110aa961ac3c963257600b503e6e92c44fee532a7ff0a78ddc30115-d_295x166?region=us"],"uploadDate":"2021-03-12T12:03:20+00:00"}},{"@type":"HowToStep","text":"Add the broth and the water. Bring to a simmer; add the mushrooms and simmer for 10 minutes or until the mushrooms have softened and the broth is flavorful.","url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#instruction-step-2","video":{"@context":"http:\/\/schema.org","@type":"VideoObject","name":"Quick Homemade Ramen Step 2","description":"Add the broth and the water. Bring to a simmer; add the mushrooms and simmer for 10 minutes or until the mushrooms have softened and the broth is flavorful.","duration":"PT13S","embedUrl":"https:\/\/player.vimeo.com\/video\/522884846?dnt=1&amp;app_id=122963","contentUrl":"https:\/\/vimeo.com\/522884846","thumbnailUrl":["https:\/\/i.vimeocdn.com\/video\/1082995074-73fd3d7612e32769b9e48b2a3640f7f5ce08ae6e4ed3cb006be84b32d0de3ae2-d_295x166?region=us"],"uploadDate":"2021-03-12T12:03:45+00:00"}},{"@type":"HowToStep","text":"Add the instant noodles to the hot liquid and simmer for an additional 5 minutes or until the noodles have softened. Add the scallions and stir to combine.","url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#instruction-step-3","video":{"@context":"http:\/\/schema.org","@type":"VideoObject","name":"Quick Homemade Ramen Step 3","description":"Add the instant noodles to the hot liquid and simmer for an additional 5 minutes or until the noodles have softened. Add the scallions and stir to combine.","duration":"PT9S","embedUrl":"https:\/\/player.vimeo.com\/video\/522970619?dnt=1&amp;app_id=122963","contentUrl":"https:\/\/vimeo.com\/522970619","thumbnailUrl":["https:\/\/i.vimeocdn.com\/video\/1082994227-950f549d3a67ac0ae1dddb3bbfb2d718d6e410591ecafafeaaf388fc92527c60-d_295x166?region=us"],"uploadDate":"2021-03-12T15:58:24+00:00"}},{"@type":"HowToStep","text":"Remove from heat, stir in the kale and carrots, and top with crunchy panko crumbs (see notes) and a soft-boiled egg (optional). Season with chili oil, hot sauce, sesame oil, and\/or soy sauce and salt to taste.","url":"https:\/\/pinchofyum.com\/quick-homemade-ramen#instruction-step-4","video":{"@context":"http:\/\/schema.org","@type":"VideoObject","name":"Quick Homemade Ramen Step 4","description":"Remove from heat, stir in the kale and carrots, and top with crunchy panko crumbs (see notes) and a soft boiled egg (optional). Season with chili oil, hot sauce, sesame oil, and\/or soy sauce and salt to taste.","duration":"PT14S","embedUrl":"https:\/\/player.vimeo.com\/video\/522970694?dnt=1&amp;app_id=122963","contentUrl":"https:\/\/vimeo.com\/522970694","thumbnailUrl":["https:\/\/i.vimeocdn.com\/video\/1082996636-3f0a43d6674d5b7f78a5aeced0bf81c90c376bc273fb134222ae68b92b596527-d_295x166?region=us"],"uploadDate":"2021-03-12T15:58:37+00:00"}}],"prepTime":"PT5M","cookTime":"PT20M","totalTime":"PT25M","recipeYield":["6","makes 6 heaping 1-cup servings"],"recipeCategory":"Dinner","cookingMethod":"Stovetop","recipeCuisine":"Asian-Inspired","aggregateRating":{"@type":"AggregateRating","reviewCount":"119","ratingValue":"4.4"},"nutrition":{"servingSize":null,"calories":"197 calories","sugarContent":"2.5 g","sodiumContent":"1177.3 mg","fatContent":"7.7 g","saturatedFatContent":"2.6 g","transFatContent":"0 g","carbohydrateContent":"28 g","fiberContent":"2.6 g","proteinContent":"5.4 g","cholesterolContent":"0 mg","@type":"nutritionInformation"},"video":{"@context":"http:\/\/schema.org","@type":"VideoObject","name":"Quick Homemade Ramen","description":"Take the usual ramen up a notch with this quick homemade ramen. Fresh veggies and herbs make this extra delicious, healthy, and cozy!","contentUrl":"https:\/\/content.jwplatform.com\/videos\/GT2EiPaE.mp4","thumbnailUrl":["https:\/\/content.jwplatform.com\/thumbs\/GT2EiPaE-720.jpg"],"uploadDate":"2021-03-17T19:31:05+00:00"},"review":[{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"Padaek"},"datePublished":"2014-02-26","reviewBody":"The noodle and broth looks super oishii!! :)"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"Chrystal @ YUMeating"},"datePublished":"2014-02-26","reviewBody":"We are huge fans for homemade Ramen. I believe it was last month we had a Ramen bar where we picked our own toppings. I tested an idea I had seen in the Food Network magazine by adding a fried egg to the top of mine. Oh, it was so delish!"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"karen"},"datePublished":"2014-02-27","reviewBody":"I second what Victoria said. But if you still have these Shin Ramen (I have a box for an emergency), you can boil the noodles in a pot of boiling water, drain and rinse. Then, add them to your homemade broth. \r\n\r\nAsian groceries also sell fresh ramen noodles that you can freeze. Those are even better than the plain dried ones. \r\n\r\nOne more thing I add to my broth is miso. It's. to. die. for. And oh, drop an egg in it at the very end. Don't stir."},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"DessertForTwo"},"datePublished":"2014-02-26","reviewBody":"Remember when Facebook required a college email address (with a .edu) to get started? That way only cool college kids could play? Oh, I wish it stayed that way!"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"Derek"},"datePublished":"2020-11-21","reviewBody":"That was the #1 way to meet girls and hang out, your group of friends with their group of friends. I went Abilene Christian in Texas, and I remember our url to login was acu.facebook.com. If I wanted to be friends to talk to some of my friends who went to Azusa Pacific or Pepperdine, apu.facebook.com and I forgot the malibu address. I think at one point I had 3100 friends. Anyways, thats something that I forgot that was a genius way of online hanging out with JUST your school. Thanks for the memory, and the tasty ramen!"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"Derek"},"datePublished":"2020-11-21","reviewBody":"Forgot to add...after college, honed the friends list WAY down. Keeping caught up with good friends. Out of nowhere, my mom invites me to be her friend. I was living, at the time, with my mom. There were DEF pictures on my feed that needed to be retracted before my family could touch my FB. Me standing under a pyramid of 100 beer cans? no thanks, mom. I instantly got off of facebook and took a 1 year hiatus, which was hard. Wouldn't you know, the day I log back in, my profile never erased  a single setting, friend, or photo. I pressed delete 3 times to get off the site, and it kept all my data fresh that whole time. It took me 2 hours to go through my feed and erase any deragatory (trying to be funny) posts, any pictures with girls who showed too much skin or of me in the background slamming a cheap adult bevvy. Then friends from church and family were all invited and Facebook died forever. It's still nice to see my roomates kids, but its not the same."},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"Chelsea @ Gal on a Mission"},"datePublished":"2014-02-26","reviewBody":"I just love the colors, Lindsay! Gorgeous as always. \r\n\r\nFor years I lived off of Ramen Noodles, but never tried it homemade. Adding this to my bucket list of recipes. Yum! :)"},{"@type":"Review","reviewRating":{"@type":"Rating","ratingValue":"5"},"author":{"@type":"Person","name":"Joanna@DrizzleofSunshine"},"datePublished":"2014-02-26","reviewBody":"It's finally getting cold here in California so this will be at the top of the list to make. I LOOOVE Ramen noodles. As a child, I went through a phase where all I ate was that. I should've turned into a package of Ramen, I ate so much! Love the additions you made. Crunchy Tempura makes it!"}],"datePublished":"2021-03-15","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#recipe","isPartOf":{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#article"},"mainEntityOfPage":"https:\/\/pinchofyum.com\/quick-homemade-ramen"},{"@type":"VideoObject","@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#video","name":"Quick Homemade Ramen - Pinch of Yum","isPartOf":{"@id":"https:\/\/pinchofyum.com\/quick-homemade-ramen#article"},"thumbnailUrl":"https:\/\/pinchofyum.com\/uploads\/Homemade-Ramen-4-3.jpg","description":"How to make instant ramen better! This homemade ramen is quick and uses fresh veggies and herbs take the usual ramen up a notch.","uploadDate":"2021-03-15T04:00:00+00:00","width":1920,"height":1080,"embedUrl":"https:\/\/player.vimeo.com\/video\/522884678","duration":"PT49S","isFamilyFriendly":true,"inLanguage":"en-US"}]}</script>
