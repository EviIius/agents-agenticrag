-17" id="mwDRU"><span class="mw-linkback-text" id="mwDRY">18</span></a> <a href="#cite_ref-Bouverie-2025_17-18" id="mwDRc"><span class="mw-linkback-text" id="mwDRg">19</span></a> <a href="#cite_ref-Bouverie-2025_17-19" id="mwDRk"><span class="mw-linkback-text" id="mwDRo">20</span></a> <a href="#cite_ref-Bouverie-2025_17-20" id="mwDRs"><span class="mw-linkback-text" id="mwDRw">21</span></a> <a href="#cite_ref-Bouverie-2025_17-21" id="mwDR0"><span class="mw-linkback-text" id="mwDR4">22</span></a> <a href="#cite_ref-Bouverie-2025_17-22" id="mwDR8"><span class="mw-linkback-text" id="mwDSA">23</span></a> <a href="#cite_ref-Bouverie-2025_17-23" id="mwDSE"><span class="mw-linkback-text" id="mwDSI">24</span></a> <a href="#cite_ref-Bouverie-2025_17-24" id="mwDSM"><span class="mw-linkback-text" id="mwDSQ">25</span></a> <a href="#cite_ref-Bouverie-2025_17-25" id="mwDSU"><span class="mw-linkback-text" id="mwDSY">26</span></a> <a href="#cite_ref-Bouverie-2025_17-26" id="mwDSc"><span class="mw-linkback-text" id="mwDSg">27</span></a> <a href="#cite_ref-Bouverie-2025_17-27" id="mwDSk"><span class="mw-linkback-text" id="mwDSo">28</span></a> <a href="#cite_ref-Bouverie-2025_17-28" id="mwDSs"><span class="mw-linkback-text" id="mwDSw">29</span></a> <a href="#cite_ref-Bouverie-2025_17-29" id="mwDS0"><span class="mw-linkback-text" id="mwDS4">30</span></a></span> <span id="mw-reference-text-cite_note-Bouverie-2025-17" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt141" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDS8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Bouverie"},"first":{"wt":"Tim"},"title":{"wt":"Allies at War: The Politics of Defeating Hitler"},"publisher":{"wt":"Vintage Digital"},"year":{"wt":"2025"},"isbn":{"wt":"978-1529926590"}},"i":0}}]}'/><cite id="CITEREFBouverie2025" class="citation book cs1" about="#mwt141">Bouverie, Tim (2025). <i id="mwDTA">Allies at War: The Politics of Defeating Hitler</i>. Vintage Digital. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDTE">ISBN</a><span typeof="mw:Entity" id="mwDTI"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-1529926590" title="Special:BookSources/978-1529926590" id="mwDTM"><bdi id="mwDTQ">978-1529926590</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Allies+at+War%3A+The+Politics+of+Defeating+Hitler&amp;rft.pub=Vintage+Digital&amp;rft.date=2025&amp;rft.isbn=978-1529926590&amp;rft.aulast=Bouverie&amp;rft.aufirst=Tim&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt141" id="mwDTU"></span></span></li>
<li about="#cite_note-18" id="cite_note-18" data-mw-footnote-number="17"><span class="mw-cite-backlink" id="mwDTY"><a href="#cite_ref-18" rel="mw:referencedBy" id="mwDTc"><span class="mw-linkback-text" id="mwDTg">↑</span></a></span> <span id="mw-reference-text-cite_note-18" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFAkio2015" about="#mwt126" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDTk" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Akio"},"2":{"wt":"2015"},"pp":{"wt":"124-125"}},"i":0}}]}'>Akio (2015)</a><span about="#mwt126" id="mwDTo">, pp.</span><span typeof="mw:Entity" about="#mwt126" id="mwDTs"> </span><span about="#mwt126" id="mwDTw">124–125</span>.</span></li>
<li about="#cite_note-19" id="cite_note-19" data-mw-footnote-number="18"><span class="mw-cite-backlink" id="mwDT0"><a href="#cite_ref-19" rel="mw:referencedBy" id="mwDT4"><span class="mw-linkback-text" id="mwDT8">↑</span></a></span> <span id="mw-reference-text-cite_note-19" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFHoward2014" about="#mwt129" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDUA" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Howard"},"2":{"wt":"2014"},"ps":{"wt":". \"Grand Alliance: term coined by Churchill to describe the association of nations, in particular the UK, USA, and USSR, which came together to fight the Axis powers in the Second World War.\""}},"i":0}}]}'>Howard (2014)</a><span about="#mwt129" id="mwDUE">. "Grand Alliance: term coined by Churchill to describe the association of nations, in particular the UK, USA, and USSR, which came together to fight the Axis powers in the Second World War."</span></span></li>
<li about="#cite_note-20" id="cite_note-20" data-mw-footnote-number="19"><span class="mw-cite-backlink" id="mwDUI"><a href="#cite_ref-20" rel="mw:referencedBy" id="mwDUM"><span class="mw-linkback-text" id="mwDUQ">↑</span></a></span> <span id="mw-reference-text-cite_note-20" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt131" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDUU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Overy"},"first":{"wt":"Richard"},"title":{"wt":"Why the Allies Won"},"publisher":{"wt":"W. W. Norton &amp; Company"},"isbn":{"wt":"0393039250"},"location":{"wt":"New York and London"},"publication-date":{"wt":"1996"},"pages":{"wt":"2"}},"i":0}}]}'/><cite id="CITEREFOvery1996" class="citation book cs1" about="#mwt131">Overy, Richard (1996). <i id="mwDUY">Why the Allies Won</i>. New York and London: W. W. Norton &amp; Company. p.<span typeof="mw:Entity" id="mwDUc"> </span>2. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDUg">ISBN</a><span typeof="mw:Entity" id="mwDUk"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/0393039250" title="Special:BookSources/0393039250" id="mwDUo"><bdi id="mwDUs">0393039250</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Why+the+Allies+Won&amp;rft.place=New+York+and+London&amp;rft.pages=2&amp;rft.pub=W.+W.+Norton+%26+Company&amp;rft.date=1996&amp;rft.isbn=0393039250&amp;rft.aulast=Overy&amp;rft.aufirst=Richard&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt131" id="mwDUw"></span></span></li>
<li about="#cite_note-Johnsen-2016b-21" id="cite_note-Johnsen-2016b-21" data-mw-footnote-number="20"><span class="mw-cite-backlink" id="mwDU0"><a href="#cite_ref-Johnsen-2016b_21-0" rel="mw:referencedBy" id="mwDU4"><span class="mw-linkback-text" id="mwDU8">↑</span></a></span> <span id="mw-reference-text-cite_note-Johnsen-2016b-21" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt134" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDVA" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Johnsen"},"first":{"wt":"William T."},"url":{"wt":"https://books.google.com/books?id=ivm6DAAAQBAJ"},"title":{"wt":"The Origins of the Grand Alliance: Anglo-American Military Collaboration from the Panay Incident to Pearl Harbor"},"date":{"wt":"2016"},"publisher":{"wt":"University Press of Kentucky"},"isbn":{"wt":"978-0-8131-6836-4"},"language":{"wt":"en"},"quote":{"wt":"Although many factors manifestly contributed to the ultimately victory, not least the Soviet Union&apos;s joining of the coalition, the coalition partners&apos; ability to orchestrate their efforts and coordinate the many elements of modern warfare successfully must rank high in any assessment."}},"i":0}}]}'/><cite id="mwDVE" class="citation book cs1" about="#mwt134" data-x-id="CITEREFJohnsen2016">Johnsen, William T. (2016). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=ivm6DAAAQBAJ" class="external text" id="mwDVI"><i id="mwDVM">The Origins of the Grand Alliance: Anglo-American Military Collaboration from the Panay Incident to Pearl Harbor</i></a>. University Press of Kentucky. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDVQ">ISBN</a><span typeof="mw:Entity" id="mwDVU"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-8131-6836-4" title="Special:BookSources/978-0-8131-6836-4" id="mwDVY"><bdi id="mwDVc">978-0-8131-6836-4</bdi></a>. <q id="mwDVg">Although many factors manifestly contributed to the ultimately victory, not least the Soviet Union's joining of the coalition, the coalition partners' ability to orchestrate their efforts and coordinate the many elements of modern warfare successfully must rank high in any assessment.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=The+Origins+of+the+Grand+Alliance%3A+Anglo-American+Military+Collaboration+from+the+Panay+Incident+to+Pearl+Harbor&amp;rft.pub=University+Press+of+Kentucky&amp;rft.date=2016&amp;rft.isbn=978-0-8131-6836-4&amp;rft.aulast=Johnsen&amp;rft.aufirst=William+T.&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3Divm6DAAAQBAJ&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt134" id="mwDVk"></span></span></li>
<li about="#cite_note-22" id="cite_note-22" data-mw-footnote-number="21"><span class="mw-cite-backlink" id="mwDVo"><a href="#cite_ref-22" rel="mw:referencedBy" id="mwDVs"><span class="mw-linkback-text" id="mwDVw">↑</span></a></span> <span id="mw-reference-text-cite_note-22" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFHoward2014" about="#mwt137" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDV0" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Howard"},"2":{"wt":"2014"},"ps":{"wt":". \"The British on the other hand regarded the Chinese military potential as negligible and were unimpressed by Chiang either as a political or as a military leader, an opinion which he himself helped to reinforce when he attended the Cairo conference in November 1943.\""}},"i":0}}]}'>Howard (2014)</a><span about="#mwt137" id="mwDV4">. "The British on the other hand regarded the Chinese military potential as negligible and were unimpressed by Chiang either as a political or as a military leader, an opinion which he himself helped to reinforce when he attended the Cairo conference in November 1943."</span></span></li>
<li about="#cite_note-ReferenceA-23" id="cite_note-ReferenceA-23" data-mw-footnote-number="22"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwDV8"><a href="#cite_ref-ReferenceA_23-0" id="mwDWA"><span class="mw-linkback-text" id="mwDWE">1</span></a> <a href="#cite_ref-ReferenceA_23-1" id="mwDWI"><span class="mw-linkback-text" id="mwDWM">2</span></a></span> <span id="mw-reference-text-cite_note-ReferenceA-23" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFUnited_Nations1948" about="#mwt144" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDWQ" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"United Nations"},"2":{"wt":"1948"},"p":{"wt":"1"}},"i":0}}]}'>United Nations (1948)</a><span about="#mwt144" id="mwDWU">, p.</span><span typeof="mw:Entity" about="#mwt144" id="mwDWY"> </span><span about="#mwt144" id="mwDWc">1</span>.</span></li>
<li about="#cite_note-24" id="cite_note-24" data-mw-footnote-number="23"><span class="mw-cite-backlink" id="mwDWg"><a href="#cite_ref-24" rel="mw:referencedBy" id="mwDWk"><span class="mw-linkback-text" id="mwDWo">↑</span></a></span> <span id="mw-reference-text-cite_note-24" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt175" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDWs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"title":{"wt":"The Oxford Companion to World War II"},"date":{"wt":"2014"},"publisher":{"wt":"Oxford University Press"},"isbn":{"wt":"9780191727603"},"editor-last":{"wt":"Dear"},"editor-first":{"wt":"I. C. B."},"chapter":{"wt":"Allied powers"},"doi":{"wt":"10.1093/acref/9780198604464.001.0001"},"quote":{"wt":"From January 1942 all countries, including the governments-in-exile of those countries occupied by the Germans, which became a party to the United Nations Declaration were also regarded as Allied powers."},"editor-last2":{"wt":"Foot"},"editor-first2":{"wt":"M. R. D."}},"i":0}}]}'/><cite id="CITEREFDearFoot2014" class="citation book cs1" about="#mwt175">Dear, I. C. B.; Foot, M. R. D., eds. (2014). "Allied powers". <i id="mwDWw">The Oxford Companion to World War II</i>. Oxford University Press. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDW0">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1093%2Facref%2F9780198604464.001.0001" class="external text" id="mwDW4">10.1093/acref/9780198604464.001.0001</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDW8">ISBN</a><span typeof="mw:Entity" id="mwDXA"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9780191727603" title="Special:BookSources/9780191727603" id="mwDXE"><bdi id="mwDXI">9780191727603</bdi></a>. <q id="mwDXM">From January 1942 all countries, including the governments-in-exile of those countries occupied by the Germans, which became a party to the United Nations Declaration were also regarded as Allied powers.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=Allied+powers&amp;rft.btitle=The+Oxford+Companion+to+World+War+II&amp;rft.pub=Oxford+University+Press&amp;rft.date=2014&amp;rft_id=info%3Adoi%2F10.1093%2Facref%2F9780198604464.001.0001&amp;rft.isbn=9780191727603&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt175" id="mwDXQ"></span></span></li>
<li about="#cite_note-25" id="cite_note-25" data-mw-footnote-number="24"><span class="mw-cite-backlink" id="mwDXU"><a href="#cite_ref-25" rel="mw:referencedBy" id="mwDXY"><span class="mw-linkback-text" id="mwDXc">↑</span></a></span> <span id="mw-reference-text-cite_note-25" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFUnited_Nations1948" about="#mwt178" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDXg" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"United Nations"},"2":{"wt":"1948"},"pp":{"wt":"2-3"}},"i":0}}]}'>United Nations (1948)</a><span about="#mwt178" id="mwDXk">, pp.</span><span typeof="mw:Entity" about="#mwt178" id="mwDXo"> </span><span about="#mwt178" id="mwDXs">2–3</span>.</span></li>
<li about="#cite_note-Howard-2014b-26" id="cite_note-Howard-2014b-26" data-mw-footnote-number="25"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwDXw"><a href="#cite_ref-Howard-2014b_26-0" id="mwDX0"><span class="mw-linkback-text" id="mwDX4">1</span></a> <a href="#cite_ref-Howard-2014b_26-1" id="mwDX8"><span class="mw-linkback-text" id="mwDYA">2</span></a> <a href="#cite_ref-Howard-2014b_26-2" id="mwDYE"><span class="mw-linkback-text" id="mwDYI">3</span></a> <a href="#cite_ref-Howard-2014b_26-3" id="mwDYM"><span class="mw-linkback-text" id="mwDYQ">4</span></a> <a href="#cite_ref-Howard-2014b_26-4" id="mwDYU"><span class="mw-linkback-text" id="mwDYY">5</span></a> <a href="#cite_ref-Howard-2014b_26-5" id="mwDYc"><span class="mw-linkback-text" id="mwDYg">6</span></a></span> <span id="mw-reference-text-cite_note-Howard-2014b-26" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFHoward2014" about="#mwt180" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDYk" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Howard"},"2":{"wt":"2014"}},"i":0}}]}'>Howard (2014)</a>.</span></li>
