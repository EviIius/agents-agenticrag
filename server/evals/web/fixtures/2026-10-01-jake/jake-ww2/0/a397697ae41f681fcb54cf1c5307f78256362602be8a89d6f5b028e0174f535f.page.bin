<li about="#cite_note-124" id="cite_note-124" data-mw-footnote-number="122"><span class="mw-cite-backlink" id="mwEUQ"><a href="#cite_ref-124" rel="mw:referencedBy" id="mwEUU"><span class="mw-linkback-text" id="mwEUY">↑</span></a></span> <span id="mw-reference-text-cite_note-124" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt656" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEUc" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Deletant"},"first":{"wt":"Dennis"},"title":{"wt":"Hitler&apos;s Forgotten Ally : Ion Antonescu and His Regime, Romania 1940-44"},"publisher":{"wt":"Palgrave Macmillan"},"year":{"wt":"2006"},"isbn":{"wt":"9781403993410"},"location":{"wt":"Basingstoke"},"pages":{"wt":"61"}},"i":0}}]}'/><cite id="CITEREFDeletant2006" class="citation book cs1" about="#mwt656">Deletant, Dennis (2006). <i id="mwEUg">Hitler's Forgotten Ally<span typeof="mw:DisplaySpace" id="mwEUk"> </span>: Ion Antonescu and His Regime, Romania 1940-44</i>. Basingstoke: Palgrave Macmillan. p.<span typeof="mw:Entity" id="mwEUo"> </span>61. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwEUs">ISBN</a><span typeof="mw:Entity" id="mwEUw"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9781403993410" title="Special:BookSources/9781403993410" id="mwEU0"><bdi id="mwEU4">9781403993410</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Hitler%27s+Forgotten+Ally+%3A+Ion+Antonescu+and+His+Regime%2C+Romania+1940-44&amp;rft.place=Basingstoke&amp;rft.pages=61&amp;rft.pub=Palgrave+Macmillan&amp;rft.date=2006&amp;rft.isbn=9781403993410&amp;rft.