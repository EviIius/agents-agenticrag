<li id="mwCzY"><span class="flagicon" about="#mwt1075" typeof="mw:Transclusion" id="mwCzc" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"Pahlavi Iran"},"2":{"wt":"1933"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/Pahlavi_Iran" title="Pahlavi Iran"><img resource="https://en.wikipedia.org/wiki/File:State_flag_of_Iran_(1933–1964).svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/State_flag_of_Iran_%281933%E2%80%931964%29.svg/40px-State_flag_of_Iran_%281933%E2%80%931964%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/State_flag_of_Iran_%281933%E2%80%931964%29.svg/60px-State_flag_of_Iran_%281933%E2%80%931964%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Pahlavi Iran" data-file-width="1800" data-file-height="600" data-file-type="drawing" height="8" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Pahlavi_Iran" title="Pahlavi Iran" id="mwCzg">Iran</a>: 9 September 1943<sup about="#mwt1076" class="mw-ref reference" id="cite_ref-Martin_148-18" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Martin"}}'><a href="#cite_note-Martin-148" id="mwCzk"><span class="mw-reflink-text" id="mwCzo"><span class="cite-bracket" id="mwCzs">[</span>141<span class="cite-bracket" id="mwCzw">]</span></span></a></sup></li>
<li id="mwCz0"><span class="flagicon" about="#mwt1077" typeof="mw:Transclusion" id="mwCz4" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"Kingdom of Italy"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/Kingdom_of_Italy" title="Kingdom of Italy"><img resource="https://en.wikipedia.org/wiki/File:Flag_of_Italy_(1861-1946)_crowned.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Flag_of_Italy_%281861-1946%29_crowned.svg/40px-Flag_of_Italy_%281861-1946%29_crowned.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Flag_of_Italy_%281861-1946%29_crowned.svg/60px-Flag_of_Italy_%281861-1946%29_crowned.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Kingdom of Italy" data-file-width="1500" data-file-height="1000" data-file-type="drawing" height="15" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kingdom_of_the_South" title="Kingdom of the South" id="mwCz8">Italy</a>: 10 October 1943<sup about="#mwt1079" class="mw-ref reference" id="cite_ref-Martin_148-19" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Martin"}}'><a href="#cite_note-Martin-148" id="mwC0A"><span class="mw-reflink-text" id="mwC0E"><span class="cite-bracket" id="mwC0I">[</span>141<span class="cite-bracket" id="mwC0M">]</span></span></a></sup><span typeof="mw:Transclusion mw:Entity" about="#mwt1078" id="mwC0Q" data-mw='{"parts":[{"template":{"target":{"wt":"snd","href":"./Template:Snd"},"params":{},"i":0}}]}'> </span><span typeof="mw:Entity" about="#mwt1078">–</span><span typeof="mw:Entity" about="#mwt1078"> </span>former Axis power; <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Italian_Social_Republic" title="Italian Social Republic" id="mwC0U">Italian Social Republic</a> was founded in September 1943 and continued on the Axis side</li></ul>

</section><section data-mw-section-id="68" id="mwC0Y" aria-labelledby="1944"><div class="mw-heading mw-heading3"><h3 id="1944">1944</h3></div>
<!-- The following flags/countries denote formal declarations of war by independent states, not declarations by provisional governments, colonial regimes on behalf of colonies, or other non&#x2D;independent countries. -->
<ul id="mwC0c"><li id="mwC0g"><span class="flagicon" about="#mwt1080" typeof="mw:Transclusion" id="mwC0k" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"Liberia"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/Liberia" title="Liberia"><img resource="https://en.wikipedia.org/wiki/File:Flag_of_Liberia.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Flag_of_Liberia.svg/40px-Flag_of_Liberia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b8/Flag_of_Liberia.svg/60px-Flag_of_Liberia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Liberia" data-file-width="1140" data-file-height="600" data-file-type="drawing" height="12" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Liberia" title="Liberia" id="mwC0o">Liberia</a>: 27 January 1944<sup about="#mwt1081" class="mw-ref reference" id="cite_ref-Martin_148-20" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Martin"}}'><a href="#cite_note-Martin-148" id="mwC0s"><span class="mw-reflink-text" id="mwC0w"><span class="cite-bracket" id="mwC00">[</span>141<span class="cite-bracket" id="mwC04">]</span></span></a></sup></li>
