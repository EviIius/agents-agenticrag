<li id="mwCyw"><span class="flagicon" about="#mwt1071" typeof="mw:Transclusion" id="mwCy0" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"Bolivia"},"2":{"wt":"state"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/Bolivia" title="Bolivia"><img resource="https://en.wikipedia.org/wiki/File:Bandera_de_Bolivia_(Estado).svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/Bandera_de_Bolivia_%28Estado%29.svg/40px-Bandera_de_Bolivia_%28Estado%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/Bandera_de_Bolivia_%28Estado%29.svg/60px-Bandera_de_Bolivia_%28Estado%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Bolivia" data-file-width="1100" data-file-height="750" data-file-type="drawing" height="15" width="22" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/History_of_Bolivia_(1920–1964)#Prelude_to_the_National_Revolution,_1935–1952" title="History of Bolivia (1920–1964)" id="mwCy4">Bolivia</a>: 7 April 1943<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt1072" typeof="mw:Transclusion" id="mwCy8" data-mw='{"parts":[{"template":{"target":{"wt":"Citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"February 2015"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_February_2015" about="#mwt1072"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt1072" id="mwCzA"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed"><span title="This claim needs references to reliable sources. (February 2015)">citation needed</span></a></i><span typeof="mw:Entity">]</span></sup></li>
<li id="mwCzE"><span class="flagicon" about="#mwt1073" typeof="mw:Transclusion" id="mwCzI" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"Colombia"},"2":{"wt":"1861"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/Colombia" title="Colombia"><img resource="https://en.wikipedia.org/wiki/File:Flag_of_Colombia_(WFB_2013).gif" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/Flag_of_Colombia_%28WFB_2013%29.gif/40px-Flag_of_Colombia_%28WFB_2013%29.gif?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/b/b6/Flag_of_Colombia_%28WFB_2013%29.gif/60px-Flag_of_Colombia_%28WFB_2013%29.gif?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Colombia" data-file-width="500" data-file-height="334" data-file-type="bitmap" height="15" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Colombia" title="Colombia" id="mwCzM">Colombia</a>: 26 July 1943<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt1074" typeof="mw:Transclusion" id="mwCzQ" data-mw='{"parts":[{"template":{"target":{"wt":"Citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"February 2015"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_February_2015" about="#mwt1074"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt1074" id="mwCzU"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed"><span title="This claim needs references to reliable sources. (February 2015)">citation needed</span></a></i><span typeof="mw:Entity">]</span></sup