e=New+York+and+London&amp;rft.pub=W.+W.+Norton+%26+Company&amp;rft.date=1996&amp;rft.isbn=0393039250&amp;rft.aulast=Overy&amp;rft.aufirst=Richard&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt316" id="mwDjc"></span></span></li>
<li about="#cite_note-45" id="cite_note-45" data-mw-footnote-number="43"><span class="mw-cite-backlink" id="mwDjg"><a href="#cite_ref-45" rel="mw:referencedBy" id="mwDjk"><span class="mw-linkback-text" id="mwDjo">↑</span></a></span> <span id="mw-reference-text-cite_note-45" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt319" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDjs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Lane"},"first":{"wt":"Tony"},"title":{"wt":"The Oxford Companion to World War II"},"date":{"wt":"2014"},"publisher":{"wt":"Oxford University Press"},"isbn":{"wt":"9780191727603"},"editor-last":{"wt":"Dear"},"editor-first":{"wt":"I. C. B."},"chapter":{"wt":"UK"},"doi":{"wt":"10.1093/acref/9780198604464.001.0001"},"editor-last2":{"wt":"Foot"},"editor-first2":{"wt":"M. R. D."}},"i":0}}]}'/><cite id="CITEREFLane2014" class="citation book cs1" about="#mwt319">Lane, Tony (2014). "UK". In Dear, I. C. B.; Foot, M. R. D. (eds.). <i id="mwDjw">The Oxford Companion to World War II</i>. Oxford University Press. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDj0">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.1093%2Facref%2F9780198604464.001.0001" class="external text" id="mwDj4">10.1093/acref/9780198604464.001.0001</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDj8">ISBN</a><span typeof="mw:Entity" id="mwDkA"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/9780191727603" title="Special:BookSources/9780191727603" id="mwDkE"><bdi id="mwDkI">9780191727603</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=UK&amp;rft.btitle=The+Oxford+Companion+to+World+War+II&amp;rft.pub=Oxford+University+Press&amp;rft.date=2014&amp;rft_id=info%3Adoi%2F10.1093%2Facref%2F9780198604464.001.0001&amp;rft.isbn=9780191727603&amp;rft.aulast=Lane&amp;rft.aufirst=Tony&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt319" id="mwDkM"></span></span></li>
