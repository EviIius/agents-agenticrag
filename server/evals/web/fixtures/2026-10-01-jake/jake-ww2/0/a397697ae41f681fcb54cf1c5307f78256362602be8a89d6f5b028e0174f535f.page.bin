<li id="mwCqw"><span class="flagicon" about="#mwt1033" typeof="mw:Transclusion" id="mwCq0" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"Costa Rica"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/Costa_Rica" title="Costa Rica"><img resource="https://en.wikipedia.org/wiki/File:Flag_of_Costa_Rica.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Flag_of_Costa_Rica.svg/40px-Flag_of_Costa_Rica.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Flag_of_Costa_Rica.svg/60px-Flag_of_Costa_Rica.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Costa Rica" data-file-width="1000" data-file-height="600" data-file-type="drawing" height="14" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Costa_Rica" title="Costa Rica" id="mwCq4">Costa Rica</a>: 8 December 1941<sup about="#mwt1034" class="mw-ref reference" id="cite_ref-Martin_148-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Martin"}}'><a href="#cite_note-Martin-148" id="mwCq8"><span class="mw-reflink-text" id="mwCrA"><span class="cite-bracket" id="mwCrE">[</span>141<span class="cite-bracket" id="mwCrI">]</span></span></a></sup></li>
