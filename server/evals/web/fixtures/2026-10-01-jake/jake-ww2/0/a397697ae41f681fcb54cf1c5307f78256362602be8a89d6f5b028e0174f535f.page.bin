</section><section data-mw-section-id="62" id="mwCf4" aria-labelledby="Timeline_of_Allied_states_entering_the_war"><div class="mw-heading mw-heading2"><h2 id="Timeline_of_Allied_states_entering_the_war">Timeline of Allied states entering the war</h2></div>
<span class="mw-empty-elt" about="#mwt963" typeof="mw:Transclusion" id="mwCf8" data-mw='{"parts":[{"template":{"target":{"wt":"Main","href":"./Template:Main"},"params":{"1":{"wt":"Declarations of war during World War II"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt964" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt963" id="mwCgA">Main article: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Declarations_of_war_during_World_War_II" title="Declarations of war during World War II">Declarations of war during World War II</a></div>

<p id="mwCgE">The following list denotes dates on which states declared war on the Axis powers, or on which an Axis power declared war on them.</p>

<section data-mw-section-id="63" id="mwCgI" aria-labelledby="1939"><div class="mw-heading mw-heading3"><h3 id="1939">1939</h3></div>
<ul id="mwCgM"><li id="mwCgQ"><span class="flagicon" about="#mwt965" typeof="mw:Transclusion" id="mwCgU" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"Second Polish Republic"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/Second_Polish_Republic" title="Second Polish Republic"><img resource="https://en.wikipedia.org/wiki/File:Flag_of_Poland_(1928-1980).svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Flag_of_Poland_%281928%E2%80%931980%29.svg/40px-Flag_of_Poland_%281928%E2%80%931980%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Flag_of_Poland_%281928%E2%80%931980%29.svg/60px-Flag_of_Poland_%281928%E2%80%931980%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Second Polish Republic" data-file-width="1280" data-file-height="800" data-file-type="drawing" height="14" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Second_Polish_Republic" title="Second Polish Republic" id="mwCgY">Poland</a>: 1 September 1939<sup about="#mwt966" class="mw-ref reference" id="cite_ref-139" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-139"}}'><a href="#cite_note-139" id="mwCgc"><span class="mw-reflink-text" id="mwCgg"><span class="cite-bracket" id="mwCgk">[</span>132<span class="cite-bracket" id="mwCgo">]</span></span></a></sup></li>
<li id="mwCgs"><span class="flagicon" about="#mwt967" typeof="mw:Transclusion" id="mwCgw" data-mw='{"parts":[{"template":{"target":{"wt":"flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"French Third Republic"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/French_Third_Republic" title="French Third Republic"><img resource="https://en.wikipedia.org/wiki/File:Flag_of_France_(1794–1958).svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Flag_of_France.svg/40px-Flag_of_France.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Flag_of_France.svg/60px-Flag_of_France.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="French Third Republic" data-file-width="900" data-file-height="600" data-file-type="drawing" height="15" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/French_Third_Republic" title="French Third Republic" id="mwCg0">France</a>: 3 September 1939<sup about="#mwt970" class="mw-ref reference" id="cite_ref-BBCbritainfrance_140-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"BBCbritainfrance"},"body":{"id":"mw-reference-text-cite_note-BBCbritainfrance-140"}}'><a href="#cite_note-BBCbritainfrance-140" id="mwCg4"><span class="mw-reflink-text" id="mwCg8"><span class="cite-bracket" id="mwChA">[</span>133<span class="cite-bracket" id="mwChE">]</span></span></a></sup>
<ul id="mwChI"><li id="mwChM"><span class="flagicon" about="#mwt971" typeof="mw:Transclusion" id="mwChQ" data-mw='{"parts":[{"template":{"target":{"wt":"Flagicon","href":"./Template:Flagicon"},"params":{"1":{"wt":"French Equatorial Africa"}},"i":0}}]}'><span class="mw-image-border" typeof="mw:File"><a href="https://en.wikipedia.org/wiki/French_Equatorial_Africa" title="French Equatorial Africa"><img resource="https://en.wikipedia.org/wiki/File:Flag_of_France.svg" src="//thumb.wikimedia.org/wikipedia/en/thumb/c/c3/Flag_of_France.svg/40px-Flag_of_France.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/en/thumb/c/c3/Flag_of_France.svg/60px-Flag_of_France.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="French Equatorial Africa" data-file-width="900" data-file-height="600" data-file-type="drawing" height="15" width="23" class="mw-file-element"/></a></span></span> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/French_Equatorial_Africa" title="French Equatorial Africa" id="mwChU">French Equatorial Africa</a>: 27 October 1940<sup about="#mwt972" class="mw-ref reference" id="cite_ref-141" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-141"}}'><a href="#cite_note-141" id="mwChY"><span class="mw-reflink-text" id="mwChc"><span class="cite-bracket" id="mwChg">[</span>134<span class="cite-bracket" id="mwChk">]</span></span></a></sup></li>
