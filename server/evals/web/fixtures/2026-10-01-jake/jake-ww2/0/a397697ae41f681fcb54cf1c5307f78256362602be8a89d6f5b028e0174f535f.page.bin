=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=bookitem&amp;rft.atitle=SEXTANT&amp;rft.btitle=The+Oxford+Companion+to+World+War+II&amp;rft.pub=Oxford+University+Press&amp;rft.date=2014&amp;rft_id=info%3Adoi%2F10.1093%2Facref%2F9780198604464.001.0001&amp;rft.isbn=9780191727603&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt182" id="mwDZY"></span></span></li>
<li about="#cite_note-29" id="cite_note-29" data-mw-footnote-number="27"><span class="mw-cite-backlink" id="mwDZc"><a href="#cite_ref-29" rel="mw:referencedBy" id="mwDZg"><span class="mw-linkback-text" id="mwDZk">↑</span></a></span> <span id="mw-reference-text-cite_note-29" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt191" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDZo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"last":{"wt":"Taylor"},"first":{"wt":"Horace"},"date":{"wt":"January 1945"},"title":{"wt":"How Much of What Goods Have We Sent to Which Allies?"},"url":{"wt":"https://www.historians.org/about-aha-and-membership/aha-history-and-archives/gi-roundtable-series/pamphlets/em-13-how-shall-lend-lease-accounts-be-settled-(1945)/how-much-of-what-goods-have-we-sent-to-which-allies"},"access-date":{"wt":"2021-09-01"},"website":{"wt":""},"publisher":{"wt":"American Historical Association"},"pages":{"wt":"13–16"}},"i":0}}]}'/><cite id="CITEREFTaylor1945" class="citation web cs1" about="#mwt191">Taylor, Horace (January 1945). <a rel="mw:ExtLink nofollow" href="https://www.historians.org/about-aha-and-membership/aha-history-and-archives/gi-roundtable-series/pamphlets/em-13-how-shall-lend-lease-accounts-be-settled-(1945)/how-much-of-what-goods-have-we-sent-to-which-allies" class="external text" id="mwDZs">"How Much of What Goods Have We Sent to Which Allies?"</a>. American Historical Association. pp.<span typeof="mw:Entity" id="mwDZw"> </span><span class="nowrap" id="mwDZ0">13–</span>16<span class="reference-accessdate" id="mwDZ4">. Retrieved <span class="nowrap" id="mwDZ8">1 September</span> 2021</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=How+Much+of+What+Goods+Have+We+Sent+to+Which+Allies%3F&amp;rft.pages=13-16&amp;rft.pub=American+Historical+Association&amp;rft.date=1945-01&amp;rft.aulast=Taylor&amp;rft.aufirst=Horace&amp;rft_id=https%3A%2F%2Fwww.historians.org%2Fabout-aha-and-membership%2Faha-history-and-archives%2Fgi-roundtable-series%2Fpamphlets%2Fem-13-how-shall-lend-lease-accounts-be-settled-%281945%29%2Fhow-much-of-what-goods-have-we-sent-to-which-allies&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt191" id="mwDaA"></span></span></li>
<li about="#cite_note-30" id="cite_note-30" data-mw-footnote-number="28"><span class="mw-cite-backlink" id="mwDaE"><a href="#cite_ref-30" rel="mw:referencedBy" id="mwDaI"><span class="mw-linkback-text" id="mwDaM">↑</span></a></span> <span id="mw-reference-text-cite_note-30" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt194" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDaQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"Milestones: 1937–1945"},"url":{"wt":"https://history.state.gov/milestones/1937-1945/lend-lease"},"archive-url":{"wt":"https://web.archive.org/web/20250818025142/https://history.state.gov/milestones/1937-1945/lend-lease"},"archive-date":{"wt":"18 August 2025"},"access-date":{"wt":"2021-08-23"},"publisher":{"wt":"Office of the Historian, Department of State"},"location":{"wt":"United States"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt194" id="mwDaU"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250818025142/https://history.state.gov/milestones/1937-1945/lend-lease" class="external text" id="mwDaY">"Milestones: 1937–1945"</a>. United States: Office of the Historian, Department of State. Archived from <a rel="mw:ExtLink nofollow" href="https://history.state.gov/milestones/1937-1945/lend-lease" class="external text" id="mwDac">the original</a> on 18 August 2025<span class="reference-accessdate" id="mwDag">. Retrieved <span class="nowrap" id="mwDak">23 August</span> 2021</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Milestones%3A+1937%E2%80%931945&amp;rft.place=United+States&amp;rft.pub=Office+of+the+Historian%2C+Department+of+State&amp;rft_id=https%3A%2F%2Fhistory.state.gov%2Fmilestones%2F1937-1945%2Flend-lease&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt194" id="mwDao"></span></span></li>
<li about="#cite_note-31" id="cite_note-31" data-mw-footnote-number="29"><span class="mw-cite-backlink" id="mwDas"><a href="#cite_ref-31" rel="mw:referencedBy" id="mwDaw"><span class="mw-linkback-text" id="mwDa0">↑</span></a></span> <span id="mw-reference-text-cite_note-31" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt197" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDa4" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite journal ","href":"./Template:Cite_journal"},"params":{"last":{"wt":"E."},"first":{"wt":"D. P."},"date":{"wt":"1945"},"title":{"wt":"Lend-Lease and Reverse Lend-Lease Aid: Part II"},"url":{"wt":"https://www.jstor.org/stable/25643770"},"journal":{"wt":"Bulletin of International News"},"volume":{"wt":"22"},"issue":{"wt":"4"},"pages":{"wt":"157–164"},"issn":{"wt":"2044-3986"},"jstor":{"wt":"25643770"}},"i":0}}]}'/><cite id="CITEREFE.1945" class="citation journal cs1" about="#mwt197">E., D. P. (1945). <a rel="mw:ExtLink nofollow" href="https://www.jstor.org/stable/25643770" class="external text" id="mwDa8">"Lend-Lease and Reverse Lend-Lease Aid: Part II"</a>. <i id="mwDbA">Bulletin of International News</i>. <b id="mwDbE">22</b> (4): <span class="nowrap" id="mwDbI">157–</span>164. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwDbM">ISSN</a><span typeof="mw:Entity" id="mwDbQ"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/2044-3986" class="external text" id="mwDbU">2044-3986</a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/JSTOR_(identifier)" title="JSTOR (identifier)" class="mw-redirect" id="mwDbY">JSTOR</a><span typeof="mw:Entity" id="mwDbc"> </span><a rel="mw:ExtLink nofollow" href="https://www.jstor.org/stable/25643770" class="external text" id="mwDbg">25643770</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Bulletin+of+International+News&amp;rft.atitle=Lend-Lease+and+Reverse+Lend-Lease+Aid%3A+Part+II&amp;rft.volume=22&amp;rft.issue=4&amp;rft.pages=157-164&amp;rft.date=1945&amp;rft_id=https%3A%2F%2Fwww.jstor.org%2Fstable%2F25643770%23id-name%3DJSTOR&amp;rft.issn=2044-3986&amp;rft.aulast=E.&amp;rft.aufirst=D.+P.&amp;rft_id=https%3A%2F%2Fwww.jstor.org%2Fstable%2F25643770&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt197" id="mwDbk"></span></span></li>
<li about="#cite_note-ReferenceB-32" id="cite_note-ReferenceB-32" data-mw-footnote-number="30"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwDbo"><a href="#cite_ref-ReferenceB_32-0" id="mwDbs"><span class="mw-linkback-text" id="mwDbw">1</span></a> <a href="#cite_ref-ReferenceB_32-1" id="mwDb0"><span class="mw-linkback-text" id="mwDb4">2</span></a></span> <span id="mw-reference-text-cite_note-ReferenceB-32" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFKimball2014" about="#mwt200" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDb8" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Kimball"},"2":{"wt":"2014"}},"i":0}}]}'>Kimball (2014)</a>.</span></li>
<li about="#cite_note-Stoler-2004-33" id="cite_note-Stoler-2004-33" data-mw-footnote-number="31"><span class="mw-cite-backlink" id="mwDcA"><a href="#cite_ref-Stoler-2004_33-0" rel="mw:referencedBy" id="mwDcE"><span class="mw-linkback-text" id="mwDcI">↑</span></a></span> <span id="mw-reference-text-cite_note-Stoler-2004-33" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt202" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDcM" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Stoler"},"first":{"wt":"Mark A."},"url":{"wt":"https://books.google.com/books?id=gvTGDwAAQBAJ"},"title":{"wt":"Allies and Adversaries: The Joint Chiefs of Staff, the Grand Alliance, and U.S. Strategy in World War II"},"date":{"wt":"2004"},"publisher":{"wt":"UNC Press Books"},"isbn":{"wt":"978-0-8078-6230-8"},"language":{"wt":"en"},"quote":{"wt":"merging of their chiefs of staff organizations into the Combined Chiefs of Staff (CCS) to direct their combined forces and plan global strategy. ... the strategic, diplomatic, security, and civil-military views of the service chiefs and their planners were based to a large extent on events that had taken place before December 7, 1941."}},"i":0}}]}'/><cite id="CITEREFStoler2004" class="citation book cs1" about="#mwt202">Stoler, Mark A. (2004). <a rel="mw:ExtLink nofollow" href="https://books.google.com/books?id=gvTGDwAAQBAJ" class="external text" id="mwDcQ"><i id="mwDcU">Allies and Adversaries: The Joint Chiefs of Staff, the Grand Alliance, and U.S. Strategy in World War II</i></a>. UNC Press Books. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDcY">ISBN</a><span typeof="mw:Entity" id="mwDcc"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-8078-6230-8" title="Special:BookSources/978-0-8078-6230-8" id="mwDcg"><bdi id="mwDck">978-0-8078-6230-8</bdi></a>. <q id="mwDco">merging of their chiefs of staff organizations into the Combined Chiefs of Staff (CCS) to direct their combined forces and plan global strategy. ... the strategic, diplomatic, security, and civil-military views of the service chiefs and their planners were based to a large extent on events that had taken place before December 7, 1941.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=Allies+and+Adversaries%3A+The+Joint+Chiefs+of+Staff%2C+the+Grand+Alliance%2C+and+U.S.+Strategy+in+World+War+II&amp;rft.pub=UNC+Press+Books&amp;rft.date=2004&amp;rft.isbn=978-0-8078-6230-8&amp;rft.aulast=Stoler&amp;rft.aufirst=Mark+A.&amp;rft_id=https%3A%2F%2Fbooks.google.com%2Fbooks%3Fid%3DgvTGDwAAQBAJ&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt202" id="mwDcs"></span></span></li>
<li about="#cite_note-Gaddis-2000-34" id="cite_note-Gaddis-2000-34" data-mw-footnote-number="32"><span class="mw-cite-backlink" id="mwDcw"><a href="#cite_ref-Gaddis-2000_34-0" rel="mw:referencedBy" id="mwDc0"><span class="mw-linkback-text" id="mwDc4">↑</span></a></span> <span id="mw-reference-text-cite_note-Gaddis-2000-34" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt211" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDc8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Gaddis"},"first":{"wt":"John Lewis"},"year":{"wt":"2000"},"title":{"wt":"The United States and the Origins of the Cold War, 1941–1947"},"location":{"wt":"New York"},"publisher":{"wt":"Columbia University Press"},"pages":{"wt":"65"},"oclc":{"wt":"44550536"}},"i":0}}]}'/><cite id="CITEREFGaddis2000" class="citation book cs1" about="#mwt211">Gaddis, John Lewis (2000). <i id="mwDdA">The United States and the Origins of the Cold War, 1941–1947</i>. New York: Columbia University Press. p.<span typeof="mw:Entity" id="mwDdE"> </span>65. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/OCLC_(identifier)" title="OCLC (identifier)" class="mw-redirect" id="mwDdI">OCLC</a><span typeof="mw:Entity" id="mwDdM"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/oclc/44550536" class="external text" id="mwDdQ">44550536</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=The+United+States+and+the+Origins+of+the+Cold+War%2C+1941%E2%80%931947&amp;rft.place=New+York&amp;rft.pages=65&amp;rft.pub=Columbia+University+Press&amp;rft.date=2000&amp;rft_id=info%3Aoclcnum%2F44550536&amp;rft.aulast=Gaddis&amp;rft.aufirst=John+Lewis&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt211" id="mwDdU"></span></span></li>
<li about="#cite_note-35" id="cite_note-35" data-mw-footnote-number="33"><span class="mw-cite-backlink" id="mwDdY"><a href="#cite_ref-35" rel="mw:referencedBy" id="mwDdc"><span class="mw-linkback-text" id="mwDdg">↑</span></a></span> <span id="mw-reference-text-cite_note-35" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFDimbleby2022" about="#mwt237" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDdk" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Dimbleby"},"2":{"wt":"2022"},"p":{"wt":"500"}},"i":0}}]}'>Dimbleby (2022)</a><span about="#mwt237" id="mwDdo">, p.</span><span typeof="mw:Entity" about="#mwt237" id="mwDds"> </span><span about="#mwt237" id="mwDdw">500</span>.</span></li>
<li about="#cite_note-36" id="cite_note-36" data-mw-footnote-number="34"><span class="mw-cite-backlink" id="mwDd0"><a href="#cite_ref-36" rel="mw:referencedBy" id="mwDd4"><span class="mw-linkback-text" id="mwDd8">↑</span></a></span> <span id="mw-reference-text-cite_note-36" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFHoward2014" about="#mwt249" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDeA" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Howard"},"2":{"wt":"2014"},"ps":{"wt":". \"But the Warsaw rising, the apparently deliberate inactivity of the Soviet forces while the Germans crushed the insurrection, and Stalin&apos;s refusal to provide facilities for Allied air forces to drop supplies, opened the first serious rift in Allied unity and sharply diminished western enthusiasm at the prospect of the Red Army liberating eastern Europe.\""}},"i":0}}]}'>Howard (2014)</a><span about="#mwt249" id="mwDeE">. "But the Warsaw rising, the apparently deliberate inactivity of the Soviet forces while the Germans crushed the insurrection, and Stalin's refusal to provide facilities for Allied air forces to drop supplies, opened the first serious rift in Allied unity and sharply diminished western enthusiasm at the prospect of the Red Army liberating eastern Europe."</span></span></li>
<li about="#cite_note-37" id="cite_note-37" data-mw-footnote-number="35"><span class="mw-cite-backlink" id="mwDeI"><a href="#cite_ref-37" rel="mw:referencedBy" id="mwDeM"><span class="mw-linkback-text" id="mwDeQ">↑</span></a></span> <span id="mw-reference-text-cite_note-37" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFHoward2014" about="#mwt255" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDeU" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Howard"},"2":{"wt":"2014"},"ps":{"wt":". \"Indeed Roosevelt did not see the British as his principal allies in the Far East at all. That role was played by China under General Chiang Kai-shek with whom the USA had a close ‘special relationship’. … For Washington the initial objective was therefore to rescue China; partly as an obligation of honour … but also because at this stage of the war, it was generally accepted that air, naval, and military bases in China would be needed for mounting an invasion of Japan and so securing her defeat.\""}},"i":0}}]}'>Howard (2014)</a><span about="#mwt255" id="mwDeY">. "Indeed Roosevelt did not see the British as his principal allies in the Far East at all. That role was played by China under General Chiang Kai-shek with whom the USA had a close ‘special relationship’. … For Washington the initial objective was therefore to rescue China; partly as an obligation of honour … but also because at this stage of the war, it was generally accepted that air, naval, and military bases in China would be needed for mounting an invasion of Japan and so securing her defeat."</span></span></li>
<li about="#cite_note-38" id="cite_note-38" data-mw-footnote-number="36"><span class="mw-cite-backlink" id="mwDec"><a href="#cite_ref-38" rel="mw:referencedBy" id="mwDeg"><span class="mw-linkback-text" id="mwDek">↑</span></a></span> <span id="mw-reference-text-cite_note-38" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFVan_Slyke2014" about="#mwt268" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDeo" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Van Slyke"},"2":{"wt":"2014"},"ps":{"wt":". \"Stilwell had another point to make. He believed that nationalist Chinese troops—considered worthless by the Japanese, by most of the Allies, and even within China—could be the equal of the finest soldiers in the world, if they were properly fed, trained, supplied, and officered.\""}},"i":0}}]}'>Van Slyke (2014)</a><span about="#mwt268" id="mwDes">. "Stilwell had another point to make. He believed that nationalist Chinese troops—considered worthless by the Japanese, by most of the Allies, and even within China—could be the equal of the finest soldiers in the world, if they were properly fed, trained, supplied, and officered."</span></span></li>
<li about="#cite_note-39" id="cite_note-39" data-mw-footnote-number="37"><span class="mw-cite-backlink" id="mwDew"><a href="#cite_ref-39" rel="mw:referencedBy" id="mwDe0"><span class="mw-linkback-text" id="mwDe4">↑</span></a></span> <span id="mw-reference-text-cite_note-39" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="#CITEREFVan_Slyke2014" about="#mwt271" typeof="mw:Transclusion" class="mw-selflink-fragment" id="mwDe8" data-mw='{"parts":[{"template":{"target":{"wt":"Harvard citation year brackets","href":"./Template:Harvard_citation_year_brackets"},"params":{"1":{"wt":"Van Slyke"},"2":{"wt":"2014"},"ps":{"wt":". \"The trans-Pacific island-hopping strategy became more and more apparently the means for defeating Japan from the air and eventually, it was presumed, through amphibious warfare landings. This approach rendered China a sideshow, important mainly for tying down about one million Japanese troops and preventing their deployment elsewhere.\""}},"i":0}}]}'>Van Slyke (2014)</a><span about="#mwt271" id="mwDfA">. "The trans-Pacific island-hopping strategy became more and more apparently the means for defeating Japan from the air and eventually, it was presumed, through amphibious warfare landings. This approach rendered China a sideshow, important mainly for tying down about one million Japanese troops and preventing their deployment elsewhere."</span></span></li>
<li about="#cite_note-40" id="cite_note-40" data-mw-footnote-number="38"><span class="mw-cite-backlink" id="mwDfE"><a href="#cite_ref-40" rel="mw:referencedBy" id="mwDfI"><span class="mw-linkback-text" id="mwDfM">↑</span></a></span> <span id="mw-reference-text-cite_note-40" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt279" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDfQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Jackson"},"first":{"wt":"Ashley"},"title":{"wt":"The British Empire and the Second World War"},"publisher":{"wt":"Hambledon Contiuum"},"year":{"wt":"2006"},"isbn":{"wt":"1852854170"},"location":{"wt":"London and New York"}},"i":0}}]}'/><cite id="CITEREFJackson2006" class="citation book cs1" about="#mwt279">Jackson, Ashley (2006). <i id="mwDfU">The British Empire and the Second World War</i>. London and New York: Hambledon Contiuum. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDfY">ISBN</a><span typeof="mw:Entity" id="mwDfc"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/1852854170" title="Special:BookSources/1852854170" id="mwDfg"><bdi id="mwDfk">1852854170</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=The+British+Empire+and+the+Second+World+War&amp;rft.place=London+and+New+York&amp;rft.pub=Hambledon+Contiuum&amp;rft.date=2006&amp;rft.isbn=1852854170&amp;rft.aulast=Jackson&amp;rft.aufirst=Ashley&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt279" id="mwDfo"></span></span></li>
<li about="#cite_note-Jackson_2006-41" id="cite_note-Jackson_2006-41" data-mw-footnote-number="39"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwDfs"><a href="#cite_ref-Jackson_2006_41-0" id="mwDfw"><span class="mw-linkback-text" id="mwDf0">1</span></a> <a href="#cite_ref-Jackson_2006_41-1" id="mwDf4"><span class="mw-linkback-text" id="mwDf8">2</span></a> <a href="#cite_ref-Jackson_2006_41-2" id="mwDgA"><span class="mw-linkback-text" id="mwDgE">3</span></a> <a href="#cite_ref-Jackson_2006_41-3" id="mwDgI"><span class="mw-linkback-text" id="mwDgM">4</span></a> <a href="#cite_ref-Jackson_2006_41-4" id="mwDgQ"><span class="mw-linkback-text" id="mwDgU">5</span></a></span> <span id="mw-reference-text-cite_note-Jackson_2006-41" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt287" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDgY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite book ","href":"./Template:Cite_book"},"params":{"last":{"wt":"Jackson"},"first":{"wt":"Ashley"},"title":{"wt":"The British Empire and the Second World War"},"publisher":{"wt":"Hambledon Contiuum"},"year":{"wt":"2006"},"isbn":{"wt":"1852854170"},"location":{"wt":"London and New York"}},"i":0}}]}'/><cite id="mwDgc" class="citation book cs1" about="#mwt287" data-x-id="CITEREFJackson2006">Jackson, Ashley (2006). <i id="mwDgg">The British Empire and the Second World War</i>. London and New York: Hambledon Contiuum. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwDgk">ISBN</a><span typeof="mw:Entity" id="mwDgo"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/1852854170" title="Special:BookSources/1852854170" id="mwDgs"><bdi id="mwDgw">1852854170</bdi></a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=The+British+Empire+and+the+Second+World+War&amp;rft.place=London+and+New+York&amp;rft.pub=Hambledon+Contiuum&amp;rft.date=2006&amp;rft.isbn=1852854170&amp;rft.aulast=Jackson&amp;rft.aufirst=Ashley&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAllies+of+World+War+II" class="Z3988" about="#mwt287" id="mwDg0"></span></span></li>
<li about="#cite_note-Cave_2024-42" id="cite_note-Cave_2024-42" data-mw-footnote-number="40"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwDg4"><a href="#cite_ref-Cave_2024_42-0" id="mwDg8"><span class="mw-linkback-text" id="mwDhA">1</span></a> <a href="#cite_ref-Cave_2024_42-1" id="mwDhE"><span class="mw-linkback-text" id="mwDhI">2</span></a></span> <span id="mw-reference-text-cite_note-Cave_2024-42" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt290" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwDhM" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite thesis ","href":"./Template:Cite_thesis"},"params":{"last":{"wt":"Cave"},"first":{"wt":"David"},"title":{"wt":"Honoured Partners: The British relationship with Governments-in-exile During the Second World War"},"date":{"wt":"2024"},"access-date":{"wt":"30 May 2025"},"degree":{"wt":"PhD"},"publisher":{"wt":"University of New South Wales"},"url":{"wt":"https://unsworks.unsw.edu.au/entities/publication/91ab89a8-f382-42a8-ae4e-ba3e51ed3bb5"},"doi":{"wt":"10.26190/unsworks/25494"}},"i":0}}]}'/><cite id="mwDhQ" class="citation thesis cs1" about="#mwt290" data-x-id="CITEREFCave2024">Cave, David (2024). <a rel="mw:ExtLink nofollow" href="https://unsworks.unsw.edu.au/entities/publication/91ab89a8-f382-42a8-ae4e-ba3e51ed3bb5" class="external text" id="mwDhU"><i id="mwDhY">Honoured Partners: The British relationship with Governments-in-exile During the Second World War</i></a> (PhD thesis). University of New South Wales. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwDhc">doi</a>:<a rel="mw:ExtLink nofollow" href="https://doi.org/10.26190%2Funsworks%2F25494" class="external text" id="mwDhg">10.26190/unsworks/25494</a><span class="reference-acces