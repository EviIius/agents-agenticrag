			<style id="hc-explore-css">.hc-explore{position:relative;margin:1.2em 0 3.4em;padding:20px 24px;border-radius:3px;font-family:inherit;box-sizing:border-box}.hc-explore *{box-sizing:border-box}.hc-explore+h2,.hc-explore+h3,.hc-explore+p{margin-top:2.8em}.hc-explore__kick{margin:0 0 8px;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;line-height:1.3}.hc-explore__line{margin:0;font-size:17px;line-height:1.6;text-align:left}.hc-explore__btns{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px;align-items:stretch}.hc-explore__btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:11px 18px;font-size:14.5px;font-weight:700;line-height:1.2;letter-spacing:.01em;border-radius:3px;border:2px solid transparent;text-decoration:none!important;white-space:nowrap;transition:filter .15s ease,background .15s ease}.hc-explore__btn:hover,.hc-explore__btn:focus{filter:brightness(.93);text-decoration:none!important}.hc-explore__btn--fill{background:var(--hcx-c);border-color:var(--hcx-c);color:var(--hcx-on)!important}.hc-explore__btn--timeline{--hcx-c:#1080C0;--hcx-on:#fff}.hc-explore__btn--quiz{--hcx-c:#F9C000;--hcx-on:#141414}.hc-explore__btn--map{--hcx-c:#0F6E56;--hcx-on:#fff}.hc-explore__btn--game{--hcx-c:#534AB7;--hcx-on:#fff}.hc-explore__btn--teaching{--hcx-c:#B45309;--hcx-on:#fff}.hc-explore__btn--infographic{--hcx-c:#993556;--hcx-on:#fff}.hc-explore__btn--video{--hcx-c:#A32D2D;--hcx-on:#fff}.hc-explore__btn--line{background:#fff;border-width:1px}.hc-explore__t{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}.hc-explore__more{display:none;align-items:center;justify-content:center;gap:8px;width:100%;padding:10px;font-size:14px;font-weight:700;border-radius:3px;cursor:pointer;background:transparent;user-select:none}.hc-explore__m2{display:none}.hc-explore__chev{width:8px;height:8px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg) translateY(-2px);transition:transform .15s ease}.hc-explore__t:checked~.hc-explore__more .hc-explore__m1{display:none}.hc-explore__t:checked~.hc-explore__more .hc-explore__m2{display:inline}.hc-explore__t:checked~.hc-explore__more .hc-explore__chev{transform:rotate(-135deg) translateY(-2px)}.hc-explore__t:focus-visible~.hc-explore__more{outline:2px solid #1080C0;outline-offset:2px}@media (max-width:1023px){.hc-explore__more{display:flex}.hc-explore__btn--line{display:none}.hc-explore__t:checked~.hc-explore__btn--line{display:inline-flex}}@media (max-width:640px){.hc-explore{padding:18px}.hc-explore__line{font-size:16.5px}.hc-explore__btns{flex-direction:column}.hc-explore__btn{width:100%;white-space:normal;text-align:center}}.hc-explore--s1{background:#f4f9fd;border:1px solid #cfe3f1;border-left:4px solid #1080C0}.hc-explore--s1 .hc-explore__kick{color:#0a5c88}.hc-explore--s1 .hc-explore__line{color:#1f2933}.hc-explore--s1 .hc-explore__btn--line{color:#0a5c88!important;border-color:#9cc8e6}.hc-explore--s1 .hc-explore__more{color:#0a5c88;border:1px dashed #9cc8e6}.hc-explore--s2{background:#fff;border:1px solid #1a1a1a;padding:0}.hc-explore--s2 .hc-explore__kick{margin:0;padding:11px 20px;background:#141414;color:#fff;font-size:16px;letter-spacing:.06em}.hc-explore--s2 .hc-explore__b{color:#F9C000}.hc-explore--s2 .hc-explore__body{padding:16px 20px 20px}.hc-explore--s2 .hc-explore__line{color:#1a1a1a}.hc-explore--s2 .hc-explore__btn--timeline{--hcx-c:#141414}.hc-explore--s2 .hc-explore__btn--line{color:#141414!important;border-color:#141414}.hc-explore--s2 .hc-explore__more{color:#141414;border:1px dashed #141414}.hc-explore--s3{background:#f8fafc;border:1px solid #d9d9d9;border-radius:8px;overflow:hidden;padding:0}.hc-explore__rng{color:#1a1a1a;font-weight:700}.hc-explore--s2 .hc-explore__rng,.hc-explore--s3 .hc-explore__rng{color:#fff}.hc-explore--s3 .hc-explore__b{order:1}.hc-explore--s3 .hc-explore__a{order:2}.hc-explore--s3 .hc-explore__rng{order:3}.hc-explore--s3 .hc-explore__kick{displa