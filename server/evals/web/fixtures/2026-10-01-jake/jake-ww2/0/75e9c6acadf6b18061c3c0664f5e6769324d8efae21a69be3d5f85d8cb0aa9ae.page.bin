<style type="text/css">
.right_info{ 
width: 100%;
color: #111;
text-align: center;
font-size: 15px;	
}	

/* New Form Search Design css */
.mapSearchrow {font-family:"Open Sans", sans-serif;display:flex;width:100%;justify-content:center;float:left;position:relative;height:70px;}
.mapSearchrow .mapInputrow .algolia-places input[type="text"] {padding:0 1.5%;font-size:16px;height:66px;}
.mapSearchrow .mapInputrow .ap-input-icon {height:66px;}
.mapInputrow {float:left;height:70px;border:2px solid #28b682;}
.mapInputrow input {width:100%;height:100%;padding-left:26px;padding-top:4px;border:none;font-size:18px;font-weight:400;white-space:nowrap;}
.mapInputrow input::-webkit-input-placeholder {color:#303133!important;}
.mapInputrow input:-moz-placeholder {color:#303133!important;}
.mapInputrow input::-moz-placeholder {color:#303133!important;}
.mapInputrow input:-ms-input-placeholder {color: #303133!important}
.btnSearch{clear:both;}
.mapButtonrow {color:#fff;height:70px;border:none;background:#0eb683;padding:25px 27px;font-size:16px;font-weight:700;text-transform:uppercase;white-space:nowrap;border-radius:0;border:2px solid #28b682;border-left:0;width:auto;}
@media (min-width:992px) {
    .mapSearchrow {position:relative;margin-top:40px;}
    .mapInputrow{width:440px;}
.full-width .pop, .full-width.heading_wrapper  {
    margin-top: 32px;
}
#header {
    position: fixed;
}
.colorgraph{    position: fixed;
    width: 100%;
    z-index: 999;}
}
.header-ad {
	background: #ffffff;
	padding: 1px;
}
@media (min-width:769px) and (max-width:991px) {
    .mapSearchrow {margin-top:50px;}
    .mapInputrow {width:60%;}
    .mapInputrow input {padding-left:28px;padding-top:7px;}
    .mapButtonrow{padding:26px 31px;}
}
@media (max-width:767px) {
    .mapSearchrow {display:block;}
    .mapSearchrow span.mapInputrow {width:100%;display:flex;height:53px;}
    .mapSearchrow .mapInputrow .algolia-places input[type="text"] {padding:0 1.5%;font-size:16px;height:49px;}
    .btnSearch {display:flex;justify-content:center;margin-top:15px;float:left;width:100%;}
    .mapButtonrow{width:50%;display:flex;padding:15px 120px;height:50px;justify-content:center;box-shadow:0 6px #0f885c;letter-spacing:1px;outline:none;border-radius:40px;}
    .mapButtonrow:after {content: '';position:absolute;z-index:-1;-webkit-transition:all 0.3s;-moz-transition:all 0.3s;transition:all 0.3s;}
    .mapButtonrow:hover {box-shadow:0 4px #0f885c;top:2px;}
}
/* New form Search design css End*/
</style>

