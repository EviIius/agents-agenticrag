background: #222222 !important;
}
.ui-tabs-nav li.ui-state-active a{
color: #fff !important;
}
#uitabs .ui-tabs-panel {
    display: block;
    border-width: 0;
    padding: 1em 1.4em;
    background: none;
}
#uitabs ul.ui-tabs-nav li{
	list-style: none;
    float: left;
    position: relative;
    top: 0;
    margin: 1px .2em 0 0;
    border-bottom-width: 0;
    padding: 0;
    white-space: nowrap;
    background: #9FC9E0;
}
#uitabs ul.ui-tabs-nav li a{
	float: left;
    text-decoration: none;
    padding: 0px 9px;
    font-size: 11px;
    font-family: monospace;
}
#uitabs .ajp-list li{
    overflow: hidden;
    float: none;
    clear: both;
    padding: 0px 0;
    margin: 0;
    border-bottom: #B7D7E6 1px solid;
    line-height: 1.62em;
    background:none;
}

#uitabs .ajp-list li img {
    /*display: block;
    width: 100%;*/
    display: inline;
    float: left;
    margin: 0 5px 0 0;
    border: none;
    width:75px;
    height:75px;
}
#uitabs .ajp-list li a {
	color: #000;
    padding: 7px 0;
    font-size: 14px;
    display: block;
    -webkit-transition-property: background-color,padding;
    -webkit-transition-duration: 0.5s;
    transition-property: background-color,padding;
    transition-duration: 0.5s;
} 
#uitabs .ajp-list li a:hover{background:none;}
