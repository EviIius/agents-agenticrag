<global-header></global-header><style>
  :root {
    --admin-bar: 0px;
  }
  body.admin-bar {
    --admin-bar: 32px;
  }
  #mow_topad {
    box-sizing: border-box;
    display: block;
    background: #EAEAEA !important;
    width:100%;
    overflow: hidden;
    position: sticky;
    top: 0;
    z-index: 99;
  } 
  .mow-adbox {
    text-align: center;
  }
  .mow-adbox.desktop {
    display: none;
  }
  .mow-adbox > div{
    position: relative;
    top: 8px;
  }  
  @media(min-width:768px) {
    #mow_topadNON {
      position: fixed;
      top: var(--admin-bar);
      z-index: 110;
    }
    .mow-adbox.mobile {
      display: none;
    }
    .mow-adbox.desktop {
      display: block;
    }
  }
</style>
