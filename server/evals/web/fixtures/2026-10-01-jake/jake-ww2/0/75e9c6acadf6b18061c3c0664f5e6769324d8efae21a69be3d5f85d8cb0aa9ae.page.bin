	<script>window.headerStyles = `h1,h2,h3,h4,p{text-wrap:balance}:host{all:unset;font-size:16px}html{font-size:16px !important}*,*::before,*::after{box-sizing:border-box}header{font-family:"Inter",Helvetica,Arial,sans-serif;--accent: #34CE83;--accent-a11y: #1F8552;--light: #F4F7FD;--rule: #DCDEEE;--white: #FFFFFF;--accent-alt: #F4C70C;--black: #071C35;--grey: #576780;--overlay: rgba(0, 0, 0, 0.65);--burger: 1.5em;--container-width: 90em;--mobile-width: 40em;--footer-spacing: 2em;position:relative;z-index:100;background:var(--white);border-bottom:1px solid var(--rule);overflow-x:clip}.c-header.js-overlay::before{opacity:1;visibility:visible}.c-header::before{content:"";position:fixed;top:0;left:0;right:0;bottom:0;background:var(--overlay);opacity:0;visibility:hidden;transition:opacity .3s ease-in-out,visibility .3s ease-in-out}.c-bar{padding:.75em 1.5em;position:relative;z-index:10;background-color:var(--white)}.c-bar__grey{color:var(--white);background-color:#4a5260}.c-container{max-width:var(--container-width);margin-left:auto;margin-right:auto}.c-functional-bar{display:flex;justify-content:center}.c-hamburger{display:inline-block;width:var(--burger);height:var(--burger);position:relative}.c-hamburger .bar{display:block;position:absolute;left:0;right:0;top:50%;width:var(--burger);height:.125em;background:currentColor;transform:rotate(0) translateY(-0.0625em);transition:position .3s ease,transform .3s ease,opacity .3s ease}.c-hamburger .bar-1{top:.125em;transform:rotate(0) translateY(0)}.c-hamburger .bar-3{top:calc(100% - .125em);transform:rotate(0) translateY(-0.125em)}button.js-active .c-hamburger .bar-1{top:50%;transform:translateY(0) rotate(45deg)}button.js-active .c-hamburger .bar-2{left:50%;right:50%;opacity:0;width:0}button.js-active .c-hamburger .bar-3{top:50%;transform:translateY(0) rotate(-45deg)}.c-nav{list-style-type:none;padding:0;display:flex;justify-content:flex-end;align-items:center;column-gap:1.5em}.c-mobile-nav{position:absolute;top:100%;left:0;right:0;background:var(--white);padding:1px;transform:translateX(100%);transition:transform .5s ease-in-out}.c-mobile-nav.js-active{transform:translateX(0)}.c-mobile-list{padding:0;margin:0;list-style-type:none;margin-bottom:4.5em}.c-mobile-subnav-details{background:var(--rule);padding:1.5em}.c-nav-bar{display:flex;justify-content:space-between;align-items:center;column-gap:2em}.c-nav-btn{appearance:none;background:none;border:none;font-family:"Inter",serif;font-size:16px;font-style:normal;font-weight:500;line-height:142%;letter-spacing:-0.16px;display:flex;align-items:center;column-gap:.5em;white-space:nowrap}.c-nav-btn:hover,.c-nav-btn:focus,.c-nav-btn.js-active{color:var(--accent-a11y)}.c-nav-btn.js-active .chevron::after{transform:scale(0.65) rotate(225deg);top:25%}.c-more-btn{appearance:none;background:none;border:none;font-family:"Inter",serif;font-size:16px;font-style:normal;font-weight:500;line-height:142%;letter-spacing:-0.16px;display:flex;align-items:center;column-gap:.75em;white-space:nowrap;color:currentColor;cursor:pointer}.c-more-btn:hover,.c-more-btn:focus,.c-more-btn.js-active{color:var(--accent-a11y)}.c-mobile-nav-btn,.c-mobile-nav-link,.c-btn-back{appearance:none;background:none;cursor:pointer;border:none;font-family:"Inter",serif;font-size:16px;font-style:normal;font-weight:500;line-height:142%;letter-spacing:-0.16px;display:flex;align-items:center;justify-content:space-between;padding:1.5em 1.5em;width:100%;align-items:center;column-gap:.5em;white-space:nowrap;border-bottom:1px solid var(--rule);color:currentColor;transition:color .3s ease-in-out}.c-mobile-nav-btn .chevron,.c-mobile-nav-link .chevron,.c-btn-back .chevron{position:relative;top:.25em}.c-mobile-nav-btn:hover,.c-mobile-nav-btn:focus,.c-mobile-nav-link:hover,.c-mobile-nav-link:focus{color:var(--accent-a11y);background:#f8f8f8}.c-mobile-nav-link{color:var(--black);text-decoration:none}.c-btn-back{background:var(--accent);transition:color .3s ease-in-out,background-color .3s ease-in-out}.c-btn-back span:not(.chevron){flex:1;text-align:center}.c-btn-back:hover,.c-btn-back:focus{color:var(--white);background:var(--accent-a11y)}.chevron{display:inline-block;width:1em;height:1em;position:relative;flex-shrink:0}.chevron::after{content:"";position:absolute;top:0;left:12.5%;width:10px;height:10px;display:block;border-bottom:2px solid currentColor;border-right:2px solid currentColor;transform-origin:center;transform:scale(65%) rotate(45deg);transition:transform .3s ease-in-out,top .3s ease-in-out}.chevron.chevron-right::after{transform:scale(65%) rotate(-45deg)}.chevron.chevron-left::after{transform:scale(65%) rotate(135deg)}.c-subnav{white-space:wrap;position:absolute;top:100%;left:0;background:var(--white);border:1px solid var(--rule);padding:3em 1.5em;margin-top:3em;width:100vw;max-width:28em;column-gap:2.5em;grid-template-columns:1fr 1fr;border-radius:.5em;color:var(--black);display:none;text-align:left}.c-subnav.js-transition{display:grid;opacity:0;visibility:hidden;transition:opacity .3s ease-in-out,visibility .3s ease-in-out}.c-subnav.js-active{opacity:1;visibility:visible}.c-subnav h2,.c-mobile-subnav h2{font-weight:500;font-size:1.3125em;margin-top:0}.c-subnav ul,.c-mobile-subnav ul{list-style-type:none;padding-left:1em;display:flex;flex-direction:column;row-gap:.75em}.c-subnav ul.c-more-list,.c-mobile-subnav ul.c-more-list{padding-left:0;margin-top:2.5em}.c-mobile-subnav ul{padding-left:0;row-gap:0}.c-subnav-more{max-width:48em;grid-template-columns:1fr 1fr 1fr}.c-mobile-subnav{display:none;position:absolute;z-index:10;top:0;left:0;right:0;background:var(--white);min-height:100%;transform:translateX(100%);transition:transform .5s ease-in-out}.c-mobile-subnav.js-transition{display:block}.c-mobile-subnav.js-active{transform:translateX(0)}.c-nav-link{display:flex;width:full;justify-content:space-between;column-gap:.5em;align-items:flex-start;color:currentColor;text-decoration:none;font-size:.9375em;transition:color .3s ease-in-out}.c-nav-link .chevron{position:relative;top:.325em}.c-nav-link:hover,.c-nav-link:focus,.c-nav-link.js-active{color:var(--accent-a11y)}.c-description{color:#576780;font-size:.9375em;font-weight:500;line-height:142%;letter-spacing:-0.15px;margin:1.25em 0}.c-nav-btn{position:relative}.c-nav-item{position:relative;cursor:pointer;color:currentColor;transition:color .3s ease-in-out}.c-nav-item:hover,.c-nav-item:focus{color:var(--accent-a11y)}.visuallyhidden{position:absolute !important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border:0}.c-btn{display:inline-block;color:currentColor;text-decoration:none;position:relative;padding-bottom:.25em}.c-btn::after{content:"";display:block;position:absolute;bottom:-0.125em;left:0;right:0;background-color:var(--accent);height:.125em;transition:background-color .3s ease-in-out,transform .3s ease-in-out;transform:scale(1)}.c-btn:hover::after,.c-btn:focus::after{background-color:var(--black);transform:scale(1.075)}.c-btn-alt:hover::after,.c-btn-alt:focus::after{background-color:var(--accent-alt)}.c-btn-full{display:inline-block;color:currentColor;text-decoration:none;padding:.9375em 1.5em;text-align:center;border-radius:.4375em;border:2px solid var(--accent);transition:border-color .3s ease-in-out}.c-btn-full:hover,.c-btn-full:focus{border-color:var(--black)}.chevron{display:inline-block;width:1em;height:1em;position:relative;flex-shrink:0}.chevron::after{content:"";position:absolute;top:0;left:12.5%;width:10px;height:10px;display:block;border-bottom:2px solid currentColor;border-right:2px solid currentColor;transform-origin:center;transform:scale(65%) rotate(45deg);transition:transform .3s ease-in-out,top .3s ease-in-out}.chevron.chevron-right::after{transform:scale(65%) rotate(-45deg)}.chevron.chevron-left::after{transform:scale(65%) rotate(135deg)}
`; window.threshold = 816;</script><script src="/_nav/dist/main.min.js"></script><template id="desktop-header">
