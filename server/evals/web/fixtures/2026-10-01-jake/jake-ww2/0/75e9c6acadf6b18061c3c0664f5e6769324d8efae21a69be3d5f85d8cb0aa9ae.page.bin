<script>
jQuery(document).ready(function($) {

jQuery(".share-wrp").click(function(){
jQuery(".newsocial").slideToggle();
});
if(jQuery(window).width() < 768 ){
jQuery('.link-heading').append('<span class="aco-icon"></span>');
	jQuery('.link-heading').click(function(){
     jQuery(this).parents().find('.link-list').slideUp(200);
	 if(jQuery(this).parent().find('.link-list').is(':visible')){
	 jQuery(this).parent().find('.aco-icon').css('background','url("https://www.mapsofworld.com/images2016/icons/home/plus.png") center no-repeat');
	 jQuery(this).parent().find('.link-list').slideUp(200);
	}
	else{
	 jQuery(this).parent().find('.link-list').slideDown(200);
	 jQuery('html, body').animate({scrollTop: jQuery(this).offset().top - 150}, 500);
	 jQuery('.aco-icon').css('background','url("https://www.mapsofworld.com/images2016/icons/home/plus.png") center no-repeat');
	 jQuery(this).parent().find('.aco-icon').css('background','url("https://www.mapsofworld.com/images2016/icons/home/minus.png") center no-repeat');
	}
	});
}
});

</script>
<script>
if($(window).width() > 770) {
$(function() {
	var nav_offset_top = $('#header').offset().top;
			 var moi_nav = function(){
		var scroll_top = $(window).scrollTop(); 
		if (scroll_top > nav_offset_top) { 
			$('#header').css({ 'position': 'fixed', 'top':'0', 'left':'0', 'width':'100%' });
            $('#header').addClass('fixed-header');
			} else {
			$('#header').css({ 'position': 'relative', 'left':'0' }); 
	        $('#header').removeClass('fixed-header');
		}   
	};
	moi_nav();
	$(window).scroll(function() {
		 moi_nav();
	});
	});
}


var id = '#dialog';
//transition effect
$(id).fadeIn(200);  
//if close button is clicked
  setTimeout(function () {
  alert('close');
jQuery('.window .close').click(function (e) {
//Cancel the link behavior

e.preventDefault();
jQuery('#mask').hide();
jQuery('.window').hide();
});
   }, 2500);
//if mask is clicked
jQuery('#mask').click(function () {
jQuery(this).hide();
jQuery('.window').hide();
});

var poppy = sessionStorage.getItem('dialog');
if(!poppy){
var myVar;
function myFunction() {
myVar = setTimeout(function(){ document.getElementById("dialog").style.display = "block" }, 1000);
}
myFunction()
sessionStorage.setItem('dialog','true');
}
else{
document.getElementById("dialog").style.display = "none";
}
</script>
