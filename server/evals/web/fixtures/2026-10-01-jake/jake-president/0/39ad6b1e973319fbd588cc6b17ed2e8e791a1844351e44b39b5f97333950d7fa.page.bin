<li about="#cite_note-699" id="cite_note-699" data-mw-footnote-number="697"><span class="mw-cite-backlink" id="mwMBs"><a href="#cite_ref-699" rel="mw:referencedBy" id="mwMBw"><span class="mw-linkback-text" id="mwMB0">↑</span></a></span> <span id="mw-reference-text-cite_note-699" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2592" typeof="mw:Extension/templatestyles" id="mwMB4" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="mwMB8" class="citation news cs1" data-x-id="CITEREFSavage2025"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Charlie_Savage_(author)" title="Charlie Savage (author)" class="mw-redirect" id="mwMCA">Savage, Charlie</a> (February 5, 2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwMCE"><a rel="mw:ExtLink nofollow" href="https://www.nytimes.com/2025/02/05/us/trump-federal-law-power.html" class="external text" id="mwMCI">"Trump Brazenly Defies Laws in Escalating Executive Power Grab"</a></span>. <i id="mwMCM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_New_York_Times" title="The New York Times" id="mwMCQ">The New York Times</a></i><span class="reference-accessdate" id="mwMCU">. Retrieved <span class="nowrap" id="mwMCY">February 5,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+New+York+Times&amp;rft.atitle=Trump+Brazenly+Defies+Laws+in+Escalating+Executive+Power+Grab&amp;rft.date=2025-02-05&amp;rft.aulast=Savage&amp;rft.aufirst=Charlie&amp;rft_id=https%3A%2F%2Fwww.nytimes.com%2F2025%2F02%2F05%2Fus%2Ftrump-federal-law-power.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwMCc"></span></span></li>
<li about="#cite_note-700" id="cite_note-700" data-mw-footnote-number="698"><span class="mw-cite-backlink" id="mwMCg"><a href="#cite_ref-700" rel="mw:referencedBy" id="mwMCk"><span class="mw-linkback-text" id="mwMCo">↑</span></a></span> <span id="mw-reference-text-cite_note-700" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2597" typeof="mw:Extension/templatestyles" id="mwMCs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFRein2025" class="citation news cs1">Rein, Lisa (January 29, 2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwMCw"><a rel="mw:ExtLink nofollow" href="https://www.washingtonpost.com/politics/2025/01/29/trump-federal-government-laws-schedule-f/" class="external text" id="mwMC0">"How Trump is stretching laws to make the federal government more political"</a></span>. <i id="mwMC4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/The_Washington_Post" title="The Washington Post" id="mwMC8">The Washington Post</a></i><span class="reference-accessdate" id="mwMDA">. Retrieved <span class="nowrap" id="mwMDE">February 4,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+Washington+Post&amp;rft.atitle=How+Trump+is+stretching+laws+to+make+the+federal+government+more+political&amp;rft.date=2025-01-29&amp;rft.aulast=Rein&amp;rft.aufirst=Lisa&amp;rft_id=https%3A%2F%2Fwww.washingtonpost.com%2Fpolitics%2F2025%2F01%2F29%2Ftrump-federal-government-laws-schedule-f%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwMDI"></span></span></li>
<li about="#cite_note-701" id="cite_note-701" data-mw-footnote-number="699"><span class="mw-cite-backlink" id="mwMDM"><a href="#cite_ref-701" rel="mw:referencedBy" id="mwMDQ"><span class="mw-linkback-text" id="mwMDU">↑</span></a></span> <span id="mw-reference-text-cite_note-701" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2602" typeof="mw:Extension/templatestyles" id="mwMDY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFPereira2025" class="citation news cs1">Pereira, Ivan (January 28, 2025). <a rel="mw:ExtLink nofollow" href="https://abcnews.go.com/Politics/trump-funding-freeze-blatant-violation-constitution-federal-law/story?id=118183957" class="external text" id="mwMDc">"Trump funding freeze a blatant violation of Constitution, federal law: Legal experts"</a>. <i id="mwMDg"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ABC_News_(United_States)" title="ABC News (United States)" id="mwMDk">ABC News</a></i><span class="reference-accessdate" id="mwMDo">. Retrieved <span class="nowrap" id="mwMDs">February 4,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=ABC+News&amp;rft.atitle=Trump+funding+freeze+a+blatant+violation+of+Constitution%2C+federal+law%3A+Legal+experts&amp;rft.date=2025-01-28&amp;rft.aulast=Pereira&amp;rft.aufirst=Ivan&amp;rft_id=https%3A%2F%2Fabcnews.go.com%2FPolitics%2Ftrump-funding-freeze-blatant-violation-constitution-federal-law%2Fstory%3Fid%3D118183957&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwMDw"></span></span></li>
<li about="#cite_note-702" id="cite_note-702" data-mw-footnote-number="700"><span class="mw-cite-backlink" id="mwMD0"><a href="#cite_ref-702" rel="mw:referencedBy" id="mwMD4"><span class="mw-linkback-text" id="mwMD8">↑</span></a></span> <span id="mw-reference-text-cite_note-702" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2607" typeof="mw:Extension/templatestyles" id="mwMEA" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="mwMEE" class="citation news cs1" data-x-id="CITEREFTouchberry2025">Touchberry, Ramsay (August 9, 2025). <a rel="mw:ExtLink nofollow" href="https://www.washingtonexaminer.com/news/senate/3495365/trump-spending-freezes-quiet-pushback-senate-republicans/" class="external text" id="mwMEI">"Trump spending freezes spur quiet pushback from Senate Republicans"</a>. <i id="mwMEM">The Washington Examiner</i><span class="reference-accessdate" id="mwMEQ">. Retrieved <span class="nowrap" id="mwMEU">August 16,</span> 2025</span>. <q id="mwMEY">The Government Accountability Office, a congressional watchdog, has repeatedly ruled that canceled or delayed funding for biomedical research, K-12 education, and more is illegal and runs afoul of the Impoundment Control Act, a federal law regulating when presidents can withhold spending.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+Washington+Examiner&amp;rft.atitle=Trump+spending+freezes+spur+quiet+pushback+from+Senate+Republicans&amp;rft.date=2025-08-09&amp;rft.aulast=Touchberry&amp;rft.aufirst=Ramsay&amp;rft_id=https%3A%2F%2Fwww.washingtonexaminer.com%2Fnews%2Fsenate%2F3495365%2Ftrump-spending-freezes-quiet-pushback-senate-republicans%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwMEc"></span></span></li>
<li about="#cite_note-703" id="cite_note-703" data-mw-footnote-number="701"><span class="mw-cite-backlink" id="mwMEg"><a href="#cite_ref-703" rel="mw:referencedBy" id="mwMEk"><span class="mw-linkback-text" id="mwMEo">↑</span></a></span> <span id="mw-reference-text-cite_note-703" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2612" typeof="mw:Extension/templatestyles" id="mwMEs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="mwMEw" class="citation news cs1" data-x-id="CITEREFWaldman2025">Waldman, Annie (June 17, 2025). <a rel="mw:ExtLink nofollow" href="https://www.propublica.org/article/trump-nih-grant-terminations-illegal" class="external text" id="mwME0">"Federal Judge Deems Trump Administration's Termination of NIH Grants Illegal"</a>. <i id="mwME4">ProPublica</i><span class="reference-accessdate" id="mwME8">. Retrieved <span class="nowrap" id="mwMFA">August 16,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=ProPublica&amp;rft.atitle=Federal+Judge+Deems+Trump+Administration%27s+Termination+of+NIH+Grants+Illegal&amp;rft.date=2025-06-17&amp;rft.aulast=Waldman&amp;rft.aufirst=Annie&amp;rft_id=https%3A%2F%2Fwww.propublica.org%2Farticle%2Ftrump-nih-grant-terminations-illegal&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwMFE"></span></span></li>
