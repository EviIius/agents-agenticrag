<li about="#cite_note-285" id="cite_note-285" data-mw-footnote-number="284"><span class="mw-cite-backlink" id="mwH3s"><a href="#cite_ref-285" rel="mw:referencedBy" id="mwH3w"><span class="mw-linkback-text" id="mwH30">↑</span></a></span> <span id="mw-reference-text-cite_note-285" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt999" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwH34" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite ","function":"invoke"},"params":{"1":{"wt":" news "},"2":{"wt":"title=Meet the former Democrat leading Trump&apos;s charge against 10 universities "},"3":{"wt":"url=https://www.politico.com/news/2025/05/23/leo-terrell-trump-universities-harvard-00368352 "},"4":{"wt":"work=Politico "},"5":{"wt":"date=May 23, 2025 "},"6":{"wt":"archive-date=August 5, 2025 "},"7":{"wt":"access-date=August 3, 2025 "},"8":{"wt":"archive-url=https://web.archive.org/web/20250805000000/https://www.politico.com/news/2025/05/23/leo-terrell-trump-universities-harvard-00368352 "},"9":{"wt":"url-status=live "}},"i":0}}]}'/><cite class="citation news cs1" about="#mwt999" id="mwH38"><a rel="mw:ExtLink nofollow" href="https://www.politico.com/news/2025/05/23/leo-terrell-trump-universities-harvard-00368352" class="external text" id="mwH4A">"Meet the former Democrat leading Trump's charge against 10 universities"</a>. <i id="mwH4E">Politico</i>. May 23, 2025. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250805000000/https://www.politico.com/news/2025/05/23/leo-terrell-trump-universities-harvard-00368352" class="external text" id="mwH4I">Archived</a> from the original on August 5, 2025<span class="reference-accessdate" id="mwH4M">. Retrieved <span class="nowrap" id="mwH4Q">August 3,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Politico&amp;rft.atitle=Meet+the+former+Democrat+leading+Trump%27s+charge+against+10+universities&amp;rft.date=2025-05-23&amp;rft_id=https%3A%2F%2Fwww.politico.com%2Fnews%2F2025%2F05%2F23%2Fleo-terrell-trump-universities-harvard-00368352&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt999" id="mwH4U"></span></span></li>
<li about="#cite_note-286" id="cite_note-286" data-mw-footnote-number="285"><span class="mw-cite-backlink" id="mwH4Y"><a href="#cite_ref-286" rel="mw:referencedBy" id="mwH4c"><span class="mw-linkback-text" id="mwH4g">↑</span></a></span> <span id="mw-reference-text-cite_note-286" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1002" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwH4k" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite ","function":"invoke"},"params":{"1":{"wt":" news "},"2":{"wt":"last1=Bender "},"3":{"wt":"first1=Michael C. "},"4":{"wt":"last2=Blinder "},"5":{"wt":"first2=Alan "},"6":{"wt":"last3=Swan "},"7":{"wt":"first3=Jonathan "},"8":{"wt":"date=April 14, 2025 "},"9":{"wt":"title=Inside Trump&apos;s Pressure Campaign on Universities "},"10":{"wt":"work=The New York Times "},"11":{"wt":"url=https://www.nytimes.com/2025/04/14/us/politics/trump-pressure-universities.html "},"12":{"wt":"url-access=subscription "},"13":{"wt":"access-date=May 4, 2025 "},"14":{"wt":"archive-date=May 2, 2025 "},"15":{"wt":"archive-url=https://web.archive.org/web/20250502014738/https://www.nytimes.com/2025/04/14/us/politics/trump-pressure-universities.html "},"16":{"wt":"url-status=live "}},"i":0}}]}'/><cite id="CITEREFBenderBlinderSwan2025" class="citation news cs1" about="#mwt1002">Bender, Michael C.; Blinder, Alan; Swan, Jonathan (April 14, 2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwH4o"><a rel="mw:ExtLink nofollow" href="https://www.nytimes.com/2025/04/14/us/politics/trump-pressure-universities.html" class="external text" id="mwH4s">"Inside Trump's Pressure Campaign on Universities"</a></span>. <i id="mwH4w">The New York Times</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250502014738/https://www.nytimes.com/2025/04/14/us/politics/trump-pressure-universities.html" class="external text" id="mwH40">Archived</a> from the original on May 2, 2025<span class="reference-accessdate" id="mwH44">. Retrieved <span class="nowrap" id="mwH48">May 4,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+New+York+Times&amp;rft.atitle=Inside+Trump%27s+Pressure+Campaign+on+Universities&amp;rft.date=2025-04-14&amp;rft.aulast=Bender&amp;rft.aufirst=Michael+C.&amp;rft.au=Blinder%2C+Alan&amp;rft.au=Swan%2C+Jonathan&amp;rft_id=https%3A%2F%2Fwww.nytimes.com%2F2025%2F04%2F14%2Fus%2Fpolitics%2Ftrump-pressure-universities.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt1002" id="mwH5A"></span></span></li>
<li about="#cite_note-287" id="cite_note-287" data-mw-footnote-number="286"><span class="mw-cite-backlink" id="mwH5E"><a href="#cite_ref-287" rel="mw:referencedBy" id="mwH5I"><span class="mw-linkback-text" id="mwH5M">↑</span></a></span> <span id="mw-reference-text-cite_note-287" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1005" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwH5Q" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite ","function":"invoke"},"params":{"1":{"wt":" news "},"2":{"wt":"last=Coster "},"3":{"wt":"first=Helen "},"4":{"wt":"date=April 22, 2025 "},"5":{"wt":"title=US college presidents unite against Trump&apos;s higher education policies "},"6":{"wt":"work=Reuters "},"7":{"wt":"url=https://www.reuters.com/world/us/us-academic-leaders-unite-against-trumps-higher-education-policies-2025-04-22/ "},"8":{"wt":"access-date=May 4, 2025 "},"9":{"wt":"archive-date=April 24, 2025 "},"10":{"wt":"archive-url=https://web.archive.org/web/20250424063418/https://www.reuters.com/world/us/us-academic-leaders-unite-against-trumps-higher-education-policies-2025-04-22/ "},"11":{"wt":"url-status=live "}},"i":0}}]}'/><cite id="CITEREFCoster2025" class="citation news cs1" about="#mwt1005">Coster, Helen (April 22, 2025). <a rel="mw:ExtLink nofollow" href="https://www.reuters.com/world/us/us-academic-leaders-unite-against-trumps-higher-education-policies-2025-04-22/" class="external text" id="mwH5U">"US college presidents unite against Trump's higher education policies"</a>. <i id="mwH5Y">Reuters</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250424063418/https://www.reuters.com/world/us/us-academic-leaders-unite-against-trumps-higher-education-policies-2025-04-22/" class="external text" id="mwH5c">Archived</a> from the original on April 24, 2025<span class="reference-accessdate" id="mwH5g">. Retrieved <span class="nowrap" id="mwH5k">May 4,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Reuters&amp;rft.atitle=US+college+presidents+unite+against+Trump%27s+higher+education+policies&amp;rft.date=2025-04-22&amp;rft.aulast=Coster&amp;rft.aufirst=Helen&amp;rft_id=https%3A%2F%2Fwww.reuters.com%2Fworld%2Fus%2Fus-academic-leaders-unite-against-trumps-higher-education-policies-2025-04-22%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt1005" id="mwH5o"></span></span></li>
<li about="#cite_note-288" id="cite_note-288" data-mw-footnote-number="287"><span class="mw-cite-backlink" id="mwH5s"><a href="#cite_ref-288" rel="mw:referencedBy" id="mwH5w"><span class="mw-linkback-text" id="mwH50">↑</span></a></span> <span id="mw-reference-text-cite_note-288" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1008" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwH54" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite ","function":"invoke"},"params":{"1":{"wt":" news "},"2":{"wt":"last1=Kanno-Youngs "},"3":{"wt":"first1=Zolan "},"4":{"wt":"last2=Pager "},"5":{"wt":"first2=Tyler "},"6":{"wt":"last3=Aleaziz "},"7":{"wt":"first3=Hamed "},"8":{"wt":"date=March 21, 2025 "},"9":{"wt":"title=As Trump Broadens Crackdown, Focus Expands to Legal Immigrants and Tourists "},"10":{"wt":"work=The New York Times "},"11":{"wt":"url=https://www.nytimes.com/2025/03/21/us/politics/trump-immigration-visa-crackdown.html "},"12":{"wt":"url-access=subscription "},"13":{"wt":"access-date=March 29, 2025 "},"14":{"wt":"issn=0362-4331 "},"15":{"wt":"archive-date=March 28, 2025 "},"16":{"wt":"archive-url=https://web.archive.org/web/20250328094922/https://www.nytimes.com/2025/03/21/us/politics/trump-immigration-visa-crackdown.html "},"17":{"wt":"url-status=live "}},"i":0}}]}'/><cite id="CITEREFKanno-YoungsPagerAleaziz2025" class="citation news cs1" about="#mwt1008">Kanno-Youngs, Zolan; Pager, Tyler; Aleaziz, Hamed (March 21, 2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwH58"><a rel="mw:ExtLink nofollow" href="https://www.nytimes.com/2025/03/21/us/politics/trump-immigration-visa-crackdown.html" class="external text" id="mwH6A">"As Trump Broadens Crackdown, Focus Expands to Legal Immigrants and Tourists"</a></span>. <i id="mwH6E">The New York Times</i>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwH6I">ISSN</a><span typeof="mw:Entity" id="mwH6M"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/0362-4331" class="external text" id="mwH6Q">0362-4331</a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250328094922/https://www.nytimes.com/2025/03/21/us/politics/trump-immigration-visa-crackdown.html" class="external text" id="mwH6U">Archived</a> from the original on March 28, 2025<span class="reference-accessdate" id="mwH6Y">. Retrieved <span class="nowrap" id="mwH6c">March 29,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+New+York+Times&amp;rft.atitle=As+Trump+Broadens+Crackdown%2C+Focus+Expands+to+Legal+Immigrants+and+Tourists&amp;rft.date=2025-03-21&amp;rft.issn=0362-4331&amp;rft.aulast=Kanno-Youngs&amp;rft.aufirst=Zolan&amp;rft.au=Pager%2C+Tyler&amp;rft.au=Aleaziz%2C+Hamed&amp;rft_id=https%3A%2F%2Fwww.nytimes.com%2F2025%2F03%2F21%2Fus%2Fpolitics%2Ftrump-immigration-visa-crackdown.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt1008" id="mwH6g"></span></span></li>
<li about="#cite_note-Economist_07302025-289" id="cite_note-Economist_07302025-289" data-mw-footnote-number="288"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwH6k"><a href="#cite_ref-Economist_07302025_289-0" id="mwH6o"><span class="mw-linkback-text" id="mwH6s">1</span></a> <a href="#cite_ref-Economist_07302025_289-1" id="mwH6w"><span class="mw-linkback-text" id="mwH60">2</span></a></span> <span id="mw-reference-text-cite_note-Economist_07302025-289" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1011" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwH64" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite","function":"invoke"},"params":{"1":{"wt":"news"},"2":{"wt":"date=July 30, 2025"},"3":{"wt":"title=What Donald Trump is teaching Harvard"},"4":{"wt":"newspaper=The Economist"},"5":{"wt":"url=https://www.economist.com/united-states/2025/07/30/what-donald-trump-is-teaching-harvard"},"6":{"wt":"url-access=subscription"},"7":{"wt":"access-date=July 30, 2025"},"8":{"wt":"quote=Maybe so, but the settlement was still a shakedown. Mr Trump skipped the legal process by which the government can cancel funds. By law the administration has to offer a hearing and submit a report to Congress at least 30 days before the cut-off takes effect. None of that happened. Of course coercive, bilateral deals are Mr Trump&apos;s métier—he has achieved them with law firms and trading partners."},"9":{"wt":"archive-date=July 30, 2025"},"10":{"wt":"archive-url=https://web.archive.org/web/20250730194439/https://www.economist.com/united-states/2025/07/30/what-donald-trump-is-teaching-harvard"},"11":{"wt":"url-status=live"}},"i":0}}]}'/><cite class="citation news cs1" about="#mwt1011" id="mwH68"><span class="id-lock-subscription" title="Paid subscription required" id="mwH7A"><a rel="mw:ExtLink nofollow" href="https://www.economist.com/united-states/2025/07/30/what-donald-trump-is-teaching-harvard" class="external text" id="mwH7E">"What Donald Trump is teaching Harvard"</a></span>. <i id="mwH7I">The Economist</i>. July 30, 2025. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250730194439/https://www.economist.com/united-states/2025/07/30/what-donald-trump-is-teaching-harvard" class="external text" id="mwH7M">Archived</a> from the original on July 30, 2025<span class="reference-accessdate" id="mwH7Q">. Retrieved <span class="nowrap" id="mwH7U">July 30,</span> 2025</span>. <q id="mwH7Y">Maybe so, but the settlement was still a shakedown. Mr Trump skipped the legal process by which the government can cancel funds. By law the administration has to offer a hearing and submit a report to Congress at least 30 days before the cut-off takes effect. None of that happened. Of course coercive, bilateral deals are Mr Trump's métier—he has achieved them with law firms and trading partners.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+Economist&amp;rft.atitle=What+Donald+Trump+is+teaching+Harvard&amp;rft.date=2025-07-30&amp;rft_id=https%3A%2F%2Fwww.economist.com%2Funited-states%2F2025%2F07%2F30%2Fwhat-donald-trump-is-teaching-harvard&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt1011" id="mwH7c"></span></span></li>
<li about="#cite_note-Basu_07302025-290" id="cite_note-Basu_07302025-290" data-mw-footnote-number="289"><span class="mw-cite-backlink" id="mwH7g"><a href="#cite_ref-Basu_07302025_290-0" rel="mw:referencedBy" id="mwH7k"><span class="mw-linkback-text" id="mwH7o">↑</span></a></span> <span id="mw-reference-text-cite_note-Basu_07302025-290" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1014" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwH7s" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite","function":"invoke"},"params":{"1":{"wt":"news"},"2":{"wt":"last=Basu"},"3":{"wt":"first=Zachary"},"4":{"wt":"date=July 30, 2025"},"5":{"wt":"title=Trump&apos;s billion-dollar settlement spree"},"6":{"wt":"work=Axios"},"7":{"wt":"url=https://www.axios.com/2025/07/30/trump-harvard-settlement-dei-lawsuit"},"8":{"wt":"access-date=July 30, 2025"},"9":{"wt":"quote=America&apos;s most elite institutions have largely succumbed to the Trump administration&apos;s cultural crackdown, opting to pay up — often to the tune of tens or even hundreds of millions of dollars — rather than fight back."},"10":{"wt":"archive-date=July 30, 2025"},"11":{"wt":"archive-url=https://web.archive.org/web/20250730102249/https://www.axios.com/2025/07/30/trump-harvard-settlement-dei-lawsuit"},"12":{"wt":"url-status=live"}},"i":0}}]}'/><cite id="CITEREFBasu2025" class="citation news cs1" about="#mwt1014">Basu, Zachary (July 30, 2025). <a rel="mw:ExtLink nofollow" href="https://www.axios.com/2025/07/30/trump-harvard-settlement-dei-lawsuit" class="external text" id="mwH7w">"Trump's billion-dollar settlement spree"</a>. <i id="mwH70">Axios</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250730102249/https://www.axios.com/2025/07/30/trump-harvard-settlement-dei-lawsuit" class="external text" id="mwH74">Archived</a> from the original on July 30, 2025<span class="reference-accessdate" id="mwH78">. Retrieved <span class="nowrap" id="mwH8A">July 30,</span> 2025</span>. <q id="mwH8E">America's most elite institutions have largely succumbed to the Trump administration's cultural crackdown, opting to pay up — often to the tune of tens or even hundreds of millions of dollars — rather than fight back.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Axios&amp;rft.atitle=Trump%27s+billion-dollar+settlement+spree&amp;rft.date=2025-07-30&amp;rft.aulast=Basu&amp;rft.aufirst=Zachary&amp;rft_id=https%3A%2F%2Fwww.axios.com%2F2025%2F07%2F30%2Ftrump-harvard-settlement-dei-lawsuit&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt1014" id="mwH8I"></span></span></li>
<li about="#cite_note-291" id="cite_note-291" data-mw-footnote-number="290"><span class="mw-cite-backlink" id="mwH8M"><a href="#cite_ref-291" rel="mw:referencedBy" id="mwH8Q"><span class="mw-linkback-text" id="mwH8U">↑</span></a></span> <span id="mw-reference-text-cite_note-291" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1018" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwH8Y" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite","function":"invoke"},"params":{"1":{"wt":"news"},"2":{"wt":"last=Blinder"},"3":{"wt":"first=Alan"},"4":{"wt":"date=September 3, 2025"},"5":{"wt":"title=Judge Rules Trump Administration Illegally Canceled Harvard Funding"},"6":{"wt":"work=The New York Times"},"7":{"wt":"url=https://www.nytimes.com/2025/09/03/us/harvard-trump-funding-ruling.html"},"8":{"wt":"url-access=subscription"},"9":{"wt":"access-date=September 6, 2025"},"10":{"wt":"archive-date=September 5, 2025"},"11":{"wt":"archive-url=https://web.archive.org/web/20250905193856/https://www.nytimes.com/2025/09/03/us/harvard-trump-funding-ruling.html"},"12":{"wt":"url-status=live"}},"i":0}}]}'/><cite id="CITEREFBlinder2025" class="citation news cs1" about="#mwt1018">Blinder, Alan (September 3, 2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwH8c"><a rel="mw:ExtLink nofollow" href="https://www.nytimes.com/2025/09/03/us/harvard-trump-funding-ruling.html" class="external text" id="mwH8g">"Judge Rules Trump Administration Illegally Canceled Harvard Funding"</a></span>. <i id="mwH8k">The New York Times</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250905193856/https://www.nytimes.com/2025/09/03/us/harvard-trump-funding-ruling.html" class="external text" id="mwH8o">Archived</a> from the original on September 5, 2025<span class="refe