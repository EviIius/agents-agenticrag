<li about="#cite_note-Pitas_06102025-786" id="cite_note-Pitas_06102025-786" data-mw-footnote-number="783"><span class="mw-cite-backlink" id="mwM60"><a href="#cite_ref-Pitas_06102025_786-0" rel="mw:referencedBy" id="mwM64"><span class="mw-linkback-text" id="mwM68">↑</span></a></span> <span id="mw-reference-text-cite_note-Pitas_06102025-786" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2952" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwM7A" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite","function":"invoke"},"params":{"1":{"wt":"news"},"2":{"wt":"last=Pitas"},"3":{"wt":"first=Costas"},"4":{"wt":"date=June 10, 2025"},"5":{"wt":"title=Key facts about Los Angeles, progressive beacon at center of anti-Trump backlash"},"6":{"wt":"work=Reuters"},"7":{"wt":"url=https://www.reuters.com/world/us/los-angeles-progressive-beacon-center-anti-trump-backlash-2025-06-10/"},"8":{"wt":"url-access=subscription"},"9":{"wt":"access-date=January 10, 2025"},"10":{"wt":"quote=Protests in Los Angeles against raids on suspected undocumented immigrants have turned into the strongest domestic backlash against President Donald Trump since he took office in January."}},"i":0}}]}'/><cite id="CITEREFPitas2025" class="citation news cs1" about="#mwt2952">Pitas, Costas (June 10, 2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwM7E"><a rel="mw:ExtLink nofollow" href="https://www.reuters.com/world/us/los-angeles-progressive-beacon-center-anti-trump-backlash-2025-06-10/" class="external text" id="mwM7I">"Key facts about Los Angeles, progressive beacon at center of anti-Trump backlash"</a></span>. <i id="mwM7M">Reuters</i><span class="reference-accessdate" id="mwM7Q">. Retrieved <span class="nowrap" id="mwM7U">January 10,</span> 2025</span>. <q id="mwM7Y">Protests in Los Angeles against raids on suspected undocumented immigrants have turned into the strongest domestic backlash against President Donald Trump since he took office in January.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Reuters&amp;rft.atitle=Key+facts+about+Los+Angeles%2C+progressive+beacon+at+center+of+anti-Trump+backlash&amp;rft.date=2025-06-10&amp;rft.aulast=Pitas&amp;rft.aufirst=Costas&amp;rft_id=https%3A%2F%2Fwww.reuters.com%2Fworld%2Fus%2Flos-angeles-progressive-beacon-center-anti-trump-backlash-2025-06-10%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt2952" id="mwM7c"></span></span></li>
<li about="#cite_note-Bose_07082025-787" id="cite_note-Bose_07082025-787" data-mw-footnote-number="784"><span class="mw-cite-backlink" id="mwM7g"><a href="#cite_ref-Bose_07082025_787-0" rel="mw:referencedBy" id="mwM7k"><span class="mw-linkback-text" id="mwM7o">↑</span></a></span> <span id="mw-reference-text-cite_note-Bose_07082025-787" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2955" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwM7s" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite ","function":"invoke"},"params":{"1":{"wt":" news "},"2":{"wt":"last=Bose "},"3":{"wt":"first=Nandita "},"4":{"wt":"date=June 8, 2025 "},"5":{"wt":"title=Political divide widens as Trump deploys National Guard to Los Angeles "},"6":{"wt":"work=[[Reuters]] "},"7":{"wt":"url=https://www.reuters.com/world/us/political-divide-widens-trump-deploys-national-guard-los-angeles-2025-06-08/ "},"8":{"wt":"access-date=June 9, 2025 "},"9":{"wt":"quote=The protests against the raids have become the latest focal point in a national debate over immigration, protest rights, and the use of federal force in domestic affairs. It also has fueled discussion on the boundaries of presidential power and the public&apos;s right to dissent."}},"i":0}}]}'/><cite id="CITEREFBose2025" class="citation news cs1" about="#mwt2955">Bose, Nandita (June 8, 2025). <a rel="mw:ExtLink nofollow" href="https://www.reuters.com/world/us/political-divide-widens-trump-deploys-national-guard-los-angeles-2025-06-08/" class="external text" id="mwM7w">"Political divide widens as Trump deploys National Guard to Los Angeles"</a>. <i id="mwM70"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Reuters" title="Reuters" id="mwM74">Reuters</a></i><span class="reference-accessdate" id="mwM78">. Retrieved <span class="nowrap" id="mwM8A">June 9,</span> 2025</span>. <q id="mwM8E">The protests against the raids have become the latest focal point in a national debate over immigration, protest rights, and the use of federal force in domestic affairs. It also has fueled discussion on the boundaries of presidential power and the public's right to dissent.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Reuters&amp;rft.atitle=Political+divide+widens+as+Trump+deploys+National+Guard+to+Los+Angeles&amp;rft.date=2025-06-08&amp;rft.aulast=Bose&amp;rft.aufirst=Nandita&amp;rft_id=https%3A%2F%2Fwww.reuters.com%2Fworld%2Fus%2Fpolitical-divide-widens-trump-deploys-national-guard-los-angeles-2025-06-08%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt2955" id="mwM8I"></span></span></li>
