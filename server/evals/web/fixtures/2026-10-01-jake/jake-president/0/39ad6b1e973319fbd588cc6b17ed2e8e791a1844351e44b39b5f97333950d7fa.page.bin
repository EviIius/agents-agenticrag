ed-violence-rare-united-states" class="external text" id="mwL8I">"Politically Motivated Violence Is Rare in the United States"</a>. The Cato Institute. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250917050147/https://www.cato.org/blog/politically-motivated-violence-rare-united-states" class="external text" id="mwL8M">Archived</a> from the original on September 17, 2025.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Politically+Motivated+Violence+Is+Rare+in+the+United+States&amp;rft.pub=The+Cato+Institute&amp;rft.date=2025-09-11&amp;rft.aulast=Nowrasteh&amp;rft.aufirst=Alex&amp;rft_id=https%3A%2F%2Fwww.cato.org%2Fblog%2Fpolitically-motivated-violence-rare-united-states&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt2552" id="mwL8Q"></span> Table 2.</span></li>
<li about="#cite_note-AP_20250914-692" id="cite_note-AP_20250914-692" data-mw-footnote-number="690"><span class="mw-cite-backlink" id="mwL8U"><a href="#cite_ref-AP_20250914_692-0" rel="mw:referencedBy" id="mwL8Y"><span class="mw-linkback-text" id="mwL8c">↑</span></a></span> <span id="mw-reference-text-cite_note-AP_20250914-692" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2555" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwL8g" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"#invoke:cite ","function":"invoke"},"params":{"1":{"wt":" news "},"2":{"wt":"last1=Riccardi "},"3":{"wt":"first1=Nicholas "},"4":{"wt":"date=September 14, 2025 "},"5":{"wt":"title=Blame game after acts of political violence can lead to further attacks, experts warn "},"6":{"wt":"url=https://apnews.com/article/charlie-kirk-political-violence-shootings-utah-7b4e9b662932943a77635a0f8e839270 "},"7":{"wt":"url-status=live "},"8":{"wt":"archive-url=https://web.archive.org/web/20250915125254/https://apnews.com/article/charlie-kirk-political-violence-shootings-utah-7b4e9b662932943a77635a0f8e839270 "},"9":{"wt":"archive-date=September 15, 2025 "},"10":{"wt":"work=AP News"}},"i":0}}]}'/><cite id="CITEREFRiccardi2025" class="citation news cs1" about="#mwt2555">Riccardi, Nicholas (September 14, 2025). <a rel="mw:ExtLink nofollow" href="https://apnews.com/article/charlie-kirk-political-violence-shootings-utah-7b4e9b662932943a77635a0f8e839270" class="external text" id="mwL8k">"Blame game after acts of political violence can lead to further attacks, experts warn"</a>. <i id="mwL8o">AP News</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250915125254/https://apnews.com/article/charlie-kirk-political-violence-shootings-utah-7b4e9b662932943a77635a0f8e839270" class="external text" id="mwL8s">Archived</a> from the original on September 15, 2025.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=AP+News&amp;rft.atitle=Blame+game+after+acts+of+political+violence+can+lead+to+further+attacks%2C+experts+warn&amp;rft.date=2025-09-14&amp;rft.aulast=Riccardi&amp;rft.aufirst=Nicholas&amp;rft_id=https%3A%2F%2Fapnews.com%2Farticle%2Fcharlie-kirk-political-violence-shootings-utah-7b4e9b662932943a77635a0f8e839270&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" about="#mwt2555" id="mwL8w"></span></span></li>
<li about="#cite_note-693" id="cite_note-693" data-mw-footnote-number="691"><span class="mw-cite-backlink" id="mwL80"><a href="#cite_ref-693" rel="mw:referencedBy" id="mwL84"><span class="mw-linkback-text" id="mwL88">↑</span></a></span> <span id="mw-reference-text-cite_note-693" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2562" typeof="mw:Extension/templatestyles" id="mwL9A" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFMazaettiSwanHabermanSchmidt2025" class="citation news cs1">Mazaetti, Mark; Swan, Jonathan; Haberman, Maggie; Schmidt, Michael S. (January 28, 2025). <span class="id-lock-subscription" title="Paid subscription required" id="mwL9E"><a rel="mw:ExtLink nofollow" href="https://www.nytimes.com/2025/01/27/us/politics/trump-politics-enemies-pompeo-fauci.html" class="external text" id="mwL9I">"In Exacting Retribution, Trump Aims at the Future as Well as the Past"</a></span>. <i id="mwL9M">The New York Times</i>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwL9Q">ISSN</a><span typeof="mw:Entity" id="mwL9U"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/issn/0362-4331" class="external text" id="mwL9Y">0362-4331</a><span class="reference-accessdate" id="mwL9c">. Retrieved <span class="nowrap" id="mwL9g">January 28,</span> 2025</span>. <q id="mwL9k">In his first week in office, President Trump made clear that his promises to exact revenge on his perceived enemies were not empty campaign pledges — and that his retribution is intended not just to impose punishment for the past but also to intimidate anyone who might cross him in the future.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=The+New+York+Times&amp;rft.atitle=In+Exacting+Retribution%2C+Trump+Aims+at+the+Future+as+Well+as+the+Past&amp;rft.date=2025-01-28&amp;rft.issn=0362-4331&amp;rft.aulast=Mazaetti&amp;rft.aufirst=Mark&amp;rft.au=Swan%2C+Jonathan&amp;rft.au=Haberman%2C+Maggie&amp;rft.au=Schmidt%2C+Michael+S.&amp;rft_id=https%3A%2F%2Fwww.nytimes.com%2F2025%2F01%2F27%2Fus%2Fpolitics%2Ftrump-politics-enemies-pompeo-fauci.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwL9o"></span></span></li>
<li about="#cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Collinson_1282025-694" id="cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Collinson_1282025-694" data-mw-footnote-number="692"><span class="mw-cite-backlink" id="mwL9s"><a href="#cite_ref-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Collinson_1282025_694-0" rel="mw:referencedBy" id="mwL9w"><span class="mw-linkback-text" id="mwL90">↑</span></a></span> <span id="mw-reference-text-cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Collinson_1282025-694" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2567" typeof="mw:Extension/templatestyles" id="mwL94" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="mwL98" class="citation news cs1" data-x-id="CITEREFCollinson2025">Collinson, Stephen (January 28, 2025). <a rel="mw:ExtLink nofollow" href="https://www.cnn.com/2025/01/28/politics/trump-retribution-agenda-analysis/index.html" class="external text" id="mwL-A">"Trump sets about his retribution agenda with relish"</a>. <i id="mwL-E"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/CNN" title="CNN" id="mwL-I">CNN</a></i><span class="reference-accessdate" id="mwL-M">. Retrieved <span class="nowrap" id="mwL-Q">January 28,</span> 2025</span>. <q id="mwL-U">The president is wasting no time in following through on his frequent campaign trail vows for retribution – with a torrent of purges and pardons.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=CNN&amp;rft.atitle=Trump+sets+about+his+retribution+agenda+with+relish&amp;rft.date=2025-01-28&amp;rft.aulast=Collinson&amp;rft.aufirst=Stephen&amp;rft_id=https%3A%2F%2Fwww.cnn.com%2F2025%2F01%2F28%2Fpolitics%2Ftrump-retribution-agenda-analysis%2Findex.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwL-Y"></span></span></li>
<li about="#cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Dreisbach_04282025-695" id="cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Dreisbach_04282025-695" data-mw-footnote-number="693"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwL-c"><a href="#cite_ref-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Dreisbach_04282025_695-0" id="mwL-g"><span class="mw-linkback-text" id="mwL-k">1</span></a> <a href="#cite_ref-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Dreisbach_04282025_695-1" id="mwL-o"><span class="mw-linkback-text" id="mwL-s">2</span></a></span> <span id="mw-reference-text-cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Dreisbach_04282025-695" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2572" typeof="mw:Extension/templatestyles" id="mwL-w" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFDreisbach2025" class="citation news cs1">Dreisbach, Tom (April 28, 2025). <a rel="mw:ExtLink nofollow" href="https://www.npr.org/2025/04/29/nx-s1-5327518/donald-trump-100-days-retribution-threats" class="external text" id="mwL-0">"Trump has used government powers to target more than 100 perceived enemies"</a>. <i id="mwL-4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/NPR" title="NPR" id="mwL-8">NPR</a></i><span class="reference-accessdate" id="mwL_A">. Retrieved <span class="nowrap" id="mwL_E">April 29,</span> 2025</span>. <q id="mwL_I">In the first 100 days of his second term, President Trump has moved aggressively to fulfill his promise of retribution against an extraordinary range of individuals and organizations, targeting political opponents, news organizations, former government officials, universities, international student protesters and law firms.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=NPR&amp;rft.atitle=Trump+has+used+government+powers+to+target+more+than+100+perceived+enemies&amp;rft.date=2025-04-28&amp;rft.aulast=Dreisbach&amp;rft.aufirst=Tom&amp;rft_id=https%3A%2F%2Fwww.npr.org%2F2025%2F04%2F29%2Fnx-s1-5327518%2Fdonald-trump-100-days-retribution-threats&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3ASecond+presidency+of+Donald+Trump" class="Z3988" id="mwL_M"></span></span></li>
<li about="#cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Moynihan-696" id="cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Moynihan-696" data-mw-footnote-number="694"><span class="mw-cite-backlink" id="mwL_Q"><a href="#cite_ref-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Moynihan_696-0" rel="mw:referencedBy" id="mwL_U"><span class="mw-linkback-text" id="mwL_Y">↑</span></a></span> <span id="mw-reference-text-cite_note-Targeting_of_political_opponents_and_civil_society_under_the_second_Trump_administration_Moynihan-696" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt2577" typeof="mw:Extension/templatestyles" id="mwL_c" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFMoynihan2025" class="citation journal cs1">Moynihan, Donald (July 10, 2025). <a rel="mw:ExtLink nofollow" href="https://doi.org/10.1111%2Fpolp.70059" class="external text" id="mwL_g">"Trump, Personalism, and US Administrative Capacity"</a>. <i id="mwL_k"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Politics_and_Policy" title="Politics and Policy" id="mwL_o">Politics and Policy</a></i>. <b id="mwL_s">53</b> (4) e70059. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Doi_(identifier)" title="Doi (identifier)" class="mw-redirect" id="mwL_w">doi</a>:<span class="id-lock-free" title="Freely accessible" id="mwL_0"><a rel="mw:ExtLink nofollow" href="https://doi.org/10.1111%2Fpolp.70059" class="external text" id="mwL_4">10.1111/polp.70059</a></span>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISSN_(identifier)" title="ISSN (identifier)" class="mw-redirect" id="mwL_8">ISSN</a><span typeof="mw:Entity" id="mwMAA"> </span><a rel="mw:ExtLink nofollow" href="https://search.worl