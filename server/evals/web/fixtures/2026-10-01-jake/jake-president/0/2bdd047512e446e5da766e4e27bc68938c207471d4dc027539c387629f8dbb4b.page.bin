<span class="mw-empty-elt" about="#mwt10" typeof="mw:Transclusion" id="mwDw" data-mw='{"parts":[{"template":{"target":{"wt":"stack begin","href":"./Template:Stack_begin"},"params":{},"i":0}},"&lt;!-- DO NOT REMOVE. Required for correct vertical alignment of image at \"Early life and education\" in some user configurations. -->\n",{"template":{"target":{"wt":"infobox officeholder\n","href":"./Template:Infobox_officeholder"},"params":{"image":{"wt":"Official Presidential Portrait of President Donald J. Trump (2025).jpg"},"caption":{"wt":"[[Official portraits of Donald Trump#2025 presidential portrait|Official portrait, 2025]]&lt;!-- DO NOT CHANGE caption without prior consensus; see [[Talk:Donald Trump/Archive 196#Infobox image caption]]. -->"},"alt":{"wt":"Head-and-shoulders shot of Trump with a serious facial expression, his right eye partly closed. He is wearing a dark blue suit, a pale blue dress shirt, a red necktie, and an American flag lapel pin. Parts of the image are slightly out of focus. The background is black."},"order":{"wt":"45th &amp; 47th&lt;!-- DO NOT ADD A LINK. Please discuss any proposal on the talk page first. Most recent discussion at [[Talk:Donald Trump/Archive 65#Link-ifying \"45th\" in the Infobox?]] had a weak consensus to keep the status-quo (no link). -->"},"office":{"wt":"President of the United States"},"vice_president":{"wt":"[[JD Vance]]"},"term_start":{"wt":"January 20, 2025"},"predecessor":{"wt":"[[Joe Biden]]"},"vice_president1":{"wt":"[[Mike Pence]]"},"term_start1":{"wt":"January 20, 2017"},"term_end1":{"wt":"January 20, 2021"},"predecessor1":{"wt":"[[Barack Obama]]"},"successor1":{"wt":"Joe Biden"},"birth_name":{"wt":"Donald John Trump"},"birth_date":{"wt":"{{birth date and age|1946|6|14}}"},"birth_place":{"wt":"[[Queens]], New York City, U.S.&lt;!-- DO NOT CHANGE (or add to) this location without prior consensus; see [[Talk:Donald Trump#C2|consensus 2]]. -->"},"party":{"wt":"[[Republican Party (United States)|Republican]] (1969&a