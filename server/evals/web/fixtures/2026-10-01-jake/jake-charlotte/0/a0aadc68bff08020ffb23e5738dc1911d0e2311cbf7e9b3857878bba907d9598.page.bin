        {
          "@type": "Question",
          "name": "What food is Charlotte, NC known for?",
          "acceptedAnswer": { "@type": "Answer", "text": "Southern cooking is the backbone — fried chicken, shrimp and grits, and Carolina barbecue, plus regional specialties like livermush. Modern Charlotte is also known for international kitchens along Central Avenue and South Boulevard, a craft-brewery scene in the dozens, and a fine-dining class that earned the city its first Michelin star in 2025." }
        },
        {
          "@type": "Question",
          "name": "What are the best restaurants in Charlotte right now?",
          "acceptedAnswer": { "@type": "Answer", "text": "CLT Daily's current short list: Counter- (the city's first Michelin star), Haberdish, Supperland, Lang Van (Michelin Bib Gourmand), The Fig Tree, and Rada in Myers Park. The full ranked list is in The Essentials section of this guide, updated as the scene changes." }
        },
        {
          "@type": "Question",
          "name": "Where should I eat in Uptown Charlotte?",
          "acceptedAnswer": { "@type": "Answer", "text": "Church and Union and La Belle Hélène for a big night, Fin & Fino for seafood before a show, Sea Level NC for oysters and happy hour, and Mert's Heart & Soul for soul food before a Hornets game." }
        },
        {
          "@type": "Question",
          "name": "What restaurants are open late in Charlotte?",
          "acceptedAnswer": { "@type": "Answer", "text": "Midnight Diner (near Spectrum Center) and RedEye Diner (Queen City Quarter) are open 24/7 Uptown. Fuel Pizza in Plaza Midwood serves until 2–3am on weekends, and Cook Out drive-thrus across the city run until 3–4am." }
        },
        {
          "@type": "Question",
          "name": "What new restaurants have opened in Charlotte?",
          "acceptedAnswer": { "@type": "Answer", "text": "The 2026 class is strong: flora in South End, Uchi + Uchibā and Maman in Plaza Midwood, Grey's Diner on The Plaza, Italo Uptown, and DaBaby's No Knife Chicken & Waffles, which opened on Atando Ave in north Charlotte on September 7. We keep the New & Noteworthy section updated as openings happen." }
        },
        {
          "@type": "Question",
          "name": "When is Charlotte Restaurant Week?",
          "acceptedAnswer": { "@type": "Answer", "text": "Queen's Feast: Charlotte Restaurant Week runs twice a year — ten days each January and July — with three-course prix fixe menus at more than 120 restaurants across the Charlotte region." }
        }
      ]
    }
  ]
}
</script>

<script>
/* CLT pillar page JS — TOC highlight + last-updated (tiny, no dependencies) */
(function(){
  /* Active-section highlight in sticky TOC */
  var links = document.querySelectorAll('#cltp-toc-desktop a');
  if ('IntersectionObserver' in window && links.length) {
    var map = {};
    links.forEach(function(a){ map[a.getAttribute('href').slice(1)] = a; });
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting && map[e.target.id]) {
          links.forEach(function(a){ a.classList.remove('is-active'); });
          map[e.target.id].classList.add('is-active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    Object.keys(map).forEach(function(id){
      var el = document.getElementById(id);
      if (el) obs.observe(el);
    });
  }
  /* Close mobile TOC after tapping a link */
  var mob = document.querySelector('.cltp-toc-mobile');
  if (mob) mob.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ mob.removeAttribute('open'); });
  });
  /* Dynamic "Last updated" — pulls the page's own modified date from the REST API */
  var slot = document.getElementById('cltp-updated-date');
  if (slot) {
    var show = function(m){ if (m) { slot.textContent = new Date(m).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }); } };
    fetch('/wp-json/wp/v2/pages/3450?_fields=modified')
      .then(function(r){ if (!r.ok) throw 0; return r.json(); })
      .then(function(pg){ show(pg && pg.modified); })
      .catch(function(){
        fetch('/wp-json/wp/v2/pages?slug=best-restaurants-in-charlotte&_fields=slug,modified')
          .then(function(r){ return r.json(); })
          .then(function(arr){ var pg=(arr||[]).filter(function(p){return p.slug==='best-restaurants-in-charlotte';})[0]; show(pg && pg.modified); })
          .catch(function(){ /* keep fallback text */ });
      });
  }
})();
</script>

