<style id="wp-custom-css">
/* === CLT Daily global masthead cleanup (2026-07) ===
   Solid slate band sitewide; world-map bgs removed via Customizer settings.
   Optional skyline-silhouette variant available — see build notes. */
.site-header .inside-header{max-width:100%;padding:24px 28px;align-items:flex-start;}
.site-header .main-title{margin:0;line-height:1.1;}
.site-header .main-title a{color:#fff;}
@media (max-width:768px){.site-header .inside-header{padding:16px 20px;}}

/* ===== CLT DAILY — GLOBAL COMPONENT LIBRARY =====
   Source: page 3450 inline <style>. Globalized 2026-08-21.
   3450 still carries its own inline copy this pass — do not strip it
   until every designed page is regression-confirmed.
   Page-specific rules (.page-id-3450, #essentials/#neighborhoods/
   #brunch/#date-night/#events band colours) were deliberately NOT moved.
   html{scroll-behavior} and :target{scroll-margin} also left inline —
   they are site-wide side effects, not components.
   Design tokens promoted to :root so .cltp-* works on any page
   without a .clt-pillar wrapper. */

:root{
  --slate: #1C2638;
  --charcoal: #343A40;
  --ink: #1F2024;
  --gray: #5E5E69;
  --band: #F7F8FA;
  --line: #E4E6EA;
}

.clt-pillar { --slate: #1C2638; --charcoal: #343A40; --ink: #1F2024; --gray: #5E5E69; --band: #F7F8FA; --line: #E4E6EA; font-size: 17px; line-height: 1.65; color: var(--ink); }
.clt-pillar * { box-sizing: border-box; }
.clt-pillar h1, .clt-pillar h2, .clt-pillar h3 { font-family: Montserrat, sans-serif; color: var(--ink); }
.cltp-wrap { max-width: 1100px; margin: 0px auto; padding: 0px 20px; }
.cltp-prose { max-width: 780px; }
.cltp-hero { color: rgb(255, 255, 255); text-align: left; }
.cltp-hero .cltp-wrap { max-width: 900px; }
.cltp-hero h1 { color: rgb(255, 255, 255); font-size: clamp(2rem, 5vw, 3rem); margin: 0px 0px 14px; line-height: 1.15; }
.cltp-hero p { color: rgb(232, 235, 240); font-size: 1.1rem; max-width: 720px; margin: 0px 0px 24px; }
.cltp-hero-btns { display: flex; flex-wrap: wrap; gap: 12px; }
.cltp-btn { display: inline-block; background: rgb(255, 255, 255); font-family: Montserrat, sans-serif; font-weight: 700; font-size: 0.95rem; padding: 13px 22px; border-radius: 3px; text-decoration: none; min-height: 44px; transition: transform 0.15s, box-shadow 0.15s; color: var(--slate) !important; }
.cltp-btn:hover { transform: translateY(-2px); box-shadow: rgba(0, 0, 0, 0.25) 0px 6px 16px; }
.cltp-btn--gold { background: rgb(226, 156, 4); color: rgb(255, 255, 255) !important; }
.cltp-updated { display: inline-block; margin-top: 18px; font-size: 0.85rem; color: rgb(201, 208, 219); letter-spacing: 0.02em; }
.cltp-toc { position: sticky; top: 0px; z-index: 60; background: rgb(255, 255, 255); border-bottom: 1px solid var(--line); box-shadow: rgba(28, 38, 56, 0.06) 0px 2px 8px; }
.cltp-toc-inner { max-width: 1100px; margin: 0px auto; padding: 10px 16px; display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
.cltp-toc-inner::-webkit-scrollbar { display: none; }
.cltp-toc a { flex: 0 0 auto; font-family: Montserrat, sans-serif; font-size: 0.82rem; font-weight: 600; color: var(--charcoal); text-decoration: none; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); min-height: 36px; line-height: 1; display: inline-flex; align-items: center; transition: background 0.15s, color 0.15s; }
.cltp-toc a:hover { background: var(--band); }
.cltp-toc a.is-active { background: var(--slate); border-color: var(--slate); color: rgb(255, 255, 255); }
.cltp-toc-mobile { display: none; }
@media (max-width: 768px){
.cltp-toc-inner { display: none; }
.cltp-toc-mobile { display: block; padding: 0px; }
.cltp-toc-mobile summary { list-style: none; cursor: pointer; padding: 14px 20px; font-family: Montserrat, sans-serif; font-weight: 700; font-size: 0.9rem; color: var(--slate); display: flex; justify-content: space-between; align-items: center; }
.cltp-toc-mobile summary::after { content: "▾"; color: var(--gray); }
.cltp-toc-mobile[open] summary::after { content: "▴"; }
.cltp-toc-mobile a { display: block; padding: 12px 20px; font-size: 0.92rem; color: var(--charcoal); text-decoration: none; border-top: 1px solid var(--line); min-height: 44px; }
}
.cltp-sec { padding: 52px 20px; }
.cltp-sec--band { background: var(--band); }
.cltp-sec h2 { font-size: clamp(1.5rem, 3vw, 1.9rem); margin: 0px 0px 6px; padding-left: 14px; border-left: 5px solid var(--sec,#343A40); line-height: 1.25; }
.cltp-sec h3 { font-size: 1.15rem; margin: 34px 0px 0px; }
.cltp-kicker { font-family: Montserrat, sans-serif; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--sec,#5E5E69); margin: 0px 0px 8px; }
.cltp-sec .cltp-prose p { margin: 14px 0px; }
.cltp-sec ul { margin: 12px 0px 0px; padding-left: 22px; }
.cltp-sec li { margin: 8px 0px; }
.cltp-weekend-box { border: 2px solid rgb(226, 156, 4); background: rgb(253, 247, 233); border-radius: 6px; padding: 26px 26px 22px; position: relative; }
.cltp-badge { position: absolute; top: -13px; left: 22px; background: rgb(226, 156, 4); color: rgb(255, 255, 255); font-family: Montserrat, sans-serif; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 5px 12px; border-radius: 999px; }
.cltp-weekend-box ul { list-style: none; padding: 0px; margin: 16px 0px 0px; }
.cltp-weekend-box li { padding: 12px 0px; border-top: 1px dashed rgb(232, 206, 150); margin: 0px; }
.cltp-weekend-box li:first-child { border-top: 0px; }
.cltp-closed-box { border-color: rgb(94, 94, 105); background: rgb(244, 245, 247); }
.cltp-closed-box .cltp-badge { background: rgb(94, 94, 105); }
.cltp-closed-box li { border-top-color: rgb(220, 222, 227); }
.cltp-note { border-left: 4px solid var(--sec,#343A40); background: rgb(255, 255, 255); padding: 16px 20px; margin: 22px 0px 0px; border-radius: 0px 6px 6px 0px; font-size: 0.95rem; }
.cltp-note p { margin: 0px 0px 10px; }
.cltp-note p:last-child { margin: 0px; }
.cltp-weekend-box li strong { font-family: Montserrat, sans-serif; }
.cltp-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 22px; margin-top: 28px; }
.cltp-card { display: flex; flex-direction: column; background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 6px; overflow: hidden; text-decoration: none; transition: transform 0.18s, box-shadow 0.18s; color: var(--ink) !important; }
.cltp-card:hover { transform: translateY(-4px); box-shadow: rgba(28, 38, 56, 0.12) 0px 10px 24px; }
.cltp-card img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; display: block; background: var(--band); }
.cltp-card-body { padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 8px; flex: 1 1 0%; }
.cltp-card h3 { font-size: 1.02rem; margin: 0px; line-height: 1.35; }
.cltp-card p { font-size: 0.9rem; color: var(--gray); margin: 0px; flex: 1 1 0%; }
.cltp-more { font-family: Montserrat, sans-serif; font-size: 0.82rem; font-weight: 700; color: var(--sec,#343A40); }
.cltp-card:hover .cltp-more { text-decoration: underline; }
.cltp-tag { align-self: flex-start; font-family: Montserrat, sans-serif; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(255, 255, 255); background: var(--sec,#343A40); padding: 4px 10px; border-radius: 999px; }
.cltp-faq details { border: 1px solid var(--line); border-radius: 6px; background: rgb(255, 255, 255); margin: 10px 0px; }
.cltp-faq summary { list-style: none; cursor: pointer; padding: 16px 20px; font-family: Montserrat, sans-serif; font-weight: 700; font-size: 1rem; color: var(--slate); display: flex; justify-content: space-between; gap: 14px; min-height: 44px; }
.cltp-faq summary::-webkit-details-marker { display: none; }
.cltp-faq summary::after { content: "+"; font-size: 1.3rem; color: var(--gray); line-height: 1; }
.cltp-faq details[open] summary::after { content: "–"; }
.cltp-faq details p { padding: 0px 20px 18px; margin: 0px; color: var(--ink); }
.cltp-cta { background: var(--slate); color: rgb(255, 255, 255); padding: 56px 20px; text-align: center; }
.cltp-cta h2 { color: rgb(255, 255, 255); border: 0px; padding: 0px; font-size: clamp(1.5rem, 3vw, 1.9rem); margin: 0px 0px 10px; }
.cltp-cta p { color: rgb(201, 208, 219); max-width: 640px; margin: 0px auto 24px; }
.cltp-cta .cltp-hero-btns { justify-content: center; }
.cltp-related { padding: 48px 20px 64px; }
.cltp-related .cltp-cards { margin-top: 18px; }
.cltp-soon { opacity: 0.65; cursor: default; pointer-events: none; }
.cltp-soon .cltp-tag { background: var(--gray); }
@media (max-width: 600px){
.cltp-sec { padding: 40px 16px; }
}
.cltp-rows { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 14px 22px; margin-top: 26px; }
.cltp-row { display: flex; gap: 14px; align-items: flex-start; background: rgb(255, 255, 255); border-top-color: ; border-top-style: ; border-top-width: ; border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-left: 3px solid var(--sec,#343A40); border-radius: 6px; padding: 14px 16px; transition: transform 0.15s, box-shadow 0.15s; }
.cltp-row:hover { transform: translateY(-2px); box-shadow: rgba(28, 38, 56, 0.1) 0px 8px 18px; }
.cltp-row-ic { flex: 0 0 38px; width: 38px; height: 38px; border-radius: 50%; background: rgb(240, 242, 245); position: relative; }
.cltp-row-ic::after { content: ""; position: absolute; inset: 9px; background: var(--sec,#343A40); mask: var(--ic) center/contain no-repeat; }
.cltp-row-body h3 { font-size: 0.98rem; margin: 0px 0px 3px; line-height: 1.3; }
.cltp-row-body h3 a { color: var(--ink); }
.cltp-row-body h3 .cltp-when { font-family: Montserrat, sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--sec,#5E5E69); margin-left: 8px; white-space: nowrap; }
.cltp-row-body p { font-size: 0.88rem; color: var(--gray); margin: 0px; line-height: 1.5; }
.cltp-cta--mid { padding: 40px 20px; }
.cltp-cta--mid .cltp-cta-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px; text-align: left; }
.cltp-cta--mid h2 { margin: 0px 0px 6px; font-size: clamp(1.25rem, 2.4vw, 1.55rem); }
.cltp-cta--mid p { margin: 0px; max-width: 560px; }
.cltp-hero { position: relative; overflow: hidden; background: rgb(28, 38, 56); padding: 0px; }
.cltp-hero-img { position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover; z-index: 0; display: block; }
.cltp-hero::after { content: ""; position: absolute; inset: 0px; background: linear-gradient(rgba(28, 38, 56, 0.8), rgba(28, 38, 56, 0.9)); z-index: 1; }
.cltp-hero-content { position: relative; z-index: 2; padding: 64px 20px 56px; }
@media (max-width: 600px){
.cltp-hero-content { padding: 48px 16px 44px; }
}
.clt-pillar .cltp-hero, .clt-pillar .cltp-sec, .clt-pillar .cltp-cta, .clt-pillar .cltp-related { width: 100vw; position: relative; left: 50%; margin-left: -50vw; }

/* --- Per-category accent utilities (drive --sec on any .cltp-sec / .cltp-note) --- */
/* Colours are CLT Daily's documented category accents. Class-scoped: inert everywhere else. */
.cltp-acc-news      { --sec: #E29C04; }
.cltp-acc-business  { --sec: #4C3957; }
.cltp-acc-community { --sec: #56B85A; }
.cltp-acc-sports    { --sec: #EE5565; }
.cltp-acc-cities    { --sec: #6CD2CC; }
.cltp-acc-podcast   { --sec: #8A2BE2; }

/* ===== COMPACT ARTICLE VARIANT (.cltp-lite) =====
   For native-Gutenberg pages that use the .cltp-* components without the
   full-bleed pillar chrome. Opt-in by adding cltp-lite to a .cltp-sec.
   Leaves every pillar untouched — nothing on the site carries this class
   except page 3732. */
/* GeneratePress puts 40px of horizontal padding on EVERY .wp-block-group__inner-container.
   Nested three deep (wrap > prose > paragraph) that ate 240px of measure and was the real
   cause of both the width mismatch and the half-empty detail boxes. Scoped to .cltp-lite. */
.cltp-lite .wp-block-group__inner-container{ padding:0; max-width:none; }
.cltp-lite{ padding:32px 20px; background:#fff; }
.cltp-lite + .cltp-lite{ border-top:1px solid var(--line); }
.cltp-lite .cltp-wrap{ max-width:740px; }
.cltp-lite .cltp-prose{ max-width:100%; }
.cltp-lite .cltp-prose p{ margin:0 0 14px; }
.cltp-lite .cltp-prose p:last-child{ margin-bottom:0; }
.cltp-lite h3{
  font-size:25px; line-height:1.25; font-weight:700;
  margin:0 0 12px; padding-left:14px;
  border-left:5px solid var(--sec,#343A40);
}
.cltp-lite .cltp-note{
  max-width:100%;
  margin:18px 0 0;
  padding:10px 16px;
  background:#F1F3F6;
  border:1px solid var(--line);
  border-left:4px solid var(--sec,#343A40);
  border-radius:0 6px 6px 0;
}
.cltp-lite .cltp-note ul{ margin:0; padding-left:20px; }
.cltp-lite .cltp-note li{ margin:3px 0; line-height:1.45; }
@media (max-width:600px){
  .cltp-lite{ padding:24px 16px; }
  .cltp-lite h3{ font-size:21px; }
}

/* Lede image for the weekend page — sits BELOW the H1, no type over it,
   so image brightness is irrelevant here (see CLAUDE.md standing gotcha #2). */
.clt-lede{ margin:0 0 4px; }
.clt-lede img{ display:block; width:100%; height:auto; border-radius:8px; }
@media (max-width:600px){ .clt-lede img{ border-radius:5px; } }

/* ===== WEEKEND PAGE HERO (.clt-hero) — page 3732 =====
   Wrapper is a GenerateBlocks Container; all visual treatment lives here rather than in
   GB attributes, so nothing depends on a hand-authored GB attribute shape.

   SCRIM .70 — MEASURED on media 3755 at this exact value: worst single pixel 5.84:1
   white-on-scrim, p95 7.02:1, mean 10.10:1. Target 4.5:1.
   Was .85 (worst 9.59:1) which was far more headroom than needed and flattened the
   photo to a navy block: tonal range p5-p95 goes 28.2 -> 56.4 moving .85 -> .70, i.e.
   the skyline only becomes legible below about .75. FLOOR IS .65 (worst 4.99:1);
   .60 fails at 4.29:1. Re-measure if the photo is ever swapped.

   BACKGROUND PINNED TO TOP: holds a constant 51px above the Bank of America crown at
   EVERY width. At 'center 12%' the crown was lost at 3440px. Do not use a percentage.

   FULL BLEED WITHOUT 100vw: 'width:100vw' includes the scrollbar and added 31px of
   horizontal overflow. The element stays 100% wide and in flow; a ::before paints the bleed. */

body.page-id-3732 .inside-article{ padding-top:0; }   /* closes the 40px white strip under the nav */

.clt-hero{
  position:relative;
  isolation:isolate;
  margin:0 0 8px;
  padding:72px 24px;
  min-height:480px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.clt-hero::before{
  content:"";
  position:absolute;
  top:0; bottom:0;
  left:50%; transform:translateX(-50%);
  width:100vw; max-width:100vw;
  z-index:-1;
  background-color:#1C2638;
  background-image:linear-gradient(rgba(28,38,56,.70), rgba(28,38,56,.70)), url('https://cltdaily.com/wp-content/uploads/2026/08/charlotte-weekend-hero-1600.jpg');
  background-size:cover, cover;
  background-position:center top, center top;
  background-repeat:no-repeat, no-repeat;
}
/* Hero measure is 900px, NOT the 700px body measure — a display headline is not prose.
   The 413px headline came from a max-width:16ch cap on the H1, not from GB and not from
   the inner-container rule. Don't reintroduce a ch-based cap here. */
.clt-hero .gb-container-inside,
.clt-hero .gb-inside-container,
.clt-hero .wp-block-group__inner-container{
  padding:0;
  max-width:900px;
  margin-left:auto;
  margin-right:auto;
  width:100%;
}
.clt-hero h1{
  position:relative;
  color:#fff;
  font-family:Montserrat, sans-serif;
  font-size:clamp(1.75rem, 3.6vw, 2.375rem);
  line-height:1.15;
  margin:0;
  max-width:none;
  text-align:center;
}
/* Kicker is a PARAGRAPH, never a heading — the page must keep exactly one H1.
   Splitting the date out makes a broken date structurally impossible at any width,
   and isolates the one string that changes every Thursday. */
.clt-hero .clt-hero-kicker{
  position:relative;
  margin:14px 0 0;
  color:rgba(255,255,255,.82);
  font-family:Montserrat, sans-serif;
  font-size:clamp(1.05rem, 2.1vw, 1.425rem);   /* ~60% of the headline */
  font-weight:500;
  letter-spacing:.08em;
  text-transform:uppercase;
  text-align:center;
  line-height:1.3;
}
@media (max-width:600px){
  .clt-hero{ padding:44px 18px; min-height:300px; }
  .clt-hero .clt-hero-kicker{ margin-top:10px; letter-spacing:.06em; }
}

/* === CLT Daily — visible links in article body (2026-08-25) === */

.single-post .entry-content p a:not([class]),
.single-post .entry-content li a:not([class]) {
  color: var(--technology, #396eb3);
  text-decoration: underline;
  text-underline-offset: 2px;
  text-decoration-thickness: 1px;
}

.single-post .entry-content p a:not([class]):hover,
.single-post .entry-content p a:not([class]):focus,
.single-post .entry-content li a:not([class]):hover,
.single-post .entry-content li a:not([class]):focus {
  color: #2b568d;
  text-decoration-thickness: 2px;
}

/* cltp-table-stack — mobile stacked tables. Globalised 2026-09-03; was missing from the Aug-21 globalisation. */
@media(max-width:600px){.cltp-sec{padding:40px 16px;}.cltp-hero-content{padding:48px 16px 44px;}.cltp-rows{grid-template-columns:1fr;}
/* 3- and 4-column tables stack into labelled rows on phones — no horizontal scroll */
.cltp-table-stack{border-radius:6px;}
.cltp-table-stack thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
.cltp-table-stack tr{display:block;border-top:3px solid var(--sec,#343A40);}
.cltp-table-stack tr:first-child{border-top:0;}
.cltp-table-stack td{display:flex;gap:10px;border-top:0;padding:7px 14px;font-size:.92rem;}
.cltp-table-stack tr td:first-child{padding-top:14px;}
.cltp-table-stack tr td:last-child{padding-bottom:14px;}
.cltp-table-stack td::before{content:attr(data-l);flex:0 0 84px;font-family:'Montserrat',sans-serif;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--gray);padding-top:3px;}
.cltp-table-stack tbody tr:nth-child(odd) td{background:#FAFBFC;}}

</style>
<style id="core-block-supports-inline-css">
.wp-elements-1 a:where(:not(.wp-element-button)){color:var(--wp--preset--color--base-2);}
/*# sourceURL=core-block-supports-inline-css */
</style>

</head>

