<link rel="stylesheet" href="https://topofcharlotte.com/wp-content/plugins/custom-business-directory/assets/css/v2/v6-utility.css?v=1789326261">
<style>
/* paper sheet (Will 2026-09-02 night, "look more like on the page"): the whole
   content area sits on ONE white page surface; the inner list panel flattens
   so there is no card-inside-card. */
body.u6 .u6-main .wrap{background:var(--card);border:1px solid var(--hair);border-radius:14px;box-shadow:var(--shadow);padding:6px 40px 44px;margin:20px auto 30px}
body.u6 .u6-main .panel.tbl{border:0;box-shadow:none;background:transparent;border-radius:0}
/* Refined hero (approved 2026-09-06 + Will's tweaks): stat tiles deleted,
   dek in the reading serif, red tick on the kicker, featured image smaller
   with square corners, updated date lives in the byline. */
body.u6 .u6-main .ghero{grid-template-columns:minmax(0,1fr) 340px;gap:36px;padding:22px 0 26px;align-items:start}
body.u6 .u6-main .ghero .k.sig::before{content:"";display:inline-block;width:22px;height:3px;background:var(--sig);margin-right:10px;vertical-align:middle}
body.u6 .u6-main .ghero .dek{font-family:var(--serif);font-size:18px;line-height:1.55;color:var(--ink2);font-weight:500;max-width:none}
body.u6 .u6-main .ghero .ph{border-radius:0;overflow:hidden;box-shadow:var(--shadow)}
body.u6 .u6-main .ghero .ph img{aspect-ratio:auto;height:240px}
body.u6 .u6-main .ghero .gby{gap:13px;margin-top:20px}
body.u6 .u6-main .ghero .gby img,body.u6 .u6-main .ghero .gby .ini{width:64px;height:64px}
body.u6 .u6-main .ghero .gby b{font-size:17px;font-weight:700}
body.u6 .u6-main .ghero .gby span{font-size:13.5px;color:var(--ink2)}
body.u6 .u6-main .gby span a{color:inherit}
/* Tip-sheet band: refined form, tight rhythm (Will 2026-09-06) */
body.u6 .u6-main .band{padding:32px 40px;border-radius:10px}
body.u6 .u6-main .band h2{font-size:28px}
body.u6 .u6-main .band p{margin-top:7px}
body.u6 .u6-main .band form{padding:6px;border-radius:12px;gap:6px;align-items:center;box-shadow:0 6px 20px rgba(8,12,22,.28);flex-wrap:nowrap;max-width:390px;justify-self:end}
body.u6 .u6-main .band input{padding:12px 14px;font-size:15px;min-width:0;width:210px}
body.u6 .u6-main .band form .u-btn.primary{padding:12px 22px;border-radius:8px;font-size:14px;font-weight:700}
body.u6 .u6-main .band form .cbd-nl-msg{flex:0 0 auto;flex-basis:auto}
body.u6 .u6-main .band form .cbd-nl-msg:empty{display:none}
/* Bottom sections in the fold-row language (Will 2026-09-06, "make this
   look as good as the rest"): boxes gone, hairline sections, red mono
   kickers, serif reading text. Author block = slim bio section (kept for
   the on-page expertise copy; name/photo already live in the hero). */
body.u6 .u6-main .faqsec{background:transparent;border:0;box-shadow:none;border-radius:0;padding:22px 0;margin:0;border-top:1px solid var(--hair)}
body.u6 .u6-main .faqsec h2{font-family:var(--serif);font-size:26px;font-weight:700;letter-spacing:-.02em;margin:0 0 4px}
body.u6 .u6-main .faqsec h2::before{content:"The questions";display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--sig);margin-bottom:6px}
body.u6 .u6-main .faqsec details{border-bottom:0;border-top:1px solid var(--hair2);padding:12px 0}
body.u6 .u6-main .faqsec details:last-of-type{padding-bottom:0}
body.u6 .u6-main .faqsec details:first-of-type{border-top:0}
body.u6 .u6-main .faqsec summary{font-size:16px;color:var(--ink)}
body.u6 .u6-main .faqsec summary:after{color:var(--sig);font-family:var(--mono)}
body.u6 .u6-main .faqsec .a{font-family:var(--serif);font-size:16.5px;line-height:1.65;color:#3a4048;padding-top:10px}
body.u6 .u6-main .methodp{background:transparent;border:0;box-shadow:none;border-radius:0;padding:22px 0;margin:0;border-top:1px solid var(--hair);display:block}
body.u6 .u6-main .methodp .ic{display:none}
body.u6 .u6-main .methodp h3{font-family:var(--serif);font-size:22px;font-weight:700;letter-spacing:-.018em;margin:0 0 8px}
body.u6 .u6-main .methodp h3::before{content:"The method";display:block;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--sig);margin-bottom:6px}
body.u6 .u6-main .methodp p{font-family:var(--serif);font-size:16.5px;line-height:1.68;color:#3a4048;margin:0;max-width:none}
body.u6 .u6-main .authp{background:transparent;border:0;box-shadow:none;border-radius:0;padding:22px 0;margin:0;border-top:1px solid var(--hair);display:flex;gap:16px;align-items:flex-start}
body.u6 .u6-main .authp .authk{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--sig);margin-bottom:6px}
body.u6 .u6-main .authp b{font-family:var(--serif);font-size:20px;font-weight:700}
body.u6 .u6-main .authp b a{color:inherit;text-decoration:none}
body.u6 .u6-main .authp .u-role{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);margin:4px 0 8px}
body.u6 .u6-main .authp p{font-family:var(--serif);font-size:16.5px;line-height:1.68;color:#3a4048;margin:0}
body.u6 .u6-main .relchips{border-top:1px solid var(--hair);padding:22px 0;margin:0}
body.u6 .u6-main .relchips h3{font-family:var(--serif);font-size:22px;font-weight:700;letter-spacing:-.018em;margin:0 0 12px}
/* Fold rows (approved mockup 2026-09-06, DesignLibrary/mockups/
   vegas-guide-ramen-foldrows-2026-09-06.html.APPROVED-20260906): compact
   scannable rows, the full review opens in a fold. First 10 entries render
   open. Fold body left, facts rail right (map, hours, address, phone,
   insider tip as one labeled list). Review text is ALWAYS in the HTML;
   the fold is display only. */
body.u6 .u6-main .tbl .lrow{background:transparent;border:0 solid transparent;border-top:1px solid var(--hair);box-shadow:none;border-radius:0;overflow:visible;margin:0}
/* 2026-09-07 (Will, "you can't even see the name"): anchor arrivals land the
   row top with air above it so the rank + name are in view */
body.u6 .u6-main .tbl .lrow{scroll-margin-top:22px}
body.u6 .u6-main .tbl .lrow:first-of-type{border-top:0}
body.u6 .u6-main .lrow summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:300px minmax(0,1fr);gap:0 26px;padding:26px 0;align-items:start}
body.u6 .u6-main .lrow summary::-webkit-details-marker{display:none}
body.u6 .u6-main .lrow .flatrow{display:grid;grid-template-columns:300px minmax(0,1fr);gap:0 26px;padding:26px 0;align-items:start}
body.u6 .u6-main .lr-no{position:absolute;top:8px;left:8px;z-index:1;min-width:32px;text-align:center;background:rgba(255,255,255,.95);border-radius:6px;font-family:var(--serif);font-weight:900;font-size:20px;line-height:1.4;color:var(--ink);padding:2px 8px;box-shadow:0 1px 4px rgba(10,12,16,.18)}
body.u6 .u6-main .lr-ph{position:relative;display:block}
body.u6 .u6-main .lr-ph > img,body.u6 .u6-main .lr-ph > a > img{display:block;width:300px;height:200px;object-fit:cover;border-radius:8px;background:var(--hair2)}
body.u6 .u6-main .lr-cred{position:absolute;right:6px;bottom:6px;padding:3px 6px;background:rgba(10,12,16,.55);border-radius:4px;line-height:0}
body.u6 .u6-main .lr-cred img{height:14px;max-height:14px;width:auto;display:block;object-fit:contain;aspect-ratio:auto}
body.u6 .u6-main .lr-main{display:flex;flex-direction:column;min-width:0;gap:7px}
body.u6 .u6-main .lr-hd{display:flex;justify-content:space-between;align-items:flex-start;gap:20px}
body.u6 .u6-main .lr-tt{display:flex;flex-direction:column;gap:7px;min-width:0}
body.u6 .u6-main .lr-name{margin:0;font-family:var(--serif);font-size:28px;font-weight:700;letter-spacing:-.01em;line-height:1.15;color:var(--ink)}
body.u6 .u6-main .lrow summary:hover .lr-name{color:var(--sig)}
body.u6 .u6-main .lr-name a{color:inherit;text-decoration:none}
body.u6 .u6-main .lr-meta{font-family:var(--mono);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink2)}
body.u6 .u6-main .lr-meta .onlist{color:var(--sig);font-weight:600;text-decoration:none}
body.u6 .u6-main .lr-meta .bb-pr{color:#1e8a4a;font-weight:700}
body.u6 .u6-main .lr-score{text-align:right;padding-top:2px;flex:0 0 auto}
body.u6 .u6-main .lr-score b{display:block;font-family:var(--serif);font-size:34px;font-weight:900;line-height:1}
body.u6 .u6-main .lr-hook{font-family:var(--serif);font-size:18px;line-height:1.62;color:#3a4048;margin:0}
body.u6 .u6-main .lr-order{display:flex;align-items:center;flex-wrap:wrap;gap:7px}
body.u6 .u6-main .lr-order .u-lbl{font-style:normal;font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--sig);margin-right:5px}
body.u6 .u6-main .lr-order .pl{font-size:12.5px;font-weight:600;padding:4px 11px;border-radius:100px;background:#eef1f5;color:var(--ink);white-space:nowrap}
body.u6 .u6-main .lr-cta{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
body.u6 .u6-main .lr-cta .u-btn{font-size:12.5px;padding:7px 15px}
body.u6 .u6-main .lr-cta .cred{font-size:11px;color:var(--ink2);align-self:center}
body.u6 .u6-main .lr-foot{display:flex;align-items:baseline;justify-content:flex-end;margin-top:2px}
body.u6 .u6-main .lr-addr{display:block;font-family:var(--mono);font-size:10.5px;color:var(--ink2);margin-top:2px}
body.u6 .u6-main .lr-open{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--sig);white-space:nowrap}
body.u6 .u6-main .lr-open b{display:inline-block;font-weight:600;margin-right:7px;transition:transform .25s cubic-bezier(.2,.8,.2,1)}
body.u6 .u6-main .lrow[open] .lr-open b{transform:rotate(45deg)}
body.u6 .u6-main .lrow[open] .lr-open{color:var(--ink2)}
/* the fold */
body.u6 .u6-main .lr-fold{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:0 26px;margin:0;padding:0 0 34px;animation:gfoldin .35s cubic-bezier(.2,.8,.2,1)}
@keyframes gfoldin{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
body.u6 .u6-main .lf-rail{grid-column:2;grid-row:1;display:flex;flex-direction:column;gap:16px;padding-top:18px}
body.u6 .u6-main .lf-body{grid-column:1;grid-row:1;padding-top:18px}
body.u6 .u6-main .lf-map{position:relative;display:block}
body.u6 .u6-main .lf-map img{display:block;width:100%;height:200px;object-fit:cover;border-radius:8px;background:var(--hair2)}
body.u6 .u6-main .lf-map .osm{position:absolute;right:4px;bottom:4px;font-size:9px;line-height:1;color:#3a4048;background:rgba(255,255,255,.88);padding:2px 5px;border-radius:3px;text-decoration:none}
body.u6 .u6-main .lf-rows{margin-top:0}
body.u6 .u6-main .lf-row{display:block;padding:10px 0;border-top:1px solid var(--hair)}
body.u6 .u6-main .lf-row:first-child{border-top:0;padding-top:0}
body.u6 .u6-main .lf-row i{display:block;font-style:normal;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--sig);margin-bottom:3px}
body.u6 .u6-main .lf-row b{display:block;font-size:15px;font-weight:700;line-height:1.5;color:var(--ink)}
body.u6 .u6-main .lf-row b a{color:inherit;text-decoration:none}
body.u6 .u6-main .lf-row .tiptext{font-family:var(--serif);font-size:15px;line-height:1.6;color:#3a4048;margin:0}
body.u6 .u6-main .lf-hd2{font-family:var(--serif);font-size:22px;font-weight:700;letter-spacing:-.018em;line-height:1.3;margin:0 0 10px;color:var(--ink)}
body.u6 .u6-main .lf-dishes{display:grid;grid-template-columns:1fr 1fr;gap:2px 34px;margin:14px 0 4px}
body.u6 .u6-main .lf-dishes .fd{border-top:1px solid var(--hair2);padding:9px 0 7px}
body.u6 .u6-main .lf-dishes b{font-size:14px;font-weight:700}
body.u6 .u6-main .lf-dishes p{font-family:var(--serif);font-size:14.5px;line-height:1.5;color:#4a5058;margin:2px 0 0}
body.u6 .u6-main .lf-prose{margin-top:10px}
body.u6 .u6-main .lf-prose p{font-family:var(--serif);font-size:18px;line-height:1.7;color:#3a4048;margin:0 0 14px}
body.u6 .u6-main .gmb2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:0 0 18px;border-top:1px solid var(--hair);padding-top:18px}
/* house-ad zones get the same frame as the banner pairs, and a compact
   profile on guides (Will 2026-09-06: the wide units were too tall/wide) */
body.u6 .u6-main .featwrap{border-top:0;border-bottom:1px solid var(--hair);padding:0 0 24px;margin:0 0 24px} /* Will 2026-09-21: the ad sits BETWEEN the rules (entry line, ad, line), not under two of them */
body.u6 .u6-main .featwrap .v6-feat{margin:0}
body.u6 .u6-main .featwrap .v6-feat--imgw{min-height:112px;border-radius:8px;max-width:720px;margin:0 auto}
body.u6 .u6-main .featwrap .v6-feat--imgw>a{gap:24px;align-items:center}
body.u6 .u6-main .featwrap .v6-feat--imgw .v6-feat__im{flex:0 0 200px;min-width:200px;max-width:200px;align-self:stretch}
body.u6 .u6-main .featwrap .v6-feat--imgw .v6-feat__mid{flex:1 1 auto;max-width:none;padding:18px 0;align-items:center;text-align:center}
body.u6 .u6-main .featwrap .v6-feat--imgw .v6-feat__mid b{font-size:20px;font-weight:700}
body.u6 .u6-main .featwrap .v6-feat--imgw .v6-feat__mid i{font-size:14px}
body.u6 .u6-main .featwrap .v6-feat--imgw .v6-feat__go{flex:0 0 auto;padding:0 24px 0 0}
body.u6 .u6-main .gmb{display:flex;align-items:center;gap:14px;background:#fbfbfc;border:1px solid var(--hair2);border-radius:8px;padding:10px 14px 10px 10px;text-decoration:none;color:inherit;min-width:0}
body.u6 .u6-main .gmb img{width:104px;height:70px;object-fit:cover;border-radius:6px;flex:0 0 auto;background:var(--hair2)}
body.u6 .u6-main .gmb-t{min-width:0;flex:1}
body.u6 .u6-main .gmb-t i{display:block;font-style:normal;font-family:var(--mono);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--sig);margin-bottom:4px}
body.u6 .u6-main .gmb-t b{display:block;font-family:var(--serif);font-size:15.5px;font-weight:700;letter-spacing:-.01em;line-height:1.3;color:var(--ink)}
body.u6 .u6-main .gmb:hover .gmb-t b{color:var(--sig)}
body.u6 .u6-main .gmb-t em{display:block;font-style:normal;font-size:13px;color:var(--ink2);margin-top:4px}
body.u6 .u6-main .gmb-t em .n1{color:var(--sig);font-weight:600}
body.u6 .u6-main .gtours{display:flex;align-items:baseline;gap:24px;flex-wrap:wrap;border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);padding:12px 0;margin:2px 0 8px}
body.u6 .u6-main .gtours .k{font-size:10.5px;flex:0 0 auto}
body.u6 .u6-main .gtours a{font-family:var(--sans);font-size:13.5px;font-weight:600;color:var(--ink);text-decoration:none}
body.u6 .u6-main .gtours a:hover{color:var(--sig)}
body.u6 .u6-main .gtours .arr{color:var(--sig);font-size:13px}
/* intro runs as plain full-width serif (approved 2026-09-06); the shared
   stylesheet's card box on .u-glede is overridden here */
body.u6 .u6-main .u-glede{background:transparent;border:0;box-shadow:none;border-radius:0;padding:4px 0 4px;font-size:inherit;margin-bottom:8px}
body.u6 .u6-main .u-glede p{font-family:var(--serif);font-size:18px;line-height:1.68;color:#3a4048;margin:0 0 13px}
@media (max-width:720px){
  body.u6 .u6-main .wrap{padding:2px 14px 22px;margin:10px 8px 16px;border-radius:10px}
  body.u6 .u6-main .band{padding:24px 18px}
  body.u6 .u6-main .band form{max-width:100%;justify-self:stretch}
  body.u6 .u6-main .band input{width:0;flex:1 1 auto;min-width:0}
  body.u6 .u6-main .band form .u-btn.primary{white-space:nowrap;padding:12px 16px}
  body.u6 .u6-main .ghero{grid-template-columns:1fr}
  body.u6 .u6-main .ghero .ph img{height:170px}
  body.u6 .u6-main .lrow summary,body.u6 .u6-main .lrow .flatrow{grid-template-columns:104px minmax(0,1fr);gap:0 14px;padding:18px 0}
  body.u6 .u6-main .lr-no{top:5px;left:5px;min-width:24px;border-radius:4px;font-size:13px;padding:1px 5px}
  body.u6 .u6-main .lr-ph > img,body.u6 .u6-main .lr-ph > a > img{width:104px;height:104px}
  body.u6 .u6-main .lr-cred{right:4px;bottom:4px;padding:2px 4px}
  body.u6 .u6-main .lr-hd{gap:10px}
  body.u6 .u6-main .lr-name{font-size:19px}
  body.u6 .u6-main .lr-score b{font-size:20px}
  body.u6 .u6-main .lr-hook{font-size:15.5px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  body.u6 .u6-main .lr-order .pl{font-size:11.5px;padding:3px 9px;white-space:normal}
  body.u6 .u6-main .lr-cta .u-btn{font-size:12px;padding:6px 12px}
  body.u6 .u6-main .lr-foot{justify-content:flex-start}
  body.u6 .u6-main .lr-fold{display:block;padding:0 0 18px}
  body.u6 .u6-main .lf-rail{padding-top:12px;gap:10px}
  body.u6 .u6-main .lf-map{display:none}
  body.u6 .u6-main .lf-body{padding-top:14px;border-top:0}
  body.u6 .u6-main .lf-dishes{grid-template-columns:1fr}
  body.u6 .u6-main .lf-prose p{font-size:16.5px}
  body.u6 .u6-main .u-glede{padding:12px 0 2px}
  body.u6 .u6-main .u-glede p{font-size:16px}
  body.u6 .u6-main .gmb2{grid-template-columns:1fr;gap:10px}
  body.u6 .u6-main .gmb{gap:12px;padding:8px 10px}
  body.u6 .u6-main .gmb img{width:84px;height:56px}
  body.u6 .u6-main .gmb-t b{font-size:14px}
}

/* board-only bits kept from the previous system */
body.u6 .u6-main .t50chips .lbl{color:var(--ink,#15181d)}
body.u6 .u6-main .t50chips .cnt{color:var(--ink,#15181d)}
body.u6 .u6-main .lrow.chip-hide{display:none}
body.u6 .u6-main .tmain{min-width:0}
body.u6 .u6-main .tmain .lprose{margin:2px 0 22px}
body.u6 .u6-main .lprose p{font-family:var(--serif);font-size:18px;line-height:1.68;color:#3a4048;margin:0 0 13px}
body.u6 .u6-main .lprose a{color:var(--sig);font-weight:600}
body.u6 .u6-main .faqp{background:transparent;border:0;box-shadow:none;border-radius:0;border-top:1px solid var(--hair);padding:22px 0;margin:0}
body.u6 .u6-main .faqp h2{font-family:var(--serif);font-size:26px;font-weight:700;letter-spacing:-.02em;margin:8px 0 6px}
body.u6 .u6-main .faqp .qagrid{display:grid;grid-template-columns:1fr 1fr;gap:8px 40px;align-items:start;margin-top:6px}
body.u6 .u6-main .faqp h3{font-family:"Inter",-apple-system,BlinkMacSystemFont,sans-serif;font-size:16px;font-weight:800;color:#15181d;margin-top:16px}
body.u6 .u6-main .faqp p{font-family:var(--serif);font-size:15px;line-height:1.65;color:#3a4048;margin-top:6px}
body.u6 .u6-main .faqp p a{color:var(--sig);font-weight:600}
body.u6 .u6-main .band p{font-family:var(--serif);font-size:15px}
@media (max-width:720px){
  body.u6 .u6-main .faqp .qagrid{grid-template-columns:1fr}
  body.u6 .u6-main .faqp h2{font-size:22px}
  body.u6 .u6-main .lprose p{font-size:15px}
}
