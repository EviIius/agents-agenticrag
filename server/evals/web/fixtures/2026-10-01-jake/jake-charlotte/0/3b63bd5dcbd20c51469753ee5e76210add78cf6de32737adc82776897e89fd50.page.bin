      <div class="gmb2" data-after="r28"><div class="promotion-block promotion-guide" data-recommendation="You may also like"><span class="promotion-label">You may also like</span><a class="gmb" href="https://topofcharlotte.com/best-happy-hour-charlotte/"><img src="https://topofcharlotte.com/wp-content/uploads/2026/06/best-happy-hour-charlotte-hero-300x167.webp" alt="" loading="lazy" width="104" height="70"><span class="gmb-t"><b>Best Happy Hour in Charlotte (2026)</b><em><span class="n1">&#8470; 1:</span> Midwood Smokehouse</em></span></a></div><div class="promotion-block promotion-guide" data-recommendation="You may also like"><span class="promotion-label">You may also like</span><a class="gmb" href="https://topofcharlotte.com/best-cafes-charlotte-local-favorites/"><img src="https://topofcharlotte.com/wp-content/uploads/2026/03/best-cafes-in-charlotte-6-local-favorites-2026--300x167.webp" alt="" loading="lazy" width="104" height="70"><span class="gmb-t"><b>Best Cafes in Charlotte (2026)</b><em><span class="n1">&#8470; 1:</span> Midwood Smokehouse</em></span></a></div></div>      <article class="lrow" id="r29" data-rank="29" data-hood="Charlotte" data-price="$$$" data-tags="Upscale Dining|Romantic Spot|Local Favorite">
