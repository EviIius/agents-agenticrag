<script>
(function(){
  function q(s){return document.querySelector(s);}
  // Menu dialog keyboard contract (audit 2026-09-12): focus moves into the menu on open,
  // Escape closes it, Tab stays inside it, focus returns to the opener on close.
  var opener=null;
  function openNav(btn){var m=q('.mobnav'); if(!m)return; m.classList.add('is-open');document.body.classList.add('mobnav-open');
    opener=btn||q('[data-mobnav="open"]'); if(opener)opener.setAttribute('aria-expanded','true'); m.setAttribute('aria-modal','true');
    var f=m.querySelector('.mobnav__close')||m.querySelector('a[href],button'); if(f)f.focus();}
  function closeNav(){var m=q('.mobnav'); if(!m||!m.classList.contains('is-open'))return; m.classList.remove('is-open');document.body.classList.remove('mobnav-open');
    m.removeAttribute('aria-modal'); if(opener){opener.setAttribute('aria-expanded','false'); opener.focus();}}
  document.addEventListener('keydown',function(e){var m=q('.mobnav'); if(!m||!m.classList.contains('is-open'))return;
    if(e.key==='Escape'||e.key==='Esc'){e.preventDefault();closeNav();return;}
    if(e.key==='Tab'){var f=m.querySelectorAll('a[href],button:not([disabled])'); if(!f.length)return; var a=f[0],z=f[f.length-1];
      if(e.shiftKey&&document.activeElement===a){e.preventDefault();z.focus();} else if(!e.shiftKey&&document.activeElement===z){e.preventDefault();a.focus();}}});
  document.addEventListener('click',function(e){
    var o=e.target.closest('[data-mobnav="open"]'), c=e.target.closest('[data-mobnav="close"]');
    var so=e.target.closest('[data-search="open"]'), sc=e.target.closest('[data-search="close"]');
    if(o){openNav(o);}
    if(c){closeNav();}
    if(so){var s=q('#searchbar'); if(s){s.classList.add('is-open');var i=s.querySelector('input'); if(i)i.focus();}}
    if(sc){var s=q('#searchbar'); if(s)s.classList.remove('is-open');}
  });
})();
</script>
