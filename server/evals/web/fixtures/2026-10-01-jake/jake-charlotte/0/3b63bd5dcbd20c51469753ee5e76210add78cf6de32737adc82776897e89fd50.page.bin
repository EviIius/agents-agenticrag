    <script>
    // Defer form-handler attachment off the critical path. The form is only
    // useful after user reaches the newsletter section; attaching listeners at
    // page load isn't required.
    (function() {
      var init = function() {
        document.querySelectorAll('.cbd-nl-form').forEach(function(form) {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                var email = form.querySelector('input[type="email"]').value;
                var btn = form.querySelector('button');
                var msg = form.querySelector('.cbd-nl-msg');
                btn.disabled = true;
                btn.textContent = 'Subscribing...';

                fetch('https://topofcharlotte.com/wp-admin/admin-ajax.php', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: 'action=cbd_newsletter_subscribe&email=' + encodeURIComponent(email)
                })
                .then(function(r) { return r.json(); })
                .then(function(d) {
                    if (msg) {
                        msg.textContent = d.data;
                        msg.style.color = d.success ? '#4CAF50' : '#F44336';
                    }
                    if (d.success) {
                        localStorage.setItem('cbd_nl_subscribed', '1');
                        // Transform into success state
                        var wrapper = form.closest('.cbd-inline-cta, #cbd-exit-modal .cbd-exit-content, #cbd-slideup .cbd-slideup-card') || form.parentNode;
                        var hideEls = wrapper.querySelectorAll('form, .cbd-nl-msg, h3, .cbd-exit-icon, .cbd-exit-title, .cbd-exit-sub, .cbd-exit-note, .cbd-slideup-title, .cbd-slideup-sub, .cbd-inline-cta-title, .cbd-inline-cta-sub, p:not(.cbd-nl-success p)');
                        hideEls.forEach(function(el) { el.style.display = 'none'; });
                        var successDiv = document.createElement('div');
                        successDiv.className = 'cbd-nl-success';
                        successDiv.innerHTML = '<div class="cbd-nl-success-check"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#000" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></div><h4>You\'re in!</h4><p>Check your email for your welcome guide with our top Charlotte picks.</p>';
                        wrapper.appendChild(successDiv);
                        // Auto-dismiss popups after 3.5s
                        var popup = form.closest('#cbd-exit-modal, #cbd-slideup');
                        if (popup) {
                            setTimeout(function() {
                                popup.style.display = 'none';
                                document.body.style.overflow = '';
                            }, 3500);
                        }
                    } else {
                        btn.disabled = false;
                        btn.textContent = 'Subscribe';
                    }
                })
                .catch(function() {
                    btn.disabled = false;
                    btn.textContent = 'Subscribe';
                });
            });
        });
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(init, { timeout: 3000 });
      } else if (document.readyState !== 'loading') {
        setTimeout(init, 800);
      } else {
        document.addEventListener('DOMContentLoaded', function() { setTimeout(init, 800); });
      }
    })();
    </script>
    
