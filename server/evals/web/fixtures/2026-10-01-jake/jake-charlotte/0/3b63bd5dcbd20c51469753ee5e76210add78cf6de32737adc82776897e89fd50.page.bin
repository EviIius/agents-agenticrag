        <div class="lr-main">
          <div class="lr-hd">
            <div class="lr-tt">
              <h3 class="lr-name">New Zealand Cafe</h3>
              <span class="lr-meta">Sushi &middot; Charlotte &middot; <span class="bb-pr">$$</span></span>
