144px;\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/a\u003e\u003cp style=\" color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; line-height:17px; margin-bottom:0; margin-top:8px; overflow:hidden; padding:8px 0 7px; text-align:center; text-overflow:ellipsis; white-space:nowrap;\"\u003e\u003ca href=\"https://www.instagram.com/p/DKHwVvixFxu/?utm_source=ig_embed\u0026utm_campaign=loading\" style=\" color:#c9c8cd; font-family:Arial,sans-serif; font-size:14px; font-style:normal; font-weight:normal; line-height:17px; text-decoration:none;\" target=\"_blank\"\u003eA post shared by Clark’s SNACK BAR | A-OK (@clarkssnackbar_clt)\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/blockquote\u003e\n\u003cscript async src=\"https://www.instagram.com/embed.js\"\u003e\u003c/script\u003e"},"location":{"latitude":35.218212,"longitude":-80.79405},"name":"Clark’s Snack Bar","phone":"+19802071168","url":"https://clarkssnackbar.com/","venue":{"id":"ZXQyOnZlbnVlOjg3Nzg1MA==","globalId":"ZXQyOnZlbnVlOjg3Nzg1MA","slug":"clark-s-snack-bar","title":"Clark’s Snack Bar","address":"3001 Central Avenue, Charlotte, North Carolina 28205","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"1440 South Tryon Street, STE 100, Charlotte, North Carolina 28203, United States","description":[{"html":"New in the heart of South End is a colorful, bright, Mexican and Latin-American gastro-cantina and mezcalería. Sit at the gorgeous backlit bar where you can sip from more than 200 of Beverage Director Henry Schmulling’s agave-based spirits, or in a comfy caramel-colored dining booth where you’re transported to a scene from \u003cem\u003ethe Endless Summer\u003c/em\u003e. Chef Hector Gonzalez-Mora has created a diverse, playful menu with generous portions: try the Taco Royale with ribeye steak and sourdough tortilla or the Taco Vaqueiro with bacon-wrapped banana pepper (both $14), the truffle corn dip with crackers you wish you had a bag of, and the satisfying hamachi tostada with avocado. For mains, a 14-ounce Akaushi wagyu ribeye ($78) can be the turf while the Camarones Kora, seared jumbo shrimp in butter sauce, can be the surf ($40). Leave room for a splendid, lightly sweet popcorn flan topped with cream and crunchy sorghum bits.","plaintext":"New in the heart of South End is a colorful, bright, Mexican and Latin-American gastro-cantina and mezcalería. Sit at the gorgeous backlit bar where you can sip from more than 200 of Beverage Director Henry Schmulling’s agave-based spirits, or in a comfy caramel-colored dining booth where you’re transported to a scene from the Endless Summer. Chef Hector Gonzalez-Mora has created a diverse, playful menu with generous portions: try the Taco Royale with ribeye steak and sourdough tortilla or the Taco Vaqueiro with bacon-wrapped banana pepper (both $14), the truffle corn dip with crackers you wish you had a bag of, and the satisfying hamachi tostada with avocado. For mains, a 14-ounce Akaushi wagyu ribeye ($78) can be the turf while the Camarones Kora, seared jumbo shrimp in butter sauce, can be the surf ($40). Leave room for a splendid, lightly sweet popcorn flan topped with cream and crunchy sorghum bits."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaImageType","caption":{"html":"","plaintext":""},"credit":{"plaintext":"","html":""},"hideCredit":false,"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"},"vertical":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=23.331899795721,0,53.336200408558,100"}},"title":"The Story of “Mi Cariño”","credit":{"plaintext":"Rico Marcelo","html":"Rico Marcelo"},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"location":{"latitude":35.216527,"longitude":-80.85646},"name":"The Story of “Mi Cariño”","phone":"(704) 703-6679","url":"https://www.micarinoclt.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5Mzk5MTU=","globalId":"ZXQxMTp2ZW51ZTo5Mzk5MTU","slug":"the-story-of-mi-carino","title":"The Story of “Mi Cariño”","address":"1440 South Tryon Street, STE 100, Charlotte, North Carolina 28203, United States","ledeMedia":{"__typename":"LedeMediaImageType"},"sevenrooms":null,"safegraph":{"bookingLink":"https://reservations.safegraph.com/reserve/242931?utm_source=safegraph\u0026utm_campaign=poi"},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"131 East Park Avenue, Charlotte, North Carolina 28203","description":[{"html":"From the team behind cult favorite Yunta comes La Lima Sanguecheria, a fast-casual Peruvian sandwich joint that is consistently packed from opening to close. Here, get fresh takes on Peruvian street fare, like the Tori Nikkei, a tamari honey chicken sandwich with daikon slaw, the Italo pastrami and crunchy focaccia, or the Sakura tuna tartare sandwich in between two pillowy pieces of Barcelona’s pan de cristal. Protein lovers can opt for the Tusan bowl, which is packed with steak, fried egg, and avocado.","plaintext":"From the team behind cult favorite Yunta comes La Lima Sanguecheria, a fast-casual Peruvian sandwich joint that is consistently packed from opening to close. Here, get fresh takes on Peruvian street fare, like the Tori Nikkei, a tamari honey chicken sandwich with daikon slaw, the Italo pastrami and crunchy focaccia, or the Sakura tuna tartare sandwich in between two pillowy pieces of Barcelona’s pan de cristal. Protein lovers can opt for the Tusan bowl, which is packed with steak, fried egg, and avocado."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":null,"location":{"latitude":35.214469,"longitude":-80.856686},"name":"La Lima","phone":"+17049005265","url":"https://www.instagram.com/lalimasangucheria/","venue":{"id":"ZXQyOnZlbnVlOjg3Nzg1MQ==","globalId":"ZXQyOnZlbnVlOjg3Nzg1MQ","slug":"la-lima","title":"La Lima","address":"131 East Park Avenue, Charlotte, North Carolina 28203","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"1829 Cleveland Avenue, Charlotte, North Carolina 28203","description":[{"html":"After over three years in the making and chronicled in the new PBS reality show “Fork \u0026 Hammer,” Leluia Hall finally opened its doors in May. Jamie Brown and Jeff Tonidandel have given Charlotte a classy, coastal steak-and-surf restaurant. Each design detail — mostly grand and curved Art Nouveau style — reflects a rich history of this historic building, a church that dates back to 1914. Don’t miss the raw bar and the lobster mousse fish sticks from the seaside of the menu. On the steak side, have fun with the toppers, from au poivre to nduja butter. Then, for the final act, get chef Savannah Foltz’s Basque cheesecake.","plaintext":"After over three years in the making and chronicled in the new PBS reality show “Fork \u0026 Hammer,” Leluia Hall finally opened its doors in May. Jamie Brown and Jeff Tonidandel have given Charlotte a classy, coastal steak-and-surf restaurant. Each design detail — mostly grand and curved Art Nouveau style — reflects a rich history of this historic building, a church that dates back to 1914. Don’t miss the raw bar and the lobster mousse fish sticks from the seaside of the menu. On the steak side, have fun with the toppers, from au poivre to nduja butter. Then, for the final act, get chef Savannah Foltz’s Basque cheesecake."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaEmbedType","provider":"instagram","embedHtml":"\u003cblockquote class=\"instagram-media\" data-instgrm-captioned data-instgrm-permalink=\"https://www.instagram.com/p/DKcweNRJJod/?utm_source=ig_embed\u0026utm_campaign=loading\" data-instgrm-version=\"14\" style=\" background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:658px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);\"\u003e\u003cdiv style=\"padding:16px;\"\u003e \u003ca href=\"https://www.instagram.com/p/DKcweNRJJod/?utm_source=ig_embed\u0026utm_campaign=loading\" style=\" background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;\" target=\"_blank\"\u003e \u003cdiv style=\" display: flex; flex-direction: row; align-items: center;\"\u003e \u003cdiv style=\"background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;\"\u003e\u003c/div\u003e \u003cdiv style=\"display: flex; flex-direction: column; flex-grow: 1; justify-content: center;\"\u003e \u003cdiv style=\" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 100px;\"\u003e\u003c/div\u003e \u003cdiv style=\" background-color: #F4F4F4; border-radi