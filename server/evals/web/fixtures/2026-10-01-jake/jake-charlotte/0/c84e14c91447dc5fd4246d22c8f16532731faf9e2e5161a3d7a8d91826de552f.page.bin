t:17px; text-decoration:none;\" target=\"_blank\"\u003eA post shared by Painted Rooster (@bigpaintedrooster)\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/blockquote\u003e\n\u003cscript async src=\"https://www.instagram.com/embed.js\"\u003e\u003c/script\u003e"},"location":{"latitude":35.220578,"longitude":-80.81184},"name":"Painted Rooster","phone":"(704) 332-3663","url":"https://bigpaintedrooster.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5MTg2OTY=","globalId":"ZXQxMTp2ZW51ZTo5MTg2OTY","slug":"painted-rooster","title":"Painted Rooster","address":"1601 Central Avenue, Charlotte, North Carolina 28205, United States","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"3001 Central Avenue, Charlotte, North Carolina 28205","description":[{"html":"Clark’s Snack Bar\u003cstrong\u003e","plaintext":"Clark’s Snack Bar"},{"html":"\u003c/strong\u003eWieners, burgers, and sandwiches are so back — at least at Clark’s Snack Bar, and a lot of hungry Charlotteans think so, too. This red, blue, and retro cavern churns out kraut-ey kielbasas, pastrami on a plump housemate kaiser roll, and BECs (bacon, egg, and cheeses) on a steamy Montreal-style bagel. Layers of griddled onions and pickled veg pile high on the sandwiches, and it’s so Northeast. Here, play some darts while listening to the Grateful Dead-adjacent music setting the mood.","plaintext":"Wieners, burgers, and sandwiches are so back — at least at Clark’s Snack Bar, and a lot of hungry Charlotteans think so, too. This red, blue, and retro cavern churns out kraut-ey kielbasas, pastrami on a plump housemate kaiser roll, and BECs (bacon, egg, and cheeses) on a steamy Montreal-style bagel. Layers of griddled onions and pickled veg pile high on the sandwiches, and it’s so Northeast. Here, play some darts while listening to the Grateful Dead-adjacent music setting the mood."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaEmbedType","provider":"instagram","embedHtml":"\u003cblockquote class=\"instagram-media\" data-instgrm-captioned data-instgrm-permalink=\"https://www.instagram.com/p/DKHwVvixFxu/?utm_source=ig_embed\u0026utm_campaign=loading\" data-instgrm-version=\"14\" style=\" background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:658px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);\"\u003e\u003cdiv style=\"padding:16px;\"\u003e \u003ca href=\"https://www.instagram.com/p/DKHwVvixFxu/?utm_source=ig_embed\u0026utm_campaign=loading\" style=\" background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;\" target=\"_blank\"\u003e \u003cdiv style=\" display: flex; flex-direction: row; align-items: center;\"\u003e \u003cdiv style=\"background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;\"\u003e\u003c/div\u003e \u003cdiv style=\"display: flex; fle