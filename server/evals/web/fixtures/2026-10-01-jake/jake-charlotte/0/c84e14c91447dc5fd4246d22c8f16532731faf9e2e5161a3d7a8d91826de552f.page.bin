,100,100"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/08/gettyimages-2214357139.jpg?quality=90\u0026strip=all\u0026crop=16.666666666667,0,66.666666666667,100"}},"id":"ZXQxMTppbWFnZTo0NDkwMQ=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"NewsletterBlockType"}],"customBadgeEnabled":false,"customBadgeName":"","template":null}]},"id":"ZXQxMTpjYXRlZ29yeTozMzg="}},"errors":[]},{"operationName":"MapLayoutQuery","variables":{"nodeId":"ZXQxMTptYXA6MjY1MTg="},"data":{"node":{"__typename":"MapResourceType","title":"17 Best New Restaurants in Charlotte Right Now","wpId":26518,"chorusId":20930015,"globalId":"ZXQxMTptYXA6MjY1MTg","authors":[{"id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","name":"Shindy Chen","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}],"profileImage":null,"title":"","posts":{"edges":[{"node":{"__typename":"MapResourceType","publishedAt":"2026-02-23T14:57:35+00:00","id":"ZXQxMTptYXA6MjQwNDU="}}]}},{"id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","name":"Kayleigh Ruller","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}],"profileImage":null,"title":"Freelance Writer","posts":{"edges":[{"node":{"__typename":"MapResourceType","publishedAt":"2026-02-23T14:57:35+00:00","id":"ZXQxMTptYXA6MjQwNDU="}}]}}],"primaryCampaign":null,"mapPoints":[{"address":"20822 North Main Street, Cornelius, North Carolina 28031","description":[{"html":"Open since March 2025, Seaboy is chef Jonny Cox’s first solo endeavor as a chef and owner, and has Charlotteans driving north to the Lake Norman area to sample his seafood menu. This, especially after appearing on \u003ca href=\"https://www.esquire.com/food-drink/restaurants/a69501755/best-new-restaurants-america-2025/\"\u003eEsquire Magazine\u003c/a\u003e’s list for 33 “Best New Restaurants in America.” Inside the standalone cottage, the decor is whimsical: think coastal grandma meets modern roadside shack, with a 10-table back dining room, and a lively front bar area which seats 12, including four chef’s counter seats and nine more patio tables coming in warmer months, and all offering the full menu. For the table, start with daily oysters with homemade hot sauce and mignonettes, the generous yellowfin crudo with bright benne seeds, and perfectly round, piping hot crab and chorizo croquettes. Follow with a beautifully plated, soul-warming sablefish or a surprising, lamb pappardelle ragu, which is homey and hearty.","plaintext":"Open since March 2025, Seaboy is chef Jonny Cox’s first solo endeavor as a chef and owner, and has Charlotteans driving north to the Lake Norman area to sample his seafood menu. This, especially after appearing on Esquire Magazine’s list for 33 “Best New Restaurants in America.” Inside the standalone cottage, the decor is whimsical: think coastal grandma meets modern roadside shack, with a 10-table back dining room, and a lively front bar area which seats 12, including four chef’s counter seats and nine more patio tables coming in warmer months, and all offering the full menu. For the table, start with daily oysters with homemade hot sauce and mignonettes, the generous yellowfin crudo with bright benne seeds, and perfectly round, piping hot crab and chorizo croquettes. Follow with a beautifully plated, soul-warming sablefish or a surprising, lamb pappardelle ragu, which is homey and hearty."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":null,"location":{"latitude":35.491561,"longitude":-80.857228},"name":"Seaboy","phone":"(980) 728-1069","url":"https://www.seaboyrestaurant.com/","venue":{"id":"ZXQyOnZlbnVlOjQzOTk5Nw==","globalId":"ZXQyOnZlbnVlOjQzOTk5Nw","slug":"seaboy","title":"Seaboy","address":"20822 North Main Street, Cornelius, North Carolina 28031","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":"https://reservations.safegraph.com/reserve/235298?utm_source=safegraph\u0026utm_campaign=poi"},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"440 McCullough Dr, Charlotte, NC, 28262, US","description":[{"html":"Finally, a place to take a date for coffee and a delicious sweet treat \u003cem\u003eafter\u003c/em\u003e dinner or into the night (it’s open ‘til midnight or 1 a.m. on weekends). This massive (4,500 square feet to be exact), locally-owned coffee shop in the university area opened in February and offers Turkish coffee, among other juice refreshers and American-style flavored frappuccinos and lattes, as well as Arabian or Moroccan mint tea. Also on the menu are paninis and salads, but the true draw, according to the bustling and regularly crowded house, is the dazzling dessert case, with a variety of cheesecakes, cakes, pistachio kunafa, or Dubai chocolate-inspired sweets and cakes. Order at the counter and then nestle into a corner booth or the center Turkish-style seating nook with drapes and pillows.","plaintext":"Finally, a place to take a date for coffee and a delicious sweet treat after dinner or into the night (it’s open ‘til midnight or 1 a.m. on weekends). This massive (4,500 square feet to be exact), locally-owned coffee shop in the university area opened in February and offers Turkish coffee, among other juice refreshers and American-style flavored frappuccinos and lattes, as well as Arabian or Moroccan mint tea. Also on the menu are paninis and salads, but the true draw, according to the bustling and regularly crowded house, is the dazzling dessert case, with a variety of cheesecakes, cakes, pistachio kunafa, or Dubai chocolate-inspired sweets and cakes. Order at the counter and then nestle into a corner booth or the center Turkish-style seating nook with drapes and pillows."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaImageType","caption":{"html":"","plaintext":""},"credit":{"plaintext":"","html":""},"hideCredit":false,"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/08/476484200_122096315558767110_2258668612190239241_n.jpg?quality=90\u0026strip=all\u0026crop=0.01220703125,0,99.9755859375,100"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/08/476484200_122096315558767110_2258668612190239241_n.jpg?quality=90\u0026strip=all\u0026crop=16.6748046875,0,66.650390625,100"},"vertical":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/08/476484200_122096315558767110_2258668612190239241_n.jpg?quality=90\u0026strip=all\u0026crop=23.33984375,0,53.3203125,100"}},"title":"476484200_122096315558767110_2258668612190239241_n","credit":{"plaintext":"Vavela Cafe","html":"Vavela Cafe"},"id":"ZXQxMTppbWFnZTo0NTI3MA=="}},"location":{"latitude":35.302125,"longitude":-80.747768},"name":"Vavela Cafe","phone":"+17048179208","url":"https://vavela.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5MTg2OTI=","globalId":"ZXQxMTp2ZW51ZTo5MTg2OTI","slug":"vavela-cafe","title":"Vavela Cafe","address":"440 McCullough Dr, Charlotte, NC, 28262, US","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"3112 North Davidson Street, Charlotte, North Carolina 28205, United States","description":[{"html":"Apparently, Charlotte needed another bar — not a brewery, or a sceney cocktail joint, but an Irish pub. McHale’s, once in Fort Mill and Rock Hill, snagged the coveted space on North Davidson, and locals are flocking to it for the quaint snugs and the bona fide bar with Smithwicks, Guinness, and Harp. The outdoor beer garden fills up quickly, so go early and get the corned beef hash, ample fish and chips, Irish curry, or classic Irish breakfast.","plaintext":"Apparently, Charlotte needed another bar — not a brewery, or a sceney cocktail joint, but an Irish pub. McHale’s, once in Fort Mill and Rock Hill, snagged the coveted space on North Davidson, and locals are flocking to it for the quaint snugs and the bona fide bar with Smithwicks, Guinness, and Harp. The outdoor beer garden fills up quickly, so go early and get the corned beef hash, ample fish and chips, Irish curry, or classic Irish breakfast."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":null,"location":{"latitude":35.246699,"longitude":-80.806107},"name":"McHale’s Pub","phone":"(980) 207-3993","url":"https://mchalespubnoda.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5MDY3OTE=","globalId":"ZXQxMTp2ZW51ZTo5MDY3OTE","slug":"mchales-pub","title":"McHale’s Pub","address":"3112 North Davidson Street, Charlotte, North Carolina 28205, United States","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"301 Camp Road, Charlotte, North Carolina 28206, United States","description":[{"html":"Part essentials market, part sandwich joint, this Camp North End cornershop has quickly installed itself among the best of Charlotte sandwich lore. The menu consists of three double-smashed burgers and three chicken sandwiches, to be doused with your creamy smack sauce or kicky mambo sauce. The “honey butta” chicken sandwich features a crispy on the outside and juicy and tender on the inside heaping fried chicken portion that dwarfs the bun. The slaw and pickles crunch while the slather of honey butter smooths and brightens the bite.","plaintext":"Part essentials market, part sandwich joint, this Camp North End cornershop has quickly installed itself among the best of Charlotte sandwich lore. The menu consists of three double-smashed burgers and three chicken sandwiches, to be doused with your creamy smack sauce or kicky mambo sauce. The “honey butta” chicken sandwich features a crispy on the outside and juicy and tender on the inside heaping fried chicken portion that dwarfs the bun. The slaw and pickles crunch while the slather of honey butter smooths and brightens the bite."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaEmbedType","provider":"instagram","embedHtml":"\u003cblockquote class=\"instagram-media\" data-instgrm-captioned data-instgrm-permalink=\"https://www.instagram.com/p/DJrhnnexyK3/?utm_source=ig_embed\u0026utm_campaign=loading\" data-instgrm-version=\"14\" style=\" background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:658px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);\"\u003e\u003cdiv style=\"padding:16px;\"\u003e \u003ca href=\"https://www.i