.994624522926&amp;w=1920 1920w, https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90&amp;strip=all&amp;crop=0%2C0.0026877385367925%2C100%2C99.994624522926&amp;w=2048 2048w, https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90&amp;strip=all&amp;crop=0%2C0.0026877385367925%2C100%2C99.994624522926&amp;w=2400 2400w" src="https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90&amp;strip=all&amp;crop=0%2C0.0026877385367925%2C100%2C99.994624522926&amp;w=2400"/></div></div><div class="duet--media--caption _1l5wi2a1 _1l5wi2a0"><cite class="duet--article--dangerously-set-cms-markup e8cira2 _1l5wi2a6 _1l5wi2a5">Rico Marcelo</cite></div></div></div></div></div></div><div><div class="duet--article--map-card hkfm3h0" data-slug="la-lima" id="la-lima"><div class="hkfm3h2"></div><div class="hkfm3h3"><h2 class="hkfm3h5">La Lima</h2><span class="hkfm3h6"><button type="button" class="_6ylzph0" aria-label="Save to a list"><svg width="24" height="24" viewBox="2 2 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7.2002 20.3202L12.4176 15.0407L17.6349 20.3202V8.24064C17.6349 5.67699 15.43 3.6001 12.7113 3.6001H7.2002V20.3202Z" fill="none" stroke="currentColor" stroke-width="1.7"></path></svg></button></span></div><p class="duet--article--dangerously-set-cms-markup duet--article--standard-paragraph u67w0ti va4xi81 va4xi80 e8cira1 hkfm3h9">From the team behind cult favorite Yunta comes La Lima Sanguecheria, a fast-casual Peruvian sandwich joint that is consistently packed from opening to close. Here, get fresh takes on Peruvian street fare, like the Tori Nikkei, a tamari honey chicken sandwich with daikon slaw, the Italo pastrami and crunchy focaccia, or the Sakura tuna tartare sandwich in between two pillowy pieces of Barcelona’s pan de cristal. Protein lovers can opt for the Tusan bowl, which is packed with steak, fried egg, and avocado.</p><div class="iyvbja0"><button type="button" class="iyvbja1" aria-pressed="false"><svg width="12" height="10" viewBox="0 0 12 10" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M11.2226 0.779264C10.1836 -0.259755 8.49832 -0.259755 7.4593 0.779264L6.00095 2.23761L4.5426 0.779264C3.50359 -0.259755 1.81828 -0.259755 0.779264 0.779264C-0.259755 1.81828 -0.259755 3.50359 0.779264 4.5426L6.00007 9.76341L11.2209 4.5426C12.2599 3.50359 12.2599 1.81828 11.2209 0.779264H11.2226Z"></path></svg>Loved it</button><button type="button" class="iyvbja1" aria-pressed="false"><svg width="12" height="10" viewBox="0 0 12 10" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M11.9998 1.90244L10.0973 0L3.91706 6.17935L1.90244 4.16474L0 6.06808L3.91706 9.98514L11.9998 1.90244Z"></path></svg>Want to try</button></div><ul class="hkfm3hb"><li class="hkfm3hd hkfm3hc"><a class="_1win6by0" target="_blank" href="https://lyft.sng.link/Ednq0/5pb9?_dl=lyft%3A%2F%2Fbook-a-ride%3Fdestination%5Baddress%5D%3D131+East+Park+Avenue%2C+Charlotte%2C+North+Carolina+28203&amp;utm_source=eater&amp;utm_medium=eaterapp&amp;utm_campaign=CheckLyft2026_Eater_Awareness_CLT_VenueDestination&amp;utm_term=CheckLyft2026_Eater_Awareness_CLT_VenueDestination&amp;utm_content=CheckLyft2026_Eater_Awareness_CLT_VenueDestination_Static&amp;_smtype=3" rel="noreferrer nofollow"><img class="_1win6by1" src="/static-assets/icons/lyft.png" alt="" aria-hidden="true" width="17" height="12"/>Get there with Lyft<svg class="_1win6by2" width="12" height="12" viewBox="0 0 12 12" fill="currentColor" xmlns="http://www.w3.org/2000/svg" tabindex="-1" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M8.85017 5.58349L5.68241 2.38336L6.25987 1.79999L10.5 6.05807L6.39998 10.2L5.82251 9.61662L8.99818 6.40849L1.5 6.40849V5.58349L8.85017 5.58349Z"></path></svg></a></li><li><a class="hkfm3he" target="_blank" href="https://www.google.com/maps/search/?api=1&amp;query=La%20Lima%2C%20131%20East%20Park%20Avenue%2C%20Charlotte%2C%20North%20Carolina%2028203" rel="noreferrer nofollow"><svg xmlns="http://www.w3.org/2000/svg" class="hkfm3hf" width="20" height="20" viewBox="0 0 20 20" fill="none"><title>Location</title><path fill="inherit" fill-rule="evenodd" d="M9.147 2.071c-2.526.445-4.383 2.97-4.123 5.607.205 2.075 1.774 5.166 4.344 8.555.32.422.604.767.632.767.061 0 1.052-1.295 1.626-2.126 1.997-2.89 3.175-5.42 3.35-7.196.197-1.993-.843-4.033-2.57-5.041-.942-.55-2.155-.76-3.26-.566Zm1.516 2.87c1.36.443 2.02 2.036 1.394 3.367-.39.833-1.155 1.325-2.057 1.325-1.152 0-2.08-.826-2.268-2.021-.272-1.719 1.342-3.19 2.93-2.671Z" clip-rule="evenodd"></path></svg><div><span class="hkfm3hh">131 East Park Avenue, Charlotte, North Carolina 28203</span><svg class="hkfm3hi" width="18" height="18" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg"><title>External Link</title><path fill-rule="evenodd" clip-rule="evenodd" d="M6.8999 0.400024H10.8999V4.40002H9.8999V2.10713L4.8999 7.10713L4.1928 6.40002L9.1928 1.40002H6.8999V0.400024ZM2.3999 2.90002C2.12604 2.90002 1.8999 3.12617 1.8999 3.40002V8.90002C1.8999 9.03263 1.95258 9.15981 2.04635 9.25358C2.14012 9.34735 2.26729 9.40002 2.3999 9.40002H7.8999C8.03251 9.40002 8.15969 9.34735 8.25346 9.25358C8.34722 9.15981 8.3999 9.03263 8.3999 8.90002V5.90002H9.3999V8.90002C9.3999 9.29785 9.24187 9.67938 8.96056 9.96068C8.67926 10.242 8.29773 10.4 7.8999 10.4H2.3999C2.00208 10.4 1.62055 10.242 1.33924 9.96068C1.05794 9.67938 0.899902 9.29785 0.899902 8.90002V3.40002C0.899902 2.57388 1.57376 1.90002 2.3999 1.90002H5.3999V2.90002H2.3999Z" fill=""></path></svg></div></a></li><li><a class="hkfm3he" href="tel:17049005265"><svg xmlns="http://www.w3.org/2000/svg" class="hkfm3hf" width="20" height="20" viewBox="0 0 20 20" fill="none"><title>Phone</title><path fill="inherit" fill-rule="evenodd" d="M8.09 5.44c.435.373.435 1.056 0 1.49L6.909 8.172c.807 1.8 2.61 3.601 4.413 