9c8cd; font-family:Arial,sans-serif; font-size:14px; font-style:normal; font-weight:normal; line-height:17px; text-decoration:none;\" target=\"_blank\"\u003eA post shared by ESO Artisanal Pasta (@esopastaclt)\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003c/blockquote\u003e\n\u003cscript async src=\"https://www.instagram.com/embed.js\"\u003e\u003c/script\u003e"},"location":{"latitude":35.234311,"longitude":-80.827578},"name":"Eso Artisanal Pasta","phone":"(980) 517-0230","url":"https://www.esoartisanalpasta.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5MTg2NTA=","globalId":"ZXQxMTp2ZW51ZTo5MTg2NTA","slug":"eso-artisanal-pasta","title":"Eso Artisanal Pasta","address":"1115 North Brevard Street, STE D, Charlotte, North Carolina 28206, United States","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"224 West 10th Street, Charlotte, North Carolina 28202, United States","description":[{"html":"Mixologist Amanda Britton and chef Kendall Moore are the dynamic duo running Spaghett, an Italian restaurant in Uptown’s Fourth Ward. Setting up in a historic 19th-century home, the spirited ambiance and decor are standouts — think moss green walls adorned with Campari art from local North Carolina artists. While a cozier front dining room with an ornate fireplace feels perfect for intimate, private conversations, a neon-lit dining area toward the back feels right for convivial, louder conversations. Ask the server what is the freshest that day — be it a crisp salad of hyper-local produce, or one of Moore’s delightful, satisfying handmade pastas cooked perfectly al dente. A three-course prix fixe menu is an excellent value at $60.","plaintext":"Mixologist Amanda Britton and chef Kendall Moore are the dynamic duo running Spaghett, an Italian restaurant in Uptown’s Fourth Ward. Setting up in a historic 19th-century home, the spirited ambiance and decor are standouts — think moss green walls adorned with Campari art from local North Carolina artists. While a cozier front dining room with an ornate fireplace feels perfect for intimate, private conversations, a neon-lit dining area toward the back feels right for convivial, louder conversations. Ask the server what is the freshest that day — be it a crisp salad of hyper-local produce, or one of Moore’s delightful, satisfying handmade pastas cooked perfectly al dente. A three-course prix fixe menu is an excellent value at $60."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaImageType","caption":{"html":"","plaintext":""},"credit":{"plaintext":"","html":""},"hideCredit":false,"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/06/Potato-Scarpinocc_Credit_Karmataun-Productions.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/06/Potato-Scarpinocc_Credit_Karmataun-Productions.jpg?quality=90\u0026strip=all\u0026crop=16.666666666667,0,66.666666666667,100"},"vertical":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/06/Potato-Scarpinocc_Credit_Karmataun-Productions.jpg?quality=90\u0026strip=all\u0026crop=23.333333333333,0,53.333333333333,100"}},"title":"Potato Scarpinocc_Credit_Karmataun Productions","credit":{"plaintext":"Karmataun Productions","html":"Karmataun Productions"},"id":"ZXQxMTppbWFnZTo0NDgyNw=="}},"location":{"latitude":35.23364,"longitude":-80.838108},"name":"Spaghett","phone":"+19802021088","url":"https://www.restaurantspaghett.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5MDY3ODc=","globalId":"ZXQxMTp2ZW51ZTo5MDY3ODc","slug":"spaghett","title":"Spaghett","address":"224 West 10th Street, Charlotte, North Carolina 28202, United States","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":"https://reservations.safegraph.com/reserve/239750?utm_source=safegraph\u0026utm_campaign=poi"},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]},{"__typename":"DiningReportResourceType","id":"ZXQxMTpkaW5pbmdSZXBvcnQ6NDU0MDU=","__isFeedContentResourceInterface":"DiningReportResourceType","wpId":45405,"globalId":"ZXQxMTpkaW5pbmdSZXBvcnQ6NDU0MDU","chorusId":null,"chorusUuid":null,"resourceType":"diningReport","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"﻿Chef Kendall Moore makes primi and pasta with seasonal North Carolina ingredients"},"permalink":"https://carolinas.eater.com/dining-report/45405/charlotte-spaghett-review","title":"Charlotte’s Spaghett Offers Italian Comfort in a Quaint Historic Home","publishedAt":"2025-11-07T16:10:29+00:00","authors":[{"name":"Erin Perkins","path":"/authors/erin-perkins","id":"ZXQxMTphdXRob3JQcm9maWxlOjU1NzI2MQ==","permalink":"https://www.eater.com/authors/erin-perkins","shortBio":[{"html":"is a former editor of Eater’s South region, covering Atlanta, Nashville, Miami, New Orleans, and the Carolinas. She has been writing about the food scene in the Carolinas and Savannah for 12 years. Erin has resided in Charleston, South Carolina, for the past 20 years."}]}],"primaryCategory":{"title":"Dining Reports","id":"ZXQxMTpjYXRlZ29yeToxNzU5"},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"},{"id":"ZXQxMTpjYXRlZ29yeToxNzU5","title":"Dining Reports","slug":"dining-report"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"Charlotte’s Spaghett Offers Italian Comfort in a Quaint Historic Home","description":{"html":"﻿Chef Kendall Moore makes primi and pasta with seasonal North Carolina ingredients"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/11/Spaghette.jpg?quality=90\u0026strip=all\u0026crop=2.8852152214598,0,94.22956955708,100"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/11/Spaghette.jpg?quality=90\u0026strip=all\u0026crop=18.590143480973,0,62.819713038054,100"}},"id":"ZXQxMTppbWFnZTo0NTQwNg=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/11/Spaghette.jpg?quality=90\u0026strip=all\u0026crop=2.8852152214598,0,94.22956955708,100"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/11/Spaghette.jpg?quality=90\u0026strip=all\u0026crop=18.590143480973,0,62.819713038054,100"}},"id":"ZXQxMTppbWFnZTo0NTQwNg=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreHeadingBlockType"},{"__typename":"CoreListBlockType"},{"__typename":"CoreHeadingBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreHeadingBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"NewsletterBlockType"}],"template":null}]}}},{"address":"1601 Central Avenue, Charlotte, North Carolina 28205, United States","description":[{"html":"A new addition from Moo \u0026 Brew owners in Plaza Midwood, and snugly situated across from Snug Harbor (though you can’t miss artist Matt Moore’s massive rainbow-colored rooster out front), the Painted Rooster’s go-to items are its crisped, flame-charred wings and Southern comfort foods that pair with an ample but unpretentious beer menu. Go for the Rooster signature wings or choose from more than 15 sauces (like honey lime Sriracha, Cheerwine barbecue, or ginger garlic soy) or six dry rubs (like lemon pepper or Moroccan), or a “Handheld Hootenanny BBQ” or Buffalo chicken wrap, one of many mac ‘n’ cheese options, or build your own salad.","plaintext":"A new addition from Moo \u0026 Brew owners in Plaza Midwood, and snugly situated across from Snug Harbor (though you can’t miss artist Matt Moore’s massive rainbow-colored rooster out front), the Painted Rooster’s go-to items are its crisped, flame-charred wings and Southern comfort foods that pair with an ample but unpretentious beer menu. Go for the Rooster signature wings or choose from more than 15 sauces (like honey lime Sriracha, Cheerwine barbecue, or ginger garlic soy) or six dry rubs (like lemon pepper or Moroccan), or a “Handheld Hootenanny BBQ” or Buffalo chicken wrap, one of many mac ‘n’ cheese options, or build your own salad."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaEmbedType","provider":"instagram","embedHtml":"\u003cblockquote class=\"instagram-media\" data-instgrm-captioned data-instgrm-permalink=\"https://www.instagram.com/p/DPmZwNuEglZ/?utm_source=ig_embed\u0026utm_campaign=loading\" data-instgrm-version=\"14\" style=\" background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:658px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);\"\u003e\u003cdiv style=\"padding:16px;\"\u003e \u003ca href=\"https://www.instagram.com/p/DPmZwNuEglZ/?utm_source=ig_embed\u0026utm_campaign=loading\" style=\" background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;\" target=\"_blank\"\u003e \u003cdiv style=\" display: flex; flex-direction: row; align-items: center;\"\u003e \u003cdiv style=\"background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;\"\u003e\u003c/div\u003e \u003cdiv style=\"display: flex; flex-direction: column; flex-grow: 1; justify-content: center;\"\u003e \u003cdiv style=\" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 100px;\"\u003e\u003c/div\u003e \u003cdiv style=\" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 60px;\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv style=\"padding: 19% 0;\"\u003e\u003c/div\u003e \u003cdiv style=\"display:block; height:50px; margin:0 auto 12px; width:50px;\