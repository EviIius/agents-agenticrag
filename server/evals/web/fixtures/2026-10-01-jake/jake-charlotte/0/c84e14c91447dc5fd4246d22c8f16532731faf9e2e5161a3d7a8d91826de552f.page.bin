aku. Appealing to the affluent neighborhood of Myers Park and those in search of hybrid fine dining and omakase concepts, this tasting menu highlights seafood-forward delicacies at $225 a person for chef’s counter seating and dining tables. A short-form tasting menu of four to five courses is also available at $125, as well as special omakase events with guest chefs."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaImageType","caption":{"html":"","plaintext":""},"credit":{"plaintext":"","html":""},"hideCredit":false,"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/chorus/uploads/chorus_asset/file/26017756/497517932_661230030234764_1595203365651529604_n.jpg?quality=90\u0026strip=all\u0026crop=0,5.5555555555556,100,88.888888888889"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/chorus/uploads/chorus_asset/file/26017756/497517932_661230030234764_1595203365651529604_n.jpg?quality=90\u0026strip=all\u0026crop=12.5,0,75,100"},"vertical":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/chorus/uploads/chorus_asset/file/26017756/497517932_661230030234764_1595203365651529604_n.jpg?quality=90\u0026strip=all\u0026crop=20,0,60,100"}},"title":"","credit":{"plaintext":"Sora","html":"Sora"},"id":"ZXQxMTppbWFnZTo0MjgyNA=="}},"location":{"latitude":35.173542,"longitude":-80.84004},"name":"Sora","phone":"(980) 517-0069","url":"https://www.soranc.com/","venue":{"id":"ZXQyOnZlbnVlOjg3Nzg1NA==","globalId":"ZXQyOnZlbnVlOjg3Nzg1NA","slug":"sora","title":"Sora","address":"2907 Selwyn Avenue, Charlotte, North Carolina 28209","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":"https://reservations.safegraph.com/reserve/238919?utm_source=safegraph\u0026utm_campaign=poi"},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":2651