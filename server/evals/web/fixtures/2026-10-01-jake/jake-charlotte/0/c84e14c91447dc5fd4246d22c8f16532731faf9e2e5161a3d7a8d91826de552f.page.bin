MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"1419 East Blvd a, Charlotte, NC 28203","description":[{"html":"A beloved Japanese food truck and ghost kitchen has found new digs in an anchoring corner of a busy Dilworth shopping center. A dimly lit space with a humming hip-hop backtrack at pleasing decibel levels, and graffiti-painted walls welcomes diners. Once seated, select from an assortment of carefully plated izakaya specialties like the delectable spare ribs, bright and tarty beef tataki, hearty A5 wagyu gyudon comfort bowl, and crowd-pleasing tonkatsu showstopper, which is a pork cutlet topped with a mountain of shaved Brussels and cheese.","plaintext":"A beloved Japanese food truck and ghost kitchen has found new digs in an anchoring corner of a busy Dilworth shopping center. A dimly lit space with a humming hip-hop backtrack at pleasing decibel levels, and graffiti-painted walls welcomes diners. Once seated, select from an assortment of carefully plated izakaya specialties like the delectable spare ribs, bright and tarty beef tataki, hearty A5 wagyu gyudon comfort bowl, and crowd-pleasing tonkatsu showstopper, which is a pork cutlet topped with a mountain of shaved Brussels and cheese."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaImageType","caption":{"html":"","plaintext":""},"credit":{"plaintext":"","html":""},"hideCredit":false,"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/dozo.webp?quality=90\u0026strip=all\u0026crop=0,0.018375597206905,100,99.963248805586"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/dozo.webp?quality=90\u0026strip=all\u0026crop=16.654411764706,0,66.691176470588,100"},"vertical":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/dozo.webp?quality=90\u0026strip=all\u0026crop=23.323529411765,0,53.352941176471,100"}},"title":"dozo","credit":{"plaintext":"Dozo","html":"Dozo"},"id":"ZXQxMTppbWFnZTo0NTg5NQ=="}},"location":{"latitude":35.200907,"longitude":-80.842744},"name":"DŌZO Japanese American Kitchen","phone":"(980) 201-9852","url":null,"venue":{"id":"ZXQxMTp2ZW51ZTo5Mzk5MTM=","globalId":"ZXQxMTp2ZW51ZTo5Mzk5MTM","slug":"dozo-japanese-american-kitchen","title":"DŌZO Japanese American Kitchen","address":"1419 East Blvd a, Charlotte, NC 28203","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"715 Providence Road, STE 4, Charlotte, North Carolina 28207, United States","description":[{"html":"Myers Park’s buzziest happy hour is at this latest addition to chef Bruce Moffet’s roster of restaurants. Opened in September and housed in the same villa as sister restaurant and Charlotte stronghold Stagioni, a grown-up, sophisticated crowd hangs out at the intimate bar or petite tables over seasonal, dessert, and Negroni cocktails and an extensive selection of European (Italian, Spanish, French, Greek) wines, champagnes, and aperitifs. Light bites like Tuscan white bean salad, olives, and almonds, and snacks like oysters with a truffle mignonette, charcuterie, ceviche, and bruschetta help you linger well into the evening (it’s open until 11 p.m.).","plaintext":"Myers Park’s buzziest happy hour is at this latest addition to chef Bruce Moffet’s roster of restaurants. Opened in September and housed in the same villa as sister restaurant and Charlotte stronghold Stagioni, a grown-up, sophisticated crowd hangs out at the intimate bar or petite tables over seasonal, dessert, and Negroni cocktails and an extensive selection of European (Italian, Spanish, French, Greek) wines, champagnes, and aperitifs. Light bites like Tuscan white bean salad, olives, and almonds, and snacks like oysters with a truffle mignonette, charcuterie, ceviche, and bruschetta help you linger well into the evening (it’s open until 11 p.m.)."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":null,"location":{"latitude":35.200352,"longitude":-80.824557},"name":"Sala","phone":"+17048177247","url":"https://salaclt.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5MTg2Mzc=","globalId":"ZXQxMTp2ZW51ZTo5MTg2Mzc","slug":"sala","title":"Sala","address":"715 Providence Road, STE 4, Charlotte, North Carolina 28207, United States","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":"https://reservations.safegraph.com/reserve/241005?utm_source=safegraph\u0026utm_campaign=poi"},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"2400 Park Road, STE H, Charlotte, North Carolina 28203, United States","description":[{"html":"Open since December, this adorable, classy wine bar and bottle shop bucks the stereotype of bad wine bar food. A surprisingly delicious small plates menu dares to outshine the wines while pleasing the palate: try assorted meat and cheese plates, exquisite hamachi tiradito ($16), wagyu carpaccio that is art on a plate ($18), or pasta salad with lots of fluffy parmesan ($12). Don’t forget dessert: at the time of writing, it’s the most inventive sundae in town, with zesty orange and ginger ice cream, carrot caramel, and topped with pistachio. Lunchtime offers rotating sandwiches. Wines by-the-glass and take-home bottles are priced from $12 and $25, respectively, and showcase bottles from around the world.","plaintext":"Open since December, this adorable, classy wine bar and bottle shop bucks the stereotype of bad wine bar food. A surprisingly delicious small plates menu dares to outshine the wines while pleasing the palate: try assorted meat and cheese plates, exquisite hamachi tiradito ($16), wagyu carpaccio that is art on a plate ($18), or pasta salad with lots of fluffy parmesan ($12). Don’t forget dessert: at the time of writing, it’s the most inventive sundae in town, with zesty orange and ginger ice cream, carrot caramel, and topped with pistachio. Lunchtime offers rotating sandwiches. Wines by-the-glass and take-home bottles are priced from $12 and $25, respectively, and showcase bottles from around the world."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaImageType","caption":{"html":"","plaintext":""},"credit":{"plaintext":"","html":""},"hideCredit":false,"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/2026-01-13.webp?quality=90\u0026strip=all\u0026crop=0,25,100,50"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/2026-01-13.webp?quality=90\u0026strip=all\u0026crop=0,12.5,100,75"},"vertical":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/2026-01-13.webp?quality=90\u0026strip=all\u0026crop=0,3.125,100,93.75"}},"title":"Emmy Lou’s","credit":{"plaintext":"Emmy Lou’s","html":"Emmy Lou’s"},"id":"ZXQxMTppbWFnZTo0NTg5Mw=="}},"location":{"latitude":35.19854,"longitude":-80.852442},"name":"Emmy Lou’s","phone":"(704) 733-9181","url":"https://emmylouswinebar.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5Mzk5MDk=","globalId":"ZXQxMTp2ZW51ZTo5Mzk5MDk","slug":"emmy-lous","title":"Emmy Lou’s","address":"2400 Park Road, STE H, Charlotte, North Carolina 28203, United States","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"liveBadge":false,"package":null,"promo":{"headline":"17 Best New Restaurants in Charlotte Right Now","description":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=0,0.0026877385367925,100,99.994624522926"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2026/02/DSC01598.jpg?quality=90\u0026strip=all\u0026crop=16.664874744651,0,66.670250510698,100"}},"id":"ZXQxMTppbWFnZTo0NTkwNw=="}},"comments":{"enabled":false,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}]}]}}},{"address":"2442 Park Road, Charlotte, North Carolina 28203, United States","description":[{"html":"New to Charlotte, but not a new bakery, this distinctively Southern bakery first opened its doors in 1989 in South Carolina, where it now has three shops. Its first North Carolina location offers a market of freshly made take-and-bake items, a menu of breakfast and lunch items like cinnamon rolls, lemon muffins, quiches, pot pies, and tuna and chicken salad, and a daily bread menu, though its famous buttermilk white bread is offered daily.","plaintext":"New to Charlotte, but not a new bakery, this distinctively Southern bakery first opened its doors in 1989 in South Carolina, where it now has three shops. Its first North Carolina location offers a market of freshly made take-and-bake items, a menu of breakfast and lunch items like cinnamon rolls, lemon muffins, quiches, pot pies, and tuna and chicken salad, and a daily bread menu, though its famous buttermilk white bread is offered daily."}],"primaryCampaign":null,"campaignCustomLink":null,"ledeMedia":{"__typename":"LedeMediaImageType","caption":{"html":"","plaintext":""},"credit":{"plaintext":"","html":""},"hideCredit":false,"image":{"thumbnails":{"horizontal":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/kudzu-bakery.jpg?quality=90\u0026strip=all\u0026crop=0.049999999999997,0,99.9,100"},"square":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/kudzu-bakery.jpg?quality=90\u0026strip=all\u0026crop=16.7,0,66.6,100"},"vertical":{"url":"https://platform.carolinas.eater.com/wp-content/uploads/sites/11/2025/10/kudzu-bakery.jpg?quality=90\u0026strip=all\u0026crop=23.36,0,53.28,100"}},"title":"kudzu bakery","credit":{"plaintext":"Kudzu Bakery","html":"Kudzu Bakery"},"id":"ZXQxMTppbWFnZTo0NTI3Mg=="}},"location":{"latitude":35.19769,"longitude":-80.852708},"name":"Kudzu Bakery","phone":"(704) 900-5272","url":"https://www.kudzubakery.com/","venue":{"id":"ZXQxMTp2ZW51ZTo5MTg2OTQ=","globalId":"ZXQxMTp2ZW51ZTo5MTg2OTQ","slug":"kudzu-bakery","title":"Kudzu Bakery","address":"2442 Park Road, Charlotte, North Carolina 28203, United States","ledeMedia":null,"sevenrooms":null,"safegraph":{"bookingLink":null},"opentable":null,"posts":{"nodes":[{"__typename":"MapResourceType","id":"ZXQxMTptYXA6MjY1MTg=","__isFeedContentResourceInterface":"MapResourceType","wpId":26518,"globalId":"ZXQxMTptYXA6MjY1MTg","chorusId":20930015,"chorusUuid":"3ef636bc-be38-455d-966a-7b4113ffb3bd","resourceType":"map","site":{"isCrossCommunity":false,"wpId":11},"dek":{"html":"Charlotte heats up with a destination seafood spot, sushi cellar, and an instant-hit neighborhood wine bar"},"permalink":"https://carolinas.eater.com/maps/best-new-restaurants-charlotte","title":"17 Best New Restaurants in Charlotte Right Now","publishedAt":"2026-02-02T19:21:58+00:00","authors":[{"name":"Shindy Chen","path":"/authors/shindy-chen","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2NDYzNw==","permalink":"https://www.eater.com/authors/shindy-chen","shortBio":[{"html":"is a writer and creator who splits her time between Miami and her hometown of Charlotte, North Carolina."}]},{"name":"Kayleigh Ruller","path":"/authors/kayleigh-ruller","id":"ZXQxMTphdXRob3JQcm9maWxlOjU2MzkxMw==","permalink":"https://www.eater.com/authors/kayleigh-ruller","shortBio":[{"html":"Kayleigh Ruller is a freelance food journalist and travel writer based in North Carolina. Her work can be seen in \u003ci\u003eFood \u0026 Wine\u003c/i\u003e, Thrillist, Charlotte Magazine, The Charlotte Observer and other regional publications."}]}],"primaryCategory":{"title":"Charlotte","id":"ZXQxMTpjYXRlZ29yeTozMzg="},"categories":[{"id":"ZXQxMTpjYXRlZ29yeTozMzg=","title":"Charlotte","slug":"charlotte-restaurants"},{"id":"ZXQxMTpjYXRlZ29yeTo2Mg==","title":"Dining Out in the Carolinas","slug":"dining-out-in-the-carolinas"}],"internalCategories":[],"