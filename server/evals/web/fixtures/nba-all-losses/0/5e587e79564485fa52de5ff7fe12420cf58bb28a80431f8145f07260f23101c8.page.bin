    <script>
        (function () {
            if (window.__FW_EMBED_RUNTIME__) return;
            window.__FW_EMBED_RUNTIME__ = true;

            function processEmbeds(root) {
                root = root || document;

                if (window.__FW_EMBEDS__?.twitter && window.twttr?.widgets?.load) {
                    window.twttr.widgets.load(root);
                }

                if (window.__FW_EMBEDS__?.reddit && window.rembeddit?.init) {
                    window.rembeddit.init();
                }

                if (window.__FW_EMBEDS__?.instagram && window.instgrm?.Embeds?.process) {
                    window.instgrm.Embeds.process();
                }

                if (window.__FW_EMBEDS__?.threads && window.ThreadsEmbed?.process) {
                    window.ThreadsEmbed.process();
                }

                if (window.__FW_EMBEDS__?.bluesky && window.bsky?.embed?.init) {
                    window.bsky.embed.init();
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                processEmbeds(document);
            });

            const observer = new MutationObserver(function (mutations) {
                for (const m of mutations) {
                    for (const node of m.addedNodes) {
                        if (node.nodeType === 1) {
                            processEmbeds(node);
                        }
                    }
                }
            });

            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
        })();
    </script>
