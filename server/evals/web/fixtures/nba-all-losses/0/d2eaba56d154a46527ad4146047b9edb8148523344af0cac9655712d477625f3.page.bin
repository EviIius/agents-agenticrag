/* === BestReview Article Components (Template: custom/modular) === */

.br-theme-custom *{box-sizing:border-box}

/* Disclosure */
.br-disclosure{font-size:.75em;color:#aaa;padding:6px 10px;background:#faf9f8;border-radius:3px;margin-bottom:20px}

/* ── Top picks — cards variant (same as default) ── */
.br-qp{background:#f8f7f5;border-radius:8px;padding:18px 18px 14px;margin:0 0 24px}
.br-qp-title{font-size:.78em;font-weight:700;letter-spacing:.01em;color:#888;margin:0 0 12px}
.br-qp-grid{display:grid;grid-template-columns:1fr;gap:10px}
.br-qp-card{background:#fff;border:1px solid #e5e3df;border-radius:6px;padding:14px 16px;display:flex;gap:12px;align-items:flex-start}
.br-qp-card.is-top{border-color:#d97706;border-top:2px solid #d97706}
.br-qp-thumb{width:52px;height:52px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.br-qp-thumb a{display:flex;align-items:center;justify-content:center;width:100%;height:100%;line-height:0;cursor:pointer}
.br-qp-thumb img{max-width:52px;max-height:52px;width:auto;height:auto;object-fit:contain;display:block;transition:opacity .2s ease}
.br-qp-thumb a:hover img{opacity:.85}
.br-qp-body{min-width:0;flex:1}
.br-qp-badge{font-size:.67em;font-weight:700;letter-spacing:.01em;color:#aaa;display:block;margin-bottom:3px}
.br-qp-card.is-top .br-qp-badge{color:#b45309}
.br-qp-name{font-size:.88em;font-weight:600;display:block;margin-bottom:3px;color:#111}
.br-qp-line{font-size:.82em;line-height:1.45;color:#555;margin:0 0 8px}
.br-qp-link{display:block;font-size:.78em;font-weight:600;color:#2563eb;margin:0}
.br-article .br-qp p:empty{display:none!important;margin:0!important;padding:0!important}
.br-article .br-qp .br-qp-title{margin:0 0 12px!important}
.br-article .br-qp .br-qp-body p{margin:0!important}
.br-article .br-qp .br-qp-body p.br-qp-line,.br-article .br-qp .br-qp-body .br-qp-line{margin:0 0 8px!important}

/* ── Top picks — text variant (Wirecutter style) ── */
.br-theme-custom .br2-toppicks{margin:0 0 32px}
.br-theme-custom .br2-toppicks-title{font-size:1.45em;font-weight:700;margin:0 0 18px;padding:0;border:none;color:#111}
.br-theme-custom .br2-pick{margin:0 0 20px}
.br-theme-custom .br2-pick:last-child{margin-bottom:0}
.br-theme-custom .br2-pick-label{font-size:.72em;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#555;margin:0 0 5px}
.br-theme-custom .br2-pick-product{margin:0 0 7px}
.br-theme-custom .br2-pick-product a{font-size:1.08em;font-weight:600;color:#1a1a1a;text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px}
.br-theme-custom .br2-pick-product a:hover{color:#1d4ed8}
.br-theme-custom .br2-pick-jump{margin:0}
.br-theme-custom .br2-pick-jump a{font-size:.85em;color:#555;text-decoration:none;display:inline-flex;align-items:center;gap:4px}
.br-theme-custom .br2-pick-jump a:hover{text-decoration:underline}

/* ── Review card wrapper ── */
.br-review{border:1px solid #e5e3df;border-radius:8px;padding:20px;margin-bottom:28px}
.br-review.is-top{border-top:3px solid #d97706}
.br-article h2.br-review-kicker{font-size:1rem;letter-spacing:.02em;font-weight:700;margin:0 0 8px;padding:0;border:none;line-height:1.35;color:#57534e}
.br-review.is-top .br-review-kicker{color:#b45309}
.br-article h3.br-review-heading{font-size:clamp(1.125rem,2.2vw,1.375rem);font-weight:600;line-height:1.35;margin:0 0 16px;padding:0;border:none}
.br-article h3.br-review-heading a{color:#1c1917;text-decoration:underline;text-underline-offset:3px}
.br-article h3.br-review-heading a:hover{color:#1d4ed8}

/* ── Inline specs strip (centered layout) ── */
.br-review-specs{font-size:.84em;line-height:1.65;color:#444;margin:0 0 14px;padding:0}
.br-spec-sep{color:#d6d3d1;margin:0 5px;font-weight:400}

/* ── Image — centered variant ── */
.br-review-img{text-align:center;margin-bottom:12px}
.br-review-img a{display:inline-block;line-height:0;cursor:pointer}
.br-review-img img{max-width:100%;max-height:300px;width:auto;height:auto;object-fit:contain;display:inline-block;transition:opacity .2s ease}
.br-review-img a:hover img{opacity:.85}
@media(max-width:480px){.br-review-img img{max-height:220px}}

/* ── Image — sidebar variant (image 39% / features 56%) ── */
.br-theme-custom .br2-review-main{display:flex;gap:5%;align-items:center;margin:0 0 20px}
.br-theme-custom .br2-review-img{flex:0 0 39%;text-align:center}
.br-theme-custom .br2-review-img a{display:inline-block;line-height:0}
.br-theme-custom .br2-review-img img{max-width:100%;max-height:310px;width:auto;height:auto;object-fit:contain;display:inline-block;transition:opacity .2s ease}
.br-theme-custom .br2-review-img a:hover img{opacity:.85}
.br-theme-custom .br2-features{flex:0 0 56%;min-width:0}
.br-theme-custom .br2-features-title{font-size:1.125em;font-weight:700;margin:0 0 10px;color:#1a1a1a}
.br-theme-custom .br2-features ul{margin:0 0 16px;padding-left:2.8em;list-style:disc}
.br-theme-custom .br2-features li{font-size:.93em;padding:3px 0;line-height:1.5;color:#333;border:none}
.br-theme-custom .br2-features li::marker{color:#c0392b}
.br-theme-custom .br2-features li strong{color:#111}
@media(max-width:600px){
  .br-theme-custom .br2-review-main{flex-direction:column}
  .br-theme-custom .br2-review-img{flex:none;width:100%;text-align:center}
  .br-theme-custom .br2-review-img img{max-height:260px}
  .br-theme-custom .br2-features{flex:none;width:100%}
}

/* ── Verdict ── */
.br-verdict{font-size:.93em;font-weight:500;background:#f8f7f5;border-left:3px solid #e5e3df;padding:9px 13px;margin-bottom:14px;border-radius:0 4px 4px 0;color:#222}
.br-review.is-top .br-verdict{background:#fffbf2;border-left-color:#d97706}
.br-body p{font-size:.93em;color:#333;margin-bottom:.8em}

/* ── Tip / usage note ── */
.br-usage-note{background:#f0f9ff;border-left:3px solid #0ea5e9;padding:8px 12px;font-size:.84em;color:#0c4a6e;margin:12px 0;border-radius:0 4px 4px 0}

/* ── Pros/cons — plain variant ── */
.br-pc{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:14px 0;padding:14px;background:#fafaf8;border-radius:6px}
@media(max-width:480px){.br-pc{grid-template-columns:1fr}}
.br-pros h4{font-size:.8em;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin:0 0 6px;color:#15803d}
.br-cons h4{font-size:.8em;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin:0 0 6px;color:#dc2626}
.br-pros ul,.br-cons ul{margin:0;padding:0;list-style:none}
.br-pros li,.br-cons li{font-size:.83em;padding:3px 0 3px 18px;position:relative;line-height:1.5;color:#333;margin-bottom:0}
.br-pros li::before{content:'✓';position:absolute;left:0;color:#16a34a;font-weight:700}
.br-cons li::before{content:'✗';position:absolute;left:0;color:#dc2626}
.br-cons li.safety-hazard,.br-cons li.systemic{color:#b91c1c;font-weight:600}
.br-cons li.usability-tradeoff{font-style:italic;color:#444}

/* ── Pros/cons — badge variant ── */
.br-theme-custom .br2-pc{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:18px 0 0}
@media(max-width:480px){.br-theme-custom .br2-pc{grid-template-columns:1fr}}
.br-theme-custom .br2-pros h4,.br-theme-custom .br2-cons h4{font-size:.85em;font-weight:700;margin:0 0 10px;color:#1a1a1a}
.br-theme-custom .br2-pros ul,.br-theme-custom .br2-cons ul{margin:0;padding:0;list-style:none}
.br-theme-custom .br2-pros li,.br-theme-custom .br2-cons li{font-size:.85em;padding:4px 0 4px 26px;position:relative;line-height:1.55;color:#333;margin-bottom:2px}
.br-theme-custom .br2-pros li::before{content:'\2713';position:absolute;left:0;top:3px;color:#fff;background:#22c55e;border-radius:50%;width:18px;height:18px;font-size:.6em;line-height:18px;text-align:center;font-weight:900}
.br-theme-custom .br2-cons li::before{content:'\2715';position:absolute;left:0;top:3px;color:#fff;background:#ef4444;border-radius:50%;width:18px;height:18px;font-size:.6em;line-height:18px;text-align:center;font-weight:900}

/* ── Bottom line & CTA ── */
.br-bottom{font-size:.87em;font-style:italic;color:#555;border-top:1px solid #f0eeea;padding-top:10px;margin:12px 0 0}
.br-cta{display:block;width:fit-content;margin:14px auto 0;padding:9px 22px;background:#f97316;color:#fff!important;border-radius:4px;font-size:.86em;font-weight:700;text-decoration:none!important;letter-spacing:.01em;text-align:center}
.br-cta:hover{background:#ea6c0e;color:#fff!important}

/* ── Buying guide ── */
.br-bg-insight{font-size:.93em;font-weight:500;padding:10px 14px;background:#f0f7ff;border-left:3px solid #3b82f6;border-radius:0 6px 6px 0;margin-bottom:20px;color:#1e3a5f}
.br-bg-section{margin-bottom:16px}
.br-bg-section p{font-size:.92em;color:#444;margin-bottom:.5em}
.br-bg-mistake{font-size:.87em;padding:10px 14px;background:#fffbf0;border-left:3px solid #f59e0b;border-radius:0 4px 4px 0;margin-top:20px;margin-bottom:40px;color:#5c3d00}

/* ── FAQ ── */
.br-faq-item{border-bottom:1px solid #f0eeea;padding:16px 0}
.br-faq-item:last-child{border-bottom:none}
.br-faq-item p{font-size:.91em;color:#444;margin:0}

		</style>
		<noscript><style id="rocket-lazyload-nojs-css">.rll-youtube-player, [data-lazy-src]{display:none !important;}</style></noscript></head>

