    <style>
  .travel-banner-container {
    position: fixed;
    bottom: 0;
    left: 0;
    z-index: 2024;
    width: 100%;
    background: url('https://www.iroamly.com/images/banner/travel-banner-en-bg-mb.png');
    background-size: 100% 100%;
    aspect-ratio: 375/70;
  }

  .travel-banner-container.hide {
    display: none;
  }

  .travel-banner-container .close-btn {
    position: absolute;
    top: 20px;
    right: 24px;
  }

  @media (min-width: 768px) {
    .travel-banner-container {
      background: url('https://www.iroamly.com/images/banner/travel-banner-en-bg.png');
      height: auto;
      background-size: 100% 100%;
      aspect-ratio: 144/11;
    }

    .travel-banner-container .close-btn {
      right: 2%;
      top: 45%;
    }
  }
</style>
<div class="travel-banner-container hide">
  <button class="close-btn btn-clear">
    <img src="https://www.iroamly.com/images/banner/close.svg" alt="close" width="20" height="20" />
  </button>
  <a href="/" style="display: block; width: 100%; height: 100%; text-decoration: none;"></a>
</div>
<script src="https://cdn.jsdelivr.net/npm/js-cookie@3.0.5/dist/js.cookie.min.js"></script>
<script>
  window.addEventListener('load', () => {
    if (window.Cookies) {
      const travelBanner = Cookies.get('travelBanner');
      if (!travelBanner) {
        document.querySelector('.travel-banner-container').classList.remove('hide');
      }
      document.querySelector('.travel-banner-container .close-btn').addEventListener('click', () => {
        document.querySelector('.travel-banner-container').classList.add('hide');
        Cookies.set('travelBanner', 'true', { expires: new Date(Date.now() + 86400000) });
      })
    }
  })
</script>
  </body>
</html>