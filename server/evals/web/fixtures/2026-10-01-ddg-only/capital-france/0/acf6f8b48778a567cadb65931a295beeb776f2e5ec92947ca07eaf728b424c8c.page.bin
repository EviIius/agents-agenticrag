<div class="modal modal-switch-language fade" id="switchLanguageModalEl" tabindex="-1"
     aria-labelledby="switchLanguageModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="position-relative modal-header justify-content-center">
        <strong class="modal-title d-block w-100 fw-bold text-center" id="switchLanguageModalTitle"
                data-modal-title>Switch Language</strong>
        <button type="button" class="position-absolute end-0 btn-close btn-clear p-0 m-0 close-btn"
                data-bs-dismiss="modal" aria-label="Close">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"><path stroke="currentColor" stroke-linecap="round" stroke-width="1.5" d="m6 6 12 12M6 18 18 6"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <p data-modal-switch-message>Your browser language is English, would you like to switch the site language to English?</p>
      </div>
      <div class="modal-footer d-flex flex-wrap row-gap-2 align-items-stretch justify-content-center px-0 border-top-0">
        <button type="button" class="btn m-0 btn-cancel" data-bs-dismiss="modal"
                data-modal-cancel>
          No
        </button>
        <a href="" class="btn m-0 btn-primary text-white" data-modal-switch>
          Yes
        </a>
      </div>
    </div>
  </div>
