		<script type="text/template" id="playlist-template">
			<div id="pl-title">
				<div id="pl-header">
					<div id="pl-index"></div>
					<div id="pl-label">
						<span>
							Quiz Playlist:
							<span class="pl-name">
								<a href="<%= url %>">
									<%- name %>
								</a>
							</span>
						</span>
					</div>
					<div id="pl-meta">
						<%= game_count %> Quiz<%= game_count == 1 ? '' : 'zes'%>
						|
						<%= total_time_disp %> Total Time
					</div>
				</div>

				<div id="pl-tools">

					<% if (!hasOrange) { %>
					<span class="buttonOrange random-pl-game" id="pl-random-button">
								<span class="random-icon"></span>
								random
						</span>
					<% } else { %>
					<span class="random-pl-game buttonOrange">
							<a href="<%- random_game.url %>" >
								<span class="random-icon"></span>random
							</a>
						</span>
					<% } %>

					<span id="pl-likes-count"><%=likes%></span>
					<div id="pl-follow-button" class="follow-button<%- is_liked ? ' following' : ''%>">Follow<%- is_liked ? 'ing' : '' %></div>
				</div>
			</div>

			<div id="pl-container">
				<% _.each(games, function(game, i) { %>
					<div id="playlistGame<%- game.id %>" class="pl-game <%- game.is_current ? 'current' : 'non-current' %>">
						<div class="textBox">
							<div class="title">
								<div class="text">
									<span><%- i+1 + "." %>
										<% if (!game.is_current) { %>
											<a href="<%- game.url %>">
										<% } %>
										<%- game.name %>
										<% if (!game.is_current) { %>
											</a>
										<% } %>
									</span>
									<div class="gameType <%- game.type %>" title="<%- game.type_display %>"></div>
								</div>
							</div>
							<div class="meta">
								<% if (game.best_score) { %>
									<span>Best: <%- Math.round(game.best_score * game.element_count / 100) %>/<%- game.element_count %></span>
									<!-- <span>Last Played: <%- game.last_played %></span> -->
								<% } %>
							</div>
						</div>
						<% if (game.is_current) { %>
							<div class="arrow"></div>
						<% } %>
					</div>
				<% }); %>
			</div>
		</script>
			<script type="text/template" id="highscores-results-template">
			<% %>
			<table class='standings'>
				<thead>
					<tr>
						<th class="rank left-align">Rank</th>
						<th class="player left-align">Player</th>
						<th class="best-score">Best Out of <%=num_answers%></th>
													<th class="best-score-num">&nbsp;</th>
							<th class="play-count">Plays</th>
												<th class="last-played right-align">Last Played</th>
					</tr>
				</thead>
				<tbody class='standings-body'>
				</tbody>
			</table>
		</script>
			<script type="text/template" id="showdown-results-template">
			<% %>
			<table class='standings'>
				<thead>
					<tr>
						<th scope="col" class="rank left-align">Rank</th>
						<th scope="col" class="player left-align">Player</th>
						<th scope="col" class="rating">Rating</th>
													<th scope="col" class="record">W</th>
							<th scope="col" class="record">L</th>
							<th scope="col" class="record">T</th>
												<th scope="col" class="best-score">Best Out Of <%=num_answers%></th>
													<th scope="col" class="best-score-num">&nbsp;</th>
							<th scope="col" class="last-played right-align">Last Played</th>
											</tr>
				</thead>
				<tbody class='standings-body'>
				</tbody>
			</table>
		</script>
			<script type="text/template" id="unplayed-results-row-template">
			<%
			if (window.mweb) {
				var message = "You have not played yet";
				var messageColSpan = 4;
			} else {
			if (mode === 'showdownFriends') {
				var message = "You don't have a high score for this quiz in showdown mode yet";
				var messageColSpan = 7;
			} else if (mode === 'quizStopwatch') {
				var message = "You don't have a high score for this quiz in practice mode yet";
				var messageColSpan = 4;
			} else {
				var message = "You don't have a high score for this quiz yet";
				var messageColSpan = 4;
			}
			}

			%>
			<tr class="you">
				<td></td>
				<td class="left-align">
					<a class="user-thumb-link" href="/user/<%-user.handle%>/">
							<span class="user-thumb" style="background-image:url(<%-user.image%>)">
								<% if (user.flair_id && window._payload.active_flairs[user.flair_id]) {
									let flair = window._payload.active_flairs[user.flair_id]; %>
									<div class="user-thumb-indicator" style="background-image:url(<%= flair.image %>)" title="<%= flair.description %>"></div>
								<% } %>
							</span>
					</a>
					<a href="/user/<%-user.handle%>/" class="user-link"><%-user.handle%></a>
				</td>
				<td colspan="<%=messageColSpan%>" class="left-align">
					<span class="unplayed-message"><%=message%></span>
				</td>
			</tr>
		</script>
			<script type="text/template" id="highscores-results-row-template">
			<tr class="<%=(row.is_current_user ? 'you' : '')%>">
				<td class="left-align rank"><%=row.rank%></td>
				<td class="left-align">
					<a class="user-thumb-link" href="/user/<%-row.handle%>/" aria-label="<%-row.handle%>">
						<span class="user-thumb" style="background-image:url(<%-row.image%>)">
							<% if (row.flair_id && window._payload.active_flairs[row.flair_id]) {
								let flair = window._payload.active_flairs[row.flair_id]; %>
								<div class="user-thumb-indicator" style="background-image:url(<%= flair.image %>)" title="<%= flair.description %>"></div>
							<% } %>
						</span>
					</a>
					<a href="/user/<%-row.handle%>/" class="user-link"><%-row.handle%></a>
				</td>
									<td>
						<div class="best-score-background">
							<div class="best-score-bar" style="width:<%=(row.best_score*100)%>%"></div>
						</div>
					</td>
								<td class="left-align">
					<span><%-row.best_score_num%></span>
					<% if (row.best_score === 1 && row.best_time) { %>
						<span class="best-time">in <%-row.best_time_string%></span>
					<% } %>
				</td>

									<td><%-row.play_count%></td>
								<td class="right-align last-played"><%-row.play_date%></td>
			</tr>
		</script>
			<script type="text/template" id="showdown-results-row-template">
			<% %>
			<tr class="<%=(row.is_current_user ? 'you' : '')%>">
				<td class="left-align rank"><%=row.rank%></td>
				<td class="left-align">
				<% if (!row.is_deleted) { %>
					<a class="user-thumb-link" href="/user/<%-row.handle%>/">
						<span class="user-thumb" style="background-image:url(<%-row.image%>)">
							<% if (row.flair_id && window._payload.active_flairs[row.flair_id]) {
							   let flair = window._payload.active_flairs[row.flair_id]; %>
								<div class="user-thumb-indicator" style="background-image:url(<%= flair.image %>)" title="<%= flair.description %>"></div>
							<% } %>
						</span>
					</a>
					<a href="/user/<%-row.handle%>/" class="user-link"><%-row.handle%></a>
				<% } else { %>
					<a class="user-thumb-link">
						<span class="user-thumb" style="background-image:url(<%-row.image%>)"></span>
					</a>
					<span class="user-link"><%-row.handle%></span>
				<% } %>
				</td>
				<td><%-row.rating ? row.rating : '-' %></td>
									<td><%-row.win_count%></td>
					<td><%-row.loss_count%></td>
					<td><%-row.tie_count%></td>
					<td>
						<div class="best-score-background">
							<div class="best-score-bar" style="width:<%=(row.best_score > 1 ? 100 : row.best_score*100)%>%"></div>
						</div>
					</td>
								<td class="left-align">
					<span><%-(row.best_score_num > row.num_answers ? row.num_answers : row.best_score_num) %></span>
					<% if (row.best_score === 1 && row.best_time) { %>
						<span class="best-time">in <%-row.best_time_string%></span>
					<% } %>
				</td>
									<td class="right-align last-played"><%-row.play_date%></td>
							</tr>
		</script>
			<script type="text/template" id="playlist-index-template">
			<% if (results) { %>
				<span class='label'>Playlist</span>
			<% } %>
			<button class="button-playlist-menu reckon-bar-action">
				<img class='reckon-bar-img' src="/images/svg/game-page/playlist.svg">
				<div class="screen-reader-text">Button to open playlist dropdown</div>
			</button>
			<% if (!results) { %>
				<span class='label'>Playlist</span>
			<% } %>

			<div class="playlist-dropdown">
				<div class="playlist-dropdown-header">
					<div class="title"><a href="<%- url %>"><%- name %></a></div>
					<div class="icon close"></div>
				</div>
				<div class="playlist-dropdown-game-list">
					<ul>
						<% _.each(games, function(game, i) { %>
							<li class="playlistDropdownGame<%- game.id %> <%- game.is_current ? "current" : "" %>">
								<div class="index">
									<span class="number"><%- i+1 %>.</span>
									<a href="<%- game.url %>"><span class="icon"></span></a>
								</div>
								<div class="title">
									<div class="gameName">
										<% if (game.is_current) { %>
											<div><%- game.name %></div>
										<% } else { %>
											<a href="<%- game.url %>"><div><%- game.name %></div></a>
										<% } %>
									</div>
									<div class="gameType <%- game.type %>" title="<%- game.type_display %>"></div>
								</div>
								<div class="bestScore"><%- game.best_score !== null ? Math.round(game.best_score)+"%" : "" %></div>
							</li>
						<% }); %>
					</ul>
				</div>
			</div>
		</script>
			<script id="quiz-badge-template" type="text/template">
			<div class="quiz-badge ">

				<div class="section-subtitle">Play Quiz to Earn This Badge</div>

				<div class="badge-wrapper ">
					<a href="<%-badge_url%>" id="<%-tooltip_trigger_id%>" class="badge-art-link" aria-label="<%-badge_name%>">
						<div class="badge-art" style="background-image:url('<%-(badge_earned ? badge_art : badge_unearned_art)%>')"></div>
						<% if (logged_in && badge_earned && show_levels && (level > 0)) { %>
							<span class="level-label"><%-level%></span>
						<% } %>
					</a>

					<div class="badge-info">

						
						<a href="<%-badge_url%>" class="badge-name"><%-badge_name%></a>

						<div class="condition-desc">
							<% if (logged_in) { %>
								<% if (badge_earned) { %>
									<% if (levelable) { %>
										<div class="badge-earned-check"></div>
										<div class="badge-earned-date">Earned Level <%-level%><br><%-last_level_date%></div>
									<% } else { %>
										<div class="badge-earned-check"></div>
										<div class="badge-earned-date">Earned <%-earned_date%></div>
									<% } %>
								<% } else if (condition_earned) { %>
									<div class="condition-earned-check"></div>
									<div><%-condition_desc_past%><br><%- (conditions.length - remaining_conditions.length)+'/'+conditions.length+' tasks completed' %></div>
								<% } else { %>
									<div><%-condition_desc%><br><%- (conditions.length - remaining_conditions.length)+'/'+conditions.length+' tasks completed' %></div>
								<% } %>
							<% } else { %>
								<button class="button-secondary badge-login">Sign up to Earn</button>
							<% } %>
						</div>
					</div>
				</div>

			</div>
		</script>
			<script id="rating-details-template" type="text/template">
			<table>
				<thead>
					<tr>
						<th colspan="4">
							<b><%= average_rating %></b> average rating, <b><%= total_of_rating_counts.toLocaleString() %></b> ratings
						</th>
					</tr>
				</thead>
				<tbody>
					<% _.each(rating_counts, function(row) { %>
						<% var percent = parseInt((total_of_rating_counts ? 100*row.count/total_of_rating_counts : 0), 10); %>
						<% var width = parseInt((max_of_rating_counts ? 100*row.count/max_of_rating_counts : 0), 10); %>
						<tr>
							<td class="label"><%= row.rating %></td>
							<td class="globe"><img src="/images/globe-icon-blue.svg" class="globe-icon-blue"></td>
							<td class="graph-line"><span class="line" style="width:<%= width %>%"></span></td>
							<td class="stats"><%= percent %>% (<%= row.count.toLocaleString() %>)</td>
						</tr>
					<% }); %>
				</tbody>
			</table>
		</script>
	

<footer class="pageFooter">
