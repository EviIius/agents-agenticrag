https:\/\/d31xsmoz1lk3y3.cloudfront.net\/square\/2632079.webp?v=1780086589","icon_description":"NBA Reveal IX","label_text":"Basketball","label_url":"\/games\/subcategory\/basketball"},{"game_id":347,"game_name":"NBA Career Scoring Leaders","game_timer":"6m","game_type":0,"game_dailybox":0,"game_type_english_name":"Classic","game_type_underscore_name":"classic","game_url":"g\/nbascoreleaders","blurb_text":null,"icon":"https:\/\/d31xsmoz1lk3y3.cloudfront.net\/square\/347.jpg?v=1521669691","icon_description":"NBA Career Scoring Leaders","label_text":"Basketball","label_url":"\/games\/subcategory\/basketball"}],
		excludedPriorityQuizzes: ["1Sc1c659i"],
	};

	window._spAjaxCalls = window._spAjaxCalls || [];

	// ----------------------------------------
	// Declaring these here for the quiz results page because common_js.php isn't included there
	// ----------------------------------------
	window.creatorID = 28;
	Sporcle.gameData = Sporcle.gameData || {};
	Sporcle.gameData.name = "NBA Champions";
	Sporcle.gameData.gameID = 239;
	Sporcle.gameData.encodedGameID = '1Sc1c659i';
	Sporcle.gameData.categoryID = 6;
	Sporcle.gameData.comments_count =  100;
	Sporcle.userData = Sporcle.userData || {};
	Sporcle.userData.user_id = 0;
	Sporcle.userData.has_orange = 0;
	Sporcle.userData.user_handle = "";
	Sporcle.userData.user_icon = "\/images\/u\/default_v2.svg";
	Sporcle.userData.user_flair = null;
	window._spHooks = window._spHooks || {'start': [], 'postStart': [], 'end': [], 'showMissed': []};
	window.showingResults = false;
	Sporcle.userData.user_archived_comments =  0;
	Sporcle.userData.sent_quiz_kudos =  0;

	// ----------------------------------------
	// Done declaring stuff for the results page
	// ----------------------------------------


	// DOM loaded event handler for a game page
	$j(function() {
				setupGamePageEventHandlers();

		if (userID) {
			loadInitialScoreboardData('quiz');

			
			_spAjaxCalls.push(buildCheckForChallengesRequest(gameID));
			_spAjaxCalls.push(buildCheckForTournamentsRequest(gameID));
		}

		if (canShowOrangeNagModal()) {
			window.SporcleLib.Modal.openOrangeNagModal();
		}

		if ($j('#showdown-scoreboard').length > 0) {
			loadInitialScoreboardData('showdown');
		}



		var origHTMLBlur = HTMLElement.prototype.blur;
		HTMLElement.prototype.blur = function() {
			if ((document.activeElement.id === 'gameinput') && (this && (this.id !== 'gameinput'))) {
				var stack = new Error().stack || '';
				stack = stack
					.split('\n')
					.map(function (line) {
						return line.trim();
					})
					.filter(function(line) {
						return line;
					});

				focusLossData.events.push({
					type: 'protoBlur',
					time: Math.round((new Date()).getTime() / 1000),
					uid : userID,
					spuid : spuid,
					gid : gameID,
					o : hasOrange,
					m : hasMembership,
					s : stack,
					sb : stack[stack.length - 1],
					gi : inProgress,
					si : showdownActive,
					this : {
						id : this.id,
						name : this.name,
						nodeName : this.nodeName,
						pos : this.getBoundingClientRect()
					}
				});
			}

			origHTMLBlur.apply(this, arguments);
		}

		var origHTMLFocus = HTMLElement.prototype.focus;
		HTMLElement.prototype.focus = function() {
			if ((document.activeElement.id === 'gameinput') && (this && (this.id !== 'gameinput'))) {
				var stack = new Error().stack || '';
				stack = stack
					.split('\n')
					.map(function (line) {
						return line.trim();
					})
					.filter(function(line) {
						return line;
					});

				focusLossData.events.push({
					type: 'protoFocus',
					time: Math.round((new Date()).getTime() / 1000),
					uid : userID,
					spuid : spuid,
					gid : gameID,
					o : hasOrange,
					m : hasMembership,
					s : stack,
					sb : stack[stack.length - 1],
					gi : inProgress,
					si : showdownActive,
					this : {
						id : this.id,
						name : this.name,
						nodeName : this.nodeName,
						pos : this.getBoundingClientRect()
					}
				});
			}

			origHTMLFocus.apply(this, arguments);
		}

		var gameInputEl = document.getElementById('gameinput');
		if(gameInputEl){
            gameInputEl.addEventListener('focusout', function(e) {
                var stack = new Error().stack || '';
                stack = stack
                    .split('\n')
                    .map(function (line) {
                        return line.trim();
                    })
                    .filter(function(line) {
                        return line;
                    });

                var relatedTarget = e && e.hasOwnProperty('originalEvent') ? e.originalEvent.relatedTarget || e.originalEvent.explicitOriginalTarget || document.activeElement : null;

                focusLossData.events.push({
                    type: 'focusout',
                    time: Math.round((new Date()).getTime() / 1000),
                    uid: userID,
                    spuid: spuid,
                    gid: gameID,
                    o: hasOrange,
                    m: hasMembership,
                    t: relatedTarget ? relatedTarget.id : '',
                    n: relatedTarget && relatedTarget.nodeName ? relatedTarget.nodeName : '',
                    s: stack,
                    sb : stack[stack.length - 1],
                    gi : inProgress,
                    si : showdownActive
                });
            });

            gameInputEl.addEventListener('blur', function(e) {
                var stack = new Error().stack || '';
                stack = stack
                    .split('\n')
                    .map(function (line) {
                        return line.trim();
                    })
                    .filter(function(line) {
                        return line;
                    });

                var relatedTarget = e && e.hasOwnProperty('originalEvent') ? e.originalEvent.relatedTarget || e.originalEvent.explicitOriginalTarget || document.activeElement : null;

                focusLossData.events.push({
                    type: 'blur',
                    time: Math.round((new Date()).getTime() / 1000),
                    uid: userID,
                    spuid: spuid,
                    gid: gameID,
                    o: hasOrange,
                    m: hasMembership,
                    t: relatedTarget ? relatedTarget.id : '',
                    n: relatedTarget && relatedTarget.nodeName ? relatedTarget.nodeName : '',
                    s: stack,
                    sb : stack[stack.length - 1],
                    gi : inProgress,
                    si : showdownActive
                });
            });
        }

		_spHooks['start'].push(function() {
			$j('#send-focus-data').one('click', function(e){
				$j(this).css({opacity:.5, cursor:'default'});
				$j.ajax({
					url:'/ajax/blur.php',
					type: 'post',
					data: JSON.stringify(focusLossData)
				});
			}).css({opacity:1, cursor:'pointer'});
		})

		window.checkJustGo();
	});

	</script>


