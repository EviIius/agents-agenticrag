	window.unknownStrings = new Set();
	window.ttxt = function (text) {
		if (window.textStrings.hasOwnProperty(text))
		{
			let transText = window.textStrings[text];
			if (transText) {
				return transText;
			}
		} else {
			window.unknownStrings.add(text);
			submitString(Array.from(unknownStrings));
		}
		return text;
	}
