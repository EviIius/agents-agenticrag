// This code is only relevant to map and picture click games right now.
$j(function() {
	/* Set prev/next buttons to work with the space bar, treating it as a click event */
	$j('#previousButton, #nextButton').on('keypress', function(e) {
		if (e.keyCode === 32 || e.which === 32) { $j(this).trigger('click'); e.preventDefault(); }
	});

/*	Not including google analytics with onclick on buttons.
	The case of users interacting with buttons before the
	event handlers were placed should not occur because the
	game requires JavaScript to have loaded */

	$j("#random-link").on('click', function() {
		gtag('event', 'Random', {'location': 'Get Reckoning'});
	});


	$j('#scoreboard-login-btn').on('click', function() {
		window.SporcleLib.Modal.openRegisterModal({
			regPath		   : 'quiz_scoreboard_join_prompt'
		});
	});

	if (isPracticeModeDefault) {
		window.selectTimerSetting('stopwatch');
	}

	if (isPercentageScoreDefault) {
		window.selectScoreSetting('percentage');
	}

	if (!mweb) {
		if (!Sporcle.gameData.isMultipleChoice && !Sporcle.gameData.isClickable) {
			if (typeof window._spHooks !== 'undefined') {
				_spHooks['start'].push(function() {
					$j('#quiz-area').addClass('sticky-header');
				});
				_spHooks['end'].push(function() {
					$j('#quiz-area').removeClass('sticky-header');
				});
			}
		}
	}

	if (!Sporcle.gameData.isMultipleChoice) {
		// Turn answer arrays back into `/` separated strings. This is because we can't dump out the answers on the page as `/` separated strings
		// because it produces a bunch of 404s when google crawls our site. However, I don't want to spend the time now to dig into the game code and make
		// it all work with arrays of arrays.  See https://trello.com/c/vNFR5QkF/4929-change-something-about-the-way-we-encode-answers-on-the-quiz-page
		window.answers = window.answers.map((answer) => {
			return answer.join('/');
		});
		window.hidden = window.hidden.map((answer) => {
			return answer.join('/');
		});
	}
});


