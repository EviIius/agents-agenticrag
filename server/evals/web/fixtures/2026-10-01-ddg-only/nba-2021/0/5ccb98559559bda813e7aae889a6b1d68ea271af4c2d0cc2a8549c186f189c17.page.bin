            window.preventCommentAnchorDefaultBehavior = function (href, anchor) {
                if (href === window.location.pathname) {
                    if (anchor === window.location.hash) {
                        window.location.reload();
                        return false;
                    } else {
                        window.location.hash = anchor;
                        window.location.reload();
                        return false;
                    }
                }
            }
