			<button data-remodal-action="close" class="remodal-close"></button>

			<h2 id='confirmation-header' style="text-align:center;"><%= msg %></h2>

			<div class='buttons'>
				<div id='confirmation-buttons' style="display:flex;justify-content:center;">
					<div class='confirmation-button' style="width:12%;margin:0 20px;">
						<button type="button" class="buttonShape buttonOrange" id="yes"><%= yt %></button>
					</div>
					<div class='confirmation-button' style="width:12%;margin:0 20px;">
						<button type="button" class="buttonShape buttonOrange" id="no"><%= nt %></button>
					</div>
				</div>
				<div id='confirmation-error' class='alertBad' style='display:none;'>
					There was an error saving your preferences. Please contact <a href='/feedback/' target='_blank'>feedback</a> if you continue to see this issue.
				</div>
			</div>
		</script>
