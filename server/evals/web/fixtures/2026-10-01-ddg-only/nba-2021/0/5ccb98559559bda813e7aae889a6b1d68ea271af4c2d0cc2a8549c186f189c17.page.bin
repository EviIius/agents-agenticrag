        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}

            function loadGA4(configObj, consentGranted) {
                const s = document.createElement('script');
                s.src   = 'https://www.googletagmanager.com/gtag/js?id=G-DQF09RML7C';
                s.async = true;
                document.head.appendChild(s);

                gtag('js', new Date());
                gtag('config', 'G-DQF09RML7C', configObj);

                if (consentGranted) {
                    gtag('consent', 'update', { analytics_storage: 'granted' });
                } else {
                    gtag('consent', 'default', {
                        'analytics_storage': 'denied',
                        'region': ['GB', 'BE', 'BG', 'CH', 'CZ', 'DK', 'CY', 'LV', 'LT', 'LU', 'ES', 'FR', 'HR', 'IT', 'PL', 'PT', 'RO', 'SI', 'HU', 'MT', 'NL', 'AT', 'IS', 'LI', 'NO', 'SK', 'FI', 'SE', 'DE', 'EE', 'IE', 'EL'],
                        'wait_for_update': 500
                    });
                }
            }

                            function waitForConsent() {
                    return new Promise((resolve, reject) => {
                        let resolved = false;

                        function handleConsent(data, success) {
                            if (!resolved && success) {
                                const isComplete = data.eventStatus === 'tcloaded'
                                                || data.eventStatus === 'useractioncomplete';
                                const isNotGdpr  = data.gdprApplies === false;

                                if (isComplete || isNotGdpr) {
                                    resolved = true;
                                    resolve(data);
                                }
                            }
                        }

                        // Initial state check
                        window.__tcfapi('getTCData', 2, handleConsent);

                        // Listen for future user actions
                        window.__tcfapi('addEventListener', 2, handleConsent);
                    });
                }

                function whenTcfApiReady(timeout = 5000, intervalMs = 100) {
                  return new Promise((resolve, reject) => {
                        const start = Date.now();
                        const iv = setInterval(() => {
                        if (typeof window.__tcfapi === 'function') {
                            clearInterval(iv);
                            resolve();
                        }
                        else if (Date.now() - start > timeout) {
                            clearInterval(iv);
                            reject(new Error('__tcfapi never appeared'));
                        }
                        }, intervalMs);
                    });
                }

                const userCountry = 'US';

                if (userCountry === 'GB') {
                    whenTcfApiReady().then(() => {

                        waitForConsent().then(tcData => {
                            if (tcData.gdprApplies !== false && !tcData.purpose?.consents?.[1]) {
                                loadGA4({"sporcle_platform":"Desktop"}, false);
                            } else {
                                loadGA4({"sporcle_platform":"Desktop"}, true);
                            }
                        })
                        .catch(() => {});
                    })
                    .catch(() => {
                        loadGA4({"sporcle_platform":"Desktop"}, true);
                    });
                } else {
                    loadGA4({"sporcle_platform":"Desktop"}, false);
                }
                    </script>
