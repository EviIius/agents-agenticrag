<ul id="mwEEM"><li id="mwEEQ"><span typeof="mw:Nowiki" id="mwEEU">†</span>- Defunct franchise.</li></ul>

</section></section><section data-mw-section-id="18" id="mwEEY" aria-labelledby="Teams_awaiting_their_first_NBA_championship"><div class="mw-heading mw-heading2"><h2 id="Teams_awaiting_their_first_NBA_championship">Teams awaiting their first NBA championship</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=List_of_NBA_franchise_postseason_droughts&amp;action=edit&amp;section=18" title="Edit section: Teams awaiting their first NBA championship"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
