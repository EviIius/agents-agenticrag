<a href="https://google.com/preferences/source?q=sportingnews.com" target="_blank" class="relative h-8 md:h-10 w-max -mt-1 mb-6 md:-mt-4 md:mb-10 rounded-4xl px-3 md:px-4 flex items-center gap-2 group bg-l2" data-testid="add-google--btn">
