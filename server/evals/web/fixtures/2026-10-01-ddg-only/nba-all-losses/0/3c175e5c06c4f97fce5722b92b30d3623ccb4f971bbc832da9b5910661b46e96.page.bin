    import { createApp } from 'vue';
    import { ButtonLogin } from 'components';
    import { mountVueComponent } from 'vueMount';

    mountVueComponent(
        '[data-vue="login-button"]',
        ButtonLogin,
    );
</script>

                <div data-vue="logged-in-icon" class="contents"></div>

<script type="module">
    import { LoggedInIcon } from 'components';
    import { mountVueComponent } from 'vueMount';

    const topicsElement = document.getElementById('login-topics-data');
    const suggestedElement = document.getElementById('login-suggested-ids-data');
    const topics = topicsElement ? JSON.parse(topicsElement.textContent) : [];
    const suggestedIds = suggestedElement ? JSON.parse(suggestedElement.textContent) : [];

    mountVueComponent(
        '[data-vue="logged-in-icon"]',
        LoggedInIcon,
        { topics, suggestedIds, edition: 'us' },
    );
</script>

            </div>
            
        </div>
    </div>
