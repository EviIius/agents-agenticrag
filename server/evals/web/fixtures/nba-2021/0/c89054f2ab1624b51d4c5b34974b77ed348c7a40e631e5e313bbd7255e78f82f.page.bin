	<script>
	(function ($) {
		var $root = $('.faw-newsletter-pum');

		function unlockScrollAndPinPopup() {
			$('html').css({ overflow: '', overflowY: '', height: '' });
			$('body').css({ overflow: '', overflowY: '', height: '', position: '' });
			$('.faw-newsletter-pum .pum-container, .faw-newsletter-pum.pum-container').css({
				position: 'fixed',
				top: '50%',
				left: '50%',
				transform: 'translate(-50%, -50%)',
				margin: 0
			});
		}

		function markNewsletterConfirmed() {
			$('.faw-newsletter-pum .faw-newsletter-popup').addClass('is-confirmed');
			unlockScrollAndPinPopup();
		}

		$(document).on('pumAfterOpen pumBeforeOpen', '.faw-newsletter-pum', unlockScrollAndPinPopup);
		$(window).on('scroll.fawNewsletterPopup resize.fawNewsletterPopup', function () {
			if ($('.faw-newsletter-pum.pum-active').length) {
				unlockScrollAndPinPopup();
			}
		});

		$(document).on('wpformsAjaxSubmitSuccess wpformsAjaxSubmitSuccessConfirmation', function () {
			if ($('.faw-newsletter-pum .wpforms-confirmation-container-full, .faw-newsletter-pum .wpforms-confirmation-container').length) {
				markNewsletterConfirmed();
			}
		});

		var popup = document.querySelector('.faw-newsletter-pum');
		if (popup && window.MutationObserver) {
			new MutationObserver(function () {
				if (popup.querySelector('.wpforms-confirmation-container-full, .wpforms-confirmation-container')) {
					markNewsletterConfirmed();
				}
			}).observe(popup, { childList: true, subtree: true });
		}
	})(jQuery);
	</script>
