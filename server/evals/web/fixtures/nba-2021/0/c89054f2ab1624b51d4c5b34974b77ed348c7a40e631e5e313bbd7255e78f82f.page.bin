    <style>
        /* Make labels visible */
        .comment-form-author label,
        .comment-form-email label,
        .comment-form-comment label,
        .comment-form-url label {
            display: block !important;
            margin-bottom: 5px;
            font-weight: 600;
        }

        .required {
            color: red;
        }

        #submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

