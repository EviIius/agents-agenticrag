.mobile-logo-wrap img {
	margin-left:18px;
}

/* css for mega menue */

.mega-dropdown-inner {
	padding: 20px 0px 0px 20px;
}

.mega-columns {
	color:white;
}

.menu-item-svg {
	width: calc(1em + 15px);
    margin: 5px;
}

.w-sidebar {
    margin-bottom: 25px;
}

.menu-item {
  display: flex;
  align-items: center; /* Vertically align logo and text */
  gap: 8px; /* Add space between logo and text */
  margin: 6px 0;
}

.menu-item img {
  width: 24px;  /* Set fixed logo size */
  height: 24px; /* Keep consistent height */
  object-fit: contain;
  vertical-align: middle;
}

.menu-item span {
  line-height: 1.2;
  display: inline-block;
}

@media (max-width: 400px) {
	.navbar-right{
		padding-left: 25px;
	}
}

.nba-trade-options li:hover {
    color: #1F82CC;
}
/* Chrome / Edge / Safari */
.nba-trade-options::-webkit-scrollbar {
    width: 6px;
}

.nba-trade-options::-webkit-scrollbar-track {
    background: #000;
}

.nba-trade-options::-webkit-scrollbar-thumb {
    background-color: #1F82CC;
    border-radius: 4px;
}

.nba-trade-options::-webkit-scrollbar-thumb:hover {
    background-color: #3a9be5;
}

/* Firefox */
.nba-trade-options {
    scrollbar-width: 6px;
    scrollbar-color: #1F82CC #000;
}
/* css for category ribbon */

.p-categories{
	width:115%;
}

.logo-div {
  display: flex;
  align-items: center;
  background: #000;
  border-radius: 40px;
  padding: 7px 8px;
  gap: 5px;
  flex-wrap: wrap;
	overflow: visible !important;
}

.logo-anchor {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.logo-anchor.main-team .logo-image {
  width: 32px;
  height: 32px;
  object-fit: cover;
  border-radius: 50%;
}

.logo-anchor .logo-image {
  width:auto;
 height:25px;
  object-fit: cover;
 
}

.logo-text {
  margin-left: 8px;
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  white-space: nowrap;
}

.divider {
  color: #fff;
  font-size: 14px;
  opacity: 0.7;
  
}

@media (max-width: 768px) {
  .logo-div {
    padding: 6px 10px;
		margin-top: 18px;
   margin-bottom: -5px;
  }
  .logo-text {
    font-size: 11px;
  }
  .logo-anchor.main-team .logo-image {
    width: 28px;
    height: 28px;
  }
}

@media (max-width: 480px) {
  .logo-div {
    gap: 8px;
    border-radius: 30px;
  }
  .logo-text {
    font-size: 9px;
  }
  .divider {
    font-size: 16px;
  }
  .logo-anchor.sub-team .logo-image {
    width: 24px;
    height: 24px;
  }
}




.plus-tooltip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 25px;
  background: #000;
  color: #fff;
  border-radius: 50%;
  cursor: pointer;
  font-size: 18px;
  font-weight: 600;
  z-index: 10;
}

.plus-tooltip .tooltip-text {
  position: absolute;
  top: 36px;
  left: 50%;
  transform: translateX(-50%);
  display: none;
  flex-direction: row;
  align-items: center;
  gap: 10px;
  padding: 10px;
  background: #000;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0,0,0,0.25);
  z-index: 9999;
  white-space: nowrap;
  width: auto;
  height: auto;
}

.plus-tooltip:hover .tooltip-text {
  display: flex;
}

.tooltip-text .logo-image-tooltip {
  width: 28px;
  height: 28px;
  min-width: 28px;
  min-height: 28px;
  object-fit: cover;
  border-radius: 50%;
  flex-shrink: 0;
}

.plus-tooltip .tooltip-text::before {
  content: "";
  position: absolute;
  top: -6px;
  left: 50%;
  transform: translateX(-50%);
  border-left: 6px solid transparent;
  border-right: 6px solid transparent;
  border-bottom: 6px solid #000;
}

#back-top, #back-top {
    margin-bottom: 130px !important;
}

@media screen and (min-width: 768px) {
	body.archive.category .nba-title-mobile {
			width: 500px;
	}
}

@media (max-width: 767px) {
	[class*='ecat-bg-']:not(.is-m-list):not(.ecat-bg-3) .p-list-2 .p-top{
		padding:0px!important;
	}


	
	
	
	
	
	
	
	
	


</style>
