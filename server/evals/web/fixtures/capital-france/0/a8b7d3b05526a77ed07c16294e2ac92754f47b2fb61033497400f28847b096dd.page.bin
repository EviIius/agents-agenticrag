<tr style="vertical-align: top">
<td>20 mars 1977</td>
<td>16 mai 1995</td>
<td><span typeof="mw:File"><a href="https://fr.wikipedia.org/wiki/Fichier:Jacques_Chirac_(1997)_(cropped).jpg" class="mw-file-description"><img resource="https://fr.wikipedia.org/wiki/Fichier:Jacques_Chirac_(1997)_(cropped).jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Jacques_Chirac_%281997%29_%28cropped%29.jpg/120px-Jacques_Chirac_%281997%29_%28cropped%29.jpg?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/7/7b/Jacques_Chirac_%281997%29_%28cropped%29.jpg/250px-Jacques_Chirac_%281997%29_%28cropped%29.jpg?utm_source=fr.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1225" data-file-height="1715" data-file-type="bitmap" height="112" width="80" class="mw-file-element"/></a></span><br/><a rel="mw:WikiLink" href="https://fr.wikipedia.org/wiki/Jacques_Chirac" title="Jacques Chirac">Jacques Chirac</a></td>
