"wt":"Élu actuel","href":"./Modèle:Élu_actuel"},"params":{"Début":{"wt":"5 avril 2014"},"Fin":{"wt":"29 mars 2026"},"Identité":{"wt":"[[Fichier:Anne Hidalgo, février 2014 (cropped).jpg|80px]]&lt;br>[[Anne Hidalgo]]"},"Parti":{"wt":"[[Parti socialiste (France)|PS]]"},"Qualité":{"wt":"[[Inspection du travail (France)|Inspectrice du travail]]&lt;br>Première adjointe au maire de Paris (2001-2014)&lt;br>Conseillère régionale d&apos;[[Île-de-France]] (2004-2014)&lt;br>Première vice-présidente de la [[métropole du Grand Paris]] (2016-2024)"}},"i":4}},"\n",{"template":{"target":{"wt":"Élu actuel","href":"./Modèle:Élu_actuel"},"params":{"Début":{"wt":"29 mars 2026"},"Fin":{"wt":""},"Identité":{"wt":"[[Fichier:Emmanuel Grégoire (46632368425).jpg|80px]]&lt;br>[[Emmanuel Grégoire]]"},"Parti":{"wt":"[[Parti socialiste (France)|PS]]"},"Qualité":{"wt":"Conseiller de Paris (depuis 2014)&lt;br>Premier adjoint au maire de Paris (2018-2024)&lt;br>Député de Paris (2024-2026)"}},"i":5}},"\n",{"template":{"target":{"wt":"ÉluFin","href":"./Modèle:ÉluFin"},"params":{},"i":6}}]}'><style data-mw-deduplicate="TemplateStyles:r216827629" typeof="mw:Extension/templatestyles" about="#mwt1024" data-mw='{"name":"templatestyles","attrs":{"src":"MediaWiki:Common.css/Subdivisions administratives.css"}}'>.mw-parser-output .communes th[scope=col]{background-color:#ddffdd}.mw-parser-output .localites th[scope=col]{background-color:#ffffbb}.mw-parser-output .intercommunalites th[scope=col]{background-color:#ffe2bf}.mw-parser-output .cantons th[scope=col]{background-color:#ece5ca}.mw-parser-output .arrondissements th[scope=col]{background-color:#e1e1e1}.mw-parser-output .departements th[scope=col]{background-color:#f6f3dd}.mw-parser-output .regions th[scope=col]{background-color:#bbdefd}html.skin-theme-clientpref-night .mw-parser-output .communes th[scope=col]{background-color:#002a00}html.skin-theme-clientpref-night .mw-parser-output .localites th[scope=col]{background-color:#282800}html.skin-theme-client