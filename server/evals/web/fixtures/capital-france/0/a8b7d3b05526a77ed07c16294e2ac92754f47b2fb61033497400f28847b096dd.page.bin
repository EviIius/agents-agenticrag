<tbody><tr><td colspan="2" class="entete entete map" style="background-color:#DDFFDD;color:black;">Paris<span class="mw-empty-elt"><style data-mw-deduplicate="TemplateStyles:r228712713" typeof="mw:Extension/templatestyles" about="#mwt7" data-mw='{"name":"templatestyles","attrs":{"src":"Infobox/Pictogramme/map.css"},"body":{"extsrc":""}}'>.mw-parser-output .entete.map{background-image:url("//upload.wikimedia.org/wikipedia/commons/7/7a/Picto_infobox_map.png")}</style></span></td></tr>
