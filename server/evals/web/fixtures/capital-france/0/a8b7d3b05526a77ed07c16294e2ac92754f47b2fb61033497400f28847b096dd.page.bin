<li about="#cite_note-109" id="cite_note-109" data-mw-footnote-number="3"><span class="mw-cite-backlink" id="mwI4c"><a href="#cite_ref-109" data-mw-group="a" rel="mw:referencedBy" id="mwI4g"><span class="mw-linkback-text" id="mwI4k">↑</span></a></span> <span id="mw-reference-text-cite_note-109" class="mw-reference-text reference-text" data-mw-group="a"><i id="mwI4o">LOG T7 - Résidences selon le statut d'occupation</i>.</span></li>
