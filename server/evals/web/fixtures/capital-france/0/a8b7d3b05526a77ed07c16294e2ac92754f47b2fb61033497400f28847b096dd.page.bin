</section><section data-mw-section-id="127" id="mwI5k" aria-labelledby="Références"><div class="mw-heading mw-heading3"><h3 id="Références"><span id="R.C3.A9f.C3.A9rences" typeof="mw:FallbackId"></span>Références</h3></div>
