<span class="mw-empty-elt" about="#mwt3" typeof="mw:Transclusion" id="mwBA" data-mw='{"parts":[{"template":{"target":{"wt":"infobox settlement\n","href":"./Template:Infobox_settlement"},"params":{"name":{"wt":"Paris"},"settlement_type":{"wt":"[[Communes of France|Commune]] and [[Departments of France|department]]"},"image_skyline":{"wt":"{{Photomontage |border=0 |size=275 |spacing=2 |color=none |photo1a=Seine and Eiffel Tower from Tour Saint Jacques 2013-08.JPG |photo2a=Arc Triomphe (square).jpg |photo2b=Notre Dame dalla Senna.jpg |photo3a=Louvre Museum Wikimedia Commons.jpg}}"},"image_caption":{"wt":"Clockwise from top: [[wikt:skyline|skyline]] of Paris on the [[Seine]] with the [[Eiffel Tower]], [[Notre-Dame de Paris]], the [[Louvre]] and its [[Louvre Pyramid|large pyramid]], and the [[Arc de Triomphe]]"},"image_flag":{"wt":"Flag of Paris with coat of arms.svg"},"flag_size":{"wt":"95px"},"image_shield":{"wt":"Grandes_Armes_de_Paris.svg"},"shield_size":{"wt":"95px"},"motto":{"wt":"{{lang|fr|[[Fluctuat nec mergitur]]}}&lt;br /> {{smaller|\"Tossed by the waves but never sunk\"}}"},"coordinates":{"wt":"{{coord|48.8567|2.3508|type:city(2200000)_region:FR|format=dms|display=inline,title}}"},"pushpin_map":{"wt":"France#Europe#World"},"pushpin_map_caption":{"wt":"Location within France##Location within Europe"},"pushpin_relief":{"wt":"1"},"subdivision_type":{"wt":"[[List of sovereign states|Country]]"},"subdivision_name":{"wt":"[[France]]"},"subdivision_type1":{"wt":"[[Regions of France|Region]]"},"subdivision_name1":{"wt":"[[Île-de-France]]"},"subdivision_type2":{"wt":"[[Departments of France|Department]]"},"subdivision_name2":{"wt":"Paris"},"parts_type":{"wt":"[[Administrative division|Subdivisions]]"},"parts":{"wt":"[[Arrondissements of Paris|20 arrondissements]]"},"leader_title":{"wt":"Mayor"},"leader_name":{"wt":"[[Emmanuel Grégoire]] ([[Socialist Party (France)|PS]])"},"unit_pref":{"wt":"Metric"},"area_total_km2":{"wt":"105.4"},"population_total":{"wt":"2,140,526"},