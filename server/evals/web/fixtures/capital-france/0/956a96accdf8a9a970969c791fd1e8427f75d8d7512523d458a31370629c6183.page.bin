      }

      .signup-form {
        flex-direction: column;
        align-items: stretch;
        gap: 6px;
        padding: 0;
        background: transparent;
        border: none;
        border-radius: 0;
        box-shadow: none;
        overflow: visible;
      }

      .email-input {
        width: 100%;
        padding: 10px 12px;
        font-size: 12px;
        text-align: left;
        background-color: #ffffff;
        border: 1.1px solid rgba(221, 221, 221, 0.5);
        border-radius: 35px;
        box-shadow: 0 4.4px 6.6px rgba(0, 0, 0, 0.03);
        align-self: stretch;
      }

      .submit-btn {
