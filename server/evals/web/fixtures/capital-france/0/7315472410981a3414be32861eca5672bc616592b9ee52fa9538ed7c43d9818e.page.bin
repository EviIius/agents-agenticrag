,\"Paris\"]}]}],[\"$\",\"div\",null,{\"className\":\"prose\",\"children\":[null,[\"$\",\"p\",null,{\"children\":[\"Paris\",\" has been the capital of \",\"France\",\" since \",\"12th century\",\", Paris has been France's political and cultural capital since the medieval period, growing under the Capetian kings from the late 10th century into the national capital by the late 12th century\",\".\"]}],null,\"$undefined\",[[\"$\",\"p\",\"0\",{\"children\":\"Paris is France's largest city, and with its surrounding Île-de-France region it forms one of the most populous metropolitan areas in Europe.\"}]],[\"$\",\"p\",null,{\"className\":\"muted\",\"style\":{\"fontSize\":\"0.82rem\"},\"children\":[\"City facts sourced from\",\" \",[\"$\",\"a\",null,{\"className\":\"cite\",\"href\":\"https://en.wikipedia.org/wiki/Paris\",\"target\":\"_blank\",\"rel\":\"noopener\",\"children\":\"Wikipedia: Paris\"}],\".\"]}]]}]]\n"])</script><script>self.__next_f.push([1,"1f:[\"$\",\"div\",null,{\"className\":\"prose\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Frequently asked questions\"}],[\"$\",\"div\",null,{\"className\":\"faq\",\"children\":[[\"$\",\"details\",\"0\",{\"children\":[[\"$\",\"summary\",null,{\"children\":\"What is the capital of France?\"}],[\"$\",\"div\",null,{\"className\":\"faq-body\",\"children\":\"The capital of France is Paris.\"}]]}],[\"$\",\"details\",\"1\",{\"children\":[[\"$\",\"summary\",null,{\"children\":\"Is Paris the largest city in France?\"}],[\"$\",\"div\",null,{\"className\":\"faq-body\",\"children\":\"Yes. Paris is both the capital and the largest city of France.\"}]]}],[\"$\",\"details\",\"2\",{\"children\":[[\"$\",\"summary\",null,{\"children\":\"What is the population of Paris?\"}],[\"$\",\"div\",null,{\"className\":\"faq-body\",\"children\":\"Paris has a population of about 2,047,602 (2026 estimate), while its wider metropolitan area is home to around 13,320,752.\"}]]}],[\"$\",\"details\",\"3\",{\"children\":[[\"$\",\"summary\",null,{\"children