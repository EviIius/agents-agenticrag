l-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l6 6a.75.75 0 0 1 0 1.06l-6 6a.75.75 0 0 1-1.06-1.06L13.69 12 8.22 6.53a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"></path></svg>About</a></nav></div></div></header><main class="container reading" id="main"><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"City","name":"Paris","url":"https://flagdex.net/capital/france","containedInPlace":{"@type":"Country","name":"France"},"population":2047602},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the capital of France?","acceptedAnswer":{"@type":"Answer","text":"The capital of France is Paris."}},{"@type":"Question","name":"Is Paris the largest city in France?","acceptedAnswer":{"@type":"Answer","text":"Yes. Paris is both the capital and the largest city of France."}},{"@type":"Question","name":"What is the population of Paris?","acceptedAnswer":{"@type":"Answer","text":"Paris has a population of about 2,047,602 (2026 estimate), while its wider metropolitan area is home to around 13,320,752."}},{"@type":"Question","name":"Where is Paris located?","acceptedAnswer":{"@type":"Answer","text":"Paris sits on the Seine in the centre of the Île-de-France region in northern France; the river's banks through the city are a UNESCO World Heritage site."}},{"@type":"Question","name":"When did Paris become the capital of France?","acceptedAnswer":{"@type":"Answer","text":"Paris has been the capital of France since 12th century, Paris has been France's political and cultural capital since the medieval period, growing under the Capetian kings from the late 10th century into the national capital by the late 12th century."}},{"@type":"Question","name":"What time zone is Paris in?","acceptedAnswer":{"@type":"Answer","text":"Paris uses UTC+01:00 (CET)."}},{"@type":"Question","name":"What currency is used in Paris?","acceptedAnswer":{"@type":"Answer","text":"Paris, like the rest of France, uses the Euro (EUR, symbol €)."}}]},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://flagdex.net"},{"@type":"ListItem","position":2,"name":"Capitals","item":"https://flagdex.net/capitals"},{"@type":"ListItem","position":3,"name":"Capital of France","item":"https://flagdex.net/capital/france"}]}],"dateModified":"2026-07-02","publisher":{"@id":"https://flagdex.net/#organization"}}</script><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">/</span><a href="/capitals">Capitals</a><span class="sep">/</span><span>Capital of <!-- -->France</span></nav><h1>What is the capital of <!-- -->France<!-- -->?</h1><div class="answer-box"><span class="frame"><img src="/flags/fr.svg" alt="Flag of France" width="108" height="72" loading="eager" decoding="async"/></span><div class="answer-text">The capital of <!-- -->France<!-- --> is <strong>Paris</strong></div></div><div class="prose"><p>Paris sits on the Seine in the centre of the Île-de-France region in northern France; the river&#x27;s banks through the city are a UNESCO World Heritage site.</p><p>Paris<!-- --> is the capital and seat of government of <!-- -->France<!-- -->, a role it has held since 12th century<!-- -->.<!-- --> France itself has an estimated population of 68,720,337 (2025).</p><p>Paris<!-- --> is also the largest city in <!-- -->France<!-- -->, which is the usual arrangement, though it is far from universal:<!-- --> <a href="/capital-vs-largest-city">see the countries where capital and largest city differ</a>.</p></div><div class="section-head"><h2>Paris<!-- --> at a glance</h2></div><div class="facts-wrap"><table class="facts"><tbody><tr><th scope="row">City population</th><td>2,047,602<!-- --> (2026 estimate)</td></tr><tr><th scope="row">Metropolitan area</th><td>13,320,752<!-- --> (2023, Île-de-France)</td></tr><tr><th scope="row">Country</th><td><a href="/country/fr">🇫🇷<!-- --> <!-- -->France</a></td></tr><tr><th scope="row">Capital since</th><td>12th century</td></tr><tr><th scope="row">Largest city in <!-- -->France</th><td>Paris</td></tr><tr><th scope="row">Time zone</th><td><span class="code-val">UTC+01:00 (CET)</span></td></tr><tr><th scope="row">Currency</th><td>Euro<!-- --> <span class="code-val">(<!-- -->EUR<!-- -->)</span></td></tr></tbody></table></div><div class="section-head"><h2>About <!-- -->Paris</h2></div><div class="prose"><p>Paris<!-- --> has been the capital of <!-- -->France<!-- --> since <!-- -->12th century<!-- -->, Paris has been France&#x27;s political and cultural capital since the medieval period, growing under the Capetian kings from the late 10th century into the national capital by the late 12th century<!-- -->.</p><p>Paris is France&#x27;s largest city, and with its surrounding Île-de-France region it forms one of the most populous metropolitan areas in Europe.</p><p class="muted" style="font-size:0.82rem">City facts sourced from<!-- --> <a class="cite" href="https://en.wikipedia.org/wiki/Paris" target="_blank" rel="noopener">Wikipedia: Paris</a>.</p></div><div class="prose"><h2>Frequently asked questions</h2><div class="faq"><details><summary>What is the capital of France?</summary><div class="faq-body">The capital of France is Paris.</div></details><details><summary>Is Paris the largest city in France?</summary><div class="faq-body">Yes. Paris is both the capital and the largest city of France.</div></details><details><summary>What is the population of Paris?</summary><div class="faq-body">Paris has a population of about 2,047,602 (2026 estimate), while its wider metropolitan area is home to around 13,320,752.</div></details><details><summary>Where is Paris located?</summary><div class="faq-body">Paris sits on the Seine in the centre of the Île-de-France region in northern France; the river&#x27;s banks through the city are a UNESCO World Heritage site.</div></details><details><summary>When did Paris become the capital of France?</summary><div class="faq-body">Paris has been the capital of France since 12th century, Paris has been France&#x27;s political and cultural capital since the medieval period, growing under the Capetian kings from the late 10th century into the national capital by the late 12th century.</div></details><details><summary>What time zone is Paris in?</summary><div class="faq-body">Paris uses UTC+01:00 (CET).</div></details><details><summary>What currency is used in Paris?</summary><div class="faq-body">Paris, like the rest of France, uses the Euro (EUR, symbol €).</div></details></div><h2>Capitals of neighbouring countries</h2><div class="taglist"><a href="/capital/andorra">Capital of <!-- -->Andorra</a><a href="/capital/belgium">Capital of <!-- -->Belgium</a><a href="/capital/germany">Capital of <!-- -->Germany</a><a href="/capital/italy">Capital of <!-- -->Italy</a><a href="/capital/luxembourg">Capital of <!-- -->Luxembourg</a><a href="/capital/monaco">Capital of <!-- -->Monaco</a><a href="/capital/spain">Capital of <!-- -->Spain</a><a href="/capital/switzerland">Capital of <!-- -->Switzerland</a></div><p class="muted">See the full profile of <!-- -->France<!-- --> on its<!-- --> <a href="/country/fr">country page</a>, or browse<!-- --> <a href="/capitals">every capital city</a>.</p></div><p class="source-note">Capital and country data from open datasets; city and metropolitan populations are hand-curated per city and cited where they are shown. Populations of countries come from the World Bank (SP.POP.TOTL).<!-- --> Full sources and vintage on the <a href="/data">data page</a>.<!-- --> <span class="nowrap">Last updated <time dateTime="2026-07-02">2026-07-02</time>.</span> <a href="/contact?subject=Correction%3A%20Paris%2C%20capital%20of%20France%20(%2Fcapital%2Ffrance)">Report a correction</a>.</p></main><!--$--><!--/$--><footer class="site-footer"><div class="container"><div class="footer-top"><div class="footer-brand"><a class="brand" aria-label="Flagdex home" href="/"><svg width="30" height="30" viewBox="0 0 32 32" fill="currentCo