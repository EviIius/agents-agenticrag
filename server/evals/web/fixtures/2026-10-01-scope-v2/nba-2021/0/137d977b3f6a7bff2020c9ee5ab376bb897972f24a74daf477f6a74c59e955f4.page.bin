			<div class="page_content">

				<div class="panel panel--white">
										
					<div class="single-post__header">
						<div class="container--small">
							
                							<h4 class="single-post__category"><a href="https://blog.ticketmaster.com/category/sports/" class="category-name">Sports</a></h4>
							<h1 class="single-post__title h2">The Last 10 NBA Finals Winners, From the Knicks to the Warriors</h1>
							<div class="single-post__meta">
								<div class="single-post__meta-item">
									Jun 15, 2026								</div>
								<div class="single-post__meta-item">
									

    
    
            
    
    John Wheeler
								</div>
								<div class="single-post__meta-item">
									

    <ul class="social-share-icons social-share-icons--flush-left">

                    
            
            
                <li>
                    <a class="fb_share" data-url="https://blog.ticketmaster.com/nba-finals-winners/">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                </li>

            
                    
            
            
                <li>
                    <a class="twitter_share" data-url="https://blog.ticketmaster.com/nba-finals-winners/" data-text="The Last 10 NBA Finals Winners, From the Knicks to the Warriors" data-via="Ticketmaster">
                        <i class="fab fa-twitter"></i>
                    </a>
                </li>

            
                    
            
            
                <li>
                    <a href="mailto:?subject=The Last 10 NBA Finals Winners, From the Knicks to the Warriors&body=https://blog.ticketmaster.com/nba-finals-winners/" target="_blank">
                        <img src="https://blog.ticketmaster.com/wp-content/themes/ticketmaster-insider/img/icons/mail.svg" />
                    </a>
                </li>

            
                    
            
            
                <li>
                    <a class="copy-btn" data-clipboard-text="https://blog.ticketmaster.com/nba-finals-winners/">
                        <i class="fal fa-link"></i>
