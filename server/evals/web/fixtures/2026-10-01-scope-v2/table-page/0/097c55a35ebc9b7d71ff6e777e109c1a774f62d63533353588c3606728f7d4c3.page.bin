<p class="mw-empty-elt" id="mwAw"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt2" id="mwBA" data-mw='{"parts":[{"template":{"target":{"wt":"use American English","href":"./Template:Use_American_English"},"params":{"date":{"wt":"June 2023"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_American_English_from_June_2023" about="#mwt2"/><link rel="mw:PageProp/Category" href="./Category:All_Wikipedia_articles_written_in_American_English" about="#mwt2" id="mwBQ"/>
