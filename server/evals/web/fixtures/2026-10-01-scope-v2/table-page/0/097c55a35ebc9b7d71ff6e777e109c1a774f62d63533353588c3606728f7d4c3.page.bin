<tbody><tr><td style="border-style:none"><div style="font-size:85%"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/NBA_on_ABC" title="NBA on ABC">ABC</a></div></td></tr>
</tbody></table>
<table style="background-color:#eee; color:#202122; float:left; width:12%; table-layout:fixed">
<tbody><tr><td style="border-style:none"><div style="text-align:center">June 9<br/><small> 8:30 pm</small></div></td></tr>
</tbody></table>
<table style="background-color:#eee; color:#202122; float:left; width:7%; table-layout:fixed">
<tbody><tr><td style="border-style:none"><div style="font-size:85%"><a rel="mw:ExtLink nofollow" href="https://www.nba.com/game/den-vs-mia-0042200404" class="external text">Recap</a></div></td></tr>
</tbody></table>
<table style="background-color:#eee; color:#202122; float:left; width:50%; text-align:center">
<tbody><tr style="vertical-align:top">
