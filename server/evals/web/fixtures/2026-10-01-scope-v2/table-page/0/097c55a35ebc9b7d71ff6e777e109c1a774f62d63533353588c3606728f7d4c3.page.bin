</section><section data-mw-section-id="7" id="mwAZA" aria-labelledby="Game_summaries"><div class="mw-heading mw-heading2"><h2 id="Game_summaries">Game summaries</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2023_NBA_Finals&amp;action=edit&amp;section=7" title="Edit section: Game summaries"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<dl id="mwAZE"><dd id="mwAZI"><i id="mwAZM">Note: Times are <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eastern_Time_Zone" title="Eastern Time Zone" id="mwAZQ">EDT</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/UTC−4" title="UTC−4" class="mw-redirect" id="mwAZU">UTC−4</a>) as listed by the NBA. For games in Denver, the local time is also given (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mountain_Time_Zone" title="Mountain Time Zone" id="mwAZY">MDT</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/UTC−06:00" title="UTC−06:00" id="mwAZc">UTC−6</a>).</i></dd></dl>

<section data-mw-section-id="8" id="mwAZg" aria-labelledby="Game_1"><div class="mw-heading mw-heading3"><h3 id="Game_1">Game 1</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=2023_NBA_Finals&amp;action=edit&amp;section=8" title="Edit section: Game 1"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
