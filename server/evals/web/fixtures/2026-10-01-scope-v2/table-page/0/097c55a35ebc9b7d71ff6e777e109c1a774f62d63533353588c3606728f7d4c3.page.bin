<table class="wikitable" style="width:400px;font-size:95%;text-align:center"><tbody><tr><th colspan="7"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Eastern_Conference_(NBA)" title="Eastern Conference (NBA)">Eastern Conference</a></th></tr><tr><th style="width:5%">#</th><th>Team</th><th style="width:5%"><abbr title="Games won">W</abbr></th><th style="width:5%"><abbr title="Games lost">L</abbr></th><th style="width:5%"><abbr title="Winning percentage">PCT</abbr></th><th style="width:7.5%"><abbr title="Games behind">GB</abbr></th><th style="width:7.5%"><abbr title="Games played">GP</abbr></th></tr><tr><th>1</th><td style="text-align:left"><b>z</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Milwaukee_Bucks_season" title="2022–23 Milwaukee Bucks season">Milwaukee Bucks</a><span typeof="mw:Entity"> </span><span typeof="mw:Entity">*</span></td><td>58</td><td>24</td><td>.707</td><td>–</td><td>82</td></tr><tr><th>2</th><td style="text-align:left"><b>y</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Boston_Celtics_season" title="2022–23 Boston Celtics season">Boston Celtics</a><span typeof="mw:Entity"> </span><span typeof="mw:Entity">*</span></td><td>57</td><td>25</td><td>.695</td><td>1.0</td><td>82</td></tr><tr><th>3</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Philadelphia_76ers_season" title="2022–23 Philadelphia 76ers season">Philadelphia 76ers</a></td><td>54</td><td>28</td><td>.659</td><td>4.0</td><td>82</td></tr><tr><th>4</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Cleveland_Cavaliers_season" title="2022–23 Cleveland Cavaliers season">Cleveland Cavaliers</a></td><td>51</td><td>31</td><td>.622</td><td>7.0</td><td>82</td></tr><tr><th>5</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_New_York_Knicks_season" title="2022–23 New York Knicks season">New York Knicks</a></td><td>47</td><td>35</td><td>.573</td><td>11.0</td><td>82</td></tr><tr><th>6</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Brooklyn_Nets_season" title="2022–23 Brooklyn Nets season">Brooklyn Nets</a></td><td>45</td><td>37</td><td>.549</td><td>13.0</td><td>82</td></tr><tr style="background-color:#CCCCCC"><td colspan="7"></td></tr><tr style="background-color:#CCFFCC"><th>7</th><td style="text-align:left"><b>y</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Miami_Heat_season" title="2022–23 Miami Heat season">Miami Heat</a><span typeof="mw:Entity"> </span><span typeof="mw:Entity">*</span></td><td>44</td><td>38</td><td>.537</td><td>14.0</td><td>82</td></tr><tr><th>8</th><td style="text-align:left"><b>x</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Atlanta_Hawks_season" title="2022–23 Atlanta Hawks season">Atlanta Hawks</a></td><td>41</td><td>41</td><td>.500</td><td>17.0</td><td>82</td></tr><tr><th>9</th><td style="text-align:left"><b>pi</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Toronto_Raptors_season" title="2022–23 Toronto Raptors season">Toronto Raptors</a></td><td>41</td><td>41</td><td>.500</td><td>17.0</td><td>82</td></tr><tr><th>10</th><td style="text-align:left"><b>pi</b> – <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Chicago_Bulls_season" title="2022–23 Chicago Bulls season">Chicago Bulls</a></td><td>40</td><td>42</td><td>.488</td><td>18.0</td><td>82</td></tr><tr style="background-color:#CCCCCC"><td colspan="7"></td></tr><tr><th>11</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Indiana_Pacers_season" title="2022–23 Indiana Pacers season">Indiana Pacers</a></td><td>35</td><td>47</td><td>.427</td><td>23.0</td><td>82</td></tr><tr><th>12</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Washington_Wizards_season" title="2022–23 Washington Wizards season">Washington Wizards</a></td><td>35</td><td>47</td><td>.427</td><td>23.0</td><td>82</td></tr><tr><th>13</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Orlando_Magic_season" title="2022–23 Orlando Magic season">Orlando Magic</a></td><td>34</td><td>48</td><td>.415</td><td>24.0</td><td>82</td></tr><tr><th>14</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Charlotte_Hornets_season" title="2022–23 Charlotte Hornets season">Charlotte Hornets</a></td><td>27</td><td>55</td><td>.329</td><td>31.0</td><td>82</td></tr><tr><th>15</th><td style="text-align:left"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2022–23_Detroit_Pistons_season" title="2022–23 Detroit Pistons season">Detroit Pistons</a></td><td>17</td><td>65</td><td>.207</td><td>41.0</td><td>82</td></tr></tbody></table></td>

