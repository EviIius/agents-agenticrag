<tbody><tr><td style="border-style:none"><div style="font-size:85%"><a rel="mw:ExtLink nofollow" href="https://www.nba.com/game/gsw-vs-bos-0042100404" class="external text">Recap</a></div></td></tr>
</tbody></table>
<table style="background-color:#eee; color:#202122; float:left; width:50%; text-align:center">
<tbody><tr style="vertical-align:top">
<td colspan="3" style="text-align:center; border-style:none"><b><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Golden_State_Warriors" title="Golden State Warriors">Golden State Warriors</a></b> <b>107</b>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Boston_Celtics" title="Boston Celtics">Boston Celtics</a> 97
</td></tr>
<tr style="vertical-align:top; font-size:85%"><td style="text-align:center; border-style:none" colspan="3"><b>Scoring by quarter:</b> 27–<b>28</b>, 22–<b>26</b>, <b>30</b>–24, <b>28</b>–19</td></tr><tr style="vertical-align:top; font-size:85%">
<td style="width:48%; text-align:right; border-style:none"><b><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Point_(basketball)" title="Point (basketball)" class="mw-redirect">Pts</a>:</b> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Stephen_Curry" title="Stephen Curry">Stephen Curry</a> 43<br/><b><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Rebound_(basketball)" title="Rebound (basketball)">Rebs</a>:</b> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Andrew_Wiggins" title="Andrew Wiggins">Andrew Wiggins</a> 16<br/><b><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Assist_(basketball)" title="Assist (basketball)">Asts</a>:</b> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Draymond_Green" title="Draymond Green">Draymond Green</a> 8</td>
<td></td>
<td style="width:48%; text-align:left; border-style:none"><b>Pts:</b> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Jayson_Tatum" title="Jayson Tatum">Jayson Tatum</a> 23<br/><b>Rebs:</b> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Robert_Williams_III" title="Robert Williams III">Robert Williams III</a> 12<br/><b>Asts:</b> Jayson Tatum 6</td></tr><tr><td colspan="3" style="text-align:center; border-style:none"><i><b>Series tied 2–2</b></i></td></tr>
</tbody></table>
