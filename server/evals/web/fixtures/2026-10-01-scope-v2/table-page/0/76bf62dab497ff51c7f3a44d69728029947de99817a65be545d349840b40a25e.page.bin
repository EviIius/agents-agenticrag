section-pos="11/20" data-content="The Finals Stat: Warriors stifle Celtics again" data-content-id="794522" data-premium="false"><header data-type="headline"><h4 class="Text_text__6vd08 ArticleTile_tileTitle__rfEPH"><span class="MultiLineEllipsis_ellipsis__mpkNo" style="-webkit-line-clamp:3">The Finals Stat: Warriors stifle Celtics again</span></h4><p class="Text_text__6vd08 ArticleTile_tileSub__JlCp5"><span class="MultiLineEllipsis_ellipsis__mpkNo" style="-webkit-line-clamp:2">Golden State upholds the old adage that defense wins championships with a stifling performance to finish off Boston. </span></p></header></a></div><div class="ArticleTile_tileMeta__RljPE"><a href="/news/the-finals-stat-game-6-warriors-shut-down-celtics-over-last-3-games" class="Anchor_anchor__wnmj2 ArticleTile_tileMetaLink___ZvfC" data-is-external="false" data-has-more="false" data-has-children="true" title="Article link for The Finals Stat, Game 6: Warriors shut down Celtics over last 3 games" data-track="click" data-type="card" data-id="nba:tentpole-hub:top-story-module:card" data-pos="4/4" data-section="game-6:-warriors-103,-celtics-90" data-section-pos="11/20" data-content="The Finals Stat: Warriors stifle Celtics again" data-content-id="794522" data-premium="false"><div class="ArticleTile_tileTimestampSkeleton__8UET4 ArticleTile_tileTimestamp__73NJq"></div></a></div></div></article></div></li></ul></div></div></div></section><section class="NewsHero_newsBase__zawGu" data-has-siderail="true" template="default"><div class="MaxWidthContainer_mwc__ChCs_ NewsHero_newsContainer__ZdFPX" data-padding="false" data-ad-slot="false" data-max-width="xl"><h2 class="Text_text__6vd08 BlockTitle_base__2GNiO NewsHero_blockTitle__wO_lF" data-small="false" data-hide-small-border="false"><p class="NewsHero_title__SoOe3">GAME 5: WARRIORS 104, CELTICS 94</p></h2><div class="NewsHero_hero__eVhH3"><div class="NewsHero_heroInner__0r0eZ"><a href="/game/bos-vs-gsw-0042100405" class="Anchor_anchor__wnmj2 HeroArticleTile_link___eTGD" data-is-external="false" data-has-more="false" data-has-children="true" title="Article link for NBA Finals Game 5: Warriors vs. Celtics" data-sponser="false" data-track="click" data-type="card" data-id="nba:tentpole-hub:top-story-module:card" data-pos="1/4" data-section="game-5:-warriors-104,-celtics-94" data-section-pos="12/20" data-content="NBA Finals Game 5: Warriors vs. Celtics" data-content-id="792921" data-premium="false"><article class="HeroArticleTile_article__0AU2T"><div class="HeroArticleTile_videoContent__bPYIJ"><figure data-type="image" class="VideoThumbnail_figure__gfHhD HeroArticleTile_videoThumb__FLAyG" style="height:100%"><img src="https://cdn.nba.com/manage/2022/06/andrew-wiggins-driving-game-5-celtics.jpg" srcSet="https://cdn.nba.com/manage/2022/06/andrew-wiggins-driving-game-5-celtics.jpg?w=784&amp;h=441 1x, https://cdn.nba.com/manage/2022/06/andrew-wiggins-driving-game-5-celtics.jpg?w=1568&amp;h=882 2x" alt="NBA Finals Game 5: Warriors vs. Celtics" class="VideoThumbnail_image___FrxU" loading="lazy"/></figure></div><div class="HeroArticleTile_summary___I_yz"><div class="HeroArticleTile_summaryInner__nRi3g"><header data-type="headline"><h3 class="Text_text__6vd08 HeroArticleTile_title__Jxrmr"><span class="MultiLineEllipsis_ellipsis__mpkNo" style="-webkit-line-clamp:2">Wiggins double-double powers Warriors to 3-2 lead</span></h3><p class="Text_text__6vd08 HeroArticleTile_subtitle__doqz4"><span class="MultiLineEllipsis_ellipsis__mpkNo" style="-webkit-line-clamp:2">Warriors All-Star Andrew Wiggins puts up 26 points and 13 rebounds as Golden State pushes Boston to the brink with a 4th-quarter flurry.</span></p></header></div><div class="HeroArticleTile_timestampBlock__frqdc"><span class="HeroArticleTile_timestamp__Z0i6n">June 14, 2022</span></div></div></article></a></div><div class="NewsHero_aside__OnlCW"><ul class="RelatedArticleBlock_rab__4xdtb"><li class="RelatedArticleBlock_rabItem__YsG2A"><div class="ArticleTile_tile__YVZ55" data-padding="true" data-featured="true" data-podcast="false" data-sponser="false"><article class="ArticleTile_tileArticle__yiOwT"><a href="/watch/video/game-recap-warriors-104-celtics-94" class="Anchor_anchor__wnmj2 ArticleTile_tileThumnailLink__rzBfB" data-is-external="false" data-has-more="false" data-has-children="true" title="Article link for Game Recap: Warriors 104, Celtics 94" data-track="video" data-type="card" data-id="nba:tentpole-hub:top-story-module:card" data-pos="2/4" data-section="game-5:-warriors-104,-celtics-94" data-section-pos="12/20" data-content="Game Recap: Warriors 104, Celtics 94" data-content-id="793183" data-premium="false" data-franchise="Game Recap" data-cat-type="2022 NBA Finals: Warriors vs. Celtics" data-live-vod="vod"><div class="ArticleTile_tileImage__AdgpH"><figure data-type="image" class="VideoThumbnail_figure__gfHhD ArticleTile_tileThumbnail__XIMaF" style="height:100%"><img src="https://cdn.nba.com/manage/2022/06/BOS_GSW_G5_061322-2.jpg" srcSet="https://cdn.nba.com/manage/2022/06/BOS_GSW_G5_061322-2.jpg?w=735&amp;h=413 1x, https://cdn.nba.com/manage/2022/06/BOS_GSW_G5_061322-2.jpg?w=1470&amp;h=826 2x" alt="Game Recap: Warriors 104, Celtics 94" class="VideoThumbnail_image___FrxU" loading="lazy"/><div class="VideoThumbnail_base__yet4f"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 14 14" class="PlayVideoIcon_icon__vHhLK PlayVideoIcon_triangle__OB0w4" data-no-icon="true" role="presentation" style="height:24px;width:24px"><circle cx="7" cy="7" r="7" fill="currentColor"></circle><path d="m10.15 7.35-4.9 3.15V4.2z"></path></svg><span class="VideoThumbnail_runtime__oJK3B">02:56</span></div></figure></div></a><div class="ArticleTile_tileMain__rcp49"><div class="ArticleTile_tileMainContent__kMfmf"><a href="/watch/video/game-recap-warriors-104-celtics-94" class="Anchor_anchor__wnmj2 ArticleTile_tileHeadlineLink___NLZQ" data-is-external="false" data-has-more="false" data-has-children="true" title="Article link for Game Recap: Warriors 104, Celtics 94" data-track="video" data-type="card" data-id="nba:tentpole-hub:top-story-module:card" data-pos="2/4" data-section="game-5:-warriors-104,-celtics-94" data-section-pos="12/20" data-content="Game Recap: Warriors 104, Celtics 94" data-content-id="793183" data-premium="false" data-franchise="Game Recap" data-cat-type="2022 NBA Finals: Warriors vs. Celtics" data-live-vod="vod"><header data-type="headline"><h4 class="Text_text__6vd08 ArticleTile_tileTitle__rfEPH"><span class="MultiLineEllipsis_ellipsis__mpkNo" style="-webkit-line-clamp:3">Game Recap: Warriors 104, Celtics 94</span></h4><p class="Text_text__6vd08 ArticleTile_tileSub__JlCp5"><span class="MultiLineEllipsis_ellipsis__mpkNo" style="-webkit-line-clamp:2">Led by Andrew Wiggins 26 points and 13 rebounds, the Golden State Warriors defeated the Boston Celtics in Game five, 104-94. Klay Thompson (21 points, 5-11 3pt FG) and Stephen Curry (16 points, eight assists, 0-9 3pt FG) added a combined 37 points for the Warriors in the victory, while Jayson Tatum led all scorers with 27 points and 10 rebounds for the Celtics. The Warriors lead this best-of-seven series 3-2, with Game six taking place on Thursday, June 16</span></p></header></a></div><div class="ArticleTile_tileMeta__RljPE"><a href="/watch/video/game-recap-warriors-104-celtics-94" class="Anchor_anchor__wnmj2 ArticleTile_tileMetaLink___ZvfC" data-is-external="false" data-has-more="false" data-has-children="true" title="Article link for Game Recap: Warriors 104, Celtics 94" data-track="video" data-type="card" data-id="nba:tentpole-hub:top-story-module:card" data-pos="2/4" data-section="game-5:-warriors-104,-celtics-94" data-section-pos="12/20" data-content="Game Recap: Warriors 104, Celtics 94" data-content-id="793183" data-premium="false" data-franchise="Game Recap" data-cat-type="2022 NBA Finals: Warriors vs. Celtics" data-live-vod="vod"><div class="ArticleTile_tileTimestampSkeleton__8UET4 ArticleTile_tileTimesta