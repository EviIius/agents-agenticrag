"1610612744":"Golden State Warriors"},"players":{"56":"Gary Payton","1627780":"Gary Payton II"},"videoFranchises":{"nba-gametime-segments":"NBA GameTime Segments"},"videoFranchisesName":{},"videoCategories":{"tv-analysis-interpretation":"TV Analysis \u0026amp; Interpretation"},"videoTypes":{"features":"Features"},"nbatvSeries":{"gametime":"Gametime"},"videoNumPlays":0},"hideDisplayAds":false,"author":{"id":402,"name":"Kobi"},"categoryPrimary":{"name":"2022 NBA Finals: Warriors vs. Celtics","slug":"2022-nba-finals"}}]}},{"id":11,"type":"collection","title":"GAME 6: WARRIORS 103, CELTICS 90","value":{"layout":"top_story","collectionTitle":"GAME 6: WARRIORS 103, CELTICS 90","collectionContent":[{"id":794590,"type":"hyperlink","name":"nba-finals-game-6-warriors-vs-celtics","title":"NBA Finals, Game 6: Warriors vs. Celtics","status":"publish","slug":"nba-finals-game-6-warriors-vs-celtics","permalink":"https://www.nba.com/game/gsw-vs-bos-0042100406","excerpt":"Golden State secures its 4th championship in 8 years behind 34 points from Finals MVP Stephen Curry. ","timestamp":1655425714000,"date":"2022-06-17T00:28:34Z","modified":"2022-06-17T05:33:53Z","featuredImage":"https://cdn.nba.com/manage/2022/06/Championship_Graphic_16x9.png","category":"","url":"https://www.nba.com/game/gsw-vs-bos-0042100406","shortTitle":"Warriors finish off Celtics, clinch title","appUrl":"gametime://game/20220616/BOSGSW","ctaText":""},{"id":794933,"type":"video","name":"game-recap-warriors-103-celtics-90","title":"Game Recap: Warriors 103, Celtics 90","status":"publish","slug":"game-recap-warriors-103-celtics-90-yzfta8","permalink":"https://www.nba.com/watch/video/game-recap-warriors-103-celtics-90-yzfta8","excerpt":"Led by Stephen Currys 34 points (6-11 3pt FG), seven rebounds and seven assists, the Golden State Warriors defeated the Boston Celtics in Game six, 103-90. Andrew Wiggins (18 points, six rebounds, five assists, four steals, three blocks) and Draymond Green (12 points, 12 rebounds, eight assists) added a combined 30 points for the Warriors in the victory, while Jaylen Brown tallied 34 points and seven rebounds for the Celtics. With the victory, the Warriors have secured the franchises 7th NBA title, passing the Chicago Bulls (6) for the 3rd most championships in NBA history.","timestamp":1655442912000,"date":"2022-06-17T05:15:12Z","modified":"2025-01-14T20:19:30Z","featuredImage":"https://cdn.nba.com/manage/2022/06/USATSI_18549129-1-scaled.jpg","category":"2022 NBA Finals: Warriors vs. Celtics,2022 NBA Playoffs,Game Recap","coverImage":"","coverImageId":"","shortTitle":"","description":"","expirationDate":"","hideFromPlatform":"","videoCreationSource":"nbae-inhouse","entitlements":"free","videoName":"recap22_P406_GSWBOS.mp4","videoDuration":"03:09","videoDurationSeconds":189,"duration":"","mediaKindAssetId":"202206170059NBA_____VIDEOS__NBAE_2591708","mediakindExternalProgramId":"fake_202206170059NBA_____VIDEOS__NBAE_2591708_NBA_movie","mediaKindOperationStatus":"succeeded","videoIviCaid":"nba-manage-prod-1-794933","videoIviCType":"gameRecapHighlights","branchUrl":"https://nba.smart.link/2e64ifwhb?videoid=794933","seo":{},"videoAssets":{},"attributes":{},"leagueId":"","leagueFullName":"","league":"","languages":[],"taxonomy":{"categories":{"2022-nba-finals":"2022 NBA Finals: Warriors vs. Celtics","2022-nba-playoffs":"2022 NBA Playoffs","game-recap":"Game Recap"},"tags":{"75th-anniversary":"75th anniversary","andrew-wiggins":"Andrew Wiggins","basketball":"basketball","boston-celtics":"Boston Celtics","draymond-green":"Draymond Green","finals":"finals","game-recap":"game recap","golden-state-warriors":"golden state warriors","highlights":"highlights","jaylen-brown":"Jaylen Brown","nba":"nba","nba-finals":"NBA Finals","nba75":"nba75","recap":"recap","stephen-curry":"Stephen Curry"},"games":{"0042100406":"GSW @ BOS (0042100406)"},"teams":{"1610612738":"Boston Celtics","1610612744":"Golden State Warriors"},"players":{"201939":"Wardell Curry","203110":