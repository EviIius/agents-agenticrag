="19/20" data-content="Top Finals moments: Smith, Olajuwon save day in 1995" data-content-id="601695" data-premium="false"><div class="ArticleTile_tileTimestampSkeleton__8UET4 ArticleTile_tileTimestamp__73NJq"></div></a></div></div></article></div></li><li class="NewsStrip_nsItem__w0qp8"><div class="ArticleTile_tile__YVZ55 NewsStrip_nsArticle__hzZzi" data-padding="true" data-featured="false" data-podcast="false" data-sponser="false"><article class="ArticleTile_tileArticle__yiOwT"><a href="/news/history-finals-moments-john-paxson-3-pointer-1993" class="Anchor_anchor__wnmj2 ArticleTile_tileThumnailLink__rzBfB" data-is-external="false" data-has-more="false" data-has-children="true" title="Article link for Top NBA Finals moments: John Paxson&#x27;s 3-pointer seals three-peat for Bulls" data-track="click" data-type="card" data-id="nba:tentpole-hub:newsstripshort:card" data-pos="17/24" data-section="top-finals-moments" data-section-pos="19/20" data-content="Top Finals moments: Paxson&#x27;s 3 seals three-peat" data-content-id="601682" data-premium="false"><div class="ArticleTile_tileImage__AdgpH"><figure data-type="image" class="VideoThumbnail_figure__gfHhD ArticleTile_tileThumbnail__XIMaF" style="height:100%"><img src="https://cdn.nba.com/manage/2017/05/john-paxson-shoots-1993-finals-archive.jpg" srcSet="https://cdn.nba.com/manage/2017/05/john-paxson-shoots-1993-finals-archive.jpg?w=384&amp;h=224 1x" alt="Top NBA Finals moments: John Paxson&#x27;s 3-pointer seals three-peat for Bulls" class="VideoThumbnail_image___FrxU" loading="lazy"/></figure></div></a><div class="ArticleTile_tileMain__rcp49"><div class="ArticleTile_tileMainContent__kMfmf"><a href="/news/history-finals-moments-john-paxson-3-pointer-1993" class="Anchor_anchor__wnmj2 ArticleTile_tileHeadlineLink___NLZQ" data-is-external="false" data-has-more="false" data-has-children="true" title="Article link for Top NBA Finals moments: John Paxson&#x27;s 3-pointer seals three-peat for Bulls" data-track="click" data-typ