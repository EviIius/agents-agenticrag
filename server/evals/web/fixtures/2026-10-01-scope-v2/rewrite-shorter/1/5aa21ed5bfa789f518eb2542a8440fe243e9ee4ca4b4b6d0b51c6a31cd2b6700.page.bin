{\"children\":\"tailscale status\"}]}],\" command and pass its output to the \",[\"$\",\"a\",null,{\"href\":\"https://jqlang.org/\",\"children\":[\"$\",\"code\",null,{\"children\":\"jq\"}]}],\" command-line JSON processor:\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"tailscale status --json | jq '.Self.CapMap.\\\"service-host\\\"'\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale status --json \",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token operator\",\"children\":[\"|\"]}],\" jq \",[\"$\",\"span\",\"fract-0-3\",{\"className\":\"token string\",\"children\":[\"'.Self.CapMap.\\\"service-host\\\"'\"]}],\"\\n\"]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"The \",[\"$\",\"code\",null,{\"children\":\"jq\"}],\" output should show the \",[\"$\",\"code\",null,{\"children\":\"service-host\"}],\" status.\"]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"configure-service-access\",\"children\":\"Configure Service access\",\"level\":4}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"You can use a Tailscale Service as a destination in \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/access-control/grants\",\"children\":\"grant\"}],\" access control policies.\"]}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Go to the \",[\"$\",\"$L14\",null,{\"href\":\"https://console.tailscale.com/admin/acls\",\"className\":\"!font-bold !text-[#3b82f6] underline decoration-blue-50 underline-offset-4 hover:!text-[#2563eb] hover:!decoration-[#3b82f6] focus-visible:no-underline\",\"children\":\"Access controls\"}],\" page of the a