726-43e80890dd4575db.js\",\"27282\",\"static/chunks/27282-769c2f0e9b3ebcab.js\",\"78958\",\"static/chunks/78958-99de291f66e7dbfd.js\",\"44888\",\"static/chunks/app/docs/not-found-72d44f838296c1ae.js\"],\"default\"]\n1c:I[78281,[\"72972\",\"static/chunks/72972-0a07a3915dc70b19.js\",\"95726\",\"static/chunks/95726-43e80890dd4575db.js\",\"27282\",\"static/chunks/27282-769c2f0e9b3ebcab.js\",\"78958\",\"static/chunks/78958-99de291f66e7dbfd.js\",\"44888\",\"static/chunks/app/docs/not-found-72d44f838296c1ae.js\"],\"default\"]\nb:[[\"$\",\"link\",null,{\"rel\":\"describedby\",\"href\":\"/docs/llms.txt\"}],[\"$\",\"main\",null,{\"className\":\"scope-kb is-wide container\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid grid-cols-10 gap-x-8 pt-4 md:pt-8\",\"children\":[[\"$\",\"aside\",null,{\"className\":\"js-docHighlight col-span-10 hidden md:col-span-3 md:row-span-2 md:block xl:col-span-2\",\"children\":[\"$\",\"$L10\",null,{}]}],[\"$\",\"$L8\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"docs\",\"children\"],\"error\":\"$11\",\"errorStyles\":[],\"errorScripts\":[],\"template\":[\"$\",\"$La\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$L12\",\"notFoundStyles\":[]}]]}]}]]\n1a:T422,# Run tailscale up \u003c...\u003e\n# Set up a few L7 endpoints:\n\ntailscale serve --service=\"svc:web-server\" --https=443 8080\ntailscale serve --service=\"svc:web-server\" --https=443 --set-path /mt2 8081\ntailscale serve --service=\"svc:web-server\" --http=80 3000\n\n# When you want to modify config, drain it first."])</script><script>self.__next_f.push([1,"\n\ntailscale serve drain svc:web-server\n\n# Wait until all connections close.\n\n# To only remove the endpoint configuration for the /mt2 path on port 443:\n\ntailscale serve --service=\"svc:web-server\" --https=443 --set-path /mt2 off\n\n# Then, advertise it again and it will only create one endpoint on HTTPS port 443\n\ntailscale serve advertise svc:web-server\n\n# To remove the endpoint configuration for HTTPS port 443:\n\ntailscale serve --service:\"svc:web-server\" --https=443 off\n# You will see a prompt asking you to confirm\n# After you confirm, it removes all configured endpoints on port 443 but preserves other port configured for the same service resource.\n# Advertise the service again without the removed HTTPS port:\n\ntailscale serve advertise svc:web-server\n"])</script><script>self.__next_f.push([1,"7:[[\"$\",\"div\",null,{\"className\":\"col-span-10 mb-8 md:col-span-7 xl:col-span-6\",\"children\":[[\"$\",\"section\",null,{\"className\":\"flex flex-col gap-6 pb-8 md:gap-8 md:pb-1.5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"order-first md:order-2\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Docs\\\",\\\"item\\\":\\\"/docs\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"Features\\\",\\\"item\\\":\\\"/docs/features\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Tailscale Services\\\",\\\"item\\\":\\\"/docs/features/tailscale-services\\\"}]}\"}}],[\"$\",\"$L13\",null,{\"children\":[\"$\",\"nav\",null,{\"aria-label\":\"breadcrumb\",\"children\":[\"$\",\"ol\",null,{\"className\":\"flex min-w-0 flex-wrap items-center gap-2 text-sm font-medium\",\"children\":[[\"$\",\"li\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"$L14\",null,{\"href\":\"/docs\",\"className\":\"transition-color cursor-pointer text-gray-600 hover:text-gray-800\",\"children\":\"Docs\"}],[\"$\",\"span\",null,{\"role\":\"presentation\",\"aria-hidden\":\"true\",\"className\":\"text-gray-500\",\"children\":\"›\"}]]}],[\"$\",\"li\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"$L14\",null,{\"href\":\"/docs/features\",\"className\":\"transition-color cursor-pointer text-gray-600 hover:text-gray-800\",\"children\":\"Features\"}],[\"$\",\"span\",null,{\"role\":\"presentation\",\"aria-hidden\":\"true\",\"className\":\"text-gray-500\",\"children\":\"›\"}]]}],[\"$\",\"li\",null,{\"className\":\"inline-flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"role\":\"link\",\"aria-disabled\":\"true\",\"aria-current\":\"page\",\"className\":\"text-gray-800\",\"children\":\"Tailscale Services\"}],false]}]]}]}]}]]}],[\"$\",\"$L15\",null,{\"fallback\":[\"$\",\"span\",null,{}],\"children\":[\"$\",\"div\",null,{\"className\":\"relative order-2 flex md:order-first md:max-w-lg\",\"children\":[\"$\",\"$L16\",null,{\"initialQuery\":\"$undefined\"}]}]}]]}],[\"$\",\"article\",null,{\"id\":\"main-content\",\"className\":\"prism markdown-content js-docHighlight order-3\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-4xl font-medium tracking-tight\",\"children\":\"Tailscale Services\"}],[\"$\",\"$L17\",null,{\"formattedDate\":\"Feb 2, 2026\",\"lastValidated\":\"2026-02-02\",\"docPath\":\"features/tailscale-services\"}],[\"$\",\"$L15\",null,{\"fallback\":[\"$\",\"$L11\",null,{}],\"children\":[\"$\",\"div\",null,{\"className\":\"ts-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Tailscale Services lets you publish internal resources (like databases or web servers) as named services in your Tailscale network, known as a tailnet.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Instead of connecting to specific devices, users connect to Tailscale Services using stable \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/magicdns\",\"children\":\"MagicDNS\"}],\" names while Tailscale automatically routes traffic to available hosts across your infrastructure.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"This approach decouples your resources from the devices hosting them. For example, a database service remains accessible at the same address even when you migrate it to a different host, add redundant hosts for high availability, or route traffic across regions. You gain built-in traffic steering, granular access control, approval workflows, and the ability to configure different endpoint types for different layers of the networking stack.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Tailscale Services increases reliability, leverages Tailscale's access-controlled routing, and provides a centralized way to manage all internal resources available in your Tailscale network. You can focus on maintaining your applications while Tailscale handles the networking complexity.\"}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"use-cases\",\"children\":\"Use cases\",\"level\":2}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"You can use Tailscale Services in a variety of scenarios to securely expose internal resources within your tailnet in a way that decouples them from the devices hosting them. For example:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Developer workflows and internal tooling\"}],\": Make any internal application or developer resource highly available, horizontally scalable, and secure without complex load balancer configurations.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Database connectivity\"}],\": Connect securely to database clusters (PostgreSQL, MySQL, RDS) with simplified connection scaling and identity-based access controls.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Cluster meshes\"}],\": Enable cross-cluster or hybrid-cloud connectivity between any compute resources like EC2 instances, Kubernetes services, or containers.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Version-controlled applications\"}],\": Generate stable hostnames for frequently updated, version-controlled, or ephemeral resources that persist across deployments.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"IoT integrations\"}],\": Stream device logs and telemetry securely to SIEM or logging services without exposing IoT devices to the public internet.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Internal APIs and webhooks\"}],\": Expose internal APIs securely without public domains or complex mTLS configurations while maintaining granular access control.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"prerequisites\",\"children\":\"Prerequisites\",\"level\":2}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"To get started with Tailscale Services, you must have:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"An active tailnet.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"One or more devices running Tailscale v1.86.0 or later, or an \",[\"$\",\"$L14\",null,{\"href\":\"/docs/install/unstable\",\"children\":\"unstable\"}],\" v1.87.x release.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/user-roles/\",\"className\":\"!font-medium !text-[#3b82f6] underline decoration-blue-50 underline-offset-4 hover:!text-[#2563eb] hover:!decoration-[#3b82f6] focus-visible:no-underline\",\"children\":\"Owner, Admin, or Network admin\"}],\" account permissions.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"An internal resource running on a device in a tailnet that you want to expose as a Tailscale Service. The device hosting the resource must use a \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/tags\",\"children\":\"tag-based\"}],\" identity.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"get-started\",\"children\":\"Get started\",\"level\":2}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"To get started with Tailscale Services, you need to define a Service through the admin console, configure an endpoint on a device (the host) in a tailnet, then advertise the endpoint.\"}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"step-1-define-a-tailscale-service\",\"children\":\"Step 1: Define a Tailscale Service\",\"level\":3}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"You define a Tailscale Service using the admin console. Each Tailscale Service consists of a MagicDNS name, a TailVIP (Tailscale Virtual IP address), a resource definition, and one or more back-end hosts.\"}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Open the \",[\"$\",\"$L14\",null,{\"href\":\"https://console.tailscale.com/admin/services\",\"className\":\"!font-bold !text-[#3b82f6] underline decoration-blue-50 underline-offset-4 hover:!text-[#2563eb] hover:!decoration-[#3b82f6] focus-visible:no-underline\",\"children\":\"Services\"}],\" page of the admin console.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Select \",[\"$\",\"strong\",null,{\"children\":\"Advertise\"}],\", and then select \",[\"$\",\"strong\",null,{\"children\":\"Define a Service\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Within the \",[\"$\",\"strong\",null,{\"children\":\"Define a Service\"}],\" dialog, provide a name and description for your Service.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Choose a port or set of endpoints your Service will advertise, including the \",[\"$\",\"code\",null,{\"children\":\"tcp:\"}],\" transport protocol prefix (for example, \",[\"$\",\"code\",null,{\"children\":\"tcp:443\"}],\"). Currently, TCP is the only supported transport protocol. Alternatively, enter \",[\"$\",\"code\",null,{\"children\":\"do-not-validate\"}],\" to skip endpoint validation.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"(Optional) Provide the Service with an identity by adding one or more \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/tags\",\"children\":\"tags\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Select \",[\"$\",\"strong\",null,{\"children\":\"Add service\"}],\".\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"You have now defined the Service interface. Next, you need to configure a tailnet device as a Service host.\"}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"step-2-configure-a-service-host\",\"children\":\"Step 2: Configure a Service host\",\"level\":3}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"A Service host is a Tailscale device that runs the Tailscale client and advertises one or more endpoints for a specific Tailscale Service. The host handles incoming connections to the Service and routes them to the appropriate resource. Hosts can advertise both local and remote resources.\"}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-orange-300 bg-orange-50 pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-orange-700\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"9\",\"x2\":\"12\",\"y2\":\"13\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"17\",\"x2\":\"12.01\",\"y2\":\"17\"}]]}]}],[\"$\",\"p\",null,{\"children\":[\"Any device you want to use as a Service host must use a \",[\"$\",\"$L14\",null,{\"href\":\"/docs/features/tags\",\"children\":\"tag-based identity\"}],\". You cannot use a device authenticated with a user account as a Service host.\"]}]]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-[#86efac] bg-[#f0fdf4] pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-[#15803d]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"}],[\"$\",\"polyline\",null,{\"points\":\"22 4 12 14.01 9 11.01\"}]]}]}],[[\"$\",\"p\",null,{\"children\":\"Make sure to start the resource on a device in a tailnet that you want to expose as a Tailscale Service. This resource can be a web server, database, or any other service that you want to make available through Tailscale.\"}],[\"$\",\"p\",null,{\"children\":[\"For example, you might start a basic web server using Node.js and the \",[\"$\",\"a\",null,{\"href\":\"https://www.npmjs.com/package/http-server\",\"children\":[[\"$\",\"code\",null,{\"children\":\"http-server\"}],\" package\"]}],\" that listens on port \",[\"$\",\"code\",null,{\"children\":\"8080\"}],\":\"]}],[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"# Install globally\\nnpm install -g http-server\\n\\n# Then start a basic web server\\nhttp-server -p 8080\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[[\"$\",\"span\",\"fract-0-0\",{\"className\":\"token comment\",\"children\":[\"# Install globally\"]}],\"\\n\",[\"$\",\"span\",\"fract-0-2\",{\"className\":\"token function\",\"children\":[\"npm\"]}],\" \",[\"$\",\"span\",\"fract-0-4\",{\"className\":\"token function\",\"children\":[\"install\"]}],\" -g http-server\\n\\n\",[\"$\",\"span\",\"fract-0-6\",{\"className\":\"token comment\",\"children\":[\"# Then start a basic web server\"]}],\"\\nhttp-server -p \",[\"$\",\"span\",\"fract-0-8\",{\"className\":\"token number\",\"children\":[\"8080\"]}],\"\\n\"]}]}]]}],[\"$\",\"p\",null,{\"children\":[\"This example starts a basic web server that serves static files from the current directory on port \",[\"$\",\"code\",null,{\"children\":\"8080\"}],\".\"]}],[\"$\",\"p\",null,{\"children\":\"After you have your resource running and listening for connections, you can configure it as a Service host.\"}]]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"You can configure a Service host using either the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}],\" CLI command or using a \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/tailscale-services-configuration-file\",\"children\":\"Service configuration file\"}],\".\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"Tailscale recommends using the CLI method because it automatically handles both configuration and advertisement, while the configuration file method gives you control over these as separate steps.\"}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Run the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}],\" command with the \",[\"$\",\"code\",null,{\"children\":\"--service\"}],\" flag followed by the service name, the protocol, the port number, and the destination:\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"tailscale serve --service=svc:web-server --https=443 127.0.0.1:8080\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve --service\",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token operator\",\"children\":[\"=\"]}],\"svc:web-server --https\",[\"$\",\"span\",\"fract-0-3\",{\"className\":\"token operator\",\"children\":[\"=\"]}],[\"$\",\"span\",\"fract-0-4\",{\"className\":\"token number\",\"children\":[\"443\"]}],\" \",[\"$\",\"span\",\"fract-0-6\",{\"className\":\"token number\",\"children\":[\"127.0\"]}],\".0.1:8080\\n\"]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"The command returns output similar to the following:\"}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"This machine is configured as a service host for `svc:web-server`, but approval from an admin is required. Once approved, it will be available in your Tailnet as:\\n\\nhttps://web-server.\u003ctailnet-name\u003e.ts.net:443/\\n|-- proxy http://127.0.0.1:8080\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"This machine is configured as a \",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token function\",\"children\":[\"service\"]}],\" \",[\"$\",\"span\",\"fract-0-3\",{\"className\":\"token function\",\"children\":[\"host\"]}],\" \",[\"$\",\"span\",\"fract-0-5\",{\"className\":\"token keyword\",\"children\":[\"for\"]}],\" \",[\"$\",\"span\",\"fract-0-7\",{\"className\":\"token variable\",\"children\":[[\"$\",\"span\",\"fract-1-0\",{\"className\":\"token variable\",\"children\":[\"`\"]}],\"svc:web-server\",[\"$\",\"span\",\"fract-1-2\",{\"className\":\"token variable\",\"children\":[\"`\"]}]]}],\", but approval from an admin is required. Once approved, it will be available \",[\"$\",\"span\",\"fract-0-9\",{\"className\":\"token keyword\",\"children\":[\"in\"]}],\" your Tailnet as:\\n\\nhttps://web-server.\",[\"$\",\"span\",\"fract-0-11\",{\"className\":\"token operator\",\"children\":[\"\u003c\"]}],\"tailnet-name\",[\"$\",\"span\",\"fract-0-13\",{\"className\":\"token operator\",\"children\":[\"\u003e\"]}],\".ts.net:443/\\n\",[\"$\",\"span\",\"fract-0-15\",{\"className\":\"token operator\",\"children\":[\"|\"]}],\"-- proxy http://127.0.0.1:8080\\n\"]}]}]]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],[\"$\",\"p\",null,{\"children\":[\"When you configure and advertise an endpoint using the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}],\" CLI command, it automatically uses background mode (which you would normally need to use the \",[\"$\",\"code\",null,{\"children\":\"--bg\"}],\" flag for when using the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}],\" command).\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"This command configures and automatically advertises an endpoint for the resource. When you use the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}],\" command with the HTTPS protocol, Tailscale automatically provisions a TLS certificate for your unique tailnet DNS name.\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Run the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve status\"}],\" command to verify your configuration:\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"tailscale serve status --json\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve status --json\\n\"]}]}]]}],\"\\n\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],[\"$\",\"p\",null,{\"children\":[\"To use \",[\"$\",\"a\",null,{\"href\":\"/docs/how-to/set-up-high-availability#regional-routing\",\"children\":\"regional routing\"}],\"'s in-region load balancing with Tailscale Services, you will need to enable it for your tailnet.\"]}]]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"step-3-approve-a-service-host\",\"children\":\"Step 3: Approve a Service host\",\"level\":3}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"If your tailnet has \",[\"$\",\"a\",null,{\"href\":\"/docs/reference/syntax/policy-file#autoapprovers\",\"children\":\"auto-approval\"}],\" policies set up for the Service, the host is automatically approved. If not, an \",[\"$\",\"$L14\",null,{\"href\":\"/docs/reference/user-roles/\",\"className\":\"!font-medium !text-[#3b82f6] underline decoration-blue-50 underline-offset-4 hover:!text-[#2563eb] hover:!decoration-[#3b82f6] focus-visible:no-underline\",\"children\":\"Admin, Network admin, or Owner\"}],\" must approve the host before it becomes active.\"]}],\"\\n\",[\"$\",\"ol\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Open the \",[\"$\",\"$L14\",null,{\"href\":\"https://console.tailscale.com/admin/services\",\"className\":\"!font-bold !text-[#3b82f6] underline decoration-blue-50 underline-offset-4 hover:!text-[#2563eb] hover:!decoration-[#3b82f6] focus-visible:no-underline\",\"children\":\"Services\"}],\" page of the admin console.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Select the name of the Service you created earlier.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Locate the pending advertisements in the \",[\"$\",\"strong\",null,{\"children\":\"Service hosts\"}],\" section.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Select \",[\"$\",\"strong\",null,{\"children\":\"Approve\"}],\".\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"After approval, the host becomes active and starts handling traffic for the Tailscale Service. Users in the tailnet can now connect to the Service using its MagicDNS name or IP addresses (provided they have the necessary access permissions).\"}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"step-4-access-tailscale-services-from-other-devices\",\"children\":\"Step 4: Access Tailscale Services from other devices\",\"level\":3}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"After you configure and approve a Tailscale Service, you need to ensure that other devices in your tailnet can discover and use the routes to the advertised resources.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Tailscale clients version 1.94 and later no longer require enabling \",[\"$\",\"code\",null,{\"children\":\"accept-routes\"}],\" to use Tailscale Services. This lets all clients leverage Tailscale Services by default while simultaneously not enabling \",[\"$\",\"code\",null,{\"children\":\"accept-routes\"}],\" which can lead to route clashes.\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note border-grey-200 relative mt-4 rounded border border-solid pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"circle\",null,{\"cx\":\"12\",\"cy\":\"12\",\"r\":\"10\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"16\",\"x2\":\"12\",\"y2\":\"12\"}],[\"$\",\"line\",null,{\"x1\":\"12\",\"y1\":\"8\",\"x2\":\"12.01\",\"y2\":\"8\"}]]}]}],[[\"$\",\"p\",null,{\"children\":[\"Linux devices running Tailscale version 1.93 or earlier don't discover new routes to Tailscale Services by default. You must explicitly enable accepting routes using the \",[\"$\",\"code\",null,{\"children\":\"--accept-routes\"}],\" flag with the \",[\"$\",\"a\",null,{\"href\":\"/docs/reference/tailscale-cli#set\",\"children\":[\"$\",\"code\",null,{\"children\":\"tailscale set\"}]}],\" command:\"]}],[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"sudo tailscale set --accept-routes\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[[\"$\",\"span\",\"fract-0-0\",{\"className\":\"token function\",\"children\":[\"sudo\"]}],\" tailscale \",[\"$\",\"span\",\"fract-0-2\",{\"className\":\"token builtin class-name\",\"children\":[\"set\"]}],\" --accept-routes\\n\"]}]}]]}]]]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"common-scenarios\",\"children\":\"Common scenarios\",\"level\":2}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"This section covers common scenarios for managing Tailscale Service hosts, including draining a host, removing a host configuration, and updating a Service host configuration.\"}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"drain-a-host\",\"children\":\"Drain a host\",\"level\":3}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"When you need to take a Service host offline, you should first drain the host. Draining a host stops it from accepting new incoming connections while letting existing connections to close gracefully.\"}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"Use the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve drain\"}],\" command to stop the host from advertising itself for a service (\",[\"$\",\"code\",null,{\"children\":\"svc:\u003cservice-name\u003e\"}],\"):\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"tailscale serve drain svc:\u003cservice-name\u003e\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve drain svc:\",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token operator\",\"children\":[\"\u003c\"]}],\"service-name\",[\"$\",\"span\",\"fract-0-3\",{\"className\":\"token operator\",\"children\":[\"\u003e\"]}],\"\\n\"]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"After you run the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve drain\"}],\" command, all associated endpoints on the host stop accepting new incoming connections. However, any ongoing connections remain alive until they close normally.\"]}],\"\\n\",[\"$\",\"p\",null,{\"children\":\"After all connections close gracefully, you can safely remove all relevant endpoint configurations.\"}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"remove-a-host-configuration\",\"children\":\"Remove a host configuration\",\"level\":3}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-[#FECACA] bg-[#FEF2F2] pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-[#b91c1c]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"polygon\",null,{\"points\":\"7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2\"}],[\"$\",\"line\",null,{\"x1\":\"15\",\"y1\":\"9\",\"x2\":\"9\",\"y2\":\"15\"}],[\"$\",\"line\",null,{\"x1\":\"9\",\"y1\":\"9\",\"x2\":\"15\",\"y2\":\"15\"}]]}]}],[\"$\",\"p\",null,{\"children\":\"Do not remove an endpoint configuration before draining it. Doing so abruptly ends all connections to the advertised resource.\"}]]}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"After draining the endpoint for a resource, you can remove its configuration using one of three ways: remove a specific endpoint (for a single \",[\"$\",\"code\",null,{\"children\":\"protocol:port\"}],\" endpoint mapping), remove the entire host configuration, or reset the configuration file. The best method depends on how much of the configuration file you want to preserve.\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"note relative mt-4 rounded border border-solid border-[#86efac] bg-[#f0fdf4] pb-2 pl-9 pr-3 pt-3 text-base leading-normal tracking-tight md:text-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"absolute left-3 top-3 inline-block h-[18px] w-[18px] text-[#15803d]\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":\"18px\",\"height\":\"18px\",\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":\"2\",\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"children\":[[\"$\",\"path\",null,{\"d\":\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"}],[\"$\",\"polyline\",null,{\"points\":\"22 4 12 14.01 9 11.01\"}]]}]}],[[\"$\",\"p\",null,{\"children\":[\"You can check your Service configuration file at any point using the \",[\"$\",\"code\",null,{\"children\":\"tailscale serve status\"}],\" command.\"]}],[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"tailscale serve status -json\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve status -json\\n\"]}]}]]}]]]}],\"\\n\",[\"$\",\"$L18\",null,{\"id\":\"remove-an-endpoint\",\"children\":\"Remove an endpoint\",\"level\":4}],\"\\n\",[\"$\",\"p\",null,{\"children\":[\"If you configured multiple endpoints for a single resource using different port numbers or protocols, you can use the \",[\"$\",\"code\",null,{\"children\":\"off\"}],\" argument to remove only a specific endpoint mapping. To remove a specific endpoint mapping for a resource for a specific port number, re-run the original \",[\"$\",\"code\",null,{\"children\":\"tailscale serve\"}],\" command (that you used to configure the endpoint) with the \",[\"$\",\"code\",null,{\"children\":\"off\"}],\" argument. You must run the command with the same values and flags as you did to set up the endpoint.\"]}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L19\",null,{\"text\":\"tailscale serve --service:\\\"svc:\u003cservice-name\u003e\\\" --https:\u003cport\u003e \u003cadditional-flags\u003e off\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve --service:\",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token string\",\"children\":[\"\\\"svc:\u003cservice-name\u003e\\\"\"]}],\" --https:\",[\"$\",\"span\",\"fract-0-3\",{\"className\":\"token operator\",\"children\":[\"\u003c\"]}],\"port\",[\"$\",\"span\",\"fract-0-5\",{\"className\":\"token operator\",\"children\":[\"\u003e\"]}],\" \",[\"$\",\"span\",\"fract-0-7\",{\"className\":\"token operator\",\"children\":[\"\u003c\"]}],\"additional-flags\",[\"$\",\"span\",\"fract-0-9\",{\"className\":\"token operator\",\"children\":[\"\u003e\"]}],\" off\\n\"]}]}]]}],\"\\n\",[\"$\",\"p\",null,{\"children