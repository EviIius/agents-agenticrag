<style>
	html.theme {
		transition: background-color 0.5s ease-in-out, color 0.5s ease-in-out;
	}
	html.theme .theme-text,
	html.theme a,
	html.theme [data-theme-preview] span {
		transition: color 0.5s ease-in-out, background-color 0.5s ease-in-out;
	}
	html.theme .theme-midtone {
		transition: color 0.5s ease-in-out;
	}
	html.theme {
		--accent: #E7040F;
		--accent-hover: var(--accent);
	}
	@media screen {
		
		
		html.theme[data-theme="sun"] {
			--accent: #E7040F;
			
			--project-tag-active-color: #ECE9E9;
			
		}
		
		
		html.theme[data-theme="default"] {
			--accent: #00449E;
			
			--project-tag-active-color: #ECE9E9;
			
		}
		
		
		html.theme[data-theme="mint"] {
			--accent: #137752;
			
			--project-tag-active-color: #ECE9E9;
			
		}
		
		
		html.theme[data-theme="grape"] {
			--accent: #FFA3D7;
			
			--project-tag-active-color: #2D113B;
			
		}
		
		
		html.theme[data-theme="charcoal"] {
			--accent: #CCCCCC;
			
			--project-tag-active-color: #1A1A1A;
			
		}
		
		
		html.theme[data-theme="deep-blue"] {
			--accent: #CDECFF;
			
