		}
		
		
		html.theme[data-theme="midnight"] {
			--accent: #96CCFF;
			
			--project-tag-active-color: #001B44;
			
		}
		
		
		html.theme[data-theme="terminal"] {
			--accent: #33FF66;
			
			--project-tag-active-color: #0A2A0A;
			
		}
		
	}
	@supports (color: color-mix(in srgb, #000 0%, #fff 100%)) {
		html.theme {
			--accent-hover: color-mix(in srgb, var(--accent) 80%, white 20%);
		}
	}
	@supports (color: lch(50% 0 0)) {
		html.theme {
			--accent-hover: lch(from var(--accent) calc(l + 20) c h);
		}
	}
	html.theme .theme-midtone {
		color: var(--accent);
	}
	html.theme a,
	html.theme a:visited {
		color: var(--accent);
	}
	html.theme a:hover,
	html.theme a:focus {
		color: var(--accent-hover);
	}
	html.theme a:focus-visible {
		outline-color: var(--accent);
	}
	html.theme blockquote.todo-quote {
		--todo-quote-bg: var(--accent);
		--todo-quote-fg: #fff;
		background: var(--todo-quote-bg);
		color: var(--todo-quote-fg);
		border-left: 0.4rem solid var(--todo-quote-fg);
		border-radius: 0.5rem;
		padding: 1rem 1.25rem;
		margin-left: 0;
		margin-right: 0;
		box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--todo-quote-bg) 70%, transparent);
	}
	html.theme blockquote.todo-quote a,
	html.theme blockquote.todo-quote a:visited {
		color: inherit;
	}
	html.theme blockquote.todo-quote.prod {
		display: none !important;
	}
	html.theme.black blockquote.todo-quote {
		--todo-quote-fg: #fff;
	}
	html.theme.near-white blockquote.todo-quote,
	html.theme.white blockquote.todo-quote {
		--todo-quote-fg: #111;
	}
	html.theme .footnotes {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
		font-size: 0.95rem;
	}
	html.theme .footnotes-sep {
		display: none;
	}
	html.theme .footnotes-list {
		counter-reset: footnotes;
		list-style: none;
		padding-left: 0;
		margin: 0.75rem 0 0;
	}
	html.theme .footnote-item {
		counter-increment: footnotes;
		display: grid;
		grid-template-columns: auto 1fr;
		column-gap: 0.55rem;
		align-items: baseline;
		padding: 0.25rem 0.45rem;
		margin: 0.35rem 0;
	}
	html.theme .footnote-item::before {
		content: counter(footnotes) ".";
		grid-column: 1;
		grid-row: 1;
	}
	html.theme .footnote-item > p {
		grid-column: 2;
		margin: 0;
	}
	html.theme .footnote-item:target {
		outline: 3px solid var(--footnote-target-outline, var(--accent));
		outline-offset: 0.2rem;
		border-radius: 0.35rem;
	}
	html.theme .footnote-ref,
	html.theme .footnote-backref {
		text-decoration: none;
		font-weight: 700;
	}
	html.theme .footnote-ref {
		font-size: 0.8em;
		vertical-align: super;
	}
	html.theme .footnote-backref {
		margin-left: 0.25rem;
	}
	html.theme .footnote-ref a,
	html.theme .footnote-backref {
		color: var(--accent);
	}
	@supports (color: color-mix(in srgb, #000 0%, transparent)) {
		html.theme {
			--footnote-target-outline: color-mix(in srgb, var(--accent) 62%, transparent);
		}
	}
	/*
		Eleventy Img transform adds width/height attrs;
		Reset the height so images stay proportional at narrow widths
	*/
	main table {
		margin-left: auto;
		margin-right: auto;
	}
	main p a,
	main li a,
	main td a {
		overflow-wrap: anywhere;
		word-break: break-word;
	}
	img {
		height: auto;
	}
</style>

	<script>
	(function() {
		const themeTarget = document.documentElement;
		const defaultThemeId = themeTarget.dataset.defaultTheme;
		const autoLightThemeId = themeTarget.dataset.autoLightTheme || defaultThemeId;
		const autoDarkThemeId = themeTarget.dataset.autoDarkTheme || defaultThemeId;
		const preferenceStorageKey = 'themePreference';
		const themeConfig = [{"id":"sun","label":"Sun (black / washed-yellow)","classes":["black","bg-washed-yellow"],"midtoneClass":"gold","accent":"#E7040F","project":{"tagActiveColor":"#ECE9E9"}},{"id":"default","label":"Default","classes":["black","bg-white"],"midtoneClass":"mid-gray","accent":"#00449E","project":{"tagActiveColor":"#ECE9E9"}},{"id":"mint","label":"Mint (black / washed-green)","classes":["black","bg-washed-green"],"midtoneClass":"dark-green","accent":"#137752","project":{"tagActiveColor":"#ECE9E9"}},{"id":"grape","label":"Grape (near-white / purple)","classes":["near-white","bg-purple"],"midtoneClass":"light-purple","accent":"#FFA3D7","project":{"tagActiveColor":"#2D113B"}},{"id":"charcoal","label":"Charcoal (near-white / mid-gray)","classes":["near-white","bg-mid-gray"],"midtoneClass":"light-silver","accent":"#CCCCCC","project":{"tagActiveColor":"#1A1A1A"}},{"id":"deep-blue","label":"Deep Blue (white / dark-blue)","classes":["white","bg-dark-blue"],"midtoneClass":"light-blue","accent":"#CDECFF","project":{"tagActiveColor":"#012A63"}},{"id":"midnight","label":"Midnight (near-white / navy)","classes":["near-white","bg-navy"],"midtoneClass":"moon-gray","accent":"#96CCFF","project":{"tagActiveColor":"#001B44"}},{"id":"terminal","label":"Terminal (green / near-black)","classes":["near-white","bg-near-black"],"midtoneClass":"light-green","accent":"#33FF66","project":{"tagActiveColor":"#0A2A0A"}}];
		const themeMap = themeConfig.reduce((map, theme) => {
			map[theme.id] = theme.classes;
			return map;
		}, {});
		const allThemeClasses = Array.from(new Set(themeConfig.flatMap(theme => theme.classes)));

		function getSystemThemeId() {
			if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
				return themeMap[autoDarkThemeId] ? autoDarkThemeId : defaultThemeId;
			}
			return themeMap[autoLightThemeId] ? autoLightThemeId : defaultThemeId;
		}

		function resolveThemeId(preference) {
			if (preference === 'auto') {
				return getSystemThemeId();
			}
			return themeMap[preference] ? preference : defaultThemeId;
		}

		let desiredPreference = themeTarget.dataset.themePreference || 'auto';
		try {
			const storedPreference = localStorage.getItem(preferenceStorageKey);
			if (storedPreference === 'auto' || themeMap[storedPreference]) {
				desiredPreference = storedPreference;
			} else {
				const storedTheme = localStorage.getItem('theme');
				if (storedTheme && themeMap[storedTheme]) {
					desiredPreference = storedTheme;
				}
			}
		} catch (error) {
			/* Ignore storage access errors and fall back to default theme. */
		}
		const desiredThemeId = resolveThemeId(desiredPreference);
		const desiredClasses = themeMap[desiredThemeId];
		if (!desiredClasses) return;
		themeTarget.classList.remove(...allThemeClasses);
		themeTarget.classList.add(...desiredClasses);
		themeTarget.dataset.theme = desiredThemeId;
		themeTarget.dataset.themePreference = desiredPreference;
	})();
</script>


	
		


