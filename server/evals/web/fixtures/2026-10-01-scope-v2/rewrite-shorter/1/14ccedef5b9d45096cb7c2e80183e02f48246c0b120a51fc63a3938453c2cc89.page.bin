<div class="sans-serif">
  
  <style>
    /* Fade + Slide Keyframe Animations */
    @keyframes slideFadeIn {
      from { transform: translateY(-10px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    @keyframes slideFadeOut {
      from { transform: translateY(0); opacity: 1; }
      to { transform: translateY(-10px); opacity: 0; }
    }
    .slide-fade-in { animation: slideFadeIn 0.3s ease forwards; }
    .slide-fade-out { animation: slideFadeOut 0.3s ease forwards; }

    /* Burger Menu Icon */
    #nav-toggle { position: relative; width: 2rem; height: 2rem; color: inherit; }
    .burger {
      position: absolute;
      top: 50%; left: 50%;
      width: 1.5rem; height: 1.25rem;
      transform: translate(-50%, -50%);
      display: flex; flex-direction: column;
      justify-content: space-between;
    }
    .burger div {
      width: 100%; height: 2px;
      background: currentColor;
      transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
    }
    /* active state: hide middle patty, rotate buns */
    #nav-toggle.opened .burger .patty {
      opacity: 0;
    }
    #nav-toggle.opened .burger .top-bun {
      transform: translateY(6px) rotate(45deg);
      width: 100%;
    }
    #nav-toggle.opened .burger .bottom-bun {
      transform: translateY(-6px) rotate(-45deg);
      width: 100%;
    }

    [data-theme-preview],
    [data-theme-mode-toggle] {
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    [data-theme-preview]:focus,
    [data-theme-mode-toggle]:focus {
      outline: none;
    }
    [data-theme-preview][data-active],
    [data-theme-mode-toggle][data-active] {
      box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.35);
    }
    [data-theme-preview]:hover,
    [data-theme-mode-toggle]:hover {
      transform: translateY(-2px);
    }
    [data-theme-mode-toggle] {
      position: relative;
    }
    [data-theme-mode-toggle] .theme-mode-surface {
      background: #f5f5f5;
      color: #111;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    [data-theme-mode-toggle] .theme-mode-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .theme-auto-icon {
      position: relative;
      width: 0.9rem;
      height: 0.9rem;
      display: inline-block;
      border: 1.5px solid currentColor;
      border-radius: 9999px;
      background: linear-gradient(90deg, currentColor 0 50%, transparent 50% 100%);
      overflow: hidden;
      opacity: 0.9;
    }
    .theme-auto-icon::before {
      content: '';
      position: absolute;
      top: 0.12rem;
      bottom: 0.12rem;
      left: 50%;
      width: 1px;
      transform: translateX(-50%);
      background: currentColor;
      opacity: 0.3;
    }
    .theme-auto-icon::after {
      content: none;
    }
    html.theme[data-theme="sun"] [data-theme-mode-toggle] .theme-auto-icon,
    html.theme[data-theme="default"] [data-theme-mode-toggle] .theme-auto-icon,
    html.theme[data-theme="mint"] [data-theme-mode-toggle] .theme-auto-icon {
      color: #111;
    }
    html.theme[data-theme="grape"] [data-theme-mode-toggle] .theme-auto-icon,
    html.theme[data-theme="charcoal"] [data-theme-mode-toggle] .theme-auto-icon,
    html.theme[data-theme="deep-blue"] [data-theme-mode-toggle] .theme-auto-icon,
    html.theme[data-theme="midnight"] [data-theme-mode-toggle] .theme-auto-icon,
    html.theme[data-theme="terminal"] [data-theme-mode-toggle] .theme-auto-icon {
      color: #f4f4f4;
    }
    .theme-mode-icon {
      width: 1rem;
      height: 1rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.875rem;
      line-height: 1;
    }
    .theme-mode-icon--light,
    .theme-mode-icon--dark {
      font-size: 0.9rem;
    }
    [data-theme-mode-toggle][data-theme-mode="auto"] .theme-mode-icon--light,
    [data-theme-mode-toggle][data-theme-mode="auto"] .theme-mode-icon--dark,
    [data-theme-mode-toggle][data-theme-mode="light"] .theme-mode-icon--auto,
    [data-theme-mode-toggle][data-theme-mode="light"] .theme-mode-icon--dark,
    [data-theme-mode-toggle][data-theme-mode="dark"] .theme-mode-icon--auto,
    [data-theme-mode-toggle][data-theme-mode="dark"] .theme-mode-icon--light,
    [data-theme-mode-toggle][data-theme-mode="custom"] .theme-mode-icon--light,
    [data-theme-mode-toggle][data-theme-mode="custom"] .theme-mode-icon--dark {
      display: none;
    }
    html.theme[data-theme="grape"] [data-theme-mode-toggle] .theme-mode-surface,
    html.theme[data-theme="charcoal"] [data-theme-mode-toggle] .theme-mode-surface,
    html.theme[data-theme="deep-blue"] [data-theme-mode-toggle] .theme-mode-surface,
    html.theme[data-theme="midnight"] [data-theme-mode-toggle] .theme-mode-surface,
    html.theme[data-theme="terminal"] [data-theme-mode-toggle] .theme-mode-surface {
      background: rgba(255, 255, 255, 0.08);
      color: #f4f4f4;
    }
    html.theme[data-theme="grape"] [data-theme-mode-toggle][data-theme-mode="auto"] .theme-mode-surface,
    html.theme[data-theme="charcoal"] [data-theme-mode-toggle][data-theme-mode="auto"] .theme-mode-surface,
    html.theme[data-theme="deep-blue"] [data-theme-mode-toggle][data-theme-mode="auto"] .theme-mode-surface,
    html.theme[data-theme="midnight"] [data-theme-mode-toggle][data-theme-mode="auto"] .theme-mode-surface,
    html.theme[data-theme="terminal"] [data-theme-mode-toggle][data-theme-mode="auto"] .theme-mode-surface {
      background: rgba(255, 255, 255, 0.08);
      color: #f4f4f4;
    }
    html.theme[data-theme="grape"] [data-theme-mode-toggle][data-theme-mode="light"] .theme-mode-surface,
    html.theme[data-theme="charcoal"] [data-theme-mode-toggle][data-theme-mode="light"] .theme-mode-surface,
    html.theme[data-theme="deep-blue"] [data-theme-mode-toggle][data-theme-mode="light"] .theme-mode-surface,
    html.theme[data-theme="midnight"] [data-theme-mode-toggle][data-theme-mode="light"] .theme-mode-surface,
    html.theme[data-theme="terminal"] [data-theme-mode-toggle][data-theme-mode="light"] .theme-mode-surface {
      background: #f4f4f4;
      color: #111;
    }
    html.theme[data-theme="sun"] [data-theme-mode-toggle][data-theme-mode="dark"] .theme-mode-surface,
    html.theme[data-theme="default"] [data-theme-mode-toggle][data-theme-mode="dark"] .theme-mode-surface,
    html.theme[data-theme="mint"] [data-theme-mode-toggle][data-theme-mode="dark"] .theme-mode-surface,
