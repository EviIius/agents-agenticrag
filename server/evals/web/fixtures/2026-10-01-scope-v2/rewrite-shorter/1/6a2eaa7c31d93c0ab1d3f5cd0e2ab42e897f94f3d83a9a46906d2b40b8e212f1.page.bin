<article class="post-article layout-default mx-auto max-w-[680px]" style="--post-accent: #3B82F6">
  
<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-4 font-mono text-[11px] text-muted">
