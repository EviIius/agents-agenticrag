<script>
document.addEventListener('DOMContentLoaded', function () {
  function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  document.querySelectorAll('form.js-subscribe').forEach(function (f) {
    f.setAttribute('data-t', String(Date.now() / 1000));
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = f.querySelector('.js-subscribe-msg');
      var btn = f.querySelector('button[type="submit"]');
      btn.disabled = true; msg.textContent = 'Sending…';
      fetch(f.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: f.email.value,
          source: f.getAttribute('data-source') || 'footer',
          path: location.pathname,
          query: location.search,
          company: (f.company && f.company.value) || '',
          t: f.getAttribute('data-t') || '',
          lang: (document.documentElement.lang || '') === 'en' ? '' : document.documentElement.lang
        })
      }).then(function (r) { return r.json(); }).then(function (d) {
        msg.textContent = d.message || d.error || 'Something went wrong — try again.';
        msg.style.color = d.ok ? '#059669' : '#DC2626';
        if (d.ok) {
          f.email.value = '';
          lsSet('sr_subscribed', '1');
          var s = document.getElementById('sr-slidein');
          if (s && !s.contains(f)) { s.classList.remove('sr-slidein-show'); }
        }
        btn.disabled = false;
      }).catch(function () {
        msg.textContent = 'Something went wrong — try again.';
        msg.style.color = '#DC2626';
        btn.disabled = false;
      });
    });
  });
});
</script>
  
    <script>
    (function () {
      try {
        var n = navigator, s = screen, PX = "/learn/px";
        /* The page navigation's Sec-Fetch-Site. The edge echoes it as Server-Timing sfs,
           the one response header this script can read (navigation timing). Empty when
           the edge does not add it or the browser does not expose serverTiming. */
        var navSfs = function () {
          try {
            var nav = performance.getEntriesByType("navigation")[0];
            var st = (nav && nav.serverTiming) || [];
            for (var i = 0; i < st.length; i++) {
              if (st[i].name === "sfs") { return String(st[i].description || ""); }
            }
          } catch (e) {}
          return "";
        };
        var post = function (obj) {
          var b = new Blob([JSON.stringify(obj)], { type: "application/json" });
          if (!(n.sendBeacon && n.sendBeacon(PX, b))) {
            fetch(PX, { method: "POST", body: b, keepalive: true });
          }
        };
        var t0, lastEvt, lastDepth = 0, active = 0, maxPct = 0, maxBottom = 0;
        var headings = [], curSec = null, secDwell = {}, clicks = [], sentClicks = 0;
        /* Three states, not two: secSeen is reach, secDwell is attention, secVmax is the
           skim. Dwell alone cannot separate a section nobody reached from one they scrolled
           past, and those two call for opposite edits. See apps/blog/analytics.py. */
        var secSeen = {}, secVmax = {}, secPtr = {}, lastTop = 0, lastVt = 0;
        /* Cursor as a reading proxy, desktop-only: a touch device has no hovering pointer,
           so ptype is recorded and an unlabelled zero is never read as disengagement. */
        var ptype = "";
        var recent = [], navigated = false;
        /* Report the STABLE key when the page has one (2026-08-14).
           `id` comes from the heading text, so it is translated and it changes whenever a
           page is re-derived with different wording, which silently orphans every recorded
           read. The 2026-08-13 retranslation did exactly that corpus-wide: 38 of 48 reads on
           one page pointed at ids that no longer existed, and the attention report showed
           "SKIPPED" for sections nobody had stopped reading.
           data-section is positional and survives rewording. Falling back to id keeps pages
           rendered before this shipped (and any cached HTML) reporting exactly as before,
           so nothing is lost while the corpus rolls over.
           NOTE: this comment ships to the browser, so it must stay free of em-dashes like
           the rest of the reader-facing HTML (tests/test_deals.py enforces it). */
        var buildHeadings = function () {
          headings = [];
          var hs = document.querySelectorAll("main h2[id], main h3[id]");
          for (var i = 0; i < hs.length; i++) {
            headings.push({ id: hs[i].getAttribute("data-section") || hs[i].id, el: hs[i] });
          }
        };
        var sectionAt = function (y) {
          var cur = null;
          for (var i = 0; i < headings.length; i++) {
            if (headings[i].el.offsetTop <= y) cur = headings[i].id; else break;
          }
          return cur;
        };
        var depth = function (force) {
          var now = Date.now();
          if (!force && now - lastDepth < 250) return;
          lastDepth = now;
          var d = document.documentElement;
          var h = Math.max(d.scrollHeight || 0, document.body ? document.body.scrollHeight : 0);
          var top = (window.pageYOffset || d.scrollTop || 0);
          /* px/s since the last sample; coarse by design, so one flick of the wheel is not
             read as reading speed. */
          if (lastVt) {
            var vdt = now - lastVt;
            if (vdt > 0) {
              var v = Math.abs(top - lastTop) * 1000 / vdt;
              if (curSec && v > (secVmax[curSec] || 0)) secVmax[curSec] = Math.round(v);
            }
          }
          lastVt = now; lastTop = top;
          var seen = top + innerHeight;
          if (seen > maxBottom) maxBottom = seen;
          if (h > 0) {
            var pct = Math.max(0, Math.min(100, Math.round(100 * seen / h)));
            if (pct > maxPct) maxPct = pct;
          }
          curSec = sectionAt(top + innerHeight * 0.35);
          if (curSec) secSeen[curSec] = 1;   /* reached, whether or not they stayed */
        };
        /* Throttled to 4/s: we want cursor liveness per section, not a trace. */
        var lastPtr = 0;
        var onPointer = function (e) {
          if (!ptype && e && e.pointerType) ptype = String(e.pointerType).slice(0, 8);
          var now = Date.now();
          if (now - lastPtr < 250) return;
          lastPtr = now;
          if (curSec) secPtr[curSec] = (secPtr[curSec] || 0) + 1;
        };
        var bump = function () {
          var now = Date.now();
          if (now - lastEvt < 30000) {
            var dt = now - lastEvt;
            active += dt;
            if (curSec) secDwell[curSec] = (secDwell[curSec] || 0) + dt;
          }
          lastEvt = now;
        };
        var CLICKY = { A: 1, BUTTON: 1, SUMMARY: 1, INPUT: 1, SELECT: 1, LABEL: 1,
                       TEXTAREA: 1, IMG: 1, SVG: 1, VIDEO: 1 };
        var looksClickable = function (el) {
          for (var i = 0; el && el.tagName && i < 4; i++, el = el.parentElement) {
            if (CLICKY[el.tagName]) return true;
            var role = el.getAttribute && el.getAttribute("role");
            if (role && /button|link|tab|menuitem|checkbox|switch/.test(role)) return true;
            try { if (getComputedStyle(el).cursor === "pointer") return true; } catch (e) {}
          }
          return false;
        };
        var isRealInteractive = function (el) {
          for (var i = 0; el && el.tagName && i < 4; i++, el = el.parentElement) {
            var tg = el.tagName;
            if (tg === "A") {
              var href = el.getAttribute("href");
              if (href && href.charAt(0) !== "#") return true;
            } else if (tg === "BUTTON" || tg === "SUMMARY" || tg === "INPUT" ||
                       tg === "SELECT" || tg === "TEXTAREA" || tg === "LABEL") return true;
          }
          return false;
        };
        var describe = function (el) {
          if (!el || !el.tagName) return null;
          var s = el.tagName.toLowerCase();
          if (el.id) s += "#" + el.id;
          else if (typeof el.className === "string") {
            var c = el.className.trim().split(/\s+/)[0];
            if (c) s += "." + c;
          }
          var txt = (el.textContent || "").replace(/\s+/g, " ").trim().slice(0, 32);
          if (txt) s += ' "' + txt + '"';
          return s.slice(0, 80);
        };
        var onClick = function (e) {
          if (clicks.length >= 50) return;
          var el = e.target, d = document.documentElement;
          var pageH = Math.max(d.scrollHeight || 0, 1);
          var top = (window.pageYOffset || d.scrollTop || 0), absY = top + e.clientY;
          var rec = { x: Math.round(100 * e.clientX / Math.max(innerWidth, 1)),
                      y: Math.round(100 * absY / pageH), s: sectionAt(absY),
                      t: describe(el), d: 0, r: 0 };
          clicks.push(rec);
          var now = Date.now();
          recent.push({ t: now, x: e.clientX, y: e.clientY });
          recent = recent.filter(function (p) { return now - p.t <= 1000; });
          var near = 0;
          for (var i = 0; i < recent.length; i++) {
            if (Math.abs(recent[i].x - e.clientX) < 40 && Math.abs(recent[i].y - e.clientY) < 40) near++;
          }
          if (near >= 3) rec.r = 1;
          if (looksClickable(el) && !isRealInteractive(el)) {
            var mutated = false, mo;
            try {
              mo = new MutationObserver(function () { mutated = true; });
              mo.observe(document.body, { childList: true, subtree: true, attributes: true });
            } catch (e2) {}
            setTimeout(function () {
              if (mo) mo.disconnect();
              var moved = Math.abs((window.pageYOffset || d.scrollTop || 0) - top) > 8;
              var sel = false;
              try { sel = String(getSelection ? getSelection() : "").length > 0; } catch (e3) {}
              if (!navigated && !mutated && !moved && !sel) rec.d = 1;
            }, 700);
          }
        };
        var exit = function () {
          bump();
          depth(true);
          var sec = sectionAt(maxBottom);
          var pending = clicks.slice(sentClicks);
          sentClicks = clicks.length;
          var seen = [];
          for (var cid in ctaSeen) if (ctaSeen[cid] === 1) { seen.push(ctaSeen.d[cid]); ctaSeen[cid] = 2; }
          post({ k: "x", p: location.pathname, sd: maxPct, sec: sec,
                 at: Math.round(active / 1000), dur: Math.round((Date.now() - t0) / 1000),
                 secs: secDwell, secl: headings.map(function (h) { return h.id; }),
                 seen: secSeen, vmax: secVmax, cur: secPtr, ptype: ptype,
                 /* visible heading ids, same order: labels only, so the attention
                    report reads as prose instead of s1/s2/s3. */
                 secn: headings.map(function (h) { return h.el.id; }),
                 cv: (document.querySelector('meta[name="content-version"]') || {}).content,
                 clk: pending, cta: seen });
        };
        var ctaSeen = { d: {} };
        var ctaPayload = function (el) {
          return { c: el.getAttribute("data-cta"), v: el.getAttribute("data-cta-variant"),
                   g: "what-is-tailscale",
                   l: "en" };
        };
        var watchCtas = function () {
          var els = document.querySelectorAll("[data-cta]");
          if (!els.length) return;
          addEventListener("click", function (e) {
            var a = e.target.closest && e.target.closest("[data-cta]");
            if (!a) return;

            if (e.target.closest("input, select, textarea, label")) return;
            var pl = ctaPayload(a);
            var b = e.target.closest("button");
            pl.k = (b && a.contains(b)) ? "ctax" : "cta";
            pl.p = location.pathname;
            post(pl);
          }, true);
          if (!window.IntersectionObserver) return;
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              var id = en.target.getAttribute("data-cta");
              if (!en.isIntersecting) { clearTimeout(en.target._ctaT); return; }
              if (ctaSeen[id]) { io.unobserve(en.target); return; }
              en.target._ctaT = setTimeout(function () {
                if (ctaSeen[id]) return;
                ctaSeen[id] = 1; ctaSeen.d[id] = ctaPayload(en.target);
                io.unobserve(en.target);
              }, 1000);
            });
          }, { threshold: 0.5 });
          for (var i = 0; i < els.length; i++) io.observe(els[i]);
        };
        var start = function () {
          t0 = lastEvt = Date.now();
          buildHeadings();
          depth(true);
          addEventListener("pointermove", onPointer, { passive: true });
          addEventListener("pointerdown", onPointer, { passive: true });
          ["keydown", "pointerdown", "pointermove", "touchstart", "click"].forEach(function (e) {
            addEventListener(e, bump, { passive: true });
          });
          addEventListener("click", onClick, true);
          watchCtas();
          addEventListener("scroll", function () { bump(); depth(); }, { passive: true });
          document.addEventListener("visibilitychange", function () {
            if (document.visibilityState === "hidden") { exit(); } else { lastEvt = Date.now(); }
          });
          addEventListener("beforeunload", function () { navigated = true; });
          addEventListener("pagehide", exit);
          post({
            p: location.pathname,
            tz: (Intl.DateTimeFormat().resolvedOptions() || {}).timeZone,
            screen: s.width + "x" + s.height,
            viewport: innerWidth + "x" + innerHeight,
            dpr: String(devicePixelRatio || 1),
            webdriver: n.webdriver ? 1 : 0,
            cores: n.hardwareConcurrency || 0,
            memory: String(n.deviceMemory || ""),
            lang: n.language || "",
            r: document.referrer || "",
            sfs: navSfs()
          });
        };
        if (document.prerendering) {
          document.addEventListener("prerenderingchange", start, { once: true });
        } else {
          start();
        }
      } catch (e) {}
    })();
  </script>
  
<script>
(function () {
  try {
    var PX = "/learn/px";
    var t0 = Date.now(), lastEvt = t0, dirty = false, sentFinal = false;
    var sc = [], led = [], hov = {}, tap = {}, fq = [], fqSeen = {};
    var lastSc = 0, hovKey = null, hovT0 = 0;

    var label = function (el) {
      for (var e = el; e && e.getAttribute; e = e.parentElement) {
        var v = e.getAttribute("data-cta");
        if (v) return "cta:" + v;
        if (e.getAttribute("data-pid")) return "card:" + e.getAttribute("data-pid");
        if (e.getAttribute("data-deal-cycle")) return "mode:" + e.getAttribute("data-deal-cycle");
        if (e.getAttribute("data-deal-tab")) return "tab:" + e.getAttribute("data-deal-tab");
        if (e.getAttribute("data-faq")) return "faq:" + e.getAttribute("data-faq");
        var tag = e.tagName;
        if (tag === "A" && e.getAttribute("href"))
          return "link:" + (e.getAttribute("href") || "").split("?")[0].slice(0, 60);
        if ((tag === "H2" || tag === "H3") && e.id) return "h:" + e.id;
        if (tag === "PRE") return "code";
        if (tag === "BUTTON") return "btn:" + (e.id || (e.textContent || "").trim().slice(0, 20));
      }
      return null;
    };
    var mark = function (key) {
      if (!key || fqSeen[key]) { return; }
      fqSeen[key] = 1;
      if (fq.length < 20) fq.push(key);
    };
    var pct = function () {
      var d = document.documentElement;
      var s = d.scrollHeight - window.innerHeight;
      return s > 0 ? Math.max(0, Math.min(100,
        Math.round(100 * (window.scrollY || d.scrollTop || 0) / s))) : 0;
    };

    addEventListener("scroll", function () {
      lastEvt = Date.now();
      if (lastEvt - lastSc < 300 || sc.length >= 480) return;
      lastSc = lastEvt;
      sc.push([Math.round((lastEvt - t0) / 100), pct()]);
      dirty = true;
    }, { passive: true });

    ["pointermove", "keydown", "touchstart", "click"].forEach(function (e) {
      addEventListener(e, function () { lastEvt = Date.now(); }, { passive: true });
    });

    addEventListener("pointerover", function (e) {
      var k = label(e.target);
      if (k === hovKey) return;
      if (hovKey) hov[hovKey] = (hov[hovKey] || 0) + (Date.now() - hovT0);
      hovKey = k; hovT0 = Date.now();
      if (k) { mark(k); dirty = true; }
    }, { passive: true });

    addEventListener("pointerdown", function (e) {
      var k = label(e.target);
      if (k) { tap[k] = (tap[k] || 0) + 1; mark(k); dirty = true; }
    }, { passive: true });

    setInterval(function () {
      var state = document.hidden ? "h" : ((Date.now() - lastEvt) < 5000 ? "a" : "i");
      var last = led[led.length - 1];
      if (last && last[0] === state) { last[1]++; } else if (led.length < 400) { led.push([state, 1]); }
      dirty = true;
    }, 1000);

    var sends = 0;
    var send = function (force) {
      if (!dirty || (!force && sends >= 40)) return;
      dirty = false; sends++;
      if (hovKey) { hov[hovKey] = (hov[hovKey] || 0) + (Date.now() - hovT0); hovT0 = Date.now(); }
      var body = { k: "tr", p: location.pathname,
                   tr: { sc: sc.length > 240 ? sc.filter(function (_, i) { return i % 2 === 0; }) : sc,
                         led: led, hov: hov, tap: tap, fq: fq } };
      var b = new Blob([JSON.stringify(body)], { type: "application/json" });
      if (!(navigator.sendBeacon && navigator.sendBeacon(PX, b))) {
        fetch(PX, { method: "POST", body: b, keepalive: true }).catch(function () {});
      }
    };
    setInterval(function () { send(false); }, 30000);
    var finalSend = function () { if (!sentFinal) { dirty = true; send(true); } };
    addEventListener("pagehide", function () { finalSend(); sentFinal = true; });
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) finalSend();
    });
  } catch (e) {}
})();
</script>
  <style>
    /* Sticky header: in-page anchor targets must land BELOW it, not under it. 6rem clears
       the tallest (wrapped, two-row mobile) header; on desktop it just adds breathing room. */
    html { scroll-padding-top: 6rem; }
    /* The nav product CTA — a filled pill so the offer reads as a button, not another link.
       Carries the nav's mono/uppercase/tracking so it stays OF the header, just weighted.
       var(--post-accent) matches the card buttons' per-post accent, same fallback. */
    .nav-cta { background: var(--post-accent, #3B82F6); color: #fff; font-weight: 700;
      padding: .45rem .9rem; border-radius: 9999px; white-space: nowrap;
      transition: filter .12s; }
    .nav-cta:hover { filter: brightness(1.12); color: #fff; }
    /* Header split (owner call, 2026-07-29): mobile = brand + offer + burger, desktop = the
       full text nav with the pill pinned at the end. Native <details> burger; the opened
       menu is IN FLOW, so it expands the sticky header downward rather than overlaying. */
    .nav-burger > summary { display: inline-flex; align-items: center; cursor: pointer;
      list-style: none; padding: .3rem; }
    .nav-burger > summary::-webkit-details-marker { display: none; }
    .nav-burger > summary::marker { content: ""; }
    @media (min-width: 768px) {
      .nav-burger { display: none; }
      .site-nav { order: 2; }
      .nav-cta { order: 3; }
    }
    @media (max-width: 767.98px) {
      .site-nav { display: none; width: 100%; flex-direction: column;
        align-items: flex-start; gap: .9rem; padding: .6rem 0 .3rem; }
      .nav-burger[open] ~ .site-nav { display: flex; }
      .nav-cta { padding: .4rem .75rem; }
      .site-brand { letter-spacing: .08em; }
      /* the switcher's inline-start divider is a row artifact; drop it in the column menu */
      .lang-switch { border-inline-start: none; padding-inline-start: 0; margin-inline-start: 0; }
    }
    .blog-code-wrap { position: relative; }
    .blog-code-wrap .code-copy {
      position: absolute; top: 8px; right: 8px; z-index: 2;
      font: 600 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.04em; text-transform: uppercase;
      color: #cbd5e1; background: rgba(15,23,42,0.65); border: 1px solid rgba(148,163,184,0.35);
      border-radius: 6px; padding: 5px 9px; cursor: pointer; opacity: 0; transition: opacity .12s, color .12s, border-color .12s;
    }
    .blog-code-wrap:hover .code-copy, .blog-code-wrap .code-copy:focus-visible { opacity: 1; }
    .blog-code-wrap .code-copy:hover { color: #fff; border-color: rgba(148,163,184,0.7); }
    .blog-code-wrap .code-copy.copied { color: #34d399; border-color: rgba(52,211,153,0.6); opacity: 1; }
    /* The clipboard API can refuse (focus, permission, insecure context). Say so rather
       than leave a button that reads as broken. */
    .blog-code-wrap .code-copy.copy-failed { color: #fca5a5; border-color: rgba(252,165,165,0.6); opacity: 1; }
    @media (hover: none) { .blog-code-wrap .code-copy { opacity: 1; } }
    /* RTL page (dir="rtl" on <html>): shell text flows RTL, but code, chart/tool widgets
       and quoted terminal output are LTR artifacts and must stay LTR — a reader runs the
       exact same commands. Physical-direction utilities that encode "end of line" flip. */
    [dir="rtl"] .blog-code-wrap, [dir="rtl"] pre,
    [dir="rtl"] .sr-mount, [dir="rtl"] .tool-mount { direction: ltr; text-align: left; }
    [dir="rtl"] .text-right { text-align: left; }
    [dir="rtl"] .ml-auto { margin-left: 0; margin-right: auto; }
    /* Language switcher (native <details> disclosure) — structure only; logical properties so
       it mirrors under dir="rtl" with no ar-specific rule. */
    .lang-switch{position:relative;text-transform:none;letter-spacing:normal;
      padding-inline-start:.75rem;margin-inline-start:.25rem;border-inline-start:1px solid var(--line,#E7E5E4)}
    .lang-switch>summary{display:inline-flex;align-items:center;gap:.4rem;cursor:pointer;list-style:none}
    .lang-switch>summary::-webkit-details-marker{display:none}
    .lang-switch>summary::marker{content:""}
    .lang-switch>summary:focus-visible{outline:2px solid currentColor;outline-offset:3px}
    .lang-switch .lang-globe{inline-size:1em;block-size:1em;flex:none;opacity:.85}
    .lang-switch>summary:hover .lang-globe{opacity:1}
    .lang-switch .lang-caret{font-size:.8em;line-height:1;transition:transform .12s ease}
    .lang-switch[open] .lang-caret{transform:rotate(180deg)}
    .lang-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    /* Show the WHOLE list at a glance. Past ~12 languages a single column overflows the
       viewport, so lay the options out in a multi-column grid — 3 columns on desktop, 2 then 1
       as the screen narrows. Pure CSS on the native <details>, no capped scroll box that hides
       options. `auto` columns size to the widest endonym so nothing clips; the 1-column phone
       fallback keeps a max-height safety for an unusually short window. */
    .lang-menu{position:absolute;top:calc(100% + .5rem);inset-inline-end:0;z-index:50;
      display:grid;grid-template-columns:repeat(3,auto);gap:0 .15rem;max-width:calc(100vw - 1.5rem);
      margin:0;padding:.25rem;list-style:none;border-radius:8px;box-shadow:0 8px 28px rgba(15,23,42,.16)}
    @media (max-width:640px){.lang-menu{grid-template-columns:repeat(2,auto)}}
    @media (max-width:400px){.lang-menu{grid-template-columns:1fr;max-height:calc(100dvh - 5rem);overflow-y:auto}}
    .lang-menu li{margin:0}
    .lang-menu .lang-opt{display:flex;align-items:center;gap:.5rem;padding:.4rem .6rem;
      border-radius:6px;text-align:start;white-space:nowrap;text-decoration:none}
    .lang-menu .lang-mark{inline-size:1em;flex:none;text-align:center}
    /* The Tailwind build only emitted .bg-surface/70 (the header uses it); plain .bg-surface,
       added later on the switcher dropdown and the language banner, was never compiled — so the
       dropdown rendered with NO background and the page showed through. Define it here so the
       fix does not depend on a CSS rebuild. */
    .bg-surface{background-color:var(--color-surface, #fff)}
  </style>
  
  <script>
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.code-copy');
      if (!btn) return;
      var code = btn.parentElement.querySelector('code');
      if (!code) return;
      var text = code.textContent;
      if (btn.getAttribute('data-label') === null) btn.setAttribute('data-label', btn.textContent);
      var flash = function (label, cls) {
        btn.textContent = label;
        btn.classList.add(cls);
        setTimeout(function () {
          btn.textContent = btn.getAttribute('data-label');
          btn.classList.remove(cls);
        }, 1600);
      };
      var done = function () { flash(btn.getAttribute('data-copied') || 'Copied!', 'copied'); };
      var failed = function () { flash(btn.getAttribute('data-failed') || 'Press Ctrl+C', 'copy-failed'); };
      var legacy = function () {
        var ta = document.createElement('textarea');
        ta.value = text; ta.readOnly = true;
        ta.style.position = 'fixed'; ta.style.top = '0'; ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select(); ta.setSelectionRange(0, text.length);
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
        document.body.removeChild(ta);
        (ok ? done : failed)();
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(done).catch(legacy);
      } else {
        legacy();
      }
    });
  </script>
  <script>
    (function () {
      var PATH = "/learn";
      
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[data-setlang]');
        if (!a) return;
        document.cookie = 'lang=' + encodeURIComponent(a.getAttribute('data-setlang'))
          + '; path=' + PATH + '; max-age=31536000; samesite=lax';
      });
      var langSwitches = document.querySelectorAll('details.lang-switch');
      Array.prototype.forEach.call(langSwitches, function (d) {
        var s = d.querySelector('summary'); if (!s) return;
        var sync = function () { s.setAttribute('aria-expanded', d.open ? 'true' : 'false'); };
        sync(); d.addEventListener('toggle', sync);
      });
      var closeLangOutside = function (e) {
        Array.prototype.forEach.call(langSwitches, function (d) {
          if (d.open && !d.contains(e.target)) d.open = false;
        });
      };
      document.addEventListener('pointerdown', closeLangOutside);
      document.addEventListener('focusin', closeLangOutside);
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        Array.prototype.forEach.call(langSwitches, function (d) {
          if (d.open) { d.open = false; var s = d.querySelector('summary'); if (s) s.focus(); }
        });
      });
      var el = document.getElementById('lang-banner'), data = document.getElementById('lang-banner-data');
      if (!el || !data) return;
      var map; try { map = JSON.parse(data.textContent || '{}'); } catch (e) { return; }
      var normLang = function (tag) {
        tag = (tag || '').toLowerCase();
        var primary = tag.split('-')[0];
        if (primary === 'zh') { if (/hant|tw|hk|mo/.test(tag)) return ''; return 'zh-hans'; }
        return primary;
      };
      var pref = document.cookie.split('; ').reduce(function (acc, c) {
        var i = c.indexOf('='); return c.slice(0, i) === 'lang' ? decodeURIComponent(c.slice(i + 1)) : acc;
      }, '');
      var chosen = '';
      if (pref) {
        if (map[pref]) chosen = pref;
      } else {
        var navs = (navigator.languages && navigator.languages.length)
          ? navigator.languages : [navigator.language || ''];
        for (var i = 0; i < navs.length && !chosen; i++) {
          var code = normLang(navs[i]);
          if (code && map[code]) chosen = code;
        }
      }
      if (!chosen) return;
      pref = chosen;
      var key = 'lb_x_' + pref;
      try { if (sessionStorage.getItem(key) === '1') return; } catch (e) {}
      var link = document.getElementById('lang-banner-link');
      link.textContent = map[pref].text; link.href = map[pref].url;
      el.hidden = false;
      var x = document.getElementById('lang-banner-x');
      if (x) x.addEventListener('click', function () {
        el.hidden = true; try { sessionStorage.setItem(key, '1'); } catch (e) {}
      });
    })();
  </script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495" integrity="sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==" data-cf-beacon='{"version":"2024.11.0","token":"d2d602f2775c49029b2d89214051525d","spa":2}' crossorigin="anonymous"></script>
