             aria-label="Email address"
             style="flex:1 1 200px;min-width:0;border:1px solid var(--line,#E7E5E4);border-radius:8px;padding:0.5rem 0.85rem;font-size:0.9rem;background:#FFFFFF;color:#1C1917;">
      <button type="submit"
              style="flex:0 0 auto;background:var(--post-accent,#2563EB);color:#fff;font-weight:600;font-size:0.9rem;padding:0.5rem 1.1rem;border-radius:8px;border:0;cursor:pointer;">Send me the guide</button>
