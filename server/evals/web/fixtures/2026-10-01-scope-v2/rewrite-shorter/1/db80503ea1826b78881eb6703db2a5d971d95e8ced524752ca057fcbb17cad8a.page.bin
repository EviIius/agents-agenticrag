6033353,"textPrimary":4292929275,"textSecondary":4289312224,"invertedBackground":4286354659,"overlayBackground":3423146807},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"Oct 28"},"label":{"simpleText":"2025"},"accessibilityText":"Oct 28, 2025","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293981183,"raisedBackground":4293981183,"additiveBackground":558261193,"textPrimary":4278784823,"textSecondary":4281614964,"invertedBackground":4279841679,"overlayBackground":3423146807},"darkThemeColorPalette":{"baseBackground":4278323228,"raisedBackground":4278784823,"additiveBackground":726033353,"textPrimary":4292929275,"textSecondary":4289312224,"invertedBackground":4286354659,"overlayBackground":3423146807},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBUQ040EGAciEwjp7ZT28JmXAxV4AtsBHVbYMOfKAQSpaA06","commandMetadata":{"webCommandMetadata":{"url":"/@Tailscale","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCcdv38QxPjSMqbt5ffLhJLA","canonicalBaseUrl":"/@Tailscale"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/K3B5Hdi7j4zy2y53nlQCQb9J0qHNuSXhD2hWysrwaiDvv19tPr5RY04QuQfFOvb9rDq9cugGjZU=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Tailscale Services is a new beta feature that makes it easy to publish, load balance, and scale internal applications across your Tailnet. In this video, Alex walks through how to set up and use Tailscale Services to securely expose apps, manage TLS, and automatically route traffic to the best available instance. Whether you’re hosting apps at home or across cloud regions, Tailscale handles it all seamlessly.\n\nThis launch is part of the Tailscale Fall Update series, featuring new releases, live events, and deep dives every day this week. Watch the full demo to see how Tailscale Services works in practice, and join the community on Discord to share your feedback and use cases. Subscribe for more updates throughout the week.\n\nLinks: \n\nhttps://tailscale.com/blog/services-beta\nhttps://tailscale.com/blog/fall-updat...\n\nChapters:\n\n00:00 - Start\n01:41 - What is Tailscale Services?\n06:25 - Setting up a Tailscale Service from scratch\n13:25 - Outro","commandRuns":[{"startIndex":743,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwjp7ZT28JmXAxV4AtsBHVbYMOdIoJqW6bmQsKGYAcoBBKloDTo=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRWJpb3lrbnliT01lczJlbjlUMWtPVnxBTl9pYzRmd0JGcW9KNHJEWlZ0bFdGajJ2NU1qc0pvemtNWU9udlV6RXdMNThWOW9TRXQ3QzVCWW4wV0ZWVjlYMEFyVm9CX0FhWVJ2a0VyYm5QYXl4TEU4YlVyeTRFb2txUFM4\u0026q=https%3A%2F%2Ftailscale.com%2Fblog%2Fservices-beta\u0026v=mELAg50ljSA","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRWJpb3lrbnliT01lczJlbjlUMWtPVnxBTl9pYzRmd0JGcW9KNHJEWlZ0bFdGajJ2NU1qc0pvemtNWU9udlV6RXdMNThWOW9TRXQ3QzVCWW4wV0ZWVjlYMEFyVm9CX0FhWVJ2a0VyYm5QYXl4TEU4YlVyeTRFb2txUFM4\u0026q=https%3A%2F%2Ftailscale.com%2Fblog%2Fservices-beta\u0026v=mELAg50ljSA","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":784,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwjp7ZT28JmXAxV4AtsBHVbYMOdIoJqW6bmQsKGYAcoBBKloDTo=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljRTlTSW8tV205ejdrU0FlUmlBMm5vbnxBTl9pYzRmUWVxNlIyUThBR19yaVNyVWUyNXlNRnJ3YXpkcjZ6WnVqU0pid2dpdWhEdmJHZnBPSmV