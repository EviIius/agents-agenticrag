,{"languageCode":"tk","languageName":{"simpleText":"Turkmen"}},{"languageCode":"uk","languageName":{"simpleText":"Ukrainian"}},{"languageCode":"ur","languageName":{"simpleText":"Urdu"}},{"languageCode":"ug","languageName":{"simpleText":"Uyghur"}},{"languageCode":"uz","languageName":{"simpleText":"Uzbek"}},{"languageCode":"ve","languageName":{"simpleText":"Venda"}},{"languageCode":"vi","languageName":{"simpleText":"Vietnamese"}},{"languageCode":"war","languageName":{"simpleText":"Waray"}},{"languageCode":"cy","languageName":{"simpleText":"Welsh"}},{"languageCode":"fy","languageName":{"simpleText":"Western Frisian"}},{"languageCode":"wo","languageName":{"simpleText":"Wolof"}},{"languageCode":"xh","languageName":{"simpleText":"Xhosa"}},{"languageCode":"yi","languageName":{"simpleText":"Yiddish"}},{"languageCode":"yo","languageName":{"simpleText":"Yoruba"}},{"languageCode":"zu","languageName":{"simpleText":"Zulu"}}],"defaultAudioTrackIndex":10}},"videoDetails":{"videoId":"mELAg50ljSA","title":"An exciting new feature just dropped - Tailscale Services","lengthSeconds":"885","keywords":["tailscale","tailscale services","tailscale beta","tailscale fall update","secure networking","self-hosted apps","internal applications","load balancing","reverse proxy","devops","network security","zero trust","mesh networking","proxmox","node js","tailscale demo","tailscale tutorial","alex kretzschmar","vpn alternative","infrastructure automation"],"channelId":"UCcdv38QxPjSMqbt5ffLhJLA","isOwnerViewing":false,"shortDescription":"Tailscale Services is a new beta feature that makes it easy to publish, load balance, and scale internal applications across your Tailnet. In this video, Alex walks through how to set up and use Tailscale Services to securely expose apps, manage TLS, and automatically route traffic to the best available instance. Whether you’re hosting apps at home or across cloud regions, Tailscale handles it all seamlessly.\n\nThis launch is part of the Tailscale Fall Update series, featuring new releases, live events, and deep dives every day this week. Watch the full demo to see how Tailscale Services works in practice, and join the community on Discord to share your feedback and use cases. Subscribe for more updates throughout the week.\n\nLinks: \n\n- https://tailscale.com/blog/services-beta\n- https://tailscale.com/blog/fall-update-week-25\n\nChapters:\n\n00:00 - Start\n01:41 - What is Tailscale Services?\n06:25 - Setting up a Tailscale Service from scratch\n13:25 - Outro","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/mELAg50ljSA/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLBYcYoesAre6QE_KwpTTb9j8x2SiA","width":168,"height":94},{"url":"https://i.ytimg.com/vi/mELAg50ljSA/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLCMZVV6-loqsWJ14G4jRav62r4R-A","width":196,"height":110},{"url":"https://i.ytimg.com/vi/mELAg50ljSA/hqdefault.jpg?sqp=-oaymwEjCPYBEIoBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLBQlv762v3_wmPwCVqknd1j8lyg8g","width":246,"height":138},{"url":"https://i.ytimg.com/vi/mELAg50ljSA/hqdefault.jpg?sqp=-oaymwEjCNACELwBSFryq4qpAxUIARUAAAAAGAElAADIQj0AgKJDeAE=\u0026rs=AOn4CLBAS59gSp7PEuo7sus8i4Sfw1nVdw","width":336,"height":188},{"url":"https://i.ytimg.com/vi/mELAg50ljSA/maxresdefault.jpg","width":1920,"height":1080}]},"allowRatings":true,"viewCount":"72912","author":"Tailscale","isPrivate":false,"isUnpluggedCorpus":false,"isLiveContent":false,"isTvfilmVideo":false},"annotations":[{"playerAnnotationsExpandedRenderer":{"featuredChannel":{"startTimeMs":"5000","endTimeMs":"864000","watermark":{"thumbnails":[{"url":"https://i.ytimg.com/an/cdv38QxPjSMqbt5ffLhJLA/featured_channel.jpg?v=60089b3e","width":40,"height":40}]},"trackingParams":"CBAQ8zciEwiT5JT28JmXAxUP03IJHZ92KYU=","navigationEndpoint":{"clickTrackingParams":"CBAQ8zciEwiT5JT28JmXAxUP03IJHZ92KYUyAml2ygEEqWgNOg==","commandMetadata":{"webCommandMetadata":{