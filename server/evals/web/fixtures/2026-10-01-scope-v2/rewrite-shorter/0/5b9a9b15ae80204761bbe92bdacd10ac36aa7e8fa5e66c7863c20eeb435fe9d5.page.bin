e\"}],\" command accepts a target that can be a file, directory, text, or most commonly, the location to a service running on the local device. You can write the location to the local service as a port number (for example, \",[\"$\",\"code\",null,{\"children\":\"3000\"}],\"), a partial URL (for example, \",[\"$\",\"code\",null,{\"children\":\"localhost:3000\"}],\"), or a full URL including a path (for example, \",[\"$\",\"code\",null,{\"children\":\"tcp://localhost:3000/foo\"}],\", \",[\"$\",\"code\",null,{\"children\":\"https+insecure://localhost:3000/foo\"}],\").\"]}],\"\\n\",[\"$\",\"$L19\",null,{\"id\":\"use-https-and-http-servers\",\"children\":\"Use HTTPS and HTTP servers\",\"level\":2}],\"\\n\",[\"$\",\"div\",null,{\"className\":\"group relative overflow-hidden\",\"children\":[[\"$\",\"div\",null,{\"className\":\"absolute right-[5px] top-[21px] flex h-10 w-10 items-center justify-center rounded bg-gray-200 text-gray-1000 opacity-0 transition-opacity duration-200 group-hover:opacity-100\",\"children\":[\"$\",\"$L18\",null,{\"text\":\"tailscale serve --https=\u003cport\u003e \u003ctarget\u003e [off]\\ntailscale serve --http=\u003cport\u003e \u003ctarget\u003e [off]\\n\"}]}],[\"$\",\"pre\",null,{\"className\":\"refractor language-shell\",\"children\":[\"$\",\"code\",null,{\"className\":\"language-shell\",\"children\":[\"tailscale serve --https\",[\"$\",\"span\",\"fract-0-1\",{\"className\":\"token operator\",\"children\":[\"=\"]}],[\"$\",\"span\",\"fract-0-2\",{\"className\":\"token operator\",\"children\":[\"\u003c\"]}],\"port\",[\"$\",\"span\",\"fract-0-4\",{\"className\":\"token operator\",\"children\":[\"\u003e\"]}],\" \",[\"$\",\"span\",\"fract-0-6\",{\"className\":\"token operator\",\"children\":[\"\u003c\"]}],\"target\",[\"$\",\"span\",\"fract-0-8\",{\"className\":\"token operator\",\"children\":[\"\u003e\"]}],\" \",[\"$\",\"span\",\"fract-0-10\",{\"className\":\"token punctuation\",\"children\":[\"[\"]}],\"off\",[\"$\",\"span\",\"fract-0-12\",{\"classNam