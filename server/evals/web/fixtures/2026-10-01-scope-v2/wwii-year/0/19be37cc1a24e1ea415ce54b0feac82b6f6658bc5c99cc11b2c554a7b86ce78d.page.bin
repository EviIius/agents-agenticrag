<div class="card__content " >
<div class="card__header"></div>
<span class="card__title"><span class="card__title-text ">Heading Toward World War II in the Pacific</span></span>
<div class="card__byline mntl-card__byline " data-byline="By Kennedy Hickman"></div>
<div id="card-metadata_1-0" class="comp card-metadata mntl-card-metadata mntl-block text-label-200 card-metadata--vertical-divider" data-taxonomy="World War II"></div> </div>
</a>
<a id="mntl-card-list-items_2-0" class="comp mntl-card-list-items mntl-universal-card mntl-document-card mntl-card card card--no-image" data-tracking-subtype="Card #2" data-doc-id="2361485" data-tracking-target-url="https://www.thoughtco.com/world-war-ii-battle-of-greece-2361485" data-tax-levels href="https://www.thoughtco.com/world-war-ii-battle-of-greece-2361485" data-tracking-subcategory="Related Articles" data-ordinal="2" data-tracking-container="true" data-tracking-category="Recirc">
<div class="loc card__top">
<div class="card__media mntl-image card__media universal-image__container">
<div class="img-placeholder" style="padding-bottom:66.6%;">
<img
data-src="https://www.thoughtco.com/thmb/f36kdp78u-JJ80_Mffnxeqkbv2A=/282x188/filters:no_upscale():max_bytes(150000):strip_icc():focal(784x0:786x2)/battle-of-greece-large-56a61bea5f9b58b7d0dff538.jpg"
width="282"
height="188"
data-srcset="https://www.thoughtco.com/thmb/cEKkejD-8h7BXOdXK0t9GVMNqzA=/564x0/filters:no_upscale():max_bytes(150000):strip_icc():focal(784x0:786x2)/battle-of-greece-large-56a61bea5f9b58b7d0dff538.jpg 564w"
data-sizes="(min-width: 50em) 600px, 300px"
alt="German artillery during the Battle of Greece (1941)."
class="lazyload card__img universal-image__image"
