ps://welltica.com/wp-content/uploads/2025/01/cropped-cropped-w-2-32x32.png" sizes="32x32" /><link rel="icon" href="https://welltica.com/wp-content/uploads/2025/01/cropped-cropped-w-2-192x192.png" sizes="192x192" /><link rel="apple-touch-icon" href="https://welltica.com/wp-content/uploads/2025/01/cropped-cropped-w-2-180x180.png" /><meta name="msapplication-TileImage" content="https://welltica.com/wp-content/uploads/2025/01/cropped-cropped-w-2-270x270.png" /><style id="wp-custom-css">.td-banner-wrap-full.td-logo-wrap-full.td-container-wrap {
    display: none;
}

/* Desktop only */
@media only screen and (min-width: 1031px) { .desktop-only { display: block; } }
@media only screen and (max-width: 1030px) { .desktop-only { display: none; } }

/* iPad / Tablet only */
@media only screen and (min-width: 750px) and (max-width: 1030px) { .tablet-only { display: block; } }
@media only screen and (max-width: 749px), only screen and (min-width: 1031px) { .tablet-only { display: none; } }

/* Desktop and iPad/Tablet only (excluding mobile) */
@media only screen and (min-width: 750px) { .desktop-tablet-only { display: block; } }
@media only screen and (max-width: 749px) { .desktop-tablet-only { display: none; } }

/* Mobile only */
@media only screen and (max-width: 749px) { .mobile-only { display: block; } }
@media only screen and (min-width: 750px) { .mobile-only { display: none; } }


/* Target all container text to reduce redundant code - content provided below in queries */
.ad-container:has(.desktop_ad):before, .ad-container:has(.mobile_ad):before, .inArticleBanner:before
   {
     content: '';
     font-size: 10px !important;
     text-align: center;
     clear: right;
     display: block;
     color: #696969;
     letter-spacing: 2px;
     text-transform: uppercase;
 }
/* Ad Layout */
/* Desktop */
@media (min-width: 576px) {
    .ad-container:has(.desktop_ad), .inArticleBanner {
        background: #f5f5f554 !important;
      min-height: 300px;
      align-items: center;
      display: grid !important;
      place-content: start center !important;
      grid-template-rows: auto 1fr;
      padding: 5px 0 !important;
      position: relative;
			
    }
    .ad-container:has(.desktop_ad):before {
        content: 'Ad';
    }
}
/* Mobile */
@media (max-width: 576px) {
    .ad-container:has(.mobile_ad), .inArticleBanner {
        background: #F5F5F5 !important;
        min-height: 390px !important;
        align-items: center;
        display: grid !important;
        place-content: start center !important;
        grid-template-rows: auto 1fr;
        padding: 5px 0 !important;
        position: relative;
			width: 100vw;
      margin-left: -15px !important;
    }
    .inArticleBanner {
      min-height: 300px !important;
     }
    .ad-container:has(.mobile_ad):before {
        content: 'Ad';
    }
}
.inArticleBanner:before {
 content: 'The article continues after the ad:';
}
