    <div style="display: contents"><!--[--><!--[--><!--[--><!----><!--[--><!----><div class="spec-sheet bg-white text-gray-900 min-h-screen svelte-1srov1l"><div class="max-w-[210mm] mx-auto px-6 py-6"><header class="flex items-center justify-between border-b-2 border-purple-600 pb-4 mb-5"><div class="flex items-center gap-3"><img src="/gpu.png" alt="Flopper.io" class="w-8 h-8"/> <div><span class="text-lg font-bold"><span class="text-purple-600">Flop</span><span>per.io</span></span> <span class="text-xs text-gray-500 ml-2">GPU Specification Sheet</span></div></div> <div class="text-right text-xs text-gray-500"><div>October 1, 2026</div> <a href="https://flopper.io/gpu/apple-m5-pro" class="text-purple-600 hover:underline print:text-gray-600">flopper.io/gpu/apple-m5-pro</a></div></header> <section class="mb-5"><h1 class="text-2xl font-bold text-gray-900 mb-1">Apple M5 Pro</h1> <div class="flex flex-wrap items-center gap-2 text-sm text-gray-600"><!--[--><span class="inline-flex items-center px-2 py-0.5 bg-purple-100 text-purple-800 rounded text-xs font-medium">Apple M5</span><!--]--> <!--[--><span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-700 rounded text-xs font-medium">SoC</span><!--]--> <!--[--><span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-700 rounded text-xs font-medium">2026</span><!--]--> <!--[--><span class="inline-flex items-center px-2 py-0.5 bg-gray-100 text-gray-700 rounded text-xs font-medium">3nm</span><!--]--></div></section> <section class="mb-5"><h2 class="text-sm font-bold text-purple-600 uppercase tracking-wider mb-2 border-b border-gray-200 pb-1">Overview</h2> <div class="grid grid-cols-4 gap-3"><div class="text-center p-2 bg-gray-50 rounded"><div class="text-lg font-bold text-gray-900">8.3</div> <div class="text-xs text-gray-500">FP32 TFLOPS</div></div> <div class="text-center p-2 bg-gray-50 rounded"><div class="text-lg font-bold text-gray-900">64 GB</div> <div class="text-xs text-gray-500">Memory LPDDR5X</div></div> <div class="text-center p-2 bg-gray-50 rounded"><div class="text-lg font-bold text-gray-900">307 GB/s</div> <div class="text-xs text-gray-500">Memory Bandwidth</div></div> <div class="text-center p-2 bg-gray-50 rounded"><div class="text-lg font-bold text-gray-900">—</div> <div class="text-xs text-gray-500">TDP</div></div></div></section> <section class="mb-5"><h2 class="text-sm font-bold text-purple-600 uppercase tracking-wider mb-2 border-b border-gray-200 pb-1">Performance Metrics</h2> <table class="w-full text-sm"><thead><tr class="bg-gray-50"><th class="text-left py-1.5 px-2 font-semibold text-gray-700">Precision</th><th class="text-right py-1.5 px-2 font-semibold text-gray-700">Peak (dense)</th><!--[!--><!--]--><!--[!--><!--]--><th class="text-right py-1.5 px-2 font-semibold text-gray-700">Bits</th><th class="text-left py-1.5 px-2 font-semibold text-gray-700">Type</th></tr></thead><tbody><!--[--><tr class="bg-white border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">FP64</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-gray-50 border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">FP32</td><td class="py-1.5 px-2 text-right font-mono">8.3</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">32</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-white border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">TF32</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-gray-50 border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">BF16</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-white border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">FP16</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-gray-50 border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">FP8</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-white border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">FP6</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-gray-50 border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">FP4</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><tr class="bg-white border-b border-gray-100"><td class="py-1.5 px-2 font-medium text-gray-900">INT8</td><td class="py-1.5 px-2 text-right font-mono">—</td><!--[!--><!--]--><!--[!--><!--]--><td class="py-1.5 px-2 text-right text-gray-600">—</td><td class="py-1.5 px-2 text-gray-600 text-xs"><!--[!-->Standard<!--]--></td></tr><!--]--></tbody></table></section> <div class="grid grid-cols-2 gap-5"><section><h2 class="text-sm font-bold text-purple-600 uppercase tracking-wider mb-2 border-b border-gray-200 pb-1">Memory Specifications</h2> <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5 text-sm"><dt class="text-gray-500">Capacity</dt> <dd class="text-right font-medium">64 GB</dd> <dt class="text-gray-500">Type</dt> <dd class="text-right font-medium">LPDDR5X</dd> <dt class="text-gray-500">Bandwidth</dt> <dd class="text-right font-medium">307 GB/s</dd> <dt class="text-gray-500">Interface Width</dt> <dd class="text-right font-medium">—</dd></dl></section> <section><h2 class="text-sm font-bold text-purple-600 uppercase tracking-wider mb-2 border-b border-gray-200 pb-1">Power &amp; Efficiency</h2> <dl class="grid grid-cols-2 gap-x-3 gap-y-1.5 text-sm"><dt class="text-gray-500">TDP</dt> <dd class="text-right font-medium">—</dd> <dt class="text-gray-500" title="No verified maximum board power available">Max power</dt> <dd class="text-right font-medium"><!--[!--><!--[!-->—<!--]--><!--]--></dd> <dt class="text-gray-500">FP32 dense TFLOPS per W of TDP</dt> <dd class="text-right font-medium">—</dd> <dt class="text-gray-500">FP16 dense TFLOPS per W of TDP</dt> <dd class="text-right font-medium">—</dd></dl> <p class="mt-1.5 text-xs text-gray-500"><!--[!--><!--]--> Per W of TDP figures divide dense peak by accelerator TDP. Board power only: excludes host
          CPUs, networking, cooling and facility overhead.</p></section></div> <section class="mt-5"><h2 class="text-sm font-bold text-purple-600 uppercase tracking-wider mb-2 border-b border-gray-200 pb-1">Hardware Details</h2> <div class="grid grid-cols-3 gap-3 text-sm"><div><span class="text-gray-500">Vendor:</span> <span class="font-medium ml-1">Apple</span></div> <div><span class="text-gray-500">Architecture:</span> <span class="font-medium ml-1">Apple M5</span></div> <div><span class="text-gray-500">Process Node:</span> <span class="font-medium ml-1">3nm</span></div> <div><span class="text-gray-500">Form Factor:</span> <span class="font-medium ml-1">SoC</span></div> <div><span class="text-gray-500">Launch Year:</span> <span class="font-medium ml-1">2026</span></div> <!--[--><div><span class="text-gray-500">Variant:</span> <span class="font-medium ml-1">Pro</span></div><!--]--></div></section> <!--[!--><!--]--> <!--[!--><!--]--> <!--[!--><!--]--> <!--[--><section class="mt-5"><h2 class="text-sm font-bold text-purple-600 uppercase tracking-wider mb-2 border-b border-gray-200 pb-1">Enterprise Features</h2> <div class="grid grid-cols-3 gap-3 text-sm"><!--[!--><!--]--> <!--[!--><!--]--> <!--[--><div><span class="text-gray-500">Sparsity:</span> <span class="font-medium ml-1">No</span></div><!--]--></div></section><!--]--> <footer class="mt-6 pt-3 border-t-2 border-purple-600 flex items-center justify-between text-xs text-gray-500"><div><span class="font-semibold text-gray-700">Flopper.io</span> | Compare the GPUs Powering AI <!--[--><span class="mx-1">|</span> <span>Source: <a href="https://www.apple.com/newsroom/2026/03/apple-debuts-m5-pro-and-m5-max-to-supercharge-the-most-demanding-pro-workflows/" class="text-purple-600 hover:underline print:text-gray-600">Apple</a></span><!--]--></div> <div><a href="/gpu/apple-m5-pro/spec-sheet.pdf" class="text-purple-600 hover:underline font-medium print:hidden">Download PDF</a></div></footer></div></div><!----><!----><!--]--><