		<script>
			void (function () {
				const mainElement = document.querySelector('.main')
				if (!mainElement) {
					return console.error('Main element not found')
				}
				const mainWidth = mainElement ? mainElement.offsetWidth : 0

				if (window.innerWidth > 1280 && window.innerHeight > 680) {
					const floatBlock = document.getElementById('gtfloats-sb-right')
					const newDiv = document.createElement('div')

					const isRightType = 'right' === 'right'
					const isNearContent = 'nearContent' === 'nearContent'

					floatBlock.style.position = 'fixed'
					floatBlock.style.width = 300 + 'px'
					floatBlock.style.top = '56px'

					const leftPositionNearContent = isRightType
						? 'calc(50% + ' + (mainWidth / 2 + 16) + 'px)'
						: 'calc(50% - ' + (mainWidth / 2 + 300 + 16) + 'px)'

					const leftPositionNearBorder = isRightType
						? 'calc(100% - ' + (300 + 16) + 'px)'
						: 16 + 'px'

					floatBlock.style.left = isNearContent ? leftPositionNearContent : leftPositionNearBorder

					floatBlock.appendChild(newDiv)
				} else {
					// Remove for mobile
					const element = document.getElementById('gtfloats-sb-right')
					if (element) {
						element.remove()
					}
				}
			})()
		</script>
	
