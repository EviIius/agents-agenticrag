	<script type="module"> 
		function initUseCasePrioritiesChooser({
			url = '/api/use-case-priorities',
			formSelector = '[data-use-case-priorities-form]',
			selectSelector = '#use_case_priority',
			descTextSelector = '#use-case-desc-text',
			exampleTextSelector = '#use-case-example-text',
			categories = {},
			showButton = true,
		} = {}) {
			const parseFormData = (formData) => Object.fromEntries(formData.entries())
			const form = document.querySelector(formSelector)
			const selectElement = document.querySelector(selectSelector)
			const descTextElement = document.querySelector(descTextSelector)
			const exampleTextElement = document.querySelector(exampleTextSelector)
			const descParagraphElement = document.querySelector('#desc-paragraph')
			const exampleParagraphElement = document.querySelector('#example-paragraph')

			function updateDetails(selectedKey) {
				const category = categories[selectedKey]
				if (category) {
					if (descTextElement && descParagraphElement) {
						const prioritizeText = category.desc || '' // Changed from category.prioritize
						descTextElement.textContent = prioritizeText
						descParagraphElement.style.display = prioritizeText ? 'block' : 'none'
					}
					if (exampleTextElement && exampleParagraphElement) {
						const exampleText = category.example || ''
						exampleTextElement.textContent = exampleText
						exampleParagraphElement.style.display = exampleText ? 'block' : 'none'
					}
				} else {
					if (descTextElement && descParagraphElement) {
						descTextElement.textContent = ''
						descParagraphElement.style.display = 'none'
					}
					if (exampleTextElement && exampleParagraphElement) {
						exampleTextElement.textContent = ''
						exampleParagraphElement.style.display = 'none'
					}
				}
			}

			if (form) {
				if (showButton) {
					form.addEventListener('submit', (e) => {
						e.preventDefault()

						const body = JSON.stringify({
							pageUrl: window.location.href,
							uc: form.querySelector(selectSelector).value,
							initiator: 'use-case-priorities', // for future scroll to Final score.
						})

						fetch(url, { method: 'POST', body, headers: { 'Content-Type': 'application/json' } })
							.then((source) => source.json())
							.then((data) => {
								if (data.success === true) {
									setTimeout(() => {
										window.location.href = data.url
									}, 2000);
								} else {
									alert('Something went wrong :(')
								}
							})
							.catch((e) => console.error(e))

						showModalReloadingWindow({
							title: 'Recalculating NanoReview Score',
							html: 'Loading page with the recalculated score, please wait...',
						})
							.then((result) => {})
							.catch((e) => console.error(e))
					})
				}
			}

			const detailsContainer = document.querySelector('#use-case-desc-details')

			if (selectElement) {
				selectElement.addEventListener('change', (event) => {
					updateDetails(event.target.value)
					if (detailsContainer) {
						detailsContainer.style.display = 'block' // Show on selection
					}
					if (!showButton) {
						// Auto-submit on change
						const value = event.target.value
						const body = JSON.stringify({
							pageUrl: window.location.href,
							uc: value,
							initiator: 'use-case-priorities',
						})

						fetch('/api/use-case-priorities', { method: 'POST', body, headers: { 'Content-Type': 'application/json' } })
							.then((source) => source.json())
							.then((data) => {
								if (data.success === true) {
									setTimeout(() => {
										window.location.href = data.url
									}, 2000)
								} else {
									alert('Something went wrong :(')
								}
							})
							.catch((e) => console.error(e))

						showModalReloadingWindow({
							title: 'Recalculating NanoReview Score',
							html: 'Loading page with the recalculated score, please wait...',
						})
							.then((result) => {})
							.catch((e) => console.error(e))
					}
				})

				// Initial population - now making it visible, but only if category.default !== true
				const initialSelectedValue = selectElement.value;
				const initialCategory = categories[initialSelectedValue];

				if (initialSelectedValue && initialCategory && initialCategory.default !== true) {
					updateDetails(initialSelectedValue);
					if (detailsContainer) {
						detailsContainer.style.display = 'block';
					}
				}
			}
		}

		initUseCasePrioritiesChooser({ categories: {"generic":{"default":true,"title":"Balanced","desc":"","example":""},"gaming":{"default":false,"title":"Gaming","desc":"","example":""},"programming":{"default":false,"title":"Programming","desc":"","example":""},"content_creation":{"default":false,"title":"Content Creation","desc":"","example":""},"office":{"default":false,"title":"Office & Web","desc":"","example":""}}, showButton: false })
	</script>


		<div class="card-block" style="padding-top: 0;">
			
		<svg class="icn-svg" width="21" height="21" style="margin-top: -2px; fill: green;">
			<use width="21" height="21" xlink:href="#icn-info"></use>
		</svg>
	
			<span>Choose your main usage scenario to recalculate the Final Score and see which CPU suits your needs.</span>
		</div>

		<div class="card-block mb" style="">
			<form data-use-case-priorities-form action="/">
				<div class="flex mb" style="flex-wrap: wrap; align-items: center; ">
					<div style=" font-weight: 600; margin-right: 16px;">🔌 Usage Scenario:</div> 
					<div style="">
						<div style="max-width: 200px;">
