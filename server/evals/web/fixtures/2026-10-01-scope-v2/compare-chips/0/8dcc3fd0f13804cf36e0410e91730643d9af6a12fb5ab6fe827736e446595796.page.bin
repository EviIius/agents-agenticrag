		<div class="overlay"></div>

		<script type="module">
			function initSideMenubar({ desktopWidth = 1980, overlayWidth = 1000 }) {
				const toggleMenuButton = document.getElementById('toggle-menubar')
				const sideMenuContainer = document.getElementById('side-menubar-container')
				const overlay = document.querySelector('.overlay')

				const isMenubarOpen = () => sideMenuContainer.classList.contains('menubar-open')

				const toggleMenubar = (type) => {
					/* For preventing blinking */
					sideMenuContainer.classList.remove('menubar-open-for-desktop')
					if (type === 'open') {
						sideMenuContainer.classList.add('menubar-open')
					}
					if (type === 'close') {
						sideMenuContainer.classList.remove('menubar-open')
					}
					if (type === 'toggle') {
						sideMenuContainer.classList.toggle('menubar-open')
					}

					if (window.innerWidth < overlayWidth && isMenubarOpen()) {
						// Only apply overlay under 600px
						overlay.classList.add('active')
					} else {
						overlay.classList.remove('active')
					}
				}

				// Ensure the menu is open on load for wider screens
				if (window.innerWidth >= desktopWidth) {
					toggleMenubar('open')
				}

				toggleMenuButton.addEventListener('click', () => {
					toggleMenubar('toggle')
				})

				// Close the menu by clicking outside of it
				document.addEventListener('click', (event) => {
					if (window.innerWidth >= desktopWidth) {
						return undefined
					}
					if (!sideMenuContainer.contains(event.target) && !toggleMenuButton.contains(event.target)) {
						toggleMenubar('close')
					}
				})

				// Ensure the menu state is updated on window resize
				window.addEventListener('resize', () => {
					if (window.innerWidth >= desktopWidth && !isMenubarOpen()) {
						toggleMenubar('open')
					} else if (window.innerWidth < desktopWidth && isMenubarOpen()) {
						toggleMenubar('close')
					}
				})
			}
			initSideMenubar({ desktopWidth: 2880 })
		</script>
	

		
		
