		<style>
			#gtr-sticky-bottom {
					
					display: flex;
					background-color: rgb(250, 250, 250);
					border-top: 1px solid rgb(228 228 228);
					position: fixed;
					bottom: 0;
					left: 0;
					width: 100%;
					z-index: 9999;
					box-sizing: border-box;
					transition: transform 0.3s ease-out;
					justify-content: center;
					align-items: center;
			}

			#gtr-sticky-bottom.closing {
					transform: translateY(100%);
			}

			#gtr-sticky-bottom .close-button-container {
					position: absolute;
					top: -26px;
					left: 10px;
			}

			#gtr-sticky-bottom .close-button {
					background-color: rgb(250, 250, 250);
					border: 1px solid rgb(228 228 228);
					border-bottom: none;
					border-radius: 5px 5px 0 0;
					cursor: pointer;
					padding: 6px;
					width: 39px;
					height: 26px;
					display: flex;
					align-items: center;
					justify-content: center;
			}

			#gtr-sticky-bottom .close-button svg {
					width: 26px;
					height: 26px;
			}

			#gtr-sticky-bottom .content-container {
					padding: 0px;
					text-align: center;
					width: 100%;
			}

			#gtr-sticky-bottom .content-slot {
					width: 100%;
			}

			@media (min-width: 700px) {
					#gtr-sticky-bottom {
						display: none;
					}
			}
		</style>

		
		<script>
			;(function () {
				var banner = document.getElementById('gtr-sticky-bottom')
				var closeButtonContainer = banner.querySelector('.close-button-container')
				var closeButton = banner.querySelector('.close-button')
				var contentSlot = banner.querySelector('.content-slot')
				var isContentLoaded = false

				function checkContentHeight() {
					if (contentSlot.offsetHeight > 25) {
						closeButtonContainer.style.display = 'block'
						isContentLoaded = true
					}
				}

				function closeBanner() {
					banner.classList.add('closing')
					banner.addEventListener(
						'transitionend',
						function () {
							banner.style.display = 'none'
							banner.classList.remove('closing')
							contentSlot.innerHTML = ''
							closeButtonContainer.style.display = 'none'

							if (typeof window.onCloseStickyBanner === 'function') {
								window.onCloseStickyBanner()
							}
						},
						{ once: true }
					)
				}

				function openBanner(newContent) {
					if (newContent) {
						contentSlot.innerHTML = newContent
					}
					banner.style.display = 'flex'
					checkContentHeight()
				}

				var observer = new MutationObserver(checkContentHeight)
				observer.observe(contentSlot, { childList: true, subtree: true, attributes: true })

				var intervalId = setInterval(checkContentHeight, 500)

				setTimeout(function () {
					if (!isContentLoaded && typeof window.onStickyBannerTimeoutNotLoaded === 'function') {
						window.onStickyBannerTimeoutNotLoaded()
					}
				}, 15000)

				closeButton.addEventListener('click', closeBanner)

				checkContentHeight()
				if (window.innerWidth < 700) {
					banner.style.display = 'flex'
				}

				window.reopenStickyBanner = openBanner
				window.closeStickyBanner = closeBanner
			})()
		</script>
	
