<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt22" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAY4" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"citation\n ","href":"./Template:Citation"},"params":{"author":{"wt":"International Bureau of Weights and Measures"},"author-link":{"wt":"International Bureau of Weights and Measures"},"title":{"wt":"The International System of Units (SI)"},"date":{"wt":"20 May 2019"},"url":{"wt":"https://www.bipm.org/utils/common/pdf/si-brochure/SI-Brochure-9.pdf"},"archive-url":{"wt":"https://web.archive.org/web/20211018184555/https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf/fcf090b2-04e6-88cc-1149-c3e029ad8232"},"url-status":{"wt":"live"},"edition":{"wt":"9th"},"isbn":{"wt":"978-92-822-2272-0"},"archive-date":{"wt":"18 October 2021"}},"i":0}}]}'/><cite id="CITEREFInternational_Bureau_of_Weights_and_Measures2019" class="citation cs2" about="#mwt22"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/International_Bureau_of_Weights_and_Measures" title="International Bureau of Weights and Measures" id="mwAY8">International Bureau of Weights and Measures</a> (20 May 2019), <a rel="mw:ExtLink nofollow" href="https://www.bipm.org/utils/common/pdf/si-brochure/SI-Brochure-9.pdf" class="external text" id="mwAZA"><i id="mwAZE">The International System of Units (SI)</i></a> <span class="cs1-format" id="mwAZI">(PDF)</span> (9th<span typeof="mw:Entity" id="mwAZM"> </span>ed.), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwAZQ">ISBN</a><span typeof="mw:Entity" id="mwAZU"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-92-822-2272-0" title="Special:BookSources/978-92-822-2272-0" id="mwAZY"><bdi id="mwAZc">978-92-822-2272-0</bdi></a>, <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20211018184555/https://www.bipm.org/documents/20126/41483022/SI-Brochure-9.pdf/fcf090b2-04e6-88cc-1149-c3e029ad8232" class="external text" id="mwAZg">archived</a> from the original on 18 October 2021</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=The+International+System+of+Units+%28SI%29&amp;rft.edition=9th&amp;rft.date=2019-05-20&amp;rft.isbn=978-92-822-2272-0&amp;rft.au=International+Bureau+of+Weights+and+Measures&amp;rft_id=https%3A%2F%2Fwww.bipm.org%2Futils%2Fcommon%2Fpdf%2Fsi-brochure%2FSI-Brochure-9.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMetre" class="Z3988" about="#mwt22" id="mwAZk"></span></span></li>
<li about="#cite_note-4" id="cite_note-4" data-mw-footnote-number="4"><span class="mw-cite-backlink" id="mwAZo"><a href="#cite_ref-4" rel="mw:referencedBy" id="mwAZs"><span class="mw-linkback-text" id="mwAZw">↑</span></a></span> <span id="mw-reference-text-cite_note-4" class="mw-reference-text reference-text"><a rel="mw:ExtLink nofollow" href="https://www.perseus.tufts.edu/hopper/text?doc=Perseus:text:1999.04.0057:entry=metre/w" about="#mwt46" typeof="mw:Transclusion" class="external text" id="mwAZ0" data-mw='{"parts":[{"template":{"target":{"wt":"LSJ","href":"./Template:LSJ"},"params":{"1":{"wt":"metre/w"},"2":{"wt":"μετρέω"},"3":{"wt":"ref"}},"i":0}}]}'><span title="Ancient Greek (to 1453)-language text" id="mwAZ4"><span lang="grc" id="mwAZ8">μετρέω</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Ancient_Greek_(to_1453)-language_text" id="mwAaA"/></a><span about="#mwt46" id="mwAaE">. </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Henry_Liddell" title="Henry Liddell" about="#mwt46" id="mwAaI">Liddell, Henry George</a><span about="#mwt46" id="mwAaM">; </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Robert_Scott_(philologist)" title="Robert Scott (philologist)" about="#mwt46" id="mwAaQ">Scott, Robert</a><span about="#mwt46" id="mwAaU">; </span><i about="#mwt46" id="mwAaY"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/A_Greek–English_Lexicon" title="A Greek–English Lexicon" id="mwAac">A Greek–English Lexicon</a></i><span about="#mwt46" id="mwAag"> at the </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Perseus_Project" title="Perseus Project" about="#mwt46" class="mw-redirect" id="mwAak">Perseus Project</a>.</span></li>
<li about="#cite_note-5" id="cite_note-5" data-mw-footnote-number="5"><span class="mw-cite-backlink" id="mwAao"><a href="#cite_ref-5" rel="mw:referencedBy" id="mwAas"><span class="mw-linkback-text" id="mwAaw">↑</span></a></span> <span id="mw-reference-text-cite_note-5" class="mw-reference-text reference-text"><a rel="mw:ExtLink nofollow" href="https://www.perseus.tufts.edu/hopper/text?doc=Perseus:text:1999.04.0057:entry=me/tron" about="#mwt48" typeof="mw:Transclusion" class="external text" id="mwAa0" data-mw='{"parts":[{"template":{"target":{"wt":"LSJ","href":"./Template:LSJ"},"params":{"1":{"wt":"me/tron"},"2":{"wt":"μέτρον"},"3":{"wt":"shortref"}},"i":0}}]}'><span title="Ancient Greek (to 1453)-language text" id="mwAa4"><span lang="grc" id="mwAa8">μέτρον</span></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_Ancient_Greek_(to_1453)-language_text" id="mwAbA"/></a><span typeof="mw:Entity" about="#mwt48" id="mwAbE"> </span><span about="#mwt48" id="mwAbI">in </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Henry_Liddell" title="Henry Liddell" about="#mwt48" id="mwAbM">Liddell</a><span about="#mwt48" id="mwAbQ"> and </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Robert_Scott_(philologist)" title="Robert Scott (philologist)" about="#mwt48" id="mwAbU">Scott</a>.</span></li>
<li about="#cite_note-:6-6" id="cite_note-:6-6" data-mw-footnote-number="6"><span class="mw-cite-backlink" id="mwAbY"><a href="#cite_ref-:6_6-0" rel="mw:referencedBy" id="mwAbc"><span class="mw-linkback-text" id="mwAbg">↑</span></a></span> <span id="mw-reference-text-cite_note-:6-6" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt37" typeof="mw:Extension/templatestyles" id="mwAbk" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite class="citation web cs1" id="mwAbo"><a rel="mw:ExtLink nofollow" href="https://thebipm150.org/history/" class="external text" id="mwAbs">"History – The BIPM 150"</a><span class="reference-accessdate" id="mwAbw">. Retrieved <span class="nowrap" id="mwAb0">24 January</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=History+%E2%80%93+The+BIPM+150&amp;rft_id=https%3A%2F%2Fthebipm150.org%2Fhistory%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMetre" class="Z3988" id="mwAb4"></span></span></li>
<li about="#cite_note-Oxford-8" id="cite_note-Oxford-8" data-mw-footnote-number="7"><span class="mw-cite-backlink" id="mwAb8"><a href="#cite_ref-Oxford_8-0" rel="mw:referencedBy" id="mwAcA"><span class="mw-linkback-text" id="mwAcE">↑</span></a></span> <span id="mw-reference-text-cite_note-Oxford-8" class="mw-reference-text reference-text"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Oxford_English_Dictionary" title="Oxford English Dictionary" id="mwAcI">Oxford English Dictionary</a>, Clarendon Press 2nd ed. 1989, vol. IX p. 697 col. 3.</span></li>
<li about="#cite_note-9" id="cite_note-9" data-mw-footnote-number="8"><span class="mw-cite-backlink" id="mwAcM"><a href="#cite_ref-9" rel="mw:referencedBy" id="mwAcQ"><span class="mw-linkback-text" id="mwAcU">↑</span></a></span> <span id="mw-reference-text-cite_note-9" class="mw-reference-text reference-text">
<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt51" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAcY" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web\n ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.330-2019.pdf"},"title":{"wt":"The International System of Units (SI) – NIST"},"publisher":{"wt":"[[National Institute of Standards and Technology]]"},"location":{"wt":"US"},"date":{"wt":"26 March 2008"},"quote":{"wt":"The spelling of English words is in accordance with the United States Government Printing Office Style Manual, which follows Webster&apos;s Third New International Dictionary rather than the Oxford Dictionary. Thus the spellings &apos;meter&apos;, &apos;liter&apos;, &apos;deka&apos;, and &apos;cesium&apos; are used rather than &apos;metre&apos;, &apos;litre&apos;, &apos;deca&apos;, and &apos;caesium&apos; as in the original BIPM English text."}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt51" id="mwAcc"><a rel="mw:ExtLink nofollow" href="https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.330-2019.pdf" class="external text" id="mwAcg">"The International System of Units (SI) – NIST"</a> <span class="cs1-format" id="mwAck">(PDF)</span>. US: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Institute_of_Standards_and_Technology" title="National Institute of Standards and Technology" id="mwAco">National Institute of Standards and Technology</a>. 26 March 2008. <q id="mwAcs">The spelling of English words is in accordance with the United States Government Printing Office Style Manual, which follows Webster's Third New International Dictionary rather than the Oxford Dictionary. Thus the spellings 'meter', 'liter', 'deka', and 'cesium' are used rather than 'metre', 'litre', 'deca', and 'caesium' as in the original BIPM English text.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=The+International+System+of+Units+%28SI%29+%E2%80%93+NIST&amp;rft.place=US&amp;rft.pub=National+Institute+of+Standards+and+Technology&amp;rft.date=2008-03-26&amp;rft_id=https%3A%2F%2Fnvlpubs.nist.gov%2Fnistpubs%2FSpecialPublications%2FNIST.SP.330-2019.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMetre" class="Z3988" about="#mwt51" id="mwAcw"></span></span></li>
<li about="#cite_note-10" id="cite_note-10" data-mw-footnote-number="9"><span class="mw-cite-backlink" id="mwAc0"><a href="#cite_ref-10" rel="mw:referencedBy" id="mwAc4"><span class="mw-linkback-text" id="mwAc8">↑</span></a></span> <span id="mw-reference-text-cite_note-10" class="mw-reference-text reference-text">The most recent official brochure about the International System of Units (SI), written in French by the <i id="mwAdA"><span title="French-language text" about="#mwt54" typeof="mw:Transclusion" id="mwAdE" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"fr"},"2":{"wt":"Bureau international des poids et mesures"}},"i":0}}]}'><i lang="fr" id="mwAdI">Bureau international des poids et mesures</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_French-language_text" about="#mwt54" id="mwAdM"/></i>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/International_Bureau_of_Weights_and_Measures" title="International Bureau of Weights and Measures" id="mwAdQ">International Bureau of Weights and Measures</a> (BIPM) uses the spelling <i id="mwAdU">metre</i>; an English translation, included to make the SI standard more widely accessible also uses the spelling <i id="mwAdY">metre</i> (<a rel="mw:WikiLink" href="#bipm2006" class="mw-selflink-fragment" id="mwAdc">BIPM, 2006</a>, p. 130<i id="mwAdg">ff</i>). However, in 2008 the U.S. English translation published by the U.S. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/National_Institute_of_Standards_and_Technology" title="National Institute of Standards and Technology" id="mwAdk">National Institute of Standards and Technology</a> (NIST) chose to use the spelling <i id="mwAdo">meter</i> in accordance with the United States Government Printing Office Style Manual. The Metric Conversion Act of 1975 gives the Secretary of Commerce of the US the responsibility of interpreting or modifying the SI for use in the US. The Secretary of Commerce delegated this authority to the Director of the National Institute of Standards and Technology (<a rel="mw:WikiLink" href="#turner" class="mw-selflink-fragment" id="mwAds">Turner</a>). In 2008, NIST published the US version (<a rel="mw:WikiLink" href="#taylor2008a" class="mw-selflink-fragment" id="mwAdw">Taylor and Thompson, 2008a</a>) of the English text of the eighth edition of the BIPM publication <i id="mwAd0"><span title="French-language text" about="#mwt55" typeof="mw:Transclusion" id="mwAd4" data-mw='{"parts":[{"template":{"target":{"wt":"lang","href":"./Template:Lang"},"params":{"1":{"wt":"fr"},"2":{"wt":"Le Système international d&apos;unités"}},"i":0}}]}'><i lang="fr" id="mwAd8">Le Système international d'unités</i></span><link rel="mw:PageProp/Category" href="./Category:Articles_containing_French-language_text" about="#mwt55" id="mwAeA"/> (SI)</i> (BIPM, 2006). In the NIST publication, the spellings "meter", "liter" and "deka" are used rather than "metre", "litre" and "deca" as in the original BIPM English text (<a rel="mw:WikiLink" href="#taylor2008a" class="mw-selflink-fragment" id="mwAeE">Taylor and Thompson (2008a), p. iii</a>). The Director of the NIST officially recognised this publication, together with <a rel="mw:WikiLink" href="#taylor2008b" class="mw-selflink-fragment" id="mwAeI">Taylor and Thompson (2008b)</a>, as the "legal interpretation" of the SI for the United States (<a rel="mw:WikiLink" href="#turner" class="mw-selflink-fragment" id="mwAeM">Turner</a>). Thus, the spelling <i id="mwAeQ">metre</i> is referred to as the "international spelling"; the spelling <i id="mwAeU">meter</i>, as the "American spelling".</span></li>
<li about="#cite_note-11" id="cite_note-11" data-mw-footnote-number="10"><span class="mw-cite-backlink" id="mwAeY"><a href="#cite_ref-11" rel="mw:referencedBy" id="mwAec"><span class="mw-linkback-text" id="mwAeg">↑</span></a></span> <span id="mw-reference-text-cite_note-11" class="mw-reference-text reference-text">
<link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt57" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAek" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web\n ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.metricationmatters.com/docs/Spelling_metre_or_meter.pdf"},"title":{"wt":"Spelling metre or meter"},"first":{"wt":"Pat"},"last":{"wt":"Naughtin"},"website":{"wt":"Metrication Matters"},"year":{"wt":"2008"},"access-date":{"wt":"2017-03-12"},"archive-url":{"wt":"https://web.archive.org/web/20161011100154/http://www.metricationmatters.com/docs/Spelling_metre_or_meter.pdf"},"archive-date":{"wt":"11 October 2016"},"url-status":{"wt":"usurped"}},"i":0}}]}'/><cite id="CITEREFNaughtin2008" class="citation web cs1 cs1-prop-unfit" about="#mwt57">Naughtin, Pat (2008). <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20161011100154/http://www.metricationmatters.com/docs/Spelling_metre_or_meter.pdf" class="external text" id="mwAeo">"Spelling metre or meter"</a> <span class="cs1-format" id="mwAes">(PDF)</span>. <i id="mwAew">Metrication Matters</i>. Archived from the original on 11 October 2016<span class="reference-accessdate" id="mwAe0">. Retrieved <span class="nowrap" id="mwAe4">12 March</span> 2017</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Metrication+Matters&amp;rft.atitle=Spelling+metre+or+meter&amp;rft.date=2008&amp;rft.aulast=Naughtin&amp;rft.aufirst=Pat&amp;rft_id=http%3A%2F%2Fwww.metricationmatters.com%2Fdocs%2FSpelling_metre_or_meter.pdf&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMetre" class="Z3988" about="#mwt57" id="mwAe8"></span><link rel="mw:PageProp/Category" href="./Category:CS1:_unfit_URL" about="#mwt57" id="mwAfA"/></span></li>
<li about="#cite_note-12" id="cite_note-12" data-mw-footnote-number="11"><span class="mw-cite-backlink" id="mwAfE"><a href="#cite_ref-12" rel="mw:referencedBy" id="mwAfI"><span class="mw-linkback-text" id="mwAfM">↑</span></a></span> <span id="mw-reference-text-cite_note-12" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt60" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAfQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://grammarist.com/spelling/meter-metre/"},"title":{"wt":"Meter vs. metre"},"website":{"wt":"Grammarist"},"date":{"wt":"21 February 2011"},"access-date":{"wt":"2017-03-12"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt60" id="mwAfU"><a rel="mw:ExtLink nofollow" href="https://grammarist.com/spelling/meter-metre/" class="external text" id="mwAfY">"Meter vs. metre"</a>. <i id="mwAfc">Grammarist</i>. 21 February 2011<span class="reference-accessdate" id="mwAfg">. Retrieved <span class="nowrap" id="mwAfk">12 March</span> 2017</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Grammarist&amp;rft.atitle=Meter+vs.+metre&amp;rft.date=2011-02-21&amp;rft_id=https%3A%2F%2Fgrammarist.com%2Fspelling%2Fmeter-metre%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMetre" class="Z3988" about="#mwt60" id="mwAfo"></span></span></li>
<li about="#cite_note-13" id="cite_note-13" data-mw-footnote-number="12"><span class="mw-cite-backlink" id="mwAfs"><a href="#cite_ref-13" rel="mw:referencedBy" id="mwAfw"><span class="mw-linkback-text" id="mwAf0">↑</span></a></span> <span id="mw-reference-text-cite_note-13" class="mw-reference-text reference-text">The Philippines uses <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Philippine_English" title="Philippine English" id="mwAf4">English</a> as an official language and this largely follows American English since the country became a colony of the United States. While the law that converted the country to use the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Metric_system" title="Metric system" id="mwAf8">metric system</a> uses <i id="mwAgA">metre</i> (<a rel="mw:WikiLink" href="#PH-BatasPambansa8" class="mw-selflink-fragment" id="mwAgE">Batas Pambansa Blg. 8</a>) following the SI spelling, in actual practice, <i id="mwAgI">meter</i> is used in government and everyday commerce, as evidenced by laws (<i id="mwAgM">kilometer</i>, <a rel="mw:WikiLink" href="#PH-RA7160" class="mw-selflink-fragment" id="mwAgQ">Republic Act No. 7160</a>), Supreme Court decisions (<i id="mwAgU">meter</i>,  <a rel="mw:WikiLink" href="#PH-GR185240" class="mw-selflink-fragment" id="mwAgY">G.R. No. 185240</a>), and national standards (<i id="mwAgc">centimeter</i>, <a rel="mw:WikiLink" href="#PH-PNSBAFS181-2016" class="mw-selflink-fragment" id="mwAgg">PNS/BAFS 181:2016</a>).</span></li>
<li about="#cite_note-History_of_the_metre_Quinn-2012-14" id="cite_note-History_of_the_metre_Quinn-2012-14" data-mw-footnote-number="13"><span class="mw-cite-backlink" id="mwAgk"><a href="#cite_ref-History_of_the_metre_Quinn-2012_14-0" rel="mw:referencedBy" id="mwAgo"><span class="mw-linkback-text" id="mwAgs">↑</span></a></span> <span id="mw-reference-text-cite_note-History_of_the_metre_Quinn-2012-14" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt69" typeof="mw:Extension/templatestyles" id="mwAgw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite id="CITEREFQuinn2012" class="citation book cs1">Quinn, T. J. (2012). <i id="mwAg0">From artefacts to atoms: the BIPM and the search for ultimate measurement standards</i>. Oxford: Oxford University Press. pp.<span typeof="mw:Entity" id="mwAg4"> </span><span class="nowrap" id="mwAg8">12–</span>14, <span class="nowrap" id="mwAhA">8–</span>12, <span class="nowrap" id="mwAhE">49–</span>72, <span class="nowrap" id="mwAhI">106–</span>108, <span class="nowrap" id="mwAhM">144–</span>147. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ISBN_(identifier)" title="ISBN (identifier)" class="mw-redirect" id="mwAhQ">ISBN</a><span typeof="mw:Entity" id="mwAhU"> </span><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:BookSources/978-0-19-990991-9" title="Special:BookSources/978-0-19-990991-9" id="mwAhY"><bdi id="mwAhc">978-0-19-990991-9</bdi></a>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/OCLC_(identifier)" title="OCLC (identifier)" class="mw-redirect" id="mwAhg">OCLC</a><span typeof="mw:Entity" id="mwAhk"> </span><a rel="mw:ExtLink nofollow" href="https://search.worldcat.org/oclc/861693071" class="external text" id="mwAho">861693071</a>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=book&amp;rft.btitle=From+artefacts+to+atoms%3A+the+BIPM+and+the+search+for+ultimate+measurement+standards&amp;rft.place=Oxford&amp;rft.pages=12-14%2C+8-12%2C+49-72%2C+106-108%2C+144-147&amp;rft.pub=Oxford+University+Press&amp;rft.date=2012&amp;rft_id=info%3Aoclcnum%2F861693071&amp;rft.isbn=978-0-19-990991-9&amp;rft.aulast=Quinn&amp;rft.aufirst=T.+J.&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AMetre" class="Z3988" id="mwAhs"></span></span></li>
