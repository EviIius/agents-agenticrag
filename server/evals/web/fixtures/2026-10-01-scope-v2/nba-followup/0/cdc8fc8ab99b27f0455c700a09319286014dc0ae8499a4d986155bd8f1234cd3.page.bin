</tbody></table>
<table style="background-color:#eee; color:#202122; float:left; width:12%; table-layout:fixed">
<tbody><tr><td style="border-style:none"><div style="text-align:center">July 11<br/><small> 8:00pm <span style="font-size: 85%;">(7:00pm <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Central_Time_Zone" title="Central Time Zone">CDT</a>)</span></small></div></td></tr>
</tbody></table>
