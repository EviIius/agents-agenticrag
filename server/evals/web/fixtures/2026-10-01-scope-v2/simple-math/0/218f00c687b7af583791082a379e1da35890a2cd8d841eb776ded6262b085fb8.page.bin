    <section class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
        <h2 class="text-lg font-semibold text-gray-800 dark:text-white/90">Interactive Multiplication Grid (20 × 20)</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Scroll down for individual multiplication tables.</p>

        <div class="mt-3 overflow-x-auto">
            <div
    x-data="mtoolsTable({ id: 'grid', title: 'Multiplication Grid', highlight: true })"
    class="min-w-0 overflow-hidden rounded-lg border border-gray-200 dark:border-gray-800"
>
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-200 bg-gray-50 px-3 py-2 dark:border-gray-800 dark:bg-white/[0.04]">
        <span class="text-sm font-medium text-gray-700 dark:text-gray-200">
                            Multiplication Grid
                    </span>
        <div class="flex items-center gap-1.5">
            
            <button
                type="button"
                x-on:click="print()"
                class="mtools-btn rounded px-2.5 py-1.5 text-xs font-medium"
                title="Print this table"
            >🖶 Print</button>
