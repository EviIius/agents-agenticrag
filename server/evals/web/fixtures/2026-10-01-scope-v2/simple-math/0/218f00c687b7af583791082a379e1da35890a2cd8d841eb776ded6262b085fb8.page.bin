                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                                    <li>
                                                                                                                    <a href="/curve/lemniscate-of-bernoulli" class="menu-dropdown-item"
                                                                :class="isActive('/curve/lemniscate-of-bernoulli') ?
                                                                    'menu-dropdown-item-active' :
                                                                    'menu-dropdown-item-inactive'">
                                                                Lemniscate of Bernoulli
                                                                <span class="flex items-center gap-1 ml-auto">
                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                                    <li>
                                                                                                                    <a href="/curve/peano-curve" class="menu-dropdown-item"
                                                                :class="isActive('/curve/peano-curve') ?
                                                                    'menu-dropdown-item-active' :
                                                                    'menu-dropdown-item-inactive'">
                                                                Peano Curve
                                                                <span class="flex items-center gap-1 ml-auto">
                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                                    <li>
                                                                                                                    <a href="/curve/koch-snowflake" class="menu-dropdown-item"
                                                                :class="isActive('/curve/koch-snowflake') ?
                                                                    'menu-dropdown-item-active' :
                                                                    'menu-dropdown-item-inactive'">
                                                                Koch Snowflake
                                                                <span class="flex items-center gap-1 ml-auto">
                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                                    <li>
                                                                                                                    <a href="/curve/dragon-curve" class="menu-dropdown-item"
                                                                :class="isActive('/curve/dragon-curve') ?
                                                                    'menu-dropdown-item-active' :
                                                                    'menu-dropdown-item-inactive'">
                                                                Dragon Curve
                                                                <span class="flex items-center gap-1 ml-auto">
                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                            </ul>
                                        </div>
                                                                    </li>
                                                            <li>
                                                                            <!-- Menu Item with Submenu -->
                                        <button @click="toggleSubmenu(0, 6)"
                                            class="menu-item group w-full text-left"
                                            :class="[
                                                isSubmenuOpen(0, 6) ?
                                                'menu-item-active' : 'menu-item-inactive',
                                                !$store.sidebar.isExpanded && !$store.sidebar.isHovered ?
                                                'xl:justify-center' : 'xl:justify-start'
                                            ]">

                                            <!-- Icon -->
                                            <span :class="isSubmenuOpen(0, 6) ?
                                                    'menu-item-icon-active' : 'menu-item-icon-inactive'">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 8L4.5 12L8.5 16M15.5 8L19.5 12L15.5 16M13.25 5.5L10.75 18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                            </span>

                                            <!-- Text -->
                                            <span
                                                x-show="$store.sidebar.isExpanded || $store.sidebar.isHovered || $store.sidebar.isMobileOpen"
                                                class="menu-item-text flex items-center gap-2">
                                                API
                                                                                            </span>

                                            <!-- Chevron Down Icon -->
                                            <svg x-show="$store.sidebar.isExpanded || $store.sidebar.isHovered || $store.sidebar.isMobileOpen"
                                                class="ml-auto w-5 h-5 transition-transform duration-200"
                                                :class="{
                                                    'rotate-180 text-brand-500': isSubmenuOpen(0,
                                                        6)
                                                }"
                                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                            </svg>
                                        </button>

                                        <!-- Submenu -->
                                        <div x-show="isSubmenuOpen(0, 6) && ($store.sidebar.isExpanded || $store.sidebar.isHovered || $store.sidebar.isMobileOpen)"
                                            style="display:none">
                                            <ul class="mt-2 space-y-1 ml-9">
                                                                                                    <li>
                                                                                                                    <a href="/api/numbers" class="menu-dropdown-item"
                                                                :class="isActive('/api/numbers') ?
                                                                    'menu-dropdown-item-active' :
                                                                    'menu-dropdown-item-inactive'">
                                                                Numbers
                                                                <span class="flex items-center gap-1 ml-auto">
                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                                    <li>
                                                                                                                    <a href="/api/equations" class="menu-dropdown-item"
                                                                :class="isActive('/api/equations') ?
                                                                    'menu-dropdown-item-active' :
                                                                    'menu-dropdown-item-inactive'">
                                                                Equa Images
                                                                <span class="flex items-center gap-1 ml-auto">
                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                                    <li>
                                                                                                                    <a href="/mcp" class="menu-dropdown-item"
                                                                :class="isActive('/mcp') ?
                                                                    'menu-dropdown-item-active' :
                                                                    'menu-dropdown-item-inactive'">
                                                                MCP Server
                                                                <span class="flex items-center gap-1 ml-auto">
                                                                                                                                                                                                        </span>
                                                            </a>
                                                                                                            </li>
                                                                                            </ul>
                                        </div>
                                                                    </li>
                                                            <li>
                                                                            <!-- Simple Menu Item -->
                                        <a href="/blog" class="menu-item group"
                                            :class="[
                                                isActive('/blog') ? 'menu-item-active' :
                                                'menu-item-inactive',
                                                (!$store.sidebar.isExpanded && !$store.sidebar.isHovered && !$store.sidebar.isMobileOpen) ?
                                                'xl:justify-center' :
                                                'justify-start'
                                            ]">

                                            <!-- Icon -->
                                            <span
                                                :class="isActive('/blog') ? 'menu-item-icon-active' :
                                                    'menu-item-icon-inactive'">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.25 4.75H17.75C18.4404 4.75 19 5.30964 19 6V18C19 18.6904 18.4404 19.25 17.75 19.25H6.25C5.55964 19.25 5 18.6904 5 18V6C5 5.30964 5.55964 4.75 6.25 4.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8.25 9H15.75M8.25 12H15.75M8.25 15H12.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                            </span>

                                            <!-- Text -->
                                            <span
                                                x-show="$store.sidebar.isExpanded || $store.sidebar.isHovered || $store.sidebar.isMobileOpen"
                                                class="menu-item-text flex items-center gap-2">
                                                Blog
                                                                                            </span>
                                        </a>
                                                                    </li>
                                                            <li>
                                                                            <!-- Simple Menu Item -->
                                        <a href="/shop" class="menu-item group"
                                            :class="[
                                                isActive('/shop') ? 'menu-item-active' :
                                                'menu-item-inactive',
                                                (!$store.sidebar.isExpanded && !$store.sidebar.isHovered && !$store.sidebar.isMobileOpen) ?
                                                'xl:justify-center' :
                                                'justify-start'
                                            ]">

                                            <!-- Icon -->
                                            <span
                                                :class="isActive('/shop') ? 'menu-item-icon-active' :
                                                    'menu-item-icon-inactive'">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5.25 8.75H18.75L17.9 18.15C17.8062 19.1841 16.9385 19.9773 15.9 19.9773H8.1C7.06153 19.9773 6.19382 19.1841 6.1 18.15L5.25 8.75Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8.75 8.75V6.75C8.75 5.09315 10.0931 3.75 11.75 3.75H12.25C13.9069 3.75 15.25 5.09315 15.25 6.75V8.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="9.5" cy="12" r="0.75" fill="currentColor"></circle><circle cx="14.5" cy="12" r="0.75" fill="currentColor"></circle></svg>
                                            </span>

                                            <!-- Text -->
                                            <span
                                                x-show="$store.sidebar.isExpanded || $store.sidebar.isHovered || $store.sidebar.isMobileOpen"
                                                class="menu-item-text flex items-center gap-2">
                                                Shop
                                                                                            </span>
                                        </a>
                                                                    </li>
                                                    </ul>
                    </div>
                            </div>
        </nav>

    </div>
</aside>

<!-- Mobile Overlay -->
<div x-show="$store.sidebar.isMobileOpen" @click="$store.sidebar.setMobileOpen(false)"
    class="fixed z-50 h-screen w-full bg-gray-900/50"></div>

        
        <div id="main-content" class="min-w-0 flex-1"
            :class="{
                'transition-all duration-300 ease-in-out': $store.sidebar.ready,
                'xl:ml-[290px] xl:w-[calc(100%-290px)]': $store.sidebar.isExpanded || $store.sidebar.isHovered,
                'xl:ml-[90px] xl:w-[calc(100%-90px)]': !$store.sidebar.isExpanded && !$store.sidebar.isHovered,
                'ml-0 w-full': $store.sidebar.isMobileOpen
            }">
            <!-- app header start -->
            <header
    class="sticky top-0 flex w-full bg-white border-gray-200 z-99999 dark:border-gray-800 dark:bg-gray-900 xl:border-b"
    x-data="{
        isApplicationMenuOpen: false,
        toggleApplicationMenu() {
            this.isApplicationMenuOpen = !this.isApplicationMenuOpen;
        }
    }">
    <div class="flex flex-col items-center justify-between grow xl:flex-row xl:px-6">
        <div
            class="flex items-center justify-between w-full gap-2 px-3 py-3 border-b border-gray-200 dark:border-gray-800 sm:gap-4 xl:justify-normal xl:border-b-0 xl:px-0 lg:py-4">

            <!-- Desktop Sidebar Toggle Button (visible on xl and up) -->
            <button
                class="hidden xl:flex items-center justify-center w-10 h-10 text-gray-500 border border-gray-200 rounded-lg dark:border-gray-800 dark:text-gray-400 lg:h-11 lg:w-11"
                :class="{ 'bg-gray-100 dark:bg-white/[0.03]': !$store.sidebar.isExpanded }"
                @click="$store.sidebar.toggleExpanded()" aria-label="Toggle Sidebar">
                <svg x-show="!$store.sidebar.isMobileOpen" width="16" height="12" viewBox="0 0 16 12" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M0.583252 1C0.583252 0.585788 0.919038 0.25 1.33325 0.25H14.6666C15.0808 0.25 15.4166 0.585786 15.4166 1C15.4166 1.41421 15.0808 1.75 14.6666 1.75L1.33325 1.75C0.919038 1.75 0.583252 1.41422 0.583252 1ZM0.583252 11C0.583252 10.5858 0.919038 10.25 1.33325 10.25L14.6666 10.25C15.0808 10.25 15.4166 10.5858 15.4166 11C15.4166 11.4142 15.0808 11.75 14.6666 11.75L1.33325 11.75C0.919038 11.75 0.583252 11.4142 0.583252 11ZM1.33325 5.25C0.919038 5.25 0.583252 5.58579 0.583252 6C0.583252 6.41421 0.919038 6.75 1.33325 6.75L7.99992 6.75C8.41413 6.75 8.74992 6.41421 8.74992 6C8.74992 5.58579 8.41413 5.25 7.99992 5.25L1.33325 5.25Z"
                        fill="currentColor"></path>
                </svg>
                <svg x-show="$store.sidebar.isMobileOpen" class="fill-current" width="24" height="24" viewBox="0 0 24 24"
                    fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M6.21967 7.28131C5.92678 6.98841 5.92678 6.51354 6.21967 6.22065C6.51256 5.92775 6.98744 5.92775 7.28033 6.22065L11.999 10.9393L16.7176 6.22078C17.0105 5.92789 17.4854 5.92788 17.7782 6.22078C18.0711 6.51367 18.0711 6.98855 17.7782 7.28144L13.0597 12L17.7782 16.7186C18.0711 17.0115 18.0711 17.4863 17.7782 17.7792C17.4854 18.0721 17.0105 18.0721 16.7176 17.7792L11.999 13.0607L7.28033 17.7794C6.98744 18.0722 6.51256 18.0722 6.21967 17.7794C5.92678 17.4865 5.92678 17.0116 6.21967 16.7187L10.9384 12L6.21967 7.28131Z"
                        fill="" />
                </svg>
            </button>

            <!-- Mobile Menu Toggle Button (visible below xl) -->
            <button
                class="flex xl:hidden items-center justify-center w-10 h-10 text-gray-500 rounded-lg dark:text-gray-400 lg:h-11 lg:w-11"
                :class="{ 'bg-gray-100 dark:bg-white/[0.03]': $store.sidebar.isMobileOpen }"
                @click="$store.sidebar.toggleMobileOpen()" aria-label="Toggle Mobile Menu">
                <svg x-show="!$store.sidebar.isMobileOpen" width="16" height="12" viewBox="0 0 16 12" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M0.583252 1C0.583252 0.585788 0.919038 0.25 1.33325 0.25H14.6666C15.0808 0.25 15.4166 0.585786 15.4166 1C15.4166 1.41421 15.0808 1.75 14.6666 1.75L1.33325 1.75C0.919038 1.75 0.583252 1.41422 0.583252 1ZM0.583252 11C0.583252 10.5858 0.919038 10.25 1.33325 10.25L14.6666 10.25C15.0808 10.25 15.4166 10.5858 15.4166 11C15.4166 11.4142 15.0808 11.75 14.6666 11.75L1.33325 11.75C0.919038 11.75 0.583252 11.4142 0.583252 11ZM1.33325 5.25C0.919038 5.25 0.583252 5.58579 0.583252 6C0.583252 6.41421 0.919038 6.75 1.33325 6.75L7.99992 6.75C8.41413 6.75 8.74992 6.41421 8.74992 6C8.74992 5.58579 8.41413 5.25 7.99992 5.25L1.33325 5.25Z"
                        fill="currentColor"></path>
                </svg>
                <svg x-show="$store.sidebar.isMobileOpen" class="fill-current" width="24" height="24" viewBox="0 0 24 24"
                    fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M6.21967 7.28131C5.92678 6.98841 5.92678 6.51354 6.21967 6.22065C6.51256 5.92775 6.98744 5.92775 7.28033 6.22065L11.999 10.9393L16.7176 6.22078C17.0105 5.92789 17.4854 5.92788 17.7782 6.22078C18.0711 6.51367 18.0711 6.98855 17.7782 7.28144L13.0597 12L17.7782 16.7186C18.0711 17.0115 18.0711 17.4863 17.7782 17.7792C17.4854 18.0721 17.0105 18.0721 16.7176 17.7792L11.999 13.0607L7.28033 17.7794C6.98744 18.0722 6.51256 18.0722 6.21967 17.7794C5.92678 17.4865 5.92678 17.0116 6.21967 16.7187L10.9384 12L6.21967 7.28131Z"
                        fill="" />
                </svg>
            </button>

            <!-- Logo (mobile only) -->
            <a href="/" class="flex items-center gap-2 xl:hidden">
                <img src="/images/logo/logo-icon.svg" alt="Math Tools" width="28" height="28" />
                <span class="text-lg font-semibold text-gray-800 dark:text-white/90">Math Tools</span>
            </a>

            <!-- Application Menu Toggle (mobile only) -->
            <button @click="toggleApplicationMenu()"
                class="flex items-center justify-center w-10 h-10 text-gray-700 rounded-lg z-99999 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 xl:hidden">
                <!-- Dots Icon -->
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M5.99902 10.4951C6.82745 10.4951 7.49902 11.1667 7.49902 11.9951V12.0051C7.49902 12.8335 6.82745 13.5051 5.99902 13.5051C5.1706 13.5051 4.49902 12.8335 4.49902 12.0051V11.9951C4.49902 11.1667 5.1706 10.4951 5.99902 10.4951ZM17.999 10.4951C18.8275 10.4951 19.499 11.1667 19.499 11.9951V12.0051C19.499 12.8335 18.8275 13.5051 17.999 13.5051C17.1706 13.5051 16.499 12.8335 16.499 12.0051V11.9951C16.499 11.1667 17.1706 10.4951 17.999 10.4951ZM13.499 11.9951C13.499 11.1667 12.8275 10.4951 11.999 10.4951C11.1706 10.4951 10.499 11.1667 10.499 11.9951V12.0051C10.499 12.8335 11.1706 13.5051 11.999 13.5051C12.8275 13.5051 13.499 12.8335 13.499 12.0051V11.9951Z"
                        fill="currentColor" />
                </svg>
            </button>

            <!-- Search Bar (desktop only) — see App\Http\Controllers\SearchController -->
            <div class="hidden xl:block"
                x-data="{
                    open: false,
                    query: '',
                    results: [],
                    activeIndex: 0,
                    async search() {
                        if (this.query.trim() === '') { this.results = []; return; }
                        const res = await fetch(`/search/suggest?q=${encodeURIComponent(this.query)}`);
                        const data = await res.json();
                        this.results = data.results;
                        this.activeIndex = 0;
                    },
                    openPalette() { this.open = true; this.$nextTick(() => this.$refs.searchInput.focus()); },
                    closePalette() { this.open = false; this.query = ''; this.results = []; },
                    goToActive() {
                        if (this.results[this.activeIndex]) {
                            window.location.href = this.results[this.activeIndex].url;
                        } else if (this.query.trim() !== '') {
                            window.location.href = `/search?q=${encodeURIComponent(this.query)}`;
                        }
                    }
                }"
                @keydown.window="if (($event.metaKey || $event.ctrlKey) && $event.key === 'k') { $event.preventDefault(); openPalette(); }"
                @keydown.window.escape="closePalette()">

                <button @click="openPalette()" class="relative block" type="button">
                    <span class="absolute -translate-y-1/2 pointer-events-none left-4 top-1/2">
                        <!-- Search Icon -->
                        <svg class="fill-gray-500 dark:fill-gray-400" width="20" height="20"
                            viewBox="0 0 20 20" fill="none">
                            <path fill-rule="evenodd" clip-rule="evenodd"
                                d="M3.04175 9.37363C3.04175 5.87693 5.87711 3.04199 9.37508 3.04199C12.8731 3.04199 15.7084 5.87693 15.7084 9.37363C15.7084 12.8703 12.8731 15.7053 9.37508 15.7053C5.87711 15.7053 3.04175 12.8703 3.04175 9.37363ZM9.37508 1.54199C5.04902 1.54199 1.54175 5.04817 1.54175 9.37363C1.54175 13.6991 5.04902 17.2053 9.37508 17.2053C11.2674 17.2053 13.003 16.5344 14.357 15.4176L17.177 18.238C17.4699 18.5309 17.9448 18.5309 18.2377 18.238C18.5306 17.9451 18.5306 17.4703 18.2377 17.1774L15.418 14.3573C16.5365 13.0033 17.2084 11.2669 17.2084 9.37363C17.2084 5.04817 13.7011 1.54199 9.37508 1.54199Z"
                                fill="" />
                        </svg>
                    </span>
                    <span class="dark:bg-dark-900 flex h-11 w-full items-center rounded-lg border border-gray-200 bg-transparent py-2.5 pl-12 pr-14 text-sm text-gray-400 shadow-theme-xs dark:border-gray-800 dark:bg-white/3 xl:w-[430px]">Search or type command...</span>
                    <span
                        class="absolute right-2.5 top-1/2 inline-flex -translate-y-1/2 items-center gap-0.5 rounded-lg border border-gray-200 bg-gray-50 px-[7px] py-[4.5px] text-xs -tracking-[0.2px] text-gray-500 dark:border-gray-800 dark:bg-white/[0.03] dark:text-gray-400">
                        <span> ⌘ </span>
                        <span> K </span>
                    </span>
                </button>

                <div x-show="open" x-cloak @click.self="closePalette()"
                    class="fixed inset-0 z-99999 flex items-start justify-center bg-gray-900/50 pt-24">
                    <div class="w-full max-w-xl rounded-lg bg-white shadow-xl dark:bg-gray-900" @click.outside="closePalette()">
                        <input x-ref="searchInput" type="text" x-model="query" @input.debounce.200ms="search()"
                            @keydown.arrow-down.prevent="activeIndex = Math.min(activeIndex + 1, results.length - 1)"
                            @keydown.arrow-up.prevent="activeIndex = Math.max(activeIndex - 1, 0)"
                            @keydown.enter.prevent="goToActive()"
                            placeholder="Search or type command..."
                            class="w-full rounded-t-lg border-b border-gray-200 bg-transparent px-4 py-3 text-sm text-gray-800 outline-hidden dark:border-gray-800 dark:text-white/90" />

                        <ul class="max-h-80 overflow-y-auto py-2">
                            <template x-for="(result, index) in results" :key="result.url">
                                <li>
                                    <a :href="result.url" class="flex items-center justify-between px-4 py-2 text-sm"
                                        :class="index === activeIndex ? 'bg-gray-100 dark:bg-white/[0.05]' : ''"
                                        @mouseenter="activeIndex = index">
                                        <span x-text="result.title" class="text-gray-800 dark:text-white/90"></span>
                                        <span x-text="result.category" class="text-xs text-gray-400"></span>
                                    </a>
                                </li>
                            </template>
                        </ul>

                        <a x-show="query.trim() !== ''" :href="`/search?q=${encodeURIComponent(query)}`"
                            class="block border-t border-gray-200 px-4 py-3 text-sm text-brand-600 dark:border-gray-800 dark:text-brand-400"
                            x-text="`See all results for &quot;${query}&quot;`"></a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Application Menu (mobile) and Right Side Actions (desktop) -->
        <div :class="isApplicationMenuOpen ? 'flex' : 'hidden'"
            class="items-center justify-between w-full gap-4 px-5 py-4 xl:flex shadow-theme-md xl:justify-end xl:px-0 xl:shadow-none">
            <div class="flex items-center gap-2 2xsm:gap-3">
                <!-- Theme Toggle Button -->
                <button
                    class="relative flex items-center justify-center text-gray-500 transition-colors bg-white border border-gray-200 rounded-full hover:text-dark-900 h-11 w-11 hover:bg-gray-100 hover:text-gray-700 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
                    @click="$store.theme.toggle()">
                    <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 20 20" fill="none"
