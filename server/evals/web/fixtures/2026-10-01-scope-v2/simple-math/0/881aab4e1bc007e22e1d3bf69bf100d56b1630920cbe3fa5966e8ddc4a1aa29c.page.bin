<button id="scroll-top-btn" class="scroll-top-btn" aria-label="Scroll to top" title="Scroll to top">
  <i class="fa-solid fa-arrow-up"></i>
</button>
<script>
(function () {
  var btn = document.getElementById('scroll-top-btn');
  if (!btn) return;
  function tick() {
    // Hidden on the vault's game overlay - it has its own fullscreen UI and
    // this button would float uselessly on top of it.
    var vault = document.getElementById('vault-overlay');
    var vaultOpen = vault && vault.classList.contains('open');
    btn.classList.toggle('visible', !vaultOpen && window.scrollY > 400);
  }
  window.addEventListener('scroll', tick, { passive: true });
  var vault = document.getElementById('vault-overlay');
  if (vault) new MutationObserver(tick).observe(vault, { attributes: true, attributeFilter: ['class'] });
  tick();
  btn.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
})();
</script>

<!-- ══ FOOTER BANNER ══ Below the site footer, every page. Mounted by
     assets/js/ads-content.js, which also handles the in-content slots on
     article/tool pages further down this file. -->
<div class="sc-ad sc-ad-footer" id="sc-gam-footer"></div>

<!-- ── Auto Table of Contents (article pages) ── -->
<script>
(function(){
  var body = document.querySelector('.article-body');
  if (!body) return;
  var h2s = body.querySelectorAll('h2');
  if (h2s.length < 2) return;
  var items = [];
  h2s.forEach(function(h, i){
    var id = 'sec-' + i;
    h.id = id;
    items.push('<li><a href="#' + id + '">' + h.textContent.trim() + '</a></li>');
  });
  var toc = document.createElement('div');
  toc.className = 'auto-toc';
  toc.innerHTML = '<span class="toc-label">Table of Contents</span><ol>' + items.join('') + '</ol>';
  body.parentNode.insertBefore(toc, body);
})();
</script>

<!-- ── Mobile nav toggle (all pages) ── -->
<script>
(function(){
  var btn = document.getElementById('mob-menu-btn');
  var nav = document.getElementById('mob-nav');
  if (btn) btn.addEventListener('click', function(){
    nav.classList.toggle('open');
  });
})();
</script>


<script>
/* Share links: upgrade the share text from the site name to the actual page
   title. The href is rendered server side from SITE_URL + path, which is
   correct for the URL, but the page's own title is not in scope there (it is
   passed into the header partial, not to the page), so it falls back to the
   site name. document.title has the real thing, so fix it up on load.
   Progressive: if this never runs, the links still work with the site name. */
(function () {
  var t = (document.title || '').trim();
  if (!t) return;
  var enc = encodeURIComponent(t);
  var links = document.querySelectorAll('a.share-icon-btn[href]');
  for (var i = 0; i < links.length; i++) {
    var href = links[i].getAttribute('href');
    if (!href) continue;
    var next = href.replace(/([?&](?:text|title)=)[^&]*/, '$1' + enc);
    if (next !== href) links[i].setAttribute('href', next);
  }
})();
</script>

