  <!-- ══ COMPARISON ══ Full-bleed white band so it lines up with the other
       full-width sections instead of sitting in a narrower boxed container. -->
  <div class="cs-compare-band">
    <section class="cs-compare-inner">
      <h2 class="home-section-title">SolveCalc vs a Regular Calculator</h2>
      <div class="sc-ad sc-ad-section" id="sc-gam-compare"></div>
      <p class="cs-compare-sub">A free online scientific calculator that runs in the browser - the solve calc most students mean when they search for one - plus <a href="/tools">20 math and finance tools</a> - compared against a handheld graphing calculator and a typical phone calculator app.</p>

      <div class="cs-compare-table-wrap">
        <table class="cs-compare-table">
          <caption class="cs-compare-caption">Feature comparison: free online scientific calculator vs physical calculator vs calculator app</caption>
          <thead>
            <tr>
              <th scope="col">Feature</th>
              <th scope="col" class="cs-compare-highlight">SolveCalc</th>
              <th scope="col">Physical calculator</th>
              <th scope="col">Calculator app</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Price</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Always free</td>
              <td>$15 - $150+ upfront</td>
              <td>Free, or paid to remove ads</td>
            </tr>
            <tr>
              <th scope="row">Download or install</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> None - opens in the browser</td>
              <td><span class="cs-na">Physical device</span></td>
              <td><i class="fa-solid fa-circle-xmark"></i> App store install required</td>
            </tr>
            <tr>
              <th scope="row">Works on school Chromebooks</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Yes, on any browser</td>
              <td><span class="cs-na">Not applicable</span></td>
              <td><i class="fa-solid fa-circle-xmark"></i> Installs usually blocked</td>
            </tr>
            <tr>
              <th scope="row">Account or sign-up</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Never required</td>
              <td><span class="cs-na">Not applicable</span></td>
              <td><i class="fa-solid fa-circle-xmark"></i> Often required</td>
            </tr>
            <tr>
              <th scope="row">Scientific functions</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> sin, cos, tan, log, ln, powers, roots, factorial</td>
              <td>Depends on the model</td>
              <td>Hidden behind a rotate gesture</td>
            </tr>
            <tr>
              <th scope="row">Full expression stays visible</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Yes, with edit and history</td>
              <td>One line on most models</td>
              <td><i class="fa-solid fa-circle-xmark"></i> Current number only</td>
            </tr>
            <tr>
              <th scope="row">Graphing calculator</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Built in, free</td>
              <td>Graphing models from $100+</td>
              <td><i class="fa-solid fa-circle-xmark"></i> Rarely included</td>
            </tr>
            <tr>
              <th scope="row">Fractions, percentages, ratios</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Dedicated tools with steps</td>
              <td>Decimal answer only</td>
              <td>Decimal answer only</td>
            </tr>
            <tr>
              <th scope="row">Step-by-step working shown</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Yes, on the solver tools</td>
              <td><i class="fa-solid fa-circle-xmark"></i> Answer only</td>
              <td><i class="fa-solid fa-circle-xmark"></i> Answer only</td>
            </tr>
            <tr>
              <th scope="row">Scratch notes for homework</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Built-in notepad, saves locally</td>
              <td><i class="fa-solid fa-circle-xmark"></i> Paper needed</td>
              <td><i class="fa-solid fa-circle-xmark"></i> No</td>
            </tr>
            <tr>
              <th scope="row">Keyboard and copy-paste input</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> Full keyboard support</td>
              <td><i class="fa-solid fa-circle-xmark"></i> Buttons only</td>
              <td>Touch only on most apps</td>
            </tr>
            <tr>
              <th scope="row">Tools beyond the calculator</th>
              <td class="cs-compare-highlight"><i class="fa-solid fa-circle-check"></i> 20+ math and family finance tools</td>
              <td><i class="fa-solid fa-circle-xmark"></i> None</td>
              <td><i class="fa-solid fa-circle-xmark"></i> Usually just one</td>
            </tr>
