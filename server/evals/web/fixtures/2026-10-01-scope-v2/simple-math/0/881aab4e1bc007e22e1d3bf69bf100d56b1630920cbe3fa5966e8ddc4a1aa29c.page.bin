              <div class="vault-splash-stack">
                <div class="vault-splash-card">
                  <img id="vault-splash-thumb" src="" alt="Game thumbnail">
                </div>
              </div>
            </div>
          </div>
          <div class="vault-splash-ad vault-splash-ad-bottom" id="vault-splash-ad-bottom"></div>
        </div>
        <!-- Ad loading overlay -->
        <div id="vault-ad-loader" class="vault-ad-loader">
          <div class="vault-ad-spinner"></div>
        </div>
        <!-- Pre-game video ad container (IMA renders the player + skip/countdown
             UI in here). Currently unused - the pre-roll is disabled, see the
             note by the script tags at the bottom of this file. Left in place
             so re-enabling is a two-line change. Never visible without the
             .active class, which only _playPrerollThen() adds. -->
        <div id="vault-ad-container" class="vault-ad-container"></div>
        <iframe id="vault-iframe" src="" allow="autoplay; fullscreen; gamepad; cross-origin-isolated" referrerpolicy="strict-origin-when-cross-origin" style="display:none"></iframe>

        <!-- Horizontal ad below the played game. Was already wired in
             main.js (_pushPlayAd, mounted the first time a game opens) but
             this container had been removed at some point with the trigger
             left behind - restored while migrating off AdSense. Sits inside
             .vault-play-view, which is itself display:none until a game is
             open, so this is never visible on the grid or splash screens. -->
        <div class="sc-ad sc-ad-section" id="sc-gam-playad"></div>

      </div>
      <div class="vault-side-right" id="vault-sidebar-right">
        <p class="vault-side-label">Up Next</p>
        <div id="vault-side-cards-right"></div>
      </div>
    </div>

    <!-- Blog panel: permanently part of normal page flow below .vault-split
         (the game area, kept at a stable height) inside #vault-play-view,
         which is always the scroll container - not a hidden/shown overlay
         toggled by a button, just an ordinary section of the page a
         visitor scrolls to, the same way the "Read more" link/button below
         scrolls to it rather than revealing it. ALL 5 posts' article
         markup is server-rendered right here, each in its own [data-slug]
         container (all hidden except whichever one matches the current
         game - main.js switches that as different splash screens open) -
         rather than fetched by JS after a click, which would be invisible
         to Google, and rather than embedding just one, which would mean a
         different game's splash could only ever point back at the same
         single post. main.js only toggles which container is shown and
         mounts that one's ad slots once it actually scrolls into view; it
         never writes any article HTML itself. -->
    <div id="vault-blog-panel" class="vault-blog-panel">
      <div class="vault-blog-panel-inner">
        <button type="button" id="vault-blog-backtogame-btn" class="vault-blog-backtogame-btn">
          <i class="fa-solid fa-chevron-up"></i> Back to Game
        </button>
        <div id="vault-blog-panel-content" class="vault-blog-panel-content">
          
          
          <div class="article-page vault-blog-article" data-slug="online-college-cost-2026" hidden></div>
          
          
          <div class="article-page vault-blog-article" data-slug="uk-us-spain-degree-cost-comparison" hidden></div>
          
          
          <div class="article-page vault-blog-article" data-slug="spain-study-abroad-rise" hidden></div>
          
          
          <div class="article-page vault-blog-article" data-slug="how-to-pick-a-college-beyond-rankings" hidden></div>
          
          
          <div class="article-page vault-blog-article" data-slug="which-online-majors-are-worth-it" hidden></div>
          
        </div>
        <button type="button" class="vault-blog-backtogame-btn vault-blog-backtogame-btn-bottom" data-vault-blog-backtogame>
          <i class="fa-solid fa-chevron-up"></i> Back to Game
        </button>
      </div>
    </div>
  </div>


</div><!-- /vault-overlay -->

<style>
/* ── Vault Splash Screen ── */
.vault-splash {
  display: none;
  overflow: hidden;
  background: #0d0d14;
}
.vault-splash.active {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0; left: 0; right: 0;
  bottom: 0; /* full height, no ad zone */
  z-index: 2;
}

/* Blurred background images */
.vsplash-bg {
  position: absolute; inset: 0;
  display: flex;
  z-index: 0;
}
.vsplash-bg-img {
  flex: 1; min-width: 0;
  object-fit: cover;
  filter: blur(14px);
  transform: scale(1.12);
  opacity: 0.75;
}
.vsplash-bg-overlay {
  position: absolute; inset: 0;
  background: rgba(0,0,0,0.58);
}

/* Inner wrapper */
.vault-splash-inner {
  width: 100%;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 56px;
  padding: 48px 40px;
  box-sizing: border-box;
}

/* Splash ad slots - one above the game card, one below the Start CTA.
   min-height (not height) reserves the space: it stops the splash reflowing
   when an ad fills, while still letting a responsive unit render taller than
   expected instead of being clipped. Clipping matters - an obscured or
   cropped ad is an AdSense policy breach, so nothing here may use
   overflow:hidden or a max-height. */
.vault-splash-ad {
  position: relative; z-index: 1;
  width: 100%; max-width: 728px;
  min-height: 90px;
  flex: 0 0 auto;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
/* Visible: non-blocking display slots above and below the game card. The
   visitor can press Start at any time, which is what keeps these ordinary
   in-content placements rather than an interstitial. */
.vault-splash-ad ins { width: 100%; }
/* No vertical margin on the slots themselves. The gap above and below the
   card is owned solely by .vault-splash-inner's padding, so both ads sit the
   same distance from the content - adding a margin here as well made the top
   gap (margin + padding) visibly larger than the bottom one (padding only). */
.vault-splash-ad-top,
.vault-splash-ad-bottom { margin: 0 auto; }

@media (max-width: 900px) {
  .vault-splash-ad { max-width: 468px; min-height: 60px; }
}
@media (max-width: 520px) {
  /* Two banners plus the card and CTA do not fit a phone viewport at 100px
     each, so the mobile pair is shorter. The splash scrolls if a responsive
     unit still comes back taller than the reserved height. */
  .vault-splash-ad { max-width: 320px; min-height: 100px; }
}

/* Foreground */
.vault-splash-left { flex: 1; max-width: 420px; }
.vault-splash-right { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

.vault-splash-title {
  font-size: 2rem; font-weight: 800; margin: 0 0 14px;
  color: #fff;
  line-height: 1.2;
  text-shadow: 0 2px 12px rgba(0,0,0,0.5);
}
.vault-splash-desc {
  color: rgba(255,255,255,0.7); font-size: 0.97rem; line-height: 1.65;
  margin: 0 0 32px;
}
.vault-splash-play-btn {
  display: inline-flex; align-items: center; gap: 12px;
  background: #e53935; color: #fff;
  border: none; border-radius: 6px;
  padding: 20px 52px;
  font-size: 1.15rem; font-weight: 800; letter-spacing: 0.07em;
  cursor: pointer;
  box-shadow: none;
  transition: background 0.15s, transform 0.1s;
}
.vault-splash-play-btn svg { width: 30px; height: 30px; }
.vault-splash-play-btn svg path { stroke: currentColor; stroke-width: 3.5; stroke-linejoin: round; }
.vault-splash-play-btn:hover { background: #c62828; transform: translateY(-1px); }
.vault-splash-play-btn:active { transform: translateY(1px); }
.vault-splash-play-btn:disabled { background: #555; cursor: not-allowed; }

/* CTA block: button + hint left-aligned with title */
.vault-splash-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
.vault-splash-hint { color: rgba(255,255,255,0.45); font-size: 0.8rem; margin: 11px 0 0; text-align: left; }

/* "Read more from our blog" teaser line, between the description and the
   Start button. Link text is the dynamic post title (set by
   _showSplash() in main.js); the button is a second, equally-clickable
   way to open the same panel, for anyone who scrolls past the inline link. */
.vault-splash-blog-teaser {
  color: rgba(255,255,255,0.6); font-size: 0.85rem; margin: -18px 0 20px;
  display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
}
.vault-splash-blog-thumb { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; flex-shrink: 0; background: rgba(255,255,255,0.1); }
.vault-splash-blog-link { color: #ffb74d; font-weight: 700; text-decoration: none; }
.vault-splash-blog-link:hover { text-decoration: underline; }
.vault-splash-blog-btn {
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25);
  color: #fff; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.02em;
  padding: 4px 12px; border-radius: 999px; cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.vault-splash-blog-btn:hover { background: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.4); }
@media (max-width: 900px) { .vault-splash-blog-teaser { justify-content: center; margin-top: -6px; } }

/* Stacked card effect */
.vault-splash-stack {
  position: relative;
  width: 260px; height: 260px;
}
/* Card 3 -furthest back, most rotated */
.vault-splash-stack::before {
  content: '';
  position: absolute; inset: 0;
  border-radius: 6px;
  border: 6px solid rgba(255,255,255,0.55);
  background: #2a2030;
  transform: rotate(10deg) translate(14px, 10px);
  z-index: 0;
}
/* Card 2 -middle */
.vault-splash-stack::after {
  content: '';
  position: absolute; inset: 0;
  border-radius: 6px;
  border: 6px solid rgba(255,255,255,0.8);
  background: #1e1830;
  transform: rotate(5deg) translate(7px, 5px);
  z-index: 1;
}
/* Card 1 -front (actual thumb) */
.vault-splash-card {
  position: absolute; inset: 0;
  border-radius: 6px; overflow: hidden;
  box-shadow: 0 28px 72px rgba(0,0,0,0.6), 0 8px 24px rgba(0,0,0,0.4);
  transform: rotate(-3deg);
  border: 0;
  background: #111;
  z-index: 2;
}
.vault-splash-card img { width: 100%; height: 100%; object-fit: cover; display: block; }

@media (max-width: 900px) {
  .vault-splash-inner { flex-direction: column; align-items: center; justify-content: center; gap: 32px; padding: 32px 24px; text-align: center; }
  .vault-splash-left { max-width: 100%; margin-top: 0; }
  .vault-splash-right { order: -1; }
  .vault-splash-stack { width: 180px; height: 180px; }
  .vault-splash-title { font-size: 1.6rem; margin-bottom: 12px; }
  .vault-splash-cta { align-items: center; }
  .vault-splash-hint { text-align: center; }
}
@media (max-width: 520px) {
  .vault-splash-inner { gap: 24px; padding: 20px 16px; }
  .vault-splash-stack { width: 130px; height: 130px; }
  .vault-splash-title { font-size: 1.25rem; }
  .vault-splash-play-btn { padding: 16px 36px; font-size: 1rem; }
  .vault-splash-desc { font-size: 0.88rem; margin-bottom: 18px; }
}

/* Ad loading spinner overlay */
.vault-ad-loader {
  display: none;
  position: absolute;
  /* Start below the frame header (Back/title/Exit row) so the spinner sits in
     the real play area, vertically centred - not the whole frame. The header
     height is published as --vault-header-h from JS; 53px is the fallback. */
  top: var(--vault-header-h, 53px); left: 0; right: 0; bottom: 0;
  background: #ebebeb;
  align-items: center;
  justify-content: center;
  z-index: 5;
}
.vault-ad-loader.active { display: flex; }

/* Pre-game video ad container. Confined to the real play area - below the
   frame header (Back/title/Exit row) down to the bottom - so it fills exactly
   the box the game iframe occupies, not the header. z-index sits above the
   loader/splash so the ad covers them while playing. IMA draws its own player,
   skip button and countdown inside this element - we only size and place it. */
.vault-ad-container {
  display: none;
  position: absolute;
  top: var(--vault-header-h, 53px); left: 0; right: 0; bottom: 0;
  background: #000;
  z-index: 6;
}
.vault-ad-container.active { display: block; }
/* Escape hatch shown a few seconds into a video ad. Some VAST creatives ship
   with no skip and no close control at all, so this is the only guaranteed way
   out for the visitor. Sits above IMA's own player (which renders inside this
   container) so a creative can never cover it. */
.vault-ad-escape {
  /* Bottom-LEFT deliberately. IMA renders its own "Skip Ad" control in the
     bottom-RIGHT of the ad player, and on a skippable creative that overruns
     its declared duration both can be on screen at once - same corner would
     mean one sitting on top of the other. */
  position: absolute; left: 14px; bottom: 14px; z-index: 10;
  font: 700 15px/1 'Noto Sans', system-ui, sans-serif;
  color: #fff; background: rgba(0,0,0,.78);
  border: 1px solid rgba(255,255,255,.4);
  border-radius: 0;
  padding: 13px 22px; cursor: pointer;
  transition: background .15s;
}
.vault-ad-escape:hover { background: rgba(0,0,0,.92); }
@media (max-width: 760px) {
  .vault-ad-escape { left: 10px; bottom: 10px; font-size: 14px; padding: 12px 18px; }
}
.vault-ad-spinner {
  width: 64px; height: 64px;
  border: 5px solid #d0d0d0;
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: vaultSpin 0.75s linear infinite;
}
@keyframes vaultSpin { to { transform: rotate(360deg); } }
</style>

<!-- ── PRE-ACTIVITY VIDEO AD: ENABLED (VDO.AI VAST) ─────────────────────
     The IMA pre-roll plays a VDO.AI VAST creative in the vault, then the
     activity starts. Enabled 2026-08-18 after VDO approved the site and
     turned on video demand (tag served from targeting.vdo.ai, not GAM).

     The game ALWAYS starts: every ad failure path (no SDK, ad blocker, no
     fill, VAST error, timeout) still fires the launch callback - see
     _playPrerollThen() in main.js.

     NOTE: do NOT substitute a hardcoded display unit here, AdSense or
     Ad.Plus/GAM alike. A display unit inside a blocking gate is a
     publisher-built interstitial, which AdSense policy prohibits - a skip
     button does not make it compliant. Only Google-rendered products
     (IMA/VAST, H5 Games Ads adBreak, or a genuine GAM/Ad.Plus Interstitial
     out-of-page slot, whose timing Google controls) may gate content.
     ──────────────────────────────────────────────────────────────────── -->


<script data-cfasync="false" src="/assets/js/main.min.js?v=d1edd765"></script>
<script>
(function () {
  var playBtn = document.getElementById('vault-splash-play-btn');
  if (playBtn) {
    playBtn.addEventListener('click', function () {
      playBtn.disabled = true;                       // guard double-clicks
      if (typeof _hideSplash === 'function') _hideSplash();

      // Show the centered spinner ONLY while we actually wait on an ad. A
      // frequency-capped user (already watched one in the last 24h) plays no ad
      // and the game opens directly, so the ad-loader is skipped for them - no
      // spinner. They still see the game's own top loading bar as it downloads.
      var _willWaitOnAd = (typeof _prerollSuppressed === 'function') ? !_prerollSuppressed() : true;
      var adLoaderEl = document.getElementById('vault-ad-loader');
      if (adLoaderEl && _willWaitOnAd) adLoaderEl.classList.add('active');

      // Start loading the activity in the background NOW, in parallel with the
      // ad request, so it is ready the instant the ad ends or a no-fill
      // resolves. It stays hidden until launch reveals it.
      if (typeof _preloadGameFrame === 'function') _preloadGameFrame();

      var launch = function () {
        if (typeof _hideSplashAndLaunch === 'function') _hideSplashAndLaunch();
      };

      // Play the VDO.AI VAST pre-roll, then launch. _playPrerollThen always
      // calls launch() - on ad success, skip, no-fill, error, or timeout - so
      // the activity can never be blocked by an ad problem.
      if (typeof _playPrerollThen === 'function') {
        _playPrerollThen(launch);
      } else {
        launch();
      }
    });
  }
})();
</script>

<script>
/* Hero slider */
(function(){
  var track = document.querySelector('.hero-track');
  var dots  = document.querySelectorAll('.hero-dot');
  var prevBtn = document.getElementById('hero-prev');
  var nextBtn = document.getElementById('hero-next');
  if (!track) return;
  var cur = 0, total = 3, timer;

  function goTo(idx) {
    cur = (idx + total) % total;
    track.style.transform = 'translateX(-' + (cur * 100) + '%)';
    dots.forEach(function(d, i) {
      d.classList.toggle('active', i === cur);
      d.setAttribute('aria-selected', i === cur ? 'true' : 'false');
    });
  }

  function next() { goTo(cur + 1); }
  function prev() { goTo(cur - 1); }

  function start() { timer = setInterval(next, 5000); }
  function stop()  { clearInterval(timer); }

  dots.forEach(function(d) {
    d.addEventListener('click', function() {
      stop(); goTo(+this.dataset.idx); start();
    });
  });

  if (prevBtn) prevBtn.addEventListener('click', function() { stop(); prev(); start(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { stop(); next(); start(); });

  /* Pause on hover */
  var slider = document.querySelector('.hero-slider');
  if (slider) {
    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
  }

  start();
})();
</script>

<!-- Force the GAM/Ad.Plus anchor + interstitial overlays above the game
     vault (z-index: 9000). Google's interstitial out-of-page format shares
     its rendering with Auto Ads vignette, so the same #google_vignette /
     #google_esf ids apply; [id^="google_ads_iframe"] catches the anchor and
     any other out-of-page unit regardless of format. -->
<style>
#google_vignette,
#google_esf,
.google-auto-placed,
[id^="google_ads_iframe"],
ins.adsbygoogle[data-anchor-shown="true"] {
  z-index: 2147483647 !important;
}
/* ...but while the vault pre-roll video ad is playing, hide the anchor and
   interstitial so neither can overlap the video or cover IMA's skip button
   (restored the moment the ad ends). Fixes the mobile skip-button bug. */
body.sc-vault-preroll #google_vignette,
body.sc-vault-preroll #google_esf,
body.sc-vault-preroll .google-auto-placed,
body.sc-vault-preroll [id^="google_ads_iframe"],
body.sc-vault-preroll ins.adsbygoogle[data-anchor-shown="true"] {
  display: none !important;
}
</style>

