  <!-- Ad.Plus / Google Ad Manager. Replaces AdSense (the adsbygoogle.js
       loader + all "ins.adsbygoogle" units + Auto Ads) sitewide. Network
       code 23350311221, same MCM code already used for the VDO.ai pre-roll.
       Turn Auto Ads off in the AdSense dashboard once this is live in
       production - running both risks duplicate anchors/vignettes stacking
       and a policy flag. -->
  <script async src="https://securepubads.g.doubleclick.net/tag/js/gpt.js" crossorigin="anonymous"></script>
  <script>
    window.googletag = window.googletag || { cmd: [] };

    // Single-request mode, set ONCE for the whole page via the modern
    // setConfig API. Every slot-mount function across the site (this file,
    // main.js, ads-content.js) used to call the older
    // pubads().enableSingleRequest() itself - harmless, but it is deprecated
    // (GPT logs a console warning every time) and was never meant to be
    // called per slot; one setConfig here covers the entire page.
    //
    // lazyLoad is here for a real, measured reason: ads-content.js can drop
    // up to 7 separate 300x250 slots down a long page (one every ~600px),
    // and without this every one of them fetched and rendered the instant
    // the page loaded - a slot 4000px down counted as a served impression
    // immediately even though most visitors never scroll that far. That is
    // why that unit's measured viewability sat at ~18% against 80%+ for the
    // sticky anchor, and its eCPM was a fraction of every other unit's.
    // fetchMarginPercent/renderMarginPercent delay each slot until it is
    // actually about to be seen; mobileScaling widens that margin on phones,
    // where viewport height is smaller and scroll velocity is higher. Values
    // match Google's own documented PageSettingsConfig.lazyLoad example
    // (fetch within 5 viewports, render within 2) rather than a tighter,
    // untested guess - deliberately not the most aggressive setting
    // possible, since margins tight enough to miss a fast scroller's render
    // window trade a non-viewable impression for a dropped one entirely.
    googletag.cmd.push(function () {
      googletag.setConfig({
        singleRequest: true,
        lazyLoad: {
          fetchMarginPercent: 500,
          renderMarginPercent: 200,
          mobileScaling: 2.0
        }
      });
    });

    // Sticky Anchor. Same treatment the old AdSense anchor got: forced above
    // the game vault (see #google_vignette rule below, now retargeted) and
    // hidden during the pre-roll so it cannot cover IMA's skip button.
    googletag.cmd.push(function () {
      var anchorSlot = googletag.defineOutOfPageSlot(
        '/21849154601,23350311221/Ad.Plus-Anchor',
        googletag.enums.OutOfPageFormat.BOTTOM_ANCHOR
      );
      if (anchorSlot) {
        anchorSlot.addService(googletag.pubads());
        googletag.enableServices();
        googletag.display(anchorSlot);
        setInterval(function () { googletag.pubads().refresh([anchorSlot]); }, 30000);
      }
    });

    // Interstitial. Google's own frequency capping decides when it actually
    // shows - this just registers it, same as Ad.Plus's supplied snippet.
    googletag.cmd.push(function () {
      var interstitialSlot = googletag.defineOutOfPageSlot(
        '/21849154601,23350311221/Ad.Plus-Interstitial',
        googletag.enums.OutOfPageFormat.INTERSTITIAL
      );
      if (interstitialSlot) {
        interstitialSlot.addService(googletag.pubads());
        googletag.enableServices();
        googletag.display(interstitialSlot);
      }
    });

  </script>
