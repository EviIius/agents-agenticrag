<main>

<script>
(function(){
  var FONT_KEY = 'sc_a11y_font';
  var step = 0, minStep = -2, maxStep = 3;
  var baseSize = 17;

  function applyFont(s){
    document.documentElement.style.fontSize = (baseSize + s * 1.5) + 'px';
  }

  // Restore saved pref immediately
  step = parseInt(localStorage.getItem(FONT_KEY) || '0', 10);
  applyFont(step);

  document.addEventListener('DOMContentLoaded', function(){
    var btn = document.getElementById('a11y-btn');
    var panel = document.getElementById('a11y-panel');
    var wrap = document.getElementById('a11y-wrap');

    btn.addEventListener('click', function(e){
      e.stopPropagation();
      var open = panel.classList.toggle('a11y-panel-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', function(e){
      if(!wrap.contains(e.target)){
        panel.classList.remove('a11y-panel-open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    function bindSzBtn(upId, downId, resetId){
      var el;
      if((el = document.getElementById(upId)))    el.addEventListener('click', function(){ if(step < maxStep){ step++; applyFont(step); localStorage.setItem(FONT_KEY, step); } });
      if((el = document.getElementById(downId)))  el.addEventListener('click', function(){ if(step > minStep){ step--; applyFont(step); localStorage.setItem(FONT_KEY, step); } });
      if((el = document.getElementById(resetId))) el.addEventListener('click', function(){ step = 0; applyFont(0); localStorage.setItem(FONT_KEY, 0); });
    }
    // Desktop panel buttons
    bindSzBtn('a11y-sz-up', 'a11y-sz-down', 'a11y-sz-reset');
    // Mobile menu buttons
    bindSzBtn('mob-a11y-sz-up', 'mob-a11y-sz-down', 'mob-a11y-sz-reset');
  });
})();
</script>




