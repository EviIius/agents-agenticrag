          <span class="cs-model">SC-CM-0000</span>
<label class="code-toggle-wrap" for="vault-toggle">
            <span class="code-toggle-label">Code Mode</span>
            <input type="checkbox" id="vault-toggle" class="code-toggle-input">
            <span class="code-toggle-track"><span class="code-toggle-thumb"></span></span>
          </label>
        </div>

        <!-- Display -->
        <div class="calc-display-wrap">
          <div class="calc-expr" id="calc-expr"></div>
          <div class="calc-display" id="calc-display">0</div>
        </div>

        <!-- Physical theme only: modifier pills -->
        <div class="cs-modifiers">
          <button class="cs-mod" id="cs-shift-btn" onclick="calcToggleShift()">Shift</button>
          <button class="cs-mod" onclick="calcAlphaAns()">Alpha</button>
          <button class="cs-mod cs-replay" onclick="calcReplay()">Replay</button>
        </div>

        <!-- Physical theme only: scientific function row -->
        <div class="calc-sci-label">Scientific</div>
        <div class="calc-sci-panel">
        <div class="calc-sci-row">
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">sin⁻¹</span><span class="key-hint-alpha">A</span></span><button class="cbtn cbtn-fn" onclick="calcTrig('sin')"><span class="letter">sin</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">cos⁻¹</span><span class="key-hint-alpha">B</span></span><button class="cbtn cbtn-fn" onclick="calcTrig('cos')"><span class="letter">cos</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">tan⁻¹</span><span class="key-hint-alpha">C</span></span><button class="cbtn cbtn-fn" onclick="calcTrig('tan')"><span class="letter">tan</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">√</span><span class="key-hint-alpha">D</span></span><button class="cbtn cbtn-fn" onclick="calcFn('x*x')"><span class="letter">x²</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">x²</span><span class="key-hint-alpha">E</span></span><button class="cbtn cbtn-fn" onclick="calcFn('Math.sqrt(x)')"><span class="letter">√</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">sin</span><span class="key-hint-alpha">F</span></span><button class="cbtn cbtn-fn2" onclick="calcTrig('asin')"><span class="letter">sin⁻¹</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">cos</span><span class="key-hint-alpha">X</span></span><button class="cbtn cbtn-fn2" onclick="calcTrig('acos')"><span class="letter">cos⁻¹</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">tan</span><span class="key-hint-alpha">Y</span></span><button class="cbtn cbtn-fn2" onclick="calcTrig('atan')"><span class="letter">tan⁻¹</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">∛</span><span class="key-hint-alpha">M</span></span><button class="cbtn cbtn-fn" onclick="calcFn('x*x*x')"><span class="letter">x³</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">x³</span></span><button class="cbtn cbtn-fn" onclick="calcFn('Math.cbrt(x)')"><span class="letter">∛</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">10ˣ</span><span class="key-hint-alpha">(</span></span><button class="cbtn cbtn-fn" onclick="calcFn('Math.log10(x)')"><span class="letter">log</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">eˣ</span><span class="key-hint-alpha">)</span></span><button class="cbtn cbtn-fn" onclick="calcFn('Math.log(x)')"><span class="letter">ln</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">2ˣ</span><span class="key-hint-alpha">,</span></span><button class="cbtn cbtn-fn" onclick="calcFn('Math.log2(x)')"><span class="letter">log₂</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">nPr</span></span><button class="cbtn cbtn-fn" onclick="calcFn('(function(n){n=Math.round(n);if(n<0)return NaN;let r=1;for(let i=2;i<=n;i++)r*=i;return r;})(x)')"><span class="letter">n!</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-shift">x!</span></span><button class="cbtn cbtn-fn" onclick="calcFn('1/x')"><span class="letter">1/x</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-alpha">STO</span></span><button class="cbtn cbtn-const" onclick="calcConst('Math.PI')"><span class="letter">π</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-alpha">RCL</span></span><button class="cbtn cbtn-const" onclick="calcConst('e')"><span class="letter">e</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-alpha">M+</span></span><button class="cbtn cbtn-paren cbtn-op" onclick="calcParen('(')"><span class="letter">(</span></button></div>
          <div class="key-cell"><span class="key-hint"><span class="key-hint-alpha">M-</span></span><button class="cbtn cbtn-paren cbtn-op" onclick="calcParen(')')"><span class="letter">)</span></button></div>
        </div>
        </div><!-- /calc-sci-panel -->

        <!-- Buttons -->
        <div class="calc-grid calc-grid-standard">
          <!-- Row 1: Scientific -->
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.sin(x*Math.PI/180)')">sin</button>
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.cos(x*Math.PI/180)')">cos</button>
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.tan(x*Math.PI/180)')">tan</button>
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.log10(x)')">log</button>
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.log(x)')">ln</button>

          <!-- Row 2: More scientific -->
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.pow(x,2)')">x²</button>
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.pow(x,3)')">x³</button>
          <button class="cbtn cbtn-fn" onclick="calcFn('Math.sqrt(x)')">√</button>
          <button class="cbtn cbtn-fn" onclick="calcConst('Math.PI')">π</button>
          <button class="cbtn cbtn-fn" onclick="calcConst('Math.E')">e</button>

          <!-- Row 3: Controls -->
          <button class="cbtn cbtn-cl" onclick="calcClear()">AC</button>
          <button class="cbtn cbtn-cl" onclick="calcBack()">⌫</button>
          <button class="cbtn cbtn-op" onclick="calcParen('(')"> ( </button>
          <button class="cbtn cbtn-op" onclick="calcParen(')')"> ) </button>
          <button class="cbtn cbtn-op" onclick="calcOp('%')">%</button>

          <!-- Row 4 -->
          <button class="cbtn cbtn-num" onclick="calcDigit('7')">7</button>
          <button class="cbtn cbtn-num" onclick="calcDigit('8')">8</button>
          <button class="cbtn cbtn-num" onclick="calcDigit('9')">9</button>
          <button class="cbtn cbtn-op" onclick="calcOp('÷')">÷</button>
          <button class="cbtn cbtn-op" onclick="calcOp('×')">×</button>

          <!-- Row 5 -->
          <button class="cbtn cbtn-num" onclick="calcDigit('4')">4</button>
          <button class="cbtn cbtn-num" onclick="calcDigit('5')">5</button>
          <button class="cbtn cbtn-num" onclick="calcDigit('6')">6</button>
          <button class="cbtn cbtn-op" onclick="calcOp('-')">−</button>
          <button class="cbtn cbtn-op" onclick="calcOp('+')">+</button>

          <!-- Row 6 -->
          <button class="cbtn cbtn-num" onclick="calcDigit('1')">1</button>
          <button class="cbtn cbtn-num" onclick="calcDigit('2')">2</button>
          <button class="cbtn cbtn-num" onclick="calcDigit('3')">3</button>
          <button class="cbtn cbtn-num cbtn-wide2" onclick="calcDigit('0')">0</button>
          <button class="cbtn cbtn-num" onclick="calcDot()">.</button>

          <!-- Row 7: Equals spans full width -->
          <button class="cbtn cbtn-eq cbtn-wide5" onclick="calcEquals()">=</button>
        </div><!-- /calc-grid -->

        <!-- Physical theme only: 4-column grid -->
        <div class="calc-grid-physical">
          <button class="cbtn cbtn-cl"  onclick="calcClear()"><span class="letter">AC</span></button>
          <button class="cbtn cbtn-cl"  onclick="calcBack()"><span class="letter">⌫</span></button>
          <button class="cbtn cbtn-op"  onclick="calcOp('%')"><span class="letter">%</span></button>
          <button class="cbtn cbtn-op"  onclick="calcOp('÷')"><span class="letter">÷</span></button>

          <button class="cbtn cbtn-num" onclick="calcDigit('7')"><span class="letter">7</span></button>
          <button class="cbtn cbtn-num" onclick="calcDigit('8')"><span class="letter">8</span></button>
          <button class="cbtn cbtn-num" onclick="calcDigit('9')"><span class="letter">9</span></button>
          <button class="cbtn cbtn-op"  onclick="calcOp('×')"><span class="letter">×</span></button>

          <button class="cbtn cbtn-num" onclick="calcDigit('4')"><span class="letter">4</span></button>
          <button class="cbtn cbtn-num" onclick="calcDigit('5')"><span class="letter">5</span></button>
          <button class="cbtn cbtn-num" onclick="calcDigit('6')"><span class="letter">6</span></button>
          <button class="cbtn cbtn-op"  onclick="calcOp('-')"><span class="letter">−</span></button>

          <button class="cbtn cbtn-num" onclick="calcDigit('1')"><span class="letter">1</span></button>
          <button class="cbtn cbtn-num" onclick="calcDigit('2')"><span class="letter">2</span></button>
          <button class="cbtn cbtn-num" onclick="calcDigit('3')"><span class="letter">3</span></button>
          <button class="cbtn cbtn-op"  onclick="calcOp('+')"><span class="letter">+</span></button>

          <button class="cbtn cbtn-num cbtn-wide2" onclick="calcDigit('0')"><span class="letter">0</span></button>
          <button class="cbtn cbtn-num" onclick="calcDot()"><span class="letter">.</span></button>
          <button class="cbtn cbtn-eq"  onclick="calcEquals()"><span class="letter">=</span></button>
        </div><!-- /calc-grid-physical -->

      </div><!-- /calc-widget -->
      </div><!-- /device-frame -->

    </div><!-- /calc-col -->
      <aside class="sc-ad sc-ad-rail" id="sc-gam-rail-right" aria-label="Advertisement"></aside>
      </div><!-- /calc-stage -->

    <!-- Short trust/feature chips, right under the calculator - real,
         checkable claims (client-side, no install) plus the grade band
         this calculator is built for, for both users and search engines. -->
    <div class="calc-feat-chips" aria-label="Calculator highlights">
      <span class="calc-feat-chip"><i class="fa-solid fa-laptop"></i> Chromebook Ready</span>
      <span class="calc-feat-chip"><i class="fa-solid fa-shield-halved"></i> Client-Side CalcSolver</span>
      <span class="calc-feat-chip"><i class="fa-solid fa-graduation-cap"></i> Grades 3-12</span>
      <span class="calc-feat-chip"><i class="fa-solid fa-download"></i> No Install</span>
      <span class="calc-feat-chip"><i class="fa-solid fa-bolt"></i> Instant Results</span>
      <span class="calc-feat-chip"><i class="fa-solid fa-user-shield"></i> FERPA &amp; COPPA Friendly</span>
      <span class="calc-feat-chip"><i class="fa-solid fa-eye-slash"></i> Zero Tracking</span>
    </div>

    <!-- Highest-viewability ad on the page: right below the calculator,
         before scroll depth drops off. Measured: sc-gam-whatis further down
         sits 3.3 screens below the calculator, and the deepest section-break
         slots sit 11-19 screens below it - if most visitors stop scrolling
         at the calculator, this is the one slot on the page every one of
         them actually sees. 300x250, same as the other section-break ads. -->
    <div class="sc-ad sc-ad-section" id="sc-gam-belowcalc"></div>

    <section class="htu-section" aria-label="How to use the calculator">
      <div class="htu-head" id="htu-head" role="button" tabindex="0" aria-expanded="true" aria-controls="htu-table-wrap">
        <h2 class="htu-h2">How to use CalcSolver</h2>
        <span class="htu-toggle" id="htu-toggle">
          <i class="fa-solid fa-chevron-down"></i>
        </span>
      </div>
      <div class="htu-table-wrap" id="htu-table-wrap">
        <table class="htu-table"><caption class="visually-hidden">How to use CalcSolver</caption>
          <thead><tr><th>Buttons</th><th>Usage</th></tr></thead>
          <tbody>
            <tr>
              <td><span class="htu-k htu-k-fn">sin</span><span class="htu-k htu-k-fn">cos</span><span class="htu-k htu-k-fn">tan</span></td>
              <td>Trigonometric functions, calculated in degrees:<br>
                <span class="htu-ex"><span class="htu-k htu-k-fn">sin</span><span class="htu-k">3</span><span class="htu-k">0</span><span class="htu-k htu-k-eq">=</span><b>0.5</b></span>
                <div class="htu-cm">Code Mode: <code>sin(30)</code>, <code>cos(60)</code>, <code>tan(45)</code></div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-fn">log</span></td>
              <td>Base-10 logarithm:<br>
                <span class="htu-ex"><span class="htu-k htu-k-fn">log</span><span class="htu-k">1</span><span class="htu-k">0</span><span class="htu-k">0</span><span class="htu-k htu-k-eq">=</span><b>2</b></span>
                <div class="htu-cm">Code Mode: <code>log(100)</code> &middot; More: <a href="/guides/calcsolver-code-mode">CalcSolver Code Mode Guide</a></div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-fn">ln</span></td>
              <td>Natural logarithm (base e):<br>
                <span class="htu-ex"><span class="htu-k htu-k-fn">ln</span><span class="htu-k">1</span><span class="htu-k htu-k-eq">=</span><b>0</b></span>
                <div class="htu-cm">Code Mode: <code>ln(1)</code></div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-fn">x²</span><span class="htu-k htu-k-fn">x³</span><span class="htu-k htu-k-fn">√</span></td>
              <td>Squares, cubes, and square roots:<br>
                <span class="htu-ex"><span class="htu-k">5</span><span class="htu-k htu-k-fn">x²</span><span class="htu-k htu-k-eq">=</span><b>25</b> &nbsp; <span class="htu-k">6</span><span class="htu-k">4</span><span class="htu-k htu-k-fn">√</span><span class="htu-k htu-k-eq">=</span><b>8</b></span>
                <div class="htu-cm">Code Mode: <code>5^2</code>, <code>sqrt(64)</code></div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-fn">π</span><span class="htu-k htu-k-fn">e</span></td>
              <td>The constants pi (3.14159...) and Euler's number (2.71828...):<br>
                <span class="htu-ex"><span class="htu-k">2</span><span class="htu-k htu-k-op">×</span><span class="htu-k htu-k-fn">π</span><span class="htu-k htu-k-eq">=</span><b>6.283...</b></span>
                <div class="htu-cm">Code Mode: <code>pi</code>, <code>e</code> &middot; also <code>^</code> for powers and <code>!</code> for factorial</div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-cl">AC</span></td>
              <td>Clears the screen and starts over.</td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-cl">⌫</span></td>
              <td>Deletes the last character entered:<br>
                <span class="htu-ex"><span class="htu-k">9</span><span class="htu-k">8</span><span class="htu-k">7</span><span class="htu-k htu-k-cl">⌫</span><b>98</b></span>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k">1</span><span class="htu-k">2</span><span class="htu-k">3</span><span class="htu-k">4</span><span class="htu-k">5</span><span class="htu-k">6</span><span class="htu-k">7</span><span class="htu-k">8</span><span class="htu-k">9</span><span class="htu-k">0</span></td>
              <td>Entering numbers.</td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-op">+</span><span class="htu-k htu-k-op">−</span><span class="htu-k htu-k-op">×</span><span class="htu-k htu-k-op">÷</span></td>
              <td>The four basic operations - addition, subtraction, multiplication, division:<br>
                <span class="htu-ex"><span class="htu-k">4</span><span class="htu-k htu-k-op">+</span><span class="htu-k">6</span><span class="htu-k htu-k-eq">=</span><b>10</b></span>
                <div class="htu-cm">Code Mode: <code>4+6</code></div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-eq">=</span></td>
              <td>Solves the expression currently on screen.</td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-op">(</span><span class="htu-k htu-k-op">)</span></td>
              <td>Groups part of an expression so it's solved first:<br>
                <span class="htu-ex"><span class="htu-k htu-k-op">(</span><span class="htu-k">3</span><span class="htu-k htu-k-op">+</span><span class="htu-k">2</span><span class="htu-k htu-k-op">)</span><span class="htu-k htu-k-op">×</span><span class="htu-k">4</span><span class="htu-k htu-k-eq">=</span><b>20</b></span>
                <div class="htu-cm">Code Mode: <code>(3+2)*4</code></div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k">.</span></td>
              <td>Decimal point, for numbers that aren't whole:<br>
                <span class="htu-ex"><span class="htu-k">1</span><span class="htu-k">.</span><span class="htu-k">5</span><span class="htu-k htu-k-op">+</span><span class="htu-k">2</span><span class="htu-k">.</span><span class="htu-k">2</span><span class="htu-k">5</span><span class="htu-k htu-k-eq">=</span><b>3.75</b></span>
                <div class="htu-cm">More: <a href="/tools/fraction-calculator">Fraction Calculator</a></div>
              </td>
            </tr>
            <tr>
              <td><span class="htu-k htu-k-op">%</span></td>
              <td>Percentage - divides by 100 in place:<br>
                <span class="htu-ex"><span class="htu-k">2</span><span class="htu-k">0</span><span class="htu-k">0</span><span class="htu-k htu-k-op">×</span><span class="htu-k">1</span><span class="htu-k">5</span><span class="htu-k htu-k-op">%</span><span class="htu-k htu-k-eq">=</span><b>30</b></span>
                <div class="htu-cm">Code Mode: <code>200*15%</code> &middot; More: <a href="/tools/percentage-calculator">Percentage Calculator</a></div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ══ SCRATCH NOTES ══ -->
    <section class="notes-wrap" id="notes">
      <div class="notes-head">
        <h2 class="notes-title"><i class="fa-solid fa-pencil"></i> Scratch Notes</h2>
      </div>

      <div class="notes-toolbar" role="toolbar" aria-label="Note actions">
        <button type="button" class="nbtn" id="nb-undo" title="Undo (Ctrl+Z)" aria-label="Undo"><i class="fa-solid fa-rotate-left"></i><span>Undo</span></button>
        <button type="button" class="nbtn" id="nb-redo" title="Redo (Ctrl+Y)" aria-label="Redo"><i class="fa-solid fa-rotate-right"></i><span>Redo</span></button>
        <button type="button" class="nbtn" id="nb-ans" title="Insert the calculator's current answer" aria-label="Insert answer"><i class="fa-solid fa-equals"></i><span>Insert Answer</span></button>
        <button type="button" class="nbtn" id="nb-copy" title="Copy all text" aria-label="Copy"><i class="fa-regular fa-copy"></i><span>Copy</span></button>
        <button type="button" class="nbtn" id="nb-txt" title="Download as .txt" aria-label="Download"><i class="fa-solid fa-download"></i><span>Download</span></button>
        <button type="button" class="nbtn" id="nb-print" title="Print or save as PDF" aria-label="Print"><i class="fa-solid fa-print"></i><span>Print</span></button>
        <button type="button" class="nbtn nbtn-danger" id="nb-clear" title="Clear the note" aria-label="Clear"><i class="fa-regular fa-trash-can"></i><span>Clear</span></button>
      </div>

      <div class="paper">
        <div class="paper-margin" aria-hidden="true"></div>
        <textarea id="notes-area" class="paper-area" spellcheck="true"
                  placeholder="Jot down your working, formulas, or homework steps here…"
                  aria-label="Scratch notes"></textarea>
      </div>
    </section>

  </div><!-- /calc-section-wrap -->

    <!-- ── RIGHT: Content ── -->
    <div class="content-col">
      <article class="home-article">
        <div class="about-topics-block">

          <!-- ══ MID BANNER ══ Sits at the top of the white About band, above
               the heading, so it reads as part of this section rather than
               floating in the tinted zone above it. Mounted by
               scMountGamBanners() in main.js. -->
          <div class="sc-ad sc-ad-mid-full" id="sc-gam-mid"></div>

          <div class="about-topics-block-inner">
            <h2 class="home-article-title">About SolveCalc</h2>
            <p class="intro">SolveCalc is a free browser-based scientific calculator built for everyday math. It handles basic arithmetic all the way up to algebra, trig, and logarithms. No download, no account. Just open the page and start calculating. If you want the long version of what a CalcSolver is and who it is for, read <a href="/guides/what-is-calcsolver">What Is CalcSolver</a>.</p>

            <div class="share-row" aria-label="Share SolveCalc">
              <span class="share-row-label">Share:</span>
              <a href="https://api.whatsapp.com/send?text=SolveCalc%20-%20a%20free%20online%20scientific%20calculator%3A%20https%3A%2F%2Fsolvecalc.net%2F" target="_blank" rel="noopener noreferrer" aria-label="Share SolveCalc on WhatsApp" class="share-row-btn"><i class="fa-brands fa-whatsapp"></i></a>
              <a href="https://twitter.com/intent/tweet?text=SolveCalc%20-%20a%20free%20online%20scientific%20calculator&amp;url=https%3A%2F%2Fsolvecalc.net%2F" target="_blank" rel="noopener noreferrer" aria-label="Share SolveCalc on X (Twitter)" class="share-row-btn"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fsolvecalc.net%2F" target="_blank" rel="noopener noreferrer" aria-label="Share SolveCalc on Facebook" class="share-row-btn"><i class="fa-brands fa-facebook-f"></i></a>
              <a href="mailto:?subject=SolveCalc%20-%20Free%20Online%20Calculator&amp;body=Check%20out%20SolveCalc%2C%20a%20free%20online%20scientific%20calculator%3A%20https%3A%2F%2Fsolvecalc.net%2F" aria-label="Share SolveCalc by email" class="share-row-btn"><i class="fa-solid fa-envelope"></i></a>
            </div>

            <div class="quick-answer">
              <strong>Quick answer:</strong> SolveCalc (searched as "solve calc" just as often as "solvecalc") is a free online calcsolver that solves arithmetic, <a href="/algebra">algebra</a>, trigonometry, logarithms, <a href="/fractions">fractions</a> and <a href="/guides/how-to-calculate-percentage">percentages</a> directly in your browser. It requires no download, no sign-up and no payment, works on phones, tablets, laptops and school Chromebooks, and includes 20+ dedicated math tools alongside the main scientific calculator. Additionally, enjoy your break with Code Mode - enter <code>0000</code> and unlock 1000+ math activities built right into the calculator.
            </div>

