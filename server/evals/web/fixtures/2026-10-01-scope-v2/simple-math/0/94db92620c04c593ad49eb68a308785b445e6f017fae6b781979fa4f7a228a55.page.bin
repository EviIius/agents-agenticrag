    <script>
(function () {
    var params = new URLSearchParams(window.location.search);
    var mill = params.get('mill');
    if (!mill) return;
    var encoded = encodeURIComponent(mill);

    function isSameOrigin(url) {
        // Empty, hash-only, javascript:, mailto:, tel: → skip
        if (!url) return false;
        var lower = url.toLowerCase();
        if (lower.charAt(0) === '#') return false;
        if (lower.indexOf('javascript:') === 0) return false;
        if (lower.indexOf('mailto:') === 0) return false;
        if (lower.indexOf('tel:') === 0) return false;

        // Relative paths ("/foo", "foo") are same-origin.
        if (lower.charAt(0) === '/' && lower.charAt(1) !== '/') return true;
        if (!/^(https?:)?\/\//i.test(lower)) return true;

        // Absolute URL: compare hostnames.
        try {
            var u = new URL(url, window.location.origin);
            return u.hostname === window.location.hostname;
        } catch (e) {
            return false;
        }
    }

    function applyMill(anchor) {
        if (!anchor || anchor.tagName !== 'A') return;
        // Respect explicit opt-outs so callers can skip a specific link.
        if (anchor.hasAttribute('data-no-mill')) return;
        var raw = anchor.getAttribute('href');
        if (!isSameOrigin(raw)) return;
        // Already has a mill? Leave the caller's choice alone.
        if (/([?&])mill=/.test(raw)) return;
        var separator = raw.indexOf('?') >= 0 ? '&' : '?';
        anchor.setAttribute('href', raw + separator + 'mill=' + encoded);
    }

    function applyAll(root) {
        var anchors = (root || document).querySelectorAll('a[href]');
        for (var i = 0; i < anchors.length; i++) applyMill(anchors[i]);
    }

    // Initial pass on whatever the server sent down.
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { applyAll(document); });
    } else {
        applyAll(document);
    }

    // Second pass whenever the DOM changes. React re-renders, third-party
    // scripts inserting cards, ad-inserted content, etc. all funnel through
    // this observer so a mill-tagged session never leaks into a link that
    // was added after the initial pass.
    if (typeof MutationObserver !== 'undefined') {
        var observer = new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
                var m = mutations[i];
                if (m.type === 'attributes' && m.target && m.target.tagName === 'A') {
                    applyMill(m.target);
                    continue;
                }
                for (var j = 0; j < m.addedNodes.length; j++) {
                    var node = m.addedNodes[j];
                    if (!node || node.nodeType !== 1) continue;
                    if (node.tagName === 'A') applyMill(node);
                    if (node.querySelectorAll) applyAll(node);
                }
            }
        });
        var start = function () {
            observer.observe(document.body, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['href']
            });
        };
        if (document.body) start();
        else document.addEventListener('DOMContentLoaded', start);
    }
})();
</script>

    
    
        
            
