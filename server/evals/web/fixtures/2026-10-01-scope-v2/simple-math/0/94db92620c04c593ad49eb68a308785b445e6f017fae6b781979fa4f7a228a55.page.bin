    function setupModal() {
        const outerModal = document.getElementById('modal_530');
        const innerModal = document.getElementById('inner_modal_530');

        
                    // close the modal if they click outside
            outerModal.addEventListener('click', function(event) {
                var isClickInside = innerModal.contains(event.target);
                if (!isClickInside) {
                    outerModal.classList.add('hidden')
                }
            })
                const triggerMaxCount = 1
        let triggerCount = 0
        
        const openModal_530 = function () {
            const outerModal = document.getElementById('modal_530');
            outerModal.classList.remove('hidden');
        }

        const closeModal_530 = function () {
            const outerModal = document.getElementById('modal_530');
            outerModal.classList.add('hidden')
        }

        window.openModal_530 = openModal_530
        window.closeModal_530 = closeModal_530
    }

</script>
