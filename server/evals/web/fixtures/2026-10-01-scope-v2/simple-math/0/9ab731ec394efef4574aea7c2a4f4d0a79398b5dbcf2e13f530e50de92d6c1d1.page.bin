<script>
function calculate() {
// COPYRIGHT multiply.info
form = document.myform;
factor1 = form.factor1.value*1;
factor2 = form.factor2.value*1;
if (factor1 == 0){form.factor1.value = '';return false;}
if (factor2 == 0){form.factor2.value = '';return false;}
factor3 = factor1; if (factor1 <= factor2){factor1 = factor2*1; factor2 = factor3*1;}
form.factor1.value = factor1;form.factor2.value = factor2;
factor1 = factor1.toString();
factor2 = factor2.toString();
count1 = factor1.length;
count2 = factor2.length;
if (count1 <= 2 && count2 <= 2){location.href = 'https://multiply.info/LongMultiplication/How-to-calculate-' + factor1 + '-multiplied-by-' + factor2 + '-using-long-multiplication.html';return false;}
if (count1 == 3){location.href = 'https://multiply.info/long/'+factor2+'/how-to-calculate-' + factor1 + '-times-' + factor2 + '-using-long-multiplication.html';return false;}
}
function startOver() {
form.factor1.value = '';
form.factor2.value = '';}
function isNumberKey(evt) {
var charCode = (evt.which) ? evt.which : event.keyCode
if (charCode > 31 && (charCode < 48 || charCode > 57))
return false;
return true;}
</script>
<form name='myform' onsubmit="return false;">
