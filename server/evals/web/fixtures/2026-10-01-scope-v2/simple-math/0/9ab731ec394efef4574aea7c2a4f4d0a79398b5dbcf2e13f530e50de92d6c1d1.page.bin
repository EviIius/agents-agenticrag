× <input inputmode="decimal" id="factor2" maxlength="2" onkeypress="return isNumberKey(event);" style="width:90px; height:30px; text-align:center; font-size:16pt; -webkit-padding-start: 1px; outline:none;color: #373737;"> <br><br>
<input type="button" onClick='startOver()' style="padding: 0px 20px;background: #9F000F; color:#FFFFFF; height:40px; font-weight: bold; font-size:18pt; text-align:center; outline:none" value="C"/>
<input type="button" onClick='calculate()' style="padding: 0px 20px;background: green; color:#FFFFFF; height:40px; font-weight: bold; font-size:18pt; text-align:center; outline:none" value="Multiply"/>
