<li id="mwASM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Naniwa,_Settsu?action=edit&amp;redlink=1" title="Naniwa, Settsu (page does not exist)" class="new" typeof="mw:LocalizedAttrs" id="mwASQ" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Naniwa, Settsu"]}}'>Naniwa, Settsu</a> (Palace of <i id="mwASU">Takatsu</i>), reign of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Emperor_Nintoku" title="Emperor Nintoku" id="mwASY">Emperor Nintoku</a><sup about="#mwt85" class="mw-ref reference" id="cite_ref-32" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-32"}}'><a href="#cite_note-32" id="mwASc"><span class="mw-reflink-text" id="mwASg"><span class="cite-bracket" id="mwASk">[</span>32<span class="cite-bracket" id="mwASo">]</span></span></a></sup></li>
<li id="mwASs"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Iware,_Yamato?action=edit&amp;redlink=1" title="Iware, Yamato (page does not exist)" class="new" typeof="mw:LocalizedAttrs" id="mwASw" data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Iware, Yamato"]}}'>Iware, Yamato</a> (Palace of <i id="mwAS0">Wakasakura</i>), reign of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Emperor_Richū" title="Emperor Richū" id="mwAS4">Emperor Richū</a><sup about="#mwt86" class="mw-ref reference" id="cite_ref-33" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-33"}}'><a href="#cite_note-33" id="mwAS8"><span class="mw-reflink-text" id="mwATA"><span class="cite-bracket" id="mwATE">[</span>33<span class="cite-bracket" id="mwATI">]</span></span></a></sup></li>
