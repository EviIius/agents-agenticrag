nces" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ponsonby29"}}'><a href="#cite_note-ponsonby29-64" id="mwAuQ"><span class="mw-reflink-text" id="mwAuU"><span class="cite-bracket" id="mwAuY">[</span>64<span class="cite-bracket" id="mwAuc">]</span></span></a></sup></li>
<li id="mwAug"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kuni-kyō" title="Kuni-kyō" id="mwAuk">Kuni-kyō</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kuni_Palace" title="Kuni Palace" class="mw-redirect" id="mwAuo">Kuni Palace</a>), 740–744<sup about="#mwt159" class="mw-ref reference" id="cite_ref-65" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-65"}}'><a href="#cite_note-65" id="mwAus"><span class="mw-reflink-text" id="mwAuw"><span class="cite-bracket" id="mwAu0">[</span>65<span class="cite-bracket" id="mwAu4">]</span></span></a></sup> in the reign of Shomu<sup about="#mwt160" class="mw-ref reference" id="cite_ref-66" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-66"}}'><a href="#cite_note-66" id="mwAu8"><span class="mw-reflink-text" id="mwAvA"><span class="cite-bracket" id="mwAvE">[</span>66<span class="cite-bracket" id="mwAvI">]</span></span></a></sup></li>
<li id="mwAvM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Naniwa-kyō" title="Naniwa-kyō" id="mwAvQ">Naniwa-kyō</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Naniwa_Palace?action=edit&amp;redlink=1" title="Naniwa Palace (page does not exist)" about="#mwt161" typeof="mw:Transclusion mw:LocalizedAttrs" class="new" id="mwAvU" data-mw='{"parts":[{"template":{"target":{"wt":"ill","href":"./Template:Ill"},"params":{"1":{"wt":"Naniwa Palace"},"2":{"wt":"ja"},"3":{"wt":"難波宮"}},"i":0}}]}' data-mw-i18n='{"title":{"lang":"x-page","key":"red-link-title","params":["Naniwa Palace"]}}'>Naniwa Palace</a><span class="noprint" style="font-size:85%; font-style: normal; " about="#mwt161" id="mwAvY"><span typeof="mw:Entity"> </span><span typeof="mw:Entity">[</span><a rel="mw:WikiLink/Interwiki" href="https://ja.wikipedia.org/wiki/難波宮" title="ja:難波宮" class="extiw">ja</a><span typeof="mw:Entity">]</span></span>), 744<sup about="#mwt162" class="mw-ref reference" id="cite_ref-naniwa2_67-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"naniwa2"},"body":{"id":"mw-reference-text-cite_note-naniwa2-67"}}'><a href="#cite_note-naniwa2-67" id="mwAvc"><span class="mw-reflink-text" id="mwAvg"><span class="cite-bracket" id="mwAvk">[</span>67<span class="cite-bracket" id="mwAvo">]</span></span></a></sup></li>
<li id="mwAvs">Naniwa-kyō, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Shigaraki_Palace" title="Shigaraki Palace" id="mwAvw">Shigaraki Palace</a>, 744–745<sup about="#mwt163" class="mw-ref reference" id="cite_ref-naniwa2_67-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"naniwa2"}}'><a href="#cite_note-naniwa2-67" id="mwAv0"><span class="mw-reflink-text" id="mwAv4"><span class="cite-bracket" id="mwAv8">[</span>67<span class="cite-bracket" id="mwAwA">]</span></span></a></sup></li>
<li id="mwAwE">Heijō-kyō (Heijō Palace), 745–784<sup about="#mwt164" class="mw-ref reference" id="cite_ref-heijo-kyo_62-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"heijo-kyo"}}'><a href="#cite_note-heijo-kyo-62" id="mwAwI"><span class="mw-reflink-text" id="mwAwM"><span class="cite-bracket" id="mwAwQ">[</span>62<span class="cite-bracket" id="mwAwU">]</span></span></a></sup></li>
<li id="mwAwY">Nagaoka-kyō (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nagaoka_Palace" title="Nagaoka Palace" class="mw-redirect" id="mwAwc">Nagaoka Palace</a>), 784–794<sup about="#mwt165" class="mw-ref reference" id="cite_ref-68" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-68"}}'><a href="#cite_note-68" id="mwAwg"><span class="mw-reflink-text" id="mwAwk"><span class="cite-bracket" id="mwAwo">[</span>68<span class="cite-bracket" id="mwAws">]</span></span></a></sup> in the reign of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Emperor_Kanmu" title="Emperor Kanmu" id="mwAww">Emperor Kanmu</a><sup about="#mwt166" class="mw-ref reference" id="cite_ref-ponsonby34_69-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ponsonby34"},"body":{"id":"mw-reference-text-cite_note-ponsonby34-69"}}'><a href="#cite_note-ponsonby34-69" id="mwAw0"><span class="mw-reflink-text" id="mwAw4"><span class="cite-bracket" id="mwAw8">[</span>69<span class="cite-bracket" id="mwAxA">]</span></span></a></sup><sup about="#mwt169" class="mw-ref reference" id="cite_ref-70" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-70"}}'><a href="#cite_note-70" id="mwAxE"><span class="mw-reflink-text" id="mwAxI"><span class="cite-bracket" id="mwAxM">[</span>70<span class="cite-bracket" id="mwAxQ">]</span></span></a></sup></li></ul>

<p id="mwAxU"><b id="mwAxY"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Heian_period" title="Heian period" id="mwAxc">Heian period</a></b></p>
<figure typeof="mw:File/Thumb" id="mwAxg"><a href="https://en.wikipedia.org/wiki/File:Heiankyo_overall_model.jpg" class="mw-file-description" id="mwAxk"><img resource="https://en.wikipedia.org/wiki/File:Heiankyo_overall_model.jpg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Heiankyo_overall_model.jpg/500px-Heiankyo_overall_model.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Heiankyo_overall_model.jpg/960px-Heiankyo_overall_model.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="7360" data-file-height="3105" data-file-type="bitmap" height="148" width="350" class="mw-file-element" id="mwAxo"/></a><figcaption id="mwAxs">1/1000 scale model of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Heian-kyō" title="Heian-kyō" id="mwAxw">Heian-kyō</a>, held by Kyoto City Heiankyo Sosei-Kan Museum</figcaption></figure>
<ul id="mwAx0"><li id="mwAx4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Heian-kyō" title="Heian-kyō" id="mwAx8">Heian-kyō</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Heian_Palace" title="Heian Palace" id="mwAyA">Heian Palace</a>), 794–1180<sup about="#mwt170" class="mw-ref reference" id="cite_ref-heian-kyo_71-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"heian-kyo"},"body":{"id":"mw-reference-text-cite_note-heian-kyo-71"}}'><a href="#cite_note-heian-kyo-71" id="mwAyE"><span class="mw-reflink-text" id="mwAyI"><span class="cite-bracket" id="mwAyM">[</span>71<span class="cite-bracket" id="mwAyQ">]</span></span></a></sup> in the reign of Kammu<sup about="#mwt171" class="mw-ref reference" id="cite_ref-ponsonby34_69-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ponsonby34"}}'><a href="#cite_note-ponsonby34-69" id="mwAyU"><span class="mw-reflink-text" id="mwAyY"><span class="cite-bracket" id="mwAyc">[</span>69<span class="cite-bracket" id="mwAyg">]</span></span></a></sup> and others</li>
<li id="mwAyk"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Fukuhara-kyō" title="Fukuhara-kyō" id="mwAyo">Fukuhara Palace</a>, 1180<sup about="#mwt172" class="mw-ref reference" id="cite_ref-72" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-72"}}'><a href="#cite_note-72" id="mwAys"><span class="mw-reflink-text" id="mwAyw"><span class="cite-bracket" id="mwAy0">[</span>72<span class="cite-bracket" id="mwAy4">]</span></span></a></sup> in the reign of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Emperor_Antoku" title="Emperor Antoku" id="mwAy8">Emperor Antoku</a><sup about="#mwt173" class="mw-ref reference" id="cite_ref-73" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-73"}}'><a href="#cite_note-73" id="mwAzA"><span class="mw-reflink-text" id="mwAzE"><span class="cite-bracket" id="mwAzI">[</span>73<span class="cite-bracket" id="mwAzM">]</span></span></a></sup></li></ul>

<p id="mwAzQ"><b id="mwAzU">Medieval Japan and Early modern period</b> (see also: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/History_of_Japan" title="History of Japan" id="mwAzY">History of Japan</a>)</p>
<ul id="mwAzc"><li id="mwAzg">Heian-kyō or <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kyoto" title="Kyoto" id="mwAzk">Kyōto</a> (Heian Palace), 1180–1868<sup about="#mwt174" class="mw-ref reference" id="cite_ref-heian-kyo_71-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"heian-kyo"}}'><a href="#cite_note-heian-kyo-71" id="mwAzo"><span class="mw-reflink-text" id="mwAzs"><span class="cite-bracket" id="mwAzw">[</span>71<span class="cite-bracket" id="mwAz0">]</span></span></a></sup></li>
<li id="mwAz4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Yoshino,_Nara" title="Yoshino, Nara" id="mwAz8">Yoshino</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Nanboku-chō_period" title="Nanboku-chō period" id="mwA0A">Nanboku-chō period</a>), 1336–1392</li></ul>

<p id="mwA0E"><b id="mwA0I">Modern Japan</b> (see also: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/History_of_Japan" title="History of Japan" id="mwA0M">History of Japan</a>)</p>
<ul id="mwA0Q"><li id="mwA0U"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tokyo" title="Tokyo" id="mwA0Y">Tōkyō</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tokyo_Imperial_Palace" title="Tokyo Imperial Palace" id="mwA0c"><i id="mwA0g">Kōkyo</i></a>), 1868–present<sup about="#mwt175" class="mw-ref reference" id="cite_ref-tokyo_12-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"tokyo"}}'><a href="#cite_note-tokyo-12" id="mwA0k"><span class="mw-reflink-text" id="mwA0o"><span class="cite-bracket" id="mwA0s">[</span>12<span class="cite-bracket" id="mwA0w">]</span></span></a></sup><sup about="#mwt178" class="mw-ref reference" id="cite_ref-74" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-74"}}'><a href="#cite_note-74" id="mwA00"><span class="mw-reflink-text" id="mwA04"><span class="cite-bracket" id="mwA08">[</span>74<span class="cite-bracket" id="mwA1A">]</span></span></a></sup></li></ul>

</section></section><section data-mw-section-id="6" id="mwA1E" aria-labelledby="Historical_capitals"><div class="mw-heading mw-heading2"><h2 id="Historical_capitals">Historical capitals</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Capital_of_Japan&amp;action=edit&amp;section=6" title="Edit section: Historical capitals"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<ul id="mwA1I"><li id="mwA1M"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hiraizumi,_Iwate" title="Hiraizumi, Iwate" class="mw-redirect" id="mwA1Q">Hiraizumi</a> was the capital of totally independent Northern Fujiwara polity (Ōshū) based in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tōhoku_region" title="Tōhoku region" id="mwA1U">Tōhoku region</a>, having defeated <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Emishi" title="Emishi" id="mwA1Y">Emishi</a> tribes.  This polity existed as Kyoto's internal politics prevented  Kyoto's authority from 1100 to 1189.</li>
<li id="mwA1c"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hakodate" title="Hakodate" id="mwA1g">Hakodate</a> was the capital of the short lived <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Republic_of_Ezo" title="Republic of Ezo" id="mwA1k">Republic of Ezo</a> (1869).</li>
<li id="mwA1o"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Shuri,_Okinawa" title="Shuri, Okinawa" id="mwA1s">Shuri</a> was the capital of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ryukyu_Kingdom" title="Ryukyu Kingdom" id="mwA1w">Ryukyu Kingdom</a> (1429–1879) and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Urasoe,_Okinawa" title="Urasoe, Okinawa" id="mwA10">Urasoe</a> was capital of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Sanzan_period" title="Sanzan period" id="mwA14">Chuzan</a> from at least 1350, which predated the Ryukyu Kingdom.</li></ul>

</section><section data-mw-section-id="7" id="mwA18" aria-labelledby="See_also"><div class="mw-heading mw-heading2"><h2 id="See_also">See also</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Capital_of_Japan&amp;action=edit&amp;section=7" title="Edit section: See also"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<ul id="mwA2A"><li id="mwA2E"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/List_of_capitals_and_largest_cities_by_country" title="List of capitals and largest cities by country" class="mw-redirect" id="mwA2I">List of capitals and largest cities by country</a></li></ul>

</section><section data-mw-section-id="8" id="mwA2M" aria-labelledby="References"><div class="mw-heading mw-heading2"><h2 id="References">References</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Capital_of_Japan&amp;action=edit&amp;section=8" title="Edit section: References"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
