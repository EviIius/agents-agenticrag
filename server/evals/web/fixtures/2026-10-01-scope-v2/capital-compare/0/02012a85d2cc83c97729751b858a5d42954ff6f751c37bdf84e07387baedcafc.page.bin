<li id="mwAWM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Asuka,_Yamato" title="Asuka, Yamato" id="mwAWQ">Asuka, Yamato</a> (<i id="mwAWU">Chikatsu-Asuka-Yatsuri</i> Palace), 485–487<sup about="#mwt94" class="mw-ref reference" id="cite_ref-40" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-40"}}'><a href="#cite_note-40" id="mwAWY"><span class="mw-reflink-text" id="mwAWc"><span class="cite-bracket" id="mwAWg">[</span>40<span class="cite-bracket" id="mwAWk">]</span></span></a></sup> in reign of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Emperor_Kenzō" title="Emperor Kenzō" id="mwAWo">Emperor Kenzō</a><sup about="#mwt95" class="mw-ref reference" id="cite_ref-ponsonby14_39-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ponsonby14"}}'><a href="#cite_note-ponsonby14-39" id="mwAWs"><span class="mw-reflink-text" id="mwAWw"><span class="cite-bracket" id="mwAW0">[</span>39<span class="cite-bracket" id="mwAW4">]</span></span></a></sup></li>
