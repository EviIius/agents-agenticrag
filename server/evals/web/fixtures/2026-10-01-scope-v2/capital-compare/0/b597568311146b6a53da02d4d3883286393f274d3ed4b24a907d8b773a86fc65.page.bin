<div class="quick-facts">
  <div class="fact-card"><span class="fact-icon">🏛️</span><span class="fact-label">Capital</span><span class="fact-value"><a href="/capital-of-japan/">Tokyo</a></span></div>
  <div class="fact-card"><span class="fact-icon">💰</span><span class="fact-label">Currency</span><span class="fact-value"><a href="/currency-in-japan/">Japanese yen (¥)</a></span></div>
  <div class="fact-card"><span class="fact-icon">🗣️</span><span class="fact-label">Language</span><span class="fact-value"><a href="/language-of-japan/">Japanese</a></span></div>
  <div class="fact-card"><span class="fact-icon">📞</span><span class="fact-label">Dialling Code</span><span class="fact-value"><a href="/dialling-code-for-japan/">+81</a></span></div>
  <div class="fact-card"><span class="fact-icon">🌍</span><span class="fact-label">Region</span><span class="fact-value">Eastern Asia</span></div>
  <div class="fact-card"><span class="fact-icon">👥</span><span class="fact-label">Population</span><span class="fact-value"><a href="/population-of-japan/">123,210,000</a></span></div>
