ition:absolute;left:12px;top:18px;width:20px;height:20px;background-color:#2196f3;color:#fff;font-family:"Times New Roman",Times,serif;font-style:italic;font-weight:bold;font-size:15px;display:flex;align-items:center;justify-content:center;border-radius:50%}.header{background:#2d2d2d;color:white;padding:8px 10px;display:flex;justify-content:space-between;align-items:center}.layout{display:flex;flex-wrap:wrap;padding:5px;gap:10px;width:100%;max-width:1200px;margin:0 auto}.main-content{flex:2;padding:20px;border-radius:8px;box-shadow:0 2px 5px rgba(0,0,0,0.1);width:100%}.q-header{display:flex;align-items:center;margin-top:-10px;margin-bottom:15px;gap:5px}.q-num-badge{background:#2e7cf0;color:#ffffff;padding:3px;border-radius:50%;font-weight:bold;min-width:35px;height:35px;display:flex;align-items:center;justify-content:center}.q-header-separator{font-size:20px;font-weight:bold;margin:0 10px}.mark-badge{padding:5px 10px;border-radius:4px;font-size:13px;font-weight:bold}.pos-badge-style{background:#e8f5e9;color:green}.neg-badge-style{background:#ffebee;color:red}.star-icon{margin-left:auto;font-size:28px;cursor:pointer;color:#ccc}.star-active{color:#8b5cf6}.q-title-style{font-size:19px;font-weight:bold;line-height:1.4;margin-bottom:15px}.raw-question .question-text{font-size:1.17em;font-weight:bold;margin-top:10px;margin-bottom:10px}.option-item{font-size:17px;border:1px solid #ddd;padding:10px;margin:5px 0;border-radius:8px;cursor:pointer}.option-item.selected{border-color:#4a90e2;background-color:#eef6ff}#raw-mock-questions{margin-top:40px;padding:20px;border-radius:8px;border:1px solid #eef0f2}#raw-mock-questions .raw-question{border-bottom:1px dashed #ddd;padding-bottom:15px;margin-bottom:15px}.mock-footer{position:relative;padding:10px;display:flex;flex-direction:column;justify-content:center;align-items:center;border-top:1px solid #ddd;width:100%}.footer-row-top{display:flex;gap:12px;justify-content:center;width:100%}.btn-mark-review-clear{background:#f8fafc;color