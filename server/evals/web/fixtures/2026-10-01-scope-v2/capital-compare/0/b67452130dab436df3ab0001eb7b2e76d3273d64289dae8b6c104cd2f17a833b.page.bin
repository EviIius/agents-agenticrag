  <tr><th>Continent</th><td>Oceania</td></tr>
  <tr><th>Region</th><td>Australia and New Zealand</td></tr>
  <tr><th>Population</th><td><a href="/population-of-australia/">27,536,874</a></td></tr>
  <tr><th>Area</th><td>7,692,024 km²</td></tr>
  <tr><th>Currency</th><td><a href="/currency-in-australia/">Australian dollar (AUD) $</a></td></tr>
  <tr><th>Official Language</th><td><a href="/language-of-australia/">English</a></td></tr>
  <tr><th>Dialling Code</th><td><a href="/dialling-code-for-australia/">+61</a></td></tr>
  <tr><th>Internet TLD</th><td>.au</td></tr>
  <tr><th>Timezones</th><td><a href="/timezone-in-australia/">UTC+05:00, UTC+06:30, UTC+07:00, UTC+08:00, UTC+09:30, UTC+10:00, UTC+10:30, UTC+11:30</a></td></tr>
  <tr><th>Drives on the</th><td>Left side</td></tr>
  <tr><th>Emergency Number</th><td>000 (or 112 from mobiles)</td></tr>
  <tr><th>ISO Code</th><td>AU / AUS</td></tr>
  <tr><th>Borders</th><td>Island nation / no land borders</td></tr>
</table>
