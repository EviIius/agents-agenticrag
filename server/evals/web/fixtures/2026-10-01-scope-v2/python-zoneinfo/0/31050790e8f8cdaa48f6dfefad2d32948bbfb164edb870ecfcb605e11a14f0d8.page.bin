                <div class='breadcrumbs'><a href='/'>Home</a> &raquo; <a href='/programming'>Programming</a> &raquo; <a href='/programming/python'>Python</a> &raquo; <a href='/programming/python/modules'>Modules</a> &raquo; <span class='current-crumb'>Zoneinfo Module</span></div>
                    <div class="action-bar">
                <a href="/programming/python/modules/zoneinfo-module?action=pin" class="action-btn">📌 Pin</a>
                <a href="#" onclick="copyLink(event)" class="action-btn">🔗 Copy Link</a>
                <a href="#" data-page="programming/python/modules/zoneinfo-module" onclick="copyMarkdown(event)" class="action-btn">📋 Copy Markdown</a>
