        transition: background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base);
    }

    .video-reference__player {
        position: relative;
        aspect-ratio: 16 / 9;
        background: #080b1a;
    }

    .video-reference__player iframe {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .video-reference__body {
        padding: 1.5rem;
    }

    .post-content .video-reference__eyebrow {
        margin: 0 0 0.35rem;
        color: var(--color-comet-cyan);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .post-content .video-reference h3 {
        margin: 0 0 0.75rem;
        color: var(--color-star-white);
        font-size: 1.35rem;
    }

    .post-content .video-reference__body > p:not(.video-reference__eyebrow) {
        margin-bottom: 0.8rem;
    }

    .post-content .video-reference__credit {
        color: var(--color-moon-gray);
        font-size: 0.92rem;
    }

    .post-content .video-reference__credit:last-child {
        margin-bottom: 0;
    }
</style>

