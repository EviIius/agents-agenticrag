            <!-- Prism.js - Syntax Highlighting -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" defer></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-python.min.js" defer></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-bash.min.js" defer></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js" defer></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/line-numbers/prism-line-numbers.min.js" defer></script>

        <script>
        // Auto-detectar linguagem Python em blocos <code> sem classe
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('pre code:not([class])').forEach(function(block) {
                block.classList.add('language-python');
                block.parentElement.classList.add('language-python');
            });

            // Re-highlight após adicionar classes
            if (typeof Prism !== 'undefined') {
                Prism.highlightAll();
            }
        });
        </script>
