<script id="mbfse-responsive-tables-js-after">
(function () {
  function ready(fn) { document.readyState === "loading" ? document.addEventListener("DOMContentLoaded", fn) : fn(); }

  ready(function () {
    var content = document.querySelector(".entry-content");
    if (!content) return;

    content.querySelectorAll("table").forEach(function (table) {
      if (table.querySelector("table")) return;

      /* A table written without the block figure gets a box that can scroll. */
      if (!table.closest("figure.wp-block-table, .mbfse-tscroll")) {
        var box = document.createElement("div");
        box.className = "mbfse-tscroll";
        table.parentNode.insertBefore(box, table);
        box.appendChild(table);
      }

      /* These tables have no <thead>, so the first row is marked when it reads like a header. */
        /* Six columns or more: let it size to content and scroll, rather than
           squeezing every column until the words break apart. */
        if (table.rows[0] && table.rows[0].cells.length >= 6) { table.classList.add("mbfse-tbl--wide"); }

      if (table.tHead) { table.classList.add("mbfse-tbl--head"); return; }
      if (table.rows.length < 2) return;
      var head = table.rows[0];
      var cells = [].map.call(head.cells, function (c) { return c.textContent.replace(/\s+/g, " ").trim(); });
      if (cells.length < 2) return;
      var short = cells.every(function (t) { return t.length <= 32; });
      var wordy = cells.filter(function (t) { return t !== "" && !/^[\d.,%\s]+$/.test(t); }).length >= 2;
      if (short && wordy) {
        head.classList.add("mbfse-thead");
        table.classList.add("mbfse-tbl--head");
      }
    });
  });
})();
//# sourceURL=mbfse-responsive-tables-js-after
</script>
<script id="mbfse-height-compare-js-after">
(function () {
  function start() {
    document.querySelectorAll(".mbfse-hc").forEach(function (root) {
      var data = JSON.parse(root.getAttribute("data-hc") || "{}");
      var ids = Object.keys(data);
      var opts = root.querySelectorAll(".mbfse-hc__opt");
      var img = root.querySelector(".mbfse-hc__other-img");
      var stage = root.querySelector(".mbfse-hc__stage");
      var everest = root.querySelector(".mbfse-hc__everest-img");
      var zoom = root.querySelector(".mbfse-hc__zoom");
      var zoomImg = root.querySelector(".mbfse-hc__zoom-img");
      var pct = parseFloat(stage.style.getPropertyValue("--pct")) || 100;

      // Scale and shift a photo so its summit lands on its height line and it still
      // covers the box below. Measured from where the box ends up, not mid-animation.
      function place(im, boxW, boxH, summitY) {
        var ar = im.naturalHeight / im.naturalWidth;
        if (!ar || !boxW || !boxH) { return; }
        var sx = parseFloat(im.getAttribute("data-sx")) || 0.5;
        var sy = parseFloat(im.getAttribute("data-sy")) || 0.1;
        var ih = Math.max((boxH - summitY) / (1 - sy), boxW * ar, summitY > 0 ? summitY / sy : 0);
        var iw = ih / ar;
        var left = Math.min(0, Math.max(boxW - iw, boxW / 2 - sx * iw));
        im.style.width = iw + "px";
        im.style.height = ih + "px";
        im.style.top = (summitY - sy * ih) + "px";
        im.style.left = left + "px";
        im.classList.add("is-placed");
      }
      function layout() {
        var h = stage.clientHeight, w = stage.clientWidth / 2;
        var head = h * 0.16;
        place(everest, w, h, head);
        place(img, w, (h - head) * pct / 100, 0);
      }
      [everest, img].forEach(function (im) {
        if (im.complete) { layout(); }
        im.addEventListener("load", layout);
      });
      if ("ResizeObserver" in window) { new ResizeObserver(layout).observe(stage); } else { window.addEventListener("resize", layout); }
      var current = (root.querySelector(".mbfse-hc__opt.is-on") || opts[0]).getAttribute("data-id");

      // Warm the other photos once the reader shows interest, so switching is instant.
      var warmed = false;
      function warm() {
        if (warmed) { return; }
        warmed = true;
        ids.forEach(function (id) { var i = new Image(); i.src = data[id].img; });
      }
      root.addEventListener("pointerenter", warm, { once: true });
      root.addEventListener("focusin", warm, { once: true });

      function show(id, focus) {
        var d = data[id];
        if (!d) { return; }
        current = id;
        opts.forEach(function (o) {
          var on = o.getAttribute("data-id") === id;
          o.classList.toggle("is-on", on);
          o.setAttribute("aria-pressed", on ? "true" : "false");
          if (on && focus) { o.focus(); }
          if (on && o.scrollIntoView && o.parentNode.scrollWidth > o.parentNode.clientWidth) {
            o.parentNode.scrollTo({ left: o.offsetLeft - o.parentNode.offsetLeft - 8, behavior: "smooth" });
          }
        });
        img.style.opacity = "0";
        var next = new Image();
        next.onload = next.onerror = function () {
          img.setAttribute("data-sx", d.sx);
          img.setAttribute("data-sy", d.sy);
          img.src = d.img;
          img.alt = d.name + ", " + d.where;
          layout();
          img.style.opacity = "1";
        };
        next.src = d.img;
        root.querySelectorAll(".mbfse-hc__other-name").forEach(function (el) { el.textContent = d.name; });
        root.querySelector(".mbfse-hc__other-m").textContent = d.m + " m";
        root.querySelector(".mbfse-hc__title-text").textContent = "Mount Everest vs " + d.name;
        root.querySelector(".mbfse-hc__pct").textContent = d.pct + "%";
        pct = d.pct;
        stage.style.setProperty("--pct", d.pct);
        zoom.hidden = d.pct >= 20;
        if (d.pct < 20) { zoomImg.src = d.img; }
        layout();
        stage.classList.toggle("is-tall", d.pct > 80);
        stage.classList.toggle("is-short", d.pct < 20);
        root.querySelectorAll("tbody tr").forEach(function (tr) {
          tr.classList.toggle("is-on", tr.getAttribute("data-row") === id);
        });
      }

      opts.forEach(function (o) {
        o.addEventListener("click", function () { show(o.getAttribute("data-id")); });
      });
      root.querySelectorAll(".mbfse-hc__step").forEach(function (b) {
        b.addEventListener("click", function () {
          var i = ids.indexOf(current) + parseInt(b.getAttribute("data-step"), 10);
          show(ids[(i + ids.length) % ids.length]);
        });
      });
      root.querySelector(".mbfse-hc__options").addEventListener("keydown", function (e) {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "ArrowDown" && e.key !== "ArrowUp") { return; }
        e.preventDefault();
        var step = (e.key === "ArrowRight" || e.key === "ArrowDown") ? 1 : -1;
        var i = ids.indexOf(current) + step;
        show(ids[(i + ids.length) % ids.length], true);
      });
    });
  }
  if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", start); } else { start(); }
})();
//# sourceURL=mbfse-height-compare-js-after
</script>
