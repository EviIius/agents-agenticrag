        '; max-age=' + 90 * 86400 + '; path=/; domain=.' + host + '; SameSite=Lax';
    }
  } catch (e) {}
  /* ---- Mirror dataLayer events to the Meta Pixel (when fbq is present).
     Purchase carries eventID = purchase-{bookingId} so Meta deduplicates
     against the booking system's server-side Conversions API. ---- */
  (function () {
    function mirror(ev) {
      if (!window.fbq || !ev || !ev.event) return;
      try {
        if (ev.event === 'cta_click') {
          fbq('track', 'Contact', { content_name: ev.cta_type + ': ' + (ev.cta_label || '') });
        } else if (ev.event === 'generate_lead') {
          fbq('track', 'Lead', { content_name: 'Ask a Question' });
        } else if (ev.event === 'begin_checkout' && ev.ecommerce) {
          fbq('track', 'InitiateCheckout', { currency: 'USD', value: ev.ecommerce.value || 0 });
        } else if (ev.event === 'add_payment_info' && ev.ecommerce) {
          fbq('track', 'AddPaymentInfo', { currency: 'USD', value: ev.ecommerce.value || 0 });
        } else if (ev.event === 'purchase' && ev.ecommerce) {
          fbq('track', 'Purchase',
            { currency: 'USD', value: ev.ecommerce.value || 0, content_name: (ev.ecommerce.items && ev.ecommerce.items[0] || {}).item_name },
            ev.event_id ? { eventID: ev.event_id } : undefined);
        }
      } catch (e) {}
    }
    var orig = window.dataLayer.push.bind(window.dataLayer);
    window.dataLayer.push = function () {
      for (var i = 0; i < arguments.length; i++) mirror(arguments[i]);
      return orig.apply(null, arguments);
    };
  })();
  /* ---- Booking attribution report ----
     When the purchase event fires (after the booking is complete), tell
     the booking system how this visitor arrived. Fire-and-forget: a
     failure here can never affect the booking or the confirmation page. ---- */
  (function () {
    var sent = {};
    function read(k) { try { return JSON.parse(localStorage.getItem(k) || 'null') || {}; } catch (e) { return {}; } }
    function report(id) {
      try {
        id = String(id || '').replace(/\D/g, '');
        if (!id || sent[id] || sessionStorage.getItem('mn_attr_sent_' + id)) return;
        sent[id] = 1;
        var host = location.hostname;
        var api = (/\.test$/.test(host) || host === 'localhost' || host === '127.0.0.1')
          ? 'https://booking.test/api/v1' : 'https://app.magicalnepal.com/api/v1';
        fetch(api + '/booking/' + id + '/attribution', {
          method: 'POST', keepalive: true, credentials: 'omit',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ first: read('mn_attr_first'), last: read('mn_attr_last') })
        }).then(function () { try { sessionStorage.setItem('mn_attr_sent_' + id, '1'); } catch (e) {} })
          .catch(function () {});
      } catch (e) {}
    }
    function check(ev) {
      if (ev && ev.event === 'purchase' && ev.ecommerce && ev.ecommerce.transaction_id) report(ev.ecommerce.transaction_id);
    }
    try { (window.dataLayer || []).forEach(check); } catch (e) {}
    var prev = window.dataLayer.push.bind(window.dataLayer);
    window.dataLayer.push = function () {
      for (var i = 0; i < arguments.length; i++) { try { check(arguments[i]); } catch (e) {} }
      return prev.apply(null, arguments);
    };
  })();
  /* ---- User-provided data capture (enhanced conversions) ----
     Remember the visitor's email / phone from any form field so the
     Google tag can hash-match the conversion on the success page. ---- */
  function mnRememberUserData(input) {
    try {
      if (!input || !input.value) return;
      var v = input.value.trim();
      var t = (input.getAttribute('type') || '').toLowerCase();
      var n = ((input.getAttribute('name') || '') + ' ' + (input.id || '') + ' ' + (input.getAttribute('autocomplete') || '')).toLowerCase();
      var ud = window.mn_ud || {};
      if (t === 'email' || /email/.test(n)) {
        if (/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)) ud.email = v.toLowerCase();
      } else if (t === 'tel' || /phone|tel/.test(n)) {
        if (v.replace(/\D/g, '').length >= 6) ud.phone = v;
      } else {
        return;
      }
      window.mn_ud = ud;
      sessionStorage.setItem('mn_ud', JSON.stringify(ud));
      window.dataLayer.push({ user_data: { email: ud.email || undefined, phone: ud.phone || undefined } });
    } catch (e) {}
  }
  document.addEventListener('change', function (e) {
    if (e.target && e.target.tagName === 'INPUT') mnRememberUserData(e.target);
  }, true);
  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form || !form.querySelectorAll) return;
    form.querySelectorAll('input').forEach(mnRememberUserData);
  }, true);
  /* ---- CTA clicks: WhatsApp / email / phone / ask question / book now ---- */
  function push(type, label) {
    window.dataLayer.push({
      event: 'cta_click',
      cta_type: type,
      cta_label: (label || '').trim().slice(0, 80),
      page_location: location.href
    });
  }
  document.addEventListener('click', function (e) {
    var a = e.target.closest('a, button');
    if (!a) return;
    var href = (a.getAttribute('href') || '').toLowerCase();
    var text = a.innerText || a.getAttribute('aria-label') || '';
    if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
      push('whatsapp', text || 'Chat icon (floating widget)');
    } else if (href.indexOf('mailto:') === 0) {
      push('email', text);
    } else if (href.indexOf('tel:') === 0) {
      push('phone', text);
    } else if (a.classList.contains('slide-form-toggle') || a.closest('.slide-form-toggle') ||
      /ask a question/i.test(text)) {
      push('ask_question', text || 'Ask a Question');
    } else if (a.classList.contains('tp-check-btn') || /check availability|book now|book this trip/i.test(text)) {
      push('book_now', text);
    }
  }, true);
  /* ---- Ask-question (WPForms) submissions -> generate_lead ---- */
  function bindWpforms() {
    if (!window.jQuery) return false;
    jQuery(document).on('wpformsAjaxSubmitSuccess', function (e) {
      var form = e.target && e.target.closest ? e.target.closest('form') : null;
      window.dataLayer.push({
        event: 'generate_lead',
        lead_source: 'ask_question_form',
        form_id: form ? form.dataset.formid || form.id : '',
        page_location: location.href
      });
    });
    return true;
  }
  if (!bindWpforms()) {
    var tries = 0;
    var t = setInterval(function () {
      if (bindWpforms() || ++tries > 20) clearInterval(t);
    }, 500);
  }
})();
</script>
