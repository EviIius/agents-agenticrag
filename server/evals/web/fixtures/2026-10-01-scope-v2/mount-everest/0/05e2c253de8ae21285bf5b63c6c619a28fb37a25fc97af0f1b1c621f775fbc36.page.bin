              <ul class="list-none flex flex-col md:flex-row md:items-center gap-5 pl-0">
                <li x-data="navCurrencyChooser">
                  <select class="bg-transparent" x-model="selectedCurrency" x-on:change="setCurrency">
                    <option data-flag="us" value="usd">USD ($)</option>
                    <option data-flag="au" value="aud">AUD ($)</option>
                    <option data-flag="eu" value="eur">EUR (€)</option>
                    <option data-flag="ch" value="chf">CHF (CHf)</option>
                    <option data-flag="gb" value="gbp">GBP (£)</option>
                    <option data-flag="ca" value="cad">CAD ($)</option>
                    <option data-flag="sg" value="sgd">SGD ($)</option>
                    <option data-flag="se" value="sek">SEK (kr)</option>
                    <option data-flag="dk" value="dkk">DKK (Kr.)</option>
                    <option data-flag="ae" value="aed">AED (د.إ)</option>
                  </select>
                </li>
              </ul>
            </div>
            <script>
document.addEventListener('alpine:init', function () {
        Alpine.data('navCurrencyChooser', () => ({
            selectedCurrency: 'usd',

            init() {
                this.selectedCurrency = localStorage.getItem('currency') || 'usd'
            },

            async setCurrency() {
                const todayDate = new Date().toISOString().slice(0, 10)

                try {
                    const response = await fetch(`https://www.nrb.org.np/api/forex/v1/rates?page=1&per_page=100&from=${todayDate}&to=${todayDate}`)

                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    } else {
                        const result = await response.json()
                        const rates = result.data.payload[0].rates
                        const match = rates.find(item => item.currency.iso3 === this.selectedCurrency.toUpperCase())
                        const rate = rates[1].sell / match.sell

                        localStorage.setItem('currency', this.selectedCurrency)
                        localStorage.setItem('rate', rate)

                        location.reload()
                    }
                } catch (e) {
                    console.error('Error setting currency:', e);
                }
            },

            formatPrice(price) {
                if (!price) return 0

                const numericPrice = Number(price);

                let currency = localStorage.getItem('currency') || 'usd'

                const rate = localStorage.getItem('rate')

                switch (currency) {
                    case 'aud':
                        currency = 'AUD $'
                        break
                    case 'eur':
                        currency = 'EUR €'
                        break
                    case 'chf':
                        currency = 'CHF F'
                        break
                    case 'gbp':
                        currency = 'GBP £'
                        break
                    case 'cad':
                        currency = 'CAD $'
                        break
                    case 'sgd':
                        currency = 'SGD $'
                        break
                    case 'sek':
                        currency = 'SEK kr'
                        break
                    case 'dkk':
                        currency = 'DKK Kr.'
                        break
                    case 'aed':
                        currency = 'AED د.إ'
                        break
                    default:
                        currency = 'USD $'
                }

                if (!rate) {
                    return currency + Math.round((numericPrice + Number.EPSILON) * 100) / 100
                }

                return currency + Math.round((numericPrice * rate + Number.EPSILON) * 100) / 100
            }
        }))
    })
</script>
