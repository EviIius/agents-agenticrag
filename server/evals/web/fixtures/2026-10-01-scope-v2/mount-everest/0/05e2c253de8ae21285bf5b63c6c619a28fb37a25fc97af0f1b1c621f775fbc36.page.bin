<script>
  (function () {
    // intl-tel-input v18 removed intlTelInputGlobals; WPForms 1.9+ ships the
    // new API on window.intlTelInput. Support both.
    function api() { return window.intlTelInput && window.intlTelInput.getInstance ? window.intlTelInput : window.intlTelInputGlobals; }
    function instance(inp) { var a = api(); try { return a ? a.getInstance(inp) : null; } catch (e) { return null; } }
    function detect() {
      var inputs = document.querySelectorAll('.wpforms-smart-phone-field');
      if (!inputs.length) { return; }
      fetch('https://ipwho.is/', { mode: 'cors' }).then(function (r) { return r.json(); }).then(function (d) {
        var cc = (d && d.country_code || '').toLowerCase();
        if (!cc) { return; }
        inputs.forEach(function (inp) {
          var iti = instance(inp);
          if (iti && !inp.value && !inp.dataset.mnCountrySet) {
            try { iti.setCountry(cc); inp.dataset.mnCountrySet = '1'; } catch (e) {}
          }
        });
      }).catch(function () {});
    }
    // Scripts may load late (defer / optimizers), so poll until the smart
    // field is actually initialized.
    var tries = 0;
    var timer = setInterval(function () {
      tries++;
      var inp = document.querySelector('.wpforms-smart-phone-field');
      if (inp && instance(inp)) {
        clearInterval(timer);
        detect();
      } else if (tries > 60) {
        clearInterval(timer);
      }
    }, 700);
  })();
  </script>
