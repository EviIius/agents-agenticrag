<script type="pmdelayedscript" data-cfasync="false" data-no-optimize="1" data-no-defer="1" data-no-minify="1">
	var $button = $('.wishlist');
	var $toaster = $('#toaster');
	var $message = $toaster.find('.message');
	var $spinner = $toaster.find('.spinner');

	$button.on('click', function() {
		$message.html('Adding to wishlist ...');
		$toaster.addClass('is-visible');
		$spinner.show(); // Show the spinner

		setTimeout(function() {
			$spinner.hide(); // Hide the spinner
			$toaster.removeClass('is-visible');
		}, 4000);
	});
</script>
<script type="pmdelayedscript" data-cfasync="false" data-no-optimize="1" data-no-defer="1" data-no-minify="1">
	$(document).ready(function() {
		$(".default_option").click(function(e) {
			e.stopPropagation(); // Prevent immediate closure from document click

			let selectWrap = $(this).closest(".select_wrap");

			// Close other dropdowns before opening this one
			$(".select_wrap").not(selectWrap).removeClass("active");

			// Toggle only the clicked select box
			selectWrap.toggleClass("active");
		});

		$(".select_ul li").click(function(e) {
			e.stopPropagation(); // Prevent document click from closing immediately

			let currentele = $(this).html();
			let selectWrap = $(this).closest(".select_wrap");

			selectWrap.find(".default_option li").html(currentele); // Update selected item
			selectWrap.removeClass("active"); // Close dropdown after selection
		});

		// Close all dropdowns if clicking outside
		$(document).click(function() {
			$(".select_wrap").removeClass("active");
		});
	});
</script>

