<script src="https://explorevisionnepal.com/wp-content/themes/explorevision/assets/js/jquery.toc.min.js" type="pmdelayedscript" data-cfasync="false" data-no-optimize="1" data-no-defer="1" data-no-minify="1"></script>
<script type="pmdelayedscript" data-cfasync="false" data-no-optimize="1" data-no-defer="1" data-no-minify="1">
    $(document).ready(function() {

        // Ensure TOC is collapsed by default
        //     $('.data-toc').removeClass('active');
        //    // Collapse by default
        // Collapse by default
        //     $('.data-toc').hide();

        // Slide toggle when clicking top-item (h2 included)
        $('.table-of-content .top-item').on('click', function() {
            $('.data-toc').stop(true, true).slideToggle(300);
            $(this).toggleClass('open'); // rotate arrow
        });

        // Close TOC when clicking anywhere outside
        $(document).on('click', function() {
            $('.data-toc').removeClass('active');
        });

        // Reset on resize (desktop view)
        $(window).on('resize', function() {
            if ($(window).width() >= 991) {
                $('.data-toc').removeClass('active');
            }
        });
    });

    // Handle sticky position on scroll
    $(window).on('scroll', function() {
        if ($(this).scrollTop() > 150) {
            $('.table-of-content h2').css({
                top: '0',
                transition: 'top 0.3s ease-in-out'
            });

            $('.table-of-content .data-toc.active').css({
                top: '47px',
                transition: 'top 0.3s ease-in-out'
            });
        } else {
            $('.table-of-content h2').css({
                top: '220px',
                transition: 'top 0.3s ease-in-out'
            });

            $('.table-of-content .data-toc.active').css({
                top: '263px',
                transition: 'top 0.3s ease-in-out'
            });
        }
    });
</script>


