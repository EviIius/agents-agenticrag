9,"children":16021},{"href":16020},"\u002Fbcp\u002Fbcp9",[16022],{"type":1449,"textContent":16023},"BCP",{"type":1449,"textContent":8931},{"type":1444,"nodeName":1452,"attributes":16026,"children":16027},{"href":16020},[16028],{"type":1449,"textContent":2427},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":16031,"children":16033},{"href":16032},"\u002Finfo\u002Frfc2026\u002F",[16034],{"type":1449,"textContent":16035},"RFC 2026",{"type":1449,"textContent":16037},", October 1996.\n\n   [",{"type":1444,"nodeName":1452,"attributes":16039,"children":16041},{"id":16040},"ref-47",[16042],{"type":1449,"textContent":1473},{"type":1449,"textContent":16044},"] Masinter, L., \"Hyper Text Coffee Pot Control Protocol\n        (HTCPCP\u002F1.0)\", ",{"type":1444,"nodeName":1452,"attributes":16046,"children":16048},{"href":16047},"\u002Finfo\u002Frfc2324\u002F",[16049],{"type":1449,"textContent":16050},"RFC 2324",{"type":1449,"textContent":16052},", 1 April 1998.\n\n   [",{"type":1444,"nodeName":1452,"attributes":16054,"children":16056},{"id":16055},"ref-48",[16057],{"type":1449,"textContent":2399},{"type":1449,"textContent":16059},"] Freed, N. and N. Borenstein, \"Multipurpose Internet Mail\n        Extensions (MIME) Part Five: Conformance Criteria and Examples\",\n        ",{"type":1444,"nodeName":1452,"attributes":16061,"children":16063},{"href":16062},"\u002Finfo\u002Frfc2049\u002F",[16064],{"type":1449,"textContent":16065},"RFC 2049",{"type":1449,"textContent":15382},{"type":1444,"nodeName":1452,"attributes":16068,"children":16070},{"id":16069},"ref-49",[16071],{"type":1449,"textContent":15065},{"type":1449,"textContent":16073},"] Troost, R., Dorner, S. and K. Moore, \"Communicating Presentation\n        Information in Internet Messages: The Content-Disposition Header\n        Field\", ",{"type":1444,"nodeName":1452,"attributes":16075,"children":16076},{"href":15055},[16077],{"type":1449,"textContent":15058},{"type":1449,"textContent":16079},", August 1997.\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16081,"children":16082},{"class":1493},[16083],{"type":1449,"textContent":16084},"Fielding, et al.            Standards Track                   [Page 161]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16087,"children":16088},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16090,"children":16091},{"class":1506},[16092,16096,16097,16105,16106,16115,16117],{"type":1444,"nodeName":1461,"attributes":16093,"children":16095},{"id":16094},"page-162",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16098,"children":16099},{"class":1493},[16100,16104],{"type":1444,"nodeName":1452,"attributes":16101,"children":16102},{"href":1518},[16103],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":16107,"children":16108},{"class":5216},[16109,16113],{"type":1444,"nodeName":1452,"attributes":16110,"children":16111},{"class":5220,"id":1324,"href":4882},[16112],{"type":1449,"textContent":1682},{"type":1449,"textContent":16114}," Authors' Addresses",{"type":1449,"textContent":16116},"\n\n   Roy T. Fielding\n   Information and Computer Science\n   University of California, Irvine\n   Irvine, CA 92697-3425, USA\n\n   Fax: +1 (949) 824-1715\n   EMail: fielding@ics.uci.edu\n\n\n   James Gettys\n   World Wide Web Consortium\n   MIT Laboratory for Computer Science\n   545 Technology Square\n   Cambridge, MA 02139, USA\n\n   Fax: +1 (617) 258 8682\n   EMail: jg@w3.org\n\n\n   Jeffrey C. Mogul\n   Western Research Laboratory\n   Compaq Computer Corporation\n   250 University Avenue\n   Palo Alto, California, 94305, USA\n\n   EMail: mogul@wrl.dec.com\n\n\n   Henrik Frystyk Nielsen\n   World Wide Web Consortium\n   MIT Laboratory for Computer Science\n   545 Technology Square\n   Cambridge, MA 02139, USA\n\n   Fax: +1 (617) 258 8682\n   EMail: frystyk@w3.org\n\n\n   Larry Masinter\n   Xerox Corporation\n   3333 Coyote Hill Road\n   Palo Alto, CA 94034, USA\n\n   EMail: masinter@parc.xerox.com\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16118,"children":16119},{"class":1493},[16120],{"type":1449,"textContent":16121},"Fielding, et al.            Standards Track                   [Page 162]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16124,"children":16125},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16127,"children":16128},{"class":1506},[16129,16133,16134,16142,16144],{"type":1444,"nodeName":1461,"attributes":16130,"children":16132},{"id":16131},"page-163",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16135,"children":16136},{"class":1493},[16137,16141],{"type":1444,"nodeName":1452,"attributes":16138,"children":16139},{"href":1518},[16140],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16143},"\n\n\n   Paul J. Leach\n   Microsoft Corporation\n   1 Microsoft Way\n   Redmond, WA 98052, USA\n\n   EMail: paulle@microsoft.com\n\n\n   Tim Berners-Lee\n   Director, World Wide Web Consortium\n   MIT Laboratory for Computer Science\n   545 Technology Square\n   Cambridge, MA 02139, USA\n\n   Fax: +1 (617) 258 8682\n   EMail: timbl@w3.org\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16145,"children":16146},{"class":1493},[16147],{"type":1449,"textContent":16148},"Fielding, et al.            Standards Track                   [Page 163]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16151,"children":16152},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16154,"children":16155},{"class":1506},[16156,16160,16161,16169,16170,16179,16180,16189,16191,16195,16197],{"type":1444,"nodeName":1461,"attributes":16157,"children":16159},{"id":16158},"page-164",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16162,"children":16163},{"class":1493},[16164,16168],{"type":1444,"nodeName":1452,"attributes":16165,"children":16166},{"href":1518},[16167],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":16171,"children":16172},{"class":5216},[16173,16177],{"type":1444,"nodeName":1452,"attributes":16174,"children":16175},{"class":5220,"id":1329,"href":4896},[16176],{"type":1449,"textContent":1697},{"type":1449,"textContent":16178}," Appendices",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":16181,"children":16182},{"class":5228},[16183,16187],{"type":1444,"nodeName":1452,"attributes":16184,"children":16185},{"class":5220,"id":1335,"href":4910},[16186],{"type":1449,"textContent":4913},{"type":1449,"textContent":16188}," Internet Media Type message\u002Fhttp and application\u002Fhttp",{"type":1449,"textContent":16190},"\n\n   In addition to defining the HTTP\u002F1.1 protocol, this document serves\n   as the specification for the Internet media type \"message\u002Fhttp\" and\n   \"application\u002Fhttp\". The message\u002Fhttp type can be used to enclose a\n   single HTTP request or response message, provided that it obeys the\n   MIME restrictions for all \"message\" types regarding line length and\n   encodings. The application\u002Fhttp type can be used to enclose a\n   pipeline of one or more HTTP request or response messages (not\n   intermixed). The following is to be registered with IANA [",{"type":1444,"nodeName":1452,"attributes":16192,"children":16193},{"href":6672},[16194],{"type":1449,"textContent":1654},{"type":1449,"textContent":16196},"].\n\n       Media Type name:         message\n       Media subtype name:      http\n       Required parameters:     none\n       Optional parameters:     version, msgtype\n        version: The HTTP-Version number of the enclosed message\n                 (e.g., \"1.1\"). If not present, the version can be\n                 determined from the first line of the body.\n        msgtype: The message type -- \"request\" or \"response\". If not\n                 present, the type can be determined from the first\n                 line of the body.\n       Encoding considerations: only \"7bit\", \"8bit\", or \"binary\" are\n                                permitted\n       Security considerations: none\n\n       Media Type name:         application\n       Media subtype name:      http\n       Required parameters:     none\n       Optional parameters:     version, msgtype\n        version: The HTTP-Version number of the enclosed messages\n                 (e.g., \"1.1\"). If not present, the version can be\n                 determined from the first line of the body.\n        msgtype: The message type -- \"request\" or \"response\". If not\n                 present, the type can be determined from the first\n                 line of the body.\n       Encoding considerations: HTTP messages enclosed by this type\n                 are in \"binary\" format; use of an appropriate\n                 Content-Transfer-Encoding is required when\n                 transmitted via E-mail.\n       Security considerations: none\n\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16198,"children":16199},{"class":1493},[16200],{"type":1449,"textContent":16201},"Fielding, et al.            Standards Track                   [Page 164]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16204,"children":16205},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16207,"children":16208},{"class":1506},[16209,16213,16214,16222,16223,16232,16234],{"type":1444,"nodeName":1461,"attributes":16210,"children":16212},{"id":16211},"page-165",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16215,"children":16216},{"class":1493},[16217,16221],{"type":1444,"nodeName":1452,"attributes":16218,"children":16219},{"href":1518},[16220],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":16224,"children":16225},{"class":5228},[16226,16230],{"type":1444,"nodeName":1452,"attributes":16227,"children":16228},{"class":5220,"id":1340,"href":4923},[16229],{"type":1449,"textContent":4926},{"type":1449,"textContent":16231}," Internet Media Type multipart\u002Fbyteranges",{"type":1449,"textContent":16233},"\n\n   When an HTTP 206 (Partial Content) response message includes the\n   content of multiple ranges (a response to a request for multiple\n   non-overlapping ranges), these are transmitted as a multipart\n   message-body. The media type for this purpose is called\n   \"multipart\u002Fbyteranges\".\n\n   The multipart\u002Fbyteranges media type includes two or more parts, each\n   with its own Content-Type and Content-Range fields. The required\n   boundary parameter specifies the boundary string used to separate\n   each body-part.\n\n       Media Type name:         multipart\n       Media subtype name:      byteranges\n       Required parameters:     boundary\n       Optional parameters:     none\n       Encoding considerations: only \"7bit\", \"8bit\", or \"binary\" are\n                                permitted\n       Security considerations: none\n\n\n   For example:\n\n   HTTP\u002F1.1 206 Partial Content\n   Date: Wed, 15 Nov 1995 06:25:24 GMT\n   Last-Modified: Wed, 15 Nov 1995 04:58:08 GMT\n   Content-type: multipart\u002Fbyteranges; boundary=THIS_STRING_SEPARATES\n\n   --THIS_STRING_SEPARATES\n   Content-type: application\u002Fpdf\n   Content-range: bytes 500-999\u002F8000\n\n   ...the first range...\n   --THIS_STRING_SEPARATES\n   Content-type: application\u002Fpdf\n   Content-range: bytes 7000-7999\u002F8000\n\n   ...the second range\n   --THIS_STRING_SEPARATES--\n\n      Notes:\n\n      1) Additional CRLFs may precede the first boundary string in the\n         entity.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16235,"children":16236},{"class":1493},[16237],{"type":1449,"textContent":16238},"Fielding, et al.            Standards Track                   [Page 165]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16241,"children":16242},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16244,"children":16245},{"class":1506},[16246,16250,16251,16259,16261,16265,16266,16270,16272,16281,16283,16287,16289,16294,16296],{"type":1444,"nodeName":1461,"attributes":16247,"children":16249},{"id":16248},"page-166",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16252,"children":16253},{"class":1493},[16254,16258],{"type":1444,"nodeName":1452,"attributes":16255,"children":16256},{"href":1518},[16257],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16260},"\n\n\n      2) Although ",{"type":1444,"nodeName":1452,"attributes":16262,"children":16263},{"href":6828},[16264],{"type":1449,"textContent":6831},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16267,"children":16268},{"href":6820},[16269],{"type":1449,"textContent":6823},{"type":1449,"textContent":16271},"] permits the boundary string to be\n         quoted, some existing implementations handle a quoted boundary\n         string incorrectly.\n\n      3) A number of browsers and servers were coded to an early draft\n         of the byteranges specification to use a media type of\n         multipart\u002Fx-byteranges, which is almost, but not quite\n         compatible with the version documented in HTTP\u002F1.1.\n\n",{"type":1444,"nodeName":1461,"attributes":16273,"children":16274},{"class":5228},[16275,16279],{"type":1444,"nodeName":1452,"attributes":16276,"children":16277},{"class":5220,"id":1345,"href":4938},[16278],{"type":1449,"textContent":4941},{"type":1449,"textContent":16280}," Tolerant Applications",{"type":1449,"textContent":16282},"\n\n   Although this document specifies the requirements for the generation\n   of HTTP\u002F1.1 messages, not all applications will be correct in their\n   implementation. We therefore recommend that operational applications\n   be tolerant of deviations whenever those deviations can be\n   interpreted unambiguously.\n\n   Clients SHOULD be tolerant in parsing the Status-Line and servers\n   tolerant when parsing the Request-Line. In particular, they SHOULD\n   accept any amount of SP or HT characters between fields, even though\n   only a single SP is required.\n\n   The line terminator for message-header fields is the sequence CRLF.\n   However, we recommend that applications, when parsing such headers,\n   recognize a single LF as a line terminator and ignore the leading CR.\n\n   The character set of an entity-body SHOULD be labeled as the lowest\n   common denominator of the character codes used within that body, with\n   the exception that not labeling the entity is preferred over labeling\n   the entity with the labels US-ASCII or ISO-8859-1. See ",{"type":1444,"nodeName":1452,"attributes":16284,"children":16285},{"href":1858},[16286],{"type":1449,"textContent":6395},{"type":1449,"textContent":16288},"\n   and 3.4.1.\n\n   Additional rules for requirements on parsing and encoding of dates\n   and other potential problems with date encodings include:\n\n      - HTTP\u002F1.1 clients and caches SHOULD assume that an ",{"type":1444,"nodeName":1452,"attributes":16290,"children":16291},{"href":6163},[16292],{"type":1449,"textContent":16293},"RFC-850",{"type":1449,"textContent":16295}," date\n        which appears to be more than 50 years in the future is in fact\n        in the past (this helps solve the \"year 2000\" problem).\n\n      - An HTTP\u002F1.1 implementation MAY internally represent a parsed\n        Expires date as earlier than the proper value, but MUST NOT\n        internally represent a parsed Expires date as later than the\n        proper value.\n\n      - All expiration-related calculations MUST be done in GMT. The\n        local time zone MUST NOT influence the calculation or comparison\n        of an age or expiration time.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16297,"children":16298},{"class":1493},[16299],{"type":1449,"textContent":16300},"Fielding, et al.            Standards Track                   [Page 166]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16303,"children":16304},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16306,"children":16307},{"class":1506},[16308,16312,16313,16321,16323,16338,16340,16344,16345,16350,16351,16355,16357,16361,16363,16367,16369,16373,16375,16379,16380,16385,16387,16396,16398,16402,16403,16407,16409,16418,16419,16423,16424,16428,16430,16436,16437,16442,16444,16449,16451,16455,16457],{"type":1444,"nodeName":1461,"attributes":16309,"children":16311},{"id":16310},"page-167",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16314,"children":16315},{"class":1493},[16316,16320],{"type":1444,"nodeName":1452,"attributes":16317,"children":16318},{"href":1518},[16319],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16322},"\n\n\n      - If an HTTP header incorrectly carries a date value with a time\n        zone other than GMT, it MUST be converted into GMT using the\n        most conservative possible conversion.\n\n",{"type":1444,"nodeName":1461,"attributes":16324,"children":16325},{"class":5228},[16326,16330,16332,16336],{"type":1444,"nodeName":1452,"attributes":16327,"children":16328},{"class":5220,"id":1350,"href":4953},[16329],{"type":1449,"textContent":4956},{"type":1449,"textContent":16331}," Differences Between HTTP Entities and ",{"type":1444,"nodeName":1452,"attributes":16333,"children":16334},{"href":4961},[16335],{"type":1449,"textContent":4964},{"type":1449,"textContent":16337}," Entities",{"type":1449,"textContent":16339},"\n\n   HTTP\u002F1.1 uses many of the constructs defined for Internet Mail (",{"type":1444,"nodeName":1452,"attributes":16341,"children":16342},{"href":5662},[16343],{"type":1449,"textContent":15282},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":16346,"children":16347},{"href":5662},[16348],{"type":1449,"textContent":16349},"822",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16352,"children":16353},{"href":5308},[16354],{"type":1449,"textContent":2427},{"type":1449,"textContent":16356},"]) and the Multipurpose Internet Mail Extensions (MIME [",{"type":1444,"nodeName":1452,"attributes":16358,"children":16359},{"href":5315},[16360],{"type":1449,"textContent":1539},{"type":1449,"textContent":16362},"]) to\n   allow entities to be transmitted in an open variety of\n   representations and with extensible mechanisms. However, ",{"type":1444,"nodeName":1452,"attributes":16364,"children":16365},{"href":4961},[16366],{"type":1449,"textContent":4964},{"type":1449,"textContent":16368},"\n   discusses mail, and HTTP has a few features that are different from\n   those described in ",{"type":1444,"nodeName":1452,"attributes":16370,"children":16371},{"href":4961},[16372],{"type":1449,"textContent":4964},{"type":1449,"textContent":16374},". These differences were carefully chosen\n   to optimize performance over binary connections, to allow greater\n   freedom in the use of new media types, to make date comparisons\n   easier, and to acknowledge the practice of some early HTTP servers\n   and clients.\n\n   This appendix describes specific areas where HTTP differs from ",{"type":1444,"nodeName":1452,"attributes":16376,"children":16377},{"href":4961},[16378],{"type":1449,"textContent":15282},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":16381,"children":16382},{"href":4961},[16383],{"type":1449,"textContent":16384},"2045",{"type":1449,"textContent":16386},". Proxies and gateways to strict MIME environments SHOULD be\n   aware of these differences and provide the appropriate conversions\n   where necessary. Proxies and gateways from MIME environments to HTTP\n   also need to be aware of the differences because some conversions\n   might be required.\n\n",{"type":1444,"nodeName":1461,"attributes":16388,"children":16389},{"class":5964},[16390,16394],{"type":1444,"nodeName":1452,"attributes":16391,"children":16392},{"class":5220,"id":1356,"href":5002},[16393],{"type":1449,"textContent":5005},{"type":1449,"textContent":16395}," MIME-Version",{"type":1449,"textContent":16397},"\n\n   HTTP is not a MIME-compliant protocol. However, HTTP\u002F1.1 messages MAY\n   include a single MIME-Version general-header field to indicate what\n   version of the MIME protocol was used to construct the message. Use\n   of the MIME-Version header field indicates that the message is in\n   full compliance with the MIME protocol (as defined in ",{"type":1444,"nodeName":1452,"attributes":16399,"children":16400},{"href":4961},[16401],{"type":1449,"textContent":4964},{"type":1449,"textContent":5899},{"type":1444,"nodeName":1452,"attributes":16404,"children":16405},{"href":5315},[16406],{"type":1449,"textContent":1539},{"type":1449,"textContent":16408},"]).\n   Proxies\u002Fgateways are responsible for ensuring full compliance (where\n   possible) when exporting HTTP messages to strict MIME environments.\n\n       MIME-Version   = \"MIME-Version\" \":\" 1*DIGIT \".\" 1*DIGIT\n\n   MIME version \"1.0\" is the default for use in HTTP\u002F1.1. However,\n   HTTP\u002F1.1 message parsing and semantics are defined by this document\n   and not the MIME specification.\n\n",{"type":1444,"nodeName":1461,"attributes":16410,"children":16411},{"class":5964},[16412,16416],{"type":1444,"nodeName":1452,"attributes":16413,"children":16414},{"class":5220,"id":1361,"href":5015},[16415],{"type":1449,"textContent":5018},{"type":1449,"textContent":16417}," Conversion to Canonical Form",{"type":1449,"textContent":15031},{"type":1444,"nodeName":1452,"attributes":16420,"children":16421},{"href":4961},[16422],{"type":1449,"textContent":4964},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16425,"children":16426},{"href":5315},[16427],{"type":1449,"textContent":1539},{"type":1449,"textContent":16429},"] requires that an Internet mail entity be converted to\n   canonical form prior to being transferred, as described in ",{"type":1444,"nodeName":1452,"attributes":16431,"children":16433},{"href":16432},"\u002Finfo\u002Frfc2049\u002F#section-4",[16434],{"type":1449,"textContent":16435},"section 4\n   of RFC 2049",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16438,"children":16440},{"href":16439},"#ref-48",[16441],{"type":1449,"textContent":2399},{"type":1449,"textContent":16443},"]. ",{"type":1444,"nodeName":1452,"attributes":16445,"children":16446},{"href":1858},[16447],{"type":1449,"textContent":16448},"Section 3.7.1",{"type":1449,"textContent":16450}," of this document describes the forms\n   allowed for subtypes of the \"text\" media type when transmitted over\n   HTTP. ",{"type":1444,"nodeName":1452,"attributes":16452,"children":16453},{"href":6828},[16454],{"type":1449,"textContent":6831},{"type":1449,"textContent":16456}," requires that content with a type of \"text\" represent\n   line breaks as CRLF and forbids the use of CR or LF outside of line\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16458,"children":16459},{"class":1493},[16460],{"type":1449,"textContent":16461},"Fielding, et al.            Standards Track                   [Page 167]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16464,"children":16465},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16467,"children":16468},{"class":1506},[16469,16473,16474,16482,16484,16488,16490,16494,16496,16505,16507,16511,16513,16522,16523,16527,16529,16533,16535,16544,16546,16550,16551,16555,16557],{"type":1444,"nodeName":1461,"attributes":16470,"children":16472},{"id":16471},"page-168",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16475,"children":16476},{"class":1493},[16477,16481],{"type":1444,"nodeName":1452,"attributes":16478,"children":16479},{"href":1518},[16480],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16483},"\n\n\n   break sequences. HTTP allows CRLF, bare CR, and bare LF to indicate a\n   line break within text content when a message is transmitted over\n   HTTP.\n\n   Where it is possible, a proxy or gateway from HTTP to a strict MIME\n   environment SHOULD translate all line breaks within the text media\n   types described in ",{"type":1444,"nodeName":1452,"attributes":16485,"children":16486},{"href":1858},[16487],{"type":1449,"textContent":6395},{"type":1449,"textContent":16489}," of this document to the ",{"type":1444,"nodeName":1452,"attributes":16491,"children":16492},{"href":16062},[16493],{"type":1449,"textContent":16065},{"type":1449,"textContent":16495},"\n   canonical form of CRLF. Note, however, that this might be complicated\n   by the presence of a Content-Encoding and by the fact that HTTP\n   allows the use of some character sets which do not use octets 13 and\n   10 to represent CR and LF, as is the case for some multi-byte\n   character sets.\n\n   Implementors should note that conversion will break any cryptographic\n   checksums applied to the original content unless the original content\n   is already in canonical form. Therefore, the canonical form is\n   recommended for any content that uses such checksums in HTTP.\n\n",{"type":1444,"nodeName":1461,"attributes":16497,"children":16498},{"class":5964},[16499,16503],{"type":1444,"nodeName":1452,"attributes":16500,"children":16501},{"class":5220,"id":1366,"href":5028},[16502],{"type":1449,"textContent":5031},{"type":1449,"textContent":16504}," Conversion of Date Formats",{"type":1449,"textContent":16506},"\n\n   HTTP\u002F1.1 uses a restricted set of date formats (",{"type":1444,"nodeName":1452,"attributes":16508,"children":16509},{"href":1742},[16510],{"type":1449,"textContent":13567},{"type":1449,"textContent":16512},") to\n   simplify the process of date comparison. Proxies and gateways from\n   other protocols SHOULD ensure that any Date header field present in a\n   message conforms to one of the HTTP\u002F1.1 formats and rewrite the date\n   if necessary.\n\n",{"type":1444,"nodeName":1461,"attributes":16514,"children":16515},{"class":5964},[16516,16520],{"type":1444,"nodeName":1452,"attributes":16517,"children":16518},{"class":5220,"id":1371,"href":5043},[16519],{"type":1449,"textContent":5046},{"type":1449,"textContent":16521}," Introduction of Content-Encoding",{"type":1449,"textContent":15031},{"type":1444,"nodeName":1452,"attributes":16524,"children":16525},{"href":4961},[16526],{"type":1449,"textContent":4964},{"type":1449,"textContent":16528}," does not include any concept equivalent to HTTP\u002F1.1's\n   Content-Encoding header field. Since this acts as a modifier on the\n   media type, proxies and gateways from HTTP to MIME-compliant\n   protocols MUST either change the value of the Content-Type header\n   field or decode the entity-body before forwarding the message. (Some\n   experimental applications of Content-Type for Internet mail have used\n   a media-type parameter of \";conversions=\u003Ccontent-coding>\" to perform\n   a function equivalent to Content-Encoding. However, this parameter is\n   not part of ",{"type":1444,"nodeName":1452,"attributes":16530,"children":16531},{"href":4961},[16532],{"type":1449,"textContent":4964},{"type":1449,"textContent":16534},".)\n\n",{"type":1444,"nodeName":1461,"attributes":16536,"children":16537},{"class":5964},[16538,16542],{"type":1444,"nodeName":1452,"attributes":16539,"children":16540},{"class":5220,"id":1376,"href":5056},[16541],{"type":1449,"textContent":5059},{"type":1449,"textContent":16543}," No Content-Transfer-Encoding",{"type":1449,"textContent":16545},"\n\n   HTTP does not use the Content-Transfer-Encoding (CTE) field of ",{"type":1444,"nodeName":1452,"attributes":16547,"children":16548},{"href":4961},[16549],{"type":1449,"textContent":15282},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":16552,"children":16553},{"href":4961},[16554],{"type":1449,"textContent":16384},{"type":1449,"textContent":16556},". Proxies and gateways from MIME-compliant protocols to HTTP MUST\n   remove any non-identity CTE (\"quoted-printable\" or \"base64\") encoding\n   prior to delivering the response message to an HTTP client.\n\n   Proxies and gateways from HTTP to MIME-compliant protocols are\n   responsible for ensuring that the message is in the correct format\n   and encoding for safe transport on that protocol, where \"safe\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16558,"children":16559},{"class":1493},[16560],{"type":1449,"textContent":16561},"Fielding, et al.            Standards Track                   [Page 168]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16564,"children":16565},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16567,"children":16568},{"class":1506},[16569,16573,16574,16582,16584,16593,16595,16599,16600,16604,16606,16610,16612,16621,16623,16628,16630,16635,16637,16646,16647,16651,16652,16656,16658],{"type":1444,"nodeName":1461,"attributes":16570,"children":16572},{"id":16571},"page-169",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16575,"children":16576},{"class":1493},[16577,16581],{"type":1444,"nodeName":1452,"attributes":16578,"children":16579},{"href":1518},[16580],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16583},"\n\n\n   transport\" is defined by the limitations of the protocol being used.\n   Such a proxy or gateway SHOULD label the data with an appropriate\n   Content-Transfer-Encoding if doing so will improve the likelihood of\n   safe transport over the destination protocol.\n\n",{"type":1444,"nodeName":1461,"attributes":16585,"children":16586},{"class":5964},[16587,16591],{"type":1444,"nodeName":1452,"attributes":16588,"children":16589},{"class":5220,"id":1381,"href":5069},[16590],{"type":1449,"textContent":5072},{"type":1449,"textContent":16592}," Introduction of Transfer-Encoding",{"type":1449,"textContent":16594},"\n\n   HTTP\u002F1.1 introduces the Transfer-Encoding header field (",{"type":1444,"nodeName":1452,"attributes":16596,"children":16597},{"href":4574},[16598],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":16601,"children":16602},{"href":4574},[16603],{"type":1449,"textContent":4577},{"type":1449,"textContent":16605},"). Proxies\u002Fgateways MUST remove any transfer-coding prior to\n   forwarding a message via a MIME-compliant protocol.\n\n   A process for decoding the \"chunked\" transfer-coding (",{"type":1444,"nodeName":1452,"attributes":16607,"children":16608},{"href":1813},[16609],{"type":1449,"textContent":6699},{"type":1449,"textContent":16611},")\n   can be represented in pseudo-code as:\n\n       length := 0\n       read chunk-size, chunk-extension (if any) and CRLF\n       while (chunk-size > 0) {\n          read chunk-data and CRLF\n          append chunk-data to entity-body\n          length := length + chunk-size\n          read chunk-size and CRLF\n       }\n       read entity-header\n       while (entity-header not empty) {\n          append entity-header to existing header fields\n          read entity-header\n       }\n       Content-Length := length\n       Remove \"chunked\" from Transfer-Encoding\n\n",{"type":1444,"nodeName":1461,"attributes":16613,"children":16614},{"class":5964},[16615,16619],{"type":1444,"nodeName":1452,"attributes":16616,"children":16617},{"class":5220,"id":1386,"href":5084},[16618],{"type":1449,"textContent":5087},{"type":1449,"textContent":16620}," MHTML and Line Length Limitations",{"type":1449,"textContent":16622},"\n\n   HTTP implementations which share code with MHTML [",{"type":1444,"nodeName":1452,"attributes":16624,"children":16626},{"href":16625},"#ref-45",[16627],{"type":1449,"textContent":2329},{"type":1449,"textContent":16629},"] implementations\n   need to be aware of MIME line length limitations. Since HTTP does not\n   have this limitation, HTTP does not fold long lines. MHTML messages\n   being transported by HTTP follow all conventions of MHTML, including\n   line length limitations and folding, canonicalization, etc., since\n   HTTP transports all message-bodies as payload (see ",{"type":1444,"nodeName":1452,"attributes":16631,"children":16632},{"href":1873},[16633],{"type":1449,"textContent":16634},"section 3.7.2",{"type":1449,"textContent":16636},") and\n   does not interpret the content or any MIME header lines that might be\n   contained therein.\n\n",{"type":1444,"nodeName":1461,"attributes":16638,"children":16639},{"class":5228},[16640,16644],{"type":1444,"nodeName":1452,"attributes":16641,"children":16642},{"class":5220,"id":1391,"href":5097},[16643],{"type":1449,"textContent":5100},{"type":1449,"textContent":16645}," Additional Features",{"type":1449,"textContent":15031},{"type":1444,"nodeName":1452,"attributes":16648,"children":16649},{"href":5240},[16650],{"type":1449,"textContent":5243},{"type":1449,"textContent":6839},{"type":1444,"nodeName":1452,"attributes":16653,"children":16654},{"href":1454},[16655],{"type":1449,"textContent":1480},{"type":1449,"textContent":16657}," document protocol elements used by some\n   existing HTTP implementations, but not consistently and correctly\n   across most HTTP\u002F1.1 applications. Implementors are advised to be\n   aware of these features, but cannot rely upon their presence in, or\n   interoperability with, other HTTP\u002F1.1 applications. Some of these\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16659,"children":16660},{"class":1493},[16661],{"type":1449,"textContent":16662},"Fielding, et al.            Standards Track                   [Page 169]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16665,"children":16666},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16668,"children":16669},{"class":1506},[16670,16674,16675,16683,16685,16689,16690,16695,16696,16705,16707,16711,16712,16716,16718,16723,16725,16734,16736],{"type":1444,"nodeName":1461,"attributes":16671,"children":16673},{"id":16672},"page-170",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16676,"children":16677},{"class":1493},[16678,16682],{"type":1444,"nodeName":1452,"attributes":16679,"children":16680},{"href":1518},[16681],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16684},"\n\n\n   describe proposed experimental features, and some describe features\n   that experimental deployment found lacking that are now addressed in\n   the base HTTP\u002F1.1 specification.\n\n   A number of other headers, such as Content-Disposition and Title,\n   from SMTP and MIME are also often implemented (see ",{"type":1444,"nodeName":1452,"attributes":16686,"children":16687},{"href":15867},[16688],{"type":1449,"textContent":15870},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16691,"children":16693},{"href":16692},"#ref-37",[16694],{"type":1449,"textContent":15862},{"type":1449,"textContent":9410},{"type":1444,"nodeName":1461,"attributes":16697,"children":16698},{"class":5964},[16699,16703],{"type":1444,"nodeName":1452,"attributes":16700,"children":16701},{"class":5220,"id":1397,"href":5110},[16702],{"type":1449,"textContent":5113},{"type":1449,"textContent":16704}," Content-Disposition",{"type":1449,"textContent":16706},"\n\n   The Content-Disposition response-header field has been proposed as a\n   means for the origin server to suggest a default filename if the user\n   requests that the content is saved to a file. This usage is derived\n   from the definition of Content-Disposition in ",{"type":1444,"nodeName":1452,"attributes":16708,"children":16709},{"href":15034},[16710],{"type":1449,"textContent":15037},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16713,"children":16714},{"href":15041},[16715],{"type":1449,"textContent":2053},{"type":1449,"textContent":16717},"].\n\n        content-disposition = \"Content-Disposition\" \":\"\n                              disposition-type *( \";\" disposition-parm )\n        disposition-type = \"attachment\" | disp-extension-token\n        disposition-parm = filename-parm | disp-extension-parm\n        filename-parm = \"filename\" \"=\" quoted-string\n        disp-extension-token = token\n        disp-extension-parm = token \"=\" ( token | quoted-string )\n\n   An example is\n\n        Content-Disposition: attachment; filename=\"fname.ext\"\n\n   The receiving user agent SHOULD NOT respect any directory path\n   information present in the filename-parm parameter, which is the only\n   parameter believed to apply to HTTP implementations at this time. The\n   filename SHOULD be treated as a terminal component only.\n\n   If this header is used in a response with the application\u002Foctet-\n   stream content-type, the implied suggestion is that the user agent\n   should not display the response, but directly enter a `save response\n   as...' dialog.\n\n   See ",{"type":1444,"nodeName":1452,"attributes":16719,"children":16720},{"href":4799},[16721],{"type":1449,"textContent":16722},"section 15.5",{"type":1449,"textContent":16724}," for Content-Disposition security issues.\n\n",{"type":1444,"nodeName":1461,"attributes":16726,"children":16727},{"class":5228},[16728,16732],{"type":1444,"nodeName":1452,"attributes":16729,"children":16730},{"class":5220,"id":1402,"href":5125},[16731],{"type":1449,"textContent":5128},{"type":1449,"textContent":16733}," Compatibility with Previous Versions",{"type":1449,"textContent":16735},"\n\n   It is beyond the scope of a protocol specification to mandate\n   compliance with previous versions. HTTP\u002F1.1 was deliberately\n   designed, however, to make supporting previous versions easy. It is\n   worth noting that, at the time of composing this specification\n   (1996), we would expect commercial HTTP\u002F1.1 servers to:\n\n      - recognize the format of the Request-Line for HTTP\u002F0.9, 1.0, and\n        1.1 requests;\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16737,"children":16738},{"class":1493},[16739],{"type":1449,"textContent":16740},"Fielding, et al.            Standards Track                   [Page 170]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16743,"children":16744},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16746,"children":16747},{"class":1506},[16748,16752,16753,16761,16763,16767,16768,16772,16773,16777,16778,16787,16789,16798,16799,16803,16805,16809,16811,16815,16816,16820,16822],{"type":1444,"nodeName":1461,"attributes":16749,"children":16751},{"id":16750},"page-171",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16754,"children":16755},{"class":1493},[16756,16760],{"type":1444,"nodeName":1452,"attributes":16757,"children":16758},{"href":1518},[16759],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16762},"\n\n\n      - understand any valid request in the format of HTTP\u002F0.9, 1.0, or\n        1.1;\n\n      - respond appropriately with a message in the same major version\n        used by the client.\n\n   And we would expect HTTP\u002F1.1 clients to:\n\n      - recognize the format of the Status-Line for HTTP\u002F1.0 and 1.1\n        responses;\n\n      - understand any valid response in the format of HTTP\u002F0.9, 1.0, or\n        1.1.\n\n   For most implementations of HTTP\u002F1.0, each connection is established\n   by the client prior to the request and closed by the server after\n   sending the response. Some implementations implement the Keep-Alive\n   version of persistent connections described in section 19.7.1 of ",{"type":1444,"nodeName":1452,"attributes":16764,"children":16765},{"href":1454},[16766],{"type":1449,"textContent":15282},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":16769,"children":16770},{"href":1454},[16771],{"type":1449,"textContent":1457},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16774,"children":16775},{"href":1485},[16776],{"type":1449,"textContent":1488},{"type":1449,"textContent":6352},{"type":1444,"nodeName":1461,"attributes":16779,"children":16780},{"class":5964},[16781,16785],{"type":1444,"nodeName":1452,"attributes":16782,"children":16783},{"class":5220,"id":1408,"href":5138},[16784],{"type":1449,"textContent":5141},{"type":1449,"textContent":16786}," Changes from HTTP\u002F1.0",{"type":1449,"textContent":16788},"\n\n   This section summarizes major differences between versions HTTP\u002F1.0\n   and HTTP\u002F1.1.\n\n",{"type":1444,"nodeName":1461,"attributes":16790,"children":16791},{"class":8689},[16792,16796],{"type":1444,"nodeName":1452,"attributes":16793,"children":16794},{"class":5220,"id":1414,"href":7707},[16795],{"type":1449,"textContent":13721},{"type":1449,"textContent":16797}," Changes to Simplify Multi-homed Web Servers and Conserve IP",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16800,"children":16801},{"class":8689,"id":1419},[16802],{"type":1449,"textContent":1420},{"type":1449,"textContent":16804},"\n\n   The requirements that clients and servers support the Host request-\n   header, report an error if the Host request-header (",{"type":1444,"nodeName":1452,"attributes":16806,"children":16807},{"href":4286},[16808],{"type":1449,"textContent":9057},{"type":1449,"textContent":16810},") is\n   missing from an HTTP\u002F1.1 request, and accept absolute URIs (",{"type":1444,"nodeName":1452,"attributes":16812,"children":16813},{"href":2085},[16814],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":16817,"children":16818},{"href":2085},[16819],{"type":1449,"textContent":2088},{"type":1449,"textContent":16821},") are among the most important changes defined by this\n   specification.\n\n   Older HTTP\u002F1.0 clients assumed a one-to-one relationship of IP\n   addresses and servers; there was no other established mechanism for\n   distinguishing the intended server of a request than the IP address\n   to which that request was directed. The changes outlined above will\n   allow the Internet, once older HTTP clients are no longer common, to\n   support multiple Web sites from a single IP address, greatly\n   simplifying large operational Web servers, where allocation of many\n   IP addresses to a single host has created serious problems. The\n   Internet will also be able to recover the IP addresses that have been\n   allocated for the sole purpose of allowing special-purpose domain\n   names to be used in root-level HTTP URLs. Given the rate of growth of\n   the Web, and the number of servers already deployed, it is extremely\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16823,"children":16824},{"class":1493},[16825],{"type":1449,"textContent":16826},"Fielding, et al.            Standards Track                   [Page 171]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16829,"children":16830},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16832,"children":16833},{"class":1506},[16834,16838,16839,16847,16849,16858,16860,16864,16866,16870,16872,16876,16878,16891,16893,16897,16899,16903,16904,16908,16910,16914,16916],{"type":1444,"nodeName":1461,"attributes":16835,"children":16837},{"id":16836},"page-172",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16840,"children":16841},{"class":1493},[16842,16846],{"type":1444,"nodeName":1452,"attributes":16843,"children":16844},{"href":1518},[16845],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16848},"\n\n\n   important that all implementations of HTTP (including updates to\n   existing HTTP\u002F1.0 applications) correctly implement these\n   requirements:\n\n      - Both clients and servers MUST support the Host request-header.\n\n      - A client that sends an HTTP\u002F1.1 request MUST send a Host header.\n\n      - Servers MUST report a 400 (Bad Request) error if an HTTP\u002F1.1\n        request does not include a Host request-header.\n\n      - Servers MUST accept absolute URIs.\n\n",{"type":1444,"nodeName":1461,"attributes":16850,"children":16851},{"class":5964},[16852,16856],{"type":1444,"nodeName":1452,"attributes":16853,"children":16854},{"class":5220,"id":1424,"href":5153},[16855],{"type":1449,"textContent":5156},{"type":1449,"textContent":16857}," Compatibility with HTTP\u002F1.0 Persistent Connections",{"type":1449,"textContent":16859},"\n\n   Some clients and servers might wish to be compatible with some\n   previous implementations of persistent connections in HTTP\u002F1.0\n   clients and servers. Persistent connections in HTTP\u002F1.0 are\n   explicitly negotiated as they are not the default behavior. HTTP\u002F1.0\n   experimental implementations of persistent connections are faulty,\n   and the new facilities in HTTP\u002F1.1 are designed to rectify these\n   problems. The problem was that some existing 1.0 clients may be\n   sending Keep-Alive to a proxy server that doesn't understand\n   Connection, which would then erroneously forward it to the next\n   inbound server, which would establish the Keep-Alive connection and\n   result in a hung HTTP\u002F1.0 proxy waiting for the close on the\n   response. The result is that HTTP\u002F1.0 clients must be prevented from\n   using Keep-Alive when talking to proxies.\n\n   However, talking to proxies is the most important use of persistent\n   connections, so that prohibition is clearly unacceptable. Therefore,\n   we need some other mechanism for indicating a persistent connection\n   is desired, which is safe to use even when talking to an old proxy\n   that ignores Connection. Persistent connections are the default for\n   HTTP\u002F1.1 messages; we introduce a new keyword (Connection: close) for\n   declaring non-persistence. See ",{"type":1444,"nodeName":1452,"attributes":16861,"children":16862},{"href":4056},[16863],{"type":1449,"textContent":8684},{"type":1449,"textContent":16865},".\n\n   The original HTTP\u002F1.0 form of persistent connections (the Connection:\n   Keep-Alive and Keep-Alive header) is documented in ",{"type":1444,"nodeName":1452,"attributes":16867,"children":16868},{"href":1454},[16869],{"type":1449,"textContent":1480},{"type":1449,"textContent":16871},". [",{"type":1444,"nodeName":1452,"attributes":16873,"children":16874},{"href":1485},[16875],{"type":1449,"textContent":1488},{"type":1449,"textContent":16877},"]\n\n",{"type":1444,"nodeName":1461,"attributes":16879,"children":16880},{"class":5964},[16881,16885,16887],{"type":1444,"nodeName":1452,"attributes":16882,"children":16883},{"class":5220,"id":1429,"href":5168},[16884],{"type":1449,"textContent":5171},{"type":1449,"textContent":16886}," Changes from ",{"type":1444,"nodeName":1452,"attributes":16888,"children":16889},{"href":1454},[16890],{"type":1449,"textContent":1480},{"type":1449,"textContent":16892},"\n\n   This specification has been carefully audited to correct and\n   disambiguate key word usage; ",{"type":1444,"nodeName":1452,"attributes":16894,"children":16895},{"href":1454},[16896],{"type":1449,"textContent":1480},{"type":1449,"textContent":16898}," had many problems in respect to\n   the conventions laid out in ",{"type":1444,"nodeName":1452,"attributes":16900,"children":16901},{"href":5368},[16902],{"type":1449,"textContent":5371},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":16905,"children":16906},{"href":5375},[16907],{"type":1449,"textContent":2038},{"type":1449,"textContent":16909},"].\n\n   Clarified which error code should be used for inbound server failures\n   (e.g. DNS failures). (",{"type":1444,"nodeName":1452,"attributes":16911,"children":16912},{"href":3231},[16913],{"type":1449,"textContent":8279},{"type":1449,"textContent":16915},").\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":16917,"children":16918},{"class":1493},[16919],{"type":1449,"textContent":16920},"Fielding, et al.            Standards Track                   [Page 172]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":16923,"children":16924},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":16926,"children":16927},{"class":1506},[16928,16932,16933,16941,16943,16947,16949,16953,16955,16959,16961,16966,16968,16972,16974,16979,16981,16985,16987,16991,16992,16996,16997,17001,17003,17007,17009,17013,17015,17019,17020,17024,17026],{"type":1444,"nodeName":1461,"attributes":16929,"children":16931},{"id":16930},"page-173",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":16934,"children":16935},{"class":1493},[16936,16940],{"type":1444,"nodeName":1452,"attributes":16937,"children":16938},{"href":1518},[16939],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":16942},"\n\n\n   CREATE had a race that required an Etag be sent when a resource is\n   first created. (",{"type":1444,"nodeName":1452,"attributes":16944,"children":16945},{"href":2674},[16946],{"type":1449,"textContent":8007},{"type":1449,"textContent":16948},").\n\n   Content-Base was deleted from the specification: it was not\n   implemented widely, and there is no simple, safe way to introduce it\n   without a robust extension mechanism. In addition, it is used in a\n   similar, but not identical fashion in MHTML [",{"type":1444,"nodeName":1452,"attributes":16950,"children":16951},{"href":16625},[16952],{"type":1449,"textContent":2329},{"type":1449,"textContent":16954},"].\n\n   Transfer-coding and message lengths all interact in ways that\n   required fixing exactly when chunked encoding is used (to allow for\n   transfer encoding that may not be self delimiting); it was important\n   to straighten out exactly how message lengths are computed. (Sections\n   3.6, 4.4, 7.2.2, 13.5.2, 14.13, 14.16)\n\n   A content-coding of \"identity\" was introduced, to solve problems\n   discovered in caching. (",{"type":1444,"nodeName":1452,"attributes":16956,"children":16957},{"href":1798},[16958],{"type":1449,"textContent":6587},{"type":1449,"textContent":16960},")\n\n   Quality Values of zero should indicate that \"I don't want something\"\n   to allow clients to refuse a representation. (",{"type":1444,"nodeName":1452,"attributes":16962,"children":16963},{"href":1901},[16964],{"type":1449,"textContent":16965},"Section 3.9",{"type":1449,"textContent":16967},")\n\n   The use and interpretation of HTTP version numbers has been clarified\n   by ",{"type":1444,"nodeName":1452,"attributes":16969,"children":16970},{"href":5844},[16971],{"type":1449,"textContent":5847},{"type":1449,"textContent":16973},". Require proxies to upgrade requests to highest protocol\n   version they support to deal with problems discovered in HTTP\u002F1.0\n   implementations (",{"type":1444,"nodeName":1452,"attributes":16975,"children":16976},{"href":1658},[16977],{"type":1449,"textContent":16978},"Section 3.1",{"type":1449,"textContent":16980},")\n\n   Charset wildcarding is introduced to avoid explosion of character set\n   names in accept headers. (",{"type":1444,"nodeName":1452,"attributes":16982,"children":16983},{"href":3850},[16984],{"type":1449,"textContent":7735},{"type":1449,"textContent":16986},")\n\n   A case was missed in the Cache-Control model of HTTP\u002F1.1; s-maxage\n   was introduced to add this missing case. (Sections ",{"type":1444,"nodeName":1452,"attributes":16988,"children":16989},{"href":3625},[16990],{"type":1449,"textContent":3628},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":16993,"children":16994},{"href":3936},[16995],{"type":1449,"textContent":3939},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":16998,"children":16999},{"href":3951},[17000],{"type":1449,"textContent":3954},{"type":1449,"textContent":17002},",\n   14.9.3)\n\n   The Cache-Control: max-age directive was not properly defined for\n   responses. (",{"type":1444,"nodeName":1452,"attributes":17004,"children":17005},{"href":3996},[17006],{"type":1449,"textContent":12500},{"type":1449,"textContent":17008},")\n\n   There are situations where a server (especially a proxy) does not\n   know the full length of a response but is capable of serving a\n   byterange request. We therefore need a mechanism to allow byteranges\n   with a content-range not indicating the full length of the message.\n   (",{"type":1444,"nodeName":1452,"attributes":17010,"children":17011},{"href":4144},[17012],{"type":1449,"textContent":8457},{"type":1449,"textContent":17014},")\n\n   Range request responses would become very verbose if all meta-data\n   were always returned; by allowing the server to only send needed\n   headers in a 206 response, this problem can be avoided. (",{"type":1444,"nodeName":1452,"attributes":17016,"children":17017},{"href":2743},[17018],{"type":1449,"textContent":15126},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":17021,"children":17022},{"href":2743},[17023],{"type":1449,"textContent":2746},{"type":1449,"textContent":17025},", 13.5.3, and 14.27)\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":17027,"children":17028},{"class":1493},[17029],{"type":1449,"textContent":17030},"Fielding, et al.            Standards Track                   [Page 173]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":17033,"children":17034},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":17036,"children":17037},{"class":1506},[17038,17042,17043,17051,17053,17057,17059,17063,17064,17068,17070,17075,17077,17081,17083,17088,17090],{"type":1444,"nodeName":1461,"attributes":17039,"children":17041},{"id":17040},"page-174",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":17044,"children":17045},{"class":1493},[17046,17050],{"type":1444,"nodeName":1452,"attributes":17047,"children":17048},{"href":1518},[17049],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":17052},"\n\n\n   Fix problem with unsatisfiable range requests; there are two cases:\n   syntactic problems, and range doesn't exist in the document. The 416\n   status code was needed to resolve this ambiguity needed to indicate\n   an error for a byte range request that falls outside of the actual\n   contents of a document. (",{"type":1444,"nodeName":1452,"attributes":17054,"children":17055},{"href":3138},[17056],{"type":1449,"textContent":8237},{"type":1449,"textContent":17058},", 14.16)\n\n   Rewrite of message transmission requirements to make it much harder\n   for implementors to get it wrong, as the consequences of errors here\n   can have significant impact on the Internet, and to deal with the\n   following problems:\n\n      1. Changing \"HTTP\u002F1.1 or later\" to \"HTTP\u002F1.1\", in contexts where\n         this was incorrectly placing a requirement on the behavior of\n         an implementation of a future version of HTTP\u002F1.x\n\n      2. Made it clear that user-agents should retry requests, not\n         \"clients\" in general.\n\n      3. Converted requirements for clients to ignore unexpected 100\n         (Continue) responses, and for proxies to forward 100 responses,\n         into a general requirement for 1xx responses.\n\n      4. Modified some TCP-specific language, to make it clearer that\n         non-TCP transports are possible for HTTP.\n\n      5. Require that the origin server MUST NOT wait for the request\n         body before it sends a required 100 (Continue) response.\n\n      6. Allow, rather than require, a server to omit 100 (Continue) if\n         it has already seen some of the request body.\n\n      7. Allow servers to defend against denial-of-service attacks and\n         broken clients.\n\n   This change adds the Expect header and 417 status code. The message\n   transmission requirements fixes are in sections ",{"type":1444,"nodeName":1452,"attributes":17060,"children":17061},{"href":2361},[17062],{"type":1449,"textContent":2364},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":17065,"children":17066},{"href":3151},[17067],{"type":1449,"textContent":3154},{"type":1449,"textContent":17069},",\n   8.1.2.2, 13.11, and 14.20.\n\n   Proxies should be able to add Content-Length when appropriate.\n   (",{"type":1444,"nodeName":1452,"attributes":17071,"children":17072},{"href":3668},[17073],{"type":1449,"textContent":17074},"Section 13.5.2",{"type":1449,"textContent":17076},")\n\n   Clean up confusion between 403 and 404 responses. (",{"type":1444,"nodeName":1452,"attributes":17078,"children":17079},{"href":2963},[17080],{"type":1449,"textContent":8119},{"type":1449,"textContent":17082},",\n   10.4.5, and 10.4.11)\n\n   Warnings could be cached incorrectly, or not updated appropriately.\n   (",{"type":1444,"nodeName":1452,"attributes":17084,"children":17085},{"href":3357},[17086],{"type":1449,"textContent":17087},"Section 13.1.2",{"type":1449,"textContent":17089},", 13.2.4, 13.5.2, 13.5.3, 14.9.3, and 14.46) Warning\n   also needed to be a general header, as PUT or other methods may have\n   need for it in requests.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":17091,"children":17092},{"class":1493},[17093],{"type":1449,"textContent":17094},"Fielding, et al.            Standards Track                   [Page 174]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":17097,"children":17098},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":17100,"children":17101},{"class":1506},[17102,17106,17107,17115,17117,17121,17123,17128,17130,17134,17135,17139,17141,17145,17146,17150,17151,17160,17162],{"type":1444,"nodeName":1461,"attributes":17103,"children":17105},{"id":17104},"page-175",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":17108,"children":17109},{"class":1493},[17110,17114],{"type":1444,"nodeName":1452,"attributes":17111,"children":17112},{"href":1518},[17113],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":17116},"\n\n\n   Transfer-coding had significant problems, particularly with\n   interactions with chunked encoding. The solution is that transfer-\n   codings become as full fledged as content-codings. This involves\n   adding an IANA registry for transfer-codings (separate from content\n   codings), a new header field (TE) and enabling trailer headers in the\n   future. Transfer encoding is a major performance benefit, so it was\n   worth fixing [",{"type":1444,"nodeName":1452,"attributes":17118,"children":17119},{"href":8632},[17120],{"type":1449,"textContent":2137},{"type":1449,"textContent":17122},"]. TE also solves another, obscure, downward\n   interoperability problem that could have occurred due to interactions\n   between authentication trailers, chunked encoding and HTTP\u002F1.0\n   clients.(",{"type":1444,"nodeName":1452,"attributes":17124,"children":17125},{"href":1813},[17126],{"type":1449,"textContent":17127},"Section 3.6",{"type":1449,"textContent":17129},", 3.6.1, and 14.39)\n\n   The PATCH, LINK, UNLINK methods were defined but not commonly\n   implemented in previous versions of this specification. See ",{"type":1444,"nodeName":1452,"attributes":17131,"children":17132},{"href":1454},[17133],{"type":1449,"textContent":1480},{"type":1449,"textContent":5774},{"type":1444,"nodeName":1452,"attributes":17136,"children":17137},{"href":1485},[17138],{"type":1449,"textContent":1488},{"type":1449,"textContent":17140},"].\n\n   The Alternates, Content-Version, Derived-From, Link, URI, Public and\n   Content-Base header fields were defined in previous versions of this\n   specification, but not commonly implemented. See ",{"type":1444,"nodeName":1452,"attributes":17142,"children":17143},{"href":1454},[17144],{"type":1449,"textContent":1480},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":17147,"children":17148},{"href":1485},[17149],{"type":1449,"textContent":1488},{"type":1449,"textContent":6352},{"type":1444,"nodeName":1461,"attributes":17152,"children":17153},{"class":5216},[17154,17158],{"type":1444,"nodeName":1452,"attributes":17155,"children":17156},{"class":5220,"id":1434,"href":5187},[17157],{"type":1449,"textContent":1725},{"type":1449,"textContent":17159}," Index",{"type":1449,"textContent":17161},"\n\n   Please see the PostScript version of this RFC for the INDEX.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":17163,"children":17164},{"class":1493},[17165],{"type":1449,"textContent":17166},"Fielding, et al.            Standards Track                   [Page 175]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":17169,"children":17170},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":17172,"children":17173},{"class":1506},[17174,17178,17179,17187,17188,17197],{"type":1444,"nodeName":1461,"attributes":17175,"children":17177},{"id":17176},"page-176",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":17180,"children":17181},{"class":1493},[17182,17186],{"type":1444,"nodeName":1452,"attributes":17183,"children":17184},{"href":1518},[17185],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":17189,"children":17190},{"class":5216},[17191,17195],{"type":1444,"nodeName":1452,"attributes":17192,"children":17193},{"class":5220,"id":1439,"href":5201},[17194],{"type":1449,"textContent":1766},{"type":1449,"textContent":17196},".  Full Copyright Statement",{"type":1449,"textContent":17198},"\n\n   Copyright (C) The Internet Society (1999).  All Rights Reserved.\n\n   This document and translations of it may be copied and furnished to\n   others, and derivative works that comment on or otherwise explain it\n   or assist in its implementation may be prepared, copied, published\n   and distributed, in whole or in part, without restriction of any\n   kind, provided that the above copyright notice and this paragraph are\n   included on all such copies and derivative works.  However, this\n   document itself may not be modified in any way, such as by removing\n   the copyright notice or references to the Internet Society or other\n   Internet organizations, except as needed for the purpose of\n   developing Internet standards in which case the procedures for\n   copyrights defined in the Internet Standards process must be\n   followed, or as required to translate it into languages other than\n   English.\n\n   The limited permissions granted above are perpetual and will not be\n   revoked by the Internet Society or its successors or assigns.\n\n   This document and the information contained herein is provided on an\n   \"AS IS\" basis and THE INTERNET SOCIETY AND THE INTERNET ENGINEERING\n   TASK FORCE DISCLAIMS ALL WARRANTIES, EXPRESS OR IMPLIED, INCLUDING\n   BUT NOT LIMITED TO ANY WARRANTY THAT THE USE OF THE INFORMATION\n   HEREIN WILL NOT INFRINGE ANY RIGHTS OR ANY IMPLIED WARRANTIES OF\n   MERCHANTABILITY OR FITNESS FOR A PARTICULAR PURPOSE.\n\nAcknowledgement\n\n   Funding for the RFC Editor function is currently provided by the\n   Internet Society.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nFielding, et al.            Standards Track                   [Page 176]\n",{"type":1449,"textContent":1498},{"max":17201},72,[17203,17212,17219,17223,17229,17233,17238,17244,17250,17257,17263,17269,17275,17281,17287,17293,17299],{"errata_id":17204,"doc-id":17205,"errata_status_code":17206,"errata_type_code":17207,"section":1816,"orig_text":17208,"correct_text":24,"notes":17209,"submit_date":17210,"update_date":17211},"408","RFC2616","Verified","Technical","   The Internet Assigned Numbers Authority (IANA) acts as a registry for\n   transfer-coding value tokens. Initially, the registry contains the\n   following tokens: \"chunked\" (section 3.6.1), \"identity\" (section\n   3.6.2), \"gzip\" (section 3.5), \"compress\" (section 3.5), and\n   \"deflate\" (section 3.5).","There is no section 3.6.2; there is no such thing as Transfer-Coding:\nidentity in the RFC 2616 specification (note that there would not be\nquotes  around \"identity\" in the actual header!).","2001-10-08","2019-09-10 16:09:03",{"errata_id":17213,"doc-id":17205,"errata_status_code":17206,"errata_type_code":17214,"section":3868,"orig_text":17215,"correct_text":17216,"notes":17217,"submit_date":17218,"update_date":17211},"411","Editorial","The Accept-Encoding request-header field is similar to Accept, but\r\nrestricts the content-codings (section 3.5) that are acceptable in\r\nthe response.\r\n\r\n       Accept-Encoding  = \"Accept-Encoding\" \":\"\r\n\r\n                          1#( codings [ \";\" \"q\" \"=\" qvalue ] )\r\n       codings          = ( content-coding | \"*\" )\r\n\r\n Examples of its use are:\r\n\r\n       Accept-Encoding: compress, gzip\r\n       Accept-Encoding:\r\n       Accept-Encoding: *\r\n       Accept-Encoding: compress;q=0.5, gzip;q=1.0\r\n       Accept-Encoding: gzip;q=1.0, identity; q=0.5, *;q=0","The Accept-Encoding request-header field is similar to Accept, but\r\nrestricts the content-codings (section 3.5) that are acceptable in\r\nthe response.\r\n\r\n       Accept-Encoding  = \"Accept-Encoding\" \":\"\r\n\r\n                          1#( codings [ \";\" \"q\" \"=\" qvalue ] )\r\n       codings          = ( content-coding | \"*\" )\r\n\r\n Examples of its use are:\r\n\r\n       Accept-Encoding: compress, gzip\r\n       Accept-Encoding: *\r\n       Accept-Encoding: compress;q=0.5, gzip;q=1.0\r\n       Accept-Encoding: gzip;q=1.0, identity; q=0.5, *;q=0","As you can see, Accept-Encoding has to consist of 1 or more ( codings [ \";\"\r\n\"q\" \"=\" qvalue ] ).  So you can't just leave the value of \"Accept-Encoding:\"\r\nempty.  The second example is, therefore, incorrect.\r\n\r\n------------------------------------------------\r\nAlexey: This issue was fixed in HTTPBIS WG, see \u003Chttp:\u002F\u002Ftrac.tools.ietf.org\u002Fwg\u002Fhttpbis\u002Ftrac\u002Fticket\u002F25>","2006-10-31",{"errata_id":17220,"doc-id":17205,"errata_status_code":17206,"errata_type_code":17207,"section":24,"orig_text":24,"correct_text":24,"notes":17221,"submit_date":17222,"update_date":17211},"412","From Scott Lawrence:\r\nAll known errata for this HTTP RFC will be found at: \r\nhttp:\u002F\u002Fpurl.org\u002FNET\u002Fhttp-errata and \r\nhttp:\u002F\u002Fwww.w3.org\u002FProtocols\u002FHTTP\u002F1.1\u002Frfc2616bis\u002Fissues\u002F\r\n\r\n\r\n","2001-01-05",{"errata_id":17224,"doc-id":17205,"errata_status_code":17206,"errata_type_code":17214,"section":2016,"orig_text":17225,"correct_text":17226,"notes":17227,"submit_date":17228,"update_date":17211},"652","4.If the message uses the media type \"multipart\u002Fbyteranges\", and the\r\n  ransfer-length is not otherwise specified, then this self-\r\n  elimiting media type defines the transfer-length. This media type\r\n  UST NOT be used unless the sender knows that the recipient can arse\r\n  it; the presence in a request of a Range header with ultiple byte-\r\n  range specifiers from a 1.1 client implies that the lient can parse\r\n  multipart\u002Fbyteranges responses.","4.If the message uses the media type \"multipart\u002Fbyteranges\", and the\r\n  Transfer-length is not otherwise specified, then this self-\r\n  delimiting media type defines the transfer-length. This media type\r\n  MUST NOT be used unless the sender knows that the recipient can parse\r\n  it; the presence in a request of a Range header with multiple byte-\r\n  range specifiers from a 1.1 client implies that the client can parse\r\n  multipart\u002Fbyteranges responses.","Missing the first character of 6 words.","2000-12-23",{"errata_id":17230,"doc-id":17205,"errata_status_code":17206,"errata_type_code":17214,"section":1575,"orig_text":17231,"correct_text":17232,"notes":24,"submit_date":17228,"update_date":17211},"653","Each of these representations is termed a `varriant'.","Each of these representations is termed a `variant'.\r\n\r\n",{"errata_id":17234,"doc-id":17205,"errata_status_code":17235,"errata_type_code":17214,"section":2016,"orig_text":17236,"correct_text":17237,"notes":24,"submit_date":17218,"update_date":17211},"892","Held for Document Update","4.  If the message uses the media type \"multipart\u002Fbyteranges\", and the\r\n     ransfer-length is not otherwise specified, then this self-\r\n     elimiting media type defines the transfer-length.","4.  If the message uses the media type \"multipart\u002Fbyteranges\", and the\r\n     transfer-length is not otherwise specified, then this self-\r\n     elimiting media type defines the transfer-length.\r\n",{"errata_id":17239,"doc-id":17205,"errata_status_code":17235,"errata_type_code":17214,"section":2016,"orig_text":17240,"correct_text":17241,"notes":17242,"submit_date":17243,"update_date":17211},"1619","   4.If the message uses the media type \"multipart\u002Fbyteranges\", and the\r\n     ransfer-length is not otherwise specified, then this self-\r\n     elimiting media type defines the transfer-length. This media type\r\n     UST NOT be used unless the sender knows that the recipient can arse\r\n     it; the presence in a request of a Range header with ultiple byte-\r\n     range specifiers from a 1.1 client implies that the lient can parse\r\n     multipart\u002Fbyteranges responses.","   4.If the message uses the media type \"multipart\u002Fbyteranges\", and the\r\n     transfer-length is not otherwise specified, then this self-\r\n     delimiting media type defines the transfer-length. This media type\r\n     MUST NOT be used unless the sender knows that the recipient can parse\r\n     it; the presence in a request of a Range header with multiple byte-\r\n     range specifiers from a 1.1 client implies that the client can parse\r\n     multipart\u002Fbyteranges responses.","> \"ransfer-length\" should be \"transfer-length\"\r\n> \"self-elimiting\" should be \"self-delimiting\";\r\n> \"UST\"should be \"MUST\";\r\n> \"arse\"should be \"parse\";\r\n> \"ultiple\"should be \"multiple\";\r\n> \"lient\"should be \"client\";","2008-11-25",{"errata_id":17245,"doc-id":17205,"errata_status_code":17235,"errata_type_code":17214,"section":1816,"orig_text":17246,"correct_text":17247,"notes":17248,"submit_date":17249,"update_date":17211},"1483","   The Internet Assigned Numbers Authority (IANA) acts as a registry for\r\n   transfer-coding value tokens. Initially, the registry contains the\r\n   following tokens: \"chunked\" (section 3.6.1), \"identity\" (section\r\n   3.6.2), \"gzip\" (section 3.5), \"compress\" (section 3.5), and \"deflate\"\r\n   (section 3.5).\r\n","   The Internet Assigned Numbers Authority (IANA) acts as a registry for\r\n   transfer-coding value tokens. Initially, the registry contains the\r\n   following tokens: \"chunked\" (section 3.6.1), \"identity\" (section\r\n   3.5), \"gzip\" (section 3.5), \"compress\" (section 3.5), and \"deflate\"\r\n   (section 3.5).\r\n","The tokens for Content-Codings are defined in section 3.5. These include the identity token.","2008-08-06",{"errata_id":17251,"doc-id":17205,"errata_status_code":17252,"errata_type_code":17207,"section":4504,"orig_text":17253,"correct_text":17254,"notes":17255,"submit_date":17256,"update_date":17211},"2301","Rejected","   The Referer[sic] request-header field allows the client to specify,\r\n   for the server's benefit, the address (URI) of the resource from\r\n   which the Request-URI was obtained (the \"referrer\", although the\r\n   header field is misspelled.) The Referer request-header allows a\r\n   server to generate lists of back-links to resources for interest,\r\n   logging, optimized caching, etc. It also allows obsolete or mistyped\r\n   links to be traced for maintenance. The Referer field MUST NOT be\r\n   sent if the Request-URI was obtained from a source that does not have\r\n   its own URI, such as input from the user keyboard.","   The Referer[sic] request-header field allows the client to specify,\r\n   for the server's benefit, the address (URI) of the resource from\r\n\r\n   whose message-body the Request-URI was obtained (the \"referrer\", although the\r\n   header field is misspelled.) The Referer request-header allows a\r\n   server to generate lists of back-links to resources for interest,\r\n   logging, optimized caching, etc. It also allows obsolete or mistyped\r\n   links to be traced for maintenance. The Referer field MUST NOT be\r\n   sent if the Request-URI was obtained from a source that does not have\r\n   its own URI, such as input from the user keyboard.","The text should mention that the referrer is specified when the URI was obtained from the message-body of the Request-URI.\r\n\r\nFor instance, when the user agent receives a 302 response for a Request-URI, it does not specify the original Request-URI in the referrer header for the subsequent request - even though the (redirect) URI \"was obtained\" from the (header of the) 302 response for the original Request-URI.\r\n\r\nRoy T. Fielding replied:\r\nI think this should be rejected.  The referrer is the redirect.\r\nUser agents should be sending the redirecting URI in Referer,\r\nor sending nothing in Referer.\r\n\r\nIn any case, see the Link header field.  It is certainly possible\r\nto be referred by something in the header fields, so saying that it\r\nis in the message-body would be incorrect.\n --VERIFIER NOTES-- \nAs per the reply from Roy T. Fielding.","2010-06-14",{"errata_id":17258,"doc-id":17205,"errata_status_code":17252,"errata_type_code":17207,"section":2088,"orig_text":17259,"correct_text":17260,"notes":17261,"submit_date":17262,"update_date":17211},"3056","Request-URI    = \"*\" | absoluteURI | abs_path | authority","Request-URI    = \"*\" | absoluteURI | abs_path [ \"?\" query ] | authority\r\n","so that \"\u002Fpath?query\" is a valid Request-URI as it should.\r\n\r\nbecause it is not the case with RFC 3986\r\n(obsoleting RFC 2396 which has the same problem actually):\r\n\r\nabsoluteURI   = absolute-URI\r\nabs_path      = path-absolute\r\n\r\nabsolute-URI  = scheme \":\" hier-part [ \"?\" query ]\r\npath-absolute = \"\u002F\" [ segment-nz *( \"\u002F\" segment ) ]\r\nsegment-nz    = 1*pchar\r\nsegment       = *pchar\r\npchar         = unreserved \u002F pct-encoded \u002F sub-delims \u002F \":\" \u002F \"@\"\r\nunreserved    = ALPHA \u002F DIGIT \u002F \"-\" \u002F \".\" \u002F \"_\" \u002F \"~\"\r\npct-encoded   = \"%\" HEXDIG HEXDIG\r\nsub-delims    = \"!\" \u002F \"$\" \u002F \"&\" \u002F \"'\" \u002F \"(\" \u002F \")\" \u002F \"*\" \u002F \"+\" \u002F \",\" \u002F \";\" \u002F \"=\"\n --VERIFIER NOTES-- \nThis issue has been fixed in the revisions to RFC 2616, see http:\u002F\u002Ftrac.tools.ietf.org\u002Fwg\u002Fhttpbis\u002Ftrac\u002Fchangeset\u002F76\r\n","2011-12-20",{"errata_id":17264,"doc-id":17205,"errata_status_code":17252,"errata_type_code":17214,"section":1801,"orig_text":17265,"correct_text":17266,"notes":17267,"submit_date":17268,"update_date":17211},"2645","Use of program names for the identification of encoding formats \r\nis not desirable and is discouraged for future encodings. Their \r\nuse here is representative of historical practice, not good \r\ndesign. For compatibility with previous implementations of HTTP, \r\napplications SHOULD consider \"x-gzip\" and \"x-compress\" to be \r\nequivalent to \"gzip\" and \"compress\" respectively.\r\n","Use of program names for the identification of encoding formats \r\nis not desirable and is discouraged for future encodings. Their \r\nuse here is representative of historical practice, not good \r\ndesign. For compatibility with future implementations of HTTP, \r\napplications SHOULD consider \"x-gzip\" and \"x-compress\" to be \r\nequivalent to \"gzip\" and \"compress\" respectively.\r\n","\"For compatibility with previous implementations of HTTP\", \r\nhere, 'previous' should be replaced by 'future'.\n --VERIFIER NOTES-- \nComment by Peter Saint-Andre:\r\n\r\n   This erratum is incorrect -- the text is clearly about\r\n   backward compatibility, not forward compatibility. The\r\n   original poster can comment in the HTTPBIS WG about this\r\n   matter since draft-ietf-httpbis-p1-messaging has very \r\n   similar text.\r\n","2010-11-27",{"errata_id":17270,"doc-id":17205,"errata_status_code":17252,"errata_type_code":17214,"section":4102,"orig_text":17271,"correct_text":17272,"notes":17273,"submit_date":17274,"update_date":17211},"2806","Applications SHOULD use this field to indicate the transfer-length of\r\n   the message-body, unless this is prohibited by the rules in \u003Ca href=\"#section-   \">section\u003C\u002Fa>\r\n   \u003Ca href=\"#section-   \">4.4\u003C\u002Fa>.","Applications SHOULD use this field to indicate the transfer-length of\r\n   the message-body, unless this is prohibited by the rules in \r\n\u003Ca href=\"#section-4.4\">section 4.4\u003C\u002Fa>.","This errata refers to the linkified version of the RFC at:\r\n\r\nhttp:\u002F\u002Ftools.ietf.org\u002Fhtml\u002Frfc2616\r\n\r\nNote that the original and corrected text above both contain HTML tags. In case the text doesn't survive the form submission, just to describe the problem, the link in the text shown, an internal anchor link that should point to #section-4.4, is broken because the number 4.4 is missing at the end of the anchor inside the href quotes.\r\n\r\n--- VERIFIER NOTES ---\r\nThis report has been rejected because it is regarding a link in the HTML version of the RFC on tools.ietf.org. The report has been directed to webmaster@tools.ietf.org. \r\n\r\nErrata are for the RFCs as available from rfc-editor.org. ","2011-05-12",{"errata_id":17276,"doc-id":17205,"errata_status_code":17252,"errata_type_code":17207,"section":1689,"orig_text":17277,"correct_text":17278,"notes":17279,"submit_date":17280,"update_date":17211},"2998","   For definitive information on\r\n   URL syntax and semantics, see \"Uniform Resource Identifiers (URI):\r\n   Generic Syntax and Semantics,\" RFC 2396 [42] (which replaces RFCs\r\n   1738 [4] and RFC 1808 [11]).","   For definitive information on\r\n   URL syntax and semantics, see \"Uniform Resource Identifiers (URI):\r\n   Generic Syntax and Semantics,\" RFC 3986 [\u003Cref>] (which updates RFCs\r\n   1738 [4] and replaces RFC 1808 [11] and RFC 2396 [42]).\r\n","\u003Cref> should be added\n --VERIFIER NOTES-- \nThe reader can follow the chain of document updates from RFC 2396 to RFC 3986, which is why we do not modify published RFCs to track document updates for referenced specifications. In any case, the updated HTTP RFCs (being produced by the HTTPBIS WG) will contain the appropriate references. ","2011-10-15",{"errata_id":17282,"doc-id":17205,"errata_status_code":17235,"errata_type_code":17214,"section":1575,"orig_text":17283,"correct_text":17284,"notes":17285,"submit_date":17286,"update_date":17211},"3206","   variant\r\n      A resource may have one, or more than one, representation(s)\r\n      associated with it at any given instant. Each of these\r\n      representations is termed a `varriant'.  Use of the term `variant'\r\n      does not necessarily imply that the resource is subject to content\r\n      negotiation.\r\n\r\n","   variant\r\n      A resource may have one, or more than one, representation(s)\r\n      associated with it at any given instant. Each of these\r\n      representations is termed a `variant'.  Use of the term `variant'\r\n      does not necessarily imply that the resource is subject to content\r\n      negotiation.\r\n\r\n","\"varriant\" Is this misspelling?","2012-04-27",{"errata_id":17288,"doc-id":17205,"errata_status_code":17235,"errata_type_code":17207,"section":1631,"orig_text":17289,"correct_text":17290,"notes":17291,"submit_date":17292,"update_date":17211},"3407","   Comments can be included in some HTTP header fields by surrounding\r\n   the comment text with parentheses. Comments are only allowed in\r\n   fields containing \"comment\" as part of their field value definition.\r\n   In all other fields, parentheses are considered part of the field\r\n   value.\r\n\r\n       comment        = \"(\" *( ctext | quoted-pair | comment ) \")\"\r\n       ctext          = \u003Cany TEXT excluding \"(\" and \")\">\r\n\r\n   A string of text is parsed as a single word if it is quoted using\r\n   double-quote marks.\r\n\r\n       quoted-string  = ( \u003C\"> *(qdtext | quoted-pair ) \u003C\"> )\r\n       qdtext         = \u003Cany TEXT except \u003C\">>\r\n\r\n   The backslash character (\"\\\") MAY be used as a single-character\r\n   quoting mechanism only within quoted-string and comment constructs.\r\n\r\n       quoted-pair    = \"\\\" CHAR","   Comments can be included in some HTTP header fields by surrounding\r\n   the comment text with parentheses. Comments are only allowed in\r\n   fields containing \"comment\" as part of their field value definition.\r\n   In all other fields, parentheses are considered part of the field\r\n   value.\r\n\r\n       comment        = \"(\" *( ctext | quoted-pair | comment ) \")\"\r\n       ctext          = \u003Cany TEXT excluding \"\\\", \"(\" and \")\">\r\n\r\n   A string of text is parsed as a single word if it is quoted using\r\n   double-quote marks.\r\n\r\n       quoted-string  = ( \u003C\"> *(qdtext | quoted-pair ) \u003C\"> )\r\n       qdtext         = \u003Cany TEXT excluding \"\\\" and \u003C\">>\r\n\r\n   The backslash character (\"\\\") MAY be used as a single-character\r\n   quoting mechanism only within quoted-string and comment constructs.\r\n\r\n       quoted-pair    = \"\\\" CHAR","Allowing \"\\\" in qdtext and ctext creates ambiguous semantics.\r\n\r\nConsider:\r\n    \" \\\" (\\ was a qdtext, so string has terminated)\r\n    \" \\\"\"(\\ is part of the quoted pair \\\") \r\n    \" \\ \" (Is this an escaped space or a bare backslash?)\r\n    \" \\\\\"\" (first \\ is qdtext and second \\ is part of quoted-pair \\\")\r\n\r\nAnalogous examples would work for ctext and comment, as well.\r\n\r\nIt looks to me as though the intended meaning was for the implementer to consider \"\\\" part of a quoted-pair whenever possible.  It's always possible, so the obvious fix would be to exclude it from ctext and qdtext, and use \\\\ whenever the user desires a textual backslash.\r\n\r\n--- VERIFIER NOTES ---\r\nThis issue is already being dealt with in the HTTP 1.1 work in the HTTPBIS working group.  The 2616 updates, which will be published soon, will include fixes for this.","2012-11-14",{"errata_id":17294,"doc-id":17205,"errata_status_code":17206,"errata_type_code":17214,"section":3658,"orig_text":17295,"correct_text":17296,"notes":17297,"submit_date":17298,"update_date":17211},"4522"," The following HTTP\u002F1.1 headers are hop-by-hop headers:\r\n\r\n      - Connection\r\n      - Keep-Alive\r\n      - Proxy-Authenticate\r\n      - Proxy-Authorization\r\n      - TE\r\n      - Trailers\r\n      - Transfer-Encoding\r\n      - Upgrade\r\n"," The following HTTP\u002F1.1 headers are hop-by-hop headers:\r\n\r\n      - Connection\r\n      - Keep-Alive\r\n      - Proxy-Authenticate\r\n      - Proxy-Authorization\r\n      - TE\r\n      - Trailer\r\n      - Transfer-Encoding\r\n      - Upgrade\r\n","Trailers (with a s) does not seem to a header field, just a keyword for TE.\r\nI think that Trailer (without a s) is expected here.\r\n\r\nAFAIK, RFC 7230 does not have such an explicit list and is not concerned.","2015-11-03",{"errata_id":17300,"doc-id":17205,"errata_status_code":17206,"errata_type_code":17214,"section":162,"orig_text":17301,"correct_text":17302,"notes":17303,"submit_date":17304,"update_date":17305},"8514","variant\r\n      A resource may have one, or more than one, representation(s)\r\n      associated with it at any given instant. Each of these\r\n      representations is termed a `varriant'.  Use of the term `variant'\r\n      does not necessarily imply that the resource is subject to content\r\n      negotiation.","variant\r\n      A resource may have one, or more than one, representation(s)\r\n      associated with it at any given instant. Each of these\r\n      representations is termed a 'variant'.  Use of the term 'variant'\r\n      does not necessarily imply that the resource is subject to content\r\n      negotiation.","`varriant' --> 'variant'","2025-07-16","2025-07-28 15:16:03","2026-09-30T04:15:14.063Z",["Reactive",17308],{"$scolor-mode":17309},{"preference":17310,"value":17310,"unknown":17311,"forced":20},"system",true,["Set"],["ShallowReactive",17314],{"info-buckethtmldocument-rfc2616":-1},["Reactive",17316],{"auth":17317,"notifications":17323,"uiSettings":17329,"reefSurveys":17342,"reef":17349,"hasTouch":17357},{"hasCheckedAuth":17318,"isAuthenticated":17320,"user":17321},["EmptyRef",17319],"false",["EmptyRef",17319],["EmptyRef",17322],"_",{"queue":17324,"dismissedIds":17327},["Ref",17325],["Reactive",17326],[],["skipHydrate",17328],1,{"isUiSettingsModalOpen":17330,"obsoletedByMode":17331,"updatedByMode":17333,"disableRFCLinkPreview":17334,"textScale":17335,"subjectDensity":17337,"subjectDocumentDensity":17339,"wordBreakMode":17340},["EmptyRef",17319],["Ref",17332],"compact",["Ref",17332],["EmptyRef",17319],["Ref",17336],1.5,["Ref",17338],"full",["Ref",17338],["Ref",17341],"wbr",{"surveys":17343,"status":17346,"isSurveysModalOpen":17348},["Ref",17344],["Reactive",17345],[],["Ref",17347],"idle",["EmptyRef",17319],{"userDocuments":17350,"sets":17353,"subject":17356},["Ref",17351],["Reactive",17352],{},["Ref",17354],["Reactive",17355],[],["EmptyRef",17322],{"hasTouch":17358},["EmptyRef",17359],"null"]</script></body></html>