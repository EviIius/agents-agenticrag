ype":1444,"nodeName":1452,"attributes":5152,"children":5154},{"href":5153},"#section-19.6.2",[5155],{"type":1449,"textContent":5156},"19.6.2",{"type":1449,"textContent":5158},"   Compatibility with HTTP\u002F1.0 Persistent Connections ......",{"type":1444,"nodeName":1452,"attributes":5160,"children":5162},{"href":5161},"#page-172",[5163],{"type":1449,"textContent":5164},"172",{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":5167,"children":5169},{"href":5168},"#section-19.6.3",[5170],{"type":1449,"textContent":5171},"19.6.3",{"type":1449,"textContent":5173},"   Changes from ",{"type":1444,"nodeName":1452,"attributes":5175,"children":5176},{"href":1454},[5177],{"type":1449,"textContent":1480},{"type":1449,"textContent":5179}," ...................................",{"type":1444,"nodeName":1452,"attributes":5181,"children":5182},{"href":5161},[5183],{"type":1449,"textContent":5164},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":5186,"children":5188},{"href":5187},"#section-20",[5189],{"type":1449,"textContent":1725},{"type":1449,"textContent":5191},"   Index .......................................................",{"type":1444,"nodeName":1452,"attributes":5193,"children":5195},{"href":5194},"#page-175",[5196],{"type":1449,"textContent":5197},"175",{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":5200,"children":5202},{"href":5201},"#section-21",[5203],{"type":1449,"textContent":1766},{"type":1449,"textContent":5205},"   Full Copyright Statement ....................................",{"type":1444,"nodeName":1452,"attributes":5207,"children":5209},{"href":5208},"#page-176",[5210],{"type":1449,"textContent":5211},"176",{"type":1449,"textContent":5213},"\n\n",{"type":1444,"nodeName":1461,"attributes":5215,"children":5217},{"class":5216},"h2",[5218,5223],{"type":1444,"nodeName":1452,"attributes":5219,"children":5221},{"class":5220,"id":145,"href":1528},"selflink",[5222],{"type":1449,"textContent":1531},{"type":1449,"textContent":5224}," Introduction",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":5227,"children":5229},{"class":5228},"h3",[5230,5234],{"type":1444,"nodeName":1452,"attributes":5231,"children":5232},{"class":5220,"id":151,"href":1544},[5233],{"type":1449,"textContent":1547},{"type":1449,"textContent":5235}," Purpose",{"type":1449,"textContent":5237},"\n\n   The Hypertext Transfer Protocol (HTTP) is an application-level\n   protocol for distributed, collaborative, hypermedia information\n   systems. HTTP has been in use by the World-Wide Web global\n   information initiative since 1990. The first version of HTTP,\n   referred to as HTTP\u002F0.9, was a simple protocol for raw data transfer\n   across the Internet. HTTP\u002F1.0, as defined by ",{"type":1444,"nodeName":1452,"attributes":5239,"children":5241},{"href":5240},"\u002Finfo\u002Frfc1945\u002F",[5242],{"type":1449,"textContent":5243},"RFC 1945",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":5246,"children":5248},{"href":5247},"#ref-6",[5249],{"type":1449,"textContent":2129},{"type":1449,"textContent":5251},"], improved\n   the protocol by allowing messages to be in the format of MIME-like\n   messages, containing metainformation about the data transferred and\n   modifiers on the request\u002Fresponse semantics. However, HTTP\u002F1.0 does\n   not sufficiently take into consideration the effects of hierarchical\n   proxies, caching, the need for persistent connections, or virtual\n   hosts. In addition, the proliferation of incompletely-implemented\n   applications calling themselves \"HTTP\u002F1.0\" has necessitated a\n   protocol version change in order for two communicating applications\n   to determine each other's true capabilities.\n\n   This specification defines the protocol referred to as \"HTTP\u002F1.1\".\n   This protocol includes more stringent requirements than HTTP\u002F1.0 in\n   order to ensure reliable implementation of its features.\n\n   Practical information systems require more functionality than simple\n   retrieval, including search, front-end update, and annotation. HTTP\n   allows an open-ended set of methods and headers that indicate the\n   purpose of a request [",{"type":1444,"nodeName":1452,"attributes":5253,"children":5254},{"href":1470},[5255],{"type":1449,"textContent":1473},{"type":1449,"textContent":5257},"]. It builds on the discipline of reference\n   provided by the Uniform Resource Identifier (URI) [",{"type":1444,"nodeName":1452,"attributes":5259,"children":5261},{"href":5260},"#ref-3",[5262],{"type":1449,"textContent":1646},{"type":1449,"textContent":5264},"], as a location\n   (URL) [",{"type":1444,"nodeName":1452,"attributes":5266,"children":5268},{"href":5267},"#ref-4",[5269],{"type":1449,"textContent":1960},{"type":1449,"textContent":5271},"] or name (URN) [",{"type":1444,"nodeName":1452,"attributes":5273,"children":5275},{"href":5274},"#ref-20",[5276],{"type":1449,"textContent":1725},{"type":1449,"textContent":5278},"], for indicating the resource to which a\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5280,"children":5281},{"class":1493},[5282],{"type":1449,"textContent":5283},"Fielding, et al.            Standards Track                     [Page 7]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5286,"children":5287},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5289,"children":5290},{"class":1506},[5291,5295,5296,5304,5306,5311,5313,5318,5320,5325,5327,5332,5334,5339,5341,5346,5348,5353,5355,5364,5366,5372,5373,5378,5380,5389,5391,5396,5398,5403,5405,5410,5412],{"type":1444,"nodeName":1461,"attributes":5292,"children":5294},{"id":5293},"page-8",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5297,"children":5298},{"class":1493},[5299,5303],{"type":1444,"nodeName":1452,"attributes":5300,"children":5301},{"href":1518},[5302],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5305},"\n\n\n   method is to be applied. Messages are passed in a format similar to\n   that used by Internet mail [",{"type":1444,"nodeName":1452,"attributes":5307,"children":5309},{"href":5308},"#ref-9",[5310],{"type":1449,"textContent":2427},{"type":1449,"textContent":5312},"] as defined by the Multipurpose\n   Internet Mail Extensions (MIME) [",{"type":1444,"nodeName":1452,"attributes":5314,"children":5316},{"href":5315},"#ref-7",[5317],{"type":1449,"textContent":1539},{"type":1449,"textContent":5319},"].\n\n   HTTP is also used as a generic protocol for communication between\n   user agents and proxies\u002Fgateways to other Internet systems, including\n   those supported by the SMTP [",{"type":1444,"nodeName":1452,"attributes":5321,"children":5323},{"href":5322},"#ref-16",[5324],{"type":1449,"textContent":4858},{"type":1449,"textContent":5326},"], NNTP [",{"type":1444,"nodeName":1452,"attributes":5328,"children":5330},{"href":5329},"#ref-13",[5331],{"type":1449,"textContent":3332},{"type":1449,"textContent":5333},"], FTP [",{"type":1444,"nodeName":1452,"attributes":5335,"children":5337},{"href":5336},"#ref-18",[5338],{"type":1449,"textContent":1682},{"type":1449,"textContent":5340},"], Gopher [",{"type":1444,"nodeName":1452,"attributes":5342,"children":5344},{"href":5343},"#ref-2",[5345],{"type":1449,"textContent":1603},{"type":1449,"textContent":5347},"],\n   and WAIS [",{"type":1444,"nodeName":1452,"attributes":5349,"children":5351},{"href":5350},"#ref-10",[5352],{"type":1449,"textContent":2597},{"type":1449,"textContent":5354},"] protocols. In this way, HTTP allows basic hypermedia\n   access to resources available from diverse applications.\n\n",{"type":1444,"nodeName":1461,"attributes":5356,"children":5357},{"class":5228},[5358,5362],{"type":1444,"nodeName":1452,"attributes":5359,"children":5360},{"class":5220,"id":156,"href":1557},[5361],{"type":1449,"textContent":1560},{"type":1449,"textContent":5363}," Requirements",{"type":1449,"textContent":5365},"\n\n   The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\",\n   \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\" in this\n   document are to be interpreted as described in ",{"type":1444,"nodeName":1452,"attributes":5367,"children":5369},{"href":5368},"\u002Finfo\u002Frfc2119\u002F",[5370],{"type":1449,"textContent":5371},"RFC 2119",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":5374,"children":5376},{"href":5375},"#ref-34",[5377],{"type":1449,"textContent":2038},{"type":1449,"textContent":5379},"].\n\n   An implementation is not compliant if it fails to satisfy one or more\n   of the MUST or REQUIRED level requirements for the protocols it\n   implements. An implementation that satisfies all the MUST or REQUIRED\n   level and all the SHOULD level requirements for its protocols is said\n   to be \"unconditionally compliant\"; one that satisfies all the MUST\n   level requirements but not all the SHOULD level requirements for its\n   protocols is said to be \"conditionally compliant.\"\n\n",{"type":1444,"nodeName":1461,"attributes":5381,"children":5382},{"class":5228},[5383,5387],{"type":1444,"nodeName":1452,"attributes":5384,"children":5385},{"class":5220,"id":161,"href":1572},[5386],{"type":1449,"textContent":1575},{"type":1449,"textContent":5388}," Terminology",{"type":1449,"textContent":5390},"\n\n   This specification uses a number of terms to refer to the roles\n   played by participants in, and objects of, the HTTP communication.\n\n   connection\n      A transport layer virtual circuit established between two programs\n      for the purpose of communication.\n\n   message\n      The basic unit of HTTP communication, consisting of a structured\n      sequence of octets matching the syntax defined in ",{"type":1444,"nodeName":1452,"attributes":5392,"children":5393},{"href":1957},[5394],{"type":1449,"textContent":5395},"section 4",{"type":1449,"textContent":5397}," and\n      transmitted via the connection.\n\n   request\n      An HTTP request message, as defined in ",{"type":1444,"nodeName":1452,"attributes":5399,"children":5400},{"href":2042},[5401],{"type":1449,"textContent":5402},"section 5",{"type":1449,"textContent":5404},".\n\n   response\n      An HTTP response message, as defined in ",{"type":1444,"nodeName":1452,"attributes":5406,"children":5407},{"href":2126},[5408],{"type":1449,"textContent":5409},"section 6",{"type":1449,"textContent":5411},".\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5413,"children":5414},{"class":1493},[5415],{"type":1449,"textContent":5416},"Fielding, et al.            Standards Track                     [Page 8]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5419,"children":5420},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5422,"children":5423},{"class":1506},[5424,5428,5429,5437,5439,5444,5446,5451,5453,5458,5460,5464,5466],{"type":1444,"nodeName":1461,"attributes":5425,"children":5427},{"id":5426},"page-9",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5430,"children":5431},{"class":1493},[5432,5436],{"type":1444,"nodeName":1452,"attributes":5433,"children":5434},{"href":1518},[5435],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5438},"\n\n\n   resource\n      A network data object or service that can be identified by a URI,\n      as defined in ",{"type":1444,"nodeName":1452,"attributes":5440,"children":5441},{"href":1671},[5442],{"type":1449,"textContent":5443},"section 3.2",{"type":1449,"textContent":5445},". Resources may be available in multiple\n      representations (e.g. multiple languages, data formats, size, and\n      resolutions) or vary in other ways.\n\n   entity\n      The information transferred as the payload of a request or\n      response. An entity consists of metainformation in the form of\n      entity-header fields and content in the form of an entity-body, as\n      described in ",{"type":1444,"nodeName":1452,"attributes":5447,"children":5448},{"href":2210},[5449],{"type":1449,"textContent":5450},"section 7",{"type":1449,"textContent":5452},".\n\n   representation\n      An entity included with a response that is subject to content\n      negotiation, as described in ",{"type":1444,"nodeName":1452,"attributes":5454,"children":5455},{"href":3272},[5456],{"type":1449,"textContent":5457},"section 12",{"type":1449,"textContent":5459},". There may exist multiple\n      representations associated with a particular response status.\n\n   content negotiation\n      The mechanism for selecting the appropriate representation when\n      servicing a request, as described in ",{"type":1444,"nodeName":1452,"attributes":5461,"children":5462},{"href":3272},[5463],{"type":1449,"textContent":5457},{"type":1449,"textContent":5465},". The\n      representation of entities in any response can be negotiated\n      (including error responses).\n\n   variant\n      A resource may have one, or more than one, representation(s)\n      associated with it at any given instant. Each of these\n      representations is termed a `varriant'.  Use of the term `variant'\n      does not necessarily imply that the resource is subject to content\n      negotiation.\n\n   client\n      A program that establishes connections for the purpose of sending\n      requests.\n\n   user agent\n      The client which initiates a request. These are often browsers,\n      editors, spiders (web-traversing robots), or other end user tools.\n\n   server\n      An application program that accepts connections in order to\n      service requests by sending back responses. Any given program may\n      be capable of being both a client and a server; our use of these\n      terms refers only to the role being performed by the program for a\n      particular connection, rather than to the program's capabilities\n      in general. Likewise, any server may act as an origin server,\n      proxy, gateway, or tunnel, switching behavior based on the nature\n      of each request.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5467,"children":5468},{"class":1493},[5469],{"type":1449,"textContent":5470},"Fielding, et al.            Standards Track                     [Page 9]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5473,"children":5474},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5476,"children":5477},{"class":1506},[5478,5482,5483,5491,5493,5498,5500],{"type":1444,"nodeName":1461,"attributes":5479,"children":5481},{"id":5480},"page-10",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5484,"children":5485},{"class":1493},[5486,5490],{"type":1444,"nodeName":1452,"attributes":5487,"children":5488},{"href":1518},[5489],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5492},"\n\n\n   origin server\n      The server on which a given resource resides or is to be created.\n\n   proxy\n      An intermediary program which acts as both a server and a client\n      for the purpose of making requests on behalf of other clients.\n      Requests are serviced internally or by passing them on, with\n      possible translation, to other servers. A proxy MUST implement\n      both the client and server requirements of this specification. A\n      \"transparent proxy\" is a proxy that does not modify the request or\n      response beyond what is required for proxy authentication and\n      identification. A \"non-transparent proxy\" is a proxy that modifies\n      the request or response in order to provide some added service to\n      the user agent, such as group annotation services, media type\n      transformation, protocol reduction, or anonymity filtering. Except\n      where either transparent or non-transparent behavior is explicitly\n      stated, the HTTP proxy requirements apply to both types of\n      proxies.\n\n   gateway\n      A server which acts as an intermediary for some other server.\n      Unlike a proxy, a gateway receives requests as if it were the\n      origin server for the requested resource; the requesting client\n      may not be aware that it is communicating with a gateway.\n\n   tunnel\n      An intermediary program which is acting as a blind relay between\n      two connections. Once active, a tunnel is not considered a party\n      to the HTTP communication, though the tunnel may have been\n      initiated by an HTTP request. The tunnel ceases to exist when both\n      ends of the relayed connections are closed.\n\n   cache\n      A program's local store of response messages and the subsystem\n      that controls its message storage, retrieval, and deletion. A\n      cache stores cacheable responses in order to reduce the response\n      time and network bandwidth consumption on future, equivalent\n      requests. Any client or server may include a cache, though a cache\n      cannot be used by a server that is acting as a tunnel.\n\n   cacheable\n      A response is cacheable if a cache is allowed to store a copy of\n      the response message for use in answering subsequent requests. The\n      rules for determining the cacheability of HTTP responses are\n      defined in ",{"type":1444,"nodeName":1452,"attributes":5494,"children":5495},{"href":3329},[5496],{"type":1449,"textContent":5497},"section 13",{"type":1449,"textContent":5499},". Even if a resource is cacheable, there may\n      be additional constraints on whether a cache can use the cached\n      copy for a particular request.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5501,"children":5502},{"class":1493},[5503],{"type":1449,"textContent":5504},"Fielding, et al.            Standards Track                    [Page 10]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5507,"children":5508},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5510,"children":5511},{"class":1506},[5512,5516,5517,5525,5527],{"type":1444,"nodeName":1461,"attributes":5513,"children":5515},{"id":5514},"page-11",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5518,"children":5519},{"class":1493},[5520,5524],{"type":1444,"nodeName":1452,"attributes":5521,"children":5522},{"href":1518},[5523],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5526},"\n\n\n   first-hand\n      A response is first-hand if it comes directly and without\n      unnecessary delay from the origin server, perhaps via one or more\n      proxies. A response is also first-hand if its validity has just\n      been checked directly with the origin server.\n\n   explicit expiration time\n      The time at which the origin server intends that an entity should\n      no longer be returned by a cache without further validation.\n\n   heuristic expiration time\n      An expiration time assigned by a cache when no explicit expiration\n      time is available.\n\n   age\n      The age of a response is the time since it was sent by, or\n      successfully validated with, the origin server.\n\n   freshness lifetime\n      The length of time between the generation of a response and its\n      expiration time.\n\n   fresh\n      A response is fresh if its age has not yet exceeded its freshness\n      lifetime.\n\n   stale\n      A response is stale if its age has passed its freshness lifetime.\n\n   semantically transparent\n      A cache behaves in a \"semantically transparent\" manner, with\n      respect to a particular response, when its use affects neither the\n      requesting client nor the origin server, except to improve\n      performance. When a cache is semantically transparent, the client\n      receives exactly the same response (except for hop-by-hop headers)\n      that it would have received had its request been handled directly\n      by the origin server.\n\n   validator\n      A protocol element (e.g., an entity tag or a Last-Modified time)\n      that is used to find out whether a cache entry is an equivalent\n      copy of an entity.\n\n   upstream\u002Fdownstream\n      Upstream and downstream describe the flow of a message: all\n      messages flow from upstream to downstream.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5528,"children":5529},{"class":1493},[5530],{"type":1449,"textContent":5531},"Fielding, et al.            Standards Track                    [Page 11]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5534,"children":5535},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5537,"children":5538},{"class":1506},[5539,5543,5544,5552,5554,5563,5565],{"type":1444,"nodeName":1461,"attributes":5540,"children":5542},{"id":5541},"page-12",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5545,"children":5546},{"class":1493},[5547,5551],{"type":1444,"nodeName":1452,"attributes":5548,"children":5549},{"href":1518},[5550],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5553},"\n\n\n   inbound\u002Foutbound\n      Inbound and outbound refer to the request and response paths for\n      messages: \"inbound\" means \"traveling toward the origin server\",\n      and \"outbound\" means \"traveling toward the user agent\"\n\n",{"type":1444,"nodeName":1461,"attributes":5555,"children":5556},{"class":5228},[5557,5561],{"type":1444,"nodeName":1452,"attributes":5558,"children":5559},{"class":5220,"id":166,"href":1585},[5560],{"type":1449,"textContent":1588},{"type":1449,"textContent":5562}," Overall Operation",{"type":1449,"textContent":5564},"\n\n   The HTTP protocol is a request\u002Fresponse protocol. A client sends a\n   request to the server in the form of a request method, URI, and\n   protocol version, followed by a MIME-like message containing request\n   modifiers, client information, and possible body content over a\n   connection with a server. The server responds with a status line,\n   including the message's protocol version and a success or error code,\n   followed by a MIME-like message containing server information, entity\n   metainformation, and possible entity-body content. The relationship\n   between HTTP and MIME is described in appendix 19.4.\n\n   Most HTTP communication is initiated by a user agent and consists of\n   a request to be applied to a resource on some origin server. In the\n   simplest case, this may be accomplished via a single connection (v)\n   between the user agent (UA) and the origin server (O).\n\n          request chain ------------------------>\n       UA -------------------v------------------- O\n          \u003C----------------------- response chain\n\n   A more complicated situation occurs when one or more intermediaries\n   are present in the request\u002Fresponse chain. There are three common\n   forms of intermediary: proxy, gateway, and tunnel. A proxy is a\n   forwarding agent, receiving requests for a URI in its absolute form,\n   rewriting all or part of the message, and forwarding the reformatted\n   request toward the server identified by the URI. A gateway is a\n   receiving agent, acting as a layer above some other server(s) and, if\n   necessary, translating the requests to the underlying server's\n   protocol. A tunnel acts as a relay point between two connections\n   without changing the messages; tunnels are used when the\n   communication needs to pass through an intermediary (such as a\n   firewall) even when the intermediary cannot understand the contents\n   of the messages.\n\n          request chain -------------------------------------->\n       UA -----v----- A -----v----- B -----v----- C -----v----- O\n          \u003C------------------------------------- response chain\n\n   The figure above shows three intermediaries (A, B, and C) between the\n   user agent and origin server. A request or response message that\n   travels the whole chain will pass through four separate connections.\n   This distinction is important because some HTTP communication options\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5566,"children":5567},{"class":1493},[5568],{"type":1449,"textContent":5569},"Fielding, et al.            Standards Track                    [Page 12]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5572,"children":5573},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5575,"children":5576},{"class":1506},[5577,5581,5582,5590,5592,5596,5598,5603,5605],{"type":1444,"nodeName":1461,"attributes":5578,"children":5580},{"id":5579},"page-13",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5583,"children":5584},{"class":1493},[5585,5589],{"type":1444,"nodeName":1452,"attributes":5586,"children":5587},{"href":1518},[5588],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5591},"\n\n\n   may apply only to the connection with the nearest, non-tunnel\n   neighbor, only to the end-points of the chain, or to all connections\n   along the chain. Although the diagram is linear, each participant may\n   be engaged in multiple, simultaneous communications. For example, B\n   may be receiving requests from many clients other than A, and\u002For\n   forwarding requests to servers other than C, at the same time that it\n   is handling A's request.\n\n   Any party to the communication which is not acting as a tunnel may\n   employ an internal cache for handling requests. The effect of a cache\n   is that the request\u002Fresponse chain is shortened if one of the\n   participants along the chain has a cached response applicable to that\n   request. The following illustrates the resulting chain if B has a\n   cached copy of an earlier response from O (via C) for a request which\n   has not been cached by UA or A.\n\n          request chain ---------->\n       UA -----v----- A -----v----- B - - - - - - C - - - - - - O\n          \u003C--------- response chain\n\n   Not all responses are usefully cacheable, and some requests may\n   contain modifiers which place special requirements on cache behavior.\n   HTTP requirements for cache behavior and cacheable responses are\n   defined in ",{"type":1444,"nodeName":1452,"attributes":5593,"children":5594},{"href":3329},[5595],{"type":1449,"textContent":5497},{"type":1449,"textContent":5597},".\n\n   In fact, there are a wide variety of architectures and configurations\n   of caches and proxies currently being experimented with or deployed\n   across the World Wide Web. These systems include national hierarchies\n   of proxy caches to save transoceanic bandwidth, systems that\n   broadcast or multicast cache entries, organizations that distribute\n   subsets of cached data via CD-ROM, and so on. HTTP systems are used\n   in corporate intranets over high-bandwidth links, and for access via\n   PDAs with low-power radio links and intermittent connectivity. The\n   goal of HTTP\u002F1.1 is to support the wide diversity of configurations\n   already deployed while introducing protocol constructs that meet the\n   needs of those who build web applications that require high\n   reliability and, failing that, at least reliable indications of\n   failure.\n\n   HTTP communication usually takes place over TCP\u002FIP connections. The\n   default port is TCP 80 [",{"type":1444,"nodeName":1452,"attributes":5599,"children":5601},{"href":5600},"#ref-19",[5602],{"type":1449,"textContent":1697},{"type":1449,"textContent":5604},"], but other ports can be used. This does\n   not preclude HTTP from being implemented on top of any other protocol\n   on the Internet, or on other networks. HTTP only presumes a reliable\n   transport; any protocol that provides such guarantees can be used;\n   the mapping of the HTTP\u002F1.1 request and response structures onto the\n   transport data units of the protocol in question is outside the scope\n   of this specification.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5606,"children":5607},{"class":1493},[5608],{"type":1449,"textContent":5609},"Fielding, et al.            Standards Track                    [Page 13]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5612,"children":5613},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5615,"children":5616},{"class":1506},[5617,5621,5622,5630,5632,5637,5639,5648,5649,5658,5660,5666,5667,5671,5673,5679,5681],{"type":1444,"nodeName":1461,"attributes":5618,"children":5620},{"id":5619},"page-14",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5623,"children":5624},{"class":1493},[5625,5629],{"type":1444,"nodeName":1452,"attributes":5626,"children":5627},{"href":1518},[5628],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5631},"\n\n\n   In HTTP\u002F1.0, most implementations used a new connection for each\n   request\u002Fresponse exchange. In HTTP\u002F1.1, a connection may be used for\n   one or more request\u002Fresponse exchanges, although connections may be\n   closed for a variety of reasons (see ",{"type":1444,"nodeName":1452,"attributes":5633,"children":5634},{"href":2292},[5635],{"type":1449,"textContent":5636},"section 8.1",{"type":1449,"textContent":5638},").\n\n",{"type":1444,"nodeName":1461,"attributes":5640,"children":5641},{"class":5216},[5642,5646],{"type":1444,"nodeName":1452,"attributes":5643,"children":5644},{"class":5220,"id":171,"href":1600},[5645],{"type":1449,"textContent":1603},{"type":1449,"textContent":5647}," Notational Conventions and Generic Grammar",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":5650,"children":5651},{"class":5228},[5652,5656],{"type":1444,"nodeName":1452,"attributes":5653,"children":5654},{"class":5220,"id":177,"href":1615},[5655],{"type":1449,"textContent":1618},{"type":1449,"textContent":5657}," Augmented BNF",{"type":1449,"textContent":5659},"\n\n   All of the mechanisms specified in this document are described in\n   both prose and an augmented Backus-Naur Form (BNF) similar to that\n   used by ",{"type":1444,"nodeName":1452,"attributes":5661,"children":5663},{"href":5662},"\u002Finfo\u002Frfc822\u002F",[5664],{"type":1449,"textContent":5665},"RFC 822",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":5668,"children":5669},{"href":5308},[5670],{"type":1449,"textContent":2427},{"type":1449,"textContent":5672},"]. Implementors will need to be familiar with the\n   notation in order to understand this specification. The augmented BNF\n   includes the following constructs:\n\n   name = definition\n      The name of a rule is simply the name itself (without any\n      enclosing \"\u003C\" and \">\") and is separated from its definition by the\n      equal \"=\" character. White space is only significant in that\n      indentation of continuation lines is used to indicate a rule\n      definition that spans more than one line. Certain basic rules are\n      in uppercase, such as SP, LWS, HT, CRLF, DIGIT, ALPHA, etc. Angle\n      brackets are used within definitions whenever their presence will\n      facilitate discerning the use of rule names.\n\n   \"literal\"\n      Quotation marks surround literal text. Unless stated otherwise,\n      the text is case-insensitive.\n\n   rule1 | rule2\n      Elements separated by a bar (\"|\") are alternatives, e.g., \"yes |\n      no\" will accept yes or no.\n\n   (rule1 rule2)\n      Elements enclosed in parentheses are treated as a single element.\n      Thus, \"(elem (foo | bar) elem)\" allows the token sequences \"elem\n      foo elem\" and \"elem bar elem\".\n\n   *rule\n      The character \"*\" preceding an element indicates repetition. The\n      full form is \"\u003Cn>*\u003Cm>element\" indicating at least \u003Cn> and at most\n      \u003Cm> occurrences of element. Default values are 0 and infinity so\n      that \"*(element)\" allows any number, including zero; \"1*element\"\n      requires at least one; and \"1*2element\" allows one or two.\n\n   [",{"type":1444,"nodeName":1452,"attributes":5674,"children":5676},{"id":5675},"ref-rule",[5677],{"type":1449,"textContent":5678},"rule",{"type":1449,"textContent":5680},"]\n      Square brackets enclose optional elements; \"[foo bar]\" is\n      equivalent to \"*1(foo bar)\".\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5682,"children":5683},{"class":1493},[5684],{"type":1449,"textContent":5685},"Fielding, et al.            Standards Track                    [Page 14]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5688,"children":5689},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5691,"children":5692},{"class":1506},[5693,5697,5698,5706,5708,5717,5719,5724,5726],{"type":1444,"nodeName":1461,"attributes":5694,"children":5696},{"id":5695},"page-15",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5699,"children":5700},{"class":1493},[5701,5705],{"type":1444,"nodeName":1452,"attributes":5702,"children":5703},{"href":1518},[5704],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5707},"\n\n\n   N rule\n      Specific repetition: \"\u003Cn>(element)\" is equivalent to\n      \"\u003Cn>*\u003Cn>(element)\"; that is, exactly \u003Cn> occurrences of (element).\n      Thus 2DIGIT is a 2-digit number, and 3ALPHA is a string of three\n      alphabetic characters.\n\n   #rule\n      A construct \"#\" is defined, similar to \"*\", for defining lists of\n      elements. The full form is \"\u003Cn>#\u003Cm>element\" indicating at least\n      \u003Cn> and at most \u003Cm> elements, each separated by one or more commas\n      (\",\") and OPTIONAL linear white space (LWS). This makes the usual\n      form of lists very easy; a rule such as\n         ( *LWS element *( *LWS \",\" *LWS element ))\n      can be shown as\n         1#element\n      Wherever this construct is used, null elements are allowed, but do\n      not contribute to the count of elements present. That is,\n      \"(element), , (element) \" is permitted, but counts as only two\n      elements. Therefore, where at least one element is required, at\n      least one non-null element MUST be present. Default values are 0\n      and infinity so that \"#element\" allows any number, including zero;\n      \"1#element\" requires at least one; and \"1#2element\" allows one or\n      two.\n\n   ; comment\n      A semi-colon, set off some distance to the right of rule text,\n      starts a comment that continues to the end of line. This is a\n      simple way of including useful notes in parallel with the\n      specifications.\n\n   implied *LWS\n      The grammar described by this specification is word-based. Except\n      where noted otherwise, linear white space (LWS) can be included\n      between any two adjacent words (token or quoted-string), and\n      between adjacent words and separators, without changing the\n      interpretation of a field. At least one delimiter (LWS and\u002For\n\n      separators) MUST exist between any two tokens (for the definition\n      of \"token\" below), since they would otherwise be interpreted as a\n      single token.\n\n",{"type":1444,"nodeName":1461,"attributes":5709,"children":5710},{"class":5228},[5711,5715],{"type":1444,"nodeName":1452,"attributes":5712,"children":5713},{"class":5220,"id":182,"href":1628},[5714],{"type":1449,"textContent":1631},{"type":1449,"textContent":5716}," Basic Rules",{"type":1449,"textContent":5718},"\n\n   The following rules are used throughout this specification to\n   describe basic parsing constructs. The US-ASCII coded character set\n   is defined by ANSI X3.4-1986 [",{"type":1444,"nodeName":1452,"attributes":5720,"children":5722},{"href":5721},"#ref-21",[5723],{"type":1449,"textContent":1766},{"type":1449,"textContent":5725},"].\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5727,"children":5728},{"class":1493},[5729],{"type":1449,"textContent":5730},"Fielding, et al.            Standards Track                    [Page 15]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5733,"children":5734},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5736,"children":5737},{"class":1506},[5738,5742,5743,5751,5753,5758,5760,5765,5767,5773,5775,5780,5782],{"type":1444,"nodeName":1461,"attributes":5739,"children":5741},{"id":5740},"page-16",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5744,"children":5745},{"class":1493},[5746,5750],{"type":1444,"nodeName":1452,"attributes":5747,"children":5748},{"href":1518},[5749],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5752},"\n\n\n       OCTET          = \u003Cany 8-bit sequence of data>\n       CHAR           = \u003Cany US-ASCII character (octets 0 - 127)>\n       UPALPHA        = \u003Cany US-ASCII uppercase letter \"A\"..\"Z\">\n       LOALPHA        = \u003Cany US-ASCII lowercase letter \"a\"..\"z\">\n       ALPHA          = UPALPHA | LOALPHA\n       DIGIT          = \u003Cany US-ASCII digit \"0\"..\"9\">\n       CTL            = \u003Cany US-ASCII control character\n                        (octets 0 - 31) and DEL (127)>\n       CR             = \u003CUS-ASCII CR, carriage return (13)>\n       LF             = \u003CUS-ASCII LF, linefeed (10)>\n       SP             = \u003CUS-ASCII SP, space (32)>\n       HT             = \u003CUS-ASCII HT, horizontal-tab (9)>\n       \u003C\">            = \u003CUS-ASCII double-quote mark (34)>\n\n   HTTP\u002F1.1 defines the sequence CR LF as the end-of-line marker for all\n   protocol elements except the entity-body (see appendix 19.3 for\n   tolerant applications). The end-of-line marker within an entity-body\n   is defined by its associated media type, as described in ",{"type":1444,"nodeName":1452,"attributes":5754,"children":5755},{"href":1843},[5756],{"type":1449,"textContent":5757},"section 3.7",{"type":1449,"textContent":5759},".\n\n       CRLF           = CR LF\n\n   HTTP\u002F1.1 header field values can be folded onto multiple lines if the\n   continuation line begins with a space or horizontal tab. All linear\n   white space, including folding, has the same semantics as SP. A\n   recipient MAY replace any linear white space with a single SP before\n   interpreting the field value or forwarding the message downstream.\n\n       LWS            = [CRLF] 1*( SP | HT )\n\n   The TEXT rule is only used for descriptive field contents and values\n   that are not intended to be interpreted by the message parser. Words\n   of *TEXT MAY contain characters from character sets other than ISO-\n   8859-1 [",{"type":1444,"nodeName":1452,"attributes":5761,"children":5763},{"href":5762},"#ref-22",[5764],{"type":1449,"textContent":1794},{"type":1449,"textContent":5766},"] only when encoded according to the rules of ",{"type":1444,"nodeName":1452,"attributes":5768,"children":5770},{"href":5769},"\u002Finfo\u002Frfc2047\u002F",[5771],{"type":1449,"textContent":5772},"RFC 2047",{"type":1449,"textContent":5774},"\n   [",{"type":1444,"nodeName":1452,"attributes":5776,"children":5778},{"href":5777},"#ref-14",[5779],{"type":1449,"textContent":1611},{"type":1449,"textContent":5781},"].\n\n       TEXT           = \u003Cany OCTET except CTLs,\n                        but including LWS>\n\n   A CRLF is allowed in the definition of TEXT only as part of a header\n   field continuation. It is expected that the folding LWS will be\n   replaced with a single SP before interpretation of the TEXT value.\n\n   Hexadecimal numeric characters are used in several protocol elements.\n\n       HEX            = \"A\" | \"B\" | \"C\" | \"D\" | \"E\" | \"F\"\n                      | \"a\" | \"b\" | \"c\" | \"d\" | \"e\" | \"f\" | DIGIT\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5783,"children":5784},{"class":1493},[5785],{"type":1449,"textContent":5786},"Fielding, et al.            Standards Track                    [Page 16]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5789,"children":5790},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5792,"children":5793},{"class":1506},[5794,5798,5799,5807,5809,5814,5815,5819,5821,5830,5831,5840,5842,5848,5849,5854,5856],{"type":1444,"nodeName":1461,"attributes":5795,"children":5797},{"id":5796},"page-17",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5800,"children":5801},{"class":1493},[5802,5806],{"type":1444,"nodeName":1452,"attributes":5803,"children":5804},{"href":1518},[5805],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5808},"\n\n\n   Many HTTP\u002F1.1 header field values consist of words separated by LWS\n   or special characters. These special characters MUST be in a quoted\n   string to be used within a parameter value (as defined in ",{"type":1444,"nodeName":1452,"attributes":5810,"children":5811},{"href":1813},[5812],{"type":1449,"textContent":5813},"section",{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":5816,"children":5817},{"href":1813},[5818],{"type":1449,"textContent":1816},{"type":1449,"textContent":5820},").\n\n       token          = 1*\u003Cany CHAR except CTLs or separators>\n       separators     = \"(\" | \")\" | \"\u003C\" | \">\" | \"@\"\n                      | \",\" | \";\" | \":\" | \"\\\" | \u003C\">\n                      | \"\u002F\" | \"[\" | \"]\" | \"?\" | \"=\"\n                      | \"{\" | \"}\" | SP | HT\n\n   Comments can be included in some HTTP header fields by surrounding\n   the comment text with parentheses. Comments are only allowed in\n   fields containing \"comment\" as part of their field value definition.\n   In all other fields, parentheses are considered part of the field\n   value.\n\n       comment        = \"(\" *( ctext | quoted-pair | comment ) \")\"\n       ctext          = \u003Cany TEXT excluding \"(\" and \")\">\n\n   A string of text is parsed as a single word if it is quoted using\n   double-quote marks.\n\n       quoted-string  = ( \u003C\"> *(qdtext | quoted-pair ) \u003C\"> )\n       qdtext         = \u003Cany TEXT except \u003C\">>\n\n   The backslash character (\"\\\") MAY be used as a single-character\n   quoting mechanism only within quoted-string and comment constructs.\n\n       quoted-pair    = \"\\\" CHAR\n\n",{"type":1444,"nodeName":1461,"attributes":5822,"children":5823},{"class":5216},[5824,5828],{"type":1444,"nodeName":1452,"attributes":5825,"children":5826},{"class":5220,"id":187,"href":1643},[5827],{"type":1449,"textContent":1646},{"type":1449,"textContent":5829}," Protocol Parameters",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":5832,"children":5833},{"class":5228},[5834,5838],{"type":1444,"nodeName":1452,"attributes":5835,"children":5836},{"class":5220,"id":193,"href":1658},[5837],{"type":1449,"textContent":1661},{"type":1449,"textContent":5839}," HTTP Version",{"type":1449,"textContent":5841},"\n\n   HTTP uses a \"\u003Cmajor>.\u003Cminor>\" numbering scheme to indicate versions\n   of the protocol. The protocol versioning policy is intended to allow\n   the sender to indicate the format of a message and its capacity for\n   understanding further HTTP communication, rather than the features\n   obtained via that communication. No change is made to the version\n   number for the addition of message components which do not affect\n   communication behavior or which only add to extensible field values.\n   The \u003Cminor> number is incremented when the changes made to the\n   protocol add features which do not change the general message parsing\n   algorithm, but which may add to the message semantics and imply\n   additional capabilities of the sender. The \u003Cmajor> number is\n   incremented when the format of a message within the protocol is\n   changed. See ",{"type":1444,"nodeName":1452,"attributes":5843,"children":5845},{"href":5844},"\u002Finfo\u002Frfc2145\u002F",[5846],{"type":1449,"textContent":5847},"RFC 2145",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":5850,"children":5852},{"href":5851},"#ref-36",[5853],{"type":1449,"textContent":2081},{"type":1449,"textContent":5855},"] for a fuller explanation.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5857,"children":5858},{"class":1493},[5859],{"type":1449,"textContent":5860},"Fielding, et al.            Standards Track                    [Page 17]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5863,"children":5864},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5866,"children":5867},{"class":1506},[5868,5872,5873,5881,5883,5887,5888,5892,5894,5898,5900,5904,5906,5915,5917,5921,5923,5927,5929,5933,5935],{"type":1444,"nodeName":1461,"attributes":5869,"children":5871},{"id":5870},"page-18",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5874,"children":5875},{"class":1493},[5876,5880],{"type":1444,"nodeName":1452,"attributes":5877,"children":5878},{"href":1518},[5879],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5882},"\n\n\n   The version of an HTTP message is indicated by an HTTP-Version field\n   in the first line of the message.\n\n       HTTP-Version   = \"HTTP\" \"\u002F\" 1*DIGIT \".\" 1*DIGIT\n\n   Note that the major and minor numbers MUST be treated as separate\n   integers and that each MAY be incremented higher than a single digit.\n   Thus, HTTP\u002F2.4 is a lower version than HTTP\u002F2.13, which in turn is\n   lower than HTTP\u002F12.3. Leading zeros MUST be ignored by recipients and\n   MUST NOT be sent.\n\n   An application that sends a request or response message that includes\n   HTTP-Version of \"HTTP\u002F1.1\" MUST be at least conditionally compliant\n   with this specification. Applications that are at least conditionally\n   compliant with this specification SHOULD use an HTTP-Version of\n   \"HTTP\u002F1.1\" in their messages, and MUST do so for any message that is\n   not compatible with HTTP\u002F1.0. For more details on when to send\n   specific HTTP-Version values, see ",{"type":1444,"nodeName":1452,"attributes":5884,"children":5885},{"href":5844},[5886],{"type":1449,"textContent":5847},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":5889,"children":5890},{"href":5851},[5891],{"type":1449,"textContent":2081},{"type":1449,"textContent":5893},"].\n\n   The HTTP version of an application is the highest HTTP version for\n   which the application is at least conditionally compliant.\n\n   Proxy and gateway applications need to be careful when forwarding\n   messages in protocol versions different from that of the application.\n   Since the protocol version indicates the protocol capability of the\n   sender, a proxy\u002Fgateway MUST NOT send a message with a version\n   indicator which is greater than its actual version. If a higher\n   version request is received, the proxy\u002Fgateway MUST either downgrade\n   the request version, or respond with an error, or switch to tunnel\n   behavior.\n\n   Due to interoperability problems with HTTP\u002F1.0 proxies discovered\n   since the publication of ",{"type":1444,"nodeName":1452,"attributes":5895,"children":5896},{"href":1454},[5897],{"type":1449,"textContent":1480},{"type":1449,"textContent":5899},"[",{"type":1444,"nodeName":1452,"attributes":5901,"children":5902},{"href":1485},[5903],{"type":1449,"textContent":1488},{"type":1449,"textContent":5905},"], caching proxies MUST, gateways\n   MAY, and tunnels MUST NOT upgrade the request to the highest version\n   they support. The proxy\u002Fgateway's response to that request MUST be in\n   the same major version as the request.\n\n      Note: Converting between versions of HTTP may involve modification\n      of header fields required or forbidden by the versions involved.\n\n",{"type":1444,"nodeName":1461,"attributes":5907,"children":5908},{"class":5228},[5909,5913],{"type":1444,"nodeName":1452,"attributes":5910,"children":5911},{"class":5220,"id":198,"href":1671},[5912],{"type":1449,"textContent":1674},{"type":1449,"textContent":5914}," Uniform Resource Identifiers",{"type":1449,"textContent":5916},"\n\n   URIs have been known by many names: WWW addresses, Universal Document\n   Identifiers, Universal Resource Identifiers [",{"type":1444,"nodeName":1452,"attributes":5918,"children":5919},{"href":5260},[5920],{"type":1449,"textContent":1646},{"type":1449,"textContent":5922},"], and finally the\n   combination of Uniform Resource Locators (URL) [",{"type":1444,"nodeName":1452,"attributes":5924,"children":5925},{"href":5267},[5926],{"type":1449,"textContent":1960},{"type":1449,"textContent":5928},"] and Names (URN)\n   [",{"type":1444,"nodeName":1452,"attributes":5930,"children":5931},{"href":5274},[5932],{"type":1449,"textContent":1725},{"type":1449,"textContent":5934},"]. As far as HTTP is concerned, Uniform Resource Identifiers are\n   simply formatted strings which identify--via name, location, or any\n   other characteristic--a resource.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":5936,"children":5937},{"class":1493},[5938],{"type":1449,"textContent":5939},"Fielding, et al.            Standards Track                    [Page 18]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":5942,"children":5943},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":5945,"children":5946},{"class":1506},[5947,5951,5952,5960,5962,5972,5974,5979,5981,5987,5988,5993,5995,5999,6001,6007,6008,6012,6014,6019,6021,6030,6032,6037,6039,6045,6046,6051,6053,6057,6059],{"type":1444,"nodeName":1461,"attributes":5948,"children":5950},{"id":5949},"page-19",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":5953,"children":5954},{"class":1493},[5955,5959],{"type":1444,"nodeName":1452,"attributes":5956,"children":5957},{"href":1518},[5958],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},"\n\n\n",{"type":1444,"nodeName":1461,"attributes":5963,"children":5965},{"class":5964},"h4",[5966,5970],{"type":1444,"nodeName":1452,"attributes":5967,"children":5968},{"class":5220,"id":204,"href":1686},[5969],{"type":1449,"textContent":1689},{"type":1449,"textContent":5971}," General Syntax",{"type":1449,"textContent":5973},"\n\n   URIs in HTTP can be represented in absolute form or relative to some\n   known base URI [",{"type":1444,"nodeName":1452,"attributes":5975,"children":5977},{"href":5976},"#ref-11",[5978],{"type":1449,"textContent":3262},{"type":1449,"textContent":5980},"], depending upon the context of their use. The two\n   forms are differentiated by the fact that absolute URIs always begin\n   with a scheme name followed by a colon. For definitive information on\n   URL syntax and semantics, see \"Uniform Resource Identifiers (URI):\n   Generic Syntax and Semantics,\" ",{"type":1444,"nodeName":1452,"attributes":5982,"children":5984},{"href":5983},"\u002Finfo\u002Frfc2396\u002F",[5985],{"type":1449,"textContent":5986},"RFC 2396",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":5989,"children":5991},{"href":5990},"#ref-42",[5992],{"type":1449,"textContent":2220},{"type":1449,"textContent":5994},"] (which replaces RFCs\n   1738 [",{"type":1444,"nodeName":1452,"attributes":5996,"children":5997},{"href":5267},[5998],{"type":1449,"textContent":1960},{"type":1449,"textContent":6000},"] and ",{"type":1444,"nodeName":1452,"attributes":6002,"children":6004},{"href":6003},"\u002Finfo\u002Frfc1808\u002F",[6005],{"type":1449,"textContent":6006},"RFC 1808",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6009,"children":6010},{"href":5976},[6011],{"type":1449,"textContent":3262},{"type":1449,"textContent":6013},"]). This specification adopts the\n   definitions of \"URI-reference\", \"absoluteURI\", \"relativeURI\", \"port\",\n   \"host\",\"abs_path\", \"rel_path\", and \"authority\" from that\n   specification.\n\n   The HTTP protocol does not place any a priori limit on the length of\n   a URI. Servers MUST be able to handle the URI of any resource they\n   serve, and SHOULD be able to handle URIs of unbounded length if they\n   provide GET-based forms that could generate such URIs. A server\n   SHOULD return 414 (Request-URI Too Long) status if a URI is longer\n   than the server can handle (see ",{"type":1444,"nodeName":1452,"attributes":6015,"children":6016},{"href":3112},[6017],{"type":1449,"textContent":6018},"section 10.4.15",{"type":1449,"textContent":6020},").\n\n      Note: Servers ought to be cautious about depending on URI lengths\n      above 255 bytes, because some older client or proxy\n      implementations might not properly support these lengths.\n\n",{"type":1444,"nodeName":1461,"attributes":6022,"children":6023},{"class":5964},[6024,6028],{"type":1444,"nodeName":1452,"attributes":6025,"children":6026},{"class":5220,"id":209,"href":1701},[6027],{"type":1449,"textContent":1704},{"type":1449,"textContent":6029}," http URL",{"type":1449,"textContent":6031},"\n\n   The \"http\" scheme is used to locate network resources via the HTTP\n   protocol. This section defines the scheme-specific syntax and\n   semantics for http URLs.\n\n   http_URL = \"http:\" \"\u002F\u002F\" host [ \":\" port ] [ abs_path [ \"?\" query ]]\n\n   If the port is empty or not given, port 80 is assumed. The semantics\n   are that the identified resource is located at the server listening\n   for TCP connections on that port of that host, and the Request-URI\n   for the resource is abs_path (",{"type":1444,"nodeName":1452,"attributes":6033,"children":6034},{"href":2085},[6035],{"type":1449,"textContent":6036},"section 5.1.2",{"type":1449,"textContent":6038},"). The use of IP addresses\n   in URLs SHOULD be avoided whenever possible (see ",{"type":1444,"nodeName":1452,"attributes":6040,"children":6042},{"href":6041},"\u002Finfo\u002Frfc1900\u002F",[6043],{"type":1449,"textContent":6044},"RFC 1900",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6047,"children":6049},{"href":6048},"#ref-24",[6050],{"type":1449,"textContent":1824},{"type":1449,"textContent":6052},"]). If\n   the abs_path is not present in the URL, it MUST be given as \"\u002F\" when\n   used as a Request-URI for a resource (",{"type":1444,"nodeName":1452,"attributes":6054,"children":6055},{"href":2085},[6056],{"type":1449,"textContent":6036},{"type":1449,"textContent":6058},"). If a proxy\n   receives a host name which is not a fully qualified domain name, it\n   MAY add its domain to the host name it received. If a proxy receives\n   a fully qualified domain name, the proxy MUST NOT change the host\n   name.\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6060,"children":6061},{"class":1493},[6062],{"type":1449,"textContent":6063},"Fielding, et al.            Standards Track                    [Page 19]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6066,"children":6067},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6069,"children":6070},{"class":1506},[6071,6075,6076,6084,6085,6094,6096,6100,6101,6105,6107,6112,6114,6119,6120,6125,6126,6135,6136,6145,6147,6151,6153,6159,6161,6167,6169,6175,6177,6181,6182,6187,6189,6193,6194,6198,6200,6204,6205,6210,6212,6216,6218,6223,6225],{"type":1444,"nodeName":1461,"attributes":6072,"children":6074},{"id":6073},"page-20",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6077,"children":6078},{"class":1493},[6079,6083],{"type":1444,"nodeName":1452,"attributes":6080,"children":6081},{"href":1518},[6082],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":6086,"children":6087},{"class":5964},[6088,6092],{"type":1444,"nodeName":1452,"attributes":6089,"children":6090},{"class":5220,"id":214,"href":1714},[6091],{"type":1449,"textContent":1717},{"type":1449,"textContent":6093}," URI Comparison",{"type":1449,"textContent":6095},"\n\n   When comparing two URIs to decide if they match or not, a client\n   SHOULD use a case-sensitive octet-by-octet comparison of the entire\n   URIs, with these exceptions:\n\n      - A port that is empty or not given is equivalent to the default\n        port for that URI-reference;\n\n        - Comparisons of host names MUST be case-insensitive;\n\n        - Comparisons of scheme names MUST be case-insensitive;\n\n        - An empty abs_path is equivalent to an abs_path of \"\u002F\".\n\n   Characters other than those in the \"reserved\" and \"unsafe\" sets (see\n   ",{"type":1444,"nodeName":1452,"attributes":6097,"children":6098},{"href":5983},[6099],{"type":1449,"textContent":5986},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6102,"children":6103},{"href":5990},[6104],{"type":1449,"textContent":2220},{"type":1449,"textContent":6106},"]) are equivalent to their \"\"%\" HEX HEX\" encoding.\n\n   For example, the following three URIs are equivalent:\n\n      ",{"type":1444,"nodeName":1452,"attributes":6108,"children":6110},{"href":6109},"http:\u002F\u002Fabc.com:80\u002F~smith\u002Fhome.html",[6111],{"type":1449,"textContent":6109},{"type":1449,"textContent":6113},"\n      ",{"type":1444,"nodeName":1452,"attributes":6115,"children":6117},{"href":6116},"http:\u002F\u002FABC.com\u002F%7Esmith\u002Fhome.html",[6118],{"type":1449,"textContent":6116},{"type":1449,"textContent":6113},{"type":1444,"nodeName":1452,"attributes":6121,"children":6123},{"href":6122},"http:\u002F\u002FABC.com:\u002F%7esmith\u002Fhome.html",[6124],{"type":1449,"textContent":6122},{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":6127,"children":6128},{"class":5228},[6129,6133],{"type":1444,"nodeName":1452,"attributes":6130,"children":6131},{"class":5220,"id":219,"href":1729},[6132],{"type":1449,"textContent":1732},{"type":1449,"textContent":6134}," Date\u002FTime Formats",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":6137,"children":6138},{"class":5964},[6139,6143],{"type":1444,"nodeName":1452,"attributes":6140,"children":6141},{"class":5220,"id":225,"href":1742},[6142],{"type":1449,"textContent":1745},{"type":1449,"textContent":6144}," Full Date",{"type":1449,"textContent":6146},"\n\n   HTTP applications have historically allowed three different formats\n   for the representation of date\u002Ftime stamps:\n\n      Sun, 06 Nov 1994 08:49:37 GMT  ; ",{"type":1444,"nodeName":1452,"attributes":6148,"children":6149},{"href":5662},[6150],{"type":1449,"textContent":5665},{"type":1449,"textContent":6152},", updated by ",{"type":1444,"nodeName":1452,"attributes":6154,"children":6156},{"href":6155},"\u002Finfo\u002Frfc1123\u002F",[6157],{"type":1449,"textContent":6158},"RFC 1123",{"type":1449,"textContent":6160},"\n      Sunday, 06-Nov-94 08:49:37 GMT ; ",{"type":1444,"nodeName":1452,"attributes":6162,"children":6164},{"href":6163},"\u002Finfo\u002Frfc850\u002F",[6165],{"type":1449,"textContent":6166},"RFC 850",{"type":1449,"textContent":6168},", obsoleted by ",{"type":1444,"nodeName":1452,"attributes":6170,"children":6172},{"href":6171},"\u002Finfo\u002Frfc1036\u002F",[6173],{"type":1449,"textContent":6174},"RFC 1036",{"type":1449,"textContent":6176},"\n      Sun Nov  6 08:49:37 1994       ; ANSI C's asctime() format\n\n   The first format is preferred as an Internet standard and represents\n   a fixed-length subset of that defined by ",{"type":1444,"nodeName":1452,"attributes":6178,"children":6179},{"href":6155},[6180],{"type":1449,"textContent":6158},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6183,"children":6185},{"href":6184},"#ref-8",[6186],{"type":1449,"textContent":1568},{"type":1449,"textContent":6188},"] (an update to\n   ",{"type":1444,"nodeName":1452,"attributes":6190,"children":6191},{"href":5662},[6192],{"type":1449,"textContent":5665},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6195,"children":6196},{"href":5308},[6197],{"type":1449,"textContent":2427},{"type":1449,"textContent":6199},"]). The second format is in common use, but is based on the\n   obsolete ",{"type":1444,"nodeName":1452,"attributes":6201,"children":6202},{"href":6163},[6203],{"type":1449,"textContent":6166},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6206,"children":6208},{"href":6207},"#ref-12",[6209],{"type":1449,"textContent":1596},{"type":1449,"textContent":6211},"] date format and lacks a four-digit year.\n   HTTP\u002F1.1 clients and servers that parse the date value MUST accept\n   all three formats (for compatibility with HTTP\u002F1.0), though they MUST\n   only generate the ",{"type":1444,"nodeName":1452,"attributes":6213,"children":6214},{"href":6155},[6215],{"type":1449,"textContent":6158},{"type":1449,"textContent":6217}," format for representing HTTP-date values\n   in header fields. See ",{"type":1444,"nodeName":1452,"attributes":6219,"children":6220},{"href":4938},[6221],{"type":1449,"textContent":6222},"section 19.3",{"type":1449,"textContent":6224}," for further information.\n\n      Note: Recipients of date values are encouraged to be robust in\n      accepting date values that may have been sent by non-HTTP\n      applications, as is sometimes the case when retrieving or posting\n      messages via proxies\u002Fgateways to SMTP or NNTP.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6226,"children":6227},{"class":1493},[6228],{"type":1449,"textContent":6229},"Fielding, et al.            Standards Track                    [Page 20]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6232,"children":6233},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6235,"children":6236},{"class":1506},[6237,6241,6242,6250,6252,6257,6259,6264,6266,6270,6272,6276,6278,6287,6289,6298,6300],{"type":1444,"nodeName":1461,"attributes":6238,"children":6240},{"id":6239},"page-21",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6243,"children":6244},{"class":1493},[6245,6249],{"type":1444,"nodeName":1452,"attributes":6246,"children":6247},{"href":1518},[6248],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6251},"\n\n\n   All HTTP date\u002Ftime stamps MUST be represented in Greenwich Mean Time\n   (GMT), without exception. For the purposes of HTTP, GMT is exactly\n   equal to UTC (Coordinated Universal Time). This is indicated in the\n   first two formats by the inclusion of \"GMT\" as the three-letter\n   abbreviation for time zone, and MUST be assumed when reading the\n   asctime format. HTTP-date is case sensitive and MUST NOT include\n   additional LWS beyond that specifically included as SP in the\n   grammar.\n\n       HTTP-date    = ",{"type":1444,"nodeName":1452,"attributes":6253,"children":6254},{"href":6155},[6255],{"type":1449,"textContent":6256},"rfc1123",{"type":1449,"textContent":6258},"-date | ",{"type":1444,"nodeName":1452,"attributes":6260,"children":6261},{"href":6163},[6262],{"type":1449,"textContent":6263},"rfc850",{"type":1449,"textContent":6265},"-date | asctime-date\n       ",{"type":1444,"nodeName":1452,"attributes":6267,"children":6268},{"href":6155},[6269],{"type":1449,"textContent":6256},{"type":1449,"textContent":6271},"-date = wkday \",\" SP date1 SP time SP \"GMT\"\n       ",{"type":1444,"nodeName":1452,"attributes":6273,"children":6274},{"href":6163},[6275],{"type":1449,"textContent":6263},{"type":1449,"textContent":6277},"-date  = weekday \",\" SP date2 SP time SP \"GMT\"\n       asctime-date = wkday SP date3 SP time SP 4DIGIT\n       date1        = 2DIGIT SP month SP 4DIGIT\n                      ; day month year (e.g., 02 Jun 1982)\n       date2        = 2DIGIT \"-\" month \"-\" 2DIGIT\n                      ; day-month-year (e.g., 02-Jun-82)\n       date3        = month SP ( 2DIGIT | ( SP 1DIGIT ))\n                      ; month day (e.g., Jun  2)\n       time         = 2DIGIT \":\" 2DIGIT \":\" 2DIGIT\n                      ; 00:00:00 - 23:59:59\n       wkday        = \"Mon\" | \"Tue\" | \"Wed\"\n                    | \"Thu\" | \"Fri\" | \"Sat\" | \"Sun\"\n       weekday      = \"Monday\" | \"Tuesday\" | \"Wednesday\"\n                    | \"Thursday\" | \"Friday\" | \"Saturday\" | \"Sunday\"\n       month        = \"Jan\" | \"Feb\" | \"Mar\" | \"Apr\"\n                    | \"May\" | \"Jun\" | \"Jul\" | \"Aug\"\n                    | \"Sep\" | \"Oct\" | \"Nov\" | \"Dec\"\n\n      Note: HTTP requirements for the date\u002Ftime stamp format apply only\n      to their usage within the protocol stream. Clients and servers are\n      not required to use these formats for user presentation, request\n      logging, etc.\n\n",{"type":1444,"nodeName":1461,"attributes":6279,"children":6280},{"class":5964},[6281,6285],{"type":1444,"nodeName":1452,"attributes":6282,"children":6283},{"class":5220,"id":230,"href":1755},[6284],{"type":1449,"textContent":1758},{"type":1449,"textContent":6286}," Delta Seconds",{"type":1449,"textContent":6288},"\n\n   Some HTTP header fields allow a time value to be specified as an\n   integer number of seconds, represented in decimal, after the time\n   that the message was received.\n\n       delta-seconds  = 1*DIGIT\n\n",{"type":1444,"nodeName":1461,"attributes":6290,"children":6291},{"class":5228},[6292,6296],{"type":1444,"nodeName":1452,"attributes":6293,"children":6294},{"class":5220,"id":235,"href":1770},[6295],{"type":1449,"textContent":1773},{"type":1449,"textContent":6297}," Character Sets",{"type":1449,"textContent":6299},"\n\n   HTTP uses the same definition of the term \"character set\" as that\n   described for MIME:\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6301,"children":6302},{"class":1493},[6303],{"type":1449,"textContent":6304},"Fielding, et al.            Standards Track                    [Page 21]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6307,"children":6308},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6310,"children":6311},{"class":1506},[6312,6316,6317,6325,6327,6331,6333,6337,6339,6344,6346,6351,6353,6362,6364],{"type":1444,"nodeName":1461,"attributes":6313,"children":6315},{"id":6314},"page-22",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6318,"children":6319},{"class":1493},[6320,6324],{"type":1444,"nodeName":1452,"attributes":6321,"children":6322},{"href":1518},[6323],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6326},"\n\n\n   The term \"character set\" is used in this document to refer to a\n   method used with one or more tables to convert a sequence of octets\n   into a sequence of characters. Note that unconditional conversion in\n   the other direction is not required, in that not all characters may\n   be available in a given character set and a character set may provide\n   more than one sequence of octets to represent a particular character.\n   This definition is intended to allow various kinds of character\n   encoding, from simple single-table mappings such as US-ASCII to\n   complex table switching methods such as those that use ISO-2022's\n   techniques. However, the definition associated with a MIME character\n   set name MUST fully specify the mapping to be performed from octets\n   to characters. In particular, use of external profiling information\n   to determine the exact mapping is not permitted.\n\n      Note: This use of the term \"character set\" is more commonly\n      referred to as a \"character encoding.\" However, since HTTP and\n      MIME share the same registry, it is important that the terminology\n      also be shared.\n\n   HTTP character sets are identified by case-insensitive tokens. The\n   complete set of tokens is defined by the IANA Character Set registry\n   [",{"type":1444,"nodeName":1452,"attributes":6328,"children":6329},{"href":5600},[6330],{"type":1449,"textContent":1697},{"type":1449,"textContent":6332},"].\n\n       charset = token\n\n   Although HTTP allows an arbitrary token to be used as a charset\n   value, any token that has a predefined value within the IANA\n   Character Set registry [",{"type":1444,"nodeName":1452,"attributes":6334,"children":6335},{"href":5600},[6336],{"type":1449,"textContent":1697},{"type":1449,"textContent":6338},"] MUST represent the character set defined\n   by that registry. Applications SHOULD limit their use of character\n   sets to those defined by the IANA registry.\n\n   Implementors should be aware of IETF character set requirements [",{"type":1444,"nodeName":1452,"attributes":6340,"children":6342},{"href":6341},"#ref-38",[6343],{"type":1449,"textContent":2109},{"type":1449,"textContent":6345},"]\n   [",{"type":1444,"nodeName":1452,"attributes":6347,"children":6349},{"href":6348},"#ref-41",[6350],{"type":1449,"textContent":2178},{"type":1449,"textContent":6352},"].\n\n",{"type":1444,"nodeName":1461,"attributes":6354,"children":6355},{"class":5964},[6356,6360],{"type":1444,"nodeName":1452,"attributes":6357,"children":6358},{"class":5220,"id":241,"href":1783},[6359],{"type":1449,"textContent":1786},{"type":1449,"textContent":6361}," Missing Charset",{"type":1449,"textContent":6363},"\n\n   Some HTTP\u002F1.0 software has interpreted a Content-Type header without\n   charset parameter incorrectly to mean \"recipient should guess.\"\n   Senders wishing to defeat this behavior MAY include a charset\n   parameter even when the charset is ISO-8859-1 and SHOULD do so when\n   it is known that it will not confuse the recipient.\n\n   Unfortunately, some older HTTP\u002F1.0 clients did not deal properly with\n   an explicit charset parameter. HTTP\u002F1.1 recipients MUST respect the\n   charset label provided by the sender; and those user agents that have\n   a provision to \"guess\" a charset MUST use the charset from the\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6365,"children":6366},{"class":1493},[6367],{"type":1449,"textContent":6368},"Fielding, et al.            Standards Track                    [Page 22]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6371,"children":6372},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6374,"children":6375},{"class":1506},[6376,6380,6381,6389,6391,6396,6398,6407,6409,6414,6416,6421,6423,6429,6430,6435,6437,6443,6444,6449,6451,6457,6458,6463,6464],{"type":1444,"nodeName":1461,"attributes":6377,"children":6379},{"id":6378},"page-23",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6382,"children":6383},{"class":1493},[6384,6388],{"type":1444,"nodeName":1452,"attributes":6385,"children":6386},{"href":1518},[6387],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6390},"\n\n\n   content-type field if they support that charset, rather than the\n   recipient's preference, when initially displaying a document. See\n   ",{"type":1444,"nodeName":1452,"attributes":6392,"children":6393},{"href":1858},[6394],{"type":1449,"textContent":6395},"section 3.7.1",{"type":1449,"textContent":6397},".\n\n",{"type":1444,"nodeName":1461,"attributes":6399,"children":6400},{"class":5228},[6401,6405],{"type":1444,"nodeName":1452,"attributes":6402,"children":6403},{"class":5220,"id":246,"href":1798},[6404],{"type":1449,"textContent":1801},{"type":1449,"textContent":6406}," Content Codings",{"type":1449,"textContent":6408},"\n\n   Content coding values indicate an encoding transformation that has\n   been or can be applied to an entity. Content codings are primarily\n   used to allow a document to be compressed or otherwise usefully\n   transformed without losing the identity of its underlying media type\n   and without loss of information. Frequently, the entity is stored in\n   coded form, transmitted directly, and only decoded by the recipient.\n\n       content-coding   = token\n\n   All content-coding values are case-insensitive. HTTP\u002F1.1 uses\n   content-coding values in the Accept-Encoding (",{"type":1444,"nodeName":1452,"attributes":6410,"children":6411},{"href":3865},[6412],{"type":1449,"textContent":6413},"section 14.3",{"type":1449,"textContent":6415},") and\n   Content-Encoding (",{"type":1444,"nodeName":1452,"attributes":6417,"children":6418},{"href":4071},[6419],{"type":1449,"textContent":6420},"section 14.11",{"type":1449,"textContent":6422},") header fields. Although the value\n   describes the content-coding, what is more important is that it\n   indicates what decoding mechanism will be required to remove the\n   encoding.\n\n   The Internet Assigned Numbers Authority (IANA) acts as a registry for\n   content-coding value tokens. Initially, the registry contains the\n   following tokens:\n\n   gzip An encoding format produced by the file compression program\n        \"gzip\" (GNU zip) as described in ",{"type":1444,"nodeName":1452,"attributes":6424,"children":6426},{"href":6425},"\u002Finfo\u002Frfc1952\u002F",[6427],{"type":1449,"textContent":6428},"RFC 1952",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6431,"children":6433},{"href":6432},"#ref-25",[6434],{"type":1449,"textContent":1839},{"type":1449,"textContent":6436},"]. This format is a\n        Lempel-Ziv coding (LZ77) with a 32 bit CRC.\n\n   compress\n        The encoding format produced by the common UNIX file compression\n        program \"compress\". This format is an adaptive Lempel-Ziv-Welch\n        coding (LZW).\n\n        Use of program names for the identification of encoding formats\n        is not desirable and is discouraged for future encodings. Their\n        use here is representative of historical practice, not good\n        design. For compatibility with previous implementations of HTTP,\n        applications SHOULD consider \"x-gzip\" and \"x-compress\" to be\n        equivalent to \"gzip\" and \"compress\" respectively.\n\n   deflate\n        The \"zlib\" format defined in ",{"type":1444,"nodeName":1452,"attributes":6438,"children":6440},{"href":6439},"\u002Finfo\u002Frfc1950\u002F",[6441],{"type":1449,"textContent":6442},"RFC 1950",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6445,"children":6447},{"href":6446},"#ref-31",[6448],{"type":1449,"textContent":1968},{"type":1449,"textContent":6450},"] in combination with\n        the \"deflate\" compression mechanism described in ",{"type":1444,"nodeName":1452,"attributes":6452,"children":6454},{"href":6453},"\u002Finfo\u002Frfc1951\u002F",[6455],{"type":1449,"textContent":6456},"RFC 1951",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6459,"children":6461},{"href":6460},"#ref-29",[6462],{"type":1449,"textContent":1912},{"type":1449,"textContent":1490},{"type":1444,"nodeName":1461,"attributes":6465,"children":6466},{"class":1493},[6467],{"type":1449,"textContent":6468},"Fielding, et al.            Standards Track                    [Page 23]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6471,"children":6472},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6474,"children":6475},{"class":1506},[6476,6480,6481,6489,6491,6500,6502,6507,6509,6514,6516,6521,6523,6527,6529,6534,6536],{"type":1444,"nodeName":1461,"attributes":6477,"children":6479},{"id":6478},"page-24",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6482,"children":6483},{"class":1493},[6484,6488],{"type":1444,"nodeName":1452,"attributes":6485,"children":6486},{"href":1518},[6487],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6490},"\n\n\n   identity\n        The default (identity) encoding; the use of no transformation\n        whatsoever. This content-coding is used only in the Accept-\n        Encoding header, and SHOULD NOT be used in the Content-Encoding\n        header.\n\n   New content-coding value tokens SHOULD be registered; to allow\n   interoperability between clients and servers, specifications of the\n   content coding algorithms needed to implement a new value SHOULD be\n   publicly available and adequate for independent implementation, and\n   conform to the purpose of content coding defined in this section.\n\n",{"type":1444,"nodeName":1461,"attributes":6492,"children":6493},{"class":5228},[6494,6498],{"type":1444,"nodeName":1452,"attributes":6495,"children":6496},{"class":5220,"id":251,"href":1813},[6497],{"type":1449,"textContent":1816},{"type":1449,"textContent":6499}," Transfer Codings",{"type":1449,"textContent":6501},"\n\n   Transfer-coding values are used to indicate an encoding\n   transformation that has been, can be, or may need to be applied to an\n   entity-body in order to ensure \"safe transport\" through the network.\n   This differs from a content coding in that the transfer-coding is a\n   property of the message, not of the original entity.\n\n       transfer-coding         = \"chunked\" | transfer-extension\n       transfer-extension      = token *( \";\" parameter )\n\n   Parameters are in  the form of attribute\u002Fvalue pairs.\n\n       parameter               = attribute \"=\" value\n       attribute               = token\n       value                   = token | quoted-string\n\n   All transfer-coding values are case-insensitive. HTTP\u002F1.1 uses\n   transfer-coding values in the TE header field (",{"type":1444,"nodeName":1452,"attributes":6503,"children":6504},{"href":4544},[6505],{"type":1449,"textContent":6506},"section 14.39",{"type":1449,"textContent":6508},") and in\n   the Transfer-Encoding header field (",{"type":1444,"nodeName":1452,"attributes":6510,"children":6511},{"href":4574},[6512],{"type":1449,"textContent":6513},"section 14.41",{"type":1449,"textContent":6515},").\n\n   Whenever a transfer-coding is applied to a message-body, the set of\n   transfer-codings MUST include \"chunked\", unless the message is\n   terminated by closing the connection. When the \"chunked\" transfer-\n   coding is used, it MUST be the last transfer-coding applied to the\n   message-body. The \"chunked\" transfer-coding MUST NOT be applied more\n   than once to a message-body. These rules allow the recipient to\n   determine the transfer-length of the message (",{"type":1444,"nodeName":1452,"attributes":6517,"children":6518},{"href":2013},[6519],{"type":1449,"textContent":6520},"section 4.4",{"type":1449,"textContent":6522},").\n\n   Transfer-codings are analogous to the Content-Transfer-Encoding\n   values of MIME [",{"type":1444,"nodeName":1452,"attributes":6524,"children":6525},{"href":5315},[6526],{"type":1449,"textContent":1539},{"type":1449,"textContent":6528},"], which were designed to enable safe transport of\n   binary data over a 7-bit transport service. However, safe transport\n   has a different focus for an 8bit-clean transfer protocol. In HTTP,\n   the only unsafe characteristic of message-bodies is the difficulty in\n   determining the exact body length (",{"type":1444,"nodeName":1452,"attributes":6530,"children":6531},{"href":2265},[6532],{"type":1449,"textContent":6533},"section 7.2.2",{"type":1449,"textContent":6535},"), or the desire to\n   encrypt data over a shared transport.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6537,"children":6538},{"class":1493},[6539],{"type":1449,"textContent":6540},"Fielding, et al.            Standards Track                    [Page 24]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6543,"children":6544},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6546,"children":6547},{"class":1506},[6548,6552,6553,6561,6563,6568,6570,6575,6576,6581,6583,6588,6590,6594,6596,6600,6602,6606,6608,6617,6619,6624,6626],{"type":1444,"nodeName":1461,"attributes":6549,"children":6551},{"id":6550},"page-25",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6554,"children":6555},{"class":1493},[6556,6560],{"type":1444,"nodeName":1452,"attributes":6557,"children":6558},{"href":1518},[6559],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6562},"\n\n\n   The Internet Assigned Numbers Authority (IANA) acts as a registry for\n   transfer-coding value tokens. Initially, the registry contains the\n   following tokens: \"chunked\" (",{"type":1444,"nodeName":1452,"attributes":6564,"children":6565},{"href":1828},[6566],{"type":1449,"textContent":6567},"section 3.6.1",{"type":1449,"textContent":6569},"), \"identity\" (",{"type":1444,"nodeName":1452,"attributes":6571,"children":6573},{"href":6572},"#section-3.6.2",[6574],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":6577,"children":6578},{"href":6572},[6579],{"type":1449,"textContent":6580},"3.6.2",{"type":1449,"textContent":6582},"), \"gzip\" (",{"type":1444,"nodeName":1452,"attributes":6584,"children":6585},{"href":1798},[6586],{"type":1449,"textContent":6587},"section 3.5",{"type":1449,"textContent":6589},"), \"compress\" (",{"type":1444,"nodeName":1452,"attributes":6591,"children":6592},{"href":1798},[6593],{"type":1449,"textContent":6587},{"type":1449,"textContent":6595},"), and \"deflate\"\n   (",{"type":1444,"nodeName":1452,"attributes":6597,"children":6598},{"href":1798},[6599],{"type":1449,"textContent":6587},{"type":1449,"textContent":6601},").\n\n   New transfer-coding value tokens SHOULD be registered in the same way\n   as new content-coding value tokens (",{"type":1444,"nodeName":1452,"attributes":6603,"children":6604},{"href":1798},[6605],{"type":1449,"textContent":6587},{"type":1449,"textContent":6607},").\n\n   A server which receives an entity-body with a transfer-coding it does\n   not understand SHOULD return 501 (Unimplemented), and close the\n   connection. A server MUST NOT send transfer-codings to an HTTP\u002F1.0\n   client.\n\n",{"type":1444,"nodeName":1461,"attributes":6609,"children":6610},{"class":5964},[6611,6615],{"type":1444,"nodeName":1452,"attributes":6612,"children":6613},{"class":5220,"id":257,"href":1828},[6614],{"type":1449,"textContent":1831},{"type":1449,"textContent":6616}," Chunked Transfer Coding",{"type":1449,"textContent":6618},"\n\n   The chunked encoding modifies the body of a message in order to\n   transfer it as a series of chunks, each with its own size indicator,\n   followed by an OPTIONAL trailer containing entity-header fields. This\n   allows dynamically produced content to be transferred along with the\n   information necessary for the recipient to verify that it has\n   received the full message.\n\n       Chunked-Body   = *chunk\n                        last-chunk\n                        trailer\n                        CRLF\n\n       chunk          = chunk-size [ chunk-extension ] CRLF\n                        chunk-data CRLF\n       chunk-size     = 1*HEX\n       last-chunk     = 1*(\"0\") [ chunk-extension ] CRLF\n\n       chunk-extension= *( \";\" chunk-ext-name [ \"=\" chunk-ext-val ] )\n       chunk-ext-name = token\n       chunk-ext-val  = token | quoted-string\n       chunk-data     = chunk-size(OCTET)\n       trailer        = *(entity-header CRLF)\n\n   The chunk-size field is a string of hex digits indicating the size of\n   the chunk. The chunked encoding is ended by any chunk whose size is\n   zero, followed by the trailer, which is terminated by an empty line.\n\n   The trailer allows the sender to include additional HTTP header\n   fields at the end of the message. The Trailer header field can be\n   used to indicate which header fields are included in a trailer (see\n   ",{"type":1444,"nodeName":1452,"attributes":6620,"children":6621},{"href":4559},[6622],{"type":1449,"textContent":6623},"section 14.40",{"type":1449,"textContent":6625},").\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6627,"children":6628},{"class":1493},[6629],{"type":1449,"textContent":6630},"Fielding, et al.            Standards Track                    [Page 25]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6633,"children":6634},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6636,"children":6637},{"class":1506},[6638,6642,6643,6651,6653,6657,6659,6668,6670,6675,6677,6681,6682,6686,6688,6693,6695,6700,6702],{"type":1444,"nodeName":1461,"attributes":6639,"children":6641},{"id":6640},"page-26",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6644,"children":6645},{"class":1493},[6646,6650],{"type":1444,"nodeName":1452,"attributes":6647,"children":6648},{"href":1518},[6649],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6652},"\n\n\n   A server using chunked transfer-coding in a response MUST NOT use the\n   trailer for any header fields unless at least one of the following is\n   true:\n\n   a)the request included a TE header field that indicates \"trailers\" is\n     acceptable in the transfer-coding of the  response, as described in\n     ",{"type":1444,"nodeName":1452,"attributes":6654,"children":6655},{"href":4544},[6656],{"type":1449,"textContent":6506},{"type":1449,"textContent":6658},"; or,\n\n   b)the server is the origin server for the response, the trailer\n     fields consist entirely of optional metadata, and the recipient\n     could use the message (in a manner acceptable to the origin server)\n     without receiving this metadata.  In other words, the origin server\n     is willing to accept the possibility that the trailer fields might\n     be silently discarded along the path to the client.\n\n   This requirement prevents an interoperability failure when the\n   message is being received by an HTTP\u002F1.1 (or later) proxy and\n   forwarded to an HTTP\u002F1.0 recipient. It avoids a situation where\n   compliance with the protocol would have necessitated a possibly\n   infinite buffer on the proxy.\n\n   An example process for decoding a Chunked-Body is presented in\n   appendix 19.4.6.\n\n   All HTTP\u002F1.1 applications MUST be able to receive and decode the\n   \"chunked\" transfer-coding, and MUST ignore chunk-extension extensions\n   they do not understand.\n\n",{"type":1444,"nodeName":1461,"attributes":6660,"children":6661},{"class":5228},[6662,6666],{"type":1444,"nodeName":1452,"attributes":6663,"children":6664},{"class":5220,"id":262,"href":1843},[6665],{"type":1449,"textContent":1846},{"type":1449,"textContent":6667}," Media Types",{"type":1449,"textContent":6669},"\n\n   HTTP uses Internet Media Types [",{"type":1444,"nodeName":1452,"attributes":6671,"children":6673},{"href":6672},"#ref-17",[6674],{"type":1449,"textContent":1654},{"type":1449,"textContent":6676},"] in the Content-Type (",{"type":1444,"nodeName":1452,"attributes":6678,"children":6679},{"href":4159},[6680],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":6683,"children":6684},{"href":4159},[6685],{"type":1449,"textContent":4162},{"type":1449,"textContent":6687},") and Accept (",{"type":1444,"nodeName":1452,"attributes":6689,"children":6690},{"href":3837},[6691],{"type":1449,"textContent":6692},"section 14.1",{"type":1449,"textContent":6694},") header fields in order to provide\n   open and extensible data typing and type negotiation.\n\n       media-type     = type \"\u002F\" subtype *( \";\" parameter )\n       type           = token\n       subtype        = token\n\n   Parameters MAY follow the type\u002Fsubtype in the form of attribute\u002Fvalue\n   pairs (as defined in ",{"type":1444,"nodeName":1452,"attributes":6696,"children":6697},{"href":1813},[6698],{"type":1449,"textContent":6699},"section 3.6",{"type":1449,"textContent":6701},").\n\n   The type, subtype, and parameter attribute names are case-\n   insensitive. Parameter values might or might not be case-sensitive,\n   depending on the semantics of the parameter name. Linear white space\n   (LWS) MUST NOT be used between the type and subtype, nor between an\n   attribute and its value. The presence or absence of a parameter might\n   be significant to the processing of a media-type, depending on its\n   definition within the media type registry.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6703,"children":6704},{"class":1493},[6705],{"type":1449,"textContent":6706},"Fielding, et al.            Standards Track                    [Page 26]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6709,"children":6710},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6712,"children":6713},{"class":1506},[6714,6718,6719,6727,6729,6733,6735,6741,6742,6746,6748,6757,6759,6764,6766,6771,6773,6782,6784,6790,6791],{"type":1444,"nodeName":1461,"attributes":6715,"children":6717},{"id":6716},"page-27",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6720,"children":6721},{"class":1493},[6722,6726],{"type":1444,"nodeName":1452,"attributes":6723,"children":6724},{"href":1518},[6725],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6728},"\n\n\n   Note that some older HTTP applications do not recognize media type\n   parameters. When sending data to older HTTP applications,\n   implementations SHOULD only use media type parameters when they are\n   required by that type\u002Fsubtype definition.\n\n   Media-type values are registered with the Internet Assigned Number\n   Authority (IANA [",{"type":1444,"nodeName":1452,"attributes":6730,"children":6731},{"href":5600},[6732],{"type":1449,"textContent":1697},{"type":1449,"textContent":6734},"]). The media type registration process is\n   outlined in ",{"type":1444,"nodeName":1452,"attributes":6736,"children":6738},{"href":6737},"\u002Finfo\u002Frfc1590\u002F",[6739],{"type":1449,"textContent":6740},"RFC 1590",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6743,"children":6744},{"href":6672},[6745],{"type":1449,"textContent":1654},{"type":1449,"textContent":6747},"]. Use of non-registered media types is\n   discouraged.\n\n",{"type":1444,"nodeName":1461,"attributes":6749,"children":6750},{"class":5964},[6751,6755],{"type":1444,"nodeName":1452,"attributes":6752,"children":6753},{"class":5220,"id":268,"href":1858},[6754],{"type":1449,"textContent":1861},{"type":1449,"textContent":6756}," Canonicalization and Text Defaults",{"type":1449,"textContent":6758},"\n\n   Internet media types are registered with a canonical form. An\n   entity-body transferred via HTTP messages MUST be represented in the\n   appropriate canonical form prior to its transmission except for\n   \"text\" types, as defined in the next paragraph.\n\n   When in canonical form, media subtypes of the \"text\" type use CRLF as\n   the text line break. HTTP relaxes this requirement and allows the\n   transport of text media with plain CR or LF alone representing a line\n   break when it is done consistently for an entire entity-body. HTTP\n   applications MUST accept CRLF, bare CR, and bare LF as being\n   representative of a line break in text media received via HTTP. In\n   addition, if the text is represented in a character set that does not\n   use octets 13 and 10 for CR and LF respectively, as is the case for\n   some multi-byte character sets, HTTP allows the use of whatever octet\n   sequences are defined by that character set to represent the\n   equivalent of CR and LF for line breaks. This flexibility regarding\n   line breaks applies only to text media in the entity-body; a bare CR\n   or LF MUST NOT be substituted for CRLF within any of the HTTP control\n   structures (such as header fields and multipart boundaries).\n\n   If an entity-body is encoded with a content-coding, the underlying\n   data MUST be in a form defined above prior to being encoded.\n\n   The \"charset\" parameter is used with some media types to define the\n   character set (",{"type":1444,"nodeName":1452,"attributes":6760,"children":6761},{"href":1770},[6762],{"type":1449,"textContent":6763},"section 3.4",{"type":1449,"textContent":6765},") of the data. When no explicit charset\n   parameter is provided by the sender, media subtypes of the \"text\"\n   type are defined to have a default charset value of \"ISO-8859-1\" when\n   received via HTTP. Data in character sets other than \"ISO-8859-1\" or\n   its subsets MUST be labeled with an appropriate charset value. See\n   ",{"type":1444,"nodeName":1452,"attributes":6767,"children":6768},{"href":1783},[6769],{"type":1449,"textContent":6770},"section 3.4.1",{"type":1449,"textContent":6772}," for compatibility problems.\n\n",{"type":1444,"nodeName":1461,"attributes":6774,"children":6775},{"class":5964},[6776,6780],{"type":1444,"nodeName":1452,"attributes":6777,"children":6778},{"class":5220,"id":273,"href":1873},[6779],{"type":1449,"textContent":1876},{"type":1449,"textContent":6781}," Multipart Types",{"type":1449,"textContent":6783},"\n\n   MIME provides for a number of \"multipart\" types -- encapsulations of\n   one or more entities within a single message-body. All multipart\n   types share a common syntax, as defined in ",{"type":1444,"nodeName":1452,"attributes":6785,"children":6787},{"href":6786},"\u002Finfo\u002Frfc2046\u002F#section-5.1.1",[6788],{"type":1449,"textContent":6789},"section 5.1.1 of RFC 2046",{"type":1449,"textContent":2180},{"type":1444,"nodeName":1461,"attributes":6792,"children":6793},{"class":1493},[6794],{"type":1449,"textContent":6795},"Fielding, et al.            Standards Track                    [Page 27]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6798,"children":6799},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6801,"children":6802},{"class":1506},[6803,6807,6808,6816,6818,6824,6826,6832,6834,6838,6840,6844,6846,6852,6853,6858,6859,6868,6870],{"type":1444,"nodeName":1461,"attributes":6804,"children":6806},{"id":6805},"page-28",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6809,"children":6810},{"class":1493},[6811,6815],{"type":1444,"nodeName":1452,"attributes":6812,"children":6813},{"href":1518},[6814],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6817},"\n\n\n   [",{"type":1444,"nodeName":1452,"attributes":6819,"children":6821},{"href":6820},"#ref-40",[6822],{"type":1449,"textContent":6823},"40",{"type":1449,"textContent":6825},"], and MUST include a boundary parameter as part of the media type\n   value. The message body is itself a protocol element and MUST\n   therefore use only CRLF to represent line breaks between body-parts.\n   Unlike in ",{"type":1444,"nodeName":1452,"attributes":6827,"children":6829},{"href":6828},"\u002Finfo\u002Frfc2046\u002F",[6830],{"type":1449,"textContent":6831},"RFC 2046",{"type":1449,"textContent":6833},", the epilogue of any multipart message MUST be\n   empty; HTTP applications MUST NOT transmit the epilogue (even if the\n   original multipart contains an epilogue). These restrictions exist in\n   order to preserve the self-delimiting nature of a multipart message-\n   body, wherein the \"end\" of the message-body is indicated by the\n   ending multipart boundary.\n\n   In general, HTTP treats a multipart message-body no differently than\n   any other media type: strictly as payload. The one exception is the\n   \"multipart\u002Fbyteranges\" type (appendix 19.2) when it appears in a 206\n   (Partial Content) response, which will be interpreted by some HTTP\n   caching mechanisms as described in sections ",{"type":1444,"nodeName":1452,"attributes":6835,"children":6836},{"href":3696},[6837],{"type":1449,"textContent":3699},{"type":1449,"textContent":6839}," and ",{"type":1444,"nodeName":1452,"attributes":6841,"children":6842},{"href":4144},[6843],{"type":1449,"textContent":4147},{"type":1449,"textContent":6845},". In all\n   other cases, an HTTP user agent SHOULD follow the same or similar\n   behavior as a MIME user agent would upon receipt of a multipart type.\n   The MIME header fields within each body-part of a multipart message-\n   body do not have any significance to HTTP beyond that defined by\n   their MIME semantics.\n\n   In general, an HTTP user agent SHOULD follow the same or similar\n   behavior as a MIME user agent would upon receipt of a multipart type.\n   If an application receives an unrecognized multipart subtype, the\n   application MUST treat it as being equivalent to \"multipart\u002Fmixed\".\n\n      Note: The \"multipart\u002Fform-data\" type has been specifically defined\n      for carrying form data suitable for processing via the POST\n      request method, as described in ",{"type":1444,"nodeName":1452,"attributes":6847,"children":6849},{"href":6848},"\u002Finfo\u002Frfc1867\u002F",[6850],{"type":1449,"textContent":6851},"RFC 1867",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6854,"children":6856},{"href":6855},"#ref-15",[6857],{"type":1449,"textContent":1639},{"type":1449,"textContent":6352},{"type":1444,"nodeName":1461,"attributes":6860,"children":6861},{"class":5228},[6862,6866],{"type":1444,"nodeName":1452,"attributes":6863,"children":6864},{"class":5220,"id":278,"href":1886},[6865],{"type":1449,"textContent":1889},{"type":1449,"textContent":6867}," Product Tokens",{"type":1449,"textContent":6869},"\n\n   Product tokens are used to allow communicating applications to\n   identify themselves by software name and version. Most fields using\n   product tokens also allow sub-products which form a significant part\n   of the application to be listed, separated by white space. By\n   convention, the products are listed in order of their significance\n   for identifying the application.\n\n       product         = token [\"\u002F\" product-version]\n       product-version = token\n\n   Examples:\n\n       User-Agent: CERN-LineMode\u002F2.15 libwww\u002F2.17b3\n       Server: Apache\u002F0.8.4\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6871,"children":6872},{"class":1493},[6873],{"type":1449,"textContent":6874},"Fielding, et al.            Standards Track                    [Page 28]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6877,"children":6878},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6880,"children":6881},{"class":1506},[6882,6886,6887,6895,6897,6906,6908,6912,6914,6923,6925,6931,6932,6937,6939],{"type":1444,"nodeName":1461,"attributes":6883,"children":6885},{"id":6884},"page-29",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6888,"children":6889},{"class":1493},[6890,6894],{"type":1444,"nodeName":1452,"attributes":6891,"children":6892},{"href":1518},[6893],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6896},"\n\n\n   Product tokens SHOULD be short and to the point. They MUST NOT be\n   used for advertising or other non-essential information. Although any\n   token character MAY appear in a product-version, this token SHOULD\n   only be used for a version identifier (i.e., successive versions of\n   the same product SHOULD only differ in the product-version portion of\n   the product value).\n\n",{"type":1444,"nodeName":1461,"attributes":6898,"children":6899},{"class":5228},[6900,6904],{"type":1444,"nodeName":1452,"attributes":6901,"children":6902},{"class":5220,"id":283,"href":1901},[6903],{"type":1449,"textContent":1904},{"type":1449,"textContent":6905}," Quality Values",{"type":1449,"textContent":6907},"\n\n   HTTP content negotiation (",{"type":1444,"nodeName":1452,"attributes":6909,"children":6910},{"href":3272},[6911],{"type":1449,"textContent":5457},{"type":1449,"textContent":6913},") uses short \"floating point\"\n   numbers to indicate the relative importance (\"weight\") of various\n   negotiable parameters.  A weight is normalized to a real number in\n   the range 0 through 1, where 0 is the minimum and 1 the maximum\n   value. If a parameter has a quality value of 0, then content with\n   this parameter is `not acceptable' for the client. HTTP\u002F1.1\n   applications MUST NOT generate more than three digits after the\n   decimal point. User configuration of these values SHOULD also be\n   limited in this fashion.\n\n       qvalue         = ( \"0\" [ \".\" 0*3DIGIT ] )\n                      | ( \"1\" [ \".\" 0*3(\"0\") ] )\n\n   \"Quality values\" is a misnomer, since these values merely represent\n   relative degradation in desired quality.\n\n",{"type":1444,"nodeName":1461,"attributes":6915,"children":6916},{"class":5228},[6917,6921],{"type":1444,"nodeName":1452,"attributes":6918,"children":6919},{"class":5220,"id":288,"href":1916},[6920],{"type":1449,"textContent":1919},{"type":1449,"textContent":6922}," Language Tags",{"type":1449,"textContent":6924},"\n\n   A language tag identifies a natural language spoken, written, or\n   otherwise conveyed by human beings for communication of information\n   to other human beings. Computer languages are explicitly excluded.\n   HTTP uses language tags within the Accept-Language and Content-\n   Language fields.\n\n   The syntax and registry of HTTP language tags is the same as that\n   defined by ",{"type":1444,"nodeName":1452,"attributes":6926,"children":6928},{"href":6927},"\u002Finfo\u002Frfc1766\u002F",[6929],{"type":1449,"textContent":6930},"RFC 1766",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":6933,"children":6935},{"href":6934},"#ref-1",[6936],{"type":1449,"textContent":1531},{"type":1449,"textContent":6938},"]. In summary, a language tag is composed of 1\n   or more parts: A primary language tag and a possibly empty series of\n   subtags:\n\n        language-tag  = primary-tag *( \"-\" subtag )\n        primary-tag   = 1*8ALPHA\n        subtag        = 1*8ALPHA\n\n   White space is not allowed within the tag and all tags are case-\n   insensitive. The name space of language tags is administered by the\n   IANA. Example tags include:\n\n       en, en-US, en-cockney, i-cherokee, x-pig-latin\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":6940,"children":6941},{"class":1493},[6942],{"type":1449,"textContent":6943},"Fielding, et al.            Standards Track                    [Page 29]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":6946,"children":6947},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":6949,"children":6950},{"class":1506},[6951,6955,6956,6964,6966,6975,6977,6981,6982,6986,6988,6993,6995,7000,7002,7007,7009,7014,7016,7025,7027,7032,7034,7039,7041],{"type":1444,"nodeName":1461,"attributes":6952,"children":6954},{"id":6953},"page-30",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":6957,"children":6958},{"class":1493},[6959,6963],{"type":1444,"nodeName":1452,"attributes":6960,"children":6961},{"href":1518},[6962],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":6965},"\n\n\n   where any two-letter primary-tag is an ISO-639 language abbreviation\n   and any two-letter initial subtag is an ISO-3166 country code. (The\n   last three tags above are not registered tags; all but the last are\n   examples of tags which could be registered in future.)\n\n",{"type":1444,"nodeName":1461,"attributes":6967,"children":6968},{"class":5228},[6969,6973],{"type":1444,"nodeName":1452,"attributes":6970,"children":6971},{"class":5220,"id":293,"href":1929},[6972],{"type":1449,"textContent":1932},{"type":1449,"textContent":6974}," Entity Tags",{"type":1449,"textContent":6976},"\n\n   Entity tags are used for comparing two or more entities from the same\n   requested resource. HTTP\u002F1.1 uses entity tags in the ETag (",{"type":1444,"nodeName":1452,"attributes":6978,"children":6979},{"href":4202},[6980],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":6983,"children":6984},{"href":4202},[6985],{"type":1449,"textContent":4205},{"type":1449,"textContent":6987},"), If-Match (",{"type":1444,"nodeName":1452,"attributes":6989,"children":6990},{"href":4299},[6991],{"type":1449,"textContent":6992},"section 14.24",{"type":1449,"textContent":6994},"), If-None-Match (",{"type":1444,"nodeName":1452,"attributes":6996,"children":6997},{"href":4329},[6998],{"type":1449,"textContent":6999},"section 14.26",{"type":1449,"textContent":7001},"), and\n   If-Range (",{"type":1444,"nodeName":1452,"attributes":7003,"children":7004},{"href":4344},[7005],{"type":1449,"textContent":7006},"section 14.27",{"type":1449,"textContent":7008},") header fields. The definition of how they\n   are used and compared as cache validators is in ",{"type":1444,"nodeName":1452,"attributes":7010,"children":7011},{"href":3596},[7012],{"type":1449,"textContent":7013},"section 13.3.3",{"type":1449,"textContent":7015},". An\n   entity tag consists of an opaque quoted string, possibly prefixed by\n   a weakness indicator.\n\n      entity-tag = [ weak ] opaque-tag\n      weak       = \"W\u002F\"\n      opaque-tag = quoted-string\n\n   A \"strong entity tag\" MAY be shared by two entities of a resource\n   only if they are equivalent by octet equality.\n\n   A \"weak entity tag,\" indicated by the \"W\u002F\" prefix, MAY be shared by\n   two entities of a resource only if the entities are equivalent and\n   could be substituted for each other with no significant change in\n   semantics. A weak entity tag can only be used for weak comparison.\n\n   An entity tag MUST be unique across all versions of all entities\n   associated with a particular resource. A given entity tag value MAY\n   be used for entities obtained by requests on different URIs. The use\n   of the same entity tag value in conjunction with entities obtained by\n   requests on different URIs does not imply the equivalence of those\n   entities.\n\n",{"type":1444,"nodeName":1461,"attributes":7017,"children":7018},{"class":5228},[7019,7023],{"type":1444,"nodeName":1452,"attributes":7020,"children":7021},{"class":5220,"id":298,"href":1944},[7022],{"type":1449,"textContent":1947},{"type":1449,"textContent":7024}," Range Units",{"type":1449,"textContent":7026},"\n\n   HTTP\u002F1.1 allows a client to request that only part (a range of) the\n   response entity be included within the response. HTTP\u002F1.1 uses range\n   units in the Range (",{"type":1444,"nodeName":1452,"attributes":7028,"children":7029},{"href":4458},[7030],{"type":1449,"textContent":7031},"section 14.35",{"type":1449,"textContent":7033},") and Content-Range (",{"type":1444,"nodeName":1452,"attributes":7035,"children":7036},{"href":4144},[7037],{"type":1449,"textContent":7038},"section 14.16",{"type":1449,"textContent":7040},")\n   header fields. An entity can be broken down into subranges according\n   to various structural units.\n\n      range-unit       = bytes-unit | other-range-unit\n      bytes-unit       = \"bytes\"\n      other-range-unit = token\n\n   The only range unit defined by HTTP\u002F1.1 is \"bytes\". HTTP\u002F1.1\n   implementations MAY ignore ranges specified using other units.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7042,"children":7043},{"class":1493},[7044],{"type":1449,"textContent":7045},"Fielding, et al.            Standards Track                    [Page 30]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7048,"children":7049},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7051,"children":7052},{"class":1506},[7053,7057,7058,7066,7068,7077,7078,7087,7089,7093,7095,7099,7101,7105,7106,7110,7112,7121,7123,7128,7130,7135,7137,7142,7144,7149,7151,7157,7158,7162,7164],{"type":1444,"nodeName":1461,"attributes":7054,"children":7056},{"id":7055},"page-31",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7059,"children":7060},{"class":1493},[7061,7065],{"type":1444,"nodeName":1452,"attributes":7062,"children":7063},{"href":1518},[7064],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7067},"\n\n\n   HTTP\u002F1.1 has been designed to allow implementations of applications\n   that do not depend on knowledge of ranges.\n\n",{"type":1444,"nodeName":1461,"attributes":7069,"children":7070},{"class":5216},[7071,7075],{"type":1444,"nodeName":1452,"attributes":7072,"children":7073},{"class":5220,"id":303,"href":1957},[7074],{"type":1449,"textContent":1960},{"type":1449,"textContent":7076}," HTTP Message",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":7079,"children":7080},{"class":5228},[7081,7085],{"type":1444,"nodeName":1452,"attributes":7082,"children":7083},{"class":5220,"id":309,"href":1972},[7084],{"type":1449,"textContent":1975},{"type":1449,"textContent":7086}," Message Types",{"type":1449,"textContent":7088},"\n\n   HTTP messages consist of requests from client to server and responses\n   from server to client.\n\n       HTTP-message   = Request | Response     ; HTTP\u002F1.1 messages\n\n   Request (",{"type":1444,"nodeName":1452,"attributes":7090,"children":7091},{"href":2042},[7092],{"type":1449,"textContent":5402},{"type":1449,"textContent":7094},") and Response (",{"type":1444,"nodeName":1452,"attributes":7096,"children":7097},{"href":2126},[7098],{"type":1449,"textContent":5409},{"type":1449,"textContent":7100},") messages use the generic\n   message format of ",{"type":1444,"nodeName":1452,"attributes":7102,"children":7103},{"href":5662},[7104],{"type":1449,"textContent":5665},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":7107,"children":7108},{"href":5308},[7109],{"type":1449,"textContent":2427},{"type":1449,"textContent":7111},"] for transferring entities (the payload\n   of the message). Both types of message consist of a start-line, zero\n   or more header fields (also known as \"headers\"), an empty line (i.e.,\n   a line with nothing preceding the CRLF) indicating the end of the\n   header fields, and possibly a message-body.\n\n        generic-message = start-line\n                          *(message-header CRLF)\n                          CRLF\n                          [ message-body ]\n        start-line      = Request-Line | Status-Line\n\n   In the interest of robustness, servers SHOULD ignore any empty\n   line(s) received where a Request-Line is expected. In other words, if\n   the server is reading the protocol stream at the beginning of a\n   message and receives a CRLF first, it should ignore the CRLF.\n\n   Certain buggy HTTP\u002F1.0 client implementations generate extra CRLF's\n   after a POST request. To restate what is explicitly forbidden by the\n   BNF, an HTTP\u002F1.1 client MUST NOT preface or follow a request with an\n   extra CRLF.\n\n",{"type":1444,"nodeName":1461,"attributes":7113,"children":7114},{"class":5228},[7115,7119],{"type":1444,"nodeName":1452,"attributes":7116,"children":7117},{"class":5220,"id":314,"href":1985},[7118],{"type":1449,"textContent":1988},{"type":1449,"textContent":7120}," Message Headers",{"type":1449,"textContent":7122},"\n\n   HTTP header fields, which include general-header (",{"type":1444,"nodeName":1452,"attributes":7124,"children":7125},{"href":2027},[7126],{"type":1449,"textContent":7127},"section 4.5",{"type":1449,"textContent":7129},"),\n   request-header (",{"type":1444,"nodeName":1452,"attributes":7131,"children":7132},{"href":2113},[7133],{"type":1449,"textContent":7134},"section 5.3",{"type":1449,"textContent":7136},"), response-header (",{"type":1444,"nodeName":1452,"attributes":7138,"children":7139},{"href":2167},[7140],{"type":1449,"textContent":7141},"section 6.2",{"type":1449,"textContent":7143},"), and\n   entity-header (",{"type":1444,"nodeName":1452,"attributes":7145,"children":7146},{"href":2224},[7147],{"type":1449,"textContent":7148},"section 7.1",{"type":1449,"textContent":7150},") fields, follow the same generic format as\n   that given in ",{"type":1444,"nodeName":1452,"attributes":7152,"children":7154},{"href":7153},"\u002Finfo\u002Frfc822\u002F#section-3.1",[7155],{"type":1449,"textContent":7156},"Section 3.1 of RFC 822",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":7159,"children":7160},{"href":5308},[7161],{"type":1449,"textContent":2427},{"type":1449,"textContent":7163},"]. Each header field consists\n   of a name followed by a colon (\":\") and the field value. Field names\n   are case-insensitive. The field value MAY be preceded by any amount\n   of LWS, though a single SP is preferred. Header fields can be\n   extended over multiple lines by preceding each extra line with at\n   least one SP or HT. Applications ought to follow \"common form\", where\n   one is known or indicated, when generating HTTP constructs, since\n   there might exist some implementations that fail to accept anything\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7165,"children":7166},{"class":1493},[7167],{"type":1449,"textContent":7168},"Fielding, et al.            Standards Track                    [Page 31]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7171,"children":7172},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7174,"children":7175},{"class":1506},[7176,7180,7181,7189,7191,7200,7202,7206,7207,7211,7213],{"type":1444,"nodeName":1461,"attributes":7177,"children":7179},{"id":7178},"page-32",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7182,"children":7183},{"class":1493},[7184,7188],{"type":1444,"nodeName":1452,"attributes":7185,"children":7186},{"href":1518},[7187],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7190},"\n\n\n   beyond the common forms.\n\n       message-header = field-name \":\" [ field-value ]\n       field-name     = token\n       field-value    = *( field-content | LWS )\n       field-content  = \u003Cthe OCTETs making up the field-value\n                        and consisting of either *TEXT or combinations\n                        of token, separators, and quoted-string>\n\n   The field-content does not include any leading or trailing LWS:\n   linear white space occurring before the first non-whitespace\n   character of the field-value or after the last non-whitespace\n   character of the field-value. Such leading or trailing LWS MAY be\n   removed without changing the semantics of the field value. Any LWS\n   that occurs between field-content MAY be replaced with a single SP\n   before interpreting the field value or forwarding the message\n   downstream.\n\n   The order in which header fields with differing field names are\n   received is not significant. However, it is \"good practice\" to send\n   general-header fields first, followed by request-header or response-\n   header fields, and ending with the entity-header fields.\n\n   Multiple message-header fields with the same field-name MAY be\n   present in a message if and only if the entire field-value for that\n   header field is defined as a comma-separated list [i.e., #(values)].\n   It MUST be possible to combine the multiple header fields into one\n   \"field-name: field-value\" pair, without changing the semantics of the\n   message, by appending each subsequent field-value to the first, each\n   separated by a comma. The order in which header fields with the same\n   field-name are received is therefore significant to the\n   interpretation of the combined field value, and thus a proxy MUST NOT\n   change the order of these field values when a message is forwarded.\n\n",{"type":1444,"nodeName":1461,"attributes":7192,"children":7193},{"class":5228},[7194,7198],{"type":1444,"nodeName":1452,"attributes":7195,"children":7196},{"class":5220,"id":319,"href":1998},[7197],{"type":1449,"textContent":2001},{"type":1449,"textContent":7199}," Message Body",{"type":1449,"textContent":7201},"\n\n   The message-body (if any) of an HTTP message is used to carry the\n   entity-body associated with the request or response. The message-body\n   differs from the entity-body only when a transfer-coding has been\n   applied, as indicated by the Transfer-Encoding header field (",{"type":1444,"nodeName":1452,"attributes":7203,"children":7204},{"href":4574},[7205],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":7208,"children":7209},{"href":4574},[7210],{"type":1449,"textContent":4577},{"type":1449,"textContent":7212},").\n\n       message-body = entity-body\n                    | \u003Centity-body encoded as per Transfer-Encoding>\n\n   Transfer-Encoding MUST be used to indicate any transfer-codings\n   applied by an application to ensure safe and proper transfer of the\n   message. Transfer-Encoding is a property of the message, not of the\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7214,"children":7215},{"class":1493},[7216],{"type":1449,"textContent":7217},"Fielding, et al.            Standards Track                    [Page 32]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7220,"children":7221},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7223,"children":7224},{"class":1506},[7225,7229,7230,7238,7240,7244,7246,7251,7253,7258,7260,7269,7271,7275,7277,7281,7283,7288,7290],{"type":1444,"nodeName":1461,"attributes":7226,"children":7228},{"id":7227},"page-33",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7231,"children":7232},{"class":1493},[7233,7237],{"type":1444,"nodeName":1452,"attributes":7234,"children":7235},{"href":1518},[7236],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7239},"\n\n\n   entity, and thus MAY be added or removed by any application along the\n   request\u002Fresponse chain. (However, ",{"type":1444,"nodeName":1452,"attributes":7241,"children":7242},{"href":1813},[7243],{"type":1449,"textContent":6699},{"type":1449,"textContent":7245}," places restrictions on\n   when certain transfer-codings may be used.)\n\n   The rules for when a message-body is allowed in a message differ for\n   requests and responses.\n\n   The presence of a message-body in a request is signaled by the\n   inclusion of a Content-Length or Transfer-Encoding header field in\n   the request's message-headers. A message-body MUST NOT be included in\n   a request if the specification of the request method (",{"type":1444,"nodeName":1452,"attributes":7247,"children":7248},{"href":2070},[7249],{"type":1449,"textContent":7250},"section 5.1.1",{"type":1449,"textContent":7252},")\n   does not allow sending an entity-body in requests. A server SHOULD\n   read and forward a message-body on any request; if the request method\n   does not include defined semantics for an entity-body, then the\n   message-body SHOULD be ignored when handling the request.\n\n   For response messages, whether or not a message-body is included with\n   a message is dependent on both the request method and the response\n   status code (",{"type":1444,"nodeName":1452,"attributes":7254,"children":7255},{"href":2154},[7256],{"type":1449,"textContent":7257},"section 6.1.1",{"type":1449,"textContent":7259},"). All responses to the HEAD request method\n   MUST NOT include a message-body, even though the presence of entity-\n   header fields might lead one to believe they do. All 1xx\n   (informational), 204 (no content), and 304 (not modified) responses\n   MUST NOT include a message-body. All other responses do include a\n   message-body, although it MAY be of zero length.\n\n",{"type":1444,"nodeName":1461,"attributes":7261,"children":7262},{"class":5228},[7263,7267],{"type":1444,"nodeName":1452,"attributes":7264,"children":7265},{"class":5220,"id":324,"href":2013},[7266],{"type":1449,"textContent":2016},{"type":1449,"textContent":7268}," Message Length",{"type":1449,"textContent":7270},"\n\n   The transfer-length of a message is the length of the message-body as\n   it appears in the message; that is, after any transfer-codings have\n   been applied. When a message-body is included with a message, the\n   transfer-length of that body is determined by one of the following\n   (in order of precedence):\n\n   1.Any response message which \"MUST NOT\" include a message-body (such\n     as the 1xx, 204, and 304 responses and any response to a HEAD\n     request) is always terminated by the first empty line after the\n     header fields, regardless of the entity-header fields present in\n     the message.\n\n   2.If a Transfer-Encoding header field (",{"type":1444,"nodeName":1452,"attributes":7272,"children":7273},{"href":4574},[7274],{"type":1449,"textContent":6513},{"type":1449,"textContent":7276},") is present and\n     has any value other than \"identity\", then the transfer-length is\n     defined by use of the \"chunked\" transfer-coding (",{"type":1444,"nodeName":1452,"attributes":7278,"children":7279},{"href":1813},[7280],{"type":1449,"textContent":6699},{"type":1449,"textContent":7282},"),\n     unless the message is terminated by closing the connection.\n\n   3.If a Content-Length header field (",{"type":1444,"nodeName":1452,"attributes":7284,"children":7285},{"href":4099},[7286],{"type":1449,"textContent":7287},"section 14.13",{"type":1449,"textContent":7289},") is present, its\n     decimal value in OCTETs represents both the entity-length and the\n     transfer-length. The Content-Length header field MUST NOT be sent\n     if these two lengths are different (i.e., if a Transfer-Encoding\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7291,"children":7292},{"class":1493},[7293],{"type":1449,"textContent":7294},"Fielding, et al.            Standards Track                    [Page 33]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7297,"children":7298},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7300,"children":7301},{"class":1506},[7302,7306,7307,7315,7317,7321,7323,7332,7334],{"type":1444,"nodeName":1461,"attributes":7303,"children":7305},{"id":7304},"page-34",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7308,"children":7309},{"class":1493},[7310,7314],{"type":1444,"nodeName":1452,"attributes":7311,"children":7312},{"href":1518},[7313],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7316},"\n\n\n     header field is present). If a message is received with both a\n     Transfer-Encoding header field and a Content-Length header field,\n     the latter MUST be ignored.\n\n   4.If the message uses the media type \"multipart\u002Fbyteranges\", and the\n     ransfer-length is not otherwise specified, then this self-\n     elimiting media type defines the transfer-length. This media type\n     UST NOT be used unless the sender knows that the recipient can arse\n     it; the presence in a request of a Range header with ultiple byte-\n     range specifiers from a 1.1 client implies that the lient can parse\n     multipart\u002Fbyteranges responses.\n\n       A range header might be forwarded by a 1.0 proxy that does not\n       understand multipart\u002Fbyteranges; in this case the server MUST\n       delimit the message using methods defined in items 1,3 or 5 of\n       this section.\n\n   5.By the server closing the connection. (Closing the connection\n     cannot be used to indicate the end of a request body, since that\n     would leave no possibility for the server to send back a response.)\n\n   For compatibility with HTTP\u002F1.0 applications, HTTP\u002F1.1 requests\n   containing a message-body MUST include a valid Content-Length header\n   field unless the server is known to be HTTP\u002F1.1 compliant. If a\n   request contains a message-body and a Content-Length is not given,\n   the server SHOULD respond with 400 (bad request) if it cannot\n   determine the length of the message, or with 411 (length required) if\n   it wishes to insist on receiving a valid Content-Length.\n\n   All HTTP\u002F1.1 applications that receive entities MUST accept the\n   \"chunked\" transfer-coding (",{"type":1444,"nodeName":1452,"attributes":7318,"children":7319},{"href":1813},[7320],{"type":1449,"textContent":6699},{"type":1449,"textContent":7322},"), thus allowing this mechanism\n   to be used for messages when the message length cannot be determined\n   in advance.\n\n   Messages MUST NOT include both a Content-Length header field and a\n   non-identity transfer-coding. If the message does include a non-\n   identity transfer-coding, the Content-Length MUST be ignored.\n\n   When a Content-Length is given in a message where a message-body is\n   allowed, its field value MUST exactly match the number of OCTETs in\n   the message-body. HTTP\u002F1.1 user agents MUST notify the user when an\n   invalid length is received and detected.\n\n",{"type":1444,"nodeName":1461,"attributes":7324,"children":7325},{"class":5228},[7326,7330],{"type":1444,"nodeName":1452,"attributes":7327,"children":7328},{"class":5220,"id":329,"href":2027},[7329],{"type":1449,"textContent":2030},{"type":1449,"textContent":7331}," General Header Fields",{"type":1449,"textContent":7333},"\n\n   There are a few header fields which have general applicability for\n   both request and response messages, but which do not apply to the\n   entity being transferred. These header fields apply only to the\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7335,"children":7336},{"class":1493},[7337],{"type":1449,"textContent":7338},"Fielding, et al.            Standards Track                    [Page 34]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7341,"children":7342},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7344,"children":7345},{"class":1506},[7346,7350,7351,7359,7361,7366,7368,7373,7375,7380,7382,7387,7389,7394,7396,7401,7403,7408,7410,7415,7417,7422,7424,7433,7435,7440,7442,7447,7449,7454,7456,7461,7463,7468,7469,7478,7480],{"type":1444,"nodeName":1461,"attributes":7347,"children":7349},{"id":7348},"page-35",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7352,"children":7353},{"class":1493},[7354,7358],{"type":1444,"nodeName":1452,"attributes":7355,"children":7356},{"href":1518},[7357],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7360},"\n\n\n   message being transmitted.\n\n       general-header = Cache-Control            ; ",{"type":1444,"nodeName":1452,"attributes":7362,"children":7363},{"href":3951},[7364],{"type":1449,"textContent":7365},"Section 14.9",{"type":1449,"textContent":7367},"\n                      | Connection               ; ",{"type":1444,"nodeName":1452,"attributes":7369,"children":7370},{"href":4056},[7371],{"type":1449,"textContent":7372},"Section 14.10",{"type":1449,"textContent":7374},"\n                      | Date                     ; ",{"type":1444,"nodeName":1452,"attributes":7376,"children":7377},{"href":4174},[7378],{"type":1449,"textContent":7379},"Section 14.18",{"type":1449,"textContent":7381},"\n                      | Pragma                   ; ",{"type":1444,"nodeName":1452,"attributes":7383,"children":7384},{"href":4417},[7385],{"type":1449,"textContent":7386},"Section 14.32",{"type":1449,"textContent":7388},"\n                      | Trailer                  ; ",{"type":1444,"nodeName":1452,"attributes":7390,"children":7391},{"href":4559},[7392],{"type":1449,"textContent":7393},"Section 14.40",{"type":1449,"textContent":7395},"\n                      | Transfer-Encoding        ; ",{"type":1444,"nodeName":1452,"attributes":7397,"children":7398},{"href":4574},[7399],{"type":1449,"textContent":7400},"Section 14.41",{"type":1449,"textContent":7402},"\n                      | Upgrade                  ; ",{"type":1444,"nodeName":1452,"attributes":7404,"children":7405},{"href":4587},[7406],{"type":1449,"textContent":7407},"Section 14.42",{"type":1449,"textContent":7409},"\n                      | Via                      ; ",{"type":1444,"nodeName":1452,"attributes":7411,"children":7412},{"href":4630},[7413],{"type":1449,"textContent":7414},"Section 14.45",{"type":1449,"textContent":7416},"\n                      | Warning                  ; ",{"type":1444,"nodeName":1452,"attributes":7418,"children":7419},{"href":4645},[7420],{"type":1449,"textContent":7421},"Section 14.46",{"type":1449,"textContent":7423},"\n\n   General-header field names can be extended reliably only in\n   combination with a change in the protocol version. However, new or\n   experimental header fields may be given the semantics of general\n   header fields if all parties in the communication recognize them to\n   be general-header fields. Unrecognized header fields are treated as\n   entity-header fields.\n\n",{"type":1444,"nodeName":1461,"attributes":7425,"children":7426},{"class":5216},[7427,7431],{"type":1444,"nodeName":1452,"attributes":7428,"children":7429},{"class":5220,"id":334,"href":2042},[7430],{"type":1449,"textContent":2045},{"type":1449,"textContent":7432}," Request",{"type":1449,"textContent":7434},"\n\n   A request message from a client to a server includes, within the\n   first line of that message, the method to be applied to the resource,\n   the identifier of the resource, and the protocol version in use.\n\n        Request       = Request-Line              ; ",{"type":1444,"nodeName":1452,"attributes":7436,"children":7437},{"href":2057},[7438],{"type":1449,"textContent":7439},"Section 5.1",{"type":1449,"textContent":7441},"\n                        *(( general-header        ; ",{"type":1444,"nodeName":1452,"attributes":7443,"children":7444},{"href":2027},[7445],{"type":1449,"textContent":7446},"Section 4.5",{"type":1449,"textContent":7448},"\n                         | request-header         ; ",{"type":1444,"nodeName":1452,"attributes":7450,"children":7451},{"href":2113},[7452],{"type":1449,"textContent":7453},"Section 5.3",{"type":1449,"textContent":7455},"\n                         | entity-header ) CRLF)  ; ",{"type":1444,"nodeName":1452,"attributes":7457,"children":7458},{"href":2224},[7459],{"type":1449,"textContent":7460},"Section 7.1",{"type":1449,"textContent":7462},"\n                        CRLF\n                        [ message-body ]          ; ",{"type":1444,"nodeName":1452,"attributes":7464,"children":7465},{"href":1998},[7466],{"type":1449,"textContent":7467},"Section 4.3",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":7470,"children":7471},{"class":5228},[7472,7476],{"type":1444,"nodeName":1452,"attributes":7473,"children":7474},{"class":5220,"id":340,"href":2057},[7475],{"type":1449,"textContent":2060},{"type":1449,"textContent":7477}," Request-Line",{"type":1449,"textContent":7479},"\n\n   The Request-Line begins with a method token, followed by the\n   Request-URI and the protocol version, and ending with CRLF. The\n   elements are separated by SP characters. No CR or LF is allowed\n   except in the final CRLF sequence.\n\n        Request-Line   = Method SP Request-URI SP HTTP-Version CRLF\n\n\n\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7481,"children":7482},{"class":1493},[7483],{"type":1449,"textContent":7484},"Fielding, et al.            Standards Track                    [Page 35]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7487,"children":7488},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7490,"children":7491},{"class":1506},[7492,7496,7497,7505,7506,7515,7517,7522,7524,7529,7531,7536,7538,7543,7545,7550,7552,7557,7559,7564,7566,7571,7573,7578,7580,7585,7586,7595,7597,7601,7603],{"type":1444,"nodeName":1461,"attributes":7493,"children":7495},{"id":7494},"page-36",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7498,"children":7499},{"class":1493},[7500,7504],{"type":1444,"nodeName":1452,"attributes":7501,"children":7502},{"href":1518},[7503],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":7507,"children":7508},{"class":5964},[7509,7513],{"type":1444,"nodeName":1452,"attributes":7510,"children":7511},{"class":5220,"id":346,"href":2070},[7512],{"type":1449,"textContent":2073},{"type":1449,"textContent":7514}," Method",{"type":1449,"textContent":7516},"\n\n   The Method  token indicates the method to be performed on the\n   resource identified by the Request-URI. The method is case-sensitive.\n\n       Method         = \"OPTIONS\"                ; ",{"type":1444,"nodeName":1452,"attributes":7518,"children":7519},{"href":2478},[7520],{"type":1449,"textContent":7521},"Section 9.2",{"type":1449,"textContent":7523},"\n                      | \"GET\"                    ; ",{"type":1444,"nodeName":1452,"attributes":7525,"children":7526},{"href":2493},[7527],{"type":1449,"textContent":7528},"Section 9.3",{"type":1449,"textContent":7530},"\n                      | \"HEAD\"                   ; ",{"type":1444,"nodeName":1452,"attributes":7532,"children":7533},{"href":2508},[7534],{"type":1449,"textContent":7535},"Section 9.4",{"type":1449,"textContent":7537},"\n                      | \"POST\"                   ; ",{"type":1444,"nodeName":1452,"attributes":7539,"children":7540},{"href":2523},[7541],{"type":1449,"textContent":7542},"Section 9.5",{"type":1449,"textContent":7544},"\n                      | \"PUT\"                    ; ",{"type":1444,"nodeName":1452,"attributes":7546,"children":7547},{"href":2536},[7548],{"type":1449,"textContent":7549},"Section 9.6",{"type":1449,"textContent":7551},"\n                      | \"DELETE\"                 ; ",{"type":1444,"nodeName":1452,"attributes":7553,"children":7554},{"href":2551},[7555],{"type":1449,"textContent":7556},"Section 9.7",{"type":1449,"textContent":7558},"\n                      | \"TRACE\"                  ; ",{"type":1444,"nodeName":1452,"attributes":7560,"children":7561},{"href":2566},[7562],{"type":1449,"textContent":7563},"Section 9.8",{"type":1449,"textContent":7565},"\n                      | \"CONNECT\"                ; ",{"type":1444,"nodeName":1452,"attributes":7567,"children":7568},{"href":2579},[7569],{"type":1449,"textContent":7570},"Section 9.9",{"type":1449,"textContent":7572},"\n                      | extension-method\n       extension-method = token\n\n   The list of methods allowed by a resource can be specified in an\n   Allow header field (",{"type":1444,"nodeName":1452,"attributes":7574,"children":7575},{"href":3923},[7576],{"type":1449,"textContent":7577},"section 14.7",{"type":1449,"textContent":7579},"). The return code of the response\n   always notifies the client whether a method is currently allowed on a\n   resource, since the set of allowed methods can change dynamically. An\n   origin server SHOULD return the status code 405 (Method Not Allowed)\n   if the method is known by the origin server but not allowed for the\n   requested resource, and 501 (Not Implemented) if the method is\n   unrecognized or not implemented by the origin server. The methods GET\n   and HEAD MUST be supported by all general-purpose servers. All other\n   methods are OPTIONAL; however, if the above methods are implemented,\n   they MUST be implemented with the same semantics as those specified\n   in ",{"type":1444,"nodeName":1452,"attributes":7581,"children":7582},{"href":2424},[7583],{"type":1449,"textContent":7584},"section 9",{"type":1449,"textContent":6397},{"type":1444,"nodeName":1461,"attributes":7587,"children":7588},{"class":5964},[7589,7593],{"type":1444,"nodeName":1452,"attributes":7590,"children":7591},{"class":5220,"id":351,"href":2085},[7592],{"type":1449,"textContent":2088},{"type":1449,"textContent":7594}," Request-URI",{"type":1449,"textContent":7596},"\n\n   The Request-URI is a Uniform Resource Identifier (",{"type":1444,"nodeName":1452,"attributes":7598,"children":7599},{"href":1671},[7600],{"type":1449,"textContent":5443},{"type":1449,"textContent":7602},") and\n   identifies the resource upon which to apply the request.\n\n       Request-URI    = \"*\" | absoluteURI | abs_path | authority\n\n   The four options for Request-URI are dependent on the nature of the\n   request. The asterisk \"*\" means that the request does not apply to a\n   particular resource, but to the server itself, and is only allowed\n   when the method used does not necessarily apply to a resource. One\n   example would be\n\n       OPTIONS * HTTP\u002F1.1\n\n   The absoluteURI form is REQUIRED when the request is being made to a\n   proxy. The proxy is requested to forward the request or service it\n   from a valid cache, and return the response. Note that the proxy MAY\n   forward the request on to another proxy or directly to the server\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7604,"children":7605},{"class":1493},[7606],{"type":1449,"textContent":7607},"Fielding, et al.            Standards Track                    [Page 36]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7610,"children":7611},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7613,"children":7614},{"class":1506},[7615,7619,7620,7628,7630,7635,7637,7642,7644,7649,7651,7655,7656,7660,7662,7666,7668],{"type":1444,"nodeName":1461,"attributes":7616,"children":7618},{"id":7617},"page-37",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7621,"children":7622},{"class":1493},[7623,7627],{"type":1444,"nodeName":1452,"attributes":7624,"children":7625},{"href":1518},[7626],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7629},"\n\n\n   specified by the absoluteURI. In order to avoid request loops, a\n   proxy MUST be able to recognize all of its server names, including\n   any aliases, local variations, and the numeric IP address. An example\n   Request-Line would be:\n\n       GET ",{"type":1444,"nodeName":1452,"attributes":7631,"children":7633},{"href":7632},"http:\u002F\u002Fwww.w3.org\u002Fpub\u002FWWW\u002FTheProject.html",[7634],{"type":1449,"textContent":7632},{"type":1449,"textContent":7636}," HTTP\u002F1.1\n\n   To allow for transition to absoluteURIs in all requests in future\n   versions of HTTP, all HTTP\u002F1.1 servers MUST accept the absoluteURI\n   form in requests, even though HTTP\u002F1.1 clients will only generate\n   them in requests to proxies.\n\n   The authority form is only used by the CONNECT method (",{"type":1444,"nodeName":1452,"attributes":7638,"children":7639},{"href":2579},[7640],{"type":1449,"textContent":7641},"section 9.9",{"type":1449,"textContent":7643},").\n\n   The most common form of Request-URI is that used to identify a\n   resource on an origin server or gateway. In this case the absolute\n   path of the URI MUST be transmitted (see ",{"type":1444,"nodeName":1452,"attributes":7645,"children":7646},{"href":1686},[7647],{"type":1449,"textContent":7648},"section 3.2.1",{"type":1449,"textContent":7650},", abs_path) as\n   the Request-URI, and the network location of the URI (authority) MUST\n   be transmitted in a Host header field. For example, a client wishing\n   to retrieve the resource above directly from the origin server would\n   create a TCP connection to port 80 of the host \"www.w3.org\" and send\n   the lines:\n\n       GET \u002Fpub\u002FWWW\u002FTheProject.html HTTP\u002F1.1\n       Host: www.w3.org\n\n   followed by the remainder of the Request. Note that the absolute path\n   cannot be empty; if none is present in the original URI, it MUST be\n   given as \"\u002F\" (the server root).\n\n   The Request-URI is transmitted in the format specified in ",{"type":1444,"nodeName":1452,"attributes":7652,"children":7653},{"href":1686},[7654],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":7657,"children":7658},{"href":1686},[7659],{"type":1449,"textContent":1689},{"type":1449,"textContent":7661},". If the Request-URI is encoded using the \"% HEX HEX\" encoding\n   [",{"type":1444,"nodeName":1452,"attributes":7663,"children":7664},{"href":5990},[7665],{"type":1449,"textContent":2220},{"type":1449,"textContent":7667},"], the origin server MUST decode the Request-URI in order to\n   properly interpret the request. Servers SHOULD respond to invalid\n   Request-URIs with an appropriate status code.\n\n   A transparent proxy MUST NOT rewrite the \"abs_path\" part of the\n   received Request-URI when forwarding it to the next inbound server,\n   except as noted above to replace a null abs_path with \"\u002F\".\n\n      Note: The \"no rewrite\" rule prevents the proxy from changing the\n      meaning of the request when the origin server is improperly using\n      a non-reserved URI character for a reserved purpose.  Implementors\n      should be aware that some pre-HTTP\u002F1.1 proxies have been known to\n      rewrite the Request-URI.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7669,"children":7670},{"class":1493},[7671],{"type":1449,"textContent":7672},"Fielding, et al.            Standards Track                    [Page 37]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7675,"children":7676},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7678,"children":7679},{"class":1506},[7680,7684,7685,7693,7694,7703,7705,7711,7713,7722,7724,7729,7731,7736,7738,7743,7745,7750,7752,7757,7759,7764,7766,7771,7773,7778,7780,7785,7786],{"type":1444,"nodeName":1461,"attributes":7681,"children":7683},{"id":7682},"page-38",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7686,"children":7687},{"class":1493},[7688,7692],{"type":1444,"nodeName":1452,"attributes":7689,"children":7690},{"href":1518},[7691],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":7695,"children":7696},{"class":5228},[7697,7701],{"type":1444,"nodeName":1452,"attributes":7698,"children":7699},{"class":5220,"id":356,"href":2098},[7700],{"type":1449,"textContent":2101},{"type":1449,"textContent":7702}," The Resource Identified by a Request",{"type":1449,"textContent":7704},"\n\n   The exact resource identified by an Internet request is determined by\n   examining both the Request-URI and the Host header field.\n\n   An origin server that does not allow resources to differ by the\n   requested host MAY ignore the Host header field value when\n   determining the resource identified by an HTTP\u002F1.1 request. (But see\n   ",{"type":1444,"nodeName":1452,"attributes":7706,"children":7708},{"href":7707},"#section-19.6.1.1",[7709],{"type":1449,"textContent":7710},"section 19.6.1.1",{"type":1449,"textContent":7712}," for other requirements on Host support in HTTP\u002F1.1.)\n\n   An origin server that does differentiate resources based on the host\n   requested (sometimes referred to as virtual hosts or vanity host\n   names) MUST use the following rules for determining the requested\n   resource on an HTTP\u002F1.1 request:\n\n   1. If Request-URI is an absoluteURI, the host is part of the\n     Request-URI. Any Host header field value in the request MUST be\n     ignored.\n\n   2. If the Request-URI is not an absoluteURI, and the request includes\n     a Host header field, the host is determined by the Host header\n     field value.\n\n   3. If the host as determined by rule 1 or 2 is not a valid host on\n     the server, the response MUST be a 400 (Bad Request) error message.\n\n   Recipients of an HTTP\u002F1.0 request that lacks a Host header field MAY\n   attempt to use heuristics (e.g., examination of the URI path for\n   something unique to a particular host) in order to determine what\n   exact resource is being requested.\n\n",{"type":1444,"nodeName":1461,"attributes":7714,"children":7715},{"class":5228},[7716,7720],{"type":1444,"nodeName":1452,"attributes":7717,"children":7718},{"class":5220,"id":361,"href":2113},[7719],{"type":1449,"textContent":2116},{"type":1449,"textContent":7721}," Request Header Fields",{"type":1449,"textContent":7723},"\n\n   The request-header fields allow the client to pass additional\n   information about the request, and about the client itself, to the\n   server. These fields act as request modifiers, with semantics\n   equivalent to the parameters on a programming language method\n   invocation.\n\n       request-header = Accept                   ; ",{"type":1444,"nodeName":1452,"attributes":7725,"children":7726},{"href":3837},[7727],{"type":1449,"textContent":7728},"Section 14.1",{"type":1449,"textContent":7730},"\n                      | Accept-Charset           ; ",{"type":1444,"nodeName":1452,"attributes":7732,"children":7733},{"href":3850},[7734],{"type":1449,"textContent":7735},"Section 14.2",{"type":1449,"textContent":7737},"\n                      | Accept-Encoding          ; ",{"type":1444,"nodeName":1452,"attributes":7739,"children":7740},{"href":3865},[7741],{"type":1449,"textContent":7742},"Section 14.3",{"type":1449,"textContent":7744},"\n                      | Accept-Language          ; ",{"type":1444,"nodeName":1452,"attributes":7746,"children":7747},{"href":3878},[7748],{"type":1449,"textContent":7749},"Section 14.4",{"type":1449,"textContent":7751},"\n                      | Authorization            ; ",{"type":1444,"nodeName":1452,"attributes":7753,"children":7754},{"href":3936},[7755],{"type":1449,"textContent":7756},"Section 14.8",{"type":1449,"textContent":7758},"\n                      | Expect                   ; ",{"type":1444,"nodeName":1452,"attributes":7760,"children":7761},{"href":4217},[7762],{"type":1449,"textContent":7763},"Section 14.20",{"type":1449,"textContent":7765},"\n                      | From                     ; ",{"type":1444,"nodeName":1452,"attributes":7767,"children":7768},{"href":4245},[7769],{"type":1449,"textContent":7770},"Section 14.22",{"type":1449,"textContent":7772},"\n                      | Host                     ; ",{"type":1444,"nodeName":1452,"attributes":7774,"children":7775},{"href":4286},[7776],{"type":1449,"textContent":7777},"Section 14.23",{"type":1449,"textContent":7779},"\n                      | If-Match                 ; ",{"type":1444,"nodeName":1452,"attributes":7781,"children":7782},{"href":4299},[7783],{"type":1449,"textContent":7784},"Section 14.24",{"type":1449,"textContent":2180},{"type":1444,"nodeName":1461,"attributes":7787,"children":7788},{"class":1493},[7789],{"type":1449,"textContent":7790},"Fielding, et al.            Standards Track                    [Page 38]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7793,"children":7794},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7796,"children":7797},{"class":1506},[7798,7802,7803,7811,7813,7818,7820,7825,7827,7832,7834,7839,7841,7846,7848,7853,7855,7860,7862,7867,7869,7874,7876,7881,7883,7892,7894,7899,7901,7905,7907,7912,7914,7918,7920,7925,7926,7935,7937,7946,7948,7953,7955],{"type":1444,"nodeName":1461,"attributes":7799,"children":7801},{"id":7800},"page-39",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7804,"children":7805},{"class":1493},[7806,7810],{"type":1444,"nodeName":1452,"attributes":7807,"children":7808},{"href":1518},[7809],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7812},"\n\n\n                      | If-Modified-Since        ; ",{"type":1444,"nodeName":1452,"attributes":7814,"children":7815},{"href":4314},[7816],{"type":1449,"textContent":7817},"Section 14.25",{"type":1449,"textContent":7819},"\n                      | If-None-Match            ; ",{"type":1444,"nodeName":1452,"attributes":7821,"children":7822},{"href":4329},[7823],{"type":1449,"textContent":7824},"Section 14.26",{"type":1449,"textContent":7826},"\n                      | If-Range                 ; ",{"type":1444,"nodeName":1452,"attributes":7828,"children":7829},{"href":4344},[7830],{"type":1449,"textContent":7831},"Section 14.27",{"type":1449,"textContent":7833},"\n                      | If-Unmodified-Since      ; ",{"type":1444,"nodeName":1452,"attributes":7835,"children":7836},{"href":4359},[7837],{"type":1449,"textContent":7838},"Section 14.28",{"type":1449,"textContent":7840},"\n                      | Max-Forwards             ; ",{"type":1444,"nodeName":1452,"attributes":7842,"children":7843},{"href":4402},[7844],{"type":1449,"textContent":7845},"Section 14.31",{"type":1449,"textContent":7847},"\n                      | Proxy-Authorization      ; ",{"type":1444,"nodeName":1452,"attributes":7849,"children":7850},{"href":4445},[7851],{"type":1449,"textContent":7852},"Section 14.34",{"type":1449,"textContent":7854},"\n                      | Range                    ; ",{"type":1444,"nodeName":1452,"attributes":7856,"children":7857},{"href":4458},[7858],{"type":1449,"textContent":7859},"Section 14.35",{"type":1449,"textContent":7861},"\n                      | Referer                  ; ",{"type":1444,"nodeName":1452,"attributes":7863,"children":7864},{"href":4501},[7865],{"type":1449,"textContent":7866},"Section 14.36",{"type":1449,"textContent":7868},"\n                      | TE                       ; ",{"type":1444,"nodeName":1452,"attributes":7870,"children":7871},{"href":4544},[7872],{"type":1449,"textContent":7873},"Section 14.39",{"type":1449,"textContent":7875},"\n                      | User-Agent               ; ",{"type":1444,"nodeName":1452,"attributes":7877,"children":7878},{"href":4602},[7879],{"type":1449,"textContent":7880},"Section 14.43",{"type":1449,"textContent":7882},"\n\n   Request-header field names can be extended reliably only in\n   combination with a change in the protocol version. However, new or\n   experimental header fields MAY be given the semantics of request-\n   header fields if all parties in the communication recognize them to\n   be request-header fields. Unrecognized header fields are treated as\n   entity-header fields.\n\n",{"type":1444,"nodeName":1461,"attributes":7884,"children":7885},{"class":5216},[7886,7890],{"type":1444,"nodeName":1452,"attributes":7887,"children":7888},{"class":5220,"id":366,"href":2126},[7889],{"type":1449,"textContent":2129},{"type":1449,"textContent":7891}," Response",{"type":1449,"textContent":7893},"\n\n   After receiving and interpreting a request message, a server responds\n   with an HTTP response message.\n\n       Response      = Status-Line               ; ",{"type":1444,"nodeName":1452,"attributes":7895,"children":7896},{"href":2141},[7897],{"type":1449,"textContent":7898},"Section 6.1",{"type":1449,"textContent":7900},"\n                       *(( general-header        ; ",{"type":1444,"nodeName":1452,"attributes":7902,"children":7903},{"href":2027},[7904],{"type":1449,"textContent":7446},{"type":1449,"textContent":7906},"\n                        | response-header        ; ",{"type":1444,"nodeName":1452,"attributes":7908,"children":7909},{"href":2167},[7910],{"type":1449,"textContent":7911},"Section 6.2",{"type":1449,"textContent":7913},"\n                        | entity-header ) CRLF)  ; ",{"type":1444,"nodeName":1452,"attributes":7915,"children":7916},{"href":2224},[7917],{"type":1449,"textContent":7460},{"type":1449,"textContent":7919},"\n                       CRLF\n                       [ message-body ]          ; ",{"type":1444,"nodeName":1452,"attributes":7921,"children":7922},{"href":2237},[7923],{"type":1449,"textContent":7924},"Section 7.2",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":7927,"children":7928},{"class":5228},[7929,7933],{"type":1444,"nodeName":1452,"attributes":7930,"children":7931},{"class":5220,"id":372,"href":2141},[7932],{"type":1449,"textContent":2144},{"type":1449,"textContent":7934}," Status-Line",{"type":1449,"textContent":7936},"\n\n   The first line of a Response message is the Status-Line, consisting\n   of the protocol version followed by a numeric status code and its\n   associated textual phrase, with each element separated by SP\n   characters. No CR or LF is allowed except in the final CRLF sequence.\n\n       Status-Line = HTTP-Version SP Status-Code SP Reason-Phrase CRLF\n\n",{"type":1444,"nodeName":1461,"attributes":7938,"children":7939},{"class":5964},[7940,7944],{"type":1444,"nodeName":1452,"attributes":7941,"children":7942},{"class":5220,"id":378,"href":2154},[7943],{"type":1449,"textContent":2157},{"type":1449,"textContent":7945}," Status Code and Reason Phrase",{"type":1449,"textContent":7947},"\n\n   The Status-Code element is a 3-digit integer result code of the\n   attempt to understand and satisfy the request. These codes are fully\n   defined in ",{"type":1444,"nodeName":1452,"attributes":7949,"children":7950},{"href":2594},[7951],{"type":1449,"textContent":7952},"section 10",{"type":1449,"textContent":7954},". The Reason-Phrase is intended to give a short\n   textual description of the Status-Code. The Status-Code is intended\n   for use by automata and the Reason-Phrase is intended for the human\n   user. The client is not required to examine or display the Reason-\n   Phrase.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":7956,"children":7957},{"class":1493},[7958],{"type":1449,"textContent":7959},"Fielding, et al.            Standards Track                    [Page 39]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":7962,"children":7963},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":7965,"children":7966},{"class":1506},[7967,7971,7972,7980,7982,7987,7989,7994,7996,8001,8003,8008,8010,8015,8017,8022,8024,8029,8031,8036,8038,8043,8045,8050,8052,8057,8059,8064,8066,8071,8073,8078,8080,8085,8087,8092,8094,8099,8101,8106,8108,8113,8115,8120,8122,8127,8129,8134,8136,8141,8143],{"type":1444,"nodeName":1461,"attributes":7968,"children":7970},{"id":7969},"page-40",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":7973,"children":7974},{"class":1493},[7975,7979],{"type":1444,"nodeName":1452,"attributes":7976,"children":7977},{"href":1518},[7978],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":7981},"\n\n\n   The first digit of the Status-Code defines the class of response. The\n   last two digits do not have any categorization role. There are 5\n   values for the first digit:\n\n      - 1xx: Informational - Request received, continuing process\n\n      - 2xx: Success - The action was successfully received,\n        understood, and accepted\n\n      - 3xx: Redirection - Further action must be taken in order to\n        complete the request\n\n      - 4xx: Client Error - The request contains bad syntax or cannot\n        be fulfilled\n\n      - 5xx: Server Error - The server failed to fulfill an apparently\n        valid request\n\n   The individual values of the numeric status codes defined for\n   HTTP\u002F1.1, and an example set of corresponding Reason-Phrase's, are\n   presented below. The reason phrases listed here are only\n   recommendations -- they MAY be replaced by local equivalents without\n   affecting the protocol.\n\n      Status-Code    =\n            \"100\"  ; ",{"type":1444,"nodeName":1452,"attributes":7983,"children":7984},{"href":2620},[7985],{"type":1449,"textContent":7986},"Section 10.1.1",{"type":1449,"textContent":7988},": Continue\n          | \"101\"  ; ",{"type":1444,"nodeName":1452,"attributes":7990,"children":7991},{"href":2635},[7992],{"type":1449,"textContent":7993},"Section 10.1.2",{"type":1449,"textContent":7995},": Switching Protocols\n          | \"200\"  ; ",{"type":1444,"nodeName":1452,"attributes":7997,"children":7998},{"href":2661},[7999],{"type":1449,"textContent":8000},"Section 10.2.1",{"type":1449,"textContent":8002},": OK\n          | \"201\"  ; ",{"type":1444,"nodeName":1452,"attributes":8004,"children":8005},{"href":2674},[8006],{"type":1449,"textContent":8007},"Section 10.2.2",{"type":1449,"textContent":8009},": Created\n          | \"202\"  ; ",{"type":1444,"nodeName":1452,"attributes":8011,"children":8012},{"href":2689},[8013],{"type":1449,"textContent":8014},"Section 10.2.3",{"type":1449,"textContent":8016},": Accepted\n          | \"203\"  ; ",{"type":1444,"nodeName":1452,"attributes":8018,"children":8019},{"href":2702},[8020],{"type":1449,"textContent":8021},"Section 10.2.4",{"type":1449,"textContent":8023},": Non-Authoritative Information\n          | \"204\"  ; ",{"type":1444,"nodeName":1452,"attributes":8025,"children":8026},{"href":2715},[8027],{"type":1449,"textContent":8028},"Section 10.2.5",{"type":1449,"textContent":8030},": No Content\n          | \"205\"  ; ",{"type":1444,"nodeName":1452,"attributes":8032,"children":8033},{"href":2730},[8034],{"type":1449,"textContent":8035},"Section 10.2.6",{"type":1449,"textContent":8037},": Reset Content\n          | \"206\"  ; ",{"type":1444,"nodeName":1452,"attributes":8039,"children":8040},{"href":2743},[8041],{"type":1449,"textContent":8042},"Section 10.2.7",{"type":1449,"textContent":8044},": Partial Content\n          | \"300\"  ; ",{"type":1444,"nodeName":1452,"attributes":8046,"children":8047},{"href":2771},[8048],{"type":1449,"textContent":8049},"Section 10.3.1",{"type":1449,"textContent":8051},": Multiple Choices\n          | \"301\"  ; ",{"type":1444,"nodeName":1452,"attributes":8053,"children":8054},{"href":2784},[8055],{"type":1449,"textContent":8056},"Section 10.3.2",{"type":1449,"textContent":8058},": Moved Permanently\n          | \"302\"  ; ",{"type":1444,"nodeName":1452,"attributes":8060,"children":8061},{"href":2799},[8062],{"type":1449,"textContent":8063},"Section 10.3.3",{"type":1449,"textContent":8065},": Found\n          | \"303\"  ; ",{"type":1444,"nodeName":1452,"attributes":8067,"children":8068},{"href":2812},[8069],{"type":1449,"textContent":8070},"Section 10.3.4",{"type":1449,"textContent":8072},": See Other\n          | \"304\"  ; ",{"type":1444,"nodeName":1452,"attributes":8074,"children":8075},{"href":2827},[8076],{"type":1449,"textContent":8077},"Section 10.3.5",{"type":1449,"textContent":8079},": Not Modified\n          | \"305\"  ; ",{"type":1444,"nodeName":1452,"attributes":8081,"children":8082},{"href":2840},[8083],{"type":1449,"textContent":8084},"Section 10.3.6",{"type":1449,"textContent":8086},": Use Proxy\n          | \"307\"  ; ",{"type":1444,"nodeName":1452,"attributes":8088,"children":8089},{"href":2894},[8090],{"type":1449,"textContent":8091},"Section 10.3.8",{"type":1449,"textContent":8093},": Temporary Redirect\n          | \"400\"  ; ",{"type":1444,"nodeName":1452,"attributes":8095,"children":8096},{"href":2922},[8097],{"type":1449,"textContent":8098},"Section 10.4.1",{"type":1449,"textContent":8100},": Bad Request\n          | \"401\"  ; ",{"type":1444,"nodeName":1452,"attributes":8102,"children":8103},{"href":2935},[8104],{"type":1449,"textContent":8105},"Section 10.4.2",{"type":1449,"textContent":8107},": Unauthorized\n          | \"402\"  ; ",{"type":1444,"nodeName":1452,"attributes":8109,"children":8110},{"href":2950},[8111],{"type":1449,"textContent":8112},"Section 10.4.3",{"type":1449,"textContent":8114},": Payment Required\n          | \"403\"  ; ",{"type":1444,"nodeName":1452,"attributes":8116,"children":8117},{"href":2963},[8118],{"type":1449,"textContent":8119},"Section 10.4.4",{"type":1449,"textContent":8121},": Forbidden\n          | \"404\"  ; ",{"type":1444,"nodeName":1452,"attributes":8123,"children":8124},{"href":2976},[8125],{"type":1449,"textContent":8126},"Section 10.4.5",{"type":1449,"textContent":8128},": Not Found\n          | \"405\"  ; ",{"type":1444,"nodeName":1452,"attributes":8130,"children":8131},{"href":2989},[8132],{"type":1449,"textContent":8133},"Section 10.4.6",{"type":1449,"textContent":8135},": Method Not Allowed\n          | \"406\"  ; ",{"type":1444,"nodeName":1452,"attributes":8137,"children":8138},{"href":3002},[8139],{"type":1449,"textContent":8140},"Section 10.4.7",{"type":1449,"textContent":8142},": Not Acceptable\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8144,"children":8145},{"class":1493},[8146],{"type":1449,"textContent":8147},"Fielding, et al.            Standards Track                    [Page 40]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8150,"children":8151},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8153,"children":8154},{"class":1506},[8155,8159,8160,8168,8170,8175,8177,8182,8184,8189,8191,8196,8198,8203,8205,8210,8212,8217,8219,8224,8226,8231,8233,8238,8240,8245,8247,8252,8254,8259,8261,8266,8268,8273,8275,8280,8282,8287,8289,8298,8300,8305,8307,8312,8314,8319,8321,8326,8328,8333,8334],{"type":1444,"nodeName":1461,"attributes":8156,"children":8158},{"id":8157},"page-41",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8161,"children":8162},{"class":1493},[8163,8167],{"type":1444,"nodeName":1452,"attributes":8164,"children":8165},{"href":1518},[8166],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":8169},"\n\n\n          | \"407\"  ; ",{"type":1444,"nodeName":1452,"attributes":8171,"children":8172},{"href":3017},[8173],{"type":1449,"textContent":8174},"Section 10.4.8",{"type":1449,"textContent":8176},": Proxy Authentication Required\n          | \"408\"  ; ",{"type":1444,"nodeName":1452,"attributes":8178,"children":8179},{"href":3030},[8180],{"type":1449,"textContent":8181},"Section 10.4.9",{"type":1449,"textContent":8183},": Request Time-out\n          | \"409\"  ; ",{"type":1444,"nodeName":1452,"attributes":8185,"children":8186},{"href":3043},[8187],{"type":1449,"textContent":8188},"Section 10.4.10",{"type":1449,"textContent":8190},": Conflict\n          | \"410\"  ; ",{"type":1444,"nodeName":1452,"attributes":8192,"children":8193},{"href":3056},[8194],{"type":1449,"textContent":8195},"Section 10.4.11",{"type":1449,"textContent":8197},": Gone\n          | \"411\"  ; ",{"type":1444,"nodeName":1452,"attributes":8199,"children":8200},{"href":3071},[8201],{"type":1449,"textContent":8202},"Section 10.4.12",{"type":1449,"textContent":8204},": Length Required\n          | \"412\"  ; ",{"type":1444,"nodeName":1452,"attributes":8206,"children":8207},{"href":3084},[8208],{"type":1449,"textContent":8209},"Section 10.4.13",{"type":1449,"textContent":8211},": Precondition Failed\n          | \"413\"  ; ",{"type":1444,"nodeName":1452,"attributes":8213,"children":8214},{"href":3097},[8215],{"type":1449,"textContent":8216},"Section 10.4.14",{"type":1449,"textContent":8218},": Request Entity Too Large\n          | \"414\"  ; ",{"type":1444,"nodeName":1452,"attributes":8220,"children":8221},{"href":3112},[8222],{"type":1449,"textContent":8223},"Section 10.4.15",{"type":1449,"textContent":8225},": Request-URI Too Large\n          | \"415\"  ; ",{"type":1444,"nodeName":1452,"attributes":8227,"children":8228},{"href":3125},[8229],{"type":1449,"textContent":8230},"Section 10.4.16",{"type":1449,"textContent":8232},": Unsupported Media Type\n          | \"416\"  ; ",{"type":1444,"nodeName":1452,"attributes":8234,"children":8235},{"href":3138},[8236],{"type":1449,"textContent":8237},"Section 10.4.17",{"type":1449,"textContent":8239},": Requested range not satisfiable\n          | \"417\"  ; ",{"type":1444,"nodeName":1452,"attributes":8241,"children":8242},{"href":3151},[8243],{"type":1449,"textContent":8244},"Section 10.4.18",{"type":1449,"textContent":8246},": Expectation Failed\n          | \"500\"  ; ",{"type":1444,"nodeName":1452,"attributes":8248,"children":8249},{"href":3179},[8250],{"type":1449,"textContent":8251},"Section 10.5.1",{"type":1449,"textContent":8253},": Internal Server Error\n          | \"501\"  ; ",{"type":1444,"nodeName":1452,"attributes":8255,"children":8256},{"href":3192},[8257],{"type":1449,"textContent":8258},"Section 10.5.2",{"type":1449,"textContent":8260},": Not Implemented\n          | \"502\"  ; ",{"type":1444,"nodeName":1452,"attributes":8262,"children":8263},{"href":3205},[8264],{"type":1449,"textContent":8265},"Section 10.5.3",{"type":1449,"textContent":8267},": Bad Gateway\n          | \"503\"  ; ",{"type":1444,"nodeName":1452,"attributes":8269,"children":8270},{"href":3218},[8271],{"type":1449,"textContent":8272},"Section 10.5.4",{"type":1449,"textContent":8274},": Service Unavailable\n          | \"504\"  ; ",{"type":1444,"nodeName":1452,"attributes":8276,"children":8277},{"href":3231},[8278],{"type":1449,"textContent":8279},"Section 10.5.5",{"type":1449,"textContent":8281},": Gateway Time-out\n          | \"505\"  ; ",{"type":1444,"nodeName":1452,"attributes":8283,"children":8284},{"href":3246},[8285],{"type":1449,"textContent":8286},"Section 10.5.6",{"type":1449,"textContent":8288},": HTTP Version not supported\n          | extension-code\n\n      extension-code = 3DIGIT\n      Reason-Phrase  = *\u003CTEXT, excluding CR, LF>\n\n   HTTP status codes are extensible. HTTP applications are not required\n   to understand the meaning of all registered status codes, though such\n   understanding is obviously desirable. However, applications MUST\n   understand the class of any status code, as indicated by the first\n   digit, and treat any unrecognized response as being equivalent to the\n   x00 status code of that class, with the exception that an\n   unrecognized response MUST NOT be cached. For example, if an\n   unrecognized status code of 431 is received by the client, it can\n   safely assume that there was something wrong with its request and\n   treat the response as if it had received a 400 status code. In such\n   cases, user agents SHOULD present to the user the entity returned\n   with the response, since that entity is likely to include human-\n   readable information which will explain the unusual status.\n\n",{"type":1444,"nodeName":1461,"attributes":8290,"children":8291},{"class":5228},[8292,8296],{"type":1444,"nodeName":1452,"attributes":8293,"children":8294},{"class":5220,"id":383,"href":2167},[8295],{"type":1449,"textContent":2170},{"type":1449,"textContent":8297}," Response Header Fields",{"type":1449,"textContent":8299},"\n\n   The response-header fields allow the server to pass additional\n   information about the response which cannot be placed in the Status-\n   Line. These header fields give information about the server and about\n   further access to the resource identified by the Request-URI.\n\n       response-header = Accept-Ranges           ; ",{"type":1444,"nodeName":1452,"attributes":8301,"children":8302},{"href":3893},[8303],{"type":1449,"textContent":8304},"Section 14.5",{"type":1449,"textContent":8306},"\n                       | Age                     ; ",{"type":1444,"nodeName":1452,"attributes":8308,"children":8309},{"href":3908},[8310],{"type":1449,"textContent":8311},"Section 14.6",{"type":1449,"textContent":8313},"\n                       | ETag                    ; ",{"type":1444,"nodeName":1452,"attributes":8315,"children":8316},{"href":4202},[8317],{"type":1449,"textContent":8318},"Section 14.19",{"type":1449,"textContent":8320},"\n                       | Location                ; ",{"type":1444,"nodeName":1452,"attributes":8322,"children":8323},{"href":4387},[8324],{"type":1449,"textContent":8325},"Section 14.30",{"type":1449,"textContent":8327},"\n                       | Proxy-Authenticate      ; ",{"type":1444,"nodeName":1452,"attributes":8329,"children":8330},{"href":4430},[8331],{"type":1449,"textContent":8332},"Section 14.33",{"type":1449,"textContent":2180},{"type":1444,"nodeName":1461,"attributes":8335,"children":8336},{"class":1493},[8337],{"type":1449,"textContent":8338},"Fielding, et al.            Standards Track                    [Page 41]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8341,"children":8342},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8344,"children":8345},{"class":1506},[8346,8350,8351,8359,8361,8366,8368,8373,8375,8380,8382,8387,8389,8398,8400,8409,8411,8416,8418,8423,8425,8430,8432,8437,8439,8444,8446,8451,8453,8458,8460,8465,8467,8472,8474,8479,8481],{"type":1444,"nodeName":1461,"attributes":8347,"children":8349},{"id":8348},"page-42",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8352,"children":8353},{"class":1493},[8354,8358],{"type":1444,"nodeName":1452,"attributes":8355,"children":8356},{"href":1518},[8357],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":8360},"\n\n\n                       | Retry-After             ; ",{"type":1444,"nodeName":1452,"attributes":8362,"children":8363},{"href":4516},[8364],{"type":1449,"textContent":8365},"Section 14.37",{"type":1449,"textContent":8367},"\n                       | Server                  ; ",{"type":1444,"nodeName":1452,"attributes":8369,"children":8370},{"href":4531},[8371],{"type":1449,"textContent":8372},"Section 14.38",{"type":1449,"textContent":8374},"\n                       | Vary                    ; ",{"type":1444,"nodeName":1452,"attributes":8376,"children":8377},{"href":4617},[8378],{"type":1449,"textContent":8379},"Section 14.44",{"type":1449,"textContent":8381},"\n                       | WWW-Authenticate        ; ",{"type":1444,"nodeName":1452,"attributes":8383,"children":8384},{"href":4660},[8385],{"type":1449,"textContent":8386},"Section 14.47",{"type":1449,"textContent":8388},"\n\n   Response-header field names can be extended reliably only in\n   combination with a change in the protocol version. However, new or\n   experimental header fields MAY be given the semantics of response-\n   header fields if all parties in the communication recognize them to\n   be response-header fields. Unrecognized header fields are treated as\n   entity-header fields.\n\n",{"type":1444,"nodeName":1461,"attributes":8390,"children":8391},{"class":5216},[8392,8396],{"type":1444,"nodeName":1452,"attributes":8393,"children":8394},{"class":5220,"id":388,"href":2210},[8395],{"type":1449,"textContent":1539},{"type":1449,"textContent":8397}," Entity",{"type":1449,"textContent":8399},"\n\n   Request and Response messages MAY transfer an entity if not otherwise\n   restricted by the request method or response status code. An entity\n   consists of entity-header fields and an entity-body, although some\n   responses will only include the entity-headers.\n\n   In this section, both sender and recipient refer to either the client\n   or the server, depending on who sends and who receives the entity.\n\n",{"type":1444,"nodeName":1461,"attributes":8401,"children":8402},{"class":5228},[8403,8407],{"type":1444,"nodeName":1452,"attributes":8404,"children":8405},{"class":5220,"id":394,"href":2224},[8406],{"type":1449,"textContent":2227},{"type":1449,"textContent":8408}," Entity Header Fields",{"type":1449,"textContent":8410},"\n\n   Entity-header fields define metainformation about the entity-body or,\n   if no body is present, about the resource identified by the request.\n   Some of this metainformation is OPTIONAL; some might be REQUIRED by\n   portions of this specification.\n\n       entity-header  = Allow                    ; ",{"type":1444,"nodeName":1452,"attributes":8412,"children":8413},{"href":3923},[8414],{"type":1449,"textContent":8415},"Section 14.7",{"type":1449,"textContent":8417},"\n                      | Content-Encoding         ; ",{"type":1444,"nodeName":1452,"attributes":8419,"children":8420},{"href":4071},[8421],{"type":1449,"textContent":8422},"Section 14.11",{"type":1449,"textContent":8424},"\n                      | Content-Language         ; ",{"type":1444,"nodeName":1452,"attributes":8426,"children":8427},{"href":4086},[8428],{"type":1449,"textContent":8429},"Section 14.12",{"type":1449,"textContent":8431},"\n                      | Content-Length           ; ",{"type":1444,"nodeName":1452,"attributes":8433,"children":8434},{"href":4099},[8435],{"type":1449,"textContent":8436},"Section 14.13",{"type":1449,"textContent":8438},"\n                      | Content-Location         ; ",{"type":1444,"nodeName":1452,"attributes":8440,"children":8441},{"href":4114},[8442],{"type":1449,"textContent":8443},"Section 14.14",{"type":1449,"textContent":8445},"\n                      | Content-MD5              ; ",{"type":1444,"nodeName":1452,"attributes":8447,"children":8448},{"href":4129},[8449],{"type":1449,"textContent":8450},"Section 14.15",{"type":1449,"textContent":8452},"\n                      | Content-Range            ; ",{"type":1444,"nodeName":1452,"attributes":8454,"children":8455},{"href":4144},[8456],{"type":1449,"textContent":8457},"Section 14.16",{"type":1449,"textContent":8459},"\n                      | Content-Type             ; ",{"type":1444,"nodeName":1452,"attributes":8461,"children":8462},{"href":4159},[8463],{"type":1449,"textContent":8464},"Section 14.17",{"type":1449,"textContent":8466},"\n                      | Expires                  ; ",{"type":1444,"nodeName":1452,"attributes":8468,"children":8469},{"href":4230},[8470],{"type":1449,"textContent":8471},"Section 14.21",{"type":1449,"textContent":8473},"\n                      | Last-Modified            ; ",{"type":1444,"nodeName":1452,"attributes":8475,"children":8476},{"href":4374},[8477],{"type":1449,"textContent":8478},"Section 14.29",{"type":1449,"textContent":8480},"\n                      | extension-header\n\n       extension-header = message-header\n\n   The extension-header mechanism allows additional entity-header fields\n   to be defined without changing the protocol, but these fields cannot\n   be assumed to be recognizable by the recipient. Unrecognized header\n   fields SHOULD be ignored by the recipient and MUST be forwarded by\n   transparent proxies.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8482,"children":8483},{"class":1493},[8484],{"type":1449,"textContent":8485},"Fielding, et al.            Standards Track                    [Page 42]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8488,"children":8489},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8491,"children":8492},{"class":1506},[8493,8497,8498,8506,8507,8516,8518,8523,8525,8534,8536,8545,8547,8552,8554],{"type":1444,"nodeName":1461,"attributes":8494,"children":8496},{"id":8495},"page-43",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8499,"children":8500},{"class":1493},[8501,8505],{"type":1444,"nodeName":1452,"attributes":8502,"children":8503},{"href":1518},[8504],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":8508,"children":8509},{"class":5228},[8510,8514],{"type":1444,"nodeName":1452,"attributes":8511,"children":8512},{"class":5220,"id":399,"href":2237},[8513],{"type":1449,"textContent":2240},{"type":1449,"textContent":8515}," Entity Body",{"type":1449,"textContent":8517},"\n\n   The entity-body (if any) sent with an HTTP request or response is in\n   a format and encoding defined by the entity-header fields.\n\n       entity-body    = *OCTET\n\n   An entity-body is only present in a message when a message-body is\n   present, as described in ",{"type":1444,"nodeName":1452,"attributes":8519,"children":8520},{"href":1998},[8521],{"type":1449,"textContent":8522},"section 4.3",{"type":1449,"textContent":8524},". The entity-body is obtained\n   from the message-body by decoding any Transfer-Encoding that might\n   have been applied to ensure safe and proper transfer of the message.\n\n",{"type":1444,"nodeName":1461,"attributes":8526,"children":8527},{"class":5964},[8528,8532],{"type":1444,"nodeName":1452,"attributes":8529,"children":8530},{"class":5220,"id":405,"href":2252},[8531],{"type":1449,"textContent":2255},{"type":1449,"textContent":8533}," Type",{"type":1449,"textContent":8535},"\n\n   When an entity-body is included with a message, the data type of that\n   body is determined via the header fields Content-Type and Content-\n   Encoding. These define a two-layer, ordered encoding model:\n\n       entity-body := Content-Encoding( Content-Type( data ) )\n\n   Content-Type specifies the media type of the underlying data.\n   Content-Encoding may be used to indicate any additional content\n   codings applied to the data, usually for the purpose of data\n   compression, that are a property of the requested resource. There is\n   no default encoding.\n\n   Any HTTP\u002F1.1 message containing an entity-body SHOULD include a\n   Content-Type header field defining the media type of that body. If\n   and only if the media type is not given by a Content-Type field, the\n   recipient MAY attempt to guess the media type via inspection of its\n   content and\u002For the name extension(s) of the URI used to identify the\n   resource. If the media type remains unknown, the recipient SHOULD\n   treat it as type \"application\u002Foctet-stream\".\n\n",{"type":1444,"nodeName":1461,"attributes":8537,"children":8538},{"class":5964},[8539,8543],{"type":1444,"nodeName":1452,"attributes":8540,"children":8541},{"class":5220,"id":410,"href":2265},[8542],{"type":1449,"textContent":2268},{"type":1449,"textContent":8544}," Entity Length",{"type":1449,"textContent":8546},"\n\n   The entity-length of a message is the length of the message-body\n   before any transfer-codings have been applied. ",{"type":1444,"nodeName":1452,"attributes":8548,"children":8549},{"href":2013},[8550],{"type":1449,"textContent":8551},"Section 4.4",{"type":1449,"textContent":8553}," defines\n   how the transfer-length of a message-body is determined.\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8555,"children":8556},{"class":1493},[8557],{"type":1449,"textContent":8558},"Fielding, et al.            Standards Track                    [Page 43]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8561,"children":8562},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8564,"children":8565},{"class":1506},[8566,8570,8571,8579,8580,8589,8590,8599,8600,8608,8610,8615,8617,8622,8624,8628,8630,8635,8637,8642,8644],{"type":1444,"nodeName":1461,"attributes":8567,"children":8569},{"id":8568},"page-44",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8572,"children":8573},{"class":1493},[8574,8578],{"type":1444,"nodeName":1452,"attributes":8575,"children":8576},{"href":1518},[8577],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":8581,"children":8582},{"class":5216},[8583,8587],{"type":1444,"nodeName":1452,"attributes":8584,"children":8585},{"class":5220,"id":415,"href":2278},[8586],{"type":1449,"textContent":1568},{"type":1449,"textContent":8588}," Connections",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":8591,"children":8592},{"class":5228},[8593,8597],{"type":1444,"nodeName":1452,"attributes":8594,"children":8595},{"class":5220,"id":421,"href":2292},[8596],{"type":1449,"textContent":2295},{"type":1449,"textContent":8598}," Persistent Connections",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":8601,"children":8602},{"class":5964},[8603,8607],{"type":1444,"nodeName":1452,"attributes":8604,"children":8605},{"class":5220,"id":427,"href":2305},[8606],{"type":1449,"textContent":2308},{"type":1449,"textContent":5235},{"type":1449,"textContent":8609},"\n\n   Prior to persistent connections, a separate TCP connection was\n   established to fetch each URL, increasing the load on HTTP servers\n   and causing congestion on the Internet. The use of inline images and\n   other associated data often require a client to make multiple\n   requests of the same server in a short amount of time. Analysis of\n   these performance problems and results from a prototype\n   implementation are available [",{"type":1444,"nodeName":1452,"attributes":8611,"children":8613},{"href":8612},"#ref-26",[8614],{"type":1449,"textContent":1854},{"type":1449,"textContent":8616},"] [",{"type":1444,"nodeName":1452,"attributes":8618,"children":8620},{"href":8619},"#ref-30",[8621],{"type":1449,"textContent":1940},{"type":1449,"textContent":8623},"]. Implementation experience and\n   measurements of actual HTTP\u002F1.1 (",{"type":1444,"nodeName":1452,"attributes":8625,"children":8626},{"href":1454},[8627],{"type":1449,"textContent":1480},{"type":1449,"textContent":8629},") implementations show good\n   results [",{"type":1444,"nodeName":1452,"attributes":8631,"children":8633},{"href":8632},"#ref-39",[8634],{"type":1449,"textContent":2137},{"type":1449,"textContent":8636},"]. Alternatives have also been explored, for example,\n   T\u002FTCP [",{"type":1444,"nodeName":1452,"attributes":8638,"children":8640},{"href":8639},"#ref-27",[8641],{"type":1449,"textContent":1869},{"type":1449,"textContent":8643},"].\n\n   Persistent HTTP connections have a number of advantages:\n\n      - By opening and closing fewer TCP connections, CPU time is saved\n        in routers and hosts (clients, servers, proxies, gateways,\n        tunnels, or caches), and memory used for TCP protocol control\n        blocks can be saved in hosts.\n\n      - HTTP requests and responses can be pipelined on a connection.\n        Pipelining allows a client to make multiple requests without\n        waiting for each response, allowing a single TCP connection to\n        be used much more efficiently, with much lower elapsed time.\n\n      - Network congestion is reduced by reducing the number of packets\n        caused by TCP opens, and by allowing TCP sufficient time to\n        determine the congestion state of the network.\n\n      - Latency on subsequent requests is reduced since there is no time\n        spent in TCP's connection opening handshake.\n\n      - HTTP can evolve more gracefully, since errors can be reported\n        without the penalty of closing the TCP connection. Clients using\n        future versions of HTTP might optimistically try a new feature,\n        but if communicating with an older server, retry with old\n        semantics after an error is reported.\n\n   HTTP implementations SHOULD implement persistent connections.\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8645,"children":8646},{"class":1493},[8647],{"type":1449,"textContent":8648},"Fielding, et al.            Standards Track                    [Page 44]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8651,"children":8652},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8654,"children":8655},{"class":1506},[8656,8660,8661,8669,8670,8678,8680,8685,8687,8699,8701,8706,8708,8712,8714],{"type":1444,"nodeName":1461,"attributes":8657,"children":8659},{"id":8658},"page-45",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8662,"children":8663},{"class":1493},[8664,8668],{"type":1444,"nodeName":1452,"attributes":8665,"children":8666},{"href":1518},[8667],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":8671,"children":8672},{"class":5964},[8673,8677],{"type":1444,"nodeName":1452,"attributes":8674,"children":8675},{"class":5220,"id":432,"href":2318},[8676],{"type":1449,"textContent":2321},{"type":1449,"textContent":5562},{"type":1449,"textContent":8679},"\n\n   A significant difference between HTTP\u002F1.1 and earlier versions of\n   HTTP is that persistent connections are the default behavior of any\n   HTTP connection. That is, unless otherwise indicated, the client\n   SHOULD assume that the server will maintain a persistent connection,\n   even after error responses from the server.\n\n   Persistent connections provide a mechanism by which a client and a\n   server can signal the close of a TCP connection. This signaling takes\n   place using the Connection header field (",{"type":1444,"nodeName":1452,"attributes":8681,"children":8682},{"href":4056},[8683],{"type":1449,"textContent":8684},"section 14.10",{"type":1449,"textContent":8686},"). Once a close\n   has been signaled, the client MUST NOT send any more requests on that\n   connection.\n\n",{"type":1444,"nodeName":1461,"attributes":8688,"children":8690},{"class":8689},"h5",[8691,8697],{"type":1444,"nodeName":1452,"attributes":8692,"children":8694},{"class":5220,"id":438,"href":8693},"#section-8.1.2.1",[8695],{"type":1449,"textContent":8696},"8.1.2.1",{"type":1449,"textContent":8698}," Negotiation",{"type":1449,"textContent":8700},"\n\n   An HTTP\u002F1.1 server MAY assume that a HTTP\u002F1.1 client intends to\n   maintain a persistent connection unless a Connection header including\n   the connection-token \"close\" was sent in the request. If the server\n   chooses to close the connection immediately after sending the\n   response, it SHOULD send a Connection header including the\n   connection-token close.\n\n   An HTTP\u002F1.1 client MAY expect a connection to remain open, but would\n   decide to keep it open based on whether the response from a server\n   contains a Connection header with the connection-token close. In case\n   the client does not want to maintain a connection for more than that\n   request, it SHOULD send a Connection header including the\n   connection-token close.\n\n   If either the client or the server sends the close token in the\n   Connection header, that request becomes the last one for the\n   connection.\n\n   Clients and servers SHOULD NOT assume that a persistent connection is\n   maintained for HTTP versions less than 1.1 unless it is explicitly\n   signaled. See ",{"type":1444,"nodeName":1452,"attributes":8702,"children":8703},{"href":5153},[8704],{"type":1449,"textContent":8705},"section 19.6.2",{"type":1449,"textContent":8707}," for more information on backward\n   compatibility with HTTP\u002F1.0 clients.\n\n   In order to remain persistent, all messages on the connection MUST\n   have a self-defined message length (i.e., one not defined by closure\n   of the connection), as described in ",{"type":1444,"nodeName":1452,"attributes":8709,"children":8710},{"href":2013},[8711],{"type":1449,"textContent":6520},{"type":1449,"textContent":8713},".\n\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8715,"children":8716},{"class":1493},[8717],{"type":1449,"textContent":8718},"Fielding, et al.            Standards Track                    [Page 45]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8721,"children":8722},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8724,"children":8725},{"class":1506},[8726,8730,8731,8739,8740,8751,8753,8758,8760,8769,8771,8775,8776,8780,8782,8786,8787,8791,8793,8802,8804],{"type":1444,"nodeName":1461,"attributes":8727,"children":8729},{"id":8728},"page-46",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8732,"children":8733},{"class":1493},[8734,8738],{"type":1444,"nodeName":1452,"attributes":8735,"children":8736},{"href":1518},[8737],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":8741,"children":8742},{"class":8689},[8743,8749],{"type":1444,"nodeName":1452,"attributes":8744,"children":8746},{"class":5220,"id":443,"href":8745},"#section-8.1.2.2",[8747],{"type":1449,"textContent":8748},"8.1.2.2",{"type":1449,"textContent":8750}," Pipelining",{"type":1449,"textContent":8752},"\n\n   A client that supports persistent connections MAY \"pipeline\" its\n   requests (i.e., send multiple requests without waiting for each\n   response). A server MUST send its responses to those requests in the\n   same order that the requests were received.\n\n   Clients which assume persistent connections and pipeline immediately\n   after connection establishment SHOULD be prepared to retry their\n   connection if the first pipelined attempt fails. If a client does\n   such a retry, it MUST NOT pipeline before it knows the connection is\n   persistent. Clients MUST also be prepared to resend their requests if\n   the server closes the connection before sending all of the\n   corresponding responses.\n\n   Clients SHOULD NOT pipeline requests using non-idempotent methods or\n   non-idempotent sequences of methods (see ",{"type":1444,"nodeName":1452,"attributes":8754,"children":8755},{"href":2465},[8756],{"type":1449,"textContent":8757},"section 9.1.2",{"type":1449,"textContent":8759},"). Otherwise, a\n   premature termination of the transport connection could lead to\n   indeterminate results. A client wishing to send a non-idempotent\n   request SHOULD wait to send that request until it has received the\n   response status for the previous request.\n\n",{"type":1444,"nodeName":1461,"attributes":8761,"children":8762},{"class":5964},[8763,8767],{"type":1444,"nodeName":1452,"attributes":8764,"children":8765},{"class":5220,"id":448,"href":2333},[8766],{"type":1449,"textContent":2336},{"type":1449,"textContent":8768}," Proxy Servers",{"type":1449,"textContent":8770},"\n\n   It is especially important that proxies correctly implement the\n   properties of the Connection header field as specified in ",{"type":1444,"nodeName":1452,"attributes":8772,"children":8773},{"href":4056},[8774],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":8777,"children":8778},{"href":4056},[8779],{"type":1449,"textContent":4059},{"type":1449,"textContent":8781},".\n\n   The proxy server MUST signal persistent connections separately with\n   its clients and the origin servers (or other proxy servers) that it\n   connects to. Each persistent connection applies to only one transport\n   link.\n\n   A proxy server MUST NOT establish a HTTP\u002F1.1 persistent connection\n   with an HTTP\u002F1.0 client (but see ",{"type":1444,"nodeName":1452,"attributes":8783,"children":8784},{"href":1454},[8785],{"type":1449,"textContent":1480},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":8788,"children":8789},{"href":1485},[8790],{"type":1449,"textContent":1488},{"type":1449,"textContent":8792},"] for information and\n   discussion of the problems with the Keep-Alive header implemented by\n   many HTTP\u002F1.0 clients).\n\n",{"type":1444,"nodeName":1461,"attributes":8794,"children":8795},{"class":5964},[8796,8800],{"type":1444,"nodeName":1452,"attributes":8797,"children":8798},{"class":5220,"id":453,"href":2348},[8799],{"type":1449,"textContent":2351},{"type":1449,"textContent":8801}," Practical Considerations",{"type":1449,"textContent":8803},"\n\n   Servers will usually have some time-out value beyond which they will\n   no longer maintain an inactive connection. Proxy servers might make\n   this a higher value since it is likely that the client will be making\n   more connections through the same server. The use of persistent\n   connections places no requirements on the length (or existence) of\n   this time-out for either the client or the server.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8805,"children":8806},{"class":1493},[8807],{"type":1449,"textContent":8808},"Fielding, et al.            Standards Track                    [Page 46]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8811,"children":8812},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8814,"children":8815},{"class":1506},[8816,8820,8821,8829,8831,8835,8837,8846,8847,8856,8858],{"type":1444,"nodeName":1461,"attributes":8817,"children":8819},{"id":8818},"page-47",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8822,"children":8823},{"class":1493},[8824,8828],{"type":1444,"nodeName":1452,"attributes":8825,"children":8826},{"href":1518},[8827],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":8830},"\n\n\n   When a client or server wishes to time-out it SHOULD issue a graceful\n   close on the transport connection. Clients and servers SHOULD both\n   constantly watch for the other side of the transport close, and\n   respond to it as appropriate. If a client or server does not detect\n   the other side's close promptly it could cause unnecessary resource\n   drain on the network.\n\n   A client, server, or proxy MAY close the transport connection at any\n   time. For example, a client might have started to send a new request\n   at the same time that the server has decided to close the \"idle\"\n   connection. From the server's point of view, the connection is being\n   closed while it was idle, but from the client's point of view, a\n   request is in progress.\n\n   This means that clients, servers, and proxies MUST be able to recover\n   from asynchronous close events. Client software SHOULD reopen the\n   transport connection and retransmit the aborted sequence of requests\n   without user interaction so long as the request sequence is\n   idempotent (see ",{"type":1444,"nodeName":1452,"attributes":8832,"children":8833},{"href":2465},[8834],{"type":1449,"textContent":8757},{"type":1449,"textContent":8836},"). Non-idempotent methods or sequences\n   MUST NOT be automatically retried, although user agents MAY offer a\n   human operator the choice of retrying the request(s). Confirmation by\n   user-agent software with semantic understanding of the application\n   MAY substitute for user confirmation. The automatic retry SHOULD NOT\n   be repeated if the second sequence of requests fails.\n\n   Servers SHOULD always respond to at least one request per connection,\n   if at all possible. Servers SHOULD NOT close a connection in the\n   middle of transmitting a response, unless a network or client failure\n   is suspected.\n\n   Clients that use persistent connections SHOULD limit the number of\n   simultaneous connections that they maintain to a given server. A\n   single-user client SHOULD NOT maintain more than 2 connections with\n   any server or proxy. A proxy SHOULD use up to 2*N connections to\n   another server or proxy, where N is the number of simultaneously\n   active users. These guidelines are intended to improve HTTP response\n   times and avoid congestion.\n\n",{"type":1444,"nodeName":1461,"attributes":8838,"children":8839},{"class":5228},[8840,8844],{"type":1444,"nodeName":1452,"attributes":8841,"children":8842},{"class":5220,"id":458,"href":2361},[8843],{"type":1449,"textContent":2364},{"type":1449,"textContent":8845}," Message Transmission Requirements",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":8848,"children":8849},{"class":5964},[8850,8854],{"type":1444,"nodeName":1452,"attributes":8851,"children":8852},{"class":5220,"id":464,"href":2375},[8853],{"type":1449,"textContent":2378},{"type":1449,"textContent":8855}," Persistent Connections and Flow Control",{"type":1449,"textContent":8857},"\n\n   HTTP\u002F1.1 servers SHOULD maintain persistent connections and use TCP's\n   flow control mechanisms to resolve temporary overloads, rather than\n   terminating connections with the expectation that clients will retry.\n   The latter technique can exacerbate network congestion.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8859,"children":8860},{"class":1493},[8861],{"type":1449,"textContent":8862},"Fielding, et al.            Standards Track                    [Page 47]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8865,"children":8866},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8868,"children":8869},{"class":1506},[8870,8874,8875,8883,8884,8893,8895,8899,8901,8910,8912,8917,8919,8924,8926,8930,8932,8936,8938],{"type":1444,"nodeName":1461,"attributes":8871,"children":8873},{"id":8872},"page-48",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8876,"children":8877},{"class":1493},[8878,8882],{"type":1444,"nodeName":1452,"attributes":8879,"children":8880},{"href":1518},[8881],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":8885,"children":8886},{"class":5964},[8887,8891],{"type":1444,"nodeName":1452,"attributes":8888,"children":8889},{"class":5220,"id":469,"href":2388},[8890],{"type":1449,"textContent":2391},{"type":1449,"textContent":8892}," Monitoring Connections for Error Status Messages",{"type":1449,"textContent":8894},"\n\n   An HTTP\u002F1.1 (or later) client sending a message-body SHOULD monitor\n   the network connection for an error status while it is transmitting\n   the request. If the client sees an error status, it SHOULD\n   immediately cease transmitting the body. If the body is being sent\n   using a \"chunked\" encoding (",{"type":1444,"nodeName":1452,"attributes":8896,"children":8897},{"href":1813},[8898],{"type":1449,"textContent":6699},{"type":1449,"textContent":8900},"), a zero length chunk and\n   empty trailer MAY be used to prematurely mark the end of the message.\n   If the body was preceded by a Content-Length header, the client MUST\n   close the connection.\n\n",{"type":1444,"nodeName":1461,"attributes":8902,"children":8903},{"class":5964},[8904,8908],{"type":1444,"nodeName":1452,"attributes":8905,"children":8906},{"class":5220,"id":474,"href":2403},[8907],{"type":1449,"textContent":2406},{"type":1449,"textContent":8909}," Use of the 100 (Continue) Status",{"type":1449,"textContent":8911},"\n\n   The purpose of the 100 (Continue) status (see ",{"type":1444,"nodeName":1452,"attributes":8913,"children":8914},{"href":2620},[8915],{"type":1449,"textContent":8916},"section 10.1.1",{"type":1449,"textContent":8918},") is to\n   allow a client that is sending a request message with a request body\n   to determine if the origin server is willing to accept the request\n   (based on the request headers) before the client sends the request\n   body. In some cases, it might either be inappropriate or highly\n   inefficient for the client to send the body if the server will reject\n   the message without looking at the body.\n\n   Requirements for HTTP\u002F1.1 clients:\n\n      - If a client will wait for a 100 (Continue) response before\n        sending the request body, it MUST send an Expect request-header\n        field (",{"type":1444,"nodeName":1452,"attributes":8920,"children":8921},{"href":4217},[8922],{"type":1449,"textContent":8923},"section 14.20",{"type":1449,"textContent":8925},") with the \"100-continue\" expectation.\n\n      - A client MUST NOT send an Expect request-header field (",{"type":1444,"nodeName":1452,"attributes":8927,"children":8928},{"href":4217},[8929],{"type":1449,"textContent":5813},{"type":1449,"textContent":8931},"\n        ",{"type":1444,"nodeName":1452,"attributes":8933,"children":8934},{"href":4217},[8935],{"type":1449,"textContent":4220},{"type":1449,"textContent":8937},") with the \"100-continue\" expectation if it does not intend\n        to send a request body.\n\n   Because of the presence of older implementations, the protocol allows\n   ambiguous situations in which a client may send \"Expect: 100-\n   continue\" without receiving either a 417 (Expectation Failed) status\n   or a 100 (Continue) status. Therefore, when a client sends this\n   header field to an origin server (possibly via a proxy) from which it\n   has never seen a 100 (Continue) status, the client SHOULD NOT wait\n   for an indefinite period before sending the request body.\n\n   Requirements for HTTP\u002F1.1 origin servers:\n\n      - Upon receiving a request which includes an Expect request-header\n        field with the \"100-continue\" expectation, an origin server MUST\n        either respond with 100 (Continue) status and continue to read\n        from the input stream, or respond with a final status code. The\n        origin server MUST NOT wait for the request body before sending\n        the 100 (Continue) response. If it responds with a final status\n        code, it MAY close the transport connection or it MAY continue\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8939,"children":8940},{"class":1493},[8941],{"type":1449,"textContent":8942},"Fielding, et al.            Standards Track                    [Page 48]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8945,"children":8946},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8948,"children":8949},{"class":1506},[8950,8954,8955,8963,8965,8969,8971],{"type":1444,"nodeName":1461,"attributes":8951,"children":8953},{"id":8952},"page-49",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8956,"children":8957},{"class":1493},[8958,8962],{"type":1444,"nodeName":1452,"attributes":8959,"children":8960},{"href":1518},[8961],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":8964},"\n\n\n        to read and discard the rest of the request.  It MUST NOT\n        perform the requested method if it returns a final status code.\n\n      - An origin server SHOULD NOT send a 100 (Continue) response if\n        the request message does not include an Expect request-header\n        field with the \"100-continue\" expectation, and MUST NOT send a\n        100 (Continue) response if such a request comes from an HTTP\u002F1.0\n        (or earlier) client. There is an exception to this rule: for\n        compatibility with ",{"type":1444,"nodeName":1452,"attributes":8966,"children":8967},{"href":1454},[8968],{"type":1449,"textContent":1480},{"type":1449,"textContent":8970},", a server MAY send a 100 (Continue)\n        status in response to an HTTP\u002F1.1 PUT or POST request that does\n        not include an Expect request-header field with the \"100-\n        continue\" expectation. This exception, the purpose of which is\n        to minimize any client processing delays associated with an\n        undeclared wait for 100 (Continue) status, applies only to\n        HTTP\u002F1.1 requests, and not to requests with any other HTTP-\n        version value.\n\n      - An origin server MAY omit a 100 (Continue) response if it has\n        already received some or all of the request body for the\n        corresponding request.\n\n      - An origin server that sends a 100 (Continue) response MUST\n        ultimately send a final status code, once the request body is\n        received and processed, unless it terminates the transport\n        connection prematurely.\n\n      - If an origin server receives a request that does not include an\n        Expect request-header field with the \"100-continue\" expectation,\n        the request includes a request body, and the server responds\n        with a final status code before reading the entire request body\n        from the transport connection, then the server SHOULD NOT close\n        the transport connection until it has read the entire request,\n        or until the client closes the connection. Otherwise, the client\n        might not reliably receive the response message. However, this\n        requirement is not be construed as preventing a server from\n        defending itself against denial-of-service attacks, or from\n        badly broken client implementations.\n\n   Requirements for HTTP\u002F1.1 proxies:\n\n      - If a proxy receives a request that includes an Expect request-\n        header field with the \"100-continue\" expectation, and the proxy\n        either knows that the next-hop server complies with HTTP\u002F1.1 or\n        higher, or does not know the HTTP version of the next-hop\n        server, it MUST forward the request, including the Expect header\n        field.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":8972,"children":8973},{"class":1493},[8974],{"type":1449,"textContent":8975},"Fielding, et al.            Standards Track                    [Page 49]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":8978,"children":8979},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":8981,"children":8982},{"class":1506},[8983,8987,8988,8996,8998,9003,9004,9013,9015],{"type":1444,"nodeName":1461,"attributes":8984,"children":8986},{"id":8985},"page-50",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":8989,"children":8990},{"class":1493},[8991,8995],{"type":1444,"nodeName":1452,"attributes":8992,"children":8993},{"href":1518},[8994],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":8997},"\n\n\n      - If the proxy knows that the version of the next-hop server is\n        HTTP\u002F1.0 or lower, it MUST NOT forward the request, and it MUST\n        respond with a 417 (Expectation Failed) status.\n\n      - Proxies SHOULD maintain a cache recording the HTTP version\n        numbers received from recently-referenced next-hop servers.\n\n      - A proxy MUST NOT forward a 100 (Continue) response if the\n        request message was received from an HTTP\u002F1.0 (or earlier)\n        client and did not include an Expect request-header field with\n        the \"100-continue\" expectation. This requirement overrides the\n        general rule for forwarding of 1xx responses (see ",{"type":1444,"nodeName":1452,"attributes":8999,"children":9000},{"href":2607},[9001],{"type":1449,"textContent":9002},"section 10.1",{"type":1449,"textContent":5638},{"type":1444,"nodeName":1461,"attributes":9005,"children":9006},{"class":5964},[9007,9011],{"type":1444,"nodeName":1452,"attributes":9008,"children":9009},{"class":5220,"id":479,"href":2416},[9010],{"type":1449,"textContent":2419},{"type":1449,"textContent":9012}," Client Behavior if Server Prematurely Closes Connection",{"type":1449,"textContent":9014},"\n\n   If an HTTP\u002F1.1 client sends a request which includes a request body,\n   but which does not include an Expect request-header field with the\n   \"100-continue\" expectation, and if the client is not directly\n   connected to an HTTP\u002F1.1 origin server, and if the client sees the\n   connection close before receiving any status from the server, the\n   client SHOULD retry the request.  If the client does retry this\n   request, it MAY use the following \"binary exponential backoff\"\n   algorithm to be assured of obtaining a reliable response:\n\n      1. Initiate a new connection to the server\n\n      2. Transmit the request-headers\n\n      3. Initialize a variable R to the estimated round-trip time to the\n         server (e.g., based on the time it took to establish the\n         connection), or to a constant value of 5 seconds if the round-\n         trip time is not available.\n\n      4. Compute T = R * (2**N), where N is the number of previous\n         retries of this request.\n\n      5. Wait either for an error response from the server, or for T\n         seconds (whichever comes first)\n\n      6. If no error response is received, after T seconds transmit the\n         body of the request.\n\n      7. If client sees that the connection is closed prematurely,\n         repeat from step 1 until the request is accepted, an error\n         response is received, or the user becomes impatient and\n         terminates the retry process.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9016,"children":9017},{"class":1493},[9018],{"type":1449,"textContent":9019},"Fielding, et al.            Standards Track                    [Page 50]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9022,"children":9023},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9025,"children":9026},{"class":1506},[9027,9031,9032,9040,9042,9051,9053,9058,9060,9069,9070,9079,9081,9090,9092],{"type":1444,"nodeName":1461,"attributes":9028,"children":9030},{"id":9029},"page-51",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9033,"children":9034},{"class":1493},[9035,9039],{"type":1444,"nodeName":1452,"attributes":9036,"children":9037},{"href":1518},[9038],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9041},"\n\n\n   If at any point an error status is received, the client\n\n      - SHOULD NOT continue and\n\n      - SHOULD close the connection if it has not completed sending the\n        request message.\n\n",{"type":1444,"nodeName":1461,"attributes":9043,"children":9044},{"class":5216},[9045,9049],{"type":1444,"nodeName":1452,"attributes":9046,"children":9047},{"class":5220,"id":484,"href":2424},[9048],{"type":1449,"textContent":2427},{"type":1449,"textContent":9050}," Method Definitions",{"type":1449,"textContent":9052},"\n\n   The set of common methods for HTTP\u002F1.1 is defined below. Although\n   this set can be expanded, additional methods cannot be assumed to\n   share the same semantics for separately extended clients and servers.\n\n   The Host request-header field (",{"type":1444,"nodeName":1452,"attributes":9054,"children":9055},{"href":4286},[9056],{"type":1449,"textContent":9057},"section 14.23",{"type":1449,"textContent":9059},") MUST accompany all\n   HTTP\u002F1.1 requests.\n\n",{"type":1444,"nodeName":1461,"attributes":9061,"children":9062},{"class":5228},[9063,9067],{"type":1444,"nodeName":1452,"attributes":9064,"children":9065},{"class":5220,"id":490,"href":2439},[9066],{"type":1449,"textContent":2442},{"type":1449,"textContent":9068}," Safe and Idempotent Methods",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":9071,"children":9072},{"class":5964},[9073,9077],{"type":1444,"nodeName":1452,"attributes":9074,"children":9075},{"class":5220,"id":496,"href":2452},[9076],{"type":1449,"textContent":2455},{"type":1449,"textContent":9078}," Safe Methods",{"type":1449,"textContent":9080},"\n\n   Implementors should be aware that the software represents the user in\n   their interactions over the Internet, and should be careful to allow\n   the user to be aware of any actions they might take which may have an\n   unexpected significance to themselves or others.\n\n   In particular, the convention has been established that the GET and\n   HEAD methods SHOULD NOT have the significance of taking an action\n   other than retrieval. These methods ought to be considered \"safe\".\n   This allows user agents to represent other methods, such as POST, PUT\n   and DELETE, in a special way, so that the user is made aware of the\n   fact that a possibly unsafe action is being requested.\n\n   Naturally, it is not possible to ensure that the server does not\n   generate side-effects as a result of performing a GET request; in\n   fact, some dynamic resources consider that a feature. The important\n   distinction here is that the user did not request the side-effects,\n   so therefore cannot be held accountable for them.\n\n",{"type":1444,"nodeName":1461,"attributes":9082,"children":9083},{"class":5964},[9084,9088],{"type":1444,"nodeName":1452,"attributes":9085,"children":9086},{"class":5220,"id":501,"href":2465},[9087],{"type":1449,"textContent":2468},{"type":1449,"textContent":9089}," Idempotent Methods",{"type":1449,"textContent":9091},"\n\n   Methods can also have the property of \"idempotence\" in that (aside\n   from error or expiration issues) the side-effects of N > 0 identical\n   requests is the same as for a single request. The methods GET, HEAD,\n   PUT and DELETE share this property. Also, the methods OPTIONS and\n   TRACE SHOULD NOT have side effects, and so are inherently idempotent.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9093,"children":9094},{"class":1493},[9095],{"type":1449,"textContent":9096},"Fielding, et al.            Standards Track                    [Page 51]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9099,"children":9100},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9102,"children":9103},{"class":1506},[9104,9108,9109,9117,9119,9128,9130],{"type":1444,"nodeName":1461,"attributes":9105,"children":9107},{"id":9106},"page-52",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9110,"children":9111},{"class":1493},[9112,9116],{"type":1444,"nodeName":1452,"attributes":9113,"children":9114},{"href":1518},[9115],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9118},"\n\n\n   However, it is possible that a sequence of several requests is non-\n   idempotent, even if all of the methods executed in that sequence are\n   idempotent. (A sequence is idempotent if a single execution of the\n   entire sequence always yields a result that is not changed by a\n   reexecution of all, or part, of that sequence.) For example, a\n   sequence is non-idempotent if its result depends on a value that is\n   later modified in the same sequence.\n\n   A sequence that never has side effects is idempotent, by definition\n   (provided that no concurrent operations are being executed on the\n   same set of resources).\n\n",{"type":1444,"nodeName":1461,"attributes":9120,"children":9121},{"class":5228},[9122,9126],{"type":1444,"nodeName":1452,"attributes":9123,"children":9124},{"class":5220,"id":506,"href":2478},[9125],{"type":1449,"textContent":2481},{"type":1449,"textContent":9127}," OPTIONS",{"type":1449,"textContent":9129},"\n\n   The OPTIONS method represents a request for information about the\n   communication options available on the request\u002Fresponse chain\n   identified by the Request-URI. This method allows the client to\n   determine the options and\u002For requirements associated with a resource,\n   or the capabilities of a server, without implying a resource action\n   or initiating a resource retrieval.\n\n   Responses to this method are not cacheable.\n\n   If the OPTIONS request includes an entity-body (as indicated by the\n   presence of Content-Length or Transfer-Encoding), then the media type\n   MUST be indicated by a Content-Type field. Although this\n   specification does not define any use for such a body, future\n   extensions to HTTP might use the OPTIONS body to make more detailed\n   queries on the server. A server that does not support such an\n   extension MAY discard the request body.\n\n   If the Request-URI is an asterisk (\"*\"), the OPTIONS request is\n   intended to apply to the server in general rather than to a specific\n   resource. Since a server's communication options typically depend on\n   the resource, the \"*\" request is only useful as a \"ping\" or \"no-op\"\n   type of method; it does nothing beyond allowing the client to test\n   the capabilities of the server. For example, this can be used to test\n   a proxy for HTTP\u002F1.1 compliance (or lack thereof).\n\n   If the Request-URI is not an asterisk, the OPTIONS request applies\n   only to the options that are available when communicating with that\n   resource.\n\n   A 200 response SHOULD include any header fields that indicate\n   optional features implemented by the server and applicable to that\n   resource (e.g., Allow), possibly including extensions not defined by\n   this specification. The response body, if any, SHOULD also include\n   information about the communication options. The format for such a\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9131,"children":9132},{"class":1493},[9133],{"type":1449,"textContent":9134},"Fielding, et al.            Standards Track                    [Page 52]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9137,"children":9138},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9140,"children":9141},{"class":1506},[9142,9146,9147,9155,9157,9166,9168,9172,9173,9177,9179,9183,9185,9190,9192],{"type":1444,"nodeName":1461,"attributes":9143,"children":9145},{"id":9144},"page-53",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9148,"children":9149},{"class":1493},[9150,9154],{"type":1444,"nodeName":1452,"attributes":9151,"children":9152},{"href":1518},[9153],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9156},"\n\n\n   body is not defined by this specification, but might be defined by\n   future extensions to HTTP. Content negotiation MAY be used to select\n   the appropriate response format. If no response body is included, the\n   response MUST include a Content-Length field with a field-value of\n   \"0\".\n\n   The Max-Forwards request-header field MAY be used to target a\n   specific proxy in the request chain. When a proxy receives an OPTIONS\n   request on an absoluteURI for which request forwarding is permitted,\n   the proxy MUST check for a Max-Forwards field. If the Max-Forwards\n   field-value is zero (\"0\"), the proxy MUST NOT forward the message;\n   instead, the proxy SHOULD respond with its own communication options.\n   If the Max-Forwards field-value is an integer greater than zero, the\n   proxy MUST decrement the field-value when it forwards the request. If\n   no Max-Forwards field is present in the request, then the forwarded\n   request MUST NOT include a Max-Forwards field.\n\n",{"type":1444,"nodeName":1461,"attributes":9158,"children":9159},{"class":5228},[9160,9164],{"type":1444,"nodeName":1452,"attributes":9161,"children":9162},{"class":5220,"id":511,"href":2493},[9163],{"type":1449,"textContent":2496},{"type":1449,"textContent":9165}," GET",{"type":1449,"textContent":9167},"\n\n   The GET method means retrieve whatever information (in the form of an\n   entity) is identified by the Request-URI. If the Request-URI refers\n   to a data-producing process, it is the produced data which shall be\n   returned as the entity in the response and not the source text of the\n   process, unless that text happens to be the output of the process.\n\n   The semantics of the GET method change to a \"conditional GET\" if the\n   request message includes an If-Modified-Since, If-Unmodified-Since,\n   If-Match, If-None-Match, or If-Range header field. A conditional GET\n   method requests that the entity be transferred only under the\n   circumstances described by the conditional header field(s). The\n   conditional GET method is intended to reduce unnecessary network\n   usage by allowing cached entities to be refreshed without requiring\n   multiple requests or transferring data already held by the client.\n\n   The semantics of the GET method change to a \"partial GET\" if the\n   request message includes a Range header field. A partial GET requests\n   that only part of the entity be transferred, as described in ",{"type":1444,"nodeName":1452,"attributes":9169,"children":9170},{"href":4458},[9171],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":9174,"children":9175},{"href":4458},[9176],{"type":1449,"textContent":4461},{"type":1449,"textContent":9178},". The partial GET method is intended to reduce unnecessary\n   network usage by allowing partially-retrieved entities to be\n   completed without transferring data already held by the client.\n\n   The response to a GET request is cacheable if and only if it meets\n   the requirements for HTTP caching described in ",{"type":1444,"nodeName":1452,"attributes":9180,"children":9181},{"href":3329},[9182],{"type":1449,"textContent":5497},{"type":1449,"textContent":9184},".\n\n   See ",{"type":1444,"nodeName":1452,"attributes":9186,"children":9187},{"href":4728},[9188],{"type":1449,"textContent":9189},"section 15.1.3",{"type":1449,"textContent":9191}," for security considerations when used for forms.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9193,"children":9194},{"class":1493},[9195],{"type":1449,"textContent":9196},"Fielding, et al.            Standards Track                    [Page 53]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9199,"children":9200},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9202,"children":9203},{"class":1506},[9204,9208,9209,9217,9218,9227,9229,9238,9240],{"type":1444,"nodeName":1461,"attributes":9205,"children":9207},{"id":9206},"page-54",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9210,"children":9211},{"class":1493},[9212,9216],{"type":1444,"nodeName":1452,"attributes":9213,"children":9214},{"href":1518},[9215],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":9219,"children":9220},{"class":5228},[9221,9225],{"type":1444,"nodeName":1452,"attributes":9222,"children":9223},{"class":5220,"id":516,"href":2508},[9224],{"type":1449,"textContent":2511},{"type":1449,"textContent":9226}," HEAD",{"type":1449,"textContent":9228},"\n\n   The HEAD method is identical to GET except that the server MUST NOT\n   return a message-body in the response. The metainformation contained\n   in the HTTP headers in response to a HEAD request SHOULD be identical\n   to the information sent in response to a GET request. This method can\n   be used for obtaining metainformation about the entity implied by the\n   request without transferring the entity-body itself. This method is\n   often used for testing hypertext links for validity, accessibility,\n   and recent modification.\n\n   The response to a HEAD request MAY be cacheable in the sense that the\n   information contained in the response MAY be used to update a\n   previously cached entity from that resource. If the new field values\n   indicate that the cached entity differs from the current entity (as\n   would be indicated by a change in Content-Length, Content-MD5, ETag\n   or Last-Modified), then the cache MUST treat the cache entry as\n   stale.\n\n",{"type":1444,"nodeName":1461,"attributes":9230,"children":9231},{"class":5228},[9232,9236],{"type":1444,"nodeName":1452,"attributes":9233,"children":9234},{"class":5220,"id":521,"href":2523},[9235],{"type":1449,"textContent":2526},{"type":1449,"textContent":9237}," POST",{"type":1449,"textContent":9239},"\n\n   The POST method is used to request that the origin server accept the\n   entity enclosed in the request as a new subordinate of the resource\n   identified by the Request-URI in the Request-Line. POST is designed\n   to allow a uniform method to cover the following functions:\n\n      - Annotation of existing resources;\n\n      - Posting a message to a bulletin board, newsgroup, mailing list,\n        or similar group of articles;\n\n      - Providing a block of data, such as the result of submitting a\n        form, to a data-handling process;\n\n      - Extending a database through an append operation.\n\n   The actual function performed by the POST method is determined by the\n   server and is usually dependent on the Request-URI. The posted entity\n   is subordinate to that URI in the same way that a file is subordinate\n   to a directory containing it, a news article is subordinate to a\n   newsgroup to which it is posted, or a record is subordinate to a\n   database.\n\n   The action performed by the POST method might not result in a\n   resource that can be identified by a URI. In this case, either 200\n   (OK) or 204 (No Content) is the appropriate response status,\n   depending on whether or not the response includes an entity that\n   describes the result.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9241,"children":9242},{"class":1493},[9243],{"type":1449,"textContent":9244},"Fielding, et al.            Standards Track                    [Page 54]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9247,"children":9248},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9250,"children":9251},{"class":1506},[9252,9256,9257,9265,9267,9272,9274,9279,9280,9284,9286,9295,9297],{"type":1444,"nodeName":1461,"attributes":9253,"children":9255},{"id":9254},"page-55",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9258,"children":9259},{"class":1493},[9260,9264],{"type":1444,"nodeName":1452,"attributes":9261,"children":9262},{"href":1518},[9263],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9266},"\n\n\n   If a resource has been created on the origin server, the response\n   SHOULD be 201 (Created) and contain an entity which describes the\n   status of the request and refers to the new resource, and a Location\n   header (see ",{"type":1444,"nodeName":1452,"attributes":9268,"children":9269},{"href":4387},[9270],{"type":1449,"textContent":9271},"section 14.30",{"type":1449,"textContent":9273},").\n\n   Responses to this method are not cacheable, unless the response\n   includes appropriate Cache-Control or Expires header fields. However,\n   the 303 (See Other) response can be used to direct the user agent to\n   retrieve a cacheable resource.\n\n   POST requests MUST obey the message transmission requirements set out\n   in ",{"type":1444,"nodeName":1452,"attributes":9275,"children":9276},{"href":2361},[9277],{"type":1449,"textContent":9278},"section 8.2",{"type":1449,"textContent":9184},{"type":1444,"nodeName":1452,"attributes":9281,"children":9282},{"href":4728},[9283],{"type":1449,"textContent":9189},{"type":1449,"textContent":9285}," for security considerations.\n\n",{"type":1444,"nodeName":1461,"attributes":9287,"children":9288},{"class":5228},[9289,9293],{"type":1444,"nodeName":1452,"attributes":9290,"children":9291},{"class":5220,"id":526,"href":2536},[9292],{"type":1449,"textContent":2539},{"type":1449,"textContent":9294}," PUT",{"type":1449,"textContent":9296},"\n\n   The PUT method requests that the enclosed entity be stored under the\n   supplied Request-URI. If the Request-URI refers to an already\n   existing resource, the enclosed entity SHOULD be considered as a\n   modified version of the one residing on the origin server. If the\n   Request-URI does not point to an existing resource, and that URI is\n   capable of being defined as a new resource by the requesting user\n   agent, the origin server can create the resource with that URI. If a\n   new resource is created, the origin server MUST inform the user agent\n   via the 201 (Created) response. If an existing resource is modified,\n   either the 200 (OK) or 204 (No Content) response codes SHOULD be sent\n   to indicate successful completion of the request. If the resource\n   could not be created or modified with the Request-URI, an appropriate\n   error response SHOULD be given that reflects the nature of the\n   problem. The recipient of the entity MUST NOT ignore any Content-*\n   (e.g. Content-Range) headers that it does not understand or implement\n   and MUST return a 501 (Not Implemented) response in such cases.\n\n   If the request passes through a cache and the Request-URI identifies\n   one or more currently cached entities, those entries SHOULD be\n   treated as stale. Responses to this method are not cacheable.\n\n   The fundamental difference between the POST and PUT requests is\n   reflected in the different meaning of the Request-URI. The URI in a\n   POST request identifies the resource that will handle the enclosed\n   entity. That resource might be a data-accepting process, a gateway to\n   some other protocol, or a separate entity that accepts annotations.\n   In contrast, the URI in a PUT request identifies the entity enclosed\n   with the request -- the user agent knows what URI is intended and the\n   server MUST NOT attempt to apply the request to some other resource.\n   If the server desires that the request be applied to a different URI,\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9298,"children":9299},{"class":1493},[9300],{"type":1449,"textContent":9301},"Fielding, et al.            Standards Track                    [Page 55]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9304,"children":9305},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9307,"children":9308},{"class":1506},[9309,9313,9314,9322,9324,9328,9330,9339,9341,9350,9352],{"type":1444,"nodeName":1461,"attributes":9310,"children":9312},{"id":9311},"page-56",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9315,"children":9316},{"class":1493},[9317,9321],{"type":1444,"nodeName":1452,"attributes":9318,"children":9319},{"href":1518},[9320],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9323},"\n\n\n   it MUST send a 301 (Moved Permanently) response; the user agent MAY\n   then make its own decision regarding whether or not to redirect the\n   request.\n\n   A single resource MAY be identified by many different URIs. For\n   example, an article might have a URI for identifying \"the current\n   version\" which is separate from the URI identifying each particular\n   version. In this case, a PUT request on a general URI might result in\n   several other URIs being defined by the origin server.\n\n   HTTP\u002F1.1 does not define how a PUT method affects the state of an\n   origin server.\n\n   PUT requests MUST obey the message transmission requirements set out\n   in ",{"type":1444,"nodeName":1452,"attributes":9325,"children":9326},{"href":2361},[9327],{"type":1449,"textContent":9278},{"type":1449,"textContent":9329},".\n\n   Unless otherwise specified for a particular entity-header, the\n   entity-headers in the PUT request SHOULD be applied to the resource\n   created or modified by the PUT.\n\n",{"type":1444,"nodeName":1461,"attributes":9331,"children":9332},{"class":5228},[9333,9337],{"type":1444,"nodeName":1452,"attributes":9334,"children":9335},{"class":5220,"id":531,"href":2551},[9336],{"type":1449,"textContent":2554},{"type":1449,"textContent":9338}," DELETE",{"type":1449,"textContent":9340},"\n\n   The DELETE method requests that the origin server delete the resource\n   identified by the Request-URI. This method MAY be overridden by human\n   intervention (or other means) on the origin server. The client cannot\n   be guaranteed that the operation has been carried out, even if the\n   status code returned from the origin server indicates that the action\n   has been completed successfully. However, the server SHOULD NOT\n   indicate success unless, at the time the response is given, it\n   intends to delete the resource or move it to an inaccessible\n   location.\n\n   A successful response SHOULD be 200 (OK) if the response includes an\n   entity describing the status, 202 (Accepted) if the action has not\n   yet been enacted, or 204 (No Content) if the action has been enacted\n   but the response does not include an entity.\n\n   If the request passes through a cache and the Request-URI identifies\n   one or more currently cached entities, those entries SHOULD be\n   treated as stale. Responses to this method are not cacheable.\n\n",{"type":1444,"nodeName":1461,"attributes":9342,"children":9343},{"class":5228},[9344,9348],{"type":1444,"nodeName":1452,"attributes":9345,"children":9346},{"class":5220,"id":536,"href":2566},[9347],{"type":1449,"textContent":2569},{"type":1449,"textContent":9349}," TRACE",{"type":1449,"textContent":9351},"\n\n   The TRACE method is used to invoke a remote, application-layer loop-\n   back of the request message. The final recipient of the request\n   SHOULD reflect the message received back to the client as the\n   entity-body of a 200 (OK) response. The final recipient is either the\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9353,"children":9354},{"class":1493},[9355],{"type":1449,"textContent":9356},"Fielding, et al.            Standards Track                    [Page 56]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9359,"children":9360},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9362,"children":9363},{"class":1506},[9364,9368,9369,9377,9379,9384,9386,9391,9393,9402,9404,9409,9411,9420,9422,9431,9433],{"type":1444,"nodeName":1461,"attributes":9365,"children":9367},{"id":9366},"page-57",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9370,"children":9371},{"class":1493},[9372,9376],{"type":1444,"nodeName":1452,"attributes":9373,"children":9374},{"href":1518},[9375],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9378},"\n\n\n   origin server or the first proxy or gateway to receive a Max-Forwards\n   value of zero (0) in the request (see ",{"type":1444,"nodeName":1452,"attributes":9380,"children":9381},{"href":4402},[9382],{"type":1449,"textContent":9383},"section 14.31",{"type":1449,"textContent":9385},"). A TRACE request\n   MUST NOT include an entity.\n\n   TRACE allows the client to see what is being received at the other\n   end of the request chain and use that data for testing or diagnostic\n   information. The value of the Via header field (",{"type":1444,"nodeName":1452,"attributes":9387,"children":9388},{"href":4630},[9389],{"type":1449,"textContent":9390},"section 14.45",{"type":1449,"textContent":9392},") is of\n   particular interest, since it acts as a trace of the request chain.\n   Use of the Max-Forwards header field allows the client to limit the\n   length of the request chain, which is useful for testing a chain of\n   proxies forwarding messages in an infinite loop.\n\n   If the request is valid, the response SHOULD contain the entire\n   request message in the entity-body, with a Content-Type of\n   \"message\u002Fhttp\". Responses to this method MUST NOT be cached.\n\n",{"type":1444,"nodeName":1461,"attributes":9394,"children":9395},{"class":5228},[9396,9400],{"type":1444,"nodeName":1452,"attributes":9397,"children":9398},{"class":5220,"id":541,"href":2579},[9399],{"type":1449,"textContent":2582},{"type":1449,"textContent":9401}," CONNECT",{"type":1449,"textContent":9403},"\n\n   This specification reserves the method name CONNECT for use with a\n   proxy that can dynamically switch to being a tunnel (e.g. SSL\n   tunneling [",{"type":1444,"nodeName":1452,"attributes":9405,"children":9407},{"href":9406},"#ref-44",[9408],{"type":1449,"textContent":2288},{"type":1449,"textContent":9410},"]).\n\n",{"type":1444,"nodeName":1461,"attributes":9412,"children":9413},{"class":5216},[9414,9418],{"type":1444,"nodeName":1452,"attributes":9415,"children":9416},{"class":5220,"id":546,"href":2594},[9417],{"type":1449,"textContent":2597},{"type":1449,"textContent":9419}," Status Code Definitions",{"type":1449,"textContent":9421},"\n\n   Each Status-Code is described below, including a description of which\n   method(s) it can follow and any metainformation required in the\n   response.\n\n",{"type":1444,"nodeName":1461,"attributes":9423,"children":9424},{"class":5228},[9425,9429],{"type":1444,"nodeName":1452,"attributes":9426,"children":9427},{"class":5220,"id":552,"href":2607},[9428],{"type":1449,"textContent":2610},{"type":1449,"textContent":9430}," Informational 1xx",{"type":1449,"textContent":9432},"\n\n   This class of status code indicates a provisional response,\n   consisting only of the Status-Line and optional headers, and is\n   terminated by an empty line. There are no required headers for this\n   class of status code. Since HTTP\u002F1.0 did not define any 1xx status\n   codes, servers MUST NOT send a 1xx response to an HTTP\u002F1.0 client\n   except under experimental conditions.\n\n   A client MUST be prepared to accept one or more 1xx status responses\n   prior to a regular response, even if the client does not expect a 100\n   (Continue) status message. Unexpected 1xx status responses MAY be\n   ignored by a user agent.\n\n   Proxies MUST forward 1xx responses, unless the connection between the\n   proxy and its client has been closed, or unless the proxy itself\n   requested the generation of the 1xx response. (For example, if a\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9434,"children":9435},{"class":1493},[9436],{"type":1449,"textContent":9437},"Fielding, et al.            Standards Track                    [Page 57]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9440,"children":9441},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9443,"children":9444},{"class":1506},[9445,9449,9450,9458,9460,9469,9471,9476,9478,9487,9489,9494,9496,9505,9507,9516,9518],{"type":1444,"nodeName":1461,"attributes":9446,"children":9448},{"id":9447},"page-58",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9451,"children":9452},{"class":1493},[9453,9457],{"type":1444,"nodeName":1452,"attributes":9454,"children":9455},{"href":1518},[9456],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9459},"\n\n\n   proxy adds a \"Expect: 100-continue\" field when it forwards a request,\n   then it need not forward the corresponding 100 (Continue)\n   response(s).)\n\n",{"type":1444,"nodeName":1461,"attributes":9461,"children":9462},{"class":5964},[9463,9467],{"type":1444,"nodeName":1452,"attributes":9464,"children":9465},{"class":5220,"id":558,"href":2620},[9466],{"type":1449,"textContent":2623},{"type":1449,"textContent":9468}," 100 Continue",{"type":1449,"textContent":9470},"\n\n   The client SHOULD continue with its request. This interim response is\n   used to inform the client that the initial part of the request has\n   been received and has not yet been rejected by the server. The client\n   SHOULD continue by sending the remainder of the request or, if the\n   request has already been completed, ignore this response. The server\n   MUST send a final response after the request has been completed. See\n   ",{"type":1444,"nodeName":1452,"attributes":9472,"children":9473},{"href":2403},[9474],{"type":1449,"textContent":9475},"section 8.2.3",{"type":1449,"textContent":9477}," for detailed discussion of the use and handling of this\n   status code.\n\n",{"type":1444,"nodeName":1461,"attributes":9479,"children":9480},{"class":5964},[9481,9485],{"type":1444,"nodeName":1452,"attributes":9482,"children":9483},{"class":5220,"id":563,"href":2635},[9484],{"type":1449,"textContent":2638},{"type":1449,"textContent":9486}," 101 Switching Protocols",{"type":1449,"textContent":9488},"\n\n   The server understands and is willing to comply with the client's\n   request, via the Upgrade message header field (",{"type":1444,"nodeName":1452,"attributes":9490,"children":9491},{"href":4587},[9492],{"type":1449,"textContent":9493},"section 14.42",{"type":1449,"textContent":9495},"), for a\n   change in the application protocol being used on this connection. The\n   server will switch protocols to those defined by the response's\n   Upgrade header field immediately after the empty line which\n   terminates the 101 response.\n\n   The protocol SHOULD be switched only when it is advantageous to do\n   so. For example, switching to a newer version of HTTP is advantageous\n   over older versions, and switching to a real-time, synchronous\n   protocol might be advantageous when delivering resources that use\n   such features.\n\n",{"type":1444,"nodeName":1461,"attributes":9497,"children":9498},{"class":5228},[9499,9503],{"type":1444,"nodeName":1452,"attributes":9500,"children":9501},{"class":5220,"id":568,"href":2648},[9502],{"type":1449,"textContent":2651},{"type":1449,"textContent":9504}," Successful 2xx",{"type":1449,"textContent":9506},"\n\n   This class of status code indicates that the client's request was\n   successfully received, understood, and accepted.\n\n",{"type":1444,"nodeName":1461,"attributes":9508,"children":9509},{"class":5964},[9510,9514],{"type":1444,"nodeName":1452,"attributes":9511,"children":9512},{"class":5220,"id":574,"href":2661},[9513],{"type":1449,"textContent":2664},{"type":1449,"textContent":9515}," 200 OK",{"type":1449,"textContent":9517},"\n\n   The request has succeeded. The information returned with the response\n   is dependent on the method used in the request, for example:\n\n   GET    an entity corresponding to the requested resource is sent in\n          the response;\n\n   HEAD   the entity-header fields corresponding to the requested\n          resource are sent in the response without any message-body;\n\n   POST   an entity describing or containing the result of the action;\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9519,"children":9520},{"class":1493},[9521],{"type":1449,"textContent":9522},"Fielding, et al.            Standards Track                    [Page 58]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9525,"children":9526},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9528,"children":9529},{"class":1506},[9530,9534,9535,9543,9545,9554,9556,9561,9562,9571,9573,9582,9584],{"type":1444,"nodeName":1461,"attributes":9531,"children":9533},{"id":9532},"page-59",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9536,"children":9537},{"class":1493},[9538,9542],{"type":1444,"nodeName":1452,"attributes":9539,"children":9540},{"href":1518},[9541],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9544},"\n\n\n   TRACE  an entity containing the request message as received by the\n          end server.\n\n",{"type":1444,"nodeName":1461,"attributes":9546,"children":9547},{"class":5964},[9548,9552],{"type":1444,"nodeName":1452,"attributes":9549,"children":9550},{"class":5220,"id":579,"href":2674},[9551],{"type":1449,"textContent":2677},{"type":1449,"textContent":9553}," 201 Created",{"type":1449,"textContent":9555},"\n\n   The request has been fulfilled and resulted in a new resource being\n   created. The newly created resource can be referenced by the URI(s)\n   returned in the entity of the response, with the most specific URI\n   for the resource given by a Location header field. The response\n   SHOULD include an entity containing a list of resource\n   characteristics and location(s) from which the user or user agent can\n   choose the one most appropriate. The entity format is specified by\n   the media type given in the Content-Type header field. The origin\n   server MUST create the resource before returning the 201 status code.\n   If the action cannot be carried out immediately, the server SHOULD\n   respond with 202 (Accepted) response instead.\n\n   A 201 response MAY contain an ETag response header field indicating\n   the current value of the entity tag for the requested variant just\n   created, see ",{"type":1444,"nodeName":1452,"attributes":9557,"children":9558},{"href":4202},[9559],{"type":1449,"textContent":9560},"section 14.19",{"type":1449,"textContent":6397},{"type":1444,"nodeName":1461,"attributes":9563,"children":9564},{"class":5964},[9565,9569],{"type":1444,"nodeName":1452,"attributes":9566,"children":9567},{"class":5220,"id":584,"href":2689},[9568],{"type":1449,"textContent":2692},{"type":1449,"textContent":9570}," 202 Accepted",{"type":1449,"textContent":9572},"\n\n   The request has been accepted for processing, but the processing has\n   not been completed.  The request might or might not eventually be\n   acted upon, as it might be disallowed when processing actually takes\n   place. There is no facility for re-sending a status code from an\n   asynchronous operation such as this.\n\n   The 202 response is intentionally non-committal. Its purpose is to\n   allow a server to accept a request for some other process (perhaps a\n   batch-oriented process that is only run once per day) without\n   requiring that the user agent's connection to the server persist\n   until the process is completed. The entity returned with this\n   response SHOULD include an indication of the request's current status\n   and either a pointer to a status monitor or some estimate of when the\n   user can expect the request to be fulfilled.\n\n",{"type":1444,"nodeName":1461,"attributes":9574,"children":9575},{"class":5964},[9576,9580],{"type":1444,"nodeName":1452,"attributes":9577,"children":9578},{"class":5220,"id":589,"href":2702},[9579],{"type":1449,"textContent":2705},{"type":1449,"textContent":9581}," 203 Non-Authoritative Information",{"type":1449,"textContent":9583},"\n\n   The returned metainformation in the entity-header is not the\n   definitive set as available from the origin server, but is gathered\n   from a local or a third-party copy. The set presented MAY be a subset\n   or superset of the original version. For example, including local\n   annotation information about the resource might result in a superset\n   of the metainformation known by the origin server. Use of this\n   response code is not required and is only appropriate when the\n   response would otherwise be 200 (OK).\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9585,"children":9586},{"class":1493},[9587],{"type":1449,"textContent":9588},"Fielding, et al.            Standards Track                    [Page 59]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9591,"children":9592},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9594,"children":9595},{"class":1506},[9596,9600,9601,9609,9610,9619,9621,9630,9632,9641,9643,9647,9649,9653,9655,9659,9661],{"type":1444,"nodeName":1461,"attributes":9597,"children":9599},{"id":9598},"page-60",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9602,"children":9603},{"class":1493},[9604,9608],{"type":1444,"nodeName":1452,"attributes":9605,"children":9606},{"href":1518},[9607],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":9611,"children":9612},{"class":5964},[9613,9617],{"type":1444,"nodeName":1452,"attributes":9614,"children":9615},{"class":5220,"id":594,"href":2715},[9616],{"type":1449,"textContent":2718},{"type":1449,"textContent":9618}," 204 No Content",{"type":1449,"textContent":9620},"\n\n   The server has fulfilled the request but does not need to return an\n   entity-body, and might want to return updated metainformation. The\n   response MAY include new or updated metainformation in the form of\n   entity-headers, which if present SHOULD be associated with the\n   requested variant.\n\n   If the client is a user agent, it SHOULD NOT change its document view\n   from that which caused the request to be sent. This response is\n   primarily intended to allow input for actions to take place without\n   causing a change to the user agent's active document view, although\n   any new or updated metainformation SHOULD be applied to the document\n   currently in the user agent's active view.\n\n   The 204 response MUST NOT include a message-body, and thus is always\n   terminated by the first empty line after the header fields.\n\n",{"type":1444,"nodeName":1461,"attributes":9622,"children":9623},{"class":5964},[9624,9628],{"type":1444,"nodeName":1452,"attributes":9625,"children":9626},{"class":5220,"id":599,"href":2730},[9627],{"type":1449,"textContent":2733},{"type":1449,"textContent":9629}," 205 Reset Content",{"type":1449,"textContent":9631},"\n\n   The server has fulfilled the request and the user agent SHOULD reset\n   the document view which caused the request to be sent. This response\n   is primarily intended to allow input for actions to take place via\n   user input, followed by a clearing of the form in which the input is\n   given so that the user can easily initiate another input action. The\n   response MUST NOT include an entity.\n\n",{"type":1444,"nodeName":1461,"attributes":9633,"children":9634},{"class":5964},[9635,9639],{"type":1444,"nodeName":1452,"attributes":9636,"children":9637},{"class":5220,"id":604,"href":2743},[9638],{"type":1449,"textContent":2746},{"type":1449,"textContent":9640}," 206 Partial Content",{"type":1449,"textContent":9642},"\n\n   The server has fulfilled the partial GET request for the resource.\n   The request MUST have included a Range header field (",{"type":1444,"nodeName":1452,"attributes":9644,"children":9645},{"href":4458},[9646],{"type":1449,"textContent":7031},{"type":1449,"textContent":9648},")\n   indicating the desired range, and MAY have included an If-Range\n   header field (",{"type":1444,"nodeName":1452,"attributes":9650,"children":9651},{"href":4344},[9652],{"type":1449,"textContent":7006},{"type":1449,"textContent":9654},") to make the request conditional.\n\n   The response MUST include the following header fields:\n\n      - Either a Content-Range header field (",{"type":1444,"nodeName":1452,"attributes":9656,"children":9657},{"href":4144},[9658],{"type":1449,"textContent":7038},{"type":1449,"textContent":9660},") indicating\n        the range included with this response, or a multipart\u002Fbyteranges\n        Content-Type including Content-Range fields for each part. If a\n        Content-Length header field is present in the response, its\n        value MUST match the actual number of OCTETs transmitted in the\n        message-body.\n\n      - Date\n\n      - ETag and\u002For Content-Location, if the header would have been sent\n        in a 200 response to the same request\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9662,"children":9663},{"class":1493},[9664],{"type":1449,"textContent":9665},"Fielding, et al.            Standards Track                    [Page 60]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9668,"children":9669},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9671,"children":9672},{"class":1506},[9673,9677,9678,9686,9688,9692,9694,9703,9705,9714,9716,9720,9722],{"type":1444,"nodeName":1461,"attributes":9674,"children":9676},{"id":9675},"page-61",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9679,"children":9680},{"class":1493},[9681,9685],{"type":1444,"nodeName":1452,"attributes":9682,"children":9683},{"href":1518},[9684],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9687},"\n\n\n      - Expires, Cache-Control, and\u002For Vary, if the field-value might\n        differ from that sent in any previous response for the same\n        variant\n\n   If the 206 response is the result of an If-Range request that used a\n   strong cache validator (see ",{"type":1444,"nodeName":1452,"attributes":9689,"children":9690},{"href":3596},[9691],{"type":1449,"textContent":7013},{"type":1449,"textContent":9693},"), the response SHOULD NOT\n   include other entity-headers. If the response is the result of an\n   If-Range request that used a weak validator, the response MUST NOT\n   include other entity-headers; this prevents inconsistencies between\n   cached entity-bodies and updated headers. Otherwise, the response\n   MUST include all of the entity-headers that would have been returned\n   with a 200 (OK) response to the same request.\n\n   A cache MUST NOT combine a 206 response with other previously cached\n   content if the ETag or Last-Modified headers do not match exactly,\n   see 13.5.4.\n\n   A cache that does not support the Range and Content-Range headers\n   MUST NOT cache 206 (Partial) responses.\n\n",{"type":1444,"nodeName":1461,"attributes":9695,"children":9696},{"class":5228},[9697,9701],{"type":1444,"nodeName":1452,"attributes":9698,"children":9699},{"class":5220,"id":609,"href":2756},[9700],{"type":1449,"textContent":2759},{"type":1449,"textContent":9702}," Redirection 3xx",{"type":1449,"textContent":9704},"\n\n   This class of status code indicates that further action needs to be\n   taken by the user agent in order to fulfill the request.  The action\n   required MAY be carried out by the user agent without interaction\n   with the user if and only if the method used in the second request is\n   GET or HEAD. A client SHOULD detect infinite redirection loops, since\n   such loops generate network traffic for each redirection.\n\n      Note: previous versions of this specification recommended a\n      maximum of five redirections. Content developers should be aware\n      that there might be clients that implement such a fixed\n      limitation.\n\n",{"type":1444,"nodeName":1461,"attributes":9706,"children":9707},{"class":5964},[9708,9712],{"type":1444,"nodeName":1452,"attributes":9709,"children":9710},{"class":5220,"id":615,"href":2771},[9711],{"type":1449,"textContent":2774},{"type":1449,"textContent":9713}," 300 Multiple Choices",{"type":1449,"textContent":9715},"\n\n   The requested resource corresponds to any one of a set of\n   representations, each with its own specific location, and agent-\n   driven negotiation information (",{"type":1444,"nodeName":1452,"attributes":9717,"children":9718},{"href":3272},[9719],{"type":1449,"textContent":5457},{"type":1449,"textContent":9721},") is being provided so that\n   the user (or user agent) can select a preferred representation and\n   redirect its request to that location.\n\n   Unless it was a HEAD request, the response SHOULD include an entity\n   containing a list of resource characteristics and location(s) from\n   which the user or user agent can choose the one most appropriate. The\n   entity format is specified by the media type given in the Content-\n   Type header field. Depending upon the format and the capabilities of\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9723,"children":9724},{"class":1493},[9725],{"type":1449,"textContent":9726},"Fielding, et al.            Standards Track                    [Page 61]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9729,"children":9730},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9732,"children":9733},{"class":1506},[9734,9738,9739,9747,9749,9758,9760,9769,9771],{"type":1444,"nodeName":1461,"attributes":9735,"children":9737},{"id":9736},"page-62",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9740,"children":9741},{"class":1493},[9742,9746],{"type":1444,"nodeName":1452,"attributes":9743,"children":9744},{"href":1518},[9745],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9748},"\n\n\n   the user agent, selection of the most appropriate choice MAY be\n   performed automatically. However, this specification does not define\n   any standard for such automatic selection.\n\n   If the server has a preferred choice of representation, it SHOULD\n   include the specific URI for that representation in the Location\n   field; user agents MAY use the Location field value for automatic\n   redirection. This response is cacheable unless indicated otherwise.\n\n",{"type":1444,"nodeName":1461,"attributes":9750,"children":9751},{"class":5964},[9752,9756],{"type":1444,"nodeName":1452,"attributes":9753,"children":9754},{"class":5220,"id":620,"href":2784},[9755],{"type":1449,"textContent":2787},{"type":1449,"textContent":9757}," 301 Moved Permanently",{"type":1449,"textContent":9759},"\n\n   The requested resource has been assigned a new permanent URI and any\n   future references to this resource SHOULD use one of the returned\n   URIs.  Clients with link editing capabilities ought to automatically\n   re-link references to the Request-URI to one or more of the new\n   references returned by the server, where possible. This response is\n   cacheable unless indicated otherwise.\n\n   The new permanent URI SHOULD be given by the Location field in the\n   response. Unless the request method was HEAD, the entity of the\n   response SHOULD contain a short hypertext note with a hyperlink to\n   the new URI(s).\n\n   If the 301 status code is received in response to a request other\n   than GET or HEAD, the user agent MUST NOT automatically redirect the\n   request unless it can be confirmed by the user, since this might\n   change the conditions under which the request was issued.\n\n      Note: When automatically redirecting a POST request after\n      receiving a 301 status code, some existing HTTP\u002F1.0 user agents\n      will erroneously change it into a GET request.\n\n",{"type":1444,"nodeName":1461,"attributes":9761,"children":9762},{"class":5964},[9763,9767],{"type":1444,"nodeName":1452,"attributes":9764,"children":9765},{"class":5220,"id":625,"href":2799},[9766],{"type":1449,"textContent":2802},{"type":1449,"textContent":9768}," 302 Found",{"type":1449,"textContent":9770},"\n\n   The requested resource resides temporarily under a different URI.\n   Since the redirection might be altered on occasion, the client SHOULD\n   continue to use the Request-URI for future requests.  This response\n   is only cacheable if indicated by a Cache-Control or Expires header\n   field.\n\n   The temporary URI SHOULD be given by the Location field in the\n   response. Unless the request method was HEAD, the entity of the\n   response SHOULD contain a short hypertext note with a hyperlink to\n   the new URI(s).\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9772,"children":9773},{"class":1493},[9774],{"type":1449,"textContent":9775},"Fielding, et al.            Standards Track                    [Page 62]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9778,"children":9779},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9781,"children":9782},{"class":1506},[9783,9787,9788,9796,9798,9802,9803,9807,9809,9818,9820,9829,9831,9836,9838],{"type":1444,"nodeName":1461,"attributes":9784,"children":9786},{"id":9785},"page-63",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9789,"children":9790},{"class":1493},[9791,9795],{"type":1444,"nodeName":1452,"attributes":9792,"children":9793},{"href":1518},[9794],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9797},"\n\n\n   If the 302 status code is received in response to a request other\n   than GET or HEAD, the user agent MUST NOT automatically redirect the\n   request unless it can be confirmed by the user, since this might\n   change the conditions under which the request was issued.\n\n      Note: ",{"type":1444,"nodeName":1452,"attributes":9799,"children":9800},{"href":5240},[9801],{"type":1449,"textContent":5243},{"type":1449,"textContent":6839},{"type":1444,"nodeName":1452,"attributes":9804,"children":9805},{"href":1454},[9806],{"type":1449,"textContent":1480},{"type":1449,"textContent":9808}," specify that the client is not allowed\n      to change the method on the redirected request.  However, most\n      existing user agent implementations treat 302 as if it were a 303\n      response, performing a GET on the Location field-value regardless\n      of the original request method. The status codes 303 and 307 have\n      been added for servers that wish to make unambiguously clear which\n      kind of reaction is expected of the client.\n\n",{"type":1444,"nodeName":1461,"attributes":9810,"children":9811},{"class":5964},[9812,9816],{"type":1444,"nodeName":1452,"attributes":9813,"children":9814},{"class":5220,"id":630,"href":2812},[9815],{"type":1449,"textContent":2815},{"type":1449,"textContent":9817}," 303 See Other",{"type":1449,"textContent":9819},"\n\n   The response to the request can be found under a different URI and\n   SHOULD be retrieved using a GET method on that resource. This method\n   exists primarily to allow the output of a POST-activated script to\n   redirect the user agent to a selected resource. The new URI is not a\n   substitute reference for the originally requested resource. The 303\n   response MUST NOT be cached, but the response to the second\n   (redirected) request might be cacheable.\n\n   The different URI SHOULD be given by the Location field in the\n   response. Unless the request method was HEAD, the entity of the\n   response SHOULD contain a short hypertext note with a hyperlink to\n   the new URI(s).\n\n      Note: Many pre-HTTP\u002F1.1 user agents do not understand the 303\n      status. When interoperability with such clients is a concern, the\n      302 status code may be used instead, since most user agents react\n      to a 302 response as described here for 303.\n\n",{"type":1444,"nodeName":1461,"attributes":9821,"children":9822},{"class":5964},[9823,9827],{"type":1444,"nodeName":1452,"attributes":9824,"children":9825},{"class":5220,"id":635,"href":2827},[9826],{"type":1449,"textContent":2830},{"type":1449,"textContent":9828}," 304 Not Modified",{"type":1449,"textContent":9830},"\n\n   If the client has performed a conditional GET request and access is\n   allowed, but the document has not been modified, the server SHOULD\n   respond with this status code. The 304 response MUST NOT contain a\n   message-body, and thus is always terminated by the first empty line\n   after the header fields.\n\n   The response MUST include the following header fields:\n\n      - Date, unless its omission is required by ",{"type":1444,"nodeName":1452,"attributes":9832,"children":9833},{"href":4187},[9834],{"type":1449,"textContent":9835},"section 14.18.1",{"type":1449,"textContent":9837},"\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9839,"children":9840},{"class":1493},[9841],{"type":1449,"textContent":9842},"Fielding, et al.            Standards Track                    [Page 63]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9845,"children":9846},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9848,"children":9849},{"class":1506},[9850,9854,9855,9863,9865,9871,9873,9877,9878,9882,9884,9893,9895,9899,9901,9910,9912],{"type":1444,"nodeName":1461,"attributes":9851,"children":9853},{"id":9852},"page-64",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9856,"children":9857},{"class":1493},[9858,9862],{"type":1444,"nodeName":1452,"attributes":9859,"children":9860},{"href":1518},[9861],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":9864},"\n\n\n   If a clockless origin server obeys these rules, and proxies and\n   clients add their own Date to any response received without one (as\n   already specified by ",{"type":1444,"nodeName":1452,"attributes":9866,"children":9868},{"href":9867},"\u002Finfo\u002Frfc2068\u002F#section-14.19",[9869],{"type":1449,"textContent":9870},"[RFC 2068], section 14.19",{"type":1449,"textContent":9872},"), caches will operate\n   correctly.\n\n      - ETag and\u002For Content-Location, if the header would have been sent\n        in a 200 response to the same request\n\n      - Expires, Cache-Control, and\u002For Vary, if the field-value might\n        differ from that sent in any previous response for the same\n        variant\n\n   If the conditional GET used a strong cache validator (see ",{"type":1444,"nodeName":1452,"attributes":9874,"children":9875},{"href":3596},[9876],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":9879,"children":9880},{"href":3596},[9881],{"type":1449,"textContent":3599},{"type":1449,"textContent":9883},"), the response SHOULD NOT include other entity-headers.\n   Otherwise (i.e., the conditional GET used a weak validator), the\n   response MUST NOT include other entity-headers; this prevents\n   inconsistencies between cached entity-bodies and updated headers.\n\n   If a 304 response indicates an entity not currently cached, then the\n   cache MUST disregard the response and repeat the request without the\n   conditional.\n\n   If a cache uses a received 304 response to update a cache entry, the\n   cache MUST update the entry to reflect any new field values given in\n   the response.\n\n",{"type":1444,"nodeName":1461,"attributes":9885,"children":9886},{"class":5964},[9887,9891],{"type":1444,"nodeName":1452,"attributes":9888,"children":9889},{"class":5220,"id":640,"href":2840},[9890],{"type":1449,"textContent":2843},{"type":1449,"textContent":9892}," 305 Use Proxy",{"type":1449,"textContent":9894},"\n\n   The requested resource MUST be accessed through the proxy given by\n   the Location field. The Location field gives the URI of the proxy.\n   The recipient is expected to repeat this single request via the\n   proxy. 305 responses MUST only be generated by origin servers.\n\n      Note: ",{"type":1444,"nodeName":1452,"attributes":9896,"children":9897},{"href":1454},[9898],{"type":1449,"textContent":1480},{"type":1449,"textContent":9900}," was not clear that 305 was intended to redirect a\n      single request, and to be generated by origin servers only.  Not\n      observing these limitations has significant security consequences.\n\n",{"type":1444,"nodeName":1461,"attributes":9902,"children":9903},{"class":5964},[9904,9908],{"type":1444,"nodeName":1452,"attributes":9905,"children":9906},{"class":5220,"id":645,"href":2855},[9907],{"type":1449,"textContent":2858},{"type":1449,"textContent":9909}," 306 (Unused)",{"type":1449,"textContent":9911},"\n\n   The 306 status code was used in a previous version of the\n   specification, is no longer used, and the code is reserved.\n\n\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9913,"children":9914},{"class":1493},[9915],{"type":1449,"textContent":9916},"Fielding, et al.            Standards Track                    [Page 64]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9919,"children":9920},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9922,"children":9923},{"class":1506},[9924,9928,9929,9937,9938,9947,9949,9958,9960,9969,9971],{"type":1444,"nodeName":1461,"attributes":9925,"children":9927},{"id":9926},"page-65",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9930,"children":9931},{"class":1493},[9932,9936],{"type":1444,"nodeName":1452,"attributes":9933,"children":9934},{"href":1518},[9935],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":9939,"children":9940},{"class":5964},[9941,9945],{"type":1444,"nodeName":1452,"attributes":9942,"children":9943},{"class":5220,"id":650,"href":2894},[9944],{"type":1449,"textContent":2897},{"type":1449,"textContent":9946}," 307 Temporary Redirect",{"type":1449,"textContent":9948},"\n\n   The requested resource resides temporarily under a different URI.\n   Since the redirection MAY be altered on occasion, the client SHOULD\n   continue to use the Request-URI for future requests.  This response\n   is only cacheable if indicated by a Cache-Control or Expires header\n   field.\n\n   The temporary URI SHOULD be given by the Location field in the\n   response. Unless the request method was HEAD, the entity of the\n   response SHOULD contain a short hypertext note with a hyperlink to\n   the new URI(s) , since many pre-HTTP\u002F1.1 user agents do not\n   understand the 307 status. Therefore, the note SHOULD contain the\n   information necessary for a user to repeat the original request on\n   the new URI.\n\n   If the 307 status code is received in response to a request other\n   than GET or HEAD, the user agent MUST NOT automatically redirect the\n   request unless it can be confirmed by the user, since this might\n   change the conditions under which the request was issued.\n\n",{"type":1444,"nodeName":1461,"attributes":9950,"children":9951},{"class":5228},[9952,9956],{"type":1444,"nodeName":1452,"attributes":9953,"children":9954},{"class":5220,"id":655,"href":2909},[9955],{"type":1449,"textContent":2912},{"type":1449,"textContent":9957}," Client Error 4xx",{"type":1449,"textContent":9959},"\n\n   The 4xx class of status code is intended for cases in which the\n   client seems to have erred. Except when responding to a HEAD request,\n   the server SHOULD include an entity containing an explanation of the\n   error situation, and whether it is a temporary or permanent\n   condition. These status codes are applicable to any request method.\n   User agents SHOULD display any included entity to the user.\n\n   If the client is sending data, a server implementation using TCP\n   SHOULD be careful to ensure that the client acknowledges receipt of\n   the packet(s) containing the response, before the server closes the\n   input connection. If the client continues sending data to the server\n   after the close, the server's TCP stack will send a reset packet to\n   the client, which may erase the client's unacknowledged input buffers\n   before they can be read and interpreted by the HTTP application.\n\n",{"type":1444,"nodeName":1461,"attributes":9961,"children":9962},{"class":5964},[9963,9967],{"type":1444,"nodeName":1452,"attributes":9964,"children":9965},{"class":5220,"id":661,"href":2922},[9966],{"type":1449,"textContent":2925},{"type":1449,"textContent":9968}," 400 Bad Request",{"type":1449,"textContent":9970},"\n\n   The request could not be understood by the server due to malformed\n   syntax. The client SHOULD NOT repeat the request without\n   modifications.\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":9972,"children":9973},{"class":1493},[9974],{"type":1449,"textContent":9975},"Fielding, et al.            Standards Track                    [Page 65]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":9978,"children":9979},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":9981,"children":9982},{"class":1506},[9983,9987,9988,9996,9997,10006,10008,10013,10015,10020,10022,10027,10028,10037,10039,10048,10050,10059,10061,10070,10072],{"type":1444,"nodeName":1461,"attributes":9984,"children":9986},{"id":9985},"page-66",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":9989,"children":9990},{"class":1493},[9991,9995],{"type":1444,"nodeName":1452,"attributes":9992,"children":9993},{"href":1518},[9994],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":9998,"children":9999},{"class":5964},[10000,10004],{"type":1444,"nodeName":1452,"attributes":10001,"children":10002},{"class":5220,"id":666,"href":2935},[10003],{"type":1449,"textContent":2938},{"type":1449,"textContent":10005}," 401 Unauthorized",{"type":1449,"textContent":10007},"\n\n   The request requires user authentication. The response MUST include a\n   WWW-Authenticate header field (",{"type":1444,"nodeName":1452,"attributes":10009,"children":10010},{"href":4660},[10011],{"type":1449,"textContent":10012},"section 14.47",{"type":1449,"textContent":10014},") containing a challenge\n   applicable to the requested resource. The client MAY repeat the\n   request with a suitable Authorization header field (",{"type":1444,"nodeName":1452,"attributes":10016,"children":10017},{"href":3936},[10018],{"type":1449,"textContent":10019},"section 14.8",{"type":1449,"textContent":10021},"). If\n   the request already included Authorization credentials, then the 401\n   response indicates that authorization has been refused for those\n   credentials. If the 401 response contains the same challenge as the\n   prior response, and the user agent has already attempted\n   authentication at least once, then the user SHOULD be presented the\n   entity that was given in the response, since that entity might\n   include relevant diagnostic information. HTTP access authentication\n   is explained in \"HTTP Authentication: Basic and Digest Access\n   Authentication\" [",{"type":1444,"nodeName":1452,"attributes":10023,"children":10025},{"href":10024},"#ref-43",[10026],{"type":1449,"textContent":2248},{"type":1449,"textContent":6352},{"type":1444,"nodeName":1461,"attributes":10029,"children":10030},{"class":5964},[10031,10035],{"type":1444,"nodeName":1452,"attributes":10032,"children":10033},{"class":5220,"id":671,"href":2950},[10034],{"type":1449,"textContent":2953},{"type":1449,"textContent":10036}," 402 Payment Required",{"type":1449,"textContent":10038},"\n\n   This code is reserved for future use.\n\n",{"type":1444,"nodeName":1461,"attributes":10040,"children":10041},{"class":5964},[10042,10046],{"type":1444,"nodeName":1452,"attributes":10043,"children":10044},{"class":5220,"id":676,"href":2963},[10045],{"type":1449,"textContent":2966},{"type":1449,"textContent":10047}," 403 Forbidden",{"type":1449,"textContent":10049},"\n\n   The server understood the request, but is refusing to fulfill it.\n   Authorization will not help and the request SHOULD NOT be repeated.\n   If the request method was not HEAD and the server wishes to make\n   public why the request has not been fulfilled, it SHOULD describe the\n   reason for the refusal in the entity.  If the server does not wish to\n   make this information available to the client, the status code 404\n   (Not Found) can be used instead.\n\n",{"type":1444,"nodeName":1461,"attributes":10051,"children":10052},{"class":5964},[10053,10057],{"type":1444,"nodeName":1452,"attributes":10054,"children":10055},{"class":5220,"id":681,"href":2976},[10056],{"type":1449,"textContent":2979},{"type":1449,"textContent":10058}," 404 Not Found",{"type":1449,"textContent":10060},"\n\n   The server has not found anything matching the Request-URI. No\n   indication is given of whether the condition is temporary or\n   permanent. The 410 (Gone) status code SHOULD be used if the server\n   knows, through some internally configurable mechanism, that an old\n   resource is permanently unavailable and has no forwarding address.\n   This status code is commonly used when the server does not wish to\n   reveal exactly why the request has been refused, or when no other\n   response is applicable.\n\n",{"type":1444,"nodeName":1461,"attributes":10062,"children":10063},{"class":5964},[10064,10068],{"type":1444,"nodeName":1452,"attributes":10065,"children":10066},{"class":5220,"id":686,"href":2989},[10067],{"type":1449,"textContent":2992},{"type":1449,"textContent":10069}," 405 Method Not Allowed",{"type":1449,"textContent":10071},"\n\n   The method specified in the Request-Line is not allowed for the\n   resource identified by the Request-URI. The response MUST include an\n   Allow header containing a list of valid methods for the requested\n   resource.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10073,"children":10074},{"class":1493},[10075],{"type":1449,"textContent":10076},"Fielding, et al.            Standards Track                    [Page 66]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10079,"children":10080},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10082,"children":10083},{"class":1506},[10084,10088,10089,10097,10098,10107,10109,10118,10120,10125,10127,10132,10134,10138,10139,10148,10150,10159,10161],{"type":1444,"nodeName":1461,"attributes":10085,"children":10087},{"id":10086},"page-67",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10090,"children":10091},{"class":1493},[10092,10096],{"type":1444,"nodeName":1452,"attributes":10093,"children":10094},{"href":1518},[10095],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":10099,"children":10100},{"class":5964},[10101,10105],{"type":1444,"nodeName":1452,"attributes":10102,"children":10103},{"class":5220,"id":691,"href":3002},[10104],{"type":1449,"textContent":3005},{"type":1449,"textContent":10106}," 406 Not Acceptable",{"type":1449,"textContent":10108},"\n\n   The resource identified by the request is only capable of generating\n   response entities which have content characteristics not acceptable\n   according to the accept headers sent in the request.\n\n   Unless it was a HEAD request, the response SHOULD include an entity\n   containing a list of available entity characteristics and location(s)\n   from which the user or user agent can choose the one most\n   appropriate. The entity format is specified by the media type given\n   in the Content-Type header field. Depending upon the format and the\n   capabilities of the user agent, selection of the most appropriate\n   choice MAY be performed automatically. However, this specification\n   does not define any standard for such automatic selection.\n\n      Note: HTTP\u002F1.1 servers are allowed to return responses which are\n      not acceptable according to the accept headers sent in the\n      request. In some cases, this may even be preferable to sending a\n      406 response. User agents are encouraged to inspect the headers of\n      an incoming response to determine if it is acceptable.\n\n   If the response could be unacceptable, a user agent SHOULD\n   temporarily stop receipt of more data and query the user for a\n   decision on further actions.\n\n",{"type":1444,"nodeName":1461,"attributes":10110,"children":10111},{"class":5964},[10112,10116],{"type":1444,"nodeName":1452,"attributes":10113,"children":10114},{"class":5220,"id":696,"href":3017},[10115],{"type":1449,"textContent":3020},{"type":1449,"textContent":10117}," 407 Proxy Authentication Required",{"type":1449,"textContent":10119},"\n\n   This code is similar to 401 (Unauthorized), but indicates that the\n   client must first authenticate itself with the proxy. The proxy MUST\n   return a Proxy-Authenticate header field (",{"type":1444,"nodeName":1452,"attributes":10121,"children":10122},{"href":4430},[10123],{"type":1449,"textContent":10124},"section 14.33",{"type":1449,"textContent":10126},") containing a\n   challenge applicable to the proxy for the requested resource. The\n   client MAY repeat the request with a suitable Proxy-Authorization\n   header field (",{"type":1444,"nodeName":1452,"attributes":10128,"children":10129},{"href":4445},[10130],{"type":1449,"textContent":10131},"section 14.34",{"type":1449,"textContent":10133},"). HTTP access authentication is explained\n   in \"HTTP Authentication: Basic and Digest Access Authentication\"\n   [",{"type":1444,"nodeName":1452,"attributes":10135,"children":10136},{"href":10024},[10137],{"type":1449,"textContent":2248},{"type":1449,"textContent":6352},{"type":1444,"nodeName":1461,"attributes":10140,"children":10141},{"class":5964},[10142,10146],{"type":1444,"nodeName":1452,"attributes":10143,"children":10144},{"class":5220,"id":701,"href":3030},[10145],{"type":1449,"textContent":3033},{"type":1449,"textContent":10147}," 408 Request Timeout",{"type":1449,"textContent":10149},"\n\n   The client did not produce a request within the time that the server\n   was prepared to wait. The client MAY repeat the request without\n   modifications at any later time.\n\n",{"type":1444,"nodeName":1461,"attributes":10151,"children":10152},{"class":5964},[10153,10157],{"type":1444,"nodeName":1452,"attributes":10154,"children":10155},{"class":5220,"id":706,"href":3043},[10156],{"type":1449,"textContent":3046},{"type":1449,"textContent":10158}," 409 Conflict",{"type":1449,"textContent":10160},"\n\n   The request could not be completed due to a conflict with the current\n   state of the resource. This code is only allowed in situations where\n   it is expected that the user might be able to resolve the conflict\n   and resubmit the request. The response body SHOULD include enough\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10162,"children":10163},{"class":1493},[10164],{"type":1449,"textContent":10165},"Fielding, et al.            Standards Track                    [Page 67]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10168,"children":10169},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10171,"children":10172},{"class":1506},[10173,10177,10178,10186,10188,10197,10199,10208,10210,10219,10221],{"type":1444,"nodeName":1461,"attributes":10174,"children":10176},{"id":10175},"page-68",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10179,"children":10180},{"class":1493},[10181,10185],{"type":1444,"nodeName":1452,"attributes":10182,"children":10183},{"href":1518},[10184],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10187},"\n\n\n   information for the user to recognize the source of the conflict.\n   Ideally, the response entity would include enough information for the\n   user or user agent to fix the problem; however, that might not be\n   possible and is not required.\n\n   Conflicts are most likely to occur in response to a PUT request. For\n   example, if versioning were being used and the entity being PUT\n   included changes to a resource which conflict with those made by an\n   earlier (third-party) request, the server might use the 409 response\n   to indicate that it can't complete the request. In this case, the\n   response entity would likely contain a list of the differences\n   between the two versions in a format defined by the response\n   Content-Type.\n\n",{"type":1444,"nodeName":1461,"attributes":10189,"children":10190},{"class":5964},[10191,10195],{"type":1444,"nodeName":1452,"attributes":10192,"children":10193},{"class":5220,"id":711,"href":3056},[10194],{"type":1449,"textContent":3059},{"type":1449,"textContent":10196}," 410 Gone",{"type":1449,"textContent":10198},"\n\n   The requested resource is no longer available at the server and no\n   forwarding address is known. This condition is expected to be\n   considered permanent. Clients with link editing capabilities SHOULD\n   delete references to the Request-URI after user approval. If the\n   server does not know, or has no facility to determine, whether or not\n   the condition is permanent, the status code 404 (Not Found) SHOULD be\n   used instead. This response is cacheable unless indicated otherwise.\n\n   The 410 response is primarily intended to assist the task of web\n   maintenance by notifying the recipient that the resource is\n   intentionally unavailable and that the server owners desire that\n   remote links to that resource be removed. Such an event is common for\n   limited-time, promotional services and for resources belonging to\n   individuals no longer working at the server's site. It is not\n   necessary to mark all permanently unavailable resources as \"gone\" or\n   to keep the mark for any length of time -- that is left to the\n   discretion of the server owner.\n\n",{"type":1444,"nodeName":1461,"attributes":10200,"children":10201},{"class":5964},[10202,10206],{"type":1444,"nodeName":1452,"attributes":10203,"children":10204},{"class":5220,"id":716,"href":3071},[10205],{"type":1449,"textContent":3074},{"type":1449,"textContent":10207}," 411 Length Required",{"type":1449,"textContent":10209},"\n\n   The server refuses to accept the request without a defined Content-\n   Length. The client MAY repeat the request if it adds a valid\n   Content-Length header field containing the length of the message-body\n   in the request message.\n\n",{"type":1444,"nodeName":1461,"attributes":10211,"children":10212},{"class":5964},[10213,10217],{"type":1444,"nodeName":1452,"attributes":10214,"children":10215},{"class":5220,"id":721,"href":3084},[10216],{"type":1449,"textContent":3087},{"type":1449,"textContent":10218}," 412 Precondition Failed",{"type":1449,"textContent":10220},"\n\n   The precondition given in one or more of the request-header fields\n   evaluated to false when it was tested on the server. This response\n   code allows the client to place preconditions on the current resource\n   metainformation (header field data) and thus prevent the requested\n   method from being applied to a resource other than the one intended.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10222,"children":10223},{"class":1493},[10224],{"type":1449,"textContent":10225},"Fielding, et al.            Standards Track                    [Page 68]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10228,"children":10229},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10231,"children":10232},{"class":1506},[10233,10237,10238,10246,10247,10256,10258,10267,10269,10278,10280,10289,10291,10295,10297,10301,10302,10306,10308],{"type":1444,"nodeName":1461,"attributes":10234,"children":10236},{"id":10235},"page-69",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10239,"children":10240},{"class":1493},[10241,10245],{"type":1444,"nodeName":1452,"attributes":10242,"children":10243},{"href":1518},[10244],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":10248,"children":10249},{"class":5964},[10250,10254],{"type":1444,"nodeName":1452,"attributes":10251,"children":10252},{"class":5220,"id":726,"href":3097},[10253],{"type":1449,"textContent":3100},{"type":1449,"textContent":10255}," 413 Request Entity Too Large",{"type":1449,"textContent":10257},"\n\n   The server is refusing to process a request because the request\n   entity is larger than the server is willing or able to process. The\n   server MAY close the connection to prevent the client from continuing\n   the request.\n\n   If the condition is temporary, the server SHOULD include a Retry-\n   After header field to indicate that it is temporary and after what\n   time the client MAY try again.\n\n",{"type":1444,"nodeName":1461,"attributes":10259,"children":10260},{"class":5964},[10261,10265],{"type":1444,"nodeName":1452,"attributes":10262,"children":10263},{"class":5220,"id":731,"href":3112},[10264],{"type":1449,"textContent":3115},{"type":1449,"textContent":10266}," 414 Request-URI Too Long",{"type":1449,"textContent":10268},"\n\n   The server is refusing to service the request because the Request-URI\n   is longer than the server is willing to interpret. This rare\n   condition is only likely to occur when a client has improperly\n   converted a POST request to a GET request with long query\n   information, when the client has descended into a URI \"black hole\" of\n   redirection (e.g., a redirected URI prefix that points to a suffix of\n   itself), or when the server is under attack by a client attempting to\n   exploit security holes present in some servers using fixed-length\n   buffers for reading or manipulating the Request-URI.\n\n",{"type":1444,"nodeName":1461,"attributes":10270,"children":10271},{"class":5964},[10272,10276],{"type":1444,"nodeName":1452,"attributes":10273,"children":10274},{"class":5220,"id":736,"href":3125},[10275],{"type":1449,"textContent":3128},{"type":1449,"textContent":10277}," 415 Unsupported Media Type",{"type":1449,"textContent":10279},"\n\n   The server is refusing to service the request because the entity of\n   the request is in a format not supported by the requested resource\n   for the requested method.\n\n",{"type":1444,"nodeName":1461,"attributes":10281,"children":10282},{"class":5964},[10283,10287],{"type":1444,"nodeName":1452,"attributes":10284,"children":10285},{"class":5220,"id":741,"href":3138},[10286],{"type":1449,"textContent":3141},{"type":1449,"textContent":10288}," 416 Requested Range Not Satisfiable",{"type":1449,"textContent":10290},"\n\n   A server SHOULD return a response with this status code if a request\n   included a Range request-header field (",{"type":1444,"nodeName":1452,"attributes":10292,"children":10293},{"href":4458},[10294],{"type":1449,"textContent":7031},{"type":1449,"textContent":10296},"), and none of\n   the range-specifier values in this field overlap the current extent\n   of the selected resource, and the request did not include an If-Range\n   request-header field. (For byte-ranges, this means that the first-\n   byte-pos of all of the byte-range-spec values were greater than the\n   current length of the selected resource.)\n\n   When this status code is returned for a byte-range request, the\n   response SHOULD include a Content-Range entity-header field\n   specifying the current length of the selected resource (see ",{"type":1444,"nodeName":1452,"attributes":10298,"children":10299},{"href":4144},[10300],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":10303,"children":10304},{"href":4144},[10305],{"type":1449,"textContent":4147},{"type":1449,"textContent":10307},"). This response MUST NOT use the multipart\u002Fbyteranges content-\n   type.\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10309,"children":10310},{"class":1493},[10311],{"type":1449,"textContent":10312},"Fielding, et al.            Standards Track                    [Page 69]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10315,"children":10316},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10318,"children":10319},{"class":1506},[10320,10324,10325,10333,10334,10343,10345,10349,10350,10354,10356,10365,10367,10376,10378,10387,10389,10398,10400,10409,10411],{"type":1444,"nodeName":1461,"attributes":10321,"children":10323},{"id":10322},"page-70",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10326,"children":10327},{"class":1493},[10328,10332],{"type":1444,"nodeName":1452,"attributes":10329,"children":10330},{"href":1518},[10331],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":10335,"children":10336},{"class":5964},[10337,10341],{"type":1444,"nodeName":1452,"attributes":10338,"children":10339},{"class":5220,"id":746,"href":3151},[10340],{"type":1449,"textContent":3154},{"type":1449,"textContent":10342}," 417 Expectation Failed",{"type":1449,"textContent":10344},"\n\n   The expectation given in an Expect request-header field (see ",{"type":1444,"nodeName":1452,"attributes":10346,"children":10347},{"href":4217},[10348],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":10351,"children":10352},{"href":4217},[10353],{"type":1449,"textContent":4220},{"type":1449,"textContent":10355},") could not be met by this server, or, if the server is a proxy,\n   the server has unambiguous evidence that the request could not be met\n   by the next-hop server.\n\n",{"type":1444,"nodeName":1461,"attributes":10357,"children":10358},{"class":5228},[10359,10363],{"type":1444,"nodeName":1452,"attributes":10360,"children":10361},{"class":5220,"id":751,"href":3166},[10362],{"type":1449,"textContent":3169},{"type":1449,"textContent":10364}," Server Error 5xx",{"type":1449,"textContent":10366},"\n\n   Response status codes beginning with the digit \"5\" indicate cases in\n   which the server is aware that it has erred or is incapable of\n   performing the request. Except when responding to a HEAD request, the\n   server SHOULD include an entity containing an explanation of the\n   error situation, and whether it is a temporary or permanent\n   condition. User agents SHOULD display any included entity to the\n   user. These response codes are applicable to any request method.\n\n",{"type":1444,"nodeName":1461,"attributes":10368,"children":10369},{"class":5964},[10370,10374],{"type":1444,"nodeName":1452,"attributes":10371,"children":10372},{"class":5220,"id":757,"href":3179},[10373],{"type":1449,"textContent":3182},{"type":1449,"textContent":10375}," 500 Internal Server Error",{"type":1449,"textContent":10377},"\n\n   The server encountered an unexpected condition which prevented it\n   from fulfilling the request.\n\n",{"type":1444,"nodeName":1461,"attributes":10379,"children":10380},{"class":5964},[10381,10385],{"type":1444,"nodeName":1452,"attributes":10382,"children":10383},{"class":5220,"id":762,"href":3192},[10384],{"type":1449,"textContent":3195},{"type":1449,"textContent":10386}," 501 Not Implemented",{"type":1449,"textContent":10388},"\n\n   The server does not support the functionality required to fulfill the\n   request. This is the appropriate response when the server does not\n   recognize the request method and is not capable of supporting it for\n   any resource.\n\n",{"type":1444,"nodeName":1461,"attributes":10390,"children":10391},{"class":5964},[10392,10396],{"type":1444,"nodeName":1452,"attributes":10393,"children":10394},{"class":5220,"id":767,"href":3205},[10395],{"type":1449,"textContent":3208},{"type":1449,"textContent":10397}," 502 Bad Gateway",{"type":1449,"textContent":10399},"\n\n   The server, while acting as a gateway or proxy, received an invalid\n   response from the upstream server it accessed in attempting to\n   fulfill the request.\n\n",{"type":1444,"nodeName":1461,"attributes":10401,"children":10402},{"class":5964},[10403,10407],{"type":1444,"nodeName":1452,"attributes":10404,"children":10405},{"class":5220,"id":772,"href":3218},[10406],{"type":1449,"textContent":3221},{"type":1449,"textContent":10408}," 503 Service Unavailable",{"type":1449,"textContent":10410},"\n\n   The server is currently unable to handle the request due to a\n   temporary overloading or maintenance of the server. The implication\n   is that this is a temporary condition which will be alleviated after\n   some delay. If known, the length of the delay MAY be indicated in a\n   Retry-After header. If no Retry-After is given, the client SHOULD\n   handle the response as it would for a 500 response.\n\n      Note: The existence of the 503 status code does not imply that a\n      server must use it when becoming overloaded. Some servers may wish\n      to simply refuse the connection.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10412,"children":10413},{"class":1493},[10414],{"type":1449,"textContent":10415},"Fielding, et al.            Standards Track                    [Page 70]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10418,"children":10419},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10421,"children":10422},{"class":1506},[10423,10427,10428,10436,10437,10446,10448,10457,10459,10463,10464,10468,10470,10479,10481,10485,10487,10496,10498],{"type":1444,"nodeName":1461,"attributes":10424,"children":10426},{"id":10425},"page-71",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10429,"children":10430},{"class":1493},[10431,10435],{"type":1444,"nodeName":1452,"attributes":10432,"children":10433},{"href":1518},[10434],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":10438,"children":10439},{"class":5964},[10440,10444],{"type":1444,"nodeName":1452,"attributes":10441,"children":10442},{"class":5220,"id":777,"href":3231},[10443],{"type":1449,"textContent":3234},{"type":1449,"textContent":10445}," 504 Gateway Timeout",{"type":1449,"textContent":10447},"\n\n   The server, while acting as a gateway or proxy, did not receive a\n   timely response from the upstream server specified by the URI (e.g.\n   HTTP, FTP, LDAP) or some other auxiliary server (e.g. DNS) it needed\n   to access in attempting to complete the request.\n\n      Note: Note to implementors: some deployed proxies are known to\n      return 400 or 500 when DNS lookups time out.\n\n",{"type":1444,"nodeName":1461,"attributes":10449,"children":10450},{"class":5964},[10451,10455],{"type":1444,"nodeName":1452,"attributes":10452,"children":10453},{"class":5220,"id":782,"href":3246},[10454],{"type":1449,"textContent":3249},{"type":1449,"textContent":10456}," 505 HTTP Version Not Supported",{"type":1449,"textContent":10458},"\n\n   The server does not support, or refuses to support, the HTTP protocol\n   version that was used in the request message. The server is\n   indicating that it is unable or unwilling to complete the request\n   using the same major version as the client, as described in ",{"type":1444,"nodeName":1452,"attributes":10460,"children":10461},{"href":1658},[10462],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":10465,"children":10466},{"href":1658},[10467],{"type":1449,"textContent":1661},{"type":1449,"textContent":10469},", other than with this error message. The response SHOULD contain\n   an entity describing why that version is not supported and what other\n   protocols are supported by that server.\n\n",{"type":1444,"nodeName":1461,"attributes":10471,"children":10472},{"class":5216},[10473,10477],{"type":1444,"nodeName":1452,"attributes":10474,"children":10475},{"class":5220,"id":787,"href":3259},[10476],{"type":1449,"textContent":3262},{"type":1449,"textContent":10478}," Access Authentication",{"type":1449,"textContent":10480},"\n\n   HTTP provides several OPTIONAL challenge-response authentication\n   mechanisms which can be used by a server to challenge a client\n   request and by a client to provide authentication information. The\n   general framework for access authentication, and the specification of\n   \"basic\" and \"digest\" authentication, are specified in \"HTTP\n   Authentication: Basic and Digest Access Authentication\" [",{"type":1444,"nodeName":1452,"attributes":10482,"children":10483},{"href":10024},[10484],{"type":1449,"textContent":2248},{"type":1449,"textContent":10486},"]. This\n   specification adopts the definitions of \"challenge\" and \"credentials\"\n   from that specification.\n\n",{"type":1444,"nodeName":1461,"attributes":10488,"children":10489},{"class":5216},[10490,10494],{"type":1444,"nodeName":1452,"attributes":10491,"children":10492},{"class":5220,"id":792,"href":3272},[10493],{"type":1449,"textContent":1596},{"type":1449,"textContent":10495}," Content Negotiation",{"type":1449,"textContent":10497},"\n\n   Most HTTP responses include an entity which contains information for\n   interpretation by a human user. Naturally, it is desirable to supply\n   the user with the \"best available\" entity corresponding to the\n   request. Unfortunately for servers and caches, not all users have the\n   same preferences for what is \"best,\" and not all user agents are\n   equally capable of rendering all entity types. For that reason, HTTP\n   has provisions for several mechanisms for \"content negotiation\" --\n   the process of selecting the best representation for a given response\n   when there are multiple representations available.\n\n      Note: This is not called \"format negotiation\" because the\n      alternate representations may be of the same media type, but use\n      different capabilities of that type, be in different languages,\n      etc.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10499,"children":10500},{"class":1493},[10501],{"type":1449,"textContent":10502},"Fielding, et al.            Standards Track                    [Page 71]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10505,"children":10506},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10508,"children":10509},{"class":1506},[10510,10514,10515,10523,10525,10534,10536],{"type":1444,"nodeName":1461,"attributes":10511,"children":10513},{"id":10512},"page-72",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10516,"children":10517},{"class":1493},[10518,10522],{"type":1444,"nodeName":1452,"attributes":10519,"children":10520},{"href":1518},[10521],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10524},"\n\n\n   Any response containing an entity-body MAY be subject to negotiation,\n   including error responses.\n\n   There are two kinds of content negotiation which are possible in\n   HTTP: server-driven and agent-driven negotiation. These two kinds of\n   negotiation are orthogonal and thus may be used separately or in\n   combination. One method of combination, referred to as transparent\n   negotiation, occurs when a cache uses the agent-driven negotiation\n   information provided by the origin server in order to provide\n   server-driven negotiation for subsequent requests.\n\n",{"type":1444,"nodeName":1461,"attributes":10526,"children":10527},{"class":5228},[10528,10532],{"type":1444,"nodeName":1452,"attributes":10529,"children":10530},{"class":5220,"id":798,"href":3284},[10531],{"type":1449,"textContent":3287},{"type":1449,"textContent":10533}," Server-driven Negotiation",{"type":1449,"textContent":10535},"\n\n   If the selection of the best representation for a response is made by\n   an algorithm located at the server, it is called server-driven\n   negotiation. Selection is based on the available representations of\n   the response (the dimensions over which it can vary; e.g. language,\n   content-coding, etc.) and the contents of particular header fields in\n   the request message or on other information pertaining to the request\n   (such as the network address of the client).\n\n   Server-driven negotiation is advantageous when the algorithm for\n   selecting from among the available representations is difficult to\n   describe to the user agent, or when the server desires to send its\n   \"best guess\" to the client along with the first response (hoping to\n   avoid the round-trip delay of a subsequent request if the \"best\n   guess\" is good enough for the user). In order to improve the server's\n   guess, the user agent MAY include request header fields (Accept,\n   Accept-Language, Accept-Encoding, etc.) which describe its\n   preferences for such a response.\n\n   Server-driven negotiation has disadvantages:\n\n      1. It is impossible for the server to accurately determine what\n         might be \"best\" for any given user, since that would require\n         complete knowledge of both the capabilities of the user agent\n         and the intended use for the response (e.g., does the user want\n         to view it on screen or print it on paper?).\n\n      2. Having the user agent describe its capabilities in every\n         request can be both very inefficient (given that only a small\n         percentage of responses have multiple representations) and a\n         potential violation of the user's privacy.\n\n      3. It complicates the implementation of an origin server and the\n         algorithms for generating responses to a request.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10537,"children":10538},{"class":1493},[10539],{"type":1449,"textContent":10540},"Fielding, et al.            Standards Track                    [Page 72]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10543,"children":10544},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10546,"children":10547},{"class":1506},[10548,10552,10553,10561,10563,10567,10569,10574,10576,10580,10582,10587,10589,10594,10596,10601,10603,10608,10610,10619,10621],{"type":1444,"nodeName":1461,"attributes":10549,"children":10551},{"id":10550},"page-73",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10554,"children":10555},{"class":1493},[10556,10560],{"type":1444,"nodeName":1452,"attributes":10557,"children":10558},{"href":1518},[10559],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10562},"\n\n\n      4. It may limit a public cache's ability to use the same response\n         for multiple user's requests.\n\n   HTTP\u002F1.1 includes the following request-header fields for enabling\n   server-driven negotiation through description of user agent\n   capabilities and user preferences: Accept (",{"type":1444,"nodeName":1452,"attributes":10564,"children":10565},{"href":3837},[10566],{"type":1449,"textContent":6692},{"type":1449,"textContent":10568},"), Accept-\n   Charset (",{"type":1444,"nodeName":1452,"attributes":10570,"children":10571},{"href":3850},[10572],{"type":1449,"textContent":10573},"section 14.2",{"type":1449,"textContent":10575},"), Accept-Encoding (",{"type":1444,"nodeName":1452,"attributes":10577,"children":10578},{"href":3865},[10579],{"type":1449,"textContent":6413},{"type":1449,"textContent":10581},"), Accept-\n   Language (",{"type":1444,"nodeName":1452,"attributes":10583,"children":10584},{"href":3878},[10585],{"type":1449,"textContent":10586},"section 14.4",{"type":1449,"textContent":10588},"), and User-Agent (",{"type":1444,"nodeName":1452,"attributes":10590,"children":10591},{"href":4602},[10592],{"type":1449,"textContent":10593},"section 14.43",{"type":1449,"textContent":10595},"). However, an\n   origin server is not limited to these dimensions and MAY vary the\n   response based on any aspect of the request, including information\n   outside the request-header fields or within extension header fields\n   not defined by this specification.\n\n   The Vary  header field can be used to express the parameters the\n   server uses to select a representation that is subject to server-\n   driven negotiation. See ",{"type":1444,"nodeName":1452,"attributes":10597,"children":10598},{"href":3711},[10599],{"type":1449,"textContent":10600},"section 13.6",{"type":1449,"textContent":10602}," for use of the Vary header field\n   by caches and ",{"type":1444,"nodeName":1452,"attributes":10604,"children":10605},{"href":4617},[10606],{"type":1449,"textContent":10607},"section 14.44",{"type":1449,"textContent":10609}," for use of the Vary header field by\n   servers.\n\n",{"type":1444,"nodeName":1461,"attributes":10611,"children":10612},{"class":5228},[10613,10617],{"type":1444,"nodeName":1452,"attributes":10614,"children":10615},{"class":5220,"id":803,"href":3299},[10616],{"type":1449,"textContent":3302},{"type":1449,"textContent":10618}," Agent-driven Negotiation",{"type":1449,"textContent":10620},"\n\n   With agent-driven negotiation, selection of the best representation\n   for a response is performed by the user agent after receiving an\n   initial response from the origin server. Selection is based on a list\n   of the available representations of the response included within the\n   header fields or entity-body of the initial response, with each\n   representation identified by its own URI. Selection from among the\n   representations may be performed automatically (if the user agent is\n   capable of doing so) or manually by the user selecting from a\n   generated (possibly hypertext) menu.\n\n   Agent-driven negotiation is advantageous when the response would vary\n   over commonly-used dimensions (such as type, language, or encoding),\n   when the origin server is unable to determine a user agent's\n   capabilities from examining the request, and generally when public\n   caches are used to distribute server load and reduce network usage.\n\n   Agent-driven negotiation suffers from the disadvantage of needing a\n   second request to obtain the best alternate representation. This\n   second request is only efficient when caching is used. In addition,\n   this specification does not define any mechanism for supporting\n   automatic selection, though it also does not prevent any such\n   mechanism from being developed as an extension and used within\n   HTTP\u002F1.1.\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10622,"children":10623},{"class":1493},[10624],{"type":1449,"textContent":10625},"Fielding, et al.            Standards Track                    [Page 73]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10628,"children":10629},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10631,"children":10632},{"class":1506},[10633,10637,10638,10646,10648,10657,10659,10668,10670,10675,10677,10682,10684],{"type":1444,"nodeName":1461,"attributes":10634,"children":10636},{"id":10635},"page-74",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10639,"children":10640},{"class":1493},[10641,10645],{"type":1444,"nodeName":1452,"attributes":10642,"children":10643},{"href":1518},[10644],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10647},"\n\n\n   HTTP\u002F1.1 defines the 300 (Multiple Choices) and 406 (Not Acceptable)\n   status codes for enabling agent-driven negotiation when the server is\n   unwilling or unable to provide a varying response using server-driven\n   negotiation.\n\n",{"type":1444,"nodeName":1461,"attributes":10649,"children":10650},{"class":5228},[10651,10655],{"type":1444,"nodeName":1452,"attributes":10652,"children":10653},{"class":5220,"id":808,"href":3314},[10654],{"type":1449,"textContent":3317},{"type":1449,"textContent":10656}," Transparent Negotiation",{"type":1449,"textContent":10658},"\n\n   Transparent negotiation is a combination of both server-driven and\n   agent-driven negotiation. When a cache is supplied with a form of the\n   list of available representations of the response (as in agent-driven\n   negotiation) and the dimensions of variance are completely understood\n   by the cache, then the cache becomes capable of performing server-\n   driven negotiation on behalf of the origin server for subsequent\n   requests on that resource.\n\n   Transparent negotiation has the advantage of distributing the\n   negotiation work that would otherwise be required of the origin\n   server and also removing the second request delay of agent-driven\n   negotiation when the cache is able to correctly guess the right\n   response.\n\n   This specification does not define any mechanism for transparent\n   negotiation, though it also does not prevent any such mechanism from\n   being developed as an extension that could be used within HTTP\u002F1.1.\n\n",{"type":1444,"nodeName":1461,"attributes":10660,"children":10661},{"class":5216},[10662,10666],{"type":1444,"nodeName":1452,"attributes":10663,"children":10664},{"class":5220,"id":813,"href":3329},[10665],{"type":1449,"textContent":3332},{"type":1449,"textContent":10667}," Caching in HTTP",{"type":1449,"textContent":10669},"\n\n   HTTP is typically used for distributed information systems, where\n   performance can be improved by the use of response caches. The\n   HTTP\u002F1.1 protocol includes a number of elements intended to make\n   caching work as well as possible. Because these elements are\n   inextricable from other aspects of the protocol, and because they\n   interact with each other, it is useful to describe the basic caching\n   design of HTTP separately from the detailed descriptions of methods,\n   headers, response codes, etc.\n\n   Caching would be useless if it did not significantly improve\n   performance. The goal of caching in HTTP\u002F1.1 is to eliminate the need\n   to send requests in many cases, and to eliminate the need to send\n   full responses in many other cases. The former reduces the number of\n   network round-trips required for many operations; we use an\n   \"expiration\" mechanism for this purpose (see ",{"type":1444,"nodeName":1452,"attributes":10671,"children":10672},{"href":3430},[10673],{"type":1449,"textContent":10674},"section 13.2",{"type":1449,"textContent":10676},"). The\n   latter reduces network bandwidth requirements; we use a \"validation\"\n   mechanism for this purpose (see ",{"type":1444,"nodeName":1452,"attributes":10678,"children":10679},{"href":3527},[10680],{"type":1449,"textContent":10681},"section 13.3",{"type":1449,"textContent":10683},").\n\n   Requirements for performance, availability, and disconnected\n   operation require us to be able to relax the goal of semantic\n   transparency. The HTTP\u002F1.1 protocol allows origin servers, caches,\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10685,"children":10686},{"class":1493},[10687],{"type":1449,"textContent":10688},"Fielding, et al.            Standards Track                    [Page 74]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10691,"children":10692},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10694,"children":10695},{"class":1506},[10696,10700,10701,10709,10711,10721,10723,10727,10729,10733,10735,10739,10741,10745,10747],{"type":1444,"nodeName":1461,"attributes":10697,"children":10699},{"id":10698},"page-75",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10702,"children":10703},{"class":1493},[10704,10708],{"type":1444,"nodeName":1452,"attributes":10705,"children":10706},{"href":1518},[10707],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10710},"\n\n\n   and clients to explicitly reduce transparency when necessary.\n   However, because non-transparent operation may confuse non-expert\n   users, and might be incompatible with certain server applications\n   (such as those for ordering merchandise), the protocol requires that\n   transparency be relaxed\n\n      - only by an explicit protocol-level request when relaxed by\n        client or origin server\n\n      - only with an explicit warning to the end user when relaxed by\n        cache or client\n\n   Therefore, the HTTP\u002F1.1 protocol provides these important elements:\n\n      1. Protocol features that provide full semantic transparency when\n         this is required by all parties.\n\n      2. Protocol features that allow an origin server or user agent to\n         explicitly request and control non-transparent operation.\n\n      3. Protocol features that allow a cache to attach warnings to\n         responses that do not preserve the requested approximation of\n         semantic transparency.\n\n   A basic principle is that it must be possible for the clients to\n   detect any potential relaxation of semantic transparency.\n\n      Note: The server, cache, or client implementor might be faced with\n      design decisions not explicitly discussed in this specification.\n      If a decision might affect semantic transparency, the implementor\n      ought to err on the side of maintaining transparency unless a\n      careful and complete analysis shows significant benefits in\n      breaking transparency.\n\n",{"type":1444,"nodeName":1461,"attributes":10712,"children":10713},{"class":5964},[10714,10719],{"type":1444,"nodeName":1452,"attributes":10715,"children":10717},{"class":5220,"id":10716,"href":3342},"section-13.1.1",[10718],{"type":1449,"textContent":3345},{"type":1449,"textContent":10720}," Cache Correctness",{"type":1449,"textContent":10722},"\n\n   A correct cache MUST respond to a request with the most up-to-date\n   response held by the cache that is appropriate to the request (see\n   sections ",{"type":1444,"nodeName":1452,"attributes":10724,"children":10725},{"href":3499},[10726],{"type":1449,"textContent":3502},{"type":1449,"textContent":10728},", ",{"type":1444,"nodeName":1452,"attributes":10730,"children":10731},{"href":3514},[10732],{"type":1449,"textContent":3517},{"type":1449,"textContent":10734},", and ",{"type":1444,"nodeName":1452,"attributes":10736,"children":10737},{"href":3795},[10738],{"type":1449,"textContent":3798},{"type":1449,"textContent":10740},") which meets one of the following\n   conditions:\n\n      1. It has been checked for equivalence with what the origin server\n         would have returned by revalidating the response with the\n         origin server (",{"type":1444,"nodeName":1452,"attributes":10742,"children":10743},{"href":3527},[10744],{"type":1449,"textContent":10681},{"type":1449,"textContent":10746},");\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10748,"children":10749},{"class":1493},[10750],{"type":1449,"textContent":10751},"Fielding, et al.            Standards Track                    [Page 75]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10754,"children":10755},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10757,"children":10758},{"class":1506},[10759,10763,10764,10772,10774,10778,10780,10785,10787,10792,10794,10798,10800,10810,10812,10817,10819,10824,10826],{"type":1444,"nodeName":1461,"attributes":10760,"children":10762},{"id":10761},"page-76",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10765,"children":10766},{"class":1493},[10767,10771],{"type":1444,"nodeName":1452,"attributes":10768,"children":10769},{"href":1518},[10770],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10773},"\n\n\n      2. It is \"fresh enough\" (see ",{"type":1444,"nodeName":1452,"attributes":10775,"children":10776},{"href":3430},[10777],{"type":1449,"textContent":10674},{"type":1449,"textContent":10779},"). In the default case,\n         this means it meets the least restrictive freshness requirement\n         of the client, origin server, and cache (see ",{"type":1444,"nodeName":1452,"attributes":10781,"children":10782},{"href":3951},[10783],{"type":1449,"textContent":10784},"section 14.9",{"type":1449,"textContent":10786},"); if\n         the origin server so specifies, it is the freshness requirement\n         of the origin server alone.\n\n         If a stored response is not \"fresh enough\" by the most\n         restrictive freshness requirement of both the client and the\n         origin server, in carefully considered circumstances the cache\n         MAY still return the response with the appropriate Warning\n         header (see ",{"type":1444,"nodeName":1452,"attributes":10788,"children":10789},{"href":3402},[10790],{"type":1449,"textContent":10791},"section 13.1.5",{"type":1449,"textContent":10793}," and 14.46), unless such a response\n         is prohibited (e.g., by a \"no-store\" cache-directive, or by a\n         \"no-cache\" cache-request-directive; see ",{"type":1444,"nodeName":1452,"attributes":10795,"children":10796},{"href":3951},[10797],{"type":1449,"textContent":10784},{"type":1449,"textContent":10799},").\n\n      3. It is an appropriate 304 (Not Modified), 305 (Proxy Redirect),\n         or error (4xx or 5xx) response message.\n\n   If the cache can not communicate with the origin server, then a\n   correct cache SHOULD respond as above if the response can be\n   correctly served from the cache; if not it MUST return an error or\n   warning indicating that there was a communication failure.\n\n   If a cache receives a response (either an entire response, or a 304\n   (Not Modified) response) that it would normally forward to the\n   requesting client, and the received response is no longer fresh, the\n   cache SHOULD forward it to the requesting client without adding a new\n   Warning (but without removing any existing Warning headers). A cache\n   SHOULD NOT attempt to revalidate a response simply because that\n   response became stale in transit; this might lead to an infinite\n   loop. A user agent that receives a stale response without a Warning\n   MAY display a warning indication to the user.\n\n",{"type":1444,"nodeName":1461,"attributes":10801,"children":10802},{"class":5964},[10803,10808],{"type":1444,"nodeName":1452,"attributes":10804,"children":10806},{"class":5220,"id":10805,"href":3357},"section-13.1.2",[10807],{"type":1449,"textContent":3360},{"type":1449,"textContent":10809}," Warnings",{"type":1449,"textContent":10811},"\n\n   Whenever a cache returns a response that is neither first-hand nor\n   \"fresh enough\" (in the sense of condition 2 in ",{"type":1444,"nodeName":1452,"attributes":10813,"children":10814},{"href":3342},[10815],{"type":1449,"textContent":10816},"section 13.1.1",{"type":1449,"textContent":10818},"), it\n   MUST attach a warning to that effect, using a Warning general-header.\n   The Warning header and the currently defined warnings are described\n   in ",{"type":1444,"nodeName":1452,"attributes":10820,"children":10821},{"href":4645},[10822],{"type":1449,"textContent":10823},"section 14.46",{"type":1449,"textContent":10825},". The warning allows clients to take appropriate\n   action.\n\n   Warnings MAY be used for other purposes, both cache-related and\n   otherwise. The use of a warning, rather than an error status code,\n   distinguish these responses from true failures.\n\n   Warnings are assigned three digit warn-codes. The first digit\n   indicates whether the Warning MUST or MUST NOT be deleted from a\n   stored cache entry after a successful revalidation:\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10827,"children":10828},{"class":1493},[10829],{"type":1449,"textContent":10830},"Fielding, et al.            Standards Track                    [Page 76]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10833,"children":10834},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10836,"children":10837},{"class":1506},[10838,10842,10843,10851,10853,10857,10859,10869,10871],{"type":1444,"nodeName":1461,"attributes":10839,"children":10841},{"id":10840},"page-77",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10844,"children":10845},{"class":1493},[10846,10850],{"type":1444,"nodeName":1452,"attributes":10847,"children":10848},{"href":1518},[10849],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10852},"\n\n\n   1xx  Warnings that describe the freshness or revalidation status of\n     the response, and so MUST be deleted after a successful\n     revalidation. 1XX warn-codes MAY be generated by a cache only when\n     validating a cached entry. It MUST NOT be generated by clients.\n\n   2xx  Warnings that describe some aspect of the entity body or entity\n     headers that is not rectified by a revalidation (for example, a\n     lossy compression of the entity bodies) and which MUST NOT be\n     deleted after a successful revalidation.\n\n   See ",{"type":1444,"nodeName":1452,"attributes":10854,"children":10855},{"href":4645},[10856],{"type":1449,"textContent":10823},{"type":1449,"textContent":10858}," for the definitions of the codes themselves.\n\n   HTTP\u002F1.0 caches will cache all Warnings in responses, without\n   deleting the ones in the first category. Warnings in responses that\n   are passed to HTTP\u002F1.0 caches carry an extra warning-date field,\n   which prevents a future HTTP\u002F1.1 recipient from believing an\n   erroneously cached Warning.\n\n   Warnings also carry a warning text. The text MAY be in any\n   appropriate natural language (perhaps based on the client's Accept\n   headers), and include an OPTIONAL indication of what character set is\n   used.\n\n   Multiple warnings MAY be attached to a response (either by the origin\n   server or by a cache), including multiple warnings with the same code\n   number. For example, a server might provide the same warning with\n   texts in both English and Basque.\n\n   When multiple warnings are attached to a response, it might not be\n   practical or reasonable to display all of them to the user. This\n   version of HTTP does not specify strict priority rules for deciding\n   which warnings to display and in what order, but does suggest some\n   heuristics.\n\n",{"type":1444,"nodeName":1461,"attributes":10860,"children":10861},{"class":5964},[10862,10867],{"type":1444,"nodeName":1452,"attributes":10863,"children":10865},{"class":5220,"id":10864,"href":3372},"section-13.1.3",[10866],{"type":1449,"textContent":3375},{"type":1449,"textContent":10868}," Cache-control Mechanisms",{"type":1449,"textContent":10870},"\n\n   The basic cache mechanisms in HTTP\u002F1.1 (server-specified expiration\n   times and validators) are implicit directives to caches. In some\n   cases, a server or client might need to provide explicit directives\n   to the HTTP caches. We use the Cache-Control header for this purpose.\n\n   The Cache-Control header allows a client or server to transmit a\n   variety of directives in either requests or responses. These\n   directives typically override the default caching algorithms. As a\n   general rule, if there is any apparent conflict between header\n   values, the most restrictive interpretation is applied (that is, the\n   one that is most likely to preserve semantic transparency). However,\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10872,"children":10873},{"class":1493},[10874],{"type":1449,"textContent":10875},"Fielding, et al.            Standards Track                    [Page 77]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10878,"children":10879},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10881,"children":10882},{"class":1506},[10883,10887,10888,10896,10898,10902,10903,10913,10915,10925,10927],{"type":1444,"nodeName":1461,"attributes":10884,"children":10886},{"id":10885},"page-78",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10889,"children":10890},{"class":1493},[10891,10895],{"type":1444,"nodeName":1452,"attributes":10892,"children":10893},{"href":1518},[10894],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10897},"\n\n\n   in some cases, cache-control directives are explicitly specified as\n   weakening the approximation of semantic transparency (for example,\n   \"max-stale\" or \"public\").\n\n   The cache-control directives are described in detail in ",{"type":1444,"nodeName":1452,"attributes":10899,"children":10900},{"href":3951},[10901],{"type":1449,"textContent":10784},{"type":1449,"textContent":6397},{"type":1444,"nodeName":1461,"attributes":10904,"children":10905},{"class":5964},[10906,10911],{"type":1444,"nodeName":1452,"attributes":10907,"children":10909},{"class":5220,"id":10908,"href":3387},"section-13.1.4",[10910],{"type":1449,"textContent":3390},{"type":1449,"textContent":10912}," Explicit User Agent Warnings",{"type":1449,"textContent":10914},"\n\n   Many user agents make it possible for users to override the basic\n   caching mechanisms. For example, the user agent might allow the user\n   to specify that cached entities (even explicitly stale ones) are\n   never validated. Or the user agent might habitually add \"Cache-\n   Control: max-stale=3600\" to every request. The user agent SHOULD NOT\n   default to either non-transparent behavior, or behavior that results\n   in abnormally ineffective caching, but MAY be explicitly configured\n   to do so by an explicit action of the user.\n\n   If the user has overridden the basic caching mechanisms, the user\n   agent SHOULD explicitly indicate to the user whenever this results in\n   the display of information that might not meet the server's\n   transparency requirements (in particular, if the displayed entity is\n   known to be stale). Since the protocol normally allows the user agent\n   to determine if responses are stale or not, this indication need only\n   be displayed when this actually happens. The indication need not be a\n   dialog box; it could be an icon (for example, a picture of a rotting\n   fish) or some other indicator.\n\n   If the user has overridden the caching mechanisms in a way that would\n   abnormally reduce the effectiveness of caches, the user agent SHOULD\n   continually indicate this state to the user (for example, by a\n   display of a picture of currency in flames) so that the user does not\n   inadvertently consume excess resources or suffer from excessive\n   latency.\n\n",{"type":1444,"nodeName":1461,"attributes":10916,"children":10917},{"class":5964},[10918,10923],{"type":1444,"nodeName":1452,"attributes":10919,"children":10921},{"class":5220,"id":10920,"href":3402},"section-13.1.5",[10922],{"type":1449,"textContent":3405},{"type":1449,"textContent":10924}," Exceptions to the Rules and Warnings",{"type":1449,"textContent":10926},"\n\n   In some cases, the operator of a cache MAY choose to configure it to\n   return stale responses even when not requested by clients. This\n   decision ought not be made lightly, but may be necessary for reasons\n   of availability or performance, especially when the cache is poorly\n   connected to the origin server. Whenever a cache returns a stale\n   response, it MUST mark it as such (using a Warning header) enabling\n   the client software to alert the user that there might be a potential\n   problem.\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10928,"children":10929},{"class":1493},[10930],{"type":1449,"textContent":10931},"Fielding, et al.            Standards Track                    [Page 78]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10934,"children":10935},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10937,"children":10938},{"class":1506},[10939,10943,10944,10952,10954,10964,10966,10975,10976,10985,10987],{"type":1444,"nodeName":1461,"attributes":10940,"children":10942},{"id":10941},"page-79",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":10945,"children":10946},{"class":1493},[10947,10951],{"type":1444,"nodeName":1452,"attributes":10948,"children":10949},{"href":1518},[10950],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":10953},"\n\n\n   It also allows the user agent to take steps to obtain a first-hand or\n   fresh response. For this reason, a cache SHOULD NOT return a stale\n   response if the client explicitly requests a first-hand or fresh one,\n   unless it is impossible to comply for technical or policy reasons.\n\n",{"type":1444,"nodeName":1461,"attributes":10955,"children":10956},{"class":5964},[10957,10962],{"type":1444,"nodeName":1452,"attributes":10958,"children":10960},{"class":5220,"id":10959,"href":3415},"section-13.1.6",[10961],{"type":1449,"textContent":3418},{"type":1449,"textContent":10963}," Client-controlled Behavior",{"type":1449,"textContent":10965},"\n\n   While the origin server (and to a lesser extent, intermediate caches,\n   by their contribution to the age of a response) are the primary\n   source of expiration information, in some cases the client might need\n   to control a cache's decision about whether to return a cached\n   response without validating it. Clients do this using several\n   directives of the Cache-Control header.\n\n   A client's request MAY specify the maximum age it is willing to\n   accept of an unvalidated response; specifying a value of zero forces\n   the cache(s) to revalidate all responses. A client MAY also specify\n   the minimum time remaining before a response expires. Both of these\n   options increase constraints on the behavior of caches, and so cannot\n   further relax the cache's approximation of semantic transparency.\n\n   A client MAY also specify that it will accept stale responses, up to\n   some maximum amount of staleness. This loosens the constraints on the\n   caches, and so might violate the origin server's specified\n   constraints on semantic transparency, but might be necessary to\n   support disconnected operation, or high availability in the face of\n   poor connectivity.\n\n",{"type":1444,"nodeName":1461,"attributes":10967,"children":10968},{"class":5228},[10969,10973],{"type":1444,"nodeName":1452,"attributes":10970,"children":10971},{"class":5220,"id":819,"href":3430},[10972],{"type":1449,"textContent":3433},{"type":1449,"textContent":10974}," Expiration Model",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":10977,"children":10978},{"class":5964},[10979,10983],{"type":1444,"nodeName":1452,"attributes":10980,"children":10981},{"class":5220,"id":825,"href":3443},[10982],{"type":1449,"textContent":3446},{"type":1449,"textContent":10984}," Server-Specified Expiration",{"type":1449,"textContent":10986},"\n\n   HTTP caching works best when caches can entirely avoid making\n   requests to the origin server. The primary mechanism for avoiding\n   requests is for an origin server to provide an explicit expiration\n   time in the future, indicating that a response MAY be used to satisfy\n   subsequent requests. In other words, a cache can return a fresh\n   response without first contacting the server.\n\n   Our expectation is that servers will assign future explicit\n   expiration times to responses in the belief that the entity is not\n   likely to change, in a semantically significant way, before the\n   expiration time is reached. This normally preserves semantic\n   transparency, as long as the server's expiration times are carefully\n   chosen.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":10988,"children":10989},{"class":1493},[10990],{"type":1449,"textContent":10991},"Fielding, et al.            Standards Track                    [Page 79]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":10994,"children":10995},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":10997,"children":10998},{"class":1506},[10999,11003,11004,11012,11014,11019,11021,11025,11027,11032,11034,11043,11045,11054,11056,11061,11063,11068,11070],{"type":1444,"nodeName":1461,"attributes":11000,"children":11002},{"id":11001},"page-80",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11005,"children":11006},{"class":1493},[11007,11011],{"type":1444,"nodeName":1452,"attributes":11008,"children":11009},{"href":1518},[11010],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11013},"\n\n\n   The expiration mechanism applies only to responses taken from a cache\n   and not to first-hand responses forwarded immediately to the\n   requesting client.\n\n   If an origin server wishes to force a semantically transparent cache\n   to validate every request, it MAY assign an explicit expiration time\n   in the past. This means that the response is always stale, and so the\n   cache SHOULD validate it before using it for subsequent requests. See\n   ",{"type":1444,"nodeName":1452,"attributes":11015,"children":11016},{"href":4011},[11017],{"type":1449,"textContent":11018},"section 14.9.4",{"type":1449,"textContent":11020}," for a more restrictive way to force revalidation.\n\n   If an origin server wishes to force any HTTP\u002F1.1 cache, no matter how\n   it is configured, to validate every request, it SHOULD use the \"must-\n   revalidate\" cache-control directive (see ",{"type":1444,"nodeName":1452,"attributes":11022,"children":11023},{"href":3951},[11024],{"type":1449,"textContent":10784},{"type":1449,"textContent":11026},").\n\n   Servers specify explicit expiration times using either the Expires\n   header, or the max-age directive of the Cache-Control header.\n\n   An expiration time cannot be used to force a user agent to refresh\n   its display or reload a resource; its semantics apply only to caching\n   mechanisms, and such mechanisms need only check a resource's\n   expiration status when a new request for that resource is initiated.\n   See ",{"type":1444,"nodeName":1452,"attributes":11028,"children":11029},{"href":3810},[11030],{"type":1449,"textContent":11031},"section 13.13",{"type":1449,"textContent":11033}," for an explanation of the difference between caches\n   and history mechanisms.\n\n",{"type":1444,"nodeName":1461,"attributes":11035,"children":11036},{"class":5964},[11037,11041],{"type":1444,"nodeName":1452,"attributes":11038,"children":11039},{"class":5220,"id":830,"href":3456},[11040],{"type":1449,"textContent":3459},{"type":1449,"textContent":11042}," Heuristic Expiration",{"type":1449,"textContent":11044},"\n\n   Since origin servers do not always provide explicit expiration times,\n   HTTP caches typically assign heuristic expiration times, employing\n   algorithms that use other header values (such as the Last-Modified\n   time) to estimate a plausible expiration time. The HTTP\u002F1.1\n   specification does not provide specific algorithms, but does impose\n   worst-case constraints on their results. Since heuristic expiration\n   times might compromise semantic transparency, they ought to used\n   cautiously, and we encourage origin servers to provide explicit\n   expiration times as much as possible.\n\n",{"type":1444,"nodeName":1461,"attributes":11046,"children":11047},{"class":5964},[11048,11052],{"type":1444,"nodeName":1452,"attributes":11049,"children":11050},{"class":5220,"id":835,"href":3471},[11051],{"type":1449,"textContent":3474},{"type":1449,"textContent":11053}," Age Calculations",{"type":1449,"textContent":11055},"\n\n   In order to know if a cached entry is fresh, a cache needs to know if\n   its age exceeds its freshness lifetime. We discuss how to calculate\n   the latter in ",{"type":1444,"nodeName":1452,"attributes":11057,"children":11058},{"href":3484},[11059],{"type":1449,"textContent":11060},"section 13.2.4",{"type":1449,"textContent":11062},"; this section describes how to calculate\n   the age of a response or cache entry.\n\n   In this discussion, we use the term \"now\" to mean \"the current value\n   of the clock at the host performing the calculation.\" Hosts that use\n   HTTP, but especially hosts running origin servers and caches, SHOULD\n   use NTP [",{"type":1444,"nodeName":1452,"attributes":11064,"children":11066},{"href":11065},"#ref-28",[11067],{"type":1449,"textContent":1897},{"type":1449,"textContent":11069},"] or some similar protocol to synchronize their clocks to\n   a globally accurate time standard.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11071,"children":11072},{"class":1493},[11073],{"type":1449,"textContent":11074},"Fielding, et al.            Standards Track                    [Page 80]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11077,"children":11078},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11080,"children":11081},{"class":1506},[11082,11086,11087,11095,11097,11102,11104],{"type":1444,"nodeName":1461,"attributes":11083,"children":11085},{"id":11084},"page-81",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11088,"children":11089},{"class":1493},[11090,11094],{"type":1444,"nodeName":1452,"attributes":11091,"children":11092},{"href":1518},[11093],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11096},"\n\n\n   HTTP\u002F1.1 requires origin servers to send a Date header, if possible,\n   with every response, giving the time at which the response was\n   generated (see ",{"type":1444,"nodeName":1452,"attributes":11098,"children":11099},{"href":4174},[11100],{"type":1449,"textContent":11101},"section 14.18",{"type":1449,"textContent":11103},"). We use the term \"date_value\" to denote\n   the value of the Date header, in a form appropriate for arithmetic\n   operations.\n\n   HTTP\u002F1.1 uses the Age response-header to convey the estimated age of\n   the response message when obtained from a cache. The Age field value\n   is the cache's estimate of the amount of time since the response was\n   generated or revalidated by the origin server.\n\n   In essence, the Age value is the sum of the time that the response\n   has been resident in each of the caches along the path from the\n   origin server, plus the amount of time it has been in transit along\n   network paths.\n\n   We use the term \"age_value\" to denote the value of the Age header, in\n   a form appropriate for arithmetic operations.\n\n   A response's age can be calculated in two entirely independent ways:\n\n      1. now minus date_value, if the local clock is reasonably well\n         synchronized to the origin server's clock. If the result is\n         negative, the result is replaced by zero.\n\n      2. age_value, if all of the caches along the response path\n         implement HTTP\u002F1.1.\n\n   Given that we have two independent ways to compute the age of a\n   response when it is received, we can combine these as\n\n       corrected_received_age = max(now - date_value, age_value)\n\n   and as long as we have either nearly synchronized clocks or all-\n   HTTP\u002F1.1 paths, one gets a reliable (conservative) result.\n\n   Because of network-imposed delays, some significant interval might\n   pass between the time that a server generates a response and the time\n   it is received at the next outbound cache or client. If uncorrected,\n   this delay could result in improperly low ages.\n\n   Because the request that resulted in the returned Age value must have\n   been initiated prior to that Age value's generation, we can correct\n   for delays imposed by the network by recording the time at which the\n   request was initiated. Then, when an Age value is received, it MUST\n   be interpreted relative to the time the request was initiated, not\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11105,"children":11106},{"class":1493},[11107],{"type":1449,"textContent":11108},"Fielding, et al.            Standards Track                    [Page 81]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11111,"children":11112},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11114,"children":11115},{"class":1506},[11116,11120,11121,11129,11131],{"type":1444,"nodeName":1461,"attributes":11117,"children":11119},{"id":11118},"page-82",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11122,"children":11123},{"class":1493},[11124,11128],{"type":1444,"nodeName":1452,"attributes":11125,"children":11126},{"href":1518},[11127],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11130},"\n\n\n   the time that the response was received. This algorithm results in\n   conservative behavior no matter how much delay is experienced. So, we\n   compute:\n\n      corrected_initial_age = corrected_received_age\n                            + (now - request_time)\n\n   where \"request_time\" is the time (according to the local clock) when\n   the request that elicited this response was sent.\n\n   Summary of age calculation algorithm, when a cache receives a\n   response:\n\n      \u002F*\n       * age_value\n       *      is the value of Age: header received by the cache with\n       *              this response.\n       * date_value\n       *      is the value of the origin server's Date: header\n       * request_time\n       *      is the (local) time when the cache made the request\n       *              that resulted in this cached response\n       * response_time\n       *      is the (local) time when the cache received the\n       *              response\n       * now\n       *      is the current (local) time\n       *\u002F\n\n      apparent_age = max(0, response_time - date_value);\n      corrected_received_age = max(apparent_age, age_value);\n      response_delay = response_time - request_time;\n      corrected_initial_age = corrected_received_age + response_delay;\n      resident_time = now - response_time;\n      current_age   = corrected_initial_age + resident_time;\n\n   The current_age of a cache entry is calculated by adding the amount\n   of time (in seconds) since the cache entry was last validated by the\n   origin server to the corrected_initial_age. When a response is\n   generated from a cache entry, the cache MUST include a single Age\n   header field in the response with a value equal to the cache entry's\n   current_age.\n\n   The presence of an Age header field in a response implies that a\n   response is not first-hand. However, the converse is not true, since\n   the lack of an Age header field in a response does not imply that the\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11132,"children":11133},{"class":1493},[11134],{"type":1449,"textContent":11135},"Fielding, et al.            Standards Track                    [Page 82]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11138,"children":11139},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11141,"children":11142},{"class":1506},[11143,11147,11148,11156,11158,11167,11169,11174,11176,11181,11183,11187,11189],{"type":1444,"nodeName":1461,"attributes":11144,"children":11146},{"id":11145},"page-83",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11149,"children":11150},{"class":1493},[11151,11155],{"type":1444,"nodeName":1452,"attributes":11152,"children":11153},{"href":1518},[11154],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11157},"\n\n\n   response is first-hand unless all caches along the request path are\n   compliant with HTTP\u002F1.1 (i.e., older HTTP caches did not implement\n   the Age header field).\n\n",{"type":1444,"nodeName":1461,"attributes":11159,"children":11160},{"class":5964},[11161,11165],{"type":1444,"nodeName":1452,"attributes":11162,"children":11163},{"class":5220,"id":840,"href":3484},[11164],{"type":1449,"textContent":3487},{"type":1449,"textContent":11166}," Expiration Calculations",{"type":1449,"textContent":11168},"\n\n   In order to decide whether a response is fresh or stale, we need to\n   compare its freshness lifetime to its age. The age is calculated as\n   described in ",{"type":1444,"nodeName":1452,"attributes":11170,"children":11171},{"href":3471},[11172],{"type":1449,"textContent":11173},"section 13.2.3",{"type":1449,"textContent":11175},"; this section describes how to calculate\n   the freshness lifetime, and to determine if a response has expired.\n   In the discussion below, the values can be represented in any form\n   appropriate for arithmetic operations.\n\n   We use the term \"expires_value\" to denote the value of the Expires\n   header. We use the term \"max_age_value\" to denote an appropriate\n   value of the number of seconds carried by the \"max-age\" directive of\n   the Cache-Control header in a response (see ",{"type":1444,"nodeName":1452,"attributes":11177,"children":11178},{"href":3996},[11179],{"type":1449,"textContent":11180},"section 14.9.3",{"type":1449,"textContent":11182},").\n\n   The max-age directive takes priority over Expires, so if max-age is\n   present in a response, the calculation is simply:\n\n      freshness_lifetime = max_age_value\n\n   Otherwise, if Expires is present in the response, the calculation is:\n\n      freshness_lifetime = expires_value - date_value\n\n   Note that neither of these calculations is vulnerable to clock skew,\n   since all of the information comes from the origin server.\n\n   If none of Expires, Cache-Control: max-age, or Cache-Control: s-\n   maxage (see ",{"type":1444,"nodeName":1452,"attributes":11184,"children":11185},{"href":3996},[11186],{"type":1449,"textContent":11180},{"type":1449,"textContent":11188},") appears in the response, and the response\n   does not include other restrictions on caching, the cache MAY compute\n   a freshness lifetime using a heuristic. The cache MUST attach Warning\n   113 to any response whose age is more than 24 hours if such warning\n   has not already been added.\n\n   Also, if the response does have a Last-Modified time, the heuristic\n   expiration value SHOULD be no more than some fraction of the interval\n   since that time. A typical setting of this fraction might be 10%.\n\n   The calculation to determine if a response has expired is quite\n   simple:\n\n      response_is_fresh = (freshness_lifetime > current_age)\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11190,"children":11191},{"class":1493},[11192],{"type":1449,"textContent":11193},"Fielding, et al.            Standards Track                    [Page 83]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11196,"children":11197},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11199,"children":11200},{"class":1506},[11201,11205,11206,11214,11215,11224,11226,11230,11232,11241,11243],{"type":1444,"nodeName":1461,"attributes":11202,"children":11204},{"id":11203},"page-84",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11207,"children":11208},{"class":1493},[11209,11213],{"type":1444,"nodeName":1452,"attributes":11210,"children":11211},{"href":1518},[11212],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":11216,"children":11217},{"class":5964},[11218,11222],{"type":1444,"nodeName":1452,"attributes":11219,"children":11220},{"class":5220,"id":845,"href":3499},[11221],{"type":1449,"textContent":3502},{"type":1449,"textContent":11223}," Disambiguating Expiration Values",{"type":1449,"textContent":11225},"\n\n   Because expiration values are assigned optimistically, it is possible\n   for two caches to contain fresh values for the same resource that are\n   different.\n\n   If a client performing a retrieval receives a non-first-hand response\n   for a request that was already fresh in its own cache, and the Date\n   header in its existing cache entry is newer than the Date on the new\n   response, then the client MAY ignore the response. If so, it MAY\n   retry the request with a \"Cache-Control: max-age=0\" directive (see\n   ",{"type":1444,"nodeName":1452,"attributes":11227,"children":11228},{"href":3951},[11229],{"type":1449,"textContent":10784},{"type":1449,"textContent":11231},"), to force a check with the origin server.\n\n   If a cache has two fresh responses for the same representation with\n   different validators, it MUST use the one with the more recent Date\n   header. This situation might arise because the cache is pooling\n   responses from other caches, or because a client has asked for a\n   reload or a revalidation of an apparently fresh cache entry.\n\n",{"type":1444,"nodeName":1461,"attributes":11233,"children":11234},{"class":5964},[11235,11239],{"type":1444,"nodeName":1452,"attributes":11236,"children":11237},{"class":5220,"id":850,"href":3514},[11238],{"type":1449,"textContent":3517},{"type":1449,"textContent":11240}," Disambiguating Multiple Responses",{"type":1449,"textContent":11242},"\n\n   Because a client might be receiving responses via multiple paths, so\n   that some responses flow through one set of caches and other\n   responses flow through a different set of caches, a client might\n   receive responses in an order different from that in which the origin\n   server sent them. We would like the client to use the most recently\n   generated response, even if older responses are still apparently\n   fresh.\n\n   Neither the entity tag nor the expiration value can impose an\n   ordering on responses, since it is possible that a later response\n   intentionally carries an earlier expiration time. The Date values are\n   ordered to a granularity of one second.\n\n   When a client tries to revalidate a cache entry, and the response it\n   receives contains a Date header that appears to be older than the one\n   for the existing entry, then the client SHOULD repeat the request\n   unconditionally, and include\n\n       Cache-Control: max-age=0\n\n   to force any intermediate caches to validate their copies directly\n   with the origin server, or\n\n       Cache-Control: no-cache\n\n   to force any intermediate caches to obtain a new copy from the origin\n   server.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11244,"children":11245},{"class":1493},[11246],{"type":1449,"textContent":11247},"Fielding, et al.            Standards Track                    [Page 84]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11250,"children":11251},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11253,"children":11254},{"class":1506},[11255,11259,11260,11268,11270,11279,11281,11285,11287],{"type":1444,"nodeName":1461,"attributes":11256,"children":11258},{"id":11257},"page-85",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11261,"children":11262},{"class":1493},[11263,11267],{"type":1444,"nodeName":1452,"attributes":11264,"children":11265},{"href":1518},[11266],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11269},"\n\n\n   If the Date values are equal, then the client MAY use either response\n   (or MAY, if it is being extremely prudent, request a new response).\n   Servers MUST NOT depend on clients being able to choose\n   deterministically between responses generated during the same second,\n   if their expiration times overlap.\n\n",{"type":1444,"nodeName":1461,"attributes":11271,"children":11272},{"class":5228},[11273,11277],{"type":1444,"nodeName":1452,"attributes":11274,"children":11275},{"class":5220,"id":855,"href":3527},[11276],{"type":1449,"textContent":3530},{"type":1449,"textContent":11278}," Validation Model",{"type":1449,"textContent":11280},"\n\n   When a cache has a stale entry that it would like to use as a\n   response to a client's request, it first has to check with the origin\n   server (or possibly an intermediate cache with a fresh response) to\n   see if its cached entry is still usable. We call this \"validating\"\n   the cache entry. Since we do not want to have to pay the overhead of\n   retransmitting the full response if the cached entry is good, and we\n   do not want to pay the overhead of an extra round trip if the cached\n   entry is invalid, the HTTP\u002F1.1 protocol supports the use of\n   conditional methods.\n\n   The key protocol features for supporting conditional methods are\n   those concerned with \"cache validators.\" When an origin server\n   generates a full response, it attaches some sort of validator to it,\n   which is kept with the cache entry. When a client (user agent or\n   proxy cache) makes a conditional request for a resource for which it\n   has a cache entry, it includes the associated validator in the\n   request.\n\n   The server then checks that validator against the current validator\n   for the entity, and, if they match (see ",{"type":1444,"nodeName":1452,"attributes":11282,"children":11283},{"href":3596},[11284],{"type":1449,"textContent":7013},{"type":1449,"textContent":11286},"), it responds\n   with a special status code (usually, 304 (Not Modified)) and no\n   entity-body. Otherwise, it returns a full response (including\n   entity-body). Thus, we avoid transmitting the full response if the\n   validator matches, and we avoid an extra round trip if it does not\n   match.\n\n   In HTTP\u002F1.1, a conditional request looks exactly the same as a normal\n   request for the same resource, except that it carries a special\n   header (which includes the validator) that implicitly turns the\n   method (usually, GET) into a conditional.\n\n   The protocol includes both positive and negative senses of cache-\n   validating conditions. That is, it is possible to request either that\n   a method be performed if and only if a validator matches or if and\n   only if no validators match.\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11288,"children":11289},{"class":1493},[11290],{"type":1449,"textContent":11291},"Fielding, et al.            Standards Track                    [Page 85]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11294,"children":11295},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11297,"children":11298},{"class":1506},[11299,11303,11304,11312,11314,11323,11325,11334,11336,11341,11343,11347,11348,11352,11353,11357,11358,11362,11363,11372,11374],{"type":1444,"nodeName":1461,"attributes":11300,"children":11302},{"id":11301},"page-86",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11305,"children":11306},{"class":1493},[11307,11311],{"type":1444,"nodeName":1452,"attributes":11308,"children":11309},{"href":1518},[11310],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11313},"\n\n\n      Note: a response that lacks a validator may still be cached, and\n      served from cache until it expires, unless this is explicitly\n      prohibited by a cache-control directive. However, a cache cannot\n      do a conditional retrieval if it does not have a validator for the\n      entity, which means it will not be refreshable after it expires.\n\n",{"type":1444,"nodeName":1461,"attributes":11315,"children":11316},{"class":5964},[11317,11321],{"type":1444,"nodeName":1452,"attributes":11318,"children":11319},{"class":5220,"id":861,"href":3542},[11320],{"type":1449,"textContent":3545},{"type":1449,"textContent":11322}," Last-Modified Dates",{"type":1449,"textContent":11324},"\n\n   The Last-Modified entity-header field value is often used as a cache\n   validator. In simple terms, a cache entry is considered to be valid\n   if the entity has not been modified since the Last-Modified value.\n\n",{"type":1444,"nodeName":1461,"attributes":11326,"children":11327},{"class":5964},[11328,11332],{"type":1444,"nodeName":1452,"attributes":11329,"children":11330},{"class":5220,"id":866,"href":3583},[11331],{"type":1449,"textContent":3586},{"type":1449,"textContent":11333}," Entity Tag Cache Validators",{"type":1449,"textContent":11335},"\n\n   The ETag response-header field value, an entity tag, provides for an\n   \"opaque\" cache validator. This might allow more reliable validation\n   in situations where it is inconvenient to store modification dates,\n   where the one-second resolution of HTTP date values is not\n   sufficient, or where the origin server wishes to avoid certain\n   paradoxes that might arise from the use of modification dates.\n\n   Entity Tags are described in ",{"type":1444,"nodeName":1452,"attributes":11337,"children":11338},{"href":1929},[11339],{"type":1449,"textContent":11340},"section 3.11",{"type":1449,"textContent":11342},". The headers used with\n   entity tags are described in sections ",{"type":1444,"nodeName":1452,"attributes":11344,"children":11345},{"href":4202},[11346],{"type":1449,"textContent":4205},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":11349,"children":11350},{"href":4299},[11351],{"type":1449,"textContent":4302},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":11354,"children":11355},{"href":4329},[11356],{"type":1449,"textContent":4332},{"type":1449,"textContent":6839},{"type":1444,"nodeName":1452,"attributes":11359,"children":11360},{"href":4617},[11361],{"type":1449,"textContent":4620},{"type":1449,"textContent":6397},{"type":1444,"nodeName":1461,"attributes":11364,"children":11365},{"class":5964},[11366,11370],{"type":1444,"nodeName":1452,"attributes":11367,"children":11368},{"class":5220,"id":871,"href":3596},[11369],{"type":1449,"textContent":3599},{"type":1449,"textContent":11371}," Weak and Strong Validators",{"type":1449,"textContent":11373},"\n\n   Since both origin servers and caches will compare two validators to\n   decide if they represent the same or different entities, one normally\n   would expect that if the entity (the entity-body or any entity-\n   headers) changes in any way, then the associated validator would\n   change as well. If this is true, then we call this validator a\n   \"strong validator.\"\n\n   However, there might be cases when a server prefers to change the\n   validator only on semantically significant changes, and not when\n   insignificant aspects of the entity change. A validator that does not\n   always change when the resource changes is a \"weak validator.\"\n\n   Entity tags are normally \"strong validators,\" but the protocol\n   provides a mechanism to tag an entity tag as \"weak.\" One can think of\n   a strong validator as one that changes whenever the bits of an entity\n   changes, while a weak value changes whenever the meaning of an entity\n   changes. Alternatively, one can think of a strong validator as part\n   of an identifier for a specific entity, while a weak validator is\n   part of an identifier for a set of semantically equivalent entities.\n\n      Note: One example of a strong validator is an integer that is\n      incremented in stable storage every time an entity is changed.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11375,"children":11376},{"class":1493},[11377],{"type":1449,"textContent":11378},"Fielding, et al.            Standards Track                    [Page 86]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11381,"children":11382},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11384,"children":11385},{"class":1506},[11386,11390,11391,11399,11401,11406,11408],{"type":1444,"nodeName":1461,"attributes":11387,"children":11389},{"id":11388},"page-87",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11392,"children":11393},{"class":1493},[11394,11398],{"type":1444,"nodeName":1452,"attributes":11395,"children":11396},{"href":1518},[11397],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11400},"\n\n\n      An entity's modification time, if represented with one-second\n      resolution, could be a weak validator, since it is possible that\n      the resource might be modified twice during a single second.\n\n      Support for weak validators is optional. However, weak validators\n      allow for more efficient caching of equivalent objects; for\n      example, a hit counter on a site is probably good enough if it is\n      updated every few days or weeks, and any value during that period\n      is likely \"good enough\" to be equivalent.\n\n   A \"use\" of a validator is either when a client generates a request\n   and includes the validator in a validating header field, or when a\n   server compares two validators.\n\n   Strong validators are usable in any context. Weak validators are only\n   usable in contexts that do not depend on exact equality of an entity.\n   For example, either kind is usable for a conditional GET of a full\n   entity. However, only a strong validator is usable for a sub-range\n   retrieval, since otherwise the client might end up with an internally\n   inconsistent entity.\n\n   Clients MAY issue simple (non-subrange) GET requests with either weak\n   validators or strong validators. Clients MUST NOT use weak validators\n   in other forms of request.\n\n   The only function that the HTTP\u002F1.1 protocol defines on validators is\n   comparison. There are two validator comparison functions, depending\n   on whether the comparison context allows the use of weak validators\n   or not:\n\n      - The strong comparison function: in order to be considered equal,\n        both validators MUST be identical in every way, and both MUST\n        NOT be weak.\n\n      - The weak comparison function: in order to be considered equal,\n        both validators MUST be identical in every way, but either or\n        both of them MAY be tagged as \"weak\" without affecting the\n        result.\n\n   An entity tag is strong unless it is explicitly tagged as weak.\n   ",{"type":1444,"nodeName":1452,"attributes":11402,"children":11403},{"href":1929},[11404],{"type":1449,"textContent":11405},"Section 3.11",{"type":1449,"textContent":11407}," gives the syntax for entity tags.\n\n   A Last-Modified time, when used as a validator in a request, is\n   implicitly weak unless it is possible to deduce that it is strong,\n   using the following rules:\n\n      - The validator is being compared by an origin server to the\n        actual current validator for the entity and,\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11409,"children":11410},{"class":1493},[11411],{"type":1449,"textContent":11412},"Fielding, et al.            Standards Track                    [Page 87]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11415,"children":11416},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11418,"children":11419},{"class":1506},[11420,11424,11425,11433,11435],{"type":1444,"nodeName":1461,"attributes":11421,"children":11423},{"id":11422},"page-88",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11426,"children":11427},{"class":1493},[11428,11432],{"type":1444,"nodeName":1452,"attributes":11429,"children":11430},{"href":1518},[11431],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11434},"\n\n\n      - That origin server reliably knows that the associated entity did\n        not change twice during the second covered by the presented\n        validator.\n\n   or\n\n      - The validator is about to be used by a client in an If-\n        Modified-Since or If-Unmodified-Since header, because the client\n        has a cache entry for the associated entity, and\n\n      - That cache entry includes a Date value, which gives the time\n        when the origin server sent the original response, and\n\n      - The presented Last-Modified time is at least 60 seconds before\n        the Date value.\n\n   or\n\n      - The validator is being compared by an intermediate cache to the\n        validator stored in its cache entry for the entity, and\n\n      - That cache entry includes a Date value, which gives the time\n        when the origin server sent the original response, and\n\n      - The presented Last-Modified time is at least 60 seconds before\n        the Date value.\n\n   This method relies on the fact that if two different responses were\n   sent by the origin server during the same second, but both had the\n   same Last-Modified time, then at least one of those responses would\n   have a Date value equal to its Last-Modified time. The arbitrary 60-\n   second limit guards against the possibility that the Date and Last-\n   Modified values are generated from different clocks, or at somewhat\n   different times during the preparation of the response. An\n   implementation MAY use a value larger than 60 seconds, if it is\n   believed that 60 seconds is too short.\n\n   If a client wishes to perform a sub-range retrieval on a value for\n   which it has only a Last-Modified time and no opaque validator, it\n   MAY do this only if the Last-Modified time is strong in the sense\n   described here.\n\n   A cache or origin server receiving a conditional request, other than\n   a full-body GET request, MUST use the strong comparison function to\n   evaluate the condition.\n\n   These rules allow HTTP\u002F1.1 caches and clients to safely perform sub-\n   range retrievals on values that have been obtained from HTTP\u002F1.0\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11436,"children":11437},{"class":1493},[11438],{"type":1449,"textContent":11439},"Fielding, et al.            Standards Track                    [Page 88]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11442,"children":11443},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11445,"children":11446},{"class":1506},[11447,11451,11452,11460,11462,11473,11475],{"type":1444,"nodeName":1461,"attributes":11448,"children":11450},{"id":11449},"page-89",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11453,"children":11454},{"class":1493},[11455,11459],{"type":1444,"nodeName":1452,"attributes":11456,"children":11457},{"href":1518},[11458],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11461},"\n\n\n   servers.\n\n",{"type":1444,"nodeName":1461,"attributes":11463,"children":11464},{"class":5964},[11465,11471],{"type":1444,"nodeName":1452,"attributes":11466,"children":11468},{"class":5220,"id":876,"href":11467},"#section-13.3.4",[11469],{"type":1449,"textContent":11470},"13.3.4",{"type":1449,"textContent":11472}," Rules for When to Use Entity Tags and Last-Modified Dates",{"type":1449,"textContent":11474},"\n\n   We adopt a set of rules and recommendations for origin servers,\n   clients, and caches regarding when various validator types ought to\n   be used, and for what purposes.\n\n   HTTP\u002F1.1 origin servers:\n\n      - SHOULD send an entity tag validator unless it is not feasible to\n        generate one.\n\n      - MAY send a weak entity tag instead of a strong entity tag, if\n        performance considerations support the use of weak entity tags,\n        or if it is unfeasible to send a strong entity tag.\n\n      - SHOULD send a Last-Modified value if it is feasible to send one,\n        unless the risk of a breakdown in semantic transparency that\n        could result from using this date in an If-Modified-Since header\n        would lead to serious problems.\n\n   In other words, the preferred behavior for an HTTP\u002F1.1 origin server\n   is to send both a strong entity tag and a Last-Modified value.\n\n   In order to be legal, a strong entity tag MUST change whenever the\n   associated entity value changes in any way. A weak entity tag SHOULD\n   change whenever the associated entity changes in a semantically\n   significant way.\n\n      Note: in order to provide semantically transparent caching, an\n      origin server must avoid reusing a specific strong entity tag\n      value for two different entities, or reusing a specific weak\n      entity tag value for two semantically different entities. Cache\n      entries might persist for arbitrarily long periods, regardless of\n      expiration times, so it might be inappropriate to expect that a\n      cache will never again attempt to validate an entry using a\n      validator that it obtained at some point in the past.\n\n   HTTP\u002F1.1 clients:\n\n      - If an entity tag has been provided by the origin server, MUST\n        use that entity tag in any cache-conditional request (using If-\n        Match or If-None-Match).\n\n      - If only a Last-Modified value has been provided by the origin\n        server, SHOULD use that value in non-subrange cache-conditional\n        requests (using If-Modified-Since).\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11476,"children":11477},{"class":1493},[11478],{"type":1449,"textContent":11479},"Fielding, et al.            Standards Track                    [Page 89]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11482,"children":11483},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11485,"children":11486},{"class":1506},[11487,11491,11492,11500,11502,11511,11513],{"type":1444,"nodeName":1461,"attributes":11488,"children":11490},{"id":11489},"page-90",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11493,"children":11494},{"class":1493},[11495,11499],{"type":1444,"nodeName":1452,"attributes":11496,"children":11497},{"href":1518},[11498],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11501},"\n\n\n      - If only a Last-Modified value has been provided by an HTTP\u002F1.0\n        origin server, MAY use that value in subrange cache-conditional\n        requests (using If-Unmodified-Since:). The user agent SHOULD\n        provide a way to disable this, in case of difficulty.\n\n      - If both an entity tag and a Last-Modified value have been\n        provided by the origin server, SHOULD use both validators in\n        cache-conditional requests. This allows both HTTP\u002F1.0 and\n        HTTP\u002F1.1 caches to respond appropriately.\n\n   An HTTP\u002F1.1 origin server, upon receiving a conditional request that\n   includes both a Last-Modified date (e.g., in an If-Modified-Since or\n   If-Unmodified-Since header field) and one or more entity tags (e.g.,\n   in an If-Match, If-None-Match, or If-Range header field) as cache\n   validators, MUST NOT return a response status of 304 (Not Modified)\n   unless doing so is consistent with all of the conditional header\n   fields in the request.\n\n   An HTTP\u002F1.1 caching proxy, upon receiving a conditional request that\n   includes both a Last-Modified date and one or more entity tags as\n   cache validators, MUST NOT return a locally cached response to the\n   client unless that cached response is consistent with all of the\n   conditional header fields in the request.\n\n      Note: The general principle behind these rules is that HTTP\u002F1.1\n      servers and clients should transmit as much non-redundant\n      information as is available in their responses and requests.\n      HTTP\u002F1.1 systems receiving this information will make the most\n      conservative assumptions about the validators they receive.\n\n      HTTP\u002F1.0 clients and caches will ignore entity tags. Generally,\n      last-modified values received or used by these systems will\n      support transparent and efficient caching, and so HTTP\u002F1.1 origin\n      servers should provide Last-Modified values. In those rare cases\n      where the use of a Last-Modified value as a validator by an\n      HTTP\u002F1.0 system could result in a serious problem, then HTTP\u002F1.1\n      origin servers should not provide one.\n\n",{"type":1444,"nodeName":1461,"attributes":11503,"children":11504},{"class":5964},[11505,11509],{"type":1444,"nodeName":1452,"attributes":11506,"children":11507},{"class":5220,"id":881,"href":3610},[11508],{"type":1449,"textContent":3613},{"type":1449,"textContent":11510}," Non-validating Conditionals",{"type":1449,"textContent":11512},"\n\n   The principle behind entity tags is that only the service author\n   knows the semantics of a resource well enough to select an\n   appropriate cache validation mechanism, and the specification of any\n   validator comparison function more complex than byte-equality would\n   open up a can of worms. Thus, comparisons of any other headers\n   (except Last-Modified, for compatibility with HTTP\u002F1.0) are never\n   used for purposes of validating a cache entry.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11514,"children":11515},{"class":1493},[11516],{"type":1449,"textContent":11517},"Fielding, et al.            Standards Track                    [Page 90]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11520,"children":11521},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11523,"children":11524},{"class":1506},[11525,11529,11530,11538,11539,11548,11550,11554,11556,11561,11563,11567,11569,11574,11576,11580,11582],{"type":1444,"nodeName":1461,"attributes":11526,"children":11528},{"id":11527},"page-91",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11531,"children":11532},{"class":1493},[11533,11537],{"type":1444,"nodeName":1452,"attributes":11534,"children":11535},{"href":1518},[11536],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":11540,"children":11541},{"class":5228},[11542,11546],{"type":1444,"nodeName":1452,"attributes":11543,"children":11544},{"class":5220,"id":886,"href":3625},[11545],{"type":1449,"textContent":3628},{"type":1449,"textContent":11547}," Response Cacheability",{"type":1449,"textContent":11549},"\n\n   Unless specifically constrained by a cache-control (",{"type":1444,"nodeName":1452,"attributes":11551,"children":11552},{"href":3951},[11553],{"type":1449,"textContent":10784},{"type":1449,"textContent":11555},")\n   directive, a caching system MAY always store a successful response\n   (see ",{"type":1444,"nodeName":1452,"attributes":11557,"children":11558},{"href":3739},[11559],{"type":1449,"textContent":11560},"section 13.8",{"type":1449,"textContent":11562},") as a cache entry, MAY return it without validation\n   if it is fresh, and MAY return it after successful validation. If\n   there is neither a cache validator nor an explicit expiration time\n   associated with a response, we do not expect it to be cached, but\n   certain caches MAY violate this expectation (for example, when little\n   or no network connectivity is available). A client can usually detect\n   that such a response was taken from a cache by comparing the Date\n   header to the current time.\n\n      Note: some HTTP\u002F1.0 caches are known to violate this expectation\n      without providing any Warning.\n\n   However, in some cases it might be inappropriate for a cache to\n   retain an entity, or to return it in response to a subsequent\n   request. This might be because absolute semantic transparency is\n   deemed necessary by the service author, or because of security or\n   privacy considerations. Certain cache-control directives are\n   therefore provided so that the server can indicate that certain\n   resource entities, or portions thereof, are not to be cached\n   regardless of other considerations.\n\n   Note that ",{"type":1444,"nodeName":1452,"attributes":11564,"children":11565},{"href":3936},[11566],{"type":1449,"textContent":10019},{"type":1449,"textContent":11568}," normally prevents a shared cache from saving\n   and returning a response to a previous request if that request\n   included an Authorization header.\n\n   A response received with a status code of 200, 203, 206, 300, 301 or\n   410 MAY be stored by a cache and used in reply to a subsequent\n   request, subject to the expiration mechanism, unless a cache-control\n   directive prohibits caching. However, a cache that does not support\n   the Range and Content-Range headers MUST NOT cache 206 (Partial\n   Content) responses.\n\n   A response received with any other status code (e.g. status codes 302\n   and 307) MUST NOT be returned in a reply to a subsequent request\n   unless there are cache-control directives or another header(s) that\n   explicitly allow it. For example, these include the following: an\n   Expires header (",{"type":1444,"nodeName":1452,"attributes":11570,"children":11571},{"href":4230},[11572],{"type":1449,"textContent":11573},"section 14.21",{"type":1449,"textContent":11575},"); a \"max-age\", \"s-maxage\",  \"must-\n   revalidate\", \"proxy-revalidate\", \"public\" or \"private\" cache-control\n   directive (",{"type":1444,"nodeName":1452,"attributes":11577,"children":11578},{"href":3951},[11579],{"type":1449,"textContent":10784},{"type":1449,"textContent":11581},").\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11583,"children":11584},{"class":1493},[11585],{"type":1449,"textContent":11586},"Fielding, et al.            Standards Track                    [Page 91]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11589,"children":11590},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11592,"children":11593},{"class":1506},[11594,11598,11599,11607,11608,11617,11619,11628,11630,11634,11636,11645,11647],{"type":1444,"nodeName":1461,"attributes":11595,"children":11597},{"id":11596},"page-92",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11600,"children":11601},{"class":1493},[11602,11606],{"type":1444,"nodeName":1452,"attributes":11603,"children":11604},{"href":1518},[11605],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":11609,"children":11610},{"class":5228},[11611,11615],{"type":1444,"nodeName":1452,"attributes":11612,"children":11613},{"class":5220,"id":891,"href":3640},[11614],{"type":1449,"textContent":3643},{"type":1449,"textContent":11616}," Constructing Responses From Caches",{"type":1449,"textContent":11618},"\n\n   The purpose of an HTTP cache is to store information received in\n   response to requests for use in responding to future requests. In\n   many cases, a cache simply returns the appropriate parts of a\n   response to the requester. However, if the cache holds a cache entry\n   based on a previous response, it might have to combine parts of a new\n   response with what is held in the cache entry.\n\n",{"type":1444,"nodeName":1461,"attributes":11620,"children":11621},{"class":5964},[11622,11626],{"type":1444,"nodeName":1452,"attributes":11623,"children":11624},{"class":5220,"id":897,"href":3655},[11625],{"type":1449,"textContent":3658},{"type":1449,"textContent":11627}," End-to-end and Hop-by-hop Headers",{"type":1449,"textContent":11629},"\n\n   For the purpose of defining the behavior of caches and non-caching\n   proxies, we divide HTTP headers into two categories:\n\n      - End-to-end headers, which are  transmitted to the ultimate\n        recipient of a request or response. End-to-end headers in\n        responses MUST be stored as part of a cache entry and MUST be\n        transmitted in any response formed from a cache entry.\n\n      - Hop-by-hop headers, which are meaningful only for a single\n        transport-level connection, and are not stored by caches or\n        forwarded by proxies.\n\n   The following HTTP\u002F1.1 headers are hop-by-hop headers:\n\n      - Connection\n      - Keep-Alive\n      - Proxy-Authenticate\n      - Proxy-Authorization\n      - TE\n      - Trailers\n      - Transfer-Encoding\n      - Upgrade\n\n   All other headers defined by HTTP\u002F1.1 are end-to-end headers.\n\n   Other hop-by-hop headers MUST be listed in a Connection header,\n   (",{"type":1444,"nodeName":1452,"attributes":11631,"children":11632},{"href":4056},[11633],{"type":1449,"textContent":8684},{"type":1449,"textContent":11635},") to be introduced into HTTP\u002F1.1 (or later).\n\n",{"type":1444,"nodeName":1461,"attributes":11637,"children":11638},{"class":5964},[11639,11643],{"type":1444,"nodeName":1452,"attributes":11640,"children":11641},{"class":5220,"id":902,"href":3668},[11642],{"type":1449,"textContent":3671},{"type":1449,"textContent":11644}," Non-modifiable Headers",{"type":1449,"textContent":11646},"\n\n   Some features of the HTTP\u002F1.1 protocol, such as Digest\n   Authentication, depend on the value of certain end-to-end headers. A\n   transparent proxy SHOULD NOT modify an end-to-end header unless the\n   definition of that header requires or specifically allows that.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11648,"children":11649},{"class":1493},[11650],{"type":1449,"textContent":11651},"Fielding, et al.            Standards Track                    [Page 92]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11654,"children":11655},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11657,"children":11658},{"class":1506},[11659,11663,11664,11672,11674,11678,11680,11684,11686,11690,11692,11696,11698],{"type":1444,"nodeName":1461,"attributes":11660,"children":11662},{"id":11661},"page-93",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11665,"children":11666},{"class":1493},[11667,11671],{"type":1444,"nodeName":1452,"attributes":11668,"children":11669},{"href":1518},[11670],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11673},"\n\n\n   A transparent proxy MUST NOT modify any of the following fields in a\n   request or response, and it MUST NOT add any of these fields if not\n   already present:\n\n      - Content-Location\n\n      - Content-MD5\n\n      - ETag\n\n      - Last-Modified\n\n   A transparent proxy MUST NOT modify any of the following fields in a\n   response:\n\n      - Expires\n\n   but it MAY add any of these fields if not already present. If an\n   Expires header is added, it MUST be given a field-value identical to\n   that of the Date header in that response.\n\n   A  proxy MUST NOT modify or add any of the following fields in a\n   message that contains the no-transform cache-control directive, or in\n   any request:\n\n      - Content-Encoding\n\n      - Content-Range\n\n      - Content-Type\n\n   A non-transparent proxy MAY modify or add these fields to a message\n   that does not include no-transform, but if it does so, it MUST add a\n   Warning 214 (Transformation applied) if one does not already appear\n   in the message (see ",{"type":1444,"nodeName":1452,"attributes":11675,"children":11676},{"href":4645},[11677],{"type":1449,"textContent":10823},{"type":1449,"textContent":11679},").\n\n      Warning: unnecessary modification of end-to-end headers might\n      cause authentication failures if stronger authentication\n      mechanisms are introduced in later versions of HTTP. Such\n      authentication mechanisms MAY rely on the values of header fields\n      not listed here.\n\n   The Content-Length field of a request or response is added or deleted\n   according to the rules in ",{"type":1444,"nodeName":1452,"attributes":11681,"children":11682},{"href":2013},[11683],{"type":1449,"textContent":6520},{"type":1449,"textContent":11685},". A transparent proxy MUST\n   preserve the entity-length (",{"type":1444,"nodeName":1452,"attributes":11687,"children":11688},{"href":2265},[11689],{"type":1449,"textContent":6533},{"type":1449,"textContent":11691},") of the entity-body,\n   although it MAY change the transfer-length (",{"type":1444,"nodeName":1452,"attributes":11693,"children":11694},{"href":2013},[11695],{"type":1449,"textContent":6520},{"type":1449,"textContent":11697},").\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11699,"children":11700},{"class":1493},[11701],{"type":1449,"textContent":11702},"Fielding, et al.            Standards Track                    [Page 93]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11705,"children":11706},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11708,"children":11709},{"class":1506},[11710,11714,11715,11723,11724,11733,11735,11739,11740,11744,11746],{"type":1444,"nodeName":1461,"attributes":11711,"children":11713},{"id":11712},"page-94",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11716,"children":11717},{"class":1493},[11718,11722],{"type":1444,"nodeName":1452,"attributes":11719,"children":11720},{"href":1518},[11721],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":11725,"children":11726},{"class":5964},[11727,11731],{"type":1444,"nodeName":1452,"attributes":11728,"children":11729},{"class":5220,"id":907,"href":3681},[11730],{"type":1449,"textContent":3684},{"type":1449,"textContent":11732}," Combining Headers",{"type":1449,"textContent":11734},"\n\n   When a cache makes a validating request to a server, and the server\n   provides a 304 (Not Modified) response or a 206 (Partial Content)\n   response, the cache then constructs a response to send to the\n   requesting client.\n\n   If the status code is 304 (Not Modified), the cache uses the entity-\n   body stored in the cache entry as the entity-body of this outgoing\n   response. If the status code is 206 (Partial Content) and the ETag or\n   Last-Modified headers match exactly, the cache MAY combine the\n   contents stored in the cache entry with the new contents received in\n   the response and use the result as the entity-body of this outgoing\n   response, (see 13.5.4).\n\n   The end-to-end headers stored in the cache entry are used for the\n   constructed response, except that\n\n      - any stored Warning headers with warn-code 1xx (see ",{"type":1444,"nodeName":1452,"attributes":11736,"children":11737},{"href":4645},[11738],{"type":1449,"textContent":5813},{"type":1449,"textContent":8931},{"type":1444,"nodeName":1452,"attributes":11741,"children":11742},{"href":4645},[11743],{"type":1449,"textContent":4648},{"type":1449,"textContent":11745},") MUST be deleted from the cache entry and the forwarded\n        response.\n\n      - any stored Warning headers with warn-code 2xx MUST be retained\n        in the cache entry and the forwarded response.\n\n      - any end-to-end headers provided in the 304 or 206 response MUST\n        replace the corresponding headers from the cache entry.\n\n   Unless the cache decides to remove the cache entry, it MUST also\n   replace the end-to-end headers stored with the cache entry with\n   corresponding headers received in the incoming response, except for\n   Warning headers as described immediately above. If a header field-\n   name in the incoming response matches more than one header in the\n   cache entry, all such old headers MUST be replaced.\n\n   In other words, the set of end-to-end headers received in the\n   incoming response overrides all corresponding end-to-end headers\n   stored with the cache entry (except for stored Warning headers with\n   warn-code 1xx, which are deleted even if not overridden).\n\n      Note: this rule allows an origin server to use a 304 (Not\n      Modified) or a 206 (Partial Content) response to update any header\n      associated with a previous response for the same entity or sub-\n      ranges thereof, although it might not always be meaningful or\n      correct to do so. This rule does not allow an origin server to use\n      a 304 (Not Modified) or a 206 (Partial Content) response to\n      entirely delete a header that it had provided with a previous\n      response.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11747,"children":11748},{"class":1493},[11749],{"type":1449,"textContent":11750},"Fielding, et al.            Standards Track                    [Page 94]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11753,"children":11754},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11756,"children":11757},{"class":1506},[11758,11762,11763,11771,11772,11781,11783,11787,11789,11798,11800,11805,11807,11811,11813],{"type":1444,"nodeName":1461,"attributes":11759,"children":11761},{"id":11760},"page-95",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11764,"children":11765},{"class":1493},[11766,11770],{"type":1444,"nodeName":1452,"attributes":11767,"children":11768},{"href":1518},[11769],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":11773,"children":11774},{"class":5964},[11775,11779],{"type":1444,"nodeName":1452,"attributes":11776,"children":11777},{"class":5220,"id":912,"href":3696},[11778],{"type":1449,"textContent":3699},{"type":1449,"textContent":11780}," Combining Byte Ranges",{"type":1449,"textContent":11782},"\n\n   A response might transfer only a subrange of the bytes of an entity-\n   body, either because the request included one or more Range\n   specifications, or because a connection was broken prematurely. After\n   several such transfers, a cache might have received several ranges of\n   the same entity-body.\n\n   If a cache has a stored non-empty set of subranges for an entity, and\n   an incoming response transfers another subrange, the cache MAY\n   combine the new subrange with the existing set if both the following\n   conditions are met:\n\n      - Both the incoming response and the cache entry have a cache\n        validator.\n\n      - The two cache validators match using the strong comparison\n        function (see ",{"type":1444,"nodeName":1452,"attributes":11784,"children":11785},{"href":3596},[11786],{"type":1449,"textContent":7013},{"type":1449,"textContent":11788},").\n\n   If either requirement is not met, the cache MUST use only the most\n   recent partial response (based on the Date values transmitted with\n   every response, and using the incoming response if these values are\n   equal or missing), and MUST discard the other partial information.\n\n",{"type":1444,"nodeName":1461,"attributes":11790,"children":11791},{"class":5228},[11792,11796],{"type":1444,"nodeName":1452,"attributes":11793,"children":11794},{"class":5220,"id":917,"href":3711},[11795],{"type":1449,"textContent":3714},{"type":1449,"textContent":11797}," Caching Negotiated Responses",{"type":1449,"textContent":11799},"\n\n   Use of server-driven content negotiation (",{"type":1444,"nodeName":1452,"attributes":11801,"children":11802},{"href":3284},[11803],{"type":1449,"textContent":11804},"section 12.1",{"type":1449,"textContent":11806},"), as indicated\n   by the presence of a Vary header field in a response, alters the\n   conditions and procedure by which a cache can use the response for\n   subsequent requests. See ",{"type":1444,"nodeName":1452,"attributes":11808,"children":11809},{"href":4617},[11810],{"type":1449,"textContent":10607},{"type":1449,"textContent":11812}," for use of the Vary header\n   field by servers.\n\n   A server SHOULD use the Vary header field to inform a cache of what\n   request-header fields were used to select among multiple\n   representations of a cacheable response subject to server-driven\n   negotiation. The set of header fields named by the Vary field value\n   is known as the \"selecting\" request-headers.\n\n   When the cache receives a subsequent request whose Request-URI\n   specifies one or more cache entries including a Vary header field,\n   the cache MUST NOT use such a cache entry to construct a response to\n   the new request unless all of the selecting request-headers present\n   in the new request match the corresponding stored request-headers in\n   the original request.\n\n   The selecting request-headers from two requests are defined to match\n   if and only if the selecting request-headers in the first request can\n   be transformed to the selecting request-headers in the second request\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11814,"children":11815},{"class":1493},[11816],{"type":1449,"textContent":11817},"Fielding, et al.            Standards Track                    [Page 95]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11820,"children":11821},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11823,"children":11824},{"class":1506},[11825,11829,11830,11838,11840,11845,11847,11856,11858],{"type":1444,"nodeName":1461,"attributes":11826,"children":11828},{"id":11827},"page-96",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11831,"children":11832},{"class":1493},[11833,11837],{"type":1444,"nodeName":1452,"attributes":11834,"children":11835},{"href":1518},[11836],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11839},"\n\n\n   by adding or removing linear white space (LWS) at places where this\n   is allowed by the corresponding BNF, and\u002For combining multiple\n   message-header fields with the same field name following the rules\n   about message headers in ",{"type":1444,"nodeName":1452,"attributes":11841,"children":11842},{"href":1985},[11843],{"type":1449,"textContent":11844},"section 4.2",{"type":1449,"textContent":11846},".\n\n   A Vary header field-value of \"*\" always fails to match and subsequent\n   requests on that resource can only be properly interpreted by the\n   origin server.\n\n   If the selecting request header fields for the cached entry do not\n   match the selecting request header fields of the new request, then\n   the cache MUST NOT use a cached entry to satisfy the request unless\n   it first relays the new request to the origin server in a conditional\n   request and the server responds with 304 (Not Modified), including an\n   entity tag or Content-Location that indicates the entity to be used.\n\n   If an entity tag was assigned to a cached representation, the\n   forwarded request SHOULD be conditional and include the entity tags\n   in an If-None-Match header field from all its cache entries for the\n   resource. This conveys to the server the set of entities currently\n   held by the cache, so that if any one of these entities matches the\n   requested entity, the server can use the ETag header field in its 304\n   (Not Modified) response to tell the cache which entry is appropriate.\n   If the entity-tag of the new response matches that of an existing\n   entry, the new response SHOULD be used to update the header fields of\n   the existing entry, and the result MUST be returned to the client.\n\n   If any of the existing cache entries contains only partial content\n   for the associated entity, its entity-tag SHOULD NOT be included in\n   the If-None-Match header field unless the request is for a range that\n   would be fully satisfied by that entry.\n\n   If a cache receives a successful response whose Content-Location\n   field matches that of an existing cache entry for the same Request-\n   ]URI, whose entity-tag differs from that of the existing entry, and\n   whose Date is more recent than that of the existing entry, the\n   existing entry SHOULD NOT be returned in response to future requests\n   and SHOULD be deleted from the cache.\n\n",{"type":1444,"nodeName":1461,"attributes":11848,"children":11849},{"class":5228},[11850,11854],{"type":1444,"nodeName":1452,"attributes":11851,"children":11852},{"class":5220,"id":922,"href":3724},[11853],{"type":1449,"textContent":3727},{"type":1449,"textContent":11855}," Shared and Non-Shared Caches",{"type":1449,"textContent":11857},"\n\n   For reasons of security and privacy, it is necessary to make a\n   distinction between \"shared\" and \"non-shared\" caches. A non-shared\n   cache is one that is accessible only to a single user. Accessibility\n   in this case SHOULD be enforced by appropriate security mechanisms.\n   All other caches are considered to be \"shared.\" Other sections of\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11859,"children":11860},{"class":1493},[11861],{"type":1449,"textContent":11862},"Fielding, et al.            Standards Track                    [Page 96]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11865,"children":11866},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11868,"children":11869},{"class":1506},[11870,11874,11875,11883,11885,11894,11896,11900,11901,11905,11907,11911,11912,11916,11917,11926,11928,11933,11935,11944,11946],{"type":1444,"nodeName":1461,"attributes":11871,"children":11873},{"id":11872},"page-97",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11876,"children":11877},{"class":1493},[11878,11882],{"type":1444,"nodeName":1452,"attributes":11879,"children":11880},{"href":1518},[11881],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11884},"\n\n\n   this specification place certain constraints on the operation of\n   shared caches in order to prevent loss of privacy or failure of\n   access controls.\n\n",{"type":1444,"nodeName":1461,"attributes":11886,"children":11887},{"class":5228},[11888,11892],{"type":1444,"nodeName":1452,"attributes":11889,"children":11890},{"class":5220,"id":927,"href":3739},[11891],{"type":1449,"textContent":3742},{"type":1449,"textContent":11893}," Errors or Incomplete Response Cache Behavior",{"type":1449,"textContent":11895},"\n\n   A cache that receives an incomplete response (for example, with fewer\n   bytes of data than specified in a Content-Length header) MAY store\n   the response. However, the cache MUST treat this as a partial\n   response. Partial responses MAY be combined as described in ",{"type":1444,"nodeName":1452,"attributes":11897,"children":11898},{"href":3696},[11899],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":11902,"children":11903},{"href":3696},[11904],{"type":1449,"textContent":3699},{"type":1449,"textContent":11906},"; the result might be a full response or might still be\n   partial. A cache MUST NOT return a partial response to a client\n   without explicitly marking it as such, using the 206 (Partial\n   Content) status code. A cache MUST NOT return a partial response\n   using a status code of 200 (OK).\n\n   If a cache receives a 5xx response while attempting to revalidate an\n   entry, it MAY either forward this response to the requesting client,\n   or act as if the server failed to respond. In the latter case, it MAY\n   return a previously received response unless the cached entry\n   includes the \"must-revalidate\" cache-control directive (see ",{"type":1444,"nodeName":1452,"attributes":11908,"children":11909},{"href":3951},[11910],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":11913,"children":11914},{"href":3951},[11915],{"type":1449,"textContent":3954},{"type":1449,"textContent":5638},{"type":1444,"nodeName":1461,"attributes":11918,"children":11919},{"class":5228},[11920,11924],{"type":1444,"nodeName":1452,"attributes":11921,"children":11922},{"class":5220,"id":932,"href":3754},[11923],{"type":1449,"textContent":3757},{"type":1449,"textContent":11925}," Side Effects of GET and HEAD",{"type":1449,"textContent":11927},"\n\n   Unless the origin server explicitly prohibits the caching of their\n   responses, the application of GET and HEAD methods to any resources\n   SHOULD NOT have side effects that would lead to erroneous behavior if\n   these responses are taken from a cache. They MAY still have side\n   effects, but a cache is not required to consider such side effects in\n   its caching decisions. Caches are always expected to observe an\n   origin server's explicit restrictions on caching.\n\n   We note one exception to this rule: since some applications have\n   traditionally used GETs and HEADs with query URLs (those containing a\n   \"?\" in the rel_path part) to perform operations with significant side\n   effects, caches MUST NOT treat responses to such URIs as fresh unless\n   the server provides an explicit expiration time. This specifically\n   means that responses from HTTP\u002F1.0 servers for such URIs SHOULD NOT\n   be taken from a cache. See ",{"type":1444,"nodeName":1452,"attributes":11929,"children":11930},{"href":2452},[11931],{"type":1449,"textContent":11932},"section 9.1.1",{"type":1449,"textContent":11934}," for related information.\n\n",{"type":1444,"nodeName":1461,"attributes":11936,"children":11937},{"class":5228},[11938,11942],{"type":1444,"nodeName":1452,"attributes":11939,"children":11940},{"class":5220,"id":937,"href":3767},[11941],{"type":1449,"textContent":3770},{"type":1449,"textContent":11943}," Invalidation After Updates or Deletions",{"type":1449,"textContent":11945},"\n\n   The effect of certain methods performed on a resource at the origin\n   server might cause one or more existing cache entries to become non-\n   transparently invalid. That is, although they might continue to be\n   \"fresh,\" they do not accurately reflect what the origin server would\n   return for a new request on that resource.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11947,"children":11948},{"class":1493},[11949],{"type":1449,"textContent":11950},"Fielding, et al.            Standards Track                    [Page 97]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11953,"children":11954},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11956,"children":11957},{"class":1506},[11958,11962,11963,11971,11973,11982,11984],{"type":1444,"nodeName":1461,"attributes":11959,"children":11961},{"id":11960},"page-98",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":11964,"children":11965},{"class":1493},[11966,11970],{"type":1444,"nodeName":1452,"attributes":11967,"children":11968},{"href":1518},[11969],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":11972},"\n\n\n   There is no way for the HTTP protocol to guarantee that all such\n   cache entries are marked invalid. For example, the request that\n   caused the change at the origin server might not have gone through\n   the proxy where a cache entry is stored. However, several rules help\n   reduce the likelihood of erroneous behavior.\n\n   In this section, the phrase \"invalidate an entity\" means that the\n   cache will either remove all instances of that entity from its\n   storage, or will mark these as \"invalid\" and in need of a mandatory\n   revalidation before they can be returned in response to a subsequent\n   request.\n\n   Some HTTP methods MUST cause a cache to invalidate an entity. This is\n   either the entity referred to by the Request-URI, or by the Location\n   or Content-Location headers (if present). These methods are:\n\n      - PUT\n\n      - DELETE\n\n      - POST\n\n   In order to prevent denial of service attacks, an invalidation based\n   on the URI in a Location or Content-Location header MUST only be\n   performed if the host part is the same as in the Request-URI.\n\n   A cache that passes through requests for methods it does not\n   understand SHOULD invalidate any entities referred to by the\n   Request-URI.\n\n",{"type":1444,"nodeName":1461,"attributes":11974,"children":11975},{"class":5228},[11976,11980],{"type":1444,"nodeName":1452,"attributes":11977,"children":11978},{"class":5220,"id":942,"href":3780},[11979],{"type":1449,"textContent":3783},{"type":1449,"textContent":11981}," Write-Through Mandatory",{"type":1449,"textContent":11983},"\n\n   All methods that might be expected to cause modifications to the\n   origin server's resources MUST be written through to the origin\n   server. This currently includes all methods except for GET and HEAD.\n   A cache MUST NOT reply to such a request from a client before having\n   transmitted the request to the inbound server, and having received a\n   corresponding response from the inbound server. This does not prevent\n   a proxy cache from sending a 100 (Continue) response before the\n   inbound server has sent its final reply.\n\n   The alternative (known as \"write-back\" or \"copy-back\" caching) is not\n   allowed in HTTP\u002F1.1, due to the difficulty of providing consistent\n   updates and the problems arising from server, cache, or network\n   failure prior to write-back.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":11985,"children":11986},{"class":1493},[11987],{"type":1449,"textContent":11988},"Fielding, et al.            Standards Track                    [Page 98]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":11991,"children":11992},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":11994,"children":11995},{"class":1506},[11996,12000,12001,12009,12010,12019,12021,12025,12026,12030,12031,12035,12036,12040,12042,12047,12049,12058,12060],{"type":1444,"nodeName":1461,"attributes":11997,"children":11999},{"id":11998},"page-99",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12002,"children":12003},{"class":1493},[12004,12008],{"type":1444,"nodeName":1452,"attributes":12005,"children":12006},{"href":1518},[12007],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":12011,"children":12012},{"class":5228},[12013,12017],{"type":1444,"nodeName":1452,"attributes":12014,"children":12015},{"class":5220,"id":947,"href":3795},[12016],{"type":1449,"textContent":3798},{"type":1449,"textContent":12018}," Cache Replacement",{"type":1449,"textContent":12020},"\n\n   If a new cacheable (see sections ",{"type":1444,"nodeName":1452,"attributes":12022,"children":12023},{"href":3981},[12024],{"type":1449,"textContent":3984},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":12027,"children":12028},{"href":3499},[12029],{"type":1449,"textContent":3502},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":12032,"children":12033},{"href":3514},[12034],{"type":1449,"textContent":3517},{"type":1449,"textContent":6839},{"type":1444,"nodeName":1452,"attributes":12037,"children":12038},{"href":3739},[12039],{"type":1449,"textContent":3742},{"type":1449,"textContent":12041},")\n   response is received from a resource while any existing responses for\n   the same resource are cached, the cache SHOULD use the new response\n   to reply to the current request. It MAY insert it into cache storage\n   and MAY, if it meets all other requirements, use it to respond to any\n   future requests that would previously have caused the old response to\n   be returned. If it inserts the new response into cache storage  the\n   rules in ",{"type":1444,"nodeName":1452,"attributes":12043,"children":12044},{"href":3681},[12045],{"type":1449,"textContent":12046},"section 13.5.3",{"type":1449,"textContent":12048}," apply.\n\n      Note: a new response that has an older Date header value than\n      existing cached responses is not cacheable.\n\n",{"type":1444,"nodeName":1461,"attributes":12050,"children":12051},{"class":5228},[12052,12056],{"type":1444,"nodeName":1452,"attributes":12053,"children":12054},{"class":5220,"id":952,"href":3810},[12055],{"type":1449,"textContent":3813},{"type":1449,"textContent":12057}," History Lists",{"type":1449,"textContent":12059},"\n\n   User agents often have history mechanisms, such as \"Back\" buttons and\n   history lists, which can be used to redisplay an entity retrieved\n   earlier in a session.\n\n   History mechanisms and caches are different. In particular history\n   mechanisms SHOULD NOT try to show a semantically transparent view of\n   the current state of a resource. Rather, a history mechanism is meant\n   to show exactly what the user saw at the time when the resource was\n   retrieved.\n\n   By default, an expiration time does not apply to history mechanisms.\n   If the entity is still in storage, a history mechanism SHOULD display\n   it even if the entity has expired, unless the user has specifically\n   configured the agent to refresh expired history documents.\n\n   This is not to be construed to prohibit the history mechanism from\n   telling the user that a view might be stale.\n\n      Note: if history list mechanisms unnecessarily prevent users from\n      viewing stale resources, this will tend to force service authors\n      to avoid using HTTP expiration controls and cache controls when\n      they would otherwise like to. Service authors may consider it\n      important that users not be presented with error messages or\n      warning messages when they use navigation controls (such as BACK)\n      to view previously fetched resources. Even though sometimes such\n      resources ought not to cached, or ought to expire quickly, user\n      interface considerations may force service authors to resort to\n      other means of preventing caching (e.g. \"once-only\" URLs) in order\n      not to suffer the effects of improperly functioning history\n      mechanisms.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12061,"children":12062},{"class":1493},[12063],{"type":1449,"textContent":12064},"Fielding, et al.            Standards Track                    [Page 99]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12067,"children":12068},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12070,"children":12071},{"class":1506},[12072,12076,12077,12085,12086,12095,12097,12106,12108,12113,12115],{"type":1444,"nodeName":1461,"attributes":12073,"children":12075},{"id":12074},"page-100",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12078,"children":12079},{"class":1493},[12080,12084],{"type":1444,"nodeName":1452,"attributes":12081,"children":12082},{"href":1518},[12083],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":12087,"children":12088},{"class":5216},[12089,12093],{"type":1444,"nodeName":1452,"attributes":12090,"children":12091},{"class":5220,"id":957,"href":3823},[12092],{"type":1449,"textContent":1611},{"type":1449,"textContent":12094}," Header Field Definitions",{"type":1449,"textContent":12096},"\n\n   This section defines the syntax and semantics of all standard\n   HTTP\u002F1.1 header fields. For entity-header fields, both sender and\n   recipient refer to either the client or the server, depending on who\n   sends and who receives the entity.\n\n",{"type":1444,"nodeName":1461,"attributes":12098,"children":12099},{"class":5228},[12100,12104],{"type":1444,"nodeName":1452,"attributes":12101,"children":12102},{"class":5220,"id":963,"href":3837},[12103],{"type":1449,"textContent":3840},{"type":1449,"textContent":12105}," Accept",{"type":1449,"textContent":12107},"\n\n   The Accept request-header field can be used to specify certain media\n   types which are acceptable for the response. Accept headers can be\n   used to indicate that the request is specifically limited to a small\n   set of desired types, as in the case of a request for an in-line\n   image.\n\n       Accept         = \"Accept\" \":\"\n                        #( media-range [ accept-params ] )\n\n       media-range    = ( \"*\u002F*\"\n                        | ( type \"\u002F\" \"*\" )\n                        | ( type \"\u002F\" subtype )\n                        ) *( \";\" parameter )\n       accept-params  = \";\" \"q\" \"=\" qvalue *( accept-extension )\n       accept-extension = \";\" token [ \"=\" ( token | quoted-string ) ]\n\n   The asterisk \"*\" character is used to group media types into ranges,\n   with \"*\u002F*\" indicating all media types and \"type\u002F*\" indicating all\n   subtypes of that type. The media-range MAY include media type\n   parameters that are applicable to that range.\n\n   Each media-range MAY be followed by one or more accept-params,\n   beginning with the \"q\" parameter for indicating a relative quality\n   factor. The first \"q\" parameter (if any) separates the media-range\n   parameter(s) from the accept-params. Quality factors allow the user\n   or user agent to indicate the relative degree of preference for that\n   media-range, using the qvalue scale from 0 to 1 (",{"type":1444,"nodeName":1452,"attributes":12109,"children":12110},{"href":1901},[12111],{"type":1449,"textContent":12112},"section 3.9",{"type":1449,"textContent":12114},"). The\n   default value is q=1.\n\n      Note: Use of the \"q\" parameter name to separate media type\n      parameters from Accept extension parameters is due to historical\n      practice. Although this prevents any media type parameter named\n      \"q\" from being used with a media range, such an event is believed\n      to be unlikely given the lack of any \"q\" parameters in the IANA\n      media type registry and the rare usage of any media type\n      parameters in Accept. Future media types are discouraged from\n      registering any parameter named \"q\".\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12116,"children":12117},{"class":1493},[12118],{"type":1449,"textContent":12119},"Fielding, et al.            Standards Track                   [Page 100]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12122,"children":12123},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12125,"children":12126},{"class":1506},[12127,12131,12132,12140,12142],{"type":1444,"nodeName":1461,"attributes":12128,"children":12130},{"id":12129},"page-101",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12133,"children":12134},{"class":1493},[12135,12139],{"type":1444,"nodeName":1452,"attributes":12136,"children":12137},{"href":1518},[12138],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12141},"\n\n\n   The example\n\n       Accept: audio\u002F*; q=0.2, audio\u002Fbasic\n\n   SHOULD be interpreted as \"I prefer audio\u002Fbasic, but send me any audio\n   type if it is the best available after an 80% mark-down in quality.\"\n\n   If no Accept header field is present, then it is assumed that the\n   client accepts all media types. If an Accept header field is present,\n   and if the server cannot send a response which is acceptable\n   according to the combined Accept field value, then the server SHOULD\n   send a 406 (not acceptable) response.\n\n   A more elaborate example is\n\n       Accept: text\u002Fplain; q=0.5, text\u002Fhtml,\n               text\u002Fx-dvi; q=0.8, text\u002Fx-c\n\n   Verbally, this would be interpreted as \"text\u002Fhtml and text\u002Fx-c are\n   the preferred media types, but if they do not exist, then send the\n   text\u002Fx-dvi entity, and if that does not exist, send the text\u002Fplain\n   entity.\"\n\n   Media ranges can be overridden by more specific media ranges or\n   specific media types. If more than one media range applies to a given\n   type, the most specific reference has precedence. For example,\n\n       Accept: text\u002F*, text\u002Fhtml, text\u002Fhtml;level=1, *\u002F*\n\n   have the following precedence:\n\n       1) text\u002Fhtml;level=1\n       2) text\u002Fhtml\n       3) text\u002F*\n       4) *\u002F*\n\n   The media type quality factor associated with a given type is\n   determined by finding the media range with the highest precedence\n   which matches that type. For example,\n\n       Accept: text\u002F*;q=0.3, text\u002Fhtml;q=0.7, text\u002Fhtml;level=1,\n               text\u002Fhtml;level=2;q=0.4, *\u002F*;q=0.5\n\n   would cause the following values to be associated:\n\n       text\u002Fhtml;level=1         = 1\n       text\u002Fhtml                 = 0.7\n       text\u002Fplain                = 0.3\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12143,"children":12144},{"class":1493},[12145],{"type":1449,"textContent":12146},"Fielding, et al.            Standards Track                   [Page 101]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12149,"children":12150},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12152,"children":12153},{"class":1506},[12154,12158,12159,12167,12169,12178,12180,12184,12186,12195,12197,12201,12203],{"type":1444,"nodeName":1461,"attributes":12155,"children":12157},{"id":12156},"page-102",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12160,"children":12161},{"class":1493},[12162,12166],{"type":1444,"nodeName":1452,"attributes":12163,"children":12164},{"href":1518},[12165],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12168},"\n\n\n       image\u002Fjpeg                = 0.5\n       text\u002Fhtml;level=2         = 0.4\n       text\u002Fhtml;level=3         = 0.7\n\n      Note: A user agent might be provided with a default set of quality\n      values for certain media ranges. However, unless the user agent is\n      a closed system which cannot interact with other rendering agents,\n      this default set ought to be configurable by the user.\n\n",{"type":1444,"nodeName":1461,"attributes":12170,"children":12171},{"class":5228},[12172,12176],{"type":1444,"nodeName":1452,"attributes":12173,"children":12174},{"class":5220,"id":968,"href":3850},[12175],{"type":1449,"textContent":3853},{"type":1449,"textContent":12177}," Accept-Charset",{"type":1449,"textContent":12179},"\n\n   The Accept-Charset request-header field can be used to indicate what\n   character sets are acceptable for the response. This field allows\n   clients capable of understanding more comprehensive or special-\n   purpose character sets to signal that capability to a server which is\n   capable of representing documents in those character sets.\n\n      Accept-Charset = \"Accept-Charset\" \":\"\n              1#( ( charset | \"*\" )[ \";\" \"q\" \"=\" qvalue ] )\n\n\n   Character set values are described in ",{"type":1444,"nodeName":1452,"attributes":12181,"children":12182},{"href":1770},[12183],{"type":1449,"textContent":6763},{"type":1449,"textContent":12185},". Each charset MAY\n   be given an associated quality value which represents the user's\n   preference for that charset. The default value is q=1. An example is\n\n      Accept-Charset: iso-8859-5, unicode-1-1;q=0.8\n\n   The special value \"*\", if present in the Accept-Charset field,\n   matches every character set (including ISO-8859-1) which is not\n   mentioned elsewhere in the Accept-Charset field. If no \"*\" is present\n   in an Accept-Charset field, then all character sets not explicitly\n   mentioned get a quality value of 0, except for ISO-8859-1, which gets\n   a quality value of 1 if not explicitly mentioned.\n\n   If no Accept-Charset header is present, the default is that any\n   character set is acceptable. If an Accept-Charset header is present,\n   and if the server cannot send a response which is acceptable\n   according to the Accept-Charset header, then the server SHOULD send\n   an error response with the 406 (not acceptable) status code, though\n   the sending of an unacceptable response is also allowed.\n\n",{"type":1444,"nodeName":1461,"attributes":12187,"children":12188},{"class":5228},[12189,12193],{"type":1444,"nodeName":1452,"attributes":12190,"children":12191},{"class":5220,"id":973,"href":3865},[12192],{"type":1449,"textContent":3868},{"type":1449,"textContent":12194}," Accept-Encoding",{"type":1449,"textContent":12196},"\n\n   The Accept-Encoding request-header field is similar to Accept, but\n   restricts the content-codings (",{"type":1444,"nodeName":1452,"attributes":12198,"children":12199},{"href":1798},[12200],{"type":1449,"textContent":6587},{"type":1449,"textContent":12202},") that are acceptable in\n   the response.\n\n       Accept-Encoding  = \"Accept-Encoding\" \":\"\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12204,"children":12205},{"class":1493},[12206],{"type":1449,"textContent":12207},"Fielding, et al.            Standards Track                   [Page 102]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12210,"children":12211},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12213,"children":12214},{"class":1506},[12215,12219,12220,12228,12230,12234,12236],{"type":1444,"nodeName":1461,"attributes":12216,"children":12218},{"id":12217},"page-103",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12221,"children":12222},{"class":1493},[12223,12227],{"type":1444,"nodeName":1452,"attributes":12224,"children":12225},{"href":1518},[12226],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12229},"\n\n\n                          1#( codings [ \";\" \"q\" \"=\" qvalue ] )\n       codings          = ( content-coding | \"*\" )\n\n   Examples of its use are:\n\n       Accept-Encoding: compress, gzip\n       Accept-Encoding:\n       Accept-Encoding: *\n       Accept-Encoding: compress;q=0.5, gzip;q=1.0\n       Accept-Encoding: gzip;q=1.0, identity; q=0.5, *;q=0\n\n   A server tests whether a content-coding is acceptable, according to\n   an Accept-Encoding field, using these rules:\n\n      1. If the content-coding is one of the content-codings listed in\n         the Accept-Encoding field, then it is acceptable, unless it is\n         accompanied by a qvalue of 0. (As defined in ",{"type":1444,"nodeName":1452,"attributes":12231,"children":12232},{"href":1901},[12233],{"type":1449,"textContent":12112},{"type":1449,"textContent":12235},", a\n         qvalue of 0 means \"not acceptable.\")\n\n      2. The special \"*\" symbol in an Accept-Encoding field matches any\n         available content-coding not explicitly listed in the header\n         field.\n\n      3. If multiple content-codings are acceptable, then the acceptable\n         content-coding with the highest non-zero qvalue is preferred.\n\n      4. The \"identity\" content-coding is always acceptable, unless\n         specifically refused because the Accept-Encoding field includes\n         \"identity;q=0\", or because the field includes \"*;q=0\" and does\n         not explicitly include the \"identity\" content-coding. If the\n         Accept-Encoding field-value is empty, then only the \"identity\"\n         encoding is acceptable.\n\n   If an Accept-Encoding field is present in a request, and if the\n   server cannot send a response which is acceptable according to the\n   Accept-Encoding header, then the server SHOULD send an error response\n   with the 406 (Not Acceptable) status code.\n\n   If no Accept-Encoding field is present in a request, the server MAY\n   assume that the client will accept any content coding. In this case,\n   if \"identity\" is one of the available content-codings, then the\n   server SHOULD use the \"identity\" content-coding, unless it has\n   additional information that a different content-coding is meaningful\n   to the client.\n\n      Note: If the request does not include an Accept-Encoding field,\n      and if the \"identity\" content-coding is unavailable, then\n      content-codings commonly understood by HTTP\u002F1.0 clients (i.e.,\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12237,"children":12238},{"class":1493},[12239],{"type":1449,"textContent":12240},"Fielding, et al.            Standards Track                   [Page 103]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12243,"children":12244},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12246,"children":12247},{"class":1506},[12248,12252,12253,12261,12263,12272,12274,12279,12281],{"type":1444,"nodeName":1461,"attributes":12249,"children":12251},{"id":12250},"page-104",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12254,"children":12255},{"class":1493},[12256,12260],{"type":1444,"nodeName":1452,"attributes":12257,"children":12258},{"href":1518},[12259],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12262},"\n\n\n      \"gzip\" and \"compress\") are preferred; some older clients\n      improperly display messages sent with other content-codings.  The\n      server might also make this decision based on information about\n      the particular user-agent or client.\n\n      Note: Most HTTP\u002F1.0 applications do not recognize or obey qvalues\n      associated with content-codings. This means that qvalues will not\n      work and are not permitted with x-gzip or x-compress.\n\n",{"type":1444,"nodeName":1461,"attributes":12264,"children":12265},{"class":5228},[12266,12270],{"type":1444,"nodeName":1452,"attributes":12267,"children":12268},{"class":5220,"id":978,"href":3878},[12269],{"type":1449,"textContent":3881},{"type":1449,"textContent":12271}," Accept-Language",{"type":1449,"textContent":12273},"\n\n   The Accept-Language request-header field is similar to Accept, but\n   restricts the set of natural languages that are preferred as a\n   response to the request. Language tags are defined in ",{"type":1444,"nodeName":1452,"attributes":12275,"children":12276},{"href":1916},[12277],{"type":1449,"textContent":12278},"section 3.10",{"type":1449,"textContent":12280},".\n\n       Accept-Language = \"Accept-Language\" \":\"\n                         1#( language-range [ \";\" \"q\" \"=\" qvalue ] )\n       language-range  = ( ( 1*8ALPHA *( \"-\" 1*8ALPHA ) ) | \"*\" )\n\n   Each language-range MAY be given an associated quality value which\n   represents an estimate of the user's preference for the languages\n   specified by that range. The quality value defaults to \"q=1\". For\n   example,\n\n       Accept-Language: da, en-gb;q=0.8, en;q=0.7\n\n   would mean: \"I prefer Danish, but will accept British English and\n   other types of English.\" A language-range matches a language-tag if\n   it exactly equals the tag, or if it exactly equals a prefix of the\n   tag such that the first tag character following the prefix is \"-\".\n   The special range \"*\", if present in the Accept-Language field,\n   matches every tag not matched by any other range present in the\n   Accept-Language field.\n\n      Note: This use of a prefix matching rule does not imply that\n      language tags are assigned to languages in such a way that it is\n      always true that if a user understands a language with a certain\n      tag, then this user will also understand all languages with tags\n      for which this tag is a prefix. The prefix rule simply allows the\n      use of prefix tags if this is the case.\n\n   The language quality factor assigned to a language-tag by the\n   Accept-Language field is the quality value of the longest language-\n   range in the field that matches the language-tag. If no language-\n   range in the field matches the tag, the language quality factor\n   assigned is 0. If no Accept-Language header is present in the\n   request, the server\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12282,"children":12283},{"class":1493},[12284],{"type":1449,"textContent":12285},"Fielding, et al.            Standards Track                   [Page 104]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12288,"children":12289},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12291,"children":12292},{"class":1506},[12293,12297,12298,12306,12308,12313,12315,12324,12326,12331,12333],{"type":1444,"nodeName":1461,"attributes":12294,"children":12296},{"id":12295},"page-105",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12299,"children":12300},{"class":1493},[12301,12305],{"type":1444,"nodeName":1452,"attributes":12302,"children":12303},{"href":1518},[12304],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12307},"\n\n\n   SHOULD assume that all languages are equally acceptable. If an\n   Accept-Language header is present, then all languages which are\n   assigned a quality factor greater than 0 are acceptable.\n\n   It might be contrary to the privacy expectations of the user to send\n   an Accept-Language header with the complete linguistic preferences of\n   the user in every request. For a discussion of this issue, see\n   ",{"type":1444,"nodeName":1452,"attributes":12309,"children":12310},{"href":4743},[12311],{"type":1449,"textContent":12312},"section 15.1.4",{"type":1449,"textContent":12314},".\n\n   As intelligibility is highly dependent on the individual user, it is\n   recommended that client applications make the choice of linguistic\n   preference available to the user. If the choice is not made\n   available, then the Accept-Language header field MUST NOT be given in\n   the request.\n\n      Note: When making the choice of linguistic preference available to\n      the user, we remind implementors of  the fact that users are not\n      familiar with the details of language matching as described above,\n      and should provide appropriate guidance. As an example, users\n      might assume that on selecting \"en-gb\", they will be served any\n      kind of English document if British English is not available. A\n      user agent might suggest in such a case to add \"en\" to get the\n      best matching behavior.\n\n",{"type":1444,"nodeName":1461,"attributes":12316,"children":12317},{"class":5228},[12318,12322],{"type":1444,"nodeName":1452,"attributes":12319,"children":12320},{"class":5220,"id":983,"href":3893},[12321],{"type":1449,"textContent":3896},{"type":1449,"textContent":12323}," Accept-Ranges",{"type":1449,"textContent":12325},"\n\n      The Accept-Ranges response-header field allows the server to\n      indicate its acceptance of range requests for a resource:\n\n          Accept-Ranges     = \"Accept-Ranges\" \":\" acceptable-ranges\n          acceptable-ranges = 1#range-unit | \"none\"\n\n      Origin servers that accept byte-range requests MAY send\n\n          Accept-Ranges: bytes\n\n      but are not required to do so. Clients MAY generate byte-range\n      requests without having received this header for the resource\n      involved. Range units are defined in ",{"type":1444,"nodeName":1452,"attributes":12327,"children":12328},{"href":1944},[12329],{"type":1449,"textContent":12330},"section 3.12",{"type":1449,"textContent":12332},".\n\n      Servers that do not accept any kind of range request for a\n      resource MAY send\n\n          Accept-Ranges: none\n\n      to advise the client not to attempt a range request.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12334,"children":12335},{"class":1493},[12336],{"type":1449,"textContent":12337},"Fielding, et al.            Standards Track                   [Page 105]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12340,"children":12341},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12343,"children":12344},{"class":1506},[12345,12349,12350,12358,12359,12368,12370,12374,12376,12385,12387],{"type":1444,"nodeName":1461,"attributes":12346,"children":12348},{"id":12347},"page-106",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12351,"children":12352},{"class":1493},[12353,12357],{"type":1444,"nodeName":1452,"attributes":12354,"children":12355},{"href":1518},[12356],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":12360,"children":12361},{"class":5228},[12362,12366],{"type":1444,"nodeName":1452,"attributes":12363,"children":12364},{"class":5220,"id":988,"href":3908},[12365],{"type":1449,"textContent":3911},{"type":1449,"textContent":12367}," Age",{"type":1449,"textContent":12369},"\n\n      The Age response-header field conveys the sender's estimate of the\n      amount of time since the response (or its revalidation) was\n      generated at the origin server. A cached response is \"fresh\" if\n      its age does not exceed its freshness lifetime. Age values are\n      calculated as specified in ",{"type":1444,"nodeName":1452,"attributes":12371,"children":12372},{"href":3471},[12373],{"type":1449,"textContent":11173},{"type":1449,"textContent":12375},".\n\n           Age = \"Age\" \":\" age-value\n           age-value = delta-seconds\n\n      Age values are non-negative decimal integers, representing time in\n      seconds.\n\n      If a cache receives a value larger than the largest positive\n      integer it can represent, or if any of its age calculations\n      overflows, it MUST transmit an Age header with a value of\n      2147483648 (2^31). An HTTP\u002F1.1 server that includes a cache MUST\n      include an Age header field in every response generated from its\n      own cache. Caches SHOULD use an arithmetic type of at least 31\n      bits of range.\n\n",{"type":1444,"nodeName":1461,"attributes":12377,"children":12378},{"class":5228},[12379,12383],{"type":1444,"nodeName":1452,"attributes":12380,"children":12381},{"class":5220,"id":993,"href":3923},[12382],{"type":1449,"textContent":3926},{"type":1449,"textContent":12384}," Allow",{"type":1449,"textContent":12386},"\n\n      The Allow entity-header field lists the set of methods supported\n      by the resource identified by the Request-URI. The purpose of this\n      field is strictly to inform the recipient of valid methods\n      associated with the resource. An Allow header field MUST be\n      present in a 405 (Method Not Allowed) response.\n\n          Allow   = \"Allow\" \":\" #Method\n\n      Example of use:\n\n          Allow: GET, HEAD, PUT\n\n      This field cannot prevent a client from trying other methods.\n      However, the indications given by the Allow header field value\n      SHOULD be followed. The actual set of allowed methods is defined\n      by the origin server at the time of each request.\n\n      The Allow header field MAY be provided with a PUT request to\n      recommend the methods to be supported by the new or modified\n      resource. The server is not required to support these methods and\n      SHOULD include an Allow header in the response giving the actual\n      supported methods.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12388,"children":12389},{"class":1493},[12390],{"type":1449,"textContent":12391},"Fielding, et al.            Standards Track                   [Page 106]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12394,"children":12395},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12397,"children":12398},{"class":1506},[12399,12403,12404,12412,12414,12423,12425,12429,12431,12436,12438],{"type":1444,"nodeName":1461,"attributes":12400,"children":12402},{"id":12401},"page-107",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12405,"children":12406},{"class":1493},[12407,12411],{"type":1444,"nodeName":1452,"attributes":12408,"children":12409},{"href":1518},[12410],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12413},"\n\n\n      A proxy MUST NOT modify the Allow header field even if it does not\n      understand all the methods specified, since the user agent might\n      have other means of communicating with the origin server.\n\n",{"type":1444,"nodeName":1461,"attributes":12415,"children":12416},{"class":5228},[12417,12421],{"type":1444,"nodeName":1452,"attributes":12418,"children":12419},{"class":5220,"id":998,"href":3936},[12420],{"type":1449,"textContent":3939},{"type":1449,"textContent":12422}," Authorization",{"type":1449,"textContent":12424},"\n\n      A user agent that wishes to authenticate itself with a server--\n      usually, but not necessarily, after receiving a 401 response--does\n      so by including an Authorization request-header field with the\n      request.  The Authorization field value consists of credentials\n      containing the authentication information of the user agent for\n      the realm of the resource being requested.\n\n          Authorization  = \"Authorization\" \":\" credentials\n\n      HTTP access authentication is described in \"HTTP Authentication:\n      Basic and Digest Access Authentication\" [",{"type":1444,"nodeName":1452,"attributes":12426,"children":12427},{"href":10024},[12428],{"type":1449,"textContent":2248},{"type":1449,"textContent":12430},"]. If a request is\n      authenticated and a realm specified, the same credentials SHOULD\n      be valid for all other requests within this realm (assuming that\n      the authentication scheme itself does not require otherwise, such\n      as credentials that vary according to a challenge value or using\n      synchronized clocks).\n\n      When a shared cache (see ",{"type":1444,"nodeName":1452,"attributes":12432,"children":12433},{"href":3724},[12434],{"type":1449,"textContent":12435},"section 13.7",{"type":1449,"textContent":12437},") receives a request\n      containing an Authorization field, it MUST NOT return the\n      corresponding response as a reply to any other request, unless one\n      of the following specific exceptions holds:\n\n      1. If the response includes the \"s-maxage\" cache-control\n         directive, the cache MAY use that response in replying to a\n         subsequent request. But (if the specified maximum age has\n         passed) a proxy cache MUST first revalidate it with the origin\n         server, using the request-headers from the new request to allow\n         the origin server to authenticate the new request. (This is the\n         defined behavior for s-maxage.) If the response includes \"s-\n         maxage=0\", the proxy MUST always revalidate it before re-using\n         it.\n\n      2. If the response includes the \"must-revalidate\" cache-control\n         directive, the cache MAY use that response in replying to a\n         subsequent request. But if the response is stale, all caches\n         MUST first revalidate it with the origin server, using the\n         request-headers from the new request to allow the origin server\n         to authenticate the new request.\n\n      3. If the response includes the \"public\" cache-control directive,\n         it MAY be returned in reply to any subsequent request.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12439,"children":12440},{"class":1493},[12441],{"type":1449,"textContent":12442},"Fielding, et al.            Standards Track                   [Page 107]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12445,"children":12446},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12448,"children":12449},{"class":1506},[12450,12454,12455,12463,12464,12473,12475,12480,12482,12487,12489,12494,12496,12501,12503,12507,12509,12513,12515,12520,12522,12527,12529,12534,12536,12540,12542,12546,12548,12552,12554,12558,12560,12564,12566,12570,12572,12576,12578,12582,12584,12588,12590,12594,12596],{"type":1444,"nodeName":1461,"attributes":12451,"children":12453},{"id":12452},"page-108",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12456,"children":12457},{"class":1493},[12458,12462],{"type":1444,"nodeName":1452,"attributes":12459,"children":12460},{"href":1518},[12461],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":12465,"children":12466},{"class":5228},[12467,12471],{"type":1444,"nodeName":1452,"attributes":12468,"children":12469},{"class":5220,"id":1003,"href":3951},[12470],{"type":1449,"textContent":3954},{"type":1449,"textContent":12472}," Cache-Control",{"type":1449,"textContent":12474},"\n\n   The Cache-Control general-header field is used to specify directives\n   that MUST be obeyed by all caching mechanisms along the\n   request\u002Fresponse chain. The directives specify behavior intended to\n   prevent caches from adversely interfering with the request or\n   response. These directives typically override the default caching\n   algorithms. Cache directives are unidirectional in that the presence\n   of a directive in a request does not imply that the same directive is\n   to be given in the response.\n\n      Note that HTTP\u002F1.0 caches might not implement Cache-Control and\n      might only implement Pragma: no-cache (see ",{"type":1444,"nodeName":1452,"attributes":12476,"children":12477},{"href":4417},[12478],{"type":1449,"textContent":12479},"section 14.32",{"type":1449,"textContent":12481},").\n\n   Cache directives MUST be passed through by a proxy or gateway\n   application, regardless of their significance to that application,\n   since the directives might be applicable to all recipients along the\n   request\u002Fresponse chain. It is not possible to specify a cache-\n   directive for a specific cache.\n\n    Cache-Control   = \"Cache-Control\" \":\" 1#cache-directive\n\n    cache-directive = cache-request-directive\n         | cache-response-directive\n\n    cache-request-directive =\n           \"no-cache\"                          ; ",{"type":1444,"nodeName":1452,"attributes":12483,"children":12484},{"href":3966},[12485],{"type":1449,"textContent":12486},"Section 14.9.1",{"type":1449,"textContent":12488},"\n         | \"no-store\"                          ; ",{"type":1444,"nodeName":1452,"attributes":12490,"children":12491},{"href":3981},[12492],{"type":1449,"textContent":12493},"Section 14.9.2",{"type":1449,"textContent":12495},"\n         | \"max-age\" \"=\" delta-seconds         ; ",{"type":1444,"nodeName":1452,"attributes":12497,"children":12498},{"href":3996},[12499],{"type":1449,"textContent":12500},"Section 14.9.3",{"type":1449,"textContent":12502},", 14.9.4\n         | \"max-stale\" [ \"=\" delta-seconds ]   ; ",{"type":1444,"nodeName":1452,"attributes":12504,"children":12505},{"href":3996},[12506],{"type":1449,"textContent":12500},{"type":1449,"textContent":12508},"\n         | \"min-fresh\" \"=\" delta-seconds       ; ",{"type":1444,"nodeName":1452,"attributes":12510,"children":12511},{"href":3996},[12512],{"type":1449,"textContent":12500},{"type":1449,"textContent":12514},"\n         | \"no-transform\"                      ; ",{"type":1444,"nodeName":1452,"attributes":12516,"children":12517},{"href":4026},[12518],{"type":1449,"textContent":12519},"Section 14.9.5",{"type":1449,"textContent":12521},"\n         | \"only-if-cached\"                    ; ",{"type":1444,"nodeName":1452,"attributes":12523,"children":12524},{"href":4011},[12525],{"type":1449,"textContent":12526},"Section 14.9.4",{"type":1449,"textContent":12528},"\n         | cache-extension                     ; ",{"type":1444,"nodeName":1452,"attributes":12530,"children":12531},{"href":4041},[12532],{"type":1449,"textContent":12533},"Section 14.9.6",{"type":1449,"textContent":12535},"\n\n     cache-response-directive =\n           \"public\"                               ; ",{"type":1444,"nodeName":1452,"attributes":12537,"children":12538},{"href":3966},[12539],{"type":1449,"textContent":12486},{"type":1449,"textContent":12541},"\n         | \"private\" [ \"=\" \u003C\"> 1#field-name \u003C\"> ] ; ",{"type":1444,"nodeName":1452,"attributes":12543,"children":12544},{"href":3966},[12545],{"type":1449,"textContent":12486},{"type":1449,"textContent":12547},"\n         | \"no-cache\" [ \"=\" \u003C\"> 1#field-name \u003C\"> ]; ",{"type":1444,"nodeName":1452,"attributes":12549,"children":12550},{"href":3966},[12551],{"type":1449,"textContent":12486},{"type":1449,"textContent":12553},"\n         | \"no-store\"                             ; ",{"type":1444,"nodeName":1452,"attributes":12555,"children":12556},{"href":3981},[12557],{"type":1449,"textContent":12493},{"type":1449,"textContent":12559},"\n         | \"no-transform\"                         ; ",{"type":1444,"nodeName":1452,"attributes":12561,"children":12562},{"href":4026},[12563],{"type":1449,"textContent":12519},{"type":1449,"textContent":12565},"\n         | \"must-revalidate\"                      ; ",{"type":1444,"nodeName":1452,"attributes":12567,"children":12568},{"href":4011},[12569],{"type":1449,"textContent":12526},{"type":1449,"textContent":12571},"\n         | \"proxy-revalidate\"                     ; ",{"type":1444,"nodeName":1452,"attributes":12573,"children":12574},{"href":4011},[12575],{"type":1449,"textContent":12526},{"type":1449,"textContent":12577},"\n         | \"max-age\" \"=\" delta-seconds            ; ",{"type":1444,"nodeName":1452,"attributes":12579,"children":12580},{"href":3996},[12581],{"type":1449,"textContent":12500},{"type":1449,"textContent":12583},"\n         | \"s-maxage\" \"=\" delta-seconds           ; ",{"type":1444,"nodeName":1452,"attributes":12585,"children":12586},{"href":3996},[12587],{"type":1449,"textContent":12500},{"type":1449,"textContent":12589},"\n         | cache-extension                        ; ",{"type":1444,"nodeName":1452,"attributes":12591,"children":12592},{"href":4041},[12593],{"type":1449,"textContent":12533},{"type":1449,"textContent":12595},"\n\n    cache-extension = token [ \"=\" ( token | quoted-string ) ]\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12597,"children":12598},{"class":1493},[12599],{"type":1449,"textContent":12600},"Fielding, et al.            Standards Track                   [Page 108]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12603,"children":12604},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12606,"children":12607},{"class":1506},[12608,12612,12613,12621,12623,12632,12634,12639,12641,12645,12647],{"type":1444,"nodeName":1461,"attributes":12609,"children":12611},{"id":12610},"page-109",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12614,"children":12615},{"class":1493},[12616,12620],{"type":1444,"nodeName":1452,"attributes":12617,"children":12618},{"href":1518},[12619],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12622},"\n\n\n   When a directive appears without any 1#field-name parameter, the\n   directive applies to the entire request or response. When such a\n   directive appears with a 1#field-name parameter, it applies only to\n   the named field or fields, and not to the rest of the request or\n   response. This mechanism supports extensibility; implementations of\n   future versions of the HTTP protocol might apply these directives to\n   header fields not defined in HTTP\u002F1.1.\n\n   The cache-control directives can be broken down into these general\n   categories:\n\n      - Restrictions on what are cacheable; these may only be imposed by\n        the origin server.\n\n      - Restrictions on what may be stored by a cache; these may be\n        imposed by either the origin server or the user agent.\n\n      - Modifications of the basic expiration mechanism; these may be\n        imposed by either the origin server or the user agent.\n\n      - Controls over cache revalidation and reload; these may only be\n        imposed by a user agent.\n\n      - Control over transformation of entities.\n\n      - Extensions to the caching system.\n\n",{"type":1444,"nodeName":1461,"attributes":12624,"children":12625},{"class":5964},[12626,12630],{"type":1444,"nodeName":1452,"attributes":12627,"children":12628},{"class":5220,"id":1009,"href":3966},[12629],{"type":1449,"textContent":3969},{"type":1449,"textContent":12631}," What is Cacheable",{"type":1449,"textContent":12633},"\n\n   By default, a response is cacheable if the requirements of the\n   request method, request header fields, and the response status\n   indicate that it is cacheable. ",{"type":1444,"nodeName":1452,"attributes":12635,"children":12636},{"href":3625},[12637],{"type":1449,"textContent":12638},"Section 13.4",{"type":1449,"textContent":12640}," summarizes these defaults\n   for cacheability. The following Cache-Control response directives\n   allow an origin server to override the default cacheability of a\n   response:\n\n   public\n      Indicates that the response MAY be cached by any cache, even if it\n      would normally be non-cacheable or cacheable only within a non-\n      shared cache. (See also Authorization, ",{"type":1444,"nodeName":1452,"attributes":12642,"children":12643},{"href":3936},[12644],{"type":1449,"textContent":10019},{"type":1449,"textContent":12646},", for\n      additional details.)\n\n   private\n      Indicates that all or part of the response message is intended for\n      a single user and MUST NOT be cached by a shared cache. This\n      allows an origin server to state that the specified parts of the\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12648,"children":12649},{"class":1493},[12650],{"type":1449,"textContent":12651},"Fielding, et al.            Standards Track                   [Page 109]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12654,"children":12655},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12657,"children":12658},{"class":1506},[12659,12663,12664,12672,12674,12683,12685],{"type":1444,"nodeName":1461,"attributes":12660,"children":12662},{"id":12661},"page-110",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12665,"children":12666},{"class":1493},[12667,12671],{"type":1444,"nodeName":1452,"attributes":12668,"children":12669},{"href":1518},[12670],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12673},"\n\n\n      response are intended for only one user and are not a valid\n      response for requests by other users. A private (non-shared) cache\n      MAY cache the response.\n\n       Note: This usage of the word private only controls where the\n       response may be cached, and cannot ensure the privacy of the\n       message content.\n\n   no-cache\n       If the no-cache directive does not specify a field-name, then a\n      cache MUST NOT use the response to satisfy a subsequent request\n      without successful revalidation with the origin server. This\n      allows an origin server to prevent caching even by caches that\n      have been configured to return stale responses to client requests.\n\n      If the no-cache directive does specify one or more field-names,\n      then a cache MAY use the response to satisfy a subsequent request,\n      subject to any other restrictions on caching. However, the\n      specified field-name(s) MUST NOT be sent in the response to a\n      subsequent request without successful revalidation with the origin\n      server. This allows an origin server to prevent the re-use of\n      certain header fields in a response, while still allowing caching\n      of the rest of the response.\n\n       Note: Most HTTP\u002F1.0 caches will not recognize or obey this\n       directive.\n\n",{"type":1444,"nodeName":1461,"attributes":12675,"children":12676},{"class":5964},[12677,12681],{"type":1444,"nodeName":1452,"attributes":12678,"children":12679},{"class":5220,"id":1014,"href":3981},[12680],{"type":1449,"textContent":3984},{"type":1449,"textContent":12682}," What May be Stored by Caches",{"type":1449,"textContent":12684},"\n\n   no-store\n      The purpose of the no-store directive is to prevent the\n      inadvertent release or retention of sensitive information (for\n      example, on backup tapes). The no-store directive applies to the\n      entire message, and MAY be sent either in a response or in a\n      request. If sent in a request, a cache MUST NOT store any part of\n      either this request or any response to it. If sent in a response,\n      a cache MUST NOT store any part of either this response or the\n      request that elicited it. This directive applies to both non-\n      shared and shared caches. \"MUST NOT store\" in this context means\n      that the cache MUST NOT intentionally store the information in\n      non-volatile storage, and MUST make a best-effort attempt to\n      remove the information from volatile storage as promptly as\n      possible after forwarding it.\n\n      Even when this directive is associated with a response, users\n      might explicitly store such a response outside of the caching\n      system (e.g., with a \"Save As\" dialog). History buffers MAY store\n      such responses as part of their normal operation.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12686,"children":12687},{"class":1493},[12688],{"type":1449,"textContent":12689},"Fielding, et al.            Standards Track                   [Page 110]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12692,"children":12693},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12695,"children":12696},{"class":1506},[12697,12701,12702,12710,12712,12721,12723,12727,12729],{"type":1444,"nodeName":1461,"attributes":12698,"children":12700},{"id":12699},"page-111",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12703,"children":12704},{"class":1493},[12705,12709],{"type":1444,"nodeName":1452,"attributes":12706,"children":12707},{"href":1518},[12708],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12711},"\n\n\n      The purpose of this directive is to meet the stated requirements\n      of certain users and service authors who are concerned about\n      accidental releases of information via unanticipated accesses to\n      cache data structures. While the use of this directive might\n      improve privacy in some cases, we caution that it is NOT in any\n      way a reliable or sufficient mechanism for ensuring privacy. In\n      particular, malicious or compromised caches might not recognize or\n      obey this directive, and communications networks might be\n      vulnerable to eavesdropping.\n\n",{"type":1444,"nodeName":1461,"attributes":12713,"children":12714},{"class":5964},[12715,12719],{"type":1444,"nodeName":1452,"attributes":12716,"children":12717},{"class":5220,"id":1019,"href":3996},[12718],{"type":1449,"textContent":3999},{"type":1449,"textContent":12720}," Modifications of the Basic Expiration Mechanism",{"type":1449,"textContent":12722},"\n\n   The expiration time of an entity MAY be specified by the origin\n   server using the Expires header (see ",{"type":1444,"nodeName":1452,"attributes":12724,"children":12725},{"href":4230},[12726],{"type":1449,"textContent":11573},{"type":1449,"textContent":12728},"). Alternatively,\n   it MAY be specified using the max-age directive in a response. When\n   the max-age cache-control directive is present in a cached response,\n   the response is stale if its current age is greater than the age\n   value given (in seconds) at the time of a new request for that\n   resource. The max-age directive on a response implies that the\n   response is cacheable (i.e., \"public\") unless some other, more\n   restrictive cache directive is also present.\n\n   If a response includes both an Expires header and a max-age\n   directive, the max-age directive overrides the Expires header, even\n   if the Expires header is more restrictive. This rule allows an origin\n   server to provide, for a given response, a longer expiration time to\n   an HTTP\u002F1.1 (or later) cache than to an HTTP\u002F1.0 cache. This might be\n   useful if certain HTTP\u002F1.0 caches improperly calculate ages or\n   expiration times, perhaps due to desynchronized clocks.\n\n   Many HTTP\u002F1.0 cache implementations will treat an Expires value that\n   is less than or equal to the response Date value as being equivalent\n   to the Cache-Control response directive \"no-cache\". If an HTTP\u002F1.1\n   cache receives such a response, and the response does not include a\n   Cache-Control header field, it SHOULD consider the response to be\n   non-cacheable in order to retain compatibility with HTTP\u002F1.0 servers.\n\n       Note: An origin server might wish to use a relatively new HTTP\n       cache control feature, such as the \"private\" directive, on a\n       network including older caches that do not understand that\n       feature. The origin server will need to combine the new feature\n       with an Expires field whose value is less than or equal to the\n       Date value. This will prevent older caches from improperly\n       caching the response.\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12730,"children":12731},{"class":1493},[12732],{"type":1449,"textContent":12733},"Fielding, et al.            Standards Track                   [Page 111]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12736,"children":12737},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12739,"children":12740},{"class":1506},[12741,12745,12746,12754,12756,12760,12762],{"type":1444,"nodeName":1461,"attributes":12742,"children":12744},{"id":12743},"page-112",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12747,"children":12748},{"class":1493},[12749,12753],{"type":1444,"nodeName":1452,"attributes":12750,"children":12751},{"href":1518},[12752],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12755},"\n\n\n   s-maxage\n       If a response includes an s-maxage directive, then for a shared\n       cache (but not for a private cache), the maximum age specified by\n       this directive overrides the maximum age specified by either the\n       max-age directive or the Expires header. The s-maxage directive\n       also implies the semantics of the proxy-revalidate directive (see\n       ",{"type":1444,"nodeName":1452,"attributes":12757,"children":12758},{"href":4011},[12759],{"type":1449,"textContent":11018},{"type":1449,"textContent":12761},"), i.e., that the shared cache must not use the\n       entry after it becomes stale to respond to a subsequent request\n       without first revalidating it with the origin server. The s-\n       maxage directive is always ignored by a private cache.\n\n   Note that most older caches, not compliant with this specification,\n   do not implement any cache-control directives. An origin server\n   wishing to use a cache-control directive that restricts, but does not\n   prevent, caching by an HTTP\u002F1.1-compliant cache MAY exploit the\n   requirement that the max-age directive overrides the Expires header,\n   and the fact that pre-HTTP\u002F1.1-compliant caches do not observe the\n   max-age directive.\n\n   Other directives allow a user agent to modify the basic expiration\n   mechanism. These directives MAY be specified on a request:\n\n   max-age\n      Indicates that the client is willing to accept a response whose\n      age is no greater than the specified time in seconds. Unless max-\n      stale directive is also included, the client is not willing to\n      accept a stale response.\n\n   min-fresh\n      Indicates that the client is willing to accept a response whose\n      freshness lifetime is no less than its current age plus the\n      specified time in seconds. That is, the client wants a response\n      that will still be fresh for at least the specified number of\n      seconds.\n\n   max-stale\n      Indicates that the client is willing to accept a response that has\n      exceeded its expiration time. If max-stale is assigned a value,\n      then the client is willing to accept a response that has exceeded\n      its expiration time by no more than the specified number of\n      seconds. If no value is assigned to max-stale, then the client is\n      willing to accept a stale response of any age.\n\n   If a cache returns a stale response, either because of a max-stale\n   directive on a request, or because the cache is configured to\n   override the expiration time of a response, the cache MUST attach a\n   Warning header to the stale response, using Warning 110 (Response is\n   stale).\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12763,"children":12764},{"class":1493},[12765],{"type":1449,"textContent":12766},"Fielding, et al.            Standards Track                   [Page 112]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12769,"children":12770},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12772,"children":12773},{"class":1506},[12774,12778,12779,12787,12789,12798,12800],{"type":1444,"nodeName":1461,"attributes":12775,"children":12777},{"id":12776},"page-113",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12780,"children":12781},{"class":1493},[12782,12786],{"type":1444,"nodeName":1452,"attributes":12783,"children":12784},{"href":1518},[12785],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12788},"\n\n\n   A cache MAY be configured to return stale responses without\n   validation, but only if this does not conflict with any \"MUST\"-level\n   requirements concerning cache validation (e.g., a \"must-revalidate\"\n   cache-control directive).\n\n   If both the new request and the cached entry include \"max-age\"\n   directives, then the lesser of the two values is used for determining\n   the freshness of the cached entry for that request.\n\n",{"type":1444,"nodeName":1461,"attributes":12790,"children":12791},{"class":5964},[12792,12796],{"type":1444,"nodeName":1452,"attributes":12793,"children":12794},{"class":5220,"id":1024,"href":4011},[12795],{"type":1449,"textContent":4014},{"type":1449,"textContent":12797}," Cache Revalidation and Reload Controls",{"type":1449,"textContent":12799},"\n\n   Sometimes a user agent might want or need to insist that a cache\n   revalidate its cache entry with the origin server (and not just with\n   the next cache along the path to the origin server), or to reload its\n   cache entry from the origin server. End-to-end revalidation might be\n   necessary if either the cache or the origin server has overestimated\n   the expiration time of the cached response. End-to-end reload may be\n   necessary if the cache entry has become corrupted for some reason.\n\n   End-to-end revalidation may be requested either when the client does\n   not have its own local cached copy, in which case we call it\n   \"unspecified end-to-end revalidation\", or when the client does have a\n   local cached copy, in which case we call it \"specific end-to-end\n   revalidation.\"\n\n   The client can specify these three kinds of action using Cache-\n   Control request directives:\n\n   End-to-end reload\n      The request includes a \"no-cache\" cache-control directive or, for\n      compatibility with HTTP\u002F1.0 clients, \"Pragma: no-cache\". Field\n      names MUST NOT be included with the no-cache directive in a\n      request. The server MUST NOT use a cached copy when responding to\n      such a request.\n\n   Specific end-to-end revalidation\n      The request includes a \"max-age=0\" cache-control directive, which\n      forces each cache along the path to the origin server to\n      revalidate its own entry, if any, with the next cache or server.\n      The initial request includes a cache-validating conditional with\n      the client's current validator.\n\n   Unspecified end-to-end revalidation\n      The request includes \"max-age=0\" cache-control directive, which\n      forces each cache along the path to the origin server to\n      revalidate its own entry, if any, with the next cache or server.\n      The initial request does not include a cache-validating\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12801,"children":12802},{"class":1493},[12803],{"type":1449,"textContent":12804},"Fielding, et al.            Standards Track                   [Page 113]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12807,"children":12808},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12810,"children":12811},{"class":1506},[12812,12816,12817,12825,12827],{"type":1444,"nodeName":1461,"attributes":12813,"children":12815},{"id":12814},"page-114",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12818,"children":12819},{"class":1493},[12820,12824],{"type":1444,"nodeName":1452,"attributes":12821,"children":12822},{"href":1518},[12823],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12826},"\n\n\n      conditional; the first cache along the path (if any) that holds a\n      cache entry for this resource includes a cache-validating\n      conditional with its current validator.\n\n   max-age\n      When an intermediate cache is forced, by means of a max-age=0\n      directive, to revalidate its own cache entry, and the client has\n      supplied its own validator in the request, the supplied validator\n      might differ from the validator currently stored with the cache\n      entry. In this case, the cache MAY use either validator in making\n      its own request without affecting semantic transparency.\n\n      However, the choice of validator might affect performance. The\n      best approach is for the intermediate cache to use its own\n      validator when making its request. If the server replies with 304\n      (Not Modified), then the cache can return its now validated copy\n      to the client with a 200 (OK) response. If the server replies with\n      a new entity and cache validator, however, the intermediate cache\n      can compare the returned validator with the one provided in the\n      client's request, using the strong comparison function. If the\n      client's validator is equal to the origin server's, then the\n      intermediate cache simply returns 304 (Not Modified). Otherwise,\n      it returns the new entity with a 200 (OK) response.\n\n      If a request includes the no-cache directive, it SHOULD NOT\n      include min-fresh, max-stale, or max-age.\n\n   only-if-cached\n      In some cases, such as times of extremely poor network\n      connectivity, a client may want a cache to return only those\n      responses that it currently has stored, and not to reload or\n      revalidate with the origin server. To do this, the client may\n      include the only-if-cached directive in a request. If it receives\n      this directive, a cache SHOULD either respond using a cached entry\n      that is consistent with the other constraints of the request, or\n      respond with a 504 (Gateway Timeout) status. However, if a group\n      of caches is being operated as a unified system with good internal\n      connectivity, such a request MAY be forwarded within that group of\n      caches.\n\n   must-revalidate\n      Because a cache MAY be configured to ignore a server's specified\n      expiration time, and because a client request MAY include a max-\n      stale directive (which has a similar effect), the protocol also\n      includes a mechanism for the origin server to require revalidation\n      of a cache entry on any subsequent use. When the must-revalidate\n      directive is present in a response received by a cache, that cache\n      MUST NOT use the entry after it becomes stale to respond to a\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12828,"children":12829},{"class":1493},[12830],{"type":1449,"textContent":12831},"Fielding, et al.            Standards Track                   [Page 114]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12834,"children":12835},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12837,"children":12838},{"class":1506},[12839,12843,12844,12852,12854,12863,12865],{"type":1444,"nodeName":1461,"attributes":12840,"children":12842},{"id":12841},"page-115",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12845,"children":12846},{"class":1493},[12847,12851],{"type":1444,"nodeName":1452,"attributes":12848,"children":12849},{"href":1518},[12850],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12853},"\n\n\n      subsequent request without first revalidating it with the origin\n      server. (I.e., the cache MUST do an end-to-end revalidation every\n      time, if, based solely on the origin server's Expires or max-age\n      value, the cached response is stale.)\n\n      The must-revalidate directive is necessary to support reliable\n      operation for certain protocol features. In all circumstances an\n      HTTP\u002F1.1 cache MUST obey the must-revalidate directive; in\n      particular, if the cache cannot reach the origin server for any\n      reason, it MUST generate a 504 (Gateway Timeout) response.\n\n      Servers SHOULD send the must-revalidate directive if and only if\n      failure to revalidate a request on the entity could result in\n      incorrect operation, such as a silently unexecuted financial\n      transaction. Recipients MUST NOT take any automated action that\n      violates this directive, and MUST NOT automatically provide an\n      unvalidated copy of the entity if revalidation fails.\n\n      Although this is not recommended, user agents operating under\n      severe connectivity constraints MAY violate this directive but, if\n      so, MUST explicitly warn the user that an unvalidated response has\n      been provided. The warning MUST be provided on each unvalidated\n      access, and SHOULD require explicit user confirmation.\n\n   proxy-revalidate\n      The proxy-revalidate directive has the same meaning as the must-\n      revalidate directive, except that it does not apply to non-shared\n      user agent caches. It can be used on a response to an\n      authenticated request to permit the user's cache to store and\n      later return the response without needing to revalidate it (since\n      it has already been authenticated once by that user), while still\n      requiring proxies that service many users to revalidate each time\n      (in order to make sure that each user has been authenticated).\n      Note that such authenticated responses also need the public cache\n      control directive in order to allow them to be cached at all.\n\n",{"type":1444,"nodeName":1461,"attributes":12855,"children":12856},{"class":5964},[12857,12861],{"type":1444,"nodeName":1452,"attributes":12858,"children":12859},{"class":5220,"id":1029,"href":4026},[12860],{"type":1449,"textContent":4029},{"type":1449,"textContent":12862}," No-Transform Directive",{"type":1449,"textContent":12864},"\n\n   no-transform\n      Implementors of intermediate caches (proxies) have found it useful\n      to convert the media type of certain entity bodies. A non-\n      transparent proxy might, for example, convert between image\n      formats in order to save cache space or to reduce the amount of\n      traffic on a slow link.\n\n      Serious operational problems occur, however, when these\n      transformations are applied to entity bodies intended for certain\n      kinds of applications. For example, applications for medical\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12866,"children":12867},{"class":1493},[12868],{"type":1449,"textContent":12869},"Fielding, et al.            Standards Track                   [Page 115]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12872,"children":12873},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12875,"children":12876},{"class":1506},[12877,12881,12882,12890,12892,12897,12899,12908,12910],{"type":1444,"nodeName":1461,"attributes":12878,"children":12880},{"id":12879},"page-116",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12883,"children":12884},{"class":1493},[12885,12889],{"type":1444,"nodeName":1452,"attributes":12886,"children":12887},{"href":1518},[12888],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12891},"\n\n\n      imaging, scientific data analysis and those using end-to-end\n      authentication, all depend on receiving an entity body that is bit\n      for bit identical to the original entity-body.\n\n      Therefore, if a message includes the no-transform directive, an\n      intermediate cache or proxy MUST NOT change those headers that are\n      listed in ",{"type":1444,"nodeName":1452,"attributes":12893,"children":12894},{"href":3668},[12895],{"type":1449,"textContent":12896},"section 13.5.2",{"type":1449,"textContent":12898}," as being subject to the no-transform\n      directive. This implies that the cache or proxy MUST NOT change\n      any aspect of the entity-body that is specified by these headers,\n      including the value of the entity-body itself.\n\n",{"type":1444,"nodeName":1461,"attributes":12900,"children":12901},{"class":5964},[12902,12906],{"type":1444,"nodeName":1452,"attributes":12903,"children":12904},{"class":5220,"id":1034,"href":4041},[12905],{"type":1449,"textContent":4044},{"type":1449,"textContent":12907}," Cache Control Extensions",{"type":1449,"textContent":12909},"\n\n   The Cache-Control header field can be extended through the use of one\n   or more cache-extension tokens, each with an optional assigned value.\n   Informational extensions (those which do not require a change in\n   cache behavior) MAY be added without changing the semantics of other\n   directives. Behavioral extensions are designed to work by acting as\n   modifiers to the existing base of cache directives. Both the new\n   directive and the standard directive are supplied, such that\n   applications which do not understand the new directive will default\n   to the behavior specified by the standard directive, and those that\n   understand the new directive will recognize it as modifying the\n   requirements associated with the standard directive. In this way,\n   extensions to the cache-control directives can be made without\n   requiring changes to the base protocol.\n\n   This extension mechanism depends on an HTTP cache obeying all of the\n   cache-control directives defined for its native HTTP-version, obeying\n   certain extensions, and ignoring all directives that it does not\n   understand.\n\n   For example, consider a hypothetical new response directive called\n   community which acts as a modifier to the private directive. We\n   define this new directive to mean that, in addition to any non-shared\n   cache, any cache which is shared only by members of the community\n   named within its value may cache the response. An origin server\n   wishing to allow the UCI community to use an otherwise private\n   response in their shared cache(s) could do so by including\n\n       Cache-Control: private, community=\"UCI\"\n\n   A cache seeing this header field will act correctly even if the cache\n   does not understand the community cache-extension, since it will also\n   see and understand the private directive and thus default to the safe\n   behavior.\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12911,"children":12912},{"class":1493},[12913],{"type":1449,"textContent":12914},"Fielding, et al.            Standards Track                   [Page 116]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12917,"children":12918},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12920,"children":12921},{"class":1506},[12922,12926,12927,12935,12937,12946,12948,12952,12954,12958,12959,12963,12965],{"type":1444,"nodeName":1461,"attributes":12923,"children":12925},{"id":12924},"page-117",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12928,"children":12929},{"class":1493},[12930,12934],{"type":1444,"nodeName":1452,"attributes":12931,"children":12932},{"href":1518},[12933],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":12936},"\n\n\n   Unrecognized cache-directives MUST be ignored; it is assumed that any\n   cache-directive likely to be unrecognized by an HTTP\u002F1.1 cache will\n   be combined with standard directives (or the response's default\n   cacheability) such that the cache behavior will remain minimally\n   correct even if the cache does not understand the extension(s).\n\n",{"type":1444,"nodeName":1461,"attributes":12938,"children":12939},{"class":5228},[12940,12944],{"type":1444,"nodeName":1452,"attributes":12941,"children":12942},{"class":5220,"id":1039,"href":4056},[12943],{"type":1449,"textContent":4059},{"type":1449,"textContent":12945}," Connection",{"type":1449,"textContent":12947},"\n\n   The Connection general-header field allows the sender to specify\n   options that are desired for that particular connection and MUST NOT\n   be communicated by proxies over further connections.\n\n   The Connection header has the following grammar:\n\n       Connection = \"Connection\" \":\" 1#(connection-token)\n       connection-token  = token\n\n   HTTP\u002F1.1 proxies MUST parse the Connection header field before a\n   message is forwarded and, for each connection-token in this field,\n   remove any header field(s) from the message with the same name as the\n   connection-token. Connection options are signaled by the presence of\n   a connection-token in the Connection header field, not by any\n   corresponding additional header field(s), since the additional header\n   field may not be sent if there are no parameters associated with that\n   connection option.\n\n   Message headers listed in the Connection header MUST NOT include\n   end-to-end headers, such as Cache-Control.\n\n   HTTP\u002F1.1 defines the \"close\" connection option for the sender to\n   signal that the connection will be closed after completion of the\n   response. For example,\n\n       Connection: close\n\n   in either the request or the response header fields indicates that\n   the connection SHOULD NOT be considered `persistent' (",{"type":1444,"nodeName":1452,"attributes":12949,"children":12950},{"href":2292},[12951],{"type":1449,"textContent":5636},{"type":1449,"textContent":12953},")\n   after the current request\u002Fresponse is complete.\n\n   HTTP\u002F1.1 applications that do not support persistent connections MUST\n   include the \"close\" connection option in every message.\n\n   A system receiving an HTTP\u002F1.0 (or lower-version) message that\n   includes a Connection header MUST, for each connection-token in this\n   field, remove and ignore any header field(s) from the message with\n   the same name as the connection-token. This protects against mistaken\n   forwarding of such header fields by pre-HTTP\u002F1.1 proxies. See ",{"type":1444,"nodeName":1452,"attributes":12955,"children":12956},{"href":5153},[12957],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":12960,"children":12961},{"href":5153},[12962],{"type":1449,"textContent":5156},{"type":1449,"textContent":12964},".\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":12966,"children":12967},{"class":1493},[12968],{"type":1449,"textContent":12969},"Fielding, et al.            Standards Track                   [Page 117]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":12972,"children":12973},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":12975,"children":12976},{"class":1506},[12977,12981,12982,12990,12991,13000,13002,13006,13008,13012,13013,13017,13019,13028,13030],{"type":1444,"nodeName":1461,"attributes":12978,"children":12980},{"id":12979},"page-118",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":12983,"children":12984},{"class":1493},[12985,12989],{"type":1444,"nodeName":1452,"attributes":12986,"children":12987},{"href":1518},[12988],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":12992,"children":12993},{"class":5228},[12994,12998],{"type":1444,"nodeName":1452,"attributes":12995,"children":12996},{"class":5220,"id":1044,"href":4071},[12997],{"type":1449,"textContent":4074},{"type":1449,"textContent":12999}," Content-Encoding",{"type":1449,"textContent":13001},"\n\n   The Content-Encoding entity-header field is used as a modifier to the\n   media-type. When present, its value indicates what additional content\n   codings have been applied to the entity-body, and thus what decoding\n   mechanisms must be applied in order to obtain the media-type\n   referenced by the Content-Type header field. Content-Encoding is\n   primarily used to allow a document to be compressed without losing\n   the identity of its underlying media type.\n\n       Content-Encoding  = \"Content-Encoding\" \":\" 1#content-coding\n\n   Content codings are defined in ",{"type":1444,"nodeName":1452,"attributes":13003,"children":13004},{"href":1798},[13005],{"type":1449,"textContent":6587},{"type":1449,"textContent":13007},". An example of its use is\n\n       Content-Encoding: gzip\n\n   The content-coding is a characteristic of the entity identified by\n   the Request-URI. Typically, the entity-body is stored with this\n   encoding and is only decoded before rendering or analogous usage.\n   However, a non-transparent proxy MAY modify the content-coding if the\n   new coding is known to be acceptable to the recipient, unless the\n   \"no-transform\" cache-control directive is present in the message.\n\n   If the content-coding of an entity is not \"identity\", then the\n   response MUST include a Content-Encoding entity-header (",{"type":1444,"nodeName":1452,"attributes":13009,"children":13010},{"href":4071},[13011],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":13014,"children":13015},{"href":4071},[13016],{"type":1449,"textContent":4074},{"type":1449,"textContent":13018},") that lists the non-identity content-coding(s) used.\n\n   If the content-coding of an entity in a request message is not\n   acceptable to the origin server, the server SHOULD respond with a\n   status code of 415 (Unsupported Media Type).\n\n   If multiple encodings have been applied to an entity, the content\n   codings MUST be listed in the order in which they were applied.\n   Additional information about the encoding parameters MAY be provided\n   by other entity-header fields not defined by this specification.\n\n",{"type":1444,"nodeName":1461,"attributes":13020,"children":13021},{"class":5228},[13022,13026],{"type":1444,"nodeName":1452,"attributes":13023,"children":13024},{"class":5220,"id":1049,"href":4086},[13025],{"type":1449,"textContent":4089},{"type":1449,"textContent":13027}," Content-Language",{"type":1449,"textContent":13029},"\n\n   The Content-Language entity-header field describes the natural\n   language(s) of the intended audience for the enclosed entity. Note\n   that this might not be equivalent to all the languages used within\n   the entity-body.\n\n       Content-Language  = \"Content-Language\" \":\" 1#language-tag\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13031,"children":13032},{"class":1493},[13033],{"type":1449,"textContent":13034},"Fielding, et al.            Standards Track                   [Page 118]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13037,"children":13038},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13040,"children":13041},{"class":1506},[13042,13046,13047,13055,13057,13061,13063,13072,13074,13078,13079,13083,13085],{"type":1444,"nodeName":1461,"attributes":13043,"children":13045},{"id":13044},"page-119",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13048,"children":13049},{"class":1493},[13050,13054],{"type":1444,"nodeName":1452,"attributes":13051,"children":13052},{"href":1518},[13053],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13056},"\n\n\n   Language tags are defined in ",{"type":1444,"nodeName":1452,"attributes":13058,"children":13059},{"href":1916},[13060],{"type":1449,"textContent":12278},{"type":1449,"textContent":13062},". The primary purpose of\n   Content-Language is to allow a user to identify and differentiate\n   entities according to the user's own preferred language. Thus, if the\n   body content is intended only for a Danish-literate audience, the\n   appropriate field is\n\n       Content-Language: da\n\n   If no Content-Language is specified, the default is that the content\n   is intended for all language audiences. This might mean that the\n   sender does not consider it to be specific to any natural language,\n   or that the sender does not know for which language it is intended.\n\n   Multiple languages MAY be listed for content that is intended for\n   multiple audiences. For example, a rendition of the \"Treaty of\n   Waitangi,\" presented simultaneously in the original Maori and English\n   versions, would call for\n\n       Content-Language: mi, en\n\n   However, just because multiple languages are present within an entity\n   does not mean that it is intended for multiple linguistic audiences.\n   An example would be a beginner's language primer, such as \"A First\n   Lesson in Latin,\" which is clearly intended to be used by an\n   English-literate audience. In this case, the Content-Language would\n   properly only include \"en\".\n\n   Content-Language MAY be applied to any media type -- it is not\n   limited to textual documents.\n\n",{"type":1444,"nodeName":1461,"attributes":13064,"children":13065},{"class":5228},[13066,13070],{"type":1444,"nodeName":1452,"attributes":13067,"children":13068},{"class":5220,"id":1054,"href":4099},[13069],{"type":1449,"textContent":4102},{"type":1449,"textContent":13071}," Content-Length",{"type":1449,"textContent":13073},"\n\n   The Content-Length entity-header field indicates the size of the\n   entity-body, in decimal number of OCTETs, sent to the recipient or,\n   in the case of the HEAD method, the size of the entity-body that\n   would have been sent had the request been a GET.\n\n       Content-Length    = \"Content-Length\" \":\" 1*DIGIT\n\n   An example is\n\n       Content-Length: 3495\n\n   Applications SHOULD use this field to indicate the transfer-length of\n   the message-body, unless this is prohibited by the rules in ",{"type":1444,"nodeName":1452,"attributes":13075,"children":13076},{"href":2013},[13077],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":13080,"children":13081},{"href":2013},[13082],{"type":1449,"textContent":2016},{"type":1449,"textContent":13084},".\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13086,"children":13087},{"class":1493},[13088],{"type":1449,"textContent":13089},"Fielding, et al.            Standards Track                   [Page 119]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13092,"children":13093},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13095,"children":13096},{"class":1506},[13097,13101,13102,13110,13112,13116,13118,13122,13123,13132,13134,13138,13139,13143,13145],{"type":1444,"nodeName":1461,"attributes":13098,"children":13100},{"id":13099},"page-120",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13103,"children":13104},{"class":1493},[13105,13109],{"type":1444,"nodeName":1452,"attributes":13106,"children":13107},{"href":1518},[13108],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13111},"\n\n\n   Any Content-Length greater than or equal to zero is a valid value.\n   ",{"type":1444,"nodeName":1452,"attributes":13113,"children":13114},{"href":2013},[13115],{"type":1449,"textContent":8551},{"type":1449,"textContent":13117}," describes how to determine the length of a message-body\n   if a Content-Length is not given.\n\n   Note that the meaning of this field is significantly different from\n   the corresponding definition in MIME, where it is an optional field\n   used within the \"message\u002Fexternal-body\" content-type. In HTTP, it\n   SHOULD be sent whenever the message's length can be determined prior\n   to being transferred, unless this is prohibited by the rules in\n   ",{"type":1444,"nodeName":1452,"attributes":13119,"children":13120},{"href":2013},[13121],{"type":1449,"textContent":6520},{"type":1449,"textContent":6397},{"type":1444,"nodeName":1461,"attributes":13124,"children":13125},{"class":5228},[13126,13130],{"type":1444,"nodeName":1452,"attributes":13127,"children":13128},{"class":5220,"id":1059,"href":4114},[13129],{"type":1449,"textContent":4117},{"type":1449,"textContent":13131}," Content-Location",{"type":1449,"textContent":13133},"\n\n   The Content-Location entity-header field MAY be used to supply the\n   resource location for the entity enclosed in the message when that\n   entity is accessible from a location separate from the requested\n   resource's URI. A server SHOULD provide a Content-Location for the\n   variant corresponding to the response entity; especially in the case\n   where a resource has multiple entities associated with it, and those\n   entities actually have separate locations by which they might be\n   individually accessed, the server SHOULD provide a Content-Location\n   for the particular variant which is returned.\n\n       Content-Location = \"Content-Location\" \":\"\n                         ( absoluteURI | relativeURI )\n\n   The value of Content-Location also defines the base URI for the\n   entity.\n\n   The Content-Location value is not a replacement for the original\n   requested URI; it is only a statement of the location of the resource\n   corresponding to this particular entity at the time of the request.\n   Future requests MAY specify the Content-Location URI as the request-\n   URI if the desire is to identify the source of that particular\n   entity.\n\n   A cache cannot assume that an entity with a Content-Location\n   different from the URI used to retrieve it can be used to respond to\n   later requests on that Content-Location URI. However, the Content-\n   Location can be used to differentiate between multiple entities\n   retrieved from a single requested resource, as described in ",{"type":1444,"nodeName":1452,"attributes":13135,"children":13136},{"href":3711},[13137],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":13140,"children":13141},{"href":3711},[13142],{"type":1449,"textContent":3714},{"type":1449,"textContent":13144},".\n\n   If the Content-Location is a relative URI, the relative URI is\n   interpreted relative to the Request-URI.\n\n   The meaning of the Content-Location header in PUT or POST requests is\n   undefined; servers are free to ignore it in those cases.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13146,"children":13147},{"class":1493},[13148],{"type":1449,"textContent":13149},"Fielding, et al.            Standards Track                   [Page 120]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13152,"children":13153},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13155,"children":13156},{"class":1506},[13157,13161,13162,13170,13171,13180,13182,13188,13189,13194,13196,13200,13202,13206,13208],{"type":1444,"nodeName":1461,"attributes":13158,"children":13160},{"id":13159},"page-121",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13163,"children":13164},{"class":1493},[13165,13169],{"type":1444,"nodeName":1452,"attributes":13166,"children":13167},{"href":1518},[13168],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":13172,"children":13173},{"class":5228},[13174,13178],{"type":1444,"nodeName":1452,"attributes":13175,"children":13176},{"class":5220,"id":1064,"href":4129},[13177],{"type":1449,"textContent":4132},{"type":1449,"textContent":13179}," Content-MD5",{"type":1449,"textContent":13181},"\n\n   The Content-MD5 entity-header field, as defined in ",{"type":1444,"nodeName":1452,"attributes":13183,"children":13185},{"href":13184},"\u002Finfo\u002Frfc1864\u002F",[13186],{"type":1449,"textContent":13187},"RFC 1864",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":13190,"children":13192},{"href":13191},"#ref-23",[13193],{"type":1449,"textContent":1809},{"type":1449,"textContent":13195},"], is\n   an MD5 digest of the entity-body for the purpose of providing an\n   end-to-end message integrity check (MIC) of the entity-body. (Note: a\n   MIC is good for detecting accidental modification of the entity-body\n   in transit, but is not proof against malicious attacks.)\n\n        Content-MD5   = \"Content-MD5\" \":\" md5-digest\n        md5-digest   = \u003Cbase64 of 128 bit MD5 digest as per ",{"type":1444,"nodeName":1452,"attributes":13197,"children":13198},{"href":13184},[13199],{"type":1449,"textContent":13187},{"type":1449,"textContent":13201},">\n\n   The Content-MD5 header field MAY be generated by an origin server or\n   client to function as an integrity check of the entity-body. Only\n   origin servers or clients MAY generate the Content-MD5 header field;\n   proxies and gateways MUST NOT generate it, as this would defeat its\n   value as an end-to-end integrity check. Any recipient of the entity-\n   body, including gateways and proxies, MAY check that the digest value\n   in this header field matches that of the entity-body as received.\n\n   The MD5 digest is computed based on the content of the entity-body,\n   including any content-coding that has been applied, but not including\n   any transfer-encoding applied to the message-body. If the message is\n   received with a transfer-encoding, that encoding MUST be removed\n   prior to checking the Content-MD5 value against the received entity.\n\n   This has the result that the digest is computed on the octets of the\n   entity-body exactly as, and in the order that, they would be sent if\n   no transfer-encoding were being applied.\n\n   HTTP extends ",{"type":1444,"nodeName":1452,"attributes":13203,"children":13204},{"href":13184},[13205],{"type":1449,"textContent":13187},{"type":1449,"textContent":13207}," to permit the digest to be computed for MIME\n   composite media-types (e.g., multipart\u002F* and message\u002Frfc822), but\n   this does not change how the digest is computed as defined in the\n   preceding paragraph.\n\n   There are several consequences of this. The entity-body for composite\n   types MAY contain many body-parts, each with its own MIME and HTTP\n   headers (including Content-MD5, Content-Transfer-Encoding, and\n   Content-Encoding headers). If a body-part has a Content-Transfer-\n   Encoding or Content-Encoding header, it is assumed that the content\n   of the body-part has had the encoding applied, and the body-part is\n   included in the Content-MD5 digest as is -- i.e., after the\n   application. The Transfer-Encoding header field is not allowed within\n   body-parts.\n\n   Conversion of all line breaks to CRLF MUST NOT be done before\n   computing or checking the digest: the line break convention used in\n   the text actually transmitted MUST be left unaltered when computing\n   the digest.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13209,"children":13210},{"class":1493},[13211],{"type":1449,"textContent":13212},"Fielding, et al.            Standards Track                   [Page 121]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13215,"children":13216},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13218,"children":13219},{"class":1506},[13220,13224,13225,13233,13235,13239,13241,13250,13252,13256,13258,13263,13265],{"type":1444,"nodeName":1461,"attributes":13221,"children":13223},{"id":13222},"page-122",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13226,"children":13227},{"class":1493},[13228,13232],{"type":1444,"nodeName":1452,"attributes":13229,"children":13230},{"href":1518},[13231],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13234},"\n\n\n      Note: while the definition of Content-MD5 is exactly the same for\n      HTTP as in ",{"type":1444,"nodeName":1452,"attributes":13236,"children":13237},{"href":13184},[13238],{"type":1449,"textContent":13187},{"type":1449,"textContent":13240}," for MIME entity-bodies, there are several ways\n      in which the application of Content-MD5 to HTTP entity-bodies\n      differs from its application to MIME entity-bodies. One is that\n      HTTP, unlike MIME, does not use Content-Transfer-Encoding, and\n      does use Transfer-Encoding and Content-Encoding. Another is that\n      HTTP more frequently uses binary content types than MIME, so it is\n      worth noting that, in such cases, the byte order used to compute\n      the digest is the transmission byte order defined for the type.\n      Lastly, HTTP allows transmission of text types with any of several\n      line break conventions and not just the canonical form using CRLF.\n\n",{"type":1444,"nodeName":1461,"attributes":13242,"children":13243},{"class":5228},[13244,13248],{"type":1444,"nodeName":1452,"attributes":13245,"children":13246},{"class":5220,"id":1069,"href":4144},[13247],{"type":1449,"textContent":4147},{"type":1449,"textContent":13249}," Content-Range",{"type":1449,"textContent":13251},"\n\n   The Content-Range entity-header is sent with a partial entity-body to\n   specify where in the full entity-body the partial body should be\n   applied. Range units are defined in ",{"type":1444,"nodeName":1452,"attributes":13253,"children":13254},{"href":1944},[13255],{"type":1449,"textContent":12330},{"type":1449,"textContent":13257},".\n\n       Content-Range = \"Content-Range\" \":\" content-range-spec\n\n       content-range-spec      = byte-content-range-spec\n       byte-content-range-spec = bytes-unit SP\n                                 byte-range-resp-spec \"\u002F\"\n                                 ( instance-length | \"*\" )\n\n       byte-range-resp-spec = (first-byte-pos \"-\" last-byte-pos)\n                                      | \"*\"\n       instance-length           = 1*DIGIT\n\n   The header SHOULD indicate the total length of the full entity-body,\n   unless this length is unknown or difficult to determine. The asterisk\n   \"*\" character means that the instance-length is unknown at the time\n   when the response was generated.\n\n   Unlike byte-ranges-specifier values (see ",{"type":1444,"nodeName":1452,"attributes":13259,"children":13260},{"href":4473},[13261],{"type":1449,"textContent":13262},"section 14.35.1",{"type":1449,"textContent":13264},"), a byte-\n   range-resp-spec MUST only specify one range, and MUST contain\n   absolute byte positions for both the first and last byte of the\n   range.\n\n   A byte-content-range-spec with a byte-range-resp-spec whose last-\n   byte-pos value is less than its first-byte-pos value, or whose\n   instance-length value is less than or equal to its last-byte-pos\n   value, is invalid. The recipient of an invalid byte-content-range-\n   spec MUST ignore it and any content transferred along with it.\n\n   A server sending a response with status code 416 (Requested range not\n   satisfiable) SHOULD include a Content-Range field with a byte-range-\n   resp-spec of \"*\". The instance-length specifies the current length of\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13266,"children":13267},{"class":1493},[13268],{"type":1449,"textContent":13269},"Fielding, et al.            Standards Track                   [Page 122]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13272,"children":13273},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13275,"children":13276},{"class":1506},[13277,13281,13282,13290,13292],{"type":1444,"nodeName":1461,"attributes":13278,"children":13280},{"id":13279},"page-123",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13283,"children":13284},{"class":1493},[13285,13289],{"type":1444,"nodeName":1452,"attributes":13286,"children":13287},{"href":1518},[13288],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13291},"\n\n\n   the selected resource. A response with status code 206 (Partial\n   Content) MUST NOT include a Content-Range field with a byte-range-\n   resp-spec of \"*\".\n\n   Examples of byte-content-range-spec values, assuming that the entity\n   contains a total of 1234 bytes:\n\n      . The first 500 bytes:\n       bytes 0-499\u002F1234\n\n      . The second 500 bytes:\n       bytes 500-999\u002F1234\n\n      . All except for the first 500 bytes:\n       bytes 500-1233\u002F1234\n\n      . The last 500 bytes:\n       bytes 734-1233\u002F1234\n\n   When an HTTP message includes the content of a single range (for\n   example, a response to a request for a single range, or to a request\n   for a set of ranges that overlap without any holes), this content is\n   transmitted with a Content-Range header, and a Content-Length header\n   showing the number of bytes actually transferred. For example,\n\n       HTTP\u002F1.1 206 Partial content\n       Date: Wed, 15 Nov 1995 06:25:24 GMT\n       Last-Modified: Wed, 15 Nov 1995 04:58:08 GMT\n       Content-Range: bytes 21010-47021\u002F47022\n       Content-Length: 26012\n       Content-Type: image\u002Fgif\n\n   When an HTTP message includes the content of multiple ranges (for\n   example, a response to a request for multiple non-overlapping\n   ranges), these are transmitted as a multipart message. The multipart\n   media type used for this purpose is \"multipart\u002Fbyteranges\" as defined\n   in appendix 19.2. See appendix 19.6.3 for a compatibility issue.\n\n   A response to a request for a single range MUST NOT be sent using the\n   multipart\u002Fbyteranges media type.  A response to a request for\n   multiple ranges, whose result is a single range, MAY be sent as a\n   multipart\u002Fbyteranges media type with one part. A client that cannot\n   decode a multipart\u002Fbyteranges message MUST NOT ask for multiple\n   byte-ranges in a single request.\n\n   When a client requests multiple byte-ranges in one request, the\n   server SHOULD return them in the order that they appeared in the\n   request.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13293,"children":13294},{"class":1493},[13295],{"type":1449,"textContent":13296},"Fielding, et al.            Standards Track                   [Page 123]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13299,"children":13300},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13302,"children":13303},{"class":1506},[13304,13308,13309,13317,13319,13324,13326,13335,13337,13341,13343,13348,13349,13358,13360,13364,13366,13370,13371,13375,13377,13381,13382,13386,13388],{"type":1444,"nodeName":1461,"attributes":13305,"children":13307},{"id":13306},"page-124",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13310,"children":13311},{"class":1493},[13312,13316],{"type":1444,"nodeName":1452,"attributes":13313,"children":13314},{"href":1518},[13315],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13318},"\n\n\n   If the server ignores a byte-range-spec because it is syntactically\n   invalid, the server SHOULD treat the request as if the invalid Range\n   header field did not exist. (Normally, this means return a 200\n   response containing the full entity).\n\n   If the server receives a request (other than one including an If-\n   Range request-header field) with an unsatisfiable Range request-\n   header field (that is, all of whose byte-range-spec values have a\n   first-byte-pos value greater than the current length of the selected\n   resource), it SHOULD return a response code of 416 (Requested range\n   not satisfiable) (",{"type":1444,"nodeName":1452,"attributes":13320,"children":13321},{"href":3138},[13322],{"type":1449,"textContent":13323},"section 10.4.17",{"type":1449,"textContent":13325},").\n\n      Note: clients cannot depend on servers to send a 416 (Requested\n      range not satisfiable) response instead of a 200 (OK) response for\n      an unsatisfiable Range request-header, since not all servers\n      implement this request-header.\n\n",{"type":1444,"nodeName":1461,"attributes":13327,"children":13328},{"class":5228},[13329,13333],{"type":1444,"nodeName":1452,"attributes":13330,"children":13331},{"class":5220,"id":1074,"href":4159},[13332],{"type":1449,"textContent":4162},{"type":1449,"textContent":13334}," Content-Type",{"type":1449,"textContent":13336},"\n\n   The Content-Type entity-header field indicates the media type of the\n   entity-body sent to the recipient or, in the case of the HEAD method,\n   the media type that would have been sent had the request been a GET.\n\n       Content-Type   = \"Content-Type\" \":\" media-type\n\n   Media types are defined in ",{"type":1444,"nodeName":1452,"attributes":13338,"children":13339},{"href":1843},[13340],{"type":1449,"textContent":5757},{"type":1449,"textContent":13342},". An example of the field is\n\n       Content-Type: text\u002Fhtml; charset=ISO-8859-4\n\n   Further discussion of methods for identifying the media type of an\n   entity is provided in ",{"type":1444,"nodeName":1452,"attributes":13344,"children":13345},{"href":2252},[13346],{"type":1449,"textContent":13347},"section 7.2.1",{"type":1449,"textContent":6397},{"type":1444,"nodeName":1461,"attributes":13350,"children":13351},{"class":5228},[13352,13356],{"type":1444,"nodeName":1452,"attributes":13353,"children":13354},{"class":5220,"id":1079,"href":4174},[13355],{"type":1449,"textContent":4177},{"type":1449,"textContent":13357}," Date",{"type":1449,"textContent":13359},"\n\n   The Date general-header field represents the date and time at which\n   the message was originated, having the same semantics as orig-date in\n   ",{"type":1444,"nodeName":1452,"attributes":13361,"children":13362},{"href":5662},[13363],{"type":1449,"textContent":5665},{"type":1449,"textContent":13365},". The field value is an HTTP-date, as described in ",{"type":1444,"nodeName":1452,"attributes":13367,"children":13368},{"href":1742},[13369],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":13372,"children":13373},{"href":1742},[13374],{"type":1449,"textContent":1745},{"type":1449,"textContent":13376},"; it MUST be sent in ",{"type":1444,"nodeName":1452,"attributes":13378,"children":13379},{"href":6155},[13380],{"type":1449,"textContent":6158},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":13383,"children":13384},{"href":6184},[13385],{"type":1449,"textContent":1568},{"type":1449,"textContent":13387},"]-date format.\n\n       Date  = \"Date\" \":\" HTTP-date\n\n   An example is\n\n       Date: Tue, 15 Nov 1994 08:12:31 GMT\n\n   Origin servers MUST include a Date header field in all responses,\n   except in these cases:\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13389,"children":13390},{"class":1493},[13391],{"type":1449,"textContent":13392},"Fielding, et al.            Standards Track                   [Page 124]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13395,"children":13396},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13398,"children":13399},{"class":1506},[13400,13404,13405,13413,13415,13419,13421,13425,13427,13436,13438],{"type":1444,"nodeName":1461,"attributes":13401,"children":13403},{"id":13402},"page-125",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13406,"children":13407},{"class":1493},[13408,13412],{"type":1444,"nodeName":1452,"attributes":13409,"children":13410},{"href":1518},[13411],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13414},"\n\n\n      1. If the response status code is 100 (Continue) or 101 (Switching\n         Protocols), the response MAY include a Date header field, at\n         the server's option.\n\n      2. If the response status code conveys a server error, e.g. 500\n         (Internal Server Error) or 503 (Service Unavailable), and it is\n         inconvenient or impossible to generate a valid Date.\n\n      3. If the server does not have a clock that can provide a\n         reasonable approximation of the current time, its responses\n         MUST NOT include a Date header field. In this case, the rules\n         in ",{"type":1444,"nodeName":1452,"attributes":13416,"children":13417},{"href":4187},[13418],{"type":1449,"textContent":9835},{"type":1449,"textContent":13420}," MUST be followed.\n\n   A received message that does not have a Date header field MUST be\n   assigned one by the recipient if the message will be cached by that\n   recipient or gatewayed via a protocol which requires a Date. An HTTP\n   implementation without a clock MUST NOT cache responses without\n   revalidating them on every use. An HTTP cache, especially a shared\n   cache, SHOULD use a mechanism, such as NTP [",{"type":1444,"nodeName":1452,"attributes":13422,"children":13423},{"href":11065},[13424],{"type":1449,"textContent":1897},{"type":1449,"textContent":13426},"], to synchronize its\n   clock with a reliable external standard.\n\n   Clients SHOULD only send a Date header field in messages that include\n   an entity-body, as in the case of the PUT and POST requests, and even\n   then it is optional. A client without a clock MUST NOT send a Date\n   header field in a request.\n\n   The HTTP-date sent in a Date header SHOULD NOT represent a date and\n   time subsequent to the generation of the message. It SHOULD represent\n   the best available approximation of the date and time of message\n   generation, unless the implementation has no means of generating a\n   reasonably accurate date and time. In theory, the date ought to\n   represent the moment just before the entity is generated. In\n   practice, the date can be generated at any time during the message\n   origination without affecting its semantic value.\n\n",{"type":1444,"nodeName":1461,"attributes":13428,"children":13429},{"class":5964},[13430,13434],{"type":1444,"nodeName":1452,"attributes":13431,"children":13432},{"class":5220,"id":1085,"href":4187},[13433],{"type":1449,"textContent":4190},{"type":1449,"textContent":13435}," Clockless Origin Server Operation",{"type":1449,"textContent":13437},"\n\n   Some origin server implementations might not have a clock available.\n   An origin server without a clock MUST NOT assign Expires or Last-\n   Modified values to a response, unless these values were associated\n   with the resource by a system or user with a reliable clock. It MAY\n   assign an Expires value that is known, at or before server\n   configuration time, to be in the past (this allows \"pre-expiration\"\n   of responses without storing separate Expires values for each\n   resource).\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13439,"children":13440},{"class":1493},[13441],{"type":1449,"textContent":13442},"Fielding, et al.            Standards Track                   [Page 125]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13445,"children":13446},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13448,"children":13449},{"class":1506},[13450,13454,13455,13463,13464,13473,13475,13479,13480,13484,13485,13489,13491,13495,13497,13506,13508],{"type":1444,"nodeName":1461,"attributes":13451,"children":13453},{"id":13452},"page-126",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13456,"children":13457},{"class":1493},[13458,13462],{"type":1444,"nodeName":1452,"attributes":13459,"children":13460},{"href":1518},[13461],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":13465,"children":13466},{"class":5228},[13467,13471],{"type":1444,"nodeName":1452,"attributes":13468,"children":13469},{"class":5220,"id":1090,"href":4202},[13470],{"type":1449,"textContent":4205},{"type":1449,"textContent":13472}," ETag",{"type":1449,"textContent":13474},"\n\n   The ETag response-header field provides the current value of the\n   entity tag for the requested variant. The headers used with entity\n   tags are described in sections ",{"type":1444,"nodeName":1452,"attributes":13476,"children":13477},{"href":4299},[13478],{"type":1449,"textContent":4302},{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":13481,"children":13482},{"href":4329},[13483],{"type":1449,"textContent":4332},{"type":1449,"textContent":6839},{"type":1444,"nodeName":1452,"attributes":13486,"children":13487},{"href":4617},[13488],{"type":1449,"textContent":4620},{"type":1449,"textContent":13490},". The entity tag\n   MAY be used for comparison with other entities from the same resource\n   (see ",{"type":1444,"nodeName":1452,"attributes":13492,"children":13493},{"href":3596},[13494],{"type":1449,"textContent":7013},{"type":1449,"textContent":13496},").\n\n      ETag = \"ETag\" \":\" entity-tag\n\n   Examples:\n\n      ETag: \"xyzzy\"\n      ETag: W\u002F\"xyzzy\"\n      ETag: \"\"\n\n",{"type":1444,"nodeName":1461,"attributes":13498,"children":13499},{"class":5228},[13500,13504],{"type":1444,"nodeName":1452,"attributes":13501,"children":13502},{"class":5220,"id":1095,"href":4217},[13503],{"type":1449,"textContent":4220},{"type":1449,"textContent":13505}," Expect",{"type":1449,"textContent":13507},"\n\n   The Expect request-header field is used to indicate that particular\n   server behaviors are required by the client.\n\n      Expect       =  \"Expect\" \":\" 1#expectation\n\n      expectation  =  \"100-continue\" | expectation-extension\n      expectation-extension =  token [ \"=\" ( token | quoted-string )\n                               *expect-params ]\n      expect-params =  \";\" token [ \"=\" ( token | quoted-string ) ]\n\n\n   A server that does not understand or is unable to comply with any of\n   the expectation values in the Expect field of a request MUST respond\n   with appropriate error status. The server MUST respond with a 417\n   (Expectation Failed) status if any of the expectations cannot be met\n   or, if there are other problems with the request, some other 4xx\n   status.\n\n   This header field is defined with extensible syntax to allow for\n   future extensions. If a server receives a request containing an\n   Expect field that includes an expectation-extension that it does not\n   support, it MUST respond with a 417 (Expectation Failed) status.\n\n   Comparison of expectation values is case-insensitive for unquoted\n   tokens (including the 100-continue token), and is case-sensitive for\n   quoted-string expectation-extensions.\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13509,"children":13510},{"class":1493},[13511],{"type":1449,"textContent":13512},"Fielding, et al.            Standards Track                   [Page 126]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13515,"children":13516},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13518,"children":13519},{"class":1506},[13520,13524,13525,13533,13535,13539,13541,13550,13552,13556,13557,13561,13563,13568,13570,13574,13576,13580,13582,13586,13588],{"type":1444,"nodeName":1461,"attributes":13521,"children":13523},{"id":13522},"page-127",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13526,"children":13527},{"class":1493},[13528,13532],{"type":1444,"nodeName":1452,"attributes":13529,"children":13530},{"href":1518},[13531],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13534},"\n\n\n   The Expect mechanism is hop-by-hop: that is, an HTTP\u002F1.1 proxy MUST\n   return a 417 (Expectation Failed) status if it receives a request\n   with an expectation that it cannot meet. However, the Expect\n   request-header itself is end-to-end; it MUST be forwarded if the\n   request is forwarded.\n\n   Many older HTTP\u002F1.0 and HTTP\u002F1.1 applications do not understand the\n   Expect header.\n\n   See ",{"type":1444,"nodeName":1452,"attributes":13536,"children":13537},{"href":2403},[13538],{"type":1449,"textContent":9475},{"type":1449,"textContent":13540}," for the use of the 100 (continue) status.\n\n",{"type":1444,"nodeName":1461,"attributes":13542,"children":13543},{"class":5228},[13544,13548],{"type":1444,"nodeName":1452,"attributes":13545,"children":13546},{"class":5220,"id":1100,"href":4230},[13547],{"type":1449,"textContent":4233},{"type":1449,"textContent":13549}," Expires",{"type":1449,"textContent":13551},"\n\n   The Expires entity-header field gives the date\u002Ftime after which the\n   response is considered stale. A stale cache entry may not normally be\n   returned by a cache (either a proxy cache or a user agent cache)\n   unless it is first validated with the origin server (or with an\n   intermediate cache that has a fresh copy of the entity). See ",{"type":1444,"nodeName":1452,"attributes":13553,"children":13554},{"href":3430},[13555],{"type":1449,"textContent":5813},{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":13558,"children":13559},{"href":3430},[13560],{"type":1449,"textContent":3433},{"type":1449,"textContent":13562}," for further discussion of the expiration model.\n\n   The presence of an Expires field does not imply that the original\n   resource will change or cease to exist at, before, or after that\n   time.\n\n   The format is an absolute date and time as defined by HTTP-date in\n   ",{"type":1444,"nodeName":1452,"attributes":13564,"children":13565},{"href":1742},[13566],{"type":1449,"textContent":13567},"section 3.3.1",{"type":1449,"textContent":13569},"; it MUST be in ",{"type":1444,"nodeName":1452,"attributes":13571,"children":13572},{"href":6155},[13573],{"type":1449,"textContent":6158},{"type":1449,"textContent":13575}," date format:\n\n      Expires = \"Expires\" \":\" HTTP-date\n\n   An example of its use is\n\n      Expires: Thu, 01 Dec 1994 16:00:00 GMT\n\n      Note: if a response includes a Cache-Control field with the max-\n      age directive (see ",{"type":1444,"nodeName":1452,"attributes":13577,"children":13578},{"href":3996},[13579],{"type":1449,"textContent":11180},{"type":1449,"textContent":13581},"), that directive overrides the\n      Expires field.\n\n   HTTP\u002F1.1 clients and caches MUST treat other invalid date formats,\n   especially including the value \"0\", as in the past (i.e., \"already\n   expired\").\n\n   To mark a response as \"already expired,\" an origin server sends an\n   Expires date that is equal to the Date header value. (See the rules\n   for expiration calculations in ",{"type":1444,"nodeName":1452,"attributes":13583,"children":13584},{"href":3484},[13585],{"type":1449,"textContent":11060},{"type":1449,"textContent":13587},".)\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13589,"children":13590},{"class":1493},[13591],{"type":1449,"textContent":13592},"Fielding, et al.            Standards Track                   [Page 127]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13595,"children":13596},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13598,"children":13599},{"class":1506},[13600,13604,13605,13613,13615,13619,13620,13629,13631,13635,13636,13640,13642,13646,13647,13651,13653,13662,13664],{"type":1444,"nodeName":1461,"attributes":13601,"children":13603},{"id":13602},"page-128",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13606,"children":13607},{"class":1493},[13608,13612],{"type":1444,"nodeName":1452,"attributes":13609,"children":13610},{"href":1518},[13611],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13614},"\n\n\n   To mark a response as \"never expires,\" an origin server sends an\n   Expires date approximately one year from the time the response is\n   sent. HTTP\u002F1.1 servers SHOULD NOT send Expires dates more than one\n   year in the future.\n\n   The presence of an Expires header field with a date value of some\n   time in the future on a response that otherwise would by default be\n   non-cacheable indicates that the response is cacheable, unless\n   indicated otherwise by a Cache-Control header field (",{"type":1444,"nodeName":1452,"attributes":13616,"children":13617},{"href":3951},[13618],{"type":1449,"textContent":10784},{"type":1449,"textContent":5638},{"type":1444,"nodeName":1461,"attributes":13621,"children":13622},{"class":5228},[13623,13627],{"type":1444,"nodeName":1452,"attributes":13624,"children":13625},{"class":5220,"id":1105,"href":4245},[13626],{"type":1449,"textContent":4248},{"type":1449,"textContent":13628}," From",{"type":1449,"textContent":13630},"\n\n   The From request-header field, if given, SHOULD contain an Internet\n   e-mail address for the human user who controls the requesting user\n   agent. The address SHOULD be machine-usable, as defined by \"mailbox\"\n   in ",{"type":1444,"nodeName":1452,"attributes":13632,"children":13633},{"href":5662},[13634],{"type":1449,"textContent":5665},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":13637,"children":13638},{"href":5308},[13639],{"type":1449,"textContent":2427},{"type":1449,"textContent":13641},"] as updated by ",{"type":1444,"nodeName":1452,"attributes":13643,"children":13644},{"href":6155},[13645],{"type":1449,"textContent":6158},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":13648,"children":13649},{"href":6184},[13650],{"type":1449,"textContent":1568},{"type":1449,"textContent":13652},"]:\n\n       From   = \"From\" \":\" mailbox\n\n   An example is:\n\n       From: webmaster@w3.org\n\n   This header field MAY be used for logging purposes and as a means for\n   identifying the source of invalid or unwanted requests. It SHOULD NOT\n   be used as an insecure form of access protection. The interpretation\n   of this field is that the request is being performed on behalf of the\n   person given, who accepts responsibility for the method performed. In\n   particular, robot agents SHOULD include this header so that the\n   person responsible for running the robot can be contacted if problems\n   occur on the receiving end.\n\n   The Internet e-mail address in this field MAY be separate from the\n   Internet host which issued the request. For example, when a request\n   is passed through a proxy the original issuer's address SHOULD be\n   used.\n\n   The client SHOULD NOT send the From header field without the user's\n   approval, as it might conflict with the user's privacy interests or\n   their site's security policy. It is strongly recommended that the\n   user be able to disable, enable, and modify the value of this field\n   at any time prior to a request.\n\n",{"type":1444,"nodeName":1461,"attributes":13654,"children":13655},{"class":5228},[13656,13660],{"type":1444,"nodeName":1452,"attributes":13657,"children":13658},{"class":5220,"id":1110,"href":4286},[13659],{"type":1449,"textContent":4289},{"type":1449,"textContent":13661}," Host",{"type":1449,"textContent":13663},"\n\n   The Host request-header field specifies the Internet host and port\n   number of the resource being requested, as obtained from the original\n   URI given by the user or referring resource (generally an HTTP URL,\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13665,"children":13666},{"class":1493},[13667],{"type":1449,"textContent":13668},"Fielding, et al.            Standards Track                   [Page 128]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13671,"children":13672},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13674,"children":13675},{"class":1506},[13676,13680,13681,13689,13691,13696,13698,13703,13705,13710,13712,13716,13717,13722,13724,13733,13735,13739,13741],{"type":1444,"nodeName":1461,"attributes":13677,"children":13679},{"id":13678},"page-129",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13682,"children":13683},{"class":1493},[13684,13688],{"type":1444,"nodeName":1452,"attributes":13685,"children":13686},{"href":1518},[13687],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13690},"\n\n\n   as described in ",{"type":1444,"nodeName":1452,"attributes":13692,"children":13693},{"href":1701},[13694],{"type":1449,"textContent":13695},"section 3.2.2",{"type":1449,"textContent":13697},"). The Host field value MUST represent\n   the naming authority of the origin server or gateway given by the\n   original URL. This allows the origin server or gateway to\n   differentiate between internally-ambiguous URLs, such as the root \"\u002F\"\n   URL of a server for multiple host names on a single IP address.\n\n       Host = \"Host\" \":\" host [ \":\" port ] ; ",{"type":1444,"nodeName":1452,"attributes":13699,"children":13700},{"href":1701},[13701],{"type":1449,"textContent":13702},"Section 3.2.2",{"type":1449,"textContent":13704},"\n\n   A \"host\" without any trailing port information implies the default\n   port for the service requested (e.g., \"80\" for an HTTP URL). For\n   example, a request on the origin server for\n   \u003C",{"type":1444,"nodeName":1452,"attributes":13706,"children":13708},{"href":13707},"http:\u002F\u002Fwww.w3.org\u002Fpub\u002FWWW\u002F",[13709],{"type":1449,"textContent":13707},{"type":1449,"textContent":13711},"> would properly include:\n\n       GET \u002Fpub\u002FWWW\u002F HTTP\u002F1.1\n       Host: www.w3.org\n\n   A client MUST include a Host header field in all HTTP\u002F1.1 request\n   messages . If the requested URI does not include an Internet host\n   name for the service being requested, then the Host header field MUST\n   be given with an empty value. An HTTP\u002F1.1 proxy MUST ensure that any\n   request message it forwards does contain an appropriate Host header\n   field that identifies the service being requested by the proxy. All\n   Internet-based HTTP\u002F1.1 servers MUST respond with a 400 (Bad Request)\n   status code to any HTTP\u002F1.1 request message which lacks a Host header\n   field.\n\n   See sections ",{"type":1444,"nodeName":1452,"attributes":13713,"children":13714},{"href":2098},[13715],{"type":1449,"textContent":2101},{"type":1449,"textContent":6839},{"type":1444,"nodeName":1452,"attributes":13718,"children":13719},{"href":7707},[13720],{"type":1449,"textContent":13721},"19.6.1.1",{"type":1449,"textContent":13723}," for other requirements relating to\n   Host.\n\n",{"type":1444,"nodeName":1461,"attributes":13725,"children":13726},{"class":5228},[13727,13731],{"type":1444,"nodeName":1452,"attributes":13728,"children":13729},{"class":5220,"id":1115,"href":4299},[13730],{"type":1449,"textContent":4302},{"type":1449,"textContent":13732}," If-Match",{"type":1449,"textContent":13734},"\n\n   The If-Match request-header field is used with a method to make it\n   conditional. A client that has one or more entities previously\n   obtained from the resource can verify that one of those entities is\n   current by including a list of their associated entity tags in the\n   If-Match header field. Entity tags are defined in ",{"type":1444,"nodeName":1452,"attributes":13736,"children":13737},{"href":1929},[13738],{"type":1449,"textContent":11340},{"type":1449,"textContent":13740},". The\n   purpose of this feature is to allow efficient updates of cached\n   information with a minimum amount of transaction overhead. It is also\n   used, on updating requests, to prevent inadvertent modification of\n   the wrong version of a resource. As a special case, the value \"*\"\n   matches any current entity of the resource.\n\n       If-Match = \"If-Match\" \":\" ( \"*\" | 1#entity-tag )\n\n   If any of the entity tags match the entity tag of the entity that\n   would have been returned in the response to a similar GET request\n   (without the If-Match header) on that resource, or if \"*\" is given\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13742,"children":13743},{"class":1493},[13744],{"type":1449,"textContent":13745},"Fielding, et al.            Standards Track                   [Page 129]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13748,"children":13749},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13751,"children":13752},{"class":1506},[13753,13757,13758,13766,13768,13772,13774,13778,13780,13789,13791],{"type":1444,"nodeName":1461,"attributes":13754,"children":13756},{"id":13755},"page-130",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13759,"children":13760},{"class":1493},[13761,13765],{"type":1444,"nodeName":1452,"attributes":13762,"children":13763},{"href":1518},[13764],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13767},"\n\n\n   and any current entity exists for that resource, then the server MAY\n   perform the requested method as if the If-Match header field did not\n   exist.\n\n   A server MUST use the strong comparison function (see ",{"type":1444,"nodeName":1452,"attributes":13769,"children":13770},{"href":3596},[13771],{"type":1449,"textContent":7013},{"type":1449,"textContent":13773},")\n   to compare the entity tags in If-Match.\n\n   If none of the entity tags match, or if \"*\" is given and no current\n   entity exists, the server MUST NOT perform the requested method, and\n   MUST return a 412 (Precondition Failed) response. This behavior is\n   most useful when the client wants to prevent an updating method, such\n   as PUT, from modifying a resource that has changed since the client\n   last retrieved it.\n\n   If the request would, without the If-Match header field, result in\n   anything other than a 2xx or 412 status, then the If-Match header\n   MUST be ignored.\n\n   The meaning of \"If-Match: *\" is that the method SHOULD be performed\n   if the representation selected by the origin server (or by a cache,\n   possibly using the Vary mechanism, see ",{"type":1444,"nodeName":1452,"attributes":13775,"children":13776},{"href":4617},[13777],{"type":1449,"textContent":10607},{"type":1449,"textContent":13779},") exists, and\n   MUST NOT be performed if the representation does not exist.\n\n   A request intended to update a resource (e.g., a PUT) MAY include an\n   If-Match header field to signal that the request method MUST NOT be\n   applied if the entity corresponding to the If-Match value (a single\n   entity tag) is no longer a representation of that resource. This\n   allows the user to indicate that they do not wish the request to be\n   successful if the resource has been changed without their knowledge.\n   Examples:\n\n       If-Match: \"xyzzy\"\n       If-Match: \"xyzzy\", \"r2d2xxxx\", \"c3piozzzz\"\n       If-Match: *\n\n   The result of a request having both an If-Match header field and\n   either an If-None-Match or an If-Modified-Since header fields is\n   undefined by this specification.\n\n",{"type":1444,"nodeName":1461,"attributes":13781,"children":13782},{"class":5228},[13783,13787],{"type":1444,"nodeName":1452,"attributes":13784,"children":13785},{"class":5220,"id":1120,"href":4314},[13786],{"type":1449,"textContent":4317},{"type":1449,"textContent":13788}," If-Modified-Since",{"type":1449,"textContent":13790},"\n\n   The If-Modified-Since request-header field is used with a method to\n   make it conditional: if the requested variant has not been modified\n   since the time specified in this field, an entity will not be\n   returned from the server; instead, a 304 (not modified) response will\n   be returned without any message-body.\n\n       If-Modified-Since = \"If-Modified-Since\" \":\" HTTP-date\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13792,"children":13793},{"class":1493},[13794],{"type":1449,"textContent":13795},"Fielding, et al.            Standards Track                   [Page 130]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13798,"children":13799},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13801,"children":13802},{"class":1506},[13803,13807,13808,13816,13818,13822,13824],{"type":1444,"nodeName":1461,"attributes":13804,"children":13806},{"id":13805},"page-131",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13809,"children":13810},{"class":1493},[13811,13815],{"type":1444,"nodeName":1452,"attributes":13812,"children":13813},{"href":1518},[13814],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13817},"\n\n\n   An example of the field is:\n\n       If-Modified-Since: Sat, 29 Oct 1994 19:43:31 GMT\n\n   A GET method with an If-Modified-Since header and no Range header\n   requests that the identified entity be transferred only if it has\n   been modified since the date given by the If-Modified-Since header.\n   The algorithm for determining this includes the following cases:\n\n      a) If the request would normally result in anything other than a\n         200 (OK) status, or if the passed If-Modified-Since date is\n         invalid, the response is exactly the same as for a normal GET.\n         A date which is later than the server's current time is\n         invalid.\n\n      b) If the variant has been modified since the If-Modified-Since\n         date, the response is exactly the same as for a normal GET.\n\n      c) If the variant has not been modified since a valid If-\n         Modified-Since date, the server SHOULD return a 304 (Not\n         Modified) response.\n\n   The purpose of this feature is to allow efficient updates of cached\n   information with a minimum amount of transaction overhead.\n\n      Note: The Range request-header field modifies the meaning of If-\n      Modified-Since; see ",{"type":1444,"nodeName":1452,"attributes":13819,"children":13820},{"href":4458},[13821],{"type":1449,"textContent":7031},{"type":1449,"textContent":13823}," for full details.\n\n      Note: If-Modified-Since times are interpreted by the server, whose\n      clock might not be synchronized with the client.\n\n      Note: When handling an If-Modified-Since header field, some\n      servers will use an exact date comparison function, rather than a\n      less-than function, for deciding whether to send a 304 (Not\n      Modified) response. To get best results when sending an If-\n      Modified-Since header field for cache validation, clients are\n      advised to use the exact date string received in a previous Last-\n      Modified header field whenever possible.\n\n      Note: If a client uses an arbitrary date in the If-Modified-Since\n      header instead of a date taken from the Last-Modified header for\n      the same request, the client should be aware of the fact that this\n      date is interpreted in the server's understanding of time. The\n      client should consider unsynchronized clocks and rounding problems\n      due to the different encodings of time between the client and\n      server. This includes the possibility of race conditions if the\n      document has changed between the time it was first requested and\n      the If-Modified-Since date of a subsequent request, and the\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13825,"children":13826},{"class":1493},[13827],{"type":1449,"textContent":13828},"Fielding, et al.            Standards Track                   [Page 131]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13831,"children":13832},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13834,"children":13835},{"class":1506},[13836,13840,13841,13849,13851,13860,13862,13866,13868],{"type":1444,"nodeName":1461,"attributes":13837,"children":13839},{"id":13838},"page-132",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13842,"children":13843},{"class":1493},[13844,13848],{"type":1444,"nodeName":1452,"attributes":13845,"children":13846},{"href":1518},[13847],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13850},"\n\n\n      possibility of clock-skew-related problems if the If-Modified-\n      Since date is derived from the client's clock without correction\n      to the server's clock. Corrections for different time bases\n      between client and server are at best approximate due to network\n      latency.\n\n   The result of a request having both an If-Modified-Since header field\n   and either an If-Match or an If-Unmodified-Since header fields is\n   undefined by this specification.\n\n",{"type":1444,"nodeName":1461,"attributes":13852,"children":13853},{"class":5228},[13854,13858],{"type":1444,"nodeName":1452,"attributes":13855,"children":13856},{"class":5220,"id":1125,"href":4329},[13857],{"type":1449,"textContent":4332},{"type":1449,"textContent":13859}," If-None-Match",{"type":1449,"textContent":13861},"\n\n   The If-None-Match request-header field is used with a method to make\n   it conditional. A client that has one or more entities previously\n   obtained from the resource can verify that none of those entities is\n   current by including a list of their associated entity tags in the\n   If-None-Match header field. The purpose of this feature is to allow\n   efficient updates of cached information with a minimum amount of\n   transaction overhead. It is also used to prevent a method (e.g. PUT)\n   from inadvertently modifying an existing resource when the client\n   believes that the resource does not exist.\n\n   As a special case, the value \"*\" matches any current entity of the\n   resource.\n\n       If-None-Match = \"If-None-Match\" \":\" ( \"*\" | 1#entity-tag )\n\n   If any of the entity tags match the entity tag of the entity that\n   would have been returned in the response to a similar GET request\n   (without the If-None-Match header) on that resource, or if \"*\" is\n   given and any current entity exists for that resource, then the\n   server MUST NOT perform the requested method, unless required to do\n   so because the resource's modification date fails to match that\n   supplied in an If-Modified-Since header field in the request.\n   Instead, if the request method was GET or HEAD, the server SHOULD\n   respond with a 304 (Not Modified) response, including the cache-\n   related header fields (particularly ETag) of one of the entities that\n   matched. For all other request methods, the server MUST respond with\n   a status of 412 (Precondition Failed).\n\n   See ",{"type":1444,"nodeName":1452,"attributes":13863,"children":13864},{"href":3596},[13865],{"type":1449,"textContent":7013},{"type":1449,"textContent":13867}," for rules on how to determine if two entities tags\n   match. The weak comparison function can only be used with GET or HEAD\n   requests.\n\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13869,"children":13870},{"class":1493},[13871],{"type":1449,"textContent":13872},"Fielding, et al.            Standards Track                   [Page 132]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13875,"children":13876},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13878,"children":13879},{"class":1506},[13880,13884,13885,13893,13895,13900,13902,13906,13908,13917,13919],{"type":1444,"nodeName":1461,"attributes":13881,"children":13883},{"id":13882},"page-133",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13886,"children":13887},{"class":1493},[13888,13892],{"type":1444,"nodeName":1452,"attributes":13889,"children":13890},{"href":1518},[13891],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13894},"\n\n\n   If none of the entity tags match, then the server MAY perform the\n   requested method as if the If-None-Match header field did not exist,\n   but MUST also ignore any If-Modified-Since header field(s) in the\n   request. That is, if no entity tags match, then the server MUST NOT\n   return a 304 (Not Modified) response.\n\n   If the request would, without the If-None-Match header field, result\n   in anything other than a 2xx or 304 status, then the If-None-Match\n   header MUST be ignored. (See ",{"type":1444,"nodeName":1452,"attributes":13896,"children":13897},{"href":11467},[13898],{"type":1449,"textContent":13899},"section 13.3.4",{"type":1449,"textContent":13901}," for a discussion of\n   server behavior when both If-Modified-Since and If-None-Match appear\n   in the same request.)\n\n   The meaning of \"If-None-Match: *\" is that the method MUST NOT be\n   performed if the representation selected by the origin server (or by\n   a cache, possibly using the Vary mechanism, see ",{"type":1444,"nodeName":1452,"attributes":13903,"children":13904},{"href":4617},[13905],{"type":1449,"textContent":10607},{"type":1449,"textContent":13907},")\n   exists, and SHOULD be performed if the representation does not exist.\n   This feature is intended to be useful in preventing races between PUT\n   operations.\n\n   Examples:\n\n       If-None-Match: \"xyzzy\"\n       If-None-Match: W\u002F\"xyzzy\"\n       If-None-Match: \"xyzzy\", \"r2d2xxxx\", \"c3piozzzz\"\n       If-None-Match: W\u002F\"xyzzy\", W\u002F\"r2d2xxxx\", W\u002F\"c3piozzzz\"\n       If-None-Match: *\n\n   The result of a request having both an If-None-Match header field and\n   either an If-Match or an If-Unmodified-Since header fields is\n   undefined by this specification.\n\n",{"type":1444,"nodeName":1461,"attributes":13909,"children":13910},{"class":5228},[13911,13915],{"type":1444,"nodeName":1452,"attributes":13912,"children":13913},{"class":5220,"id":1130,"href":4344},[13914],{"type":1449,"textContent":4347},{"type":1449,"textContent":13916}," If-Range",{"type":1449,"textContent":13918},"\n\n   If a client has a partial copy of an entity in its cache, and wishes\n   to have an up-to-date copy of the entire entity in its cache, it\n   could use the Range request-header with a conditional GET (using\n   either or both of If-Unmodified-Since and If-Match.) However, if the\n   condition fails because the entity has been modified, the client\n   would then have to make a second request to obtain the entire current\n   entity-body.\n\n   The If-Range header allows a client to \"short-circuit\" the second\n   request. Informally, its meaning is `if the entity is unchanged, send\n   me the part(s) that I am missing; otherwise, send me the entire new\n   entity'.\n\n        If-Range = \"If-Range\" \":\" ( entity-tag | HTTP-date )\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13920,"children":13921},{"class":1493},[13922],{"type":1449,"textContent":13923},"Fielding, et al.            Standards Track                   [Page 133]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13926,"children":13927},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13929,"children":13930},{"class":1506},[13931,13935,13936,13944,13946,13955,13957,13966,13968],{"type":1444,"nodeName":1461,"attributes":13932,"children":13934},{"id":13933},"page-134",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13937,"children":13938},{"class":1493},[13939,13943],{"type":1444,"nodeName":1452,"attributes":13940,"children":13941},{"href":1518},[13942],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13945},"\n\n\n   If the client has no entity tag for an entity, but does have a Last-\n   Modified date, it MAY use that date in an If-Range header. (The\n   server can distinguish between a valid HTTP-date and any form of\n   entity-tag by examining no more than two characters.) The If-Range\n   header SHOULD only be used together with a Range header, and MUST be\n   ignored if the request does not include a Range header, or if the\n   server does not support the sub-range operation.\n\n   If the entity tag given in the If-Range header matches the current\n   entity tag for the entity, then the server SHOULD provide the\n   specified sub-range of the entity using a 206 (Partial content)\n   response. If the entity tag does not match, then the server SHOULD\n   return the entire entity using a 200 (OK) response.\n\n",{"type":1444,"nodeName":1461,"attributes":13947,"children":13948},{"class":5228},[13949,13953],{"type":1444,"nodeName":1452,"attributes":13950,"children":13951},{"class":5220,"id":1135,"href":4359},[13952],{"type":1449,"textContent":4362},{"type":1449,"textContent":13954}," If-Unmodified-Since",{"type":1449,"textContent":13956},"\n\n   The If-Unmodified-Since request-header field is used with a method to\n   make it conditional. If the requested resource has not been modified\n   since the time specified in this field, the server SHOULD perform the\n   requested operation as if the If-Unmodified-Since header were not\n   present.\n\n   If the requested variant has been modified since the specified time,\n   the server MUST NOT perform the requested operation, and MUST return\n   a 412 (Precondition Failed).\n\n      If-Unmodified-Since = \"If-Unmodified-Since\" \":\" HTTP-date\n\n   An example of the field is:\n\n       If-Unmodified-Since: Sat, 29 Oct 1994 19:43:31 GMT\n\n   If the request normally (i.e., without the If-Unmodified-Since\n   header) would result in anything other than a 2xx or 412 status, the\n   If-Unmodified-Since header SHOULD be ignored.\n\n   If the specified date is invalid, the header is ignored.\n\n   The result of a request having both an If-Unmodified-Since header\n   field and either an If-None-Match or an If-Modified-Since header\n   fields is undefined by this specification.\n\n",{"type":1444,"nodeName":1461,"attributes":13958,"children":13959},{"class":5228},[13960,13964],{"type":1444,"nodeName":1452,"attributes":13961,"children":13962},{"class":5220,"id":1140,"href":4374},[13963],{"type":1449,"textContent":4377},{"type":1449,"textContent":13965}," Last-Modified",{"type":1449,"textContent":13967},"\n\n   The Last-Modified entity-header field indicates the date and time at\n   which the origin server believes the variant was last modified.\n\n       Last-Modified  = \"Last-Modified\" \":\" HTTP-date\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":13969,"children":13970},{"class":1493},[13971],{"type":1449,"textContent":13972},"Fielding, et al.            Standards Track                   [Page 134]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":13975,"children":13976},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":13978,"children":13979},{"class":1506},[13980,13984,13985,13993,13995,14004,14006,14011,14013,14018,14020,14025,14027],{"type":1444,"nodeName":1461,"attributes":13981,"children":13983},{"id":13982},"page-135",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":13986,"children":13987},{"class":1493},[13988,13992],{"type":1444,"nodeName":1452,"attributes":13989,"children":13990},{"href":1518},[13991],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":13994},"\n\n\n   An example of its use is\n\n       Last-Modified: Tue, 15 Nov 1994 12:45:26 GMT\n\n   The exact meaning of this header field depends on the implementation\n   of the origin server and the nature of the original resource. For\n   files, it may be just the file system last-modified time. For\n   entities with dynamically included parts, it may be the most recent\n   of the set of last-modify times for its component parts. For database\n   gateways, it may be the last-update time stamp of the record. For\n   virtual objects, it may be the last time the internal state changed.\n\n   An origin server MUST NOT send a Last-Modified date which is later\n   than the server's time of message origination. In such cases, where\n   the resource's last modification would indicate some time in the\n   future, the server MUST replace that date with the message\n   origination date.\n\n   An origin server SHOULD obtain the Last-Modified value of the entity\n   as close as possible to the time that it generates the Date value of\n   its response. This allows a recipient to make an accurate assessment\n   of the entity's modification time, especially if the entity changes\n   near the time that the response is generated.\n\n   HTTP\u002F1.1 servers SHOULD send Last-Modified whenever feasible.\n\n",{"type":1444,"nodeName":1461,"attributes":13996,"children":13997},{"class":5228},[13998,14002],{"type":1444,"nodeName":1452,"attributes":13999,"children":14000},{"class":5220,"id":1145,"href":4387},[14001],{"type":1449,"textContent":4390},{"type":1449,"textContent":14003}," Location",{"type":1449,"textContent":14005},"\n\n   The Location response-header field is used to redirect the recipient\n   to a location other than the Request-URI for completion of the\n   request or identification of a new resource. For 201 (Created)\n   responses, the Location is that of the new resource which was created\n   by the request. For 3xx responses, the location SHOULD indicate the\n   server's preferred URI for automatic redirection to the resource. The\n   field value consists of a single absolute URI.\n\n       Location       = \"Location\" \":\" absoluteURI\n\n   An example is:\n\n       Location: ",{"type":1444,"nodeName":1452,"attributes":14007,"children":14009},{"href":14008},"http:\u002F\u002Fwww.w3.org\u002Fpub\u002FWWW\u002FPeople.html",[14010],{"type":1449,"textContent":14008},{"type":1449,"textContent":14012},"\n\n      Note: The Content-Location header field (",{"type":1444,"nodeName":1452,"attributes":14014,"children":14015},{"href":4114},[14016],{"type":1449,"textContent":14017},"section 14.14",{"type":1449,"textContent":14019},") differs\n      from Location in that the Content-Location identifies the original\n      location of the entity enclosed in the request. It is therefore\n      possible for a response to contain header fields for both Location\n      and Content-Location. Also see ",{"type":1444,"nodeName":1452,"attributes":14021,"children":14022},{"href":3767},[14023],{"type":1449,"textContent":14024},"section 13.10",{"type":1449,"textContent":14026}," for cache\n      requirements of some methods.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14028,"children":14029},{"class":1493},[14030],{"type":1449,"textContent":14031},"Fielding, et al.            Standards Track                   [Page 135]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14034,"children":14035},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14037,"children":14038},{"class":1506},[14039,14043,14044,14052,14053,14062,14064,14069,14071,14076,14078,14087,14089,14093,14095],{"type":1444,"nodeName":1461,"attributes":14040,"children":14042},{"id":14041},"page-136",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14045,"children":14046},{"class":1493},[14047,14051],{"type":1444,"nodeName":1452,"attributes":14048,"children":14049},{"href":1518},[14050],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":14054,"children":14055},{"class":5228},[14056,14060],{"type":1444,"nodeName":1452,"attributes":14057,"children":14058},{"class":5220,"id":1150,"href":4402},[14059],{"type":1449,"textContent":4405},{"type":1449,"textContent":14061}," Max-Forwards",{"type":1449,"textContent":14063},"\n\n   The Max-Forwards request-header field provides a mechanism with the\n   TRACE (",{"type":1444,"nodeName":1452,"attributes":14065,"children":14066},{"href":2566},[14067],{"type":1449,"textContent":14068},"section 9.8",{"type":1449,"textContent":14070},") and OPTIONS (",{"type":1444,"nodeName":1452,"attributes":14072,"children":14073},{"href":2478},[14074],{"type":1449,"textContent":14075},"section 9.2",{"type":1449,"textContent":14077},") methods to limit the\n   number of proxies or gateways that can forward the request to the\n   next inbound server. This can be useful when the client is attempting\n   to trace a request chain which appears to be failing or looping in\n   mid-chain.\n\n       Max-Forwards   = \"Max-Forwards\" \":\" 1*DIGIT\n\n   The Max-Forwards value is a decimal integer indicating the remaining\n   number of times this request message may be forwarded.\n\n   Each proxy or gateway recipient of a TRACE or OPTIONS request\n   containing a Max-Forwards header field MUST check and update its\n   value prior to forwarding the request. If the received value is zero\n   (0), the recipient MUST NOT forward the request; instead, it MUST\n   respond as the final recipient. If the received Max-Forwards value is\n   greater than zero, then the forwarded message MUST contain an updated\n   Max-Forwards field with a value decremented by one (1).\n\n   The Max-Forwards header field MAY be ignored for all other methods\n   defined by this specification and for any extension methods for which\n   it is not explicitly referred to as part of that method definition.\n\n",{"type":1444,"nodeName":1461,"attributes":14079,"children":14080},{"class":5228},[14081,14085],{"type":1444,"nodeName":1452,"attributes":14082,"children":14083},{"class":5220,"id":1155,"href":4417},[14084],{"type":1449,"textContent":4420},{"type":1449,"textContent":14086}," Pragma",{"type":1449,"textContent":14088},"\n\n   The Pragma general-header field is used to include implementation-\n   specific directives that might apply to any recipient along the\n   request\u002Fresponse chain. All pragma directives specify optional\n   behavior from the viewpoint of the protocol; however, some systems\n   MAY require that behavior be consistent with the directives.\n\n       Pragma            = \"Pragma\" \":\" 1#pragma-directive\n       pragma-directive  = \"no-cache\" | extension-pragma\n       extension-pragma  = token [ \"=\" ( token | quoted-string ) ]\n\n   When the no-cache directive is present in a request message, an\n   application SHOULD forward the request toward the origin server even\n   if it has a cached copy of what is being requested. This pragma\n   directive has the same semantics as the no-cache cache-directive (see\n   ",{"type":1444,"nodeName":1452,"attributes":14090,"children":14091},{"href":3951},[14092],{"type":1449,"textContent":10784},{"type":1449,"textContent":14094},") and is defined here for backward compatibility with\n   HTTP\u002F1.0. Clients SHOULD include both header fields when a no-cache\n   request is sent to a server not known to be HTTP\u002F1.1 compliant.\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14096,"children":14097},{"class":1493},[14098],{"type":1449,"textContent":14099},"Fielding, et al.            Standards Track                   [Page 136]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14102,"children":14103},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14105,"children":14106},{"class":1506},[14107,14111,14112,14120,14122,14131,14133,14137,14139,14148,14150,14154,14156],{"type":1444,"nodeName":1461,"attributes":14108,"children":14110},{"id":14109},"page-137",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14113,"children":14114},{"class":1493},[14115,14119],{"type":1444,"nodeName":1452,"attributes":14116,"children":14117},{"href":1518},[14118],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14121},"\n\n\n   Pragma directives MUST be passed through by a proxy or gateway\n   application, regardless of their significance to that application,\n   since the directives might be applicable to all recipients along the\n   request\u002Fresponse chain. It is not possible to specify a pragma for a\n   specific recipient; however, any pragma directive not relevant to a\n   recipient SHOULD be ignored by that recipient.\n\n   HTTP\u002F1.1 caches SHOULD treat \"Pragma: no-cache\" as if the client had\n   sent \"Cache-Control: no-cache\". No new Pragma directives will be\n   defined in HTTP.\n\n      Note: because the meaning of \"Pragma: no-cache as a response\n      header field is not actually specified, it does not provide a\n      reliable replacement for \"Cache-Control: no-cache\" in a response\n\n",{"type":1444,"nodeName":1461,"attributes":14123,"children":14124},{"class":5228},[14125,14129],{"type":1444,"nodeName":1452,"attributes":14126,"children":14127},{"class":5220,"id":1160,"href":4430},[14128],{"type":1449,"textContent":4433},{"type":1449,"textContent":14130}," Proxy-Authenticate",{"type":1449,"textContent":14132},"\n\n   The Proxy-Authenticate response-header field MUST be included as part\n   of a 407 (Proxy Authentication Required) response. The field value\n   consists of a challenge that indicates the authentication scheme and\n   parameters applicable to the proxy for this Request-URI.\n\n       Proxy-Authenticate  = \"Proxy-Authenticate\" \":\" 1#challenge\n\n   The HTTP access authentication process is described in \"HTTP\n   Authentication: Basic and Digest Access Authentication\" [",{"type":1444,"nodeName":1452,"attributes":14134,"children":14135},{"href":10024},[14136],{"type":1449,"textContent":2248},{"type":1449,"textContent":14138},"]. Unlike\n   WWW-Authenticate, the Proxy-Authenticate header field applies only to\n   the current connection and SHOULD NOT be passed on to downstream\n   clients. However, an intermediate proxy might need to obtain its own\n   credentials by requesting them from the downstream client, which in\n   some circumstances will appear as if the proxy is forwarding the\n   Proxy-Authenticate header field.\n\n",{"type":1444,"nodeName":1461,"attributes":14140,"children":14141},{"class":5228},[14142,14146],{"type":1444,"nodeName":1452,"attributes":14143,"children":14144},{"class":5220,"id":1165,"href":4445},[14145],{"type":1449,"textContent":4448},{"type":1449,"textContent":14147}," Proxy-Authorization",{"type":1449,"textContent":14149},"\n\n   The Proxy-Authorization request-header field allows the client to\n   identify itself (or its user) to a proxy which requires\n   authentication. The Proxy-Authorization field value consists of\n   credentials containing the authentication information of the user\n   agent for the proxy and\u002For realm of the resource being requested.\n\n       Proxy-Authorization     = \"Proxy-Authorization\" \":\" credentials\n\n   The HTTP access authentication process is described in \"HTTP\n   Authentication: Basic and Digest Access Authentication\" [",{"type":1444,"nodeName":1452,"attributes":14151,"children":14152},{"href":10024},[14153],{"type":1449,"textContent":2248},{"type":1449,"textContent":14155},"] . Unlike\n   Authorization, the Proxy-Authorization header field applies only to\n   the next outbound proxy that demanded authentication using the Proxy-\n   Authenticate field. When multiple proxies are used in a chain, the\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14157,"children":14158},{"class":1493},[14159],{"type":1449,"textContent":14160},"Fielding, et al.            Standards Track                   [Page 137]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14163,"children":14164},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14166,"children":14167},{"class":1506},[14168,14172,14173,14181,14183,14192,14193,14202,14204],{"type":1444,"nodeName":1461,"attributes":14169,"children":14171},{"id":14170},"page-138",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14174,"children":14175},{"class":1493},[14176,14180],{"type":1444,"nodeName":1452,"attributes":14177,"children":14178},{"href":1518},[14179],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14182},"\n\n\n   Proxy-Authorization header field is consumed by the first outbound\n   proxy that was expecting to receive credentials. A proxy MAY relay\n   the credentials from the client request to the next proxy if that is\n   the mechanism by which the proxies cooperatively authenticate a given\n   request.\n\n",{"type":1444,"nodeName":1461,"attributes":14184,"children":14185},{"class":5228},[14186,14190],{"type":1444,"nodeName":1452,"attributes":14187,"children":14188},{"class":5220,"id":1170,"href":4458},[14189],{"type":1449,"textContent":4461},{"type":1449,"textContent":14191}," Range",{"type":1449,"textContent":5213},{"type":1444,"nodeName":1461,"attributes":14194,"children":14195},{"class":5964},[14196,14200],{"type":1444,"nodeName":1452,"attributes":14197,"children":14198},{"class":5220,"id":1176,"href":4473},[14199],{"type":1449,"textContent":4476},{"type":1449,"textContent":14201}," Byte Ranges",{"type":1449,"textContent":14203},"\n\n   Since all HTTP entities are represented in HTTP messages as sequences\n   of bytes, the concept of a byte range is meaningful for any HTTP\n   entity. (However, not all clients and servers need to support byte-\n   range operations.)\n\n   Byte range specifications in HTTP apply to the sequence of bytes in\n   the entity-body (not necessarily the same as the message-body).\n\n   A byte range operation MAY specify a single range of bytes, or a set\n   of ranges within a single entity.\n\n       ranges-specifier = byte-ranges-specifier\n       byte-ranges-specifier = bytes-unit \"=\" byte-range-set\n       byte-range-set  = 1#( byte-range-spec | suffix-byte-range-spec )\n       byte-range-spec = first-byte-pos \"-\" [last-byte-pos]\n       first-byte-pos  = 1*DIGIT\n       last-byte-pos   = 1*DIGIT\n\n   The first-byte-pos value in a byte-range-spec gives the byte-offset\n   of the first byte in a range. The last-byte-pos value gives the\n   byte-offset of the last byte in the range; that is, the byte\n   positions specified are inclusive. Byte offsets start at zero.\n\n   If the last-byte-pos value is present, it MUST be greater than or\n   equal to the first-byte-pos in that byte-range-spec, or the byte-\n   range-spec is syntactically invalid. The recipient of a byte-range-\n   set that includes one or more syntactically invalid byte-range-spec\n   values MUST ignore the header field that includes that byte-range-\n   set.\n\n   If the last-byte-pos value is absent, or if the value is greater than\n   or equal to the current length of the entity-body, last-byte-pos is\n   taken to be equal to one less than the current length of the entity-\n   body in bytes.\n\n   By its choice of last-byte-pos, a client can limit the number of\n   bytes retrieved without knowing the size of the entity.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14205,"children":14206},{"class":1493},[14207],{"type":1449,"textContent":14208},"Fielding, et al.            Standards Track                   [Page 138]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14211,"children":14212},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14214,"children":14215},{"class":1506},[14216,14220,14221,14229,14231,14240,14242],{"type":1444,"nodeName":1461,"attributes":14217,"children":14219},{"id":14218},"page-139",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14222,"children":14223},{"class":1493},[14224,14228],{"type":1444,"nodeName":1452,"attributes":14225,"children":14226},{"href":1518},[14227],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14230},"\n\n\n       suffix-byte-range-spec = \"-\" suffix-length\n       suffix-length = 1*DIGIT\n\n   A suffix-byte-range-spec is used to specify the suffix of the\n   entity-body, of a length given by the suffix-length value. (That is,\n   this form specifies the last N bytes of an entity-body.) If the\n   entity is shorter than the specified suffix-length, the entire\n   entity-body is used.\n\n   If a syntactically valid byte-range-set includes at least one byte-\n   range-spec whose first-byte-pos is less than the current length of\n   the entity-body, or at least one suffix-byte-range-spec with a non-\n   zero suffix-length, then the byte-range-set is satisfiable.\n   Otherwise, the byte-range-set is unsatisfiable. If the byte-range-set\n   is unsatisfiable, the server SHOULD return a response with a status\n   of 416 (Requested range not satisfiable). Otherwise, the server\n   SHOULD return a response with a status of 206 (Partial Content)\n   containing the satisfiable ranges of the entity-body.\n\n   Examples of byte-ranges-specifier values (assuming an entity-body of\n   length 10000):\n\n      - The first 500 bytes (byte offsets 0-499, inclusive):  bytes=0-\n        499\n\n      - The second 500 bytes (byte offsets 500-999, inclusive):\n        bytes=500-999\n\n      - The final 500 bytes (byte offsets 9500-9999, inclusive):\n        bytes=-500\n\n      - Or bytes=9500-\n\n      - The first and last bytes only (bytes 0 and 9999):  bytes=0-0,-1\n\n      - Several legal but not canonical specifications of the second 500\n        bytes (byte offsets 500-999, inclusive):\n         bytes=500-600,601-999\n         bytes=500-700,601-999\n\n",{"type":1444,"nodeName":1461,"attributes":14232,"children":14233},{"class":5964},[14234,14238],{"type":1444,"nodeName":1452,"attributes":14235,"children":14236},{"class":5220,"id":1181,"href":4486},[14237],{"type":1449,"textContent":4489},{"type":1449,"textContent":14239}," Range Retrieval Requests",{"type":1449,"textContent":14241},"\n\n   HTTP retrieval requests using conditional or unconditional GET\n   methods MAY request one or more sub-ranges of the entity, instead of\n   the entire entity, using the Range request header, which applies to\n   the entity returned as the result of the request:\n\n      Range = \"Range\" \":\" ranges-specifier\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14243,"children":14244},{"class":1493},[14245],{"type":1449,"textContent":14246},"Fielding, et al.            Standards Track                   [Page 139]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14249,"children":14250},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14252,"children":14253},{"class":1506},[14254,14258,14259,14267,14269,14273,14275,14284,14286,14291,14293],{"type":1444,"nodeName":1461,"attributes":14255,"children":14257},{"id":14256},"page-140",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14260,"children":14261},{"class":1493},[14262,14266],{"type":1444,"nodeName":1452,"attributes":14263,"children":14264},{"href":1518},[14265],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14268},"\n\n\n   A server MAY ignore the Range header. However, HTTP\u002F1.1 origin\n   servers and intermediate caches ought to support byte ranges when\n   possible, since Range supports efficient recovery from partially\n   failed transfers, and supports efficient partial retrieval of large\n   entities.\n\n   If the server supports the Range header and the specified range or\n   ranges are appropriate for the entity:\n\n      - The presence of a Range header in an unconditional GET modifies\n        what is returned if the GET is otherwise successful. In other\n        words, the response carries a status code of 206 (Partial\n        Content) instead of 200 (OK).\n\n      - The presence of a Range header in a conditional GET (a request\n        using one or both of If-Modified-Since and If-None-Match, or\n        one or both of If-Unmodified-Since and If-Match) modifies what\n        is returned if the GET is otherwise successful and the\n        condition is true. It does not affect the 304 (Not Modified)\n        response returned if the conditional is false.\n\n   In some cases, it might be more appropriate to use the If-Range\n   header (see ",{"type":1444,"nodeName":1452,"attributes":14270,"children":14271},{"href":4344},[14272],{"type":1449,"textContent":7006},{"type":1449,"textContent":14274},") in addition to the Range header.\n\n   If a proxy that supports ranges receives a Range request, forwards\n   the request to an inbound server, and receives an entire entity in\n   reply, it SHOULD only return the requested range to its client. It\n   SHOULD store the entire received response in its cache if that is\n   consistent with its cache allocation policies.\n\n",{"type":1444,"nodeName":1461,"attributes":14276,"children":14277},{"class":5228},[14278,14282],{"type":1444,"nodeName":1452,"attributes":14279,"children":14280},{"class":5220,"id":1186,"href":4501},[14281],{"type":1449,"textContent":4504},{"type":1449,"textContent":14283}," Referer",{"type":1449,"textContent":14285},"\n\n   The Referer[sic] request-header field allows the client to specify,\n   for the server's benefit, the address (URI) of the resource from\n   which the Request-URI was obtained (the \"referrer\", although the\n   header field is misspelled.) The Referer request-header allows a\n   server to generate lists of back-links to resources for interest,\n   logging, optimized caching, etc. It also allows obsolete or mistyped\n   links to be traced for maintenance. The Referer field MUST NOT be\n   sent if the Request-URI was obtained from a source that does not have\n   its own URI, such as input from the user keyboard.\n\n       Referer        = \"Referer\" \":\" ( absoluteURI | relativeURI )\n\n   Example:\n\n       Referer: ",{"type":1444,"nodeName":1452,"attributes":14287,"children":14289},{"href":14288},"http:\u002F\u002Fwww.w3.org\u002Fhypertext\u002FDataSources\u002FOverview.html",[14290],{"type":1449,"textContent":14288},{"type":1449,"textContent":14292},"\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14294,"children":14295},{"class":1493},[14296],{"type":1449,"textContent":14297},"Fielding, et al.            Standards Track                   [Page 140]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14300,"children":14301},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14303,"children":14304},{"class":1506},[14305,14309,14310,14318,14320,14324,14325,14334,14336,14345,14347,14352,14354,14358,14360],{"type":1444,"nodeName":1461,"attributes":14306,"children":14308},{"id":14307},"page-141",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14311,"children":14312},{"class":1493},[14313,14317],{"type":1444,"nodeName":1452,"attributes":14314,"children":14315},{"href":1518},[14316],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14319},"\n\n\n   If the field value is a relative URI, it SHOULD be interpreted\n   relative to the Request-URI. The URI MUST NOT include a fragment. See\n   ",{"type":1444,"nodeName":1452,"attributes":14321,"children":14322},{"href":4728},[14323],{"type":1449,"textContent":9189},{"type":1449,"textContent":9285},{"type":1444,"nodeName":1461,"attributes":14326,"children":14327},{"class":5228},[14328,14332],{"type":1444,"nodeName":1452,"attributes":14329,"children":14330},{"class":5220,"id":1191,"href":4516},[14331],{"type":1449,"textContent":4519},{"type":1449,"textContent":14333}," Retry-After",{"type":1449,"textContent":14335},"\n\n   The Retry-After response-header field can be used with a 503 (Service\n   Unavailable) response to indicate how long the service is expected to\n   be unavailable to the requesting client. This field MAY also be used\n   with any 3xx (Redirection) response to indicate the minimum time the\n   user-agent is asked wait before issuing the redirected request. The\n   value of this field can be either an HTTP-date or an integer number\n   of seconds (in decimal) after the time of the response.\n\n       Retry-After  = \"Retry-After\" \":\" ( HTTP-date | delta-seconds )\n\n   Two examples of its use are\n\n       Retry-After: Fri, 31 Dec 1999 23:59:59 GMT\n       Retry-After: 120\n\n   In the latter example, the delay is 2 minutes.\n\n",{"type":1444,"nodeName":1461,"attributes":14337,"children":14338},{"class":5228},[14339,14343],{"type":1444,"nodeName":1452,"attributes":14340,"children":14341},{"class":5220,"id":1196,"href":4531},[14342],{"type":1449,"textContent":4534},{"type":1449,"textContent":14344}," Server",{"type":1449,"textContent":14346},"\n\n   The Server response-header field contains information about the\n   software used by the origin server to handle the request. The field\n   can contain multiple product tokens (",{"type":1444,"nodeName":1452,"attributes":14348,"children":14349},{"href":1886},[14350],{"type":1449,"textContent":14351},"section 3.8",{"type":1449,"textContent":14353},") and comments\n   identifying the server and any significant subproducts. The product\n   tokens are listed in order of their significance for identifying the\n   application.\n\n       Server         = \"Server\" \":\" 1*( product | comment )\n\n   Example:\n\n       Server: CERN\u002F3.0 libwww\u002F2.17\n\n   If the response is being forwarded through a proxy, the proxy\n   application MUST NOT modify the Server response-header. Instead, it\n   SHOULD include a Via field (as described in ",{"type":1444,"nodeName":1452,"attributes":14355,"children":14356},{"href":4630},[14357],{"type":1449,"textContent":9390},{"type":1449,"textContent":14359},").\n\n      Note: Revealing the specific software version of the server might\n      allow the server machine to become more vulnerable to attacks\n      against software that is known to contain security holes. Server\n      implementors are encouraged to make this field a configurable\n      option.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14361,"children":14362},{"class":1493},[14363],{"type":1449,"textContent":14364},"Fielding, et al.            Standards Track                   [Page 141]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14367,"children":14368},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14370,"children":14371},{"class":1506},[14372,14376,14377,14385,14386,14395,14397,14401,14403,14407,14409,14413,14415,14419,14421],{"type":1444,"nodeName":1461,"attributes":14373,"children":14375},{"id":14374},"page-142",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14378,"children":14379},{"class":1493},[14380,14384],{"type":1444,"nodeName":1452,"attributes":14381,"children":14382},{"href":1518},[14383],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":14387,"children":14388},{"class":5228},[14389,14393],{"type":1444,"nodeName":1452,"attributes":14390,"children":14391},{"class":5220,"id":1201,"href":4544},[14392],{"type":1449,"textContent":4547},{"type":1449,"textContent":14394}," TE",{"type":1449,"textContent":14396},"\n\n   The TE request-header field indicates what extension transfer-codings\n   it is willing to accept in the response and whether or not it is\n   willing to accept trailer fields in a chunked transfer-coding. Its\n   value may consist of the keyword \"trailers\" and\u002For a comma-separated\n   list of extension transfer-coding names with optional accept\n   parameters (as described in ",{"type":1444,"nodeName":1452,"attributes":14398,"children":14399},{"href":1813},[14400],{"type":1449,"textContent":6699},{"type":1449,"textContent":14402},").\n\n       TE        = \"TE\" \":\" #( t-codings )\n       t-codings = \"trailers\" | ( transfer-extension [ accept-params ] )\n\n   The presence of the keyword \"trailers\" indicates that the client is\n   willing to accept trailer fields in a chunked transfer-coding, as\n   defined in ",{"type":1444,"nodeName":1452,"attributes":14404,"children":14405},{"href":1828},[14406],{"type":1449,"textContent":6567},{"type":1449,"textContent":14408},". This keyword is reserved for use with\n   transfer-coding values even though it does not itself represent a\n   transfer-coding.\n\n   Examples of its use are:\n\n       TE: deflate\n       TE:\n       TE: trailers, deflate;q=0.5\n\n   The TE header field only applies to the immediate connection.\n   Therefore, the keyword MUST be supplied within a Connection header\n   field (",{"type":1444,"nodeName":1452,"attributes":14410,"children":14411},{"href":4056},[14412],{"type":1449,"textContent":8684},{"type":1449,"textContent":14414},") whenever TE is present in an HTTP\u002F1.1 message.\n\n   A server tests whether a transfer-coding is acceptable, according to\n   a TE field, using these rules:\n\n      1. The \"chunked\" transfer-coding is always acceptable. If the\n         keyword \"trailers\" is listed, the client indicates that it is\n         willing to accept trailer fields in the chunked response on\n         behalf of itself and any downstream clients. The implication is\n         that, if given, the client is stating that either all\n         downstream clients are willing to accept trailer fields in the\n         forwarded response, or that it will attempt to buffer the\n         response on behalf of downstream recipients.\n\n         Note: HTTP\u002F1.1 does not define any means to limit the size of a\n         chunked response such that a client can be assured of buffering\n         the entire response.\n\n      2. If the transfer-coding being tested is one of the transfer-\n         codings listed in the TE field, then it is acceptable unless it\n         is accompanied by a qvalue of 0. (As defined in ",{"type":1444,"nodeName":1452,"attributes":14416,"children":14417},{"href":1901},[14418],{"type":1449,"textContent":12112},{"type":1449,"textContent":14420},", a\n         qvalue of 0 means \"not acceptable.\")\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14422,"children":14423},{"class":1493},[14424],{"type":1449,"textContent":14425},"Fielding, et al.            Standards Track                   [Page 142]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14428,"children":14429},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14431,"children":14432},{"class":1506},[14433,14437,14438,14446,14448,14457,14459,14463,14465,14474,14476,14480,14482],{"type":1444,"nodeName":1461,"attributes":14434,"children":14436},{"id":14435},"page-143",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14439,"children":14440},{"class":1493},[14441,14445],{"type":1444,"nodeName":1452,"attributes":14442,"children":14443},{"href":1518},[14444],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14447},"\n\n\n      3. If multiple transfer-codings are acceptable, then the\n         acceptable transfer-coding with the highest non-zero qvalue is\n         preferred.  The \"chunked\" transfer-coding always has a qvalue\n         of 1.\n\n   If the TE field-value is empty or if no TE field is present, the only\n   transfer-coding  is \"chunked\". A message with no transfer-coding is\n   always acceptable.\n\n",{"type":1444,"nodeName":1461,"attributes":14449,"children":14450},{"class":5228},[14451,14455],{"type":1444,"nodeName":1452,"attributes":14452,"children":14453},{"class":5220,"id":1206,"href":4559},[14454],{"type":1449,"textContent":4562},{"type":1449,"textContent":14456}," Trailer",{"type":1449,"textContent":14458},"\n\n   The Trailer general field value indicates that the given set of\n   header fields is present in the trailer of a message encoded with\n   chunked transfer-coding.\n\n       Trailer  = \"Trailer\" \":\" 1#field-name\n\n   An HTTP\u002F1.1 message SHOULD include a Trailer header field in a\n   message using chunked transfer-coding with a non-empty trailer. Doing\n   so allows the recipient to know which header fields to expect in the\n   trailer.\n\n   If no Trailer header field is present, the trailer SHOULD NOT include\n   any header fields. See ",{"type":1444,"nodeName":1452,"attributes":14460,"children":14461},{"href":1828},[14462],{"type":1449,"textContent":6567},{"type":1449,"textContent":14464}," for restrictions on the use of\n   trailer fields in a \"chunked\" transfer-coding.\n\n   Message header fields listed in the Trailer header field MUST NOT\n   include the following header fields:\n\n      . Transfer-Encoding\n\n      . Content-Length\n\n      . Trailer\n\n",{"type":1444,"nodeName":1461,"attributes":14466,"children":14467},{"class":5228},[14468,14472],{"type":1444,"nodeName":1452,"attributes":14469,"children":14470},{"class":5220,"id":1211,"href":4574},[14471],{"type":1449,"textContent":4577},{"type":1449,"textContent":14473}," Transfer-Encoding",{"type":1449,"textContent":14475},"\n\n   The Transfer-Encoding general-header field indicates what (if any)\n   type of transformation has been applied to the message body in order\n   to safely transfer it between the sender and the recipient. This\n   differs from the content-coding in that the transfer-coding is a\n   property of the message, not of the entity.\n\n     Transfer-Encoding       = \"Transfer-Encoding\" \":\" 1#transfer-coding\n\n   Transfer-codings are defined in ",{"type":1444,"nodeName":1452,"attributes":14477,"children":14478},{"href":1813},[14479],{"type":1449,"textContent":6699},{"type":1449,"textContent":14481},". An example is:\n\n     Transfer-Encoding: chunked\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14483,"children":14484},{"class":1493},[14485],{"type":1449,"textContent":14486},"Fielding, et al.            Standards Track                   [Page 143]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14489,"children":14490},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14492,"children":14493},{"class":1506},[14494,14498,14499,14507,14509,14518,14520,14524,14526],{"type":1444,"nodeName":1461,"attributes":14495,"children":14497},{"id":14496},"page-144",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14500,"children":14501},{"class":1493},[14502,14506],{"type":1444,"nodeName":1452,"attributes":14503,"children":14504},{"href":1518},[14505],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14508},"\n\n\n   If multiple encodings have been applied to an entity, the transfer-\n   codings MUST be listed in the order in which they were applied.\n   Additional information about the encoding parameters MAY be provided\n   by other entity-header fields not defined by this specification.\n\n   Many older HTTP\u002F1.0 applications do not understand the Transfer-\n   Encoding header.\n\n",{"type":1444,"nodeName":1461,"attributes":14510,"children":14511},{"class":5228},[14512,14516],{"type":1444,"nodeName":1452,"attributes":14513,"children":14514},{"class":5220,"id":1216,"href":4587},[14515],{"type":1449,"textContent":4590},{"type":1449,"textContent":14517}," Upgrade",{"type":1449,"textContent":14519},"\n\n   The Upgrade general-header allows the client to specify what\n   additional communication protocols it supports and would like to use\n   if the server finds it appropriate to switch protocols. The server\n   MUST use the Upgrade header field within a 101 (Switching Protocols)\n   response to indicate which protocol(s) are being switched.\n\n       Upgrade        = \"Upgrade\" \":\" 1#product\n\n   For example,\n\n       Upgrade: HTTP\u002F2.0, SHTTP\u002F1.3, IRC\u002F6.9, RTA\u002Fx11\n\n   The Upgrade header field is intended to provide a simple mechanism\n   for transition from HTTP\u002F1.1 to some other, incompatible protocol. It\n   does so by allowing the client to advertise its desire to use another\n   protocol, such as a later version of HTTP with a higher major version\n   number, even though the current request has been made using HTTP\u002F1.1.\n   This eases the difficult transition between incompatible protocols by\n   allowing the client to initiate a request in the more commonly\n   supported protocol while indicating to the server that it would like\n   to use a \"better\" protocol if available (where \"better\" is determined\n   by the server, possibly according to the nature of the method and\u002For\n   resource being requested).\n\n   The Upgrade header field only applies to switching application-layer\n   protocols upon the existing transport-layer connection. Upgrade\n   cannot be used to insist on a protocol change; its acceptance and use\n   by the server is optional. The capabilities and nature of the\n   application-layer communication after the protocol change is entirely\n   dependent upon the new protocol chosen, although the first action\n   after changing the protocol MUST be a response to the initial HTTP\n   request containing the Upgrade header field.\n\n   The Upgrade header field only applies to the immediate connection.\n   Therefore, the upgrade keyword MUST be supplied within a Connection\n   header field (",{"type":1444,"nodeName":1452,"attributes":14521,"children":14522},{"href":4056},[14523],{"type":1449,"textContent":8684},{"type":1449,"textContent":14525},") whenever Upgrade is present in an\n   HTTP\u002F1.1 message.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14527,"children":14528},{"class":1493},[14529],{"type":1449,"textContent":14530},"Fielding, et al.            Standards Track                   [Page 144]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14533,"children":14534},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14536,"children":14537},{"class":1506},[14538,14542,14543,14551,14553,14558,14560,14569,14571,14575,14577,14586,14588,14592,14594],{"type":1444,"nodeName":1461,"attributes":14539,"children":14541},{"id":14540},"page-145",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14544,"children":14545},{"class":1493},[14546,14550],{"type":1444,"nodeName":1452,"attributes":14547,"children":14548},{"href":1518},[14549],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14552},"\n\n\n   The Upgrade header field cannot be used to indicate a switch to a\n   protocol on a different connection. For that purpose, it is more\n   appropriate to use a 301, 302, 303, or 305 redirection response.\n\n   This specification only defines the protocol name \"HTTP\" for use by\n   the family of Hypertext Transfer Protocols, as defined by the HTTP\n   version rules of ",{"type":1444,"nodeName":1452,"attributes":14554,"children":14555},{"href":1658},[14556],{"type":1449,"textContent":14557},"section 3.1",{"type":1449,"textContent":14559}," and future updates to this\n   specification. Any token can be used as a protocol name; however, it\n   will only be useful if both the client and server associate the name\n   with the same protocol.\n\n",{"type":1444,"nodeName":1461,"attributes":14561,"children":14562},{"class":5228},[14563,14567],{"type":1444,"nodeName":1452,"attributes":14564,"children":14565},{"class":5220,"id":1221,"href":4602},[14566],{"type":1449,"textContent":4605},{"type":1449,"textContent":14568}," User-Agent",{"type":1449,"textContent":14570},"\n\n   The User-Agent request-header field contains information about the\n   user agent originating the request. This is for statistical purposes,\n   the tracing of protocol violations, and automated recognition of user\n   agents for the sake of tailoring responses to avoid particular user\n   agent limitations. User agents SHOULD include this field with\n   requests. The field can contain multiple product tokens (",{"type":1444,"nodeName":1452,"attributes":14572,"children":14573},{"href":1886},[14574],{"type":1449,"textContent":14351},{"type":1449,"textContent":14576},")\n   and comments identifying the agent and any subproducts which form a\n   significant part of the user agent. By convention, the product tokens\n   are listed in order of their significance for identifying the\n   application.\n\n       User-Agent     = \"User-Agent\" \":\" 1*( product | comment )\n\n   Example:\n\n       User-Agent: CERN-LineMode\u002F2.15 libwww\u002F2.17b3\n\n",{"type":1444,"nodeName":1461,"attributes":14578,"children":14579},{"class":5228},[14580,14584],{"type":1444,"nodeName":1452,"attributes":14581,"children":14582},{"class":5220,"id":1226,"href":4617},[14583],{"type":1449,"textContent":4620},{"type":1449,"textContent":14585}," Vary",{"type":1449,"textContent":14587},"\n\n   The Vary field value indicates the set of request-header fields that\n   fully determines, while the response is fresh, whether a cache is\n   permitted to use the response to reply to a subsequent request\n   without revalidation. For uncacheable or stale responses, the Vary\n   field value advises the user agent about the criteria that were used\n   to select the representation. A Vary field value of \"*\" implies that\n   a cache cannot determine from the request headers of a subsequent\n   request whether this response is the appropriate representation. See\n   ",{"type":1444,"nodeName":1452,"attributes":14589,"children":14590},{"href":3711},[14591],{"type":1449,"textContent":10600},{"type":1449,"textContent":14593}," for use of the Vary header field by caches.\n\n       Vary  = \"Vary\" \":\" ( \"*\" | 1#field-name )\n\n   An HTTP\u002F1.1 server SHOULD include a Vary header field with any\n   cacheable response that is subject to server-driven negotiation.\n   Doing so allows a cache to properly interpret future requests on that\n   resource and informs the user agent about the presence of negotiation\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14595,"children":14596},{"class":1493},[14597],{"type":1449,"textContent":14598},"Fielding, et al.            Standards Track                   [Page 145]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14601,"children":14602},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14604,"children":14605},{"class":1506},[14606,14610,14611,14619,14621,14630,14632,14636,14637,14641,14643],{"type":1444,"nodeName":1461,"attributes":14607,"children":14609},{"id":14608},"page-146",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14612,"children":14613},{"class":1493},[14614,14618],{"type":1444,"nodeName":1452,"attributes":14615,"children":14616},{"href":1518},[14617],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14620},"\n\n\n   on that resource. A server MAY include a Vary header field with a\n   non-cacheable response that is subject to server-driven negotiation,\n   since this might provide the user agent with useful information about\n   the dimensions over which the response varies at the time of the\n   response.\n\n   A Vary field value consisting of a list of field-names signals that\n   the representation selected for the response is based on a selection\n   algorithm which considers ONLY the listed request-header field values\n   in selecting the most appropriate representation. A cache MAY assume\n   that the same selection will be made for future requests with the\n   same values for the listed field names, for the duration of time for\n   which the response is fresh.\n\n   The field-names given are not limited to the set of standard\n   request-header fields defined by this specification. Field names are\n   case-insensitive.\n\n   A Vary field value of \"*\" signals that unspecified parameters not\n   limited to the request-headers (e.g., the network address of the\n   client), play a role in the selection of the response representation.\n   The \"*\" value MUST NOT be generated by a proxy server; it may only be\n   generated by an origin server.\n\n",{"type":1444,"nodeName":1461,"attributes":14622,"children":14623},{"class":5228},[14624,14628],{"type":1444,"nodeName":1452,"attributes":14625,"children":14626},{"class":5220,"id":1231,"href":4630},[14627],{"type":1449,"textContent":4633},{"type":1449,"textContent":14629},"  Via",{"type":1449,"textContent":14631},"\n\n   The Via general-header field MUST be used by gateways and proxies to\n   indicate the intermediate protocols and recipients between the user\n   agent and the server on requests, and between the origin server and\n   the client on responses. It is analogous to the \"Received\" field of\n   ",{"type":1444,"nodeName":1452,"attributes":14633,"children":14634},{"href":5662},[14635],{"type":1449,"textContent":5665},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":14638,"children":14639},{"href":5308},[14640],{"type":1449,"textContent":2427},{"type":1449,"textContent":14642},"] and is intended to be used for tracking message forwards,\n   avoiding request loops, and identifying the protocol capabilities of\n   all senders along the request\u002Fresponse chain.\n\n      Via =  \"Via\" \":\" 1#( received-protocol received-by [ comment ] )\n      received-protocol = [ protocol-name \"\u002F\" ] protocol-version\n      protocol-name     = token\n      protocol-version  = token\n      received-by       = ( host [ \":\" port ] ) | pseudonym\n      pseudonym         = token\n\n   The received-protocol indicates the protocol version of the message\n   received by the server or client along each segment of the\n   request\u002Fresponse chain. The received-protocol version is appended to\n   the Via field value when the message is forwarded so that information\n   about the protocol capabilities of upstream applications remains\n   visible to all recipients.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14644,"children":14645},{"class":1493},[14646],{"type":1449,"textContent":14647},"Fielding, et al.            Standards Track                   [Page 146]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14650,"children":14651},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14653,"children":14654},{"class":1506},[14655,14659,14660,14668,14670],{"type":1444,"nodeName":1461,"attributes":14656,"children":14658},{"id":14657},"page-147",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14661,"children":14662},{"class":1493},[14663,14667],{"type":1444,"nodeName":1452,"attributes":14664,"children":14665},{"href":1518},[14666],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14669},"\n\n\n   The protocol-name is optional if and only if it would be \"HTTP\". The\n   received-by field is normally the host and optional port number of a\n   recipient server or client that subsequently forwarded the message.\n   However, if the real host is considered to be sensitive information,\n   it MAY be replaced by a pseudonym. If the port is not given, it MAY\n   be assumed to be the default port of the received-protocol.\n\n   Multiple Via field values represents each proxy or gateway that has\n   forwarded the message. Each recipient MUST append its information\n   such that the end result is ordered according to the sequence of\n   forwarding applications.\n\n   Comments MAY be used in the Via header field to identify the software\n   of the recipient proxy or gateway, analogous to the User-Agent and\n   Server header fields. However, all comments in the Via field are\n   optional and MAY be removed by any recipient prior to forwarding the\n   message.\n\n   For example, a request message could be sent from an HTTP\u002F1.0 user\n   agent to an internal proxy code-named \"fred\", which uses HTTP\u002F1.1 to\n   forward the request to a public proxy at nowhere.com, which completes\n   the request by forwarding it to the origin server at www.ics.uci.edu.\n   The request received by www.ics.uci.edu would then have the following\n   Via header field:\n\n       Via: 1.0 fred, 1.1 nowhere.com (Apache\u002F1.1)\n\n   Proxies and gateways used as a portal through a network firewall\n   SHOULD NOT, by default, forward the names and ports of hosts within\n   the firewall region. This information SHOULD only be propagated if\n   explicitly enabled. If not enabled, the received-by host of any host\n   behind the firewall SHOULD be replaced by an appropriate pseudonym\n   for that host.\n\n   For organizations that have strong privacy requirements for hiding\n   internal structures, a proxy MAY combine an ordered subsequence of\n   Via header field entries with identical received-protocol values into\n   a single such entry. For example,\n\n       Via: 1.0 ricky, 1.1 ethel, 1.1 fred, 1.0 lucy\n\n        could be collapsed to\n\n       Via: 1.0 ricky, 1.1 mertz, 1.0 lucy\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14671,"children":14672},{"class":1493},[14673],{"type":1449,"textContent":14674},"Fielding, et al.            Standards Track                   [Page 147]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14677,"children":14678},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14680,"children":14681},{"class":1506},[14682,14686,14687,14695,14697,14706,14708,14712,14713,14717,14719],{"type":1444,"nodeName":1461,"attributes":14683,"children":14685},{"id":14684},"page-148",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14688,"children":14689},{"class":1493},[14690,14694],{"type":1444,"nodeName":1452,"attributes":14691,"children":14692},{"href":1518},[14693],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14696},"\n\n\n   Applications SHOULD NOT combine multiple entries unless they are all\n   under the same organizational control and the hosts have already been\n   replaced by pseudonyms. Applications MUST NOT combine entries which\n   have different received-protocol values.\n\n",{"type":1444,"nodeName":1461,"attributes":14698,"children":14699},{"class":5228},[14700,14704],{"type":1444,"nodeName":1452,"attributes":14701,"children":14702},{"class":5220,"id":1236,"href":4645},[14703],{"type":1449,"textContent":4648},{"type":1449,"textContent":14705}," Warning",{"type":1449,"textContent":14707},"\n\n   The Warning general-header field is used to carry additional\n   information about the status or transformation of a message which\n   might not be reflected in the message. This information is typically\n   used to warn about a possible lack of semantic transparency from\n   caching operations or transformations applied to the entity body of\n   the message.\n\n   Warning headers are sent with responses using:\n\n       Warning    = \"Warning\" \":\" 1#warning-value\n\n       warning-value = warn-code SP warn-agent SP warn-text\n                                             [SP warn-date]\n\n       warn-code  = 3DIGIT\n       warn-agent = ( host [ \":\" port ] ) | pseudonym\n                       ; the name or pseudonym of the server adding\n                       ; the Warning header, for use in debugging\n       warn-text  = quoted-string\n       warn-date  = \u003C\"> HTTP-date \u003C\">\n\n   A response MAY carry more than one Warning header.\n\n   The warn-text SHOULD be in a natural language and character set that\n   is most likely to be intelligible to the human user receiving the\n   response. This decision MAY be based on any available knowledge, such\n   as the location of the cache or user, the Accept-Language field in a\n   request, the Content-Language field in a response, etc. The default\n   language is English and the default character set is ISO-8859-1.\n\n   If a character set other than ISO-8859-1 is used, it MUST be encoded\n   in the warn-text using the method described in ",{"type":1444,"nodeName":1452,"attributes":14709,"children":14710},{"href":5769},[14711],{"type":1449,"textContent":5772},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":14714,"children":14715},{"href":5777},[14716],{"type":1449,"textContent":1611},{"type":1449,"textContent":14718},"].\n\n   Warning headers can in general be applied to any message, however\n   some specific warn-codes are specific to caches and can only be\n   applied to response messages. New Warning headers SHOULD be added\n   after any existing Warning headers. A cache MUST NOT delete any\n   Warning header that it received with a message. However, if a cache\n   successfully validates a cache entry, it SHOULD remove any Warning\n   headers previously attached to that entry except as specified for\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14720,"children":14721},{"class":1493},[14722],{"type":1449,"textContent":14723},"Fielding, et al.            Standards Track                   [Page 148]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14726,"children":14727},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14729,"children":14730},{"class":1506},[14731,14735,14736,14744,14746,14751,14753],{"type":1444,"nodeName":1461,"attributes":14732,"children":14734},{"id":14733},"page-149",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14737,"children":14738},{"class":1493},[14739,14743],{"type":1444,"nodeName":1452,"attributes":14740,"children":14741},{"href":1518},[14742],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14745},"\n\n\n   specific Warning codes. It MUST then add any Warning headers received\n   in the validating response. In other words, Warning headers are those\n   that would be attached to the most recent relevant response.\n\n   When multiple Warning headers are attached to a response, the user\n   agent ought to inform the user of as many of them as possible, in the\n   order that they appear in the response. If it is not possible to\n   inform the user of all of the warnings, the user agent SHOULD follow\n   these heuristics:\n\n      - Warnings that appear early in the response take priority over\n        those appearing later in the response.\n\n      - Warnings in the user's preferred character set take priority\n        over warnings in other character sets but with identical warn-\n        codes and warn-agents.\n\n   Systems that generate multiple Warning headers SHOULD order them with\n   this user agent behavior in mind.\n\n   Requirements for the behavior of caches with respect to Warnings are\n   stated in ",{"type":1444,"nodeName":1452,"attributes":14747,"children":14748},{"href":3357},[14749],{"type":1449,"textContent":14750},"section 13.1.2",{"type":1449,"textContent":14752},".\n\n   This is a list of the currently-defined warn-codes, each with a\n   recommended warn-text in English, and a description of its meaning.\n\n   110 Response is stale\n     MUST be included whenever the returned response is stale.\n\n   111 Revalidation failed\n     MUST be included if a cache returns a stale response because an\n     attempt to revalidate the response failed, due to an inability to\n     reach the server.\n\n   112 Disconnected operation\n     SHOULD be included if the cache is intentionally disconnected from\n     the rest of the network for a period of time.\n\n   113 Heuristic expiration\n     MUST be included if the cache heuristically chose a freshness\n     lifetime greater than 24 hours and the response's age is greater\n     than 24 hours.\n\n   199 Miscellaneous warning\n     The warning text MAY include arbitrary information to be presented\n     to a human user, or logged. A system receiving this warning MUST\n     NOT take any automated action, besides presenting the warning to\n     the user.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14754,"children":14755},{"class":1493},[14756],{"type":1449,"textContent":14757},"Fielding, et al.            Standards Track                   [Page 149]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14760,"children":14761},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14763,"children":14764},{"class":1506},[14765,14769,14770,14778,14780,14789,14791,14795,14797,14806,14808],{"type":1444,"nodeName":1461,"attributes":14766,"children":14768},{"id":14767},"page-150",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14771,"children":14772},{"class":1493},[14773,14777],{"type":1444,"nodeName":1452,"attributes":14774,"children":14775},{"href":1518},[14776],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14779},"\n\n\n   214 Transformation applied\n     MUST be added by an intermediate cache or proxy if it applies any\n     transformation changing the content-coding (as specified in the\n     Content-Encoding header) or media-type (as specified in the\n     Content-Type header) of the response, or the entity-body of the\n     response, unless this Warning code already appears in the response.\n\n   299 Miscellaneous persistent warning\n     The warning text MAY include arbitrary information to be presented\n     to a human user, or logged. A system receiving this warning MUST\n     NOT take any automated action.\n\n   If an implementation sends a message with one or more Warning headers\n   whose version is HTTP\u002F1.0 or lower, then the sender MUST include in\n   each warning-value a warn-date that matches the date in the response.\n\n   If an implementation receives a message with a warning-value that\n   includes a warn-date, and that warn-date is different from the Date\n   value in the response, then that warning-value MUST be deleted from\n   the message before storing, forwarding, or using it. (This prevents\n   bad consequences of naive caching of Warning header fields.) If all\n   of the warning-values are deleted for this reason, the Warning header\n   MUST be deleted as well.\n\n",{"type":1444,"nodeName":1461,"attributes":14781,"children":14782},{"class":5228},[14783,14787],{"type":1444,"nodeName":1452,"attributes":14784,"children":14785},{"class":5220,"id":1241,"href":4660},[14786],{"type":1449,"textContent":4663},{"type":1449,"textContent":14788}," WWW-Authenticate",{"type":1449,"textContent":14790},"\n\n   The WWW-Authenticate response-header field MUST be included in 401\n   (Unauthorized) response messages. The field value consists of at\n   least one challenge that indicates the authentication scheme(s) and\n   parameters applicable to the Request-URI.\n\n       WWW-Authenticate  = \"WWW-Authenticate\" \":\" 1#challenge\n\n   The HTTP access authentication process is described in \"HTTP\n   Authentication: Basic and Digest Access Authentication\" [",{"type":1444,"nodeName":1452,"attributes":14792,"children":14793},{"href":10024},[14794],{"type":1449,"textContent":2248},{"type":1449,"textContent":14796},"]. User\n   agents are advised to take special care in parsing the WWW-\n   Authenticate field value as it might contain more than one challenge,\n   or if more than one WWW-Authenticate header field is provided, the\n   contents of a challenge itself can contain a comma-separated list of\n   authentication parameters.\n\n",{"type":1444,"nodeName":1461,"attributes":14798,"children":14799},{"class":5216},[14800,14804],{"type":1444,"nodeName":1452,"attributes":14801,"children":14802},{"class":5220,"id":1246,"href":4675},[14803],{"type":1449,"textContent":1639},{"type":1449,"textContent":14805}," Security Considerations",{"type":1449,"textContent":14807},"\n\n   This section is meant to inform application developers, information\n   providers, and users of the security limitations in HTTP\u002F1.1 as\n   described by this document. The discussion does not include\n   definitive solutions to the problems revealed, though it does make\n   some suggestions for reducing security risks.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14809,"children":14810},{"class":1493},[14811],{"type":1449,"textContent":14812},"Fielding, et al.            Standards Track                   [Page 150]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14815,"children":14816},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14818,"children":14819},{"class":1506},[14820,14824,14825,14833,14834,14843,14845,14854,14856,14865,14867],{"type":1444,"nodeName":1461,"attributes":14821,"children":14823},{"id":14822},"page-151",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14826,"children":14827},{"class":1493},[14828,14832],{"type":1444,"nodeName":1452,"attributes":14829,"children":14830},{"href":1518},[14831],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":14835,"children":14836},{"class":5228},[14837,14841],{"type":1444,"nodeName":1452,"attributes":14838,"children":14839},{"class":5220,"id":1252,"href":4687},[14840],{"type":1449,"textContent":4690},{"type":1449,"textContent":14842}," Personal Information",{"type":1449,"textContent":14844},"\n\n   HTTP clients are often privy to large amounts of personal information\n   (e.g. the user's name, location, mail address, passwords, encryption\n   keys, etc.), and SHOULD be very careful to prevent unintentional\n   leakage of this information via the HTTP protocol to other sources.\n   We very strongly recommend that a convenient interface be provided\n   for the user to control dissemination of such information, and that\n   designers and implementors be particularly careful in this area.\n   History shows that errors in this area often create serious security\n   and\u002For privacy problems and generate highly adverse publicity for the\n   implementor's company.\n\n",{"type":1444,"nodeName":1461,"attributes":14846,"children":14847},{"class":5964},[14848,14852],{"type":1444,"nodeName":1452,"attributes":14849,"children":14850},{"class":5220,"id":1258,"href":4702},[14851],{"type":1449,"textContent":4705},{"type":1449,"textContent":14853}," Abuse of Server Log Information",{"type":1449,"textContent":14855},"\n\n   A server is in the position to save personal data about a user's\n   requests which might identify their reading patterns or subjects of\n   interest. This information is clearly confidential in nature and its\n   handling can be constrained by law in certain countries. People using\n   the HTTP protocol to provide data are responsible for ensuring that\n   such material is not distributed without the permission of any\n   individuals that are identifiable by the published results.\n\n",{"type":1444,"nodeName":1461,"attributes":14857,"children":14858},{"class":5964},[14859,14863],{"type":1444,"nodeName":1452,"attributes":14860,"children":14861},{"class":5220,"id":1263,"href":4715},[14862],{"type":1449,"textContent":4718},{"type":1449,"textContent":14864}," Transfer of Sensitive Information",{"type":1449,"textContent":14866},"\n\n   Like any generic data transfer protocol, HTTP cannot regulate the\n   content of the data that is transferred, nor is there any a priori\n   method of determining the sensitivity of any particular piece of\n   information within the context of any given request. Therefore,\n   applications SHOULD supply as much control over this information as\n   possible to the provider of that information. Four header fields are\n   worth special mention in this context: Server, Via, Referer and From.\n\n   Revealing the specific software version of the server might allow the\n   server machine to become more vulnerable to attacks against software\n   that is known to contain security holes. Implementors SHOULD make the\n   Server header field a configurable option.\n\n   Proxies which serve as a portal through a network firewall SHOULD\n   take special precautions regarding the transfer of header information\n   that identifies the hosts behind the firewall. In particular, they\n   SHOULD remove, or replace with sanitized versions, any Via fields\n   generated behind the firewall.\n\n   The Referer header allows reading patterns to be studied and reverse\n   links drawn. Although it can be very useful, its power can be abused\n   if user details are not separated from the information contained in\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14868,"children":14869},{"class":1493},[14870],{"type":1449,"textContent":14871},"Fielding, et al.            Standards Track                   [Page 151]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14874,"children":14875},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14877,"children":14878},{"class":1506},[14879,14883,14884,14892,14894,14898,14900,14905,14907,14916,14918,14927,14929],{"type":1444,"nodeName":1461,"attributes":14880,"children":14882},{"id":14881},"page-152",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14885,"children":14886},{"class":1493},[14887,14891],{"type":1444,"nodeName":1452,"attributes":14888,"children":14889},{"href":1518},[14890],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14893},"\n\n\n   the Referer. Even when the personal information has been removed, the\n   Referer header might indicate a private document's URI whose\n   publication would be inappropriate.\n\n   The information sent in the From field might conflict with the user's\n   privacy interests or their site's security policy, and hence it\n   SHOULD NOT be transmitted without the user being able to disable,\n   enable, and modify the contents of the field. The user MUST be able\n   to set the contents of this field within a user preference or\n   application defaults configuration.\n\n   We suggest, though do not require, that a convenient toggle interface\n   be provided for the user to enable or disable the sending of From and\n   Referer information.\n\n   The User-Agent (",{"type":1444,"nodeName":1452,"attributes":14895,"children":14896},{"href":4602},[14897],{"type":1449,"textContent":10593},{"type":1449,"textContent":14899},") or Server (",{"type":1444,"nodeName":1452,"attributes":14901,"children":14902},{"href":4531},[14903],{"type":1449,"textContent":14904},"section 14.38",{"type":1449,"textContent":14906},") header\n   fields can sometimes be used to determine that a specific client or\n   server have a particular security hole which might be exploited.\n   Unfortunately, this same information is often used for other valuable\n   purposes for which HTTP currently has no better mechanism.\n\n",{"type":1444,"nodeName":1461,"attributes":14908,"children":14909},{"class":5964},[14910,14914],{"type":1444,"nodeName":1452,"attributes":14911,"children":14912},{"class":5220,"id":1268,"href":4728},[14913],{"type":1449,"textContent":4731},{"type":1449,"textContent":14915}," Encoding Sensitive Information in URI's",{"type":1449,"textContent":14917},"\n\n   Because the source of a link might be private information or might\n   reveal an otherwise private information source, it is strongly\n   recommended that the user be able to select whether or not the\n   Referer field is sent. For example, a browser client could have a\n   toggle switch for browsing openly\u002Fanonymously, which would\n   respectively enable\u002Fdisable the sending of Referer and From\n   information.\n\n   Clients SHOULD NOT include a Referer header field in a (non-secure)\n   HTTP request if the referring page was transferred with a secure\n   protocol.\n\n   Authors of services which use the HTTP protocol SHOULD NOT use GET\n   based forms for the submission of sensitive data, because this will\n   cause this data to be encoded in the Request-URI. Many existing\n   servers, proxies, and user agents will log the request URI in some\n   place where it might be visible to third parties. Servers can use\n   POST-based form submission instead\n\n",{"type":1444,"nodeName":1461,"attributes":14919,"children":14920},{"class":5964},[14921,14925],{"type":1444,"nodeName":1452,"attributes":14922,"children":14923},{"class":5220,"id":1273,"href":4743},[14924],{"type":1449,"textContent":4746},{"type":1449,"textContent":14926}," Privacy Issues Connected to Accept Headers",{"type":1449,"textContent":14928},"\n\n   Accept request-headers can reveal information about the user to all\n   servers which are accessed. The Accept-Language header in particular\n   can reveal information the user would consider to be of a private\n   nature, because the understanding of particular languages is often\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14930,"children":14931},{"class":1493},[14932],{"type":1449,"textContent":14933},"Fielding, et al.            Standards Track                   [Page 152]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14936,"children":14937},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14939,"children":14940},{"class":1506},[14941,14945,14946,14954,14956,14965,14967],{"type":1444,"nodeName":1461,"attributes":14942,"children":14944},{"id":14943},"page-153",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14947,"children":14948},{"class":1493},[14949,14953],{"type":1444,"nodeName":1452,"attributes":14950,"children":14951},{"href":1518},[14952],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":14955},"\n\n\n   strongly correlated to the membership of a particular ethnic group.\n   User agents which offer the option to configure the contents of an\n   Accept-Language header to be sent in every request are strongly\n   encouraged to let the configuration process include a message which\n   makes the user aware of the loss of privacy involved.\n\n   An approach that limits the loss of privacy would be for a user agent\n   to omit the sending of Accept-Language headers by default, and to ask\n   the user whether or not to start sending Accept-Language headers to a\n   server if it detects, by looking for any Vary response-header fields\n   generated by the server, that such sending could improve the quality\n   of service.\n\n   Elaborate user-customized accept header fields sent in every request,\n   in particular if these include quality values, can be used by servers\n   as relatively reliable and long-lived user identifiers. Such user\n   identifiers would allow content providers to do click-trail tracking,\n   and would allow collaborating content providers to match cross-server\n   click-trails or form submissions of individual users. Note that for\n   many users not behind a proxy, the network address of the host\n   running the user agent will also serve as a long-lived user\n   identifier. In environments where proxies are used to enhance\n   privacy, user agents ought to be conservative in offering accept\n   header configuration options to end users. As an extreme privacy\n   measure, proxies could filter the accept headers in relayed requests.\n   General purpose user agents which provide a high degree of header\n   configurability SHOULD warn users about the loss of privacy which can\n   be involved.\n\n",{"type":1444,"nodeName":1461,"attributes":14957,"children":14958},{"class":5228},[14959,14963],{"type":1444,"nodeName":1452,"attributes":14960,"children":14961},{"class":5220,"id":1278,"href":4756},[14962],{"type":1449,"textContent":4759},{"type":1449,"textContent":14964}," Attacks Based On File and Path Names",{"type":1449,"textContent":14966},"\n\n   Implementations of HTTP origin servers SHOULD be careful to restrict\n   the documents returned by HTTP requests to be only those that were\n   intended by the server administrators. If an HTTP server translates\n   HTTP URIs directly into file system calls, the server MUST take\n   special care not to serve files that were not intended to be\n   delivered to HTTP clients. For example, UNIX, Microsoft Windows, and\n   other operating systems use \"..\" as a path component to indicate a\n   directory level above the current one. On such a system, an HTTP\n   server MUST disallow any such construct in the Request-URI if it\n   would otherwise allow access to a resource outside those intended to\n   be accessible via the HTTP server. Similarly, files intended for\n   reference only internally to the server (such as access control\n   files, configuration files, and script code) MUST be protected from\n   inappropriate retrieval, since they might contain sensitive\n   information. Experience has shown that minor bugs in such HTTP server\n   implementations have turned into security risks.\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":14968,"children":14969},{"class":1493},[14970],{"type":1449,"textContent":14971},"Fielding, et al.            Standards Track                   [Page 153]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":14974,"children":14975},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":14977,"children":14978},{"class":1506},[14979,14983,14984,14992,14993,15002,15004,15008,15010,15019,15021,15030,15032,15038,15039,15044,15046,15051,15053,15059,15060,15066,15068,15072,15074],{"type":1444,"nodeName":1461,"attributes":14980,"children":14982},{"id":14981},"page-154",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":14985,"children":14986},{"class":1493},[14987,14991],{"type":1444,"nodeName":1452,"attributes":14988,"children":14989},{"href":1518},[14990],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":14994,"children":14995},{"class":5228},[14996,15000],{"type":1444,"nodeName":1452,"attributes":14997,"children":14998},{"class":5220,"id":1283,"href":4771},[14999],{"type":1449,"textContent":4774},{"type":1449,"textContent":15001}," DNS Spoofing",{"type":1449,"textContent":15003},"\n\n   Clients using HTTP rely heavily on the Domain Name Service, and are\n   thus generally prone to security attacks based on the deliberate\n   mis-association of IP addresses and DNS names. Clients need to be\n   cautious in assuming the continuing validity of an IP number\u002FDNS name\n   association.\n\n   In particular, HTTP clients SHOULD rely on their name resolver for\n   confirmation of an IP number\u002FDNS name association, rather than\n   caching the result of previous host name lookups. Many platforms\n   already can cache host name lookups locally when appropriate, and\n   they SHOULD be configured to do so. It is proper for these lookups to\n   be cached, however, only when the TTL (Time To Live) information\n   reported by the name server makes it likely that the cached\n   information will remain useful.\n\n   If HTTP clients cache the results of host name lookups in order to\n   achieve a performance improvement, they MUST observe the TTL\n   information reported by DNS.\n\n   If HTTP clients do not observe this rule, they could be spoofed when\n   a previously-accessed server's IP address changes. As network\n   renumbering is expected to become increasingly common [",{"type":1444,"nodeName":1452,"attributes":15005,"children":15006},{"href":6048},[15007],{"type":1449,"textContent":1824},{"type":1449,"textContent":15009},"], the\n   possibility of this form of attack will grow. Observing this\n   requirement thus reduces this potential security vulnerability.\n\n   This requirement also improves the load-balancing behavior of clients\n   for replicated servers using the same DNS name and reduces the\n   likelihood of a user's experiencing failure in accessing sites which\n   use that strategy.\n\n",{"type":1444,"nodeName":1461,"attributes":15011,"children":15012},{"class":5228},[15013,15017],{"type":1444,"nodeName":1452,"attributes":15014,"children":15015},{"class":5220,"id":1288,"href":4786},[15016],{"type":1449,"textContent":4789},{"type":1449,"textContent":15018}," Location Headers and Spoofing",{"type":1449,"textContent":15020},"\n\n   If a single server supports multiple organizations that do not trust\n   one another, then it MUST check the values of Location and Content-\n   Location headers in responses that are generated under control of\n   said organizations to make sure that they do not attempt to\n   invalidate resources over which they have no authority.\n\n",{"type":1444,"nodeName":1461,"attributes":15022,"children":15023},{"class":5228},[15024,15028],{"type":1444,"nodeName":1452,"attributes":15025,"children":15026},{"class":5220,"id":1293,"href":4799},[15027],{"type":1449,"textContent":4802},{"type":1449,"textContent":15029}," Content-Disposition Issues",{"type":1449,"textContent":15031},"\n\n   ",{"type":1444,"nodeName":1452,"attributes":15033,"children":15035},{"href":15034},"\u002Finfo\u002Frfc1806\u002F",[15036],{"type":1449,"textContent":15037},"RFC 1806",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":15040,"children":15042},{"href":15041},"#ref-35",[15043],{"type":1449,"textContent":2053},{"type":1449,"textContent":15045},"], from which the often implemented Content-Disposition\n   (see ",{"type":1444,"nodeName":1452,"attributes":15047,"children":15048},{"href":5110},[15049],{"type":1449,"textContent":15050},"section 19.5.1",{"type":1449,"textContent":15052},") header in HTTP is derived, has a number of very\n   serious security considerations. Content-Disposition is not part of\n   the HTTP standard, but since it is widely implemented, we are\n   documenting its use and risks for implementors. See ",{"type":1444,"nodeName":1452,"attributes":15054,"children":15056},{"href":15055},"\u002Finfo\u002Frfc2183\u002F",[15057],{"type":1449,"textContent":15058},"RFC 2183",{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":15061,"children":15063},{"href":15062},"#ref-49",[15064],{"type":1449,"textContent":15065},"49",{"type":1449,"textContent":15067},"]\n   (which updates ",{"type":1444,"nodeName":1452,"attributes":15069,"children":15070},{"href":15034},[15071],{"type":1449,"textContent":15037},{"type":1449,"textContent":15073},") for details.\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":15075,"children":15076},{"class":1493},[15077],{"type":1449,"textContent":15078},"Fielding, et al.            Standards Track                   [Page 154]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":15081,"children":15082},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":15084,"children":15085},{"class":1506},[15086,15090,15091,15099,15100,15109,15111,15120,15122,15127,15128,15132,15134],{"type":1444,"nodeName":1461,"attributes":15087,"children":15089},{"id":15088},"page-155",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":15092,"children":15093},{"class":1493},[15094,15098],{"type":1444,"nodeName":1452,"attributes":15095,"children":15096},{"href":1518},[15097],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":5961},{"type":1444,"nodeName":1461,"attributes":15101,"children":15102},{"class":5228},[15103,15107],{"type":1444,"nodeName":1452,"attributes":15104,"children":15105},{"class":5220,"id":1298,"href":4812},[15106],{"type":1449,"textContent":4815},{"type":1449,"textContent":15108}," Authentication Credentials and Idle Clients",{"type":1449,"textContent":15110},"\n\n   Existing HTTP clients and user agents typically retain authentication\n   information indefinitely. HTTP\u002F1.1. does not provide a method for a\n   server to direct clients to discard these cached credentials. This is\n   a significant defect that requires further extensions to HTTP.\n   Circumstances under which credential caching can interfere with the\n   application's security model include but are not limited to:\n\n      - Clients which have been idle for an extended period following\n        which the server might wish to cause the client to reprompt the\n        user for credentials.\n\n      - Applications which include a session termination indication\n        (such as a `logout' or `commit' button on a page) after which\n        the server side of the application `knows' that there is no\n        further reason for the client to retain the credentials.\n\n   This is currently under separate study. There are a number of work-\n   arounds to parts of this problem, and we encourage the use of\n   password protection in screen savers, idle time-outs, and other\n   methods which mitigate the security problems inherent in this\n   problem. In particular, user agents which cache credentials are\n   encouraged to provide a readily accessible mechanism for discarding\n   cached credentials under user control.\n\n",{"type":1444,"nodeName":1461,"attributes":15112,"children":15113},{"class":5228},[15114,15118],{"type":1444,"nodeName":1452,"attributes":15115,"children":15116},{"class":5220,"id":1303,"href":4827},[15117],{"type":1449,"textContent":4830},{"type":1449,"textContent":15119}," Proxies and Caching",{"type":1449,"textContent":15121},"\n\n   By their very nature, HTTP proxies are men-in-the-middle, and\n   represent an opportunity for man-in-the-middle attacks. Compromise of\n   the systems on which the proxies run can result in serious security\n   and privacy problems. Proxies have access to security-related\n   information, personal information about individual users and\n   organizations, and proprietary information belonging to users and\n   content providers. A compromised proxy, or a proxy implemented or\n   configured without regard to security and privacy considerations,\n   might be used in the commission of a wide range of potential attacks.\n\n   Proxy operators should protect the systems on which proxies run as\n   they would protect any system that contains or transports sensitive\n   information. In particular, log information gathered at proxies often\n   contains highly sensitive personal information, and\u002For information\n   about organizations. Log information should be carefully guarded, and\n   appropriate guidelines for use developed and followed. (",{"type":1444,"nodeName":1452,"attributes":15123,"children":15124},{"href":4702},[15125],{"type":1449,"textContent":15126},"Section",{"type":1449,"textContent":1541},{"type":1444,"nodeName":1452,"attributes":15129,"children":15130},{"href":4702},[15131],{"type":1449,"textContent":4705},{"type":1449,"textContent":15133},").\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":15135,"children":15136},{"class":1493},[15137],{"type":1449,"textContent":15138},"Fielding, et al.            Standards Track                   [Page 155]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":15141,"children":15142},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":15144,"children":15145},{"class":1506},[15146,15150,15151,15159,15161,15170,15172,15181,15183,15187,15188,15192,15194,15198,15200],{"type":1444,"nodeName":1461,"attributes":15147,"children":15149},{"id":15148},"page-156",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":15152,"children":15153},{"class":1493},[15154,15158],{"type":1444,"nodeName":1452,"attributes":15155,"children":15156},{"href":1518},[15157],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":15160},"\n\n\n   Caching proxies provide additional potential vulnerabilities, since\n   the contents of the cache represent an attractive target for\n   malicious exploitation. Because cache contents persist after an HTTP\n   request is complete, an attack on the cache can reveal information\n   long after a user believes that the information has been removed from\n   the network. Therefore, cache contents should be protected as\n   sensitive information.\n\n   Proxy implementors should consider the privacy and security\n   implications of their design and coding decisions, and of the\n   configuration options they provide to proxy operators (especially the\n   default configuration).\n\n   Users of a proxy need to be aware that they are no trustworthier than\n   the people who run the proxy; HTTP itself cannot solve this problem.\n\n   The judicious use of cryptography, when appropriate, may suffice to\n   protect against a broad range of security and privacy attacks. Such\n   cryptography is beyond the scope of the HTTP\u002F1.1 specification.\n\n",{"type":1444,"nodeName":1461,"attributes":15162,"children":15163},{"class":5964},[15164,15168],{"type":1444,"nodeName":1452,"attributes":15165,"children":15166},{"class":5220,"id":1309,"href":4840},[15167],{"type":1449,"textContent":4843},{"type":1449,"textContent":15169}," Denial of Service Attacks on Proxies",{"type":1449,"textContent":15171},"\n\n   They exist. They are hard to defend against. Research continues.\n   Beware.\n\n",{"type":1444,"nodeName":1461,"attributes":15173,"children":15174},{"class":5216},[15175,15179],{"type":1444,"nodeName":1452,"attributes":15176,"children":15177},{"class":5220,"id":1314,"href":4855},[15178],{"type":1449,"textContent":4858},{"type":1449,"textContent":15180}," Acknowledgments",{"type":1449,"textContent":15182},"\n\n   This specification makes heavy use of the augmented BNF and generic\n   constructs defined by David H. Crocker for ",{"type":1444,"nodeName":1452,"attributes":15184,"children":15185},{"href":5662},[15186],{"type":1449,"textContent":5665},{"type":1449,"textContent":1482},{"type":1444,"nodeName":1452,"attributes":15189,"children":15190},{"href":5308},[15191],{"type":1449,"textContent":2427},{"type":1449,"textContent":15193},"]. Similarly, it\n   reuses many of the definitions provided by Nathaniel Borenstein and\n   Ned Freed for MIME [",{"type":1444,"nodeName":1452,"attributes":15195,"children":15196},{"href":5315},[15197],{"type":1449,"textContent":1539},{"type":1449,"textContent":15199},"]. We hope that their inclusion in this\n   specification will help reduce past confusion over the relationship\n   between HTTP and Internet mail message formats.\n\n   The HTTP protocol has evolved considerably over the years. It has\n   benefited from a large and active developer community--the many\n   people who have participated on the www-talk mailing list--and it is\n   that community which has been most responsible for the success of\n   HTTP and of the World-Wide Web in general. Marc Andreessen, Robert\n   Cailliau, Daniel W. Connolly, Bob Denny, John Franks, Jean-Francois\n   Groff, Phillip M. Hallam-Baker, Hakon W. Lie, Ari Luotonen, Rob\n   McCool, Lou Montulli, Dave Raggett, Tony Sanders, and Marc\n   VanHeyningen deserve special recognition for their efforts in\n   defining early aspects of the protocol.\n\n   This document has benefited greatly from the comments of all those\n   participating in the HTTP-WG. In addition to those already mentioned,\n   the following individuals have contributed to this specification:\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":15201,"children":15202},{"class":1493},[15203],{"type":1449,"textContent":15204},"Fielding, et al.            Standards Track                   [Page 156]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":15207,"children":15208},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":15210,"children":15211},{"class":1506},[15212,15216,15217,15225,15227],{"type":1444,"nodeName":1461,"attributes":15213,"children":15215},{"id":15214},"page-157",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":15218,"children":15219},{"class":1493},[15220,15224],{"type":1444,"nodeName":1452,"attributes":15221,"children":15222},{"href":1518},[15223],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":15226},"\n\n\n       Gary Adams                  Ross Patterson\n       Harald Tveit Alvestrand     Albert Lunde\n       Keith Ball                  John C. Mallery\n       Brian Behlendorf            Jean-Philippe Martin-Flatin\n       Paul Burchard               Mitra\n       Maurizio Codogno            David Morris\n       Mike Cowlishaw              Gavin Nicol\n       Roman Czyborra              Bill Perry\n       Michael A. Dolan            Jeffrey Perry\n       David J. Fiander            Scott Powers\n       Alan Freier                 Owen Rees\n       Marc Hedlund                Luigi Rizzo\n       Greg Herlihy                David Robinson\n       Koen Holtman                Marc Salomon\n       Alex Hopmann                Rich Salz\n       Bob Jernigan                Allan M. Schiffman\n       Shel Kaphan                 Jim Seidman\n       Rohit Khare                 Chuck Shotton\n       John Klensin                Eric W. Sink\n       Martijn Koster              Simon E. Spero\n       Alexei Kosut                Richard N. Taylor\n       David M. Kristol            Robert S. Thau\n       Daniel LaLiberte            Bill (BearHeart) Weinman\n       Ben Laurie                  Francois Yergeau\n       Paul J. Leach               Mary Ellen Zurko\n       Daniel DuBois               Josh Cohen\n\n\n   Much of the content and presentation of the caching design is due to\n   suggestions and comments from individuals including: Shel Kaphan,\n   Paul Leach, Koen Holtman, David Morris, and Larry Masinter.\n\n   Most of the specification of ranges is based on work originally done\n   by Ari Luotonen and John Franks, with additional input from Steve\n   Zilles.\n\n   Thanks to the \"cave men\" of Palo Alto. You know who you are.\n\n   Jim Gettys (the current editor of this document) wishes particularly\n   to thank Roy Fielding, the previous editor of this document, along\n   with John Klensin, Jeff Mogul, Paul Leach, Dave Kristol, Koen\n   Holtman, John Franks, Josh Cohen, Alex Hopmann, Scott Lawrence, and\n   Larry Masinter for their help. And thanks go particularly to Jeff\n   Mogul and Scott Lawrence for performing the \"MUST\u002FMAY\u002FSHOULD\" audit.\n\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":15228,"children":15229},{"class":1493},[15230],{"type":1449,"textContent":15231},"Fielding, et al.            Standards Track                   [Page 157]",{"type":1449,"textContent":1498},{"type":1444,"nodeName":1500,"attributes":15234,"children":15235},{"class":1502},[],{"type":1444,"nodeName":1445,"attributes":15237,"children":15238},{"class":1506},[15239,15243,15244,15252,15254,15258,15260,15269,15271,15276,15278,15283,15285,15290,15292,15297,15299,15305,15307,15312,15314,15319,15320,15325,15327,15332,15334,15340,15342,15347,15349,15355,15357,15362,15364,15368,15370,15375,15377,15381,15383,15388,15390,15394,15396,15401,15403,15407,15409,15414,15416,15421,15423,15427,15429,15434,15436,15440,15442],{"type":1444,"nodeName":1461,"attributes":15240,"children":15242},{"id":15241},"page-158",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":15245,"children":15246},{"class":1493},[15247,15251],{"type":1444,"nodeName":1452,"attributes":15248,"children":15249},{"href":1518},[15250],{"type":1449,"textContent":1521},{"type":1449,"textContent":1523},{"type":1449,"textContent":15253},"\n\n\n   The Apache Group, Anselm Baird-Smith, author of Jigsaw, and Henrik\n   Frystyk implemented ",{"type":1444,"nodeName":1452,"attributes":15255,"children":15256},{"href":1454},[15257],{"type":1449,"textContent":1480},{"type":1449,"textContent":15259}," early, and we wish to thank them for the\n   discovery of many of the problems that this document attempts to\n   rectify.\n\n",{"type":1444,"nodeName":1461,"attributes":15261,"children":15262},{"class":5216},[15263,15267],{"type":1444,"nodeName":1452,"attributes":15264,"children":15265},{"class":5220,"id":1319,"href":4868},[15266],{"type":1449,"textContent":1654},{"type":1449,"textContent":15268}," References",{"type":1449,"textContent":15270},"\n\n   [",{"type":1444,"nodeName":1452,"attributes":15272,"children":15274},{"id":15273},"ref-1",[15275],{"type":1449,"textContent":1531},{"type":1449,"textContent":15277},"] Alvestrand, H., \"Tags for the Identification of Languages\", ",{"type":1444,"nodeName":1452,"attributes":15279,"children":15280},{"href":6927},[15281],{"type":1449,"textContent":15282},"RFC",{"type":1449,"textContent":15284},"\n       ",{"type":1444,"nodeName":1452,"attributes":15286,"children":15287},{"href":6927},[15288],{"type":1449,"textContent":15289},"1766",{"type":1449,"textContent":15291},", March 1995.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15293,"children":15295},{"id":15294},"ref-2",[15296],{"type":1449,"textContent":1603},{"type":1449,"textContent":15298},"] Anklesaria, F., McCahill, M., Lindner, P., Johnson, D., Torrey,\n       D. and B. Alberti, \"The Internet Gopher Protocol (a distributed\n       document search and retrieval protocol)\", ",{"type":1444,"nodeName":1452,"attributes":15300,"children":15302},{"href":15301},"\u002Finfo\u002Frfc1436\u002F",[15303],{"type":1449,"textContent":15304},"RFC 1436",{"type":1449,"textContent":15306},", March 1993.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15308,"children":15310},{"id":15309},"ref-3",[15311],{"type":1449,"textContent":1646},{"type":1449,"textContent":15313},"] Berners-Lee, T., \"Universal Resource Identifiers in WWW\", ",{"type":1444,"nodeName":1452,"attributes":15315,"children":15317},{"href":15316},"\u002Finfo\u002Frfc1630\u002F",[15318],{"type":1449,"textContent":15282},{"type":1449,"textContent":15284},{"type":1444,"nodeName":1452,"attributes":15321,"children":15322},{"href":15316},[15323],{"type":1449,"textContent":15324},"1630",{"type":1449,"textContent":15326},", June 1994.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15328,"children":15330},{"id":15329},"ref-4",[15331],{"type":1449,"textContent":1960},{"type":1449,"textContent":15333},"] Berners-Lee, T., Masinter, L. and M. McCahill, \"Uniform Resource\n       Locators (URL)\", ",{"type":1444,"nodeName":1452,"attributes":15335,"children":15337},{"href":15336},"\u002Finfo\u002Frfc1738\u002F",[15338],{"type":1449,"textContent":15339},"RFC 1738",{"type":1449,"textContent":15341},", December 1994.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15343,"children":15345},{"id":15344},"ref-5",[15346],{"type":1449,"textContent":2045},{"type":1449,"textContent":15348},"] Berners-Lee, T. and D. Connolly, \"Hypertext Markup Language -\n       2.0\", ",{"type":1444,"nodeName":1452,"attributes":15350,"children":15352},{"href":15351},"\u002Finfo\u002Frfc1866\u002F",[15353],{"type":1449,"textContent":15354},"RFC 1866",{"type":1449,"textContent":15356},", November 1995.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15358,"children":15360},{"id":15359},"ref-6",[15361],{"type":1449,"textContent":2129},{"type":1449,"textContent":15363},"] Berners-Lee, T., Fielding, R. and H. Frystyk, \"Hypertext Transfer\n       Protocol -- HTTP\u002F1.0\", ",{"type":1444,"nodeName":1452,"attributes":15365,"children":15366},{"href":5240},[15367],{"type":1449,"textContent":5243},{"type":1449,"textContent":15369},", May 1996.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15371,"children":15373},{"id":15372},"ref-7",[15374],{"type":1449,"textContent":1539},{"type":1449,"textContent":15376},"] Freed, N. and N. Borenstein, \"Multipurpose Internet Mail\n       Extensions (MIME) Part One: Format of Internet Message Bodies\",\n       ",{"type":1444,"nodeName":1452,"attributes":15378,"children":15379},{"href":4961},[15380],{"type":1449,"textContent":4964},{"type":1449,"textContent":15382},", November 1996.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15384,"children":15386},{"id":15385},"ref-8",[15387],{"type":1449,"textContent":1568},{"type":1449,"textContent":15389},"] Braden, R., \"Requirements for Internet Hosts -- Communication\n       Layers\", STD 3, ",{"type":1444,"nodeName":1452,"attributes":15391,"children":15392},{"href":6155},[15393],{"type":1449,"textContent":6158},{"type":1449,"textContent":15395},", October 1989.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15397,"children":15399},{"id":15398},"ref-9",[15400],{"type":1449,"textContent":2427},{"type":1449,"textContent":15402},"] Crocker, D., \"Standard for The Format of ARPA Internet Text\n       Messages\", STD 11, ",{"type":1444,"nodeName":1452,"attributes":15404,"children":15405},{"href":5662},[15406],{"type":1449,"textContent":5665},{"type":1449,"textContent":15408},", August 1982.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15410,"children":15412},{"id":15411},"ref-10",[15413],{"type":1449,"textContent":2597},{"type":1449,"textContent":15415},"] Davis, F., Kahle, B., Morris, H., Salem, J., Shen, T., Wang, R.,\n        Sui, J., and M. Grinbaum, \"WAIS Interface Protocol Prototype\n        Functional Specification,\" (v1.5), Thinking Machines\n        Corporation, April 1990.\n\n   [",{"type":1444,"nodeName":1452,"attributes":15417,"children":15419},{"id":15418},"ref-11",[15420],{"type":1449,"textContent":3262},{"type":1449,"textContent":15422},"] Fielding, R., \"Relative Uniform Resource Locators\", ",{"type":1444,"nodeName":1452,"attributes":15424,"child