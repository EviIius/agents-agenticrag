02F",[15910],{"type":1449,"textContent":15911},"RFC 2279",{"type":1449,"textContent":15913},", January 1998. [jg641]\n\n   [",{"type":1444,"nodeName":1452,"attributes":15915,"children":15917},{"id":15916},"ref-39",[15918],{"type":1449,"textContent":2137},{"type":1449,"textContent":15920},"] Nielsen, H.F., Gettys, J., Baird-Smith, A., Prud'hommeaux, E.,\n        Lie, H., and C. Lilley. \"Network Performance Effects of\n        HTTP\u002F1.1, CSS1, and PNG,\" Proceedings of ACM SIGCOMM '97, Cannes\n        France, September 1997.[jg642]\n\n   [",{"type":1444,"nodeName":1452,"attributes":15922,"children":15924},{"id":15923},"ref-40",[15925],{"type":1449,"textContent":6823},{"type":1449,"textContent":15927},"] Freed, N. and N. Borenstein, \"Multipurpose Internet Mail\n        Extensions (MIME) Part Two: Media Types\", ",{"type":1444,"nodeName":1452,"attributes":15929,"children":15930},{"href":6828},[15931],{"type":1449,"textContent":6831},{"type":1449,"textContent":15933},", November\n        1996. [jg643]\n\n   [",{"type":1444,"nodeName":1452,"attributes":15935,"children":15937},{"id":15936},"ref-41",[15938],{"type":1449,"textContent":2178},{"type":1449,"textContent":15940},"] Alvestrand, H., \"IETF Policy on Character Sets and Languages\",\n        ",{"type":1444,"nodeName":1452,"attributes":15942,"children":15944},{"href":15943},"\u002Fbcp\u002Fbcp18",[15945],{"type":1449,"textContent":15946},"BCP 18",{"type":1449,"textContent":10728},{"type":1444,"nodeName":1452,"attributes":15949,"children":15951},{"href":15950},"\u002Finfo\u002Frfc2277\u002F",[15952],{"type":1449,"textContent":15953},"RFC 2277",{"type":1449,"textContent":15955},", January 1998. [jg644]\n\n   [",{"type":1444,"nodeName":1452,"attributes":15957,"children":15959},{"id":15958},"ref-42",[15960],{"type":1449,"textContent":2220},{"type":1449,"textContent":15962},"] Berners-Lee, T., Fielding, R. and L. Masinter, \"Uniform Resource\n        Identifiers (URI): Generic Syntax and Semantics\", ",{"type":1444,"