                    Xerox\n                                                              P. Leach\n                                                             Microsoft\n                                                        T. Berners-Lee\n                                                               W3C\u002FMIT\n                                                             June 1999\n\n\n                ",{"type":1444,"nodeName":1461,"attributes":1462,"children":1464},"span",{"class":1463},"h1",[1465],{"type":1449,"textContent":7},{"type":1449,"textContent":1467},"\n\nStatus of this Memo\n\n   This document specifies an Internet standards track protocol for the\n   Internet community, and requests discussion and suggestions for\n   improvements.  Please refer to the current edition of the \"Internet\n   Official Protocol Standards\" (STD 1) for the standardization state\n   and status of this protocol.  Distribution of this memo is unlimited.\n\nCopyright Notice\n\n   Copyright (C) The Internet Society (1999).  All Rights Reserved.\n\nAbstract\n\n   The Hypertext Transfer Protocol (HTTP) is an application-level\n   protocol for distributed, collaborative, hypermedia information\n   systems. It is a generic, stateless, protocol which can be used for\n   many tasks beyond its use for hypertext, such as name servers and\n   distributed object management systems, through extension of its\n   request methods, error codes and headers [",{"type":1444,"nodeName":1452,"attributes":1469,"children":1471},{"href":1470},"#ref-47",[1472],{"type":1449,"textContent":1473},"47",{"type":1449,"textContent":1475},"]. A feature of HTTP is\n   the typing and negotiation of data representation, allowing systems\n   to be built independently of the data being transferred.\n\n   HTTP has been in use by the World-Wide Web global information\n   initiative since 1990. This specification defines the protocol\n   referred to as \"HTTP\u002F1.1\", and is an update to ",{"type":1444,"nodeName":1452,"attributes":1477,"children":1478},{"href":1454},[1479],{"type":1449,"textContent":1480},"RFC 2068",{"type":1449,"textContent":1482}," [",{"type":1444,"nodeName":1452,"attributes":1484,"children":1486},{"href":1485},"#ref-33",[1487],{"type":1449,"textContent":1488},"33",{"type":1449,"textContent":1490},"].\n\n\n\n\n\n\n",{"type":1444,"nodeName":1461,"attributes":1492,"children":1494},{"class":1493},"grey",[1495],{"type":1449,"textContent":1496},"Fielding, et al.            Standards Track                     [Page 1]",{"type":1449,"textContent":1498},"\n",{"type":1444,"nodeName":1500,"attributes":1501,"children":1503},"hr",{"class":1502},"noprint",[],{"type":1444,"nodeName":1445,"attributes":1505,"children":1507},{"class":1506},"newpage",[1508,1512,1513,1524,1526,1532,1534,1540,1542,1548,1550,1554,1555,1561,1563,1569,1570,1576,1578,1582,1583,1589,1591,1597,1598,1604,1606,1612,1613,1619,1621,1625,1626,1632,1634,1640,1641,1647,1649,1655,1656,1662,1664,1668,1669,1675,1677,1683,1684,1690,1692,1698,1699,1705,1707,1711,1712,1718,1720,1726,1727,1733,1735,1739,1740,1746,1748,1752,1753,1759,1761,1767,1768,1774,1776,1780,1781,1787,1789,1795,1796,1802,1804,1810,1811,1817,1819,1825,1826,1832,1834,1840,1841,1847,1849,1855,1856,1862,1864,1870,1871,1877,1879,1883,1884,1890,1892,1898,1899,1905,1907,1913,1914,1920,1922,1926,1927,1933,1935,1941,1942,1948,1950,1954,1955,1961,1963,1969,1970,1976,1978,1982,1983,1989,1991,1995,1996,2002,2004,2010,2011,2017,2019,2024,2025,2031,2033,2039,2040,2046,2048,2054,2055,2061,2063,2067,2068,2074,2076,2082,2083,2089,2091,2095,2096,2102,2104,2110,2111,2117,2119,2123,2124,2130,2132,2138,2139,2145,2147,2151,2152,2158,2160,2164,2165,2171,2173,2179,2181],{"type":1444,"nodeName":1461,"attributes":1509,"children":1511},{"id":1510},"page-2",[],{"type":1449,"textContent":1498},{"type":1444,"nodeName":1461,"attributes":1514,"children":1515},{"class":1493},[1516,1522],{"type":1444,"nodeName":1452,"attributes":1517,"children":1519},{"href":1518},"\u002F