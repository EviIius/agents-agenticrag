<li id="mwCVA"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Houston_Rockets" title="Houston Rockets" id="mwCVE">Houston Rockets</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/1994_NBA_Finals" title="1994 NBA Finals" about="#mwt681" typeof="mw:Transclusion" id="mwCVI" data-mw='{"parts":[{"template":{"target":{"wt":"nbafy","href":"./Template:Nbafy"},"params":{"1":{"wt":"1994"}},"i":0}}]}'>1994</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/1995_NBA_Finals" title="1995 NBA Finals" about="#mwt682" typeof="mw:Transclusion" id="mwCVM" data-mw='{"parts":[{"template":{"target":{"wt":"nbafy","href":"./Template:Nbafy"},"params":{"1":{"wt":"1995"}},"i":0}}]}'>1995</a>)</li>
<li id="mwCVQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Los_Angeles_Lakers" title="Los Angeles Lakers" id="mwCVU">Los Angeles Lakers</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2009_NBA_Finals" title="2009 NBA Finals" about="#mwt683" typeof="mw:Transclusion" id="mwCVY" data-mw='{"parts":[{"template":{"target":{"wt":"nbafy","href":"./Template:Nbafy"},"params":{"1":{"wt":"2009"}},"i":0}}]}'>2009</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2010_NBA_Finals" title="2010 NBA Finals" about="#mwt684" typeof="mw:Transclusion" id="mwCVc" data-mw='{"parts":[{"template":{"target":{"wt":"nbafy","href":"./Template:Nbafy"},"params":{"1":{"wt":"2010"}},"i":0}}]}'>2010</a>)</li>
<li id="mwCVg"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Miami_Heat" title="Miami Heat" id="mwCVk">Miami Heat</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2012_NBA_Finals" title="2012 NBA Finals" about="#mwt685" typeof="mw:Transclusion" id="mwCVo" data-mw='{"parts":[{"template":{"target":{"wt":"nbafy","href":"./Template:Nbafy"},"params":{"1":{"wt":"2012"}},"i":0}}]}'>2012</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/2013_NBA_Finals" title="2013 NBA Finals" about="#mwt686" typeof="mw:Transclusion" id="mwCVs" data-mw='{"parts":[{"template":{"target":{"wt":"nbafy","href":"./Template:Nbafy"},"params":{"1":{"wt":"2013"}},"i":0}}]}'>2013</a>)</li>
