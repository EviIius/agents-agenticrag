<script>
/* This JavaScript is used for different helper functions, such as Sirv object updates with Ajax. */

jQuery( document ).ajaxComplete(function() {
    if (arguments[1].responseText && arguments[1].responseText.match(/class *= *"[^"]*Sirv/gm)) {
        setTimeout(function(){Sirv.start();},100);
    }
});


jQuery(document).ready(function(){
    let count = 0;
    let timerId = setInterval(fixLinks, 200);
    function fixLinks(){
        let $images = jQuery('.svi-img');
        count++;

        if($images.length > 0){
            jQuery.each($images, function (indexInArray, val) {
                jQuery(val).attr('src', val.src.replace(/amp;/g, ''));
            });
            clearInterval(timerId);
        }else{
            if (count == 10) clearInterval(timerId);
        }
        
    }

    jQuery('.svi-img').on('click', function(){
        jQuery('.preview-img-item').attr('src', jQuery(this).attr('src').replace('amp;', ''));
    });
});
</script>
<script>(function(){function strip(){document.querySelectorAll('a.wp-block-button__link').forEach(function(a){Array.prototype.slice.call(a.attributes).forEach(function(at){if(at.name.indexOf('data-lbwps-')===0){a.removeAttribute(at.name);}});});}strip();if(document.readyState!=='complete'){window.addEventListener('load',strip);}document.addEventListener('DOMContentLoaded',strip);})();</script>
    <script id="mappr-cmp-rem-fix">
(function() {
  var ATTEMPTS = 50;        // 50 * 200ms = 10s of patience for the shadow root to attach
  var INTERVAL_MS = 200;
  var attempts = 0;
  var observer = null;

  function detectVisible(root) {
    var boxes = root.querySelectorAll('[id^="cmpbox"]');
    for (var i = 0; i < boxes.length; i++) {
      var cs = getComputedStyle(boxes[i]);
      if (cs.display !== 'none' && cs.visibility !== 'hidden') return true;
    }
    return false;
  }

  function attach() {
    var wrapper = document.getElementById('cmpwrapper');
    if (!wrapper || !wrapper.shadowRoot) {
      if (++attempts < ATTEMPTS) setTimeout(attach, INTERVAL_MS);
      return;
    }
    var root = wrapper.shadowRoot;

    function recheck() {
      document.documentElement.classList.toggle('cmp-active', detectVisible(root));
    }

    observer = new MutationObserver(recheck);
    observer.observe(root, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['style', 'class']
    });
    recheck();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attach);
  } else {
    attach();
  }
})();
</script>
