# Local providers are the default. Local URLs must resolve to loopback.
AGENTICRAG_CHAT_PROVIDER=local
AGENTICRAG_EMBEDDING_PROVIDER=local
AGENTICRAG_LOCAL_CHAT_BASE_URL=http://127.0.0.1:8080/v1
AGENTICRAG_LOCAL_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
AGENTICRAG_LOCAL_CHAT_MODEL=
AGENTICRAG_LOCAL_EMBEDDING_MODEL=
# Explicit additional local runtime hostnames for containers/private networks.
# AGENTICRAG_LOCAL_RUNTIME_HOSTS=host.docker.internal,ollama

# Optional, explicit comparison profile. No role switches to OpenAI automatically.
# Set AGENTICRAG_CHAT_PROVIDER=openai only in the launching shell or choose OpenAI in the UI.
AGENTICRAG_OPENAI_BASE_URL=https://api.openai.com/v1
AGENTICRAG_OPENAI_API_KEY=
AGENTICRAG_OPENAI_CHAT_MODEL=
AGENTICRAG_OPENAI_EMBEDDING_MODEL=

AGENTICRAG_HTTP_TIMEOUT_SECONDS=90
# Structured output compatibility: json_schema (strongest), json_object, or prompt (broadest).
AGENTICRAG_CHAT_STRUCTURED_OUTPUT=json_schema
AGENTICRAG_EMBEDDING_STRUCTURED_OUTPUT=json_schema

# SQLite is the zero-service development default. PostgreSQL is the production target.
AGENTICRAG_STORE=sqlite
AGENTICRAG_POSTGRES_DSN=
AGENTICRAG_OBJECTS_PATH=.data/objects

# Bounded, local-only document ingestion.
AGENTICRAG_MAX_FILE_BYTES=52428800
AGENTICRAG_MAX_PAGES=500
AGENTICRAG_MAX_SEGMENTS=100000
# Required for Docling/OCR. Prefetch artifacts; runtime cloud services stay disabled.
# AGENTICRAG_DOCLING_ARTIFACTS_PATH=C:/models/docling


# Public search is independent of the chat provider.
AGENTICRAG_WEB_PROVIDER=duckduckgo
# AGENTICRAG_SEARXNG_URL=https://your-search.example
# AGENTICRAG_BRAVE_API_KEY=
