{
  "name": "workbench-web",
  "private": true,
  "version": "1.0.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && prettier --check src index.html vite.config.ts playwright.config.ts tests && vitest run src",
    "e2e": "playwright test",
    "fmt": "prettier --write src index.html vite.config.ts playwright.config.ts tests"
  },
  "dependencies": {
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@tanstack/react-query": "^5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zustand": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
