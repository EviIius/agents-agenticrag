{
  "name": "workbench-web",
  "private": true,
  "version": "1.0.0-alpha.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && eslint . && prettier --check src index.html vite.config.ts playwright.config.ts tests && vitest run src",
    "e2e": "playwright test",
    "fmt": "prettier --write src index.html vite.config.ts playwright.config.ts tests"
  },
  "dependencies": {
    "@streamdown/code": "latest",
    "@streamdown/math": "latest",
    "@tanstack/react-query": "^5",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "cmdk": "latest",
    "lucide-react": "latest",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7",
    "sonner": "latest",
    "streamdown": "latest",
    "tailwind-merge": "latest",
    "vaul": "latest",
    "zustand": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/vite": "^4",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "openapi-typescript": "latest",
    "prettier": "latest",
    "tailwindcss": "^4",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
